#!/usr/bin/env bash
# t-history — the LISTENING LOG: durable, user-level, engine-agnostic. Agent-facing.
#
# The eighth command, and the second one that owns state a user would be upset to lose.
# Like t-playlist it knows nothing about sites (no yt-dlp, no cookie, no host grammar) and
# nothing about playback (no mpv, no lifecycle, no players/). It knows two things: the row
# and the file.
#
# WHY IT IS NOT THE PLAYER'S `failed[]`. ARCH-player.md「状态机」 draws the line this file is
# the other side of: `failed[]` lives in ${TMPDIR}/ting-$(id -u), is bounded, records only
# failures, and dies with the reboot — correct for a tombstone a caller reads seconds later,
# useless as a log of what a user listened to. History is written on success AND failure,
# lands in the user-level store, and outlives every player that produced it. The two records
# are written at the same instant and are not a duplication; they are that rule, from both
# sides.
#
# WHY JSONL, when the playlist store is one-JSON-per-entity. A listening is not an entity,
# it is an EVENT: one file per event is thousands of inodes by spring. Three consequences,
# all of them load-bearing:
#
#   1. Appending is not a read-modify-write, so this is the ONE write in the suite that
#      takes no lock: `>>` opens O_APPEND and a single write under PIPE_BUF (4096 on POSIX)
#      lands whole. A JSON array on disk would make every write a race.
#   2. Therefore EVERY LINE MUST BE UNDER 4096 BYTES. That is not a style rule, it is the
#      premise of point 1 — see history_row_fits(), which measures rather than trusts.
#   3. Sharding by month makes "clear the old stuff" an `rm`, not a rewrite of the whole log.
#
# THE ROW IS THE ITEM RECORD the playlist and the queue already use, plus the four fields a
# listening has and a list entry does not: played_at, ended_at, seconds, reason. That is why
# `t-history --ls -j` drops straight into `t-playlist --add` and `t-play -d --queue -`
# with no field mapping in between — the .items envelope is the same shape those two read.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features; guard empty-array
# expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). ARCHITECTURE.md「可移植性契约」.

# Resolve this script's OWN symlink chain before looking for its siblings — the PATH entry
# is a symlink into a checkout that can live anywhere. Physical `cd -P`/`pwd -P`, and a
# loop rather than `readlink -f` (bash 3.2 / BSD readlink has neither). Same preamble as
# every other command in the suite; it is duplicated because there is no library to share.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)

# THE version of the whole suite, declared once, in a data file. CLAUDE.md § one fact, one place.
if [[ -r "$SCRIPT_DIR/../VERSION" ]]; then
    UT_VERSION=$(cat "$SCRIPT_DIR/../VERSION")
else
    UT_VERSION="unknown"
fi

# CONFIGURATION — the chain is flag > environment > the user's config > the shipped defaults
# in `<checkout>/config`, which is where every default value in the suite is declared once.
# Duplicated VERBATIM in every entry point — see the same block in t-play for why, and
# ARCH-cli-contract.md「配置面」 for the keys.
TING_CONFIG="${TING_CONFIG:-${UT_CONFIG:-}}"
if [[ -z "$TING_CONFIG" ]]; then
    if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/ting/config" ]]; then
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ting/config"
    else
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/uting/config"
    fi
fi
UT_CONFIG="$TING_CONFIG"
for _v in STATE_DIR ENGINE_DIR HISTORY VOLUME IMAGE KEYS RESOURCE PLAY_QUALITY VIZ_STYLE VIZ_COLOR DEFAULT_ENGINE; do
    eval "[[ -n \"\${TING_$_v+x}\" ]] && UT_$_v=\"\$TING_$_v\" || true"
    eval "[[ -n \"\${UT_$_v+x}\" && -z \"\${TING_$_v+x}\" ]] && TING_$_v=\"\$UT_$_v\" || true"
done
# Renamed and merged keys, OLD:NEW. The old name still reads, one version, into the key that
# replaced it: from the environment here, from a file in ut_read_config, and ting's write-back
# renames the line in place. Lower-level than a knob, so it is not spelled with a key prefix.
CFG_RENAMED="UT_START_RESULTS:UT_SEARCH_RESULTS YT_COOKIE_BROWSER:UT_COOKIE_BROWSER \
    BILI_COOKIE_BROWSER:UT_COOKIE_BROWSER NE_COOKIE_BROWSER:UT_COOKIE_BROWSER YT_THEME:TING_THEME \
    YT_LANG:TING_LANG YT_ASCII:TING_ASCII YT_ASCII_VO:TING_ASCII_VO \
    YT_MPV_INPUT_CONF:TING_MPV_INPUT_CONF YT_BG:TING_BG YT_SYNC:TING_SYNC \
    YT_AMBIG_WIDE:TING_AMBIG_WIDE YT_AUDIO_FORMAT:TING_YT_AUDIO_FORMAT \
    YT_VIDEO_FORMAT:TING_YT_VIDEO_FORMAT YT_VIDEO_FORMAT_FAST:TING_YT_VIDEO_FORMAT_FAST \
    YT_SUB_LANG_CHAIN:TING_YT_SUB_LANG_CHAIN BILI_AUDIO_FORMAT:TING_BILI_AUDIO_FORMAT \
    BILI_VIDEO_FORMAT:TING_BILI_VIDEO_FORMAT BILI_VIDEO_FORMAT_FAST:TING_BILI_VIDEO_FORMAT_FAST \
    BILI_UA:TING_BILI_UA BILI_BUVID:TING_BILI_BUVID NE_AUDIO_FORMAT:TING_NE_AUDIO_FORMAT \
    NE_UA:TING_NE_UA NE_INCLUDE_VIP:TING_NE_INCLUDE_VIP"
for _v in $CFG_RENAMED; do
    eval "[[ -n \"\${${_v%%:*}+x}\" && -z \"\${${_v#*:}+x}\" ]] && ${_v#*:}=\"\$${_v%%:*}\" || true"
done
UT_DEFAULTS="$SCRIPT_DIR/../config"
ut_read_config() {
    local file="$1" line key val _ting_k _ut_k
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        while [[ "$line" == [[:space:]]* ]]; do line="${line#[[:space:]]}"; done
        while [[ "$line" == *[[:space:]] ]]; do line="${line%[[:space:]]}"; done
        [[ -n "$line" && "$line" == *=* ]] || continue
        key="${line%%=*}"
        val="${line#*=}"
        while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
        while [[ "$val" == [[:space:]]* ]]; do val="${val#[[:space:]]}"; done
        case " $CFG_RENAMED " in
        *" $key:"*)
            _ut_k=" $CFG_RENAMED"
            _ut_k="${_ut_k#* $key:}"
            key="${_ut_k%% *}"
            ;;
        esac
        [[ "$key" =~ ^(TING|UT)_[A-Z0-9_]+$ ]] || continue
        case "$key" in
        TING_CONFIG | TING_DEFAULTS | TING_ENGINE_DIR | TING_VERSION | UT_CONFIG | UT_DEFAULTS | UT_ENGINE_DIR | UT_VERSION) continue ;;
        esac
        if [[ ${#val} -ge 2 ]] && { [[ "$val" == \"*\" ]] || [[ "$val" == \'*\' ]]; }; then
            val="${val#?}"
            val="${val%?}"
        fi
        [[ "$val" == "~/"* ]] && val="$HOME/${val#\~/}"
        if [[ "$key" == TING_* ]]; then
            _ut_k="UT_${key#TING_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ut_k+x}\" ]] || $_ut_k=\$val"
        else
            _ting_k="TING_${key#UT_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ting_k+x}\" ]] || $_ting_k=\$val"
        fi
    done < "$file"
}
# FAIL FAST AND SAY WHY. There is deliberately no escape hatch for --version or --help: they
# were tried, and letting execution continue past a missing defaults file replaced this one
# clear line with `TING_ASCII_VO: unbound variable` from set -u somewhere further down. A
# checkout missing part of itself is not a dependency gate (yt-dlp, jq and mpv still answer
# --version without being installed) — it is a broken checkout, and 2 is the exit code for a
# failure that is not the caller's usage error.
if [[ ! -r "$UT_DEFAULTS" ]]; then
    printf '%s: cannot read the shipped defaults at %s — that file declares every default value in the suite and is not optional\n' \
        "$(basename "$0")" "$UT_DEFAULTS" >&2
    exit 2
fi
ut_read_config "$UT_CONFIG"
ut_read_config "$UT_DEFAULTS"

# ==============================================================================
# 1. SETTINGS
# ==============================================================================

# The same user-level state root t-playlist uses, and for the same reasons: XDG because the
# neighbours (yt-dlp, mpv) are there and a Linux port would need no second layout, and an
# override because without it `tests/contract.sh` would write into the user's real history.
# ARCH-cli-contract.md「配置面」.
if [[ -z "${TING_STATE_DIR:-${UT_STATE_DIR:-}}" ]]; then
    if [[ -d "${XDG_STATE_HOME:-$HOME/.local/state}/ting" ]]; then
        UT_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ting"
    elif [[ -d "${XDG_STATE_HOME:-$HOME/.local/state}/uting" ]]; then
        UT_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/uting"
    else
        UT_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ting"
    fi
else
    UT_STATE_DIR="${TING_STATE_DIR:-$UT_STATE_DIR}"
fi
TING_STATE_DIR="$UT_STATE_DIR" 
HISTORY_DIR="$UT_STATE_DIR/history"

# The row format version, written on every line. A JSONL file has no envelope to carry one,
# so the row carries it: a line this build cannot read must be skippable, and a schema
# nobody reads buys nothing — a future file would simply be misread as this one.
HISTORY_SCHEMA_MAX=1

# Point 2 of the header, as a number. The newline counts: what has to fit in one atomic
# write is the line, not the JSON.
LINE_MAX=4096
TITLE_MAX_BYTES=200

COLOR_MODE="auto"
OUTPUT_MODE="list"
ACTION=""
LIMIT=20
BEFORE=""
RECORD_INPUT=""

# ==============================================================================
# 2. HELPERS
# ==============================================================================

err() {
    local red='' reset=''
    case "${COLOR_MODE:-auto}" in
    always) red=$'\033[31m'; reset=$'\033[0m' ;;
    auto) if [[ -t 2 ]]; then red=$'\033[31m'; reset=$'\033[0m'; fi ;;
    never) ;;
    esac
    echo "${red}Error:${reset} $*" >&2
}

die() {
    err "$@"
    exit 1
}

# A missing tool is not a malformed call: `die` is exit 1 (the argv is wrong — fix it),
# `die_dep` is exit 2 (the argv was fine; the machine is missing something no rewrite of the
# argv will supply). An agent that read 1 here would loop editing its own parameters against
# a wall. docs/ARCH-cli-contract.md「退出码、TTY、依赖」.
die_dep() {
    err "required command not found: $1"
    exit 2
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die_dep "$1"
}

validate_enum() {
    local value=$1; shift
    local allowed
    for allowed in "$@"; do
        [[ "$value" == "$allowed" ]] && return 0
    done
    return 1
}

# An OPERATIONAL failure, and the same split t-playlist states at its own fail(): prose to
# stderr in both modes, the machine envelope to stdout only under -j.
#
# The reason enum is the STATE enum (not the playback one), and this command uses two of its
# members — there is no name here to be `not_found` and no lock to be `locked`:
#
#   1  invalid_input   the caller's own argv or stdin is malformed
#   4  corrupt         argv understood, the store could not answer
#
# `--clear` on an empty store stays 0 with removed:0: the caller asked for an end state and
# the end state holds, exactly as `--del` and `--stop` do. ARCH-cli-contract.md「数据契约」与「退出码」.
fail() {
    local code=$1 reason=$2 msg=$3
    echo "t-history: $msg" >&2
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg reason "$reason" '{status: "error", reason: $reason}'
    fi
    exit "$code"
}

now_utc() { date -u +%FT%TZ 2>/dev/null || echo unknown; }

ensure_store() {
    mkdir -p -m 700 "$HISTORY_DIR" 2>/dev/null || die "cannot create the state directory: $HISTORY_DIR"
    chmod 700 "$UT_STATE_DIR" "$HISTORY_DIR" 2>/dev/null || true
}

# The ONE duration formatter, as a jq prelude — one of the identical copies of these six
# lines the suite carries because it has no library. ARCHITECTURE.md「命令拓扑」 is where that
# duplication is decided AND counted, so this comment carries no number of its own: an
# ordinal here goes stale the next time an engine pair lands, silently. A bash version would
# fork jq per row.
JQ_PRELUDE='
def p2: tostring | if length < 2 then "0" + . else . end;
def fmt_dur:
  if type != "number" then null
  else (. | floor) as $t
    | ($t / 86400 | floor) as $d
    | (($t % 86400) / 3600 | floor) as $h
    | (($t % 3600) / 60 | floor) as $m
    | ($t % 60) as $s
    | (if $d > 0 then "\($d)d " else "" end) + "\($h | p2)h:\($m | p2)m:\($s | p2)s"
  end;
'

# Truncate to a BYTE budget without cutting a character in half. jq slices by codepoint and
# the budget is in bytes, so the slice is taken and then walked back: from $n codepoints the
# string is at most 4$n bytes and each step drops at least one byte, so it converges in under
# 3$n steps (600 for a 200-byte title). This is the jq spelling of what ting's utf8_complete
# does for a keypress — a truncation that can leave a broken sequence produces a line that is
# not JSON, which is the one thing an append-only log cannot recover from.
JQ_TRUNC='
def trunc_bytes($n):
  if type != "string" then .
  elif utf8bytelength <= $n then .
  else {s: .[0:$n]}
    | until((.s | utf8bytelength) <= $n; .s = .s[0:((.s | length) - 1)])
    | .s
  end;
'

# Bytes, not characters: ${#var} counts codepoints in a UTF-8 locale, and the atomicity
# budget is bytes. One fork per --record is affordable; a wrong unit is not.
line_bytes() { printf '%s\n' "$1" | wc -c | tr -d '[:space:]'; }

# Rows, meaning NON-BLANK lines: `wc -l` would count a blank line left by a hand edit as a
# record and make --clear report removing one that was never there.
count_rows() {
    local n
    n=$(grep -c '[^[:space:]]' "$1" 2>/dev/null) || n=0
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    echo "$n"
}

# The month files, newest first. The glob is ascending and bash 3.2 has no reverse; a
# YYYY-MM name sorts lexicographically exactly as it sorts chronologically, which is the
# whole reason the shard is named that way. Files that are not a month shard are left alone
# everywhere in this command — deleting a file we did not write is not ours to do.
HISTORY_FILES=()
collect_history_files() {
    local f base month asc=()
    HISTORY_FILES=()
    for f in "$HISTORY_DIR"/*.jsonl; do
        [[ -e "$f" ]] || continue
        base=${f##*/}
        month=${base%.jsonl}
        [[ "$month" =~ ^[0-9]{4}-[0-9]{2}$ ]] || continue
        asc+=("$f")
    done
    local i
    for ((i = ${#asc[@]} - 1; i >= 0; i--)); do
        HISTORY_FILES+=("${asc[$i]}")
    done
}

# ==============================================================================
# 3. VERBS
# ==============================================================================

# --ls is a question about the whole store, so one bad line must not hide the rest: an
# unparseable line, or one written by a newer build, is counted and skipped with a sentence
# on stderr — the same rule t-playlist --ls applies to an unreadable playlist file. Skipping
# silently would make the count a lie.
#
# Only as many month files are read as the limit needs: shards are consumed newest first and
# the loop stops once enough rows are in hand, so `--ls` on five years of history reads one
# file. The rows are sorted by played_at afterwards rather than trusted in file order,
# because a record may arrive back-dated (a track that started last month and ended this one).
do_ls() {
    ensure_store
    collect_history_files
    local f chunk chunks=() got=0 bad=0 n b
    for f in ${HISTORY_FILES[@]+"${HISTORY_FILES[@]}"}; do
        # `fromjson? // null`, never a bare `fromjson?`: the ? form yields EMPTY on a line
        # that is not JSON, an empty update collapses the whole reduce to null, and one
        # hand-edited line would then hide every record in the shard. It has to yield a
        # VALUE the reduce can count.
        chunk=$(jq -Rn --argjson max "$HISTORY_SCHEMA_MAX" '
            reduce inputs as $l ({rows: [], bad: 0};
              if ($l | test("^[[:space:]]*$")) then .
              else ($l | fromjson? // null) as $r
                | if ($r | type) != "object" or (($r.schema // 0) > $max) then .bad += 1
                  else .rows += [$r] end
              end)' "$f" 2>/dev/null) || chunk=""
        if [[ -z "$chunk" ]]; then
            echo "t-history: skipping unreadable history file: $f" >&2
            continue
        fi
        # Both counts are re-checked before they reach arithmetic: `$(( bad + null ))` is not
        # a slightly wrong number under set -u, it is an unbound-variable abort.
        n=$(jq -r '.rows | length' <<<"$chunk" 2>/dev/null) || n=0
        [[ "$n" =~ ^[0-9]+$ ]] || n=0
        b=$(jq -r '.bad' <<<"$chunk" 2>/dev/null) || b=0
        [[ "$b" =~ ^[0-9]+$ ]] || b=0
        bad=$((bad + b))
        chunks+=("$(jq -c '.rows' <<<"$chunk")")
        got=$((got + n))
        if ((got >= LIMIT)); then break; fi
    done
    if ((bad > 0)); then
        echo "t-history: skipped $bad unreadable line(s)" >&2
    fi

    local items="[]"
    if ((${#chunks[@]})); then
        items=$(printf '%s\n' "${chunks[@]}" | jq -sc --argjson n "$LIMIT" \
            'add | sort_by(.played_at // "") | reverse | .[0:$n]')
    fi

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        # `duration_fmt` and `seconds_fmt` are DERIVED here and never stored — a stored copy
        # would be a second truth about the same number. They are emitted for the same reason
        # --show emits one: it makes a row field-for-field renderable by the list renderer
        # `ting` already has, and leaves .items pipeable straight back into --add / --queue.
        printf '%s' "$items" | jq -c "$JQ_PRELUDE"'
            {status: "ok", count: length,
             items: map(. + {duration_fmt: (.duration | fmt_dur),
                             seconds_fmt: (.seconds | fmt_dur)})}'
        return 0
    fi

    if [[ "$(printf '%s' "$items" | jq 'length')" == "0" ]]; then
        echo "No listening history yet."
        echo "  It fills itself as you play:  t-play -d --engine yt -- URL"
        return 0
    fi
    printf '%s' "$items" | jq -r "$JQ_PRELUDE"'
        "\(length) listening record(s), newest first",
        (to_entries[]
         | "  [\(.key)] \(.value.title // "(untitled)")",
           "        \(.value.played_at) - \(.value.seconds | fmt_dur // "--") of \(.value.duration | fmt_dur // "--") - \(.value.engine) - \(.value.reason // "finished")",
           "        \(.value.url)")'
}

# ONE record, one line, one append — and the singular is the contract, not a limitation.
# Point 1 of the header only holds for a single write under PIPE_BUF; a batch verb would be
# several lines in one `>>`, which is exactly the write that can tear.
#
# The row is CONSTRUCTED field by field rather than merged from the input, so an unknown key
# a caller happens to carry (a search result's channel, view_count, live_status) cannot land
# on disk. That is both the ARCH-player.md「持久状态层」 rule about fields that expire into lies, and
# the only way the line length stays bounded by this file rather than by its callers.
do_record() {
    ensure_store
    [[ -t 0 ]] && fail 1 invalid_input "--record reads one JSON record on stdin (try: ... | t-history --record -)"
    local raw row rc=0
    raw=$(cat)
    # A MATCH, never `${raw//[[:space:]]/}`. That substitution is quadratic on the 3.2 floor
    # once the string holds one space — 17.5s for a 7KB envelope against 4ms here — while
    # bailing fast when nothing matches, which is exactly what made it look free everywhere
    # it was used. The rule and the numbers are ARCHITECTURE.md「可移植性契约」. The input this command
    # is specifically required to survive is a record with a multi-KB title, so the cheap
    # form is not an optimisation: it is the difference between a best-effort write and a
    # stalled track boundary.
    [[ "$raw" == *[![:space:]]* ]] || fail 1 invalid_input "no input on stdin"

    # The reason enum is the PLAYBACK one, unchanged and not widened here: a caller branches
    # on the same member names whichever surface produced them (ARCH-cli-contract.md「数据契约」). A
    # skipped track is `stopped_by_user` — the user acted, and `seconds` is what tells a skip
    # at 0:05 from a stop at 3:20. Adding a member is a contract change, made in the doc and
    # then here; it is not something the player gets to invent on the way past.
    row=$(printf '%s' "$raw" | jq -c --arg now "$(now_utc)" \
        --argjson title_max "$TITLE_MAX_BYTES" "$JQ_TRUNC"'
        (if type == "object" then . else error("not an object") end)
        | {schema: 1,
           engine:   (.engine // ""),
           id:       (if (.id | type) == "string" then (.id | trunc_bytes(128)) else null end),
           url:      (.url // ""),
           title:    (if (.title | type) == "string" then (.title | trunc_bytes($title_max)) else null end),
           duration: (if (.duration | type) == "number" then .duration else null end),
           played_at: (if (.played_at | type) == "string" then .played_at else $now end),
           ended_at:  (if (.ended_at | type) == "string" then .ended_at else $now end),
           seconds:  (if (.seconds | type) == "number" then (.seconds | floor) else null end),
           reason:   (if (.reason | type) == "string" and (.reason | length) > 0 then .reason else null end)}
        # The engine name is checked the way the player checks it, because it is the prefix of
        # a command name (`<engine>-resolve`) the moment anyone plays this row back. The url is
        # checked as far as a handle on argv is — non-empty and whitespace-free — and no
        # further: which ids are good is ENGINE knowledge, and not holding it is the point.
        | if (.engine | test("^[a-z0-9][a-z0-9_-]*$") | not) or (.engine | length) > 32
          then error("engine") else . end
        | if (.url | test("^[^[:space:]]+$") | not) then error("url") else . end
        # played_at names the shard file, so a malformed one would name a malformed file.
        | if (.played_at | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T")) then . else error("played_at") end
        # Bound first: inside the pipe `.` is the enum array, so `index(.reason)` would ask
        # the array for a field it does not have.
        | (.reason) as $r
        | if $r == null
             or (["forbidden","unavailable","format_unavailable","network","stopped_by_user","unknown"]
                 | index($r)) then . else error("reason") end
    ' 2>/dev/null) || rc=$?
    if ((rc != 0)) || [[ -z "$row" ]]; then
        fail 1 invalid_input "stdin is not one listening record: it needs an engine ([a-z0-9_-]), a whitespace-free url, an ISO played_at, and a reason from the playback enum (or null)"
    fi

    # MEASURE, do not trust. Truncating the title covers the case that actually happens; this
    # covers the rest, because the 4096-byte bound is the premise the lock-free append rests
    # on and a premise you only check on typical input is not a premise. The ladder drops the
    # free-text fields first and the url last — a row without a title is still a call, a row
    # without a url is not.
    local truncated=false shrink
    if [[ "$(printf '%s' "$raw" | jq -r 'if (.title | type) == "string" and (.title | utf8bytelength) > '"$TITLE_MAX_BYTES"' then "yes" else "no" end' 2>/dev/null)" == "yes" ]]; then
        truncated=true
    fi
    for shrink in 0 1 2 3; do
        if (($(line_bytes "$row") < LINE_MAX)); then break; fi
        truncated=true
        case "$shrink" in
        0) row=$(printf '%s' "$row" | jq -c '.title = null') ;;
        1) row=$(printf '%s' "$row" | jq -c '.id = null') ;;
        2) row=$(printf '%s' "$row" | jq -c '.url = (.url[0:200])') ;;
        3) fail 1 invalid_input "the record does not fit in one $LINE_MAX-byte line even stripped to its url" ;;
        esac
    done

    local month f
    month=$(printf '%s' "$row" | jq -r '.played_at[0:7]')
    f="$HISTORY_DIR/$month.jsonl"
    # The one lock-free write in the suite. `>>` is O_APPEND, the line is under PIPE_BUF, and
    # printf is a bash builtin so there is one write() syscall and no second process racing.
    printf '%s\n' "$row" >>"$f" || die "cannot append to $f"

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg month "$month" --argjson truncated "$truncated" \
            '{status: "ok", recorded: 1, month: $month, truncated: $truncated}'
    else
        printf 'Recorded 1 listening (%s)\n' "$month"
    fi
}

# --clear with no --before empties the log; with one it deletes what is older than DATE.
# Month shards make that mostly an `rm`: every shard whose month is strictly before DATE's
# goes whole, and only the shard DATE falls inside is rewritten — which is why a day-level
# --before does not have to read a year of history to honour a one-day cut.
#
# THE BOUNDARY REWRITE IS THE ONE PLACE THIS FILE IS NOT APPEND-ONLY, and it is deliberately
# not locked. Adding a lock here would mean adding it to --record too, and --record's
# lock-free append is the premise the whole storage choice rests on (header, point 1). The
# exposure is exactly one case: a --clear whose boundary falls in the CURRENT month, racing a
# track that ends during the rewrite — a hand-run maintenance verb against the one shard
# appends go to. That record can be lost. Every other cut rewrites a shard nothing is
# appending to, and races with nothing.
#
# Lines that do not parse, or carry no played_at, are KEPT verbatim: a rewrite is not the
# place to silently drop what it could not read.
do_clear() {
    ensure_store
    collect_history_files
    local f base month removed=0 before_month="" before_rows after_rows tmp
    [[ -n "$BEFORE" ]] && before_month="${BEFORE:0:7}"

    for f in ${HISTORY_FILES[@]+"${HISTORY_FILES[@]}"}; do
        base=${f##*/}
        month=${base%.jsonl}
        if [[ -z "$BEFORE" ]] || [[ "$month" < "$before_month" ]]; then
            removed=$((removed + $(count_rows "$f")))
            rm -f "$f" || die "cannot remove $f"
            continue
        fi
        # A month-level --before excludes the whole boundary month already; only a date with
        # a day (or a time) in it has anything left to cut inside the shard.
        [[ "$month" == "$before_month" ]] || continue
        ((${#BEFORE} > 7)) || continue
        before_rows=$(count_rows "$f")
        tmp="$f.tmp.$$"
        # An ISO timestamp compares lexicographically exactly as it compares chronologically,
        # which is what lets this be a string test instead of a date parser on the 3.2 floor.
        jq -Rr --arg before "$BEFORE" '
            select(test("^[[:space:]]*$") | not)
            | . as $raw
            | (fromjson? // null) as $r
            | if ($r | type) == "object" and ($r.played_at | type) == "string"
                 and ($r.played_at < $before)
              then empty else $raw end' "$f" >"$tmp" 2>/dev/null || {
            rm -f "$tmp" 2>/dev/null || true
            fail 4 corrupt "cannot rewrite the boundary shard: $f"
        }
        after_rows=$(count_rows "$tmp")
        if [[ -s "$tmp" ]]; then
            mv -f "$tmp" "$f" || { rm -f "$tmp" 2>/dev/null || true; die "cannot persist $f"; }
        else
            rm -f "$tmp" 2>/dev/null || true
            rm -f "$f" || die "cannot remove $f"
        fi
        removed=$((removed + before_rows - after_rows))
    done

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --argjson removed "$removed" --arg before "$BEFORE" \
            '{status: "ok", removed: $removed, before: (if $before == "" then null else $before end)}'
    elif ((removed == 0)); then
        echo "Nothing to clear."
    elif [[ -n "$BEFORE" ]]; then
        printf 'Cleared %s listening record(s) from before %s\n' "$removed" "$BEFORE"
    else
        printf 'Cleared %s listening record(s)\n' "$removed"
    fi
}

# ==============================================================================
# 4. CLI
# ==============================================================================

print_usage() {
    cat <<'EOF'
t-history — the listening log (durable, user-level, engine-agnostic)

Usage:
  t-history --ls [-n N]
  t-history --record -             < one JSON record on stdin
  t-history --clear [--before DATE]

Options:
  -n N          How many records --ls prints, newest first (default 20)
  --before DATE What --clear cuts at: YYYY-MM, YYYY-MM-DD, or a full ISO timestamp.
                Records at or after DATE are kept.
  -l            Plain text output (default)
  -j            JSON envelope, one line
  --color MODE  auto | always | never (default: auto)
  -h            This help
  -V            Print the suite version

Input (--record): ONE JSON object on stdin — an item ({engine, url, [id], [title],
  [duration]}) plus the listening ({played_at, ended_at, seconds, reason}). Missing
  timestamps default to now; `reason` is the playback enum (forbidden, unavailable,
  format_unavailable, network, stopped_by_user, unknown) or null for a clean finish.
  The player writes these itself as each track ends; a hand-written one is the same shape.

Output (--ls -j): {status, count, items[]} — items are the item record the rest of the
  suite reads, so the log pipes straight back into a list or a player:

    t-history --ls -n 50 -j | t-playlist --add rediscover
    t-history --ls -n 10 -j | t-play -d --queue -

Storage: $UT_STATE_DIR/history/<YYYY-MM>.jsonl
  (default $XDG_STATE_HOME/ting, else ~/.local/state/ting; a pre-rename
  .../uting is used when there is no ting one) — one line per listening,
  appended, never rewritten except by --clear. Every line is under 4096 bytes so the
  append is atomic without a lock; a long title is truncated on a UTF-8 boundary to keep
  it that way, and --ls reports `truncated`.

Exit codes: 0 ok
            1 the call was malformed   (.reason: invalid_input)
            2 a dependency is missing  (jq — stderr says which)
            4 the store said no        (.reason: corrupt)
  --clear on an empty log is 0 with removed:0 — the end state holds.

The player's own writes are gated by UT_HISTORY (default on; UT_HISTORY=0 disables them).
This command stores what was played; to play something, use t-play.
EOF
}

set_action() {
    [[ -z "$ACTION" ]] || { echo "t-history: only one action per call ($ACTION and $1)" >&2; exit 1; }
    ACTION="$1"
}

while (($#)); do
    case "$1" in
    -h | --help) print_usage; exit 0 ;;
    -V | --version)
        # Answered before any dependency gate, like every other command in the suite.
        printf 't-history %s\n' "$UT_VERSION"
        exit 0
        ;;
    -l | --list) OUTPUT_MODE="list"; shift ;;
    -j | --json) OUTPUT_MODE="json"; shift ;;
    --color=*) COLOR_MODE="${1#*=}"; shift ;;
    --color)
        [[ $# -ge 2 ]] || { echo "t-history: $1 requires a value" >&2; exit 1; }
        COLOR_MODE="$2"; shift 2
        ;;
    --ls) set_action ls; shift ;;
    --clear) set_action clear; shift ;;
    --record | --record=*)
        set_action record
        case "$1" in
        --record=*) RECORD_INPUT="${1#*=}"; shift ;;
        *)
            [[ $# -ge 2 ]] || { echo "t-history: --record requires '-' (the record is read from stdin)" >&2; exit 1; }
            RECORD_INPUT="$2"; shift 2
            ;;
        esac
        ;;
    -n | -n=*)
        case "$1" in
        -n=*) LIMIT="${1#*=}"; shift ;;
        *)
            [[ $# -ge 2 ]] || { echo "t-history: -n requires a value" >&2; exit 1; }
            LIMIT="$2"; shift 2
            ;;
        esac
        ;;
    --before | --before=*)
        case "$1" in
        --before=*) BEFORE="${1#*=}"; shift ;;
        *)
            [[ $# -ge 2 ]] || { echo "t-history: --before requires a date (YYYY-MM or YYYY-MM-DD)" >&2; exit 1; }
            BEFORE="$2"; shift 2
            ;;
        esac
        ;;
    # The gate arms. t-play, t-playlist and t-history share a prefix and two of them share
    # a --ls, so the likely wrong turns get a sentence naming the right command rather than a
    # bare unknown-flag error — what every other command in this suite does at its edges
    # (ARCH-cli-contract.md「门模型」).
    -d | --detach | --status | --stop | --set-volume | --pause | --resume | --seek | --seek-to | --queue | --enqueue | --next | --id | --all | --engine | -f)
        echo "t-history: $1 is a playback flag — this command stores what was played, use t-play to play" >&2
        exit 1
        ;;
    --add | --show | --rm | --del | --rename | --index)
        echo "t-history: $1 belongs to t-playlist — history is a log, not a list you edit" >&2
        exit 1
        ;;
    -m | -M | -s | -S | --info | --transcript)
        echo "t-history: $1 belongs to an engine — use <engine>-search / <engine>-resolve" >&2
        exit 1
        ;;
    --)
        shift
        # `--` stops FLAG parsing, not argument validation. This command takes NO positional
        # argument: every value is attached to its verb, so anything here is a caller who
        # meant a different command.
        if (($#)); then
            echo "t-history: unexpected argument '$1' — this command takes no positional argument (see 't-history -h')" >&2
            exit 1
        fi
        break
        ;;
    -*)
        echo "t-history: unknown flag '$1' (verbs: --ls --record --clear)" >&2
        exit 1
        ;;
    *)
        echo "t-history: unexpected argument '$1' — values belong to a flag (see 't-history -h')" >&2
        exit 1
        ;;
    esac
done

[[ -n "$ACTION" ]] || { echo "t-history: an action is required: --ls --record --clear (see 't-history -h')" >&2; exit 1; }
validate_enum "$COLOR_MODE" auto always never || die "--color must be one of: auto, always, never"

# A selector with no action to select for. Silently ignoring `--clear -n 5` would let a
# caller believe it deleted five records; `t-play` and `t-playlist` reject the same shape.
if [[ "$ACTION" == "ls" ]]; then
    [[ "$LIMIT" =~ ^[0-9]+$ ]] || { echo "t-history: -n must be a non-negative integer" >&2; exit 1; }
    ((LIMIT >= 1)) || { echo "t-history: -n must be at least 1" >&2; exit 1; }
    ((LIMIT <= 10000)) || { echo "t-history: -n is capped at 10000" >&2; exit 1; }
elif [[ "$LIMIT" != "20" ]]; then
    echo "t-history: -n belongs to --ls, not --$ACTION" >&2
    exit 1
fi

if [[ "$ACTION" == "clear" ]]; then
    if [[ -n "$BEFORE" ]] && [[ ! "$BEFORE" =~ ^[0-9]{4}-[0-9]{2}(-[0-9]{2}([T\ ].*)?)?$ ]]; then
        echo "t-history: --before takes YYYY-MM, YYYY-MM-DD or a full ISO timestamp" >&2
        exit 1
    fi
elif [[ -n "$BEFORE" ]]; then
    echo "t-history: --before belongs to --clear, not --$ACTION" >&2
    exit 1
fi

if [[ "$ACTION" == "record" ]]; then
    # '-' only, and required. A path argument would be a second way to say the same thing,
    # and the player has stdin; `t-play --queue` answers the same sentence.
    [[ "$RECORD_INPUT" == "-" ]] || { echo "t-history: --record takes '-': the record is read from stdin" >&2; exit 1; }
elif [[ -n "$RECORD_INPUT" ]]; then
    echo "t-history: --record cannot be combined with --$ACTION" >&2
    exit 1
fi

require_cmd jq

case "$ACTION" in
ls) do_ls ;;
record) do_record ;;
clear) do_clear ;;
esac
exit 0
