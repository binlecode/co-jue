#!/usr/bin/env bash
# t-engine-bili — the Bilibili ENGINE: everything this suite knows about one site, in one file.
#
# An engine is one file per SITE, not one per operation. The User-Agent, the Referer, the host
# list, the BV/av id shapes, the body codes this host answers with, the cookie store — each is
# a fact about Bilibili, and when searching and resolving lived in two files each was written
# twice (about 214 duplicated lines in this pair). The verbs below share them; they share
# nothing with any other engine.
#
# This file is BELOW the public contract. `t-play` is the one entry point: it forwards its
# engine verbs (--search --info --items --auth) here verbatim and calls --stream itself to turn
# a handle into bytes. So the argv here is an internal protocol between two files of this
# suite, and the flag gate lives in exactly one place — this one. --capabilities publishes
# that gate so `t-play --engines` can answer for it. docs/ARCHITECTURE.md「命令拓扑」.
#
# TWO TRANSPORTS, and each verb uses the one that works — measured, not preferred:
#   --search --items   hand-built GETs to the site's own web API (curl + jq).
#                      yt-dlp --flat-playlist returns an av id and NOTHING else per search
#                      entry, and a full extraction recurses into every multi-part collection
#                      (`bilisearch10:周杰伦` did not finish in 120s) where one GET answers in
#                      0.71s. For a container it answers one page of 100 and never pages, and
#                      for a video's parts it returns no title and no duration (2026-08-29).
#   --stream --info    yt-dlp, which owns the WBI signature, DASH selection across three
#                      sources and CDN choice — the ~2500 lines a native client spends on it.
# That line also puts login on one side: the hand-built requests NEVER carry a credential (the
# one cookie search sends is a buvid3 this file generates), and the browser's cookie store
# reaches yt-dlp through --cookies-from-browser and nothing else. docs/ARCHITECTURE.md「原语与接缝」.
#
# There is no --transcript: this site's videos carry no caption track for yt-dlp to fetch
# (measured: subtitles {} and automatic_captions absent). A capability is stated by having the
# verb, and its absence by not having it.
#
# It has NO playback, lifecycle, or mpv logic and never starts a process that outlives it.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features; guard empty-array
# expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). ARCHITECTURE.md「可移植性契约」.

# Resolve this script's OWN symlink chain before looking for its siblings. The PATH entry
# is a symlink into a checkout that can live anywhere, so `dirname $0` is the symlink's
# directory, not the code's. This walks the chain to the real file and takes ITS directory.
#
# `cd -P` / `pwd -P`, not the logical forms: a relative symlink resolves to something like
# ~/bin/../../../elsewhere/shell, and logical `cd` would normalise those `..` textually
# against ~/bin instead of against what ~/bin actually points at. Physical resolution is the
# only one that lands in the right place. bash 3.2 has no `readlink -f`, hence the loop.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)

# THE version of the whole suite, declared once — in a data file, not in code. The engines
# and the player are independent executables that share no library, so a shell variable in
# any one of them would make the others ask IT for the version, which is the wrong
# dependency direction for a player that must not know its engines. CLAUDE.md § one fact, one place.
if [[ -r "$SCRIPT_DIR/../VERSION" ]]; then
    UT_VERSION=$(cat "$SCRIPT_DIR/../VERSION")
else
    UT_VERSION="unknown"
fi

# CONFIGURATION — the chain is flag > environment > the user's config > the shipped defaults
# in `<checkout>/config`, which is where every default value in the suite is declared once.
# Duplicated VERBATIM in every entry point — see the same block in t-play for why, and
# ARCH-cli-contract.md「配置面」 for the keys.
TING_CONFIG="${TING_CONFIG:-${UT_CONFIG:-}}"
if [[ -z "$TING_CONFIG" ]]; then
    if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/ting/config" ]]; then
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ting/config"
    else
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/uting/config"
    fi
fi
UT_CONFIG="$TING_CONFIG"
for _v in STATE_DIR ENGINE_DIR HISTORY THEME ACCENT VOLUME LANG IMAGE KEYS RESOURCE RESOURCE_TICKS BRAND ASCII SYNC PLAY_QUALITY VIZ_STYLE VIZ_COLOR DEAD_KEEP DEFAULT_ENGINE MODE_CYCLE SORT_CYCLE THEME_CYCLE QUALITY_CYCLE LOOP_CYCLE; do
    eval "[[ -n \"\${TING_$_v+x}\" ]] && UT_$_v=\"\$TING_$_v\" || true"
    eval "[[ -n \"\${UT_$_v+x}\" && -z \"\${TING_$_v+x}\" ]] && TING_$_v=\"\$UT_$_v\" || true"
done
UT_DEFAULTS="$SCRIPT_DIR/../config"
ut_read_config() {
    local file="$1" line key val _ting_k _ut_k
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        while [[ "$line" == [[:space:]]* ]]; do line="${line#[[:space:]]}"; done
        while [[ "$line" == *[[:space:]] ]]; do line="${line%[[:space:]]}"; done
        [[ -n "$line" && "$line" == *=* ]] || continue
        key="${line%%=*}"
        val="${line#*=}"
        while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
        while [[ "$val" == [[:space:]]* ]]; do val="${val#[[:space:]]}"; done
        [[ "$key" =~ ^(TING|UT|YT|BILI|NE)_[A-Z0-9_]+$ ]] || continue
        case "$key" in
        TING_CONFIG | TING_DEFAULTS | TING_ENGINE_DIR | TING_VERSION | UT_CONFIG | UT_DEFAULTS | UT_ENGINE_DIR | UT_VERSION | YT_IPC_SOCK | YT_DETACHED | YT_PLAYER_ID | YT_DETACHED_LOG) continue ;;
        esac
        if [[ ${#val} -ge 2 ]] && { [[ "$val" == \"*\" ]] || [[ "$val" == \'*\' ]]; }; then
            val="${val#?}"
            val="${val%?}"
        fi
        [[ "$val" == "~/"* ]] && val="$HOME/${val#\~/}"
        if [[ "$key" == TING_* ]]; then
            _ut_k="UT_${key#TING_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ut_k+x}\" ]] || $_ut_k=\$val"
        elif [[ "$key" == UT_* ]]; then
            _ting_k="TING_${key#UT_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ting_k+x}\" ]] || $_ting_k=\$val"
        else
            eval "[[ -n \"\${$key+x}\" ]]" && continue
            eval "$key=\$val"
        fi
    done < "$file"
}
# FAIL FAST AND SAY WHY. There is deliberately no escape hatch for --version or --help: they
# were tried, and letting execution continue past a missing defaults file replaced this one
# clear line with `YT_ASCII_VO: unbound variable` from set -u somewhere further down. A
# checkout missing part of itself is not a dependency gate — it is a broken checkout, and 2 is
# the exit code for a failure that is not the caller's usage error.
if [[ ! -r "$UT_DEFAULTS" ]]; then
    printf '%s: cannot read the shipped defaults at %s — that file declares every default value in the suite and is not optional\n' \
        "$(basename "$0")" "$UT_DEFAULTS" >&2
    exit 2
fi
ut_read_config "$UT_CONFIG"
ut_read_config "$UT_DEFAULTS"

# The engine's own name, as it appears in every envelope AND as the suffix of this file's
# name. Name == suffix is deliberate: it lets `t-play --engine bili` find `t-engine-bili` by
# string concatenation, with no name->command registry to keep in sync. docs/ARCHITECTURE.md「命令拓扑」.
ENGINE_NAME="bili"
PROG="t-engine-bili"

# ==============================================================================
# 1. SETTINGS
# ==============================================================================

# THE ENDPOINTS. Every one of them is a public web endpoint, and none takes a credential.
#
# UNPREFIXED, every one: the prefix IS config reachability — ut_read_config accepts every
# UT_/YT_/BILI_/NE_ name that is not in its refusal list — so a BILI_ spelling would be taken
# off disk and then silently overwritten by the line that declares it. A constant must not
# wear a settable name. ARCHITECTURE.md「两个根数据文件」.
SEARCH_ENDPOINT="https://api.bilibili.com/x/web-interface/search/type"

# THE PARTS ENDPOINTS — how --items reads one video's `?p=N` parts. `view` is PREFERRED,
# `/x/player/pagelist` is the FALLBACK: the two return the same per-part rows for the same
# cost, and only `view` also carries `.data.bvid`, `.data.title` and `.data.duration`.
#
# WHY THERE IS A FALLBACK AT ALL — measured 2026-09-01, from two different networks:
#
#     view      bare / + buvid3 / + an spi-issued buvid3+buvid4 / + a full browser header
#               set / either Referer / bvid or aid   ->  412, every combination
#     pagelist  bare                                 ->  200, code 0, all 200 parts
#     search/type  bare -> 412,  + buvid3 -> 200
#
# So `view` began refusing this client outright three days after a run that recorded it
# answering a bare request with 200, while `pagelist` and the search endpoint still answer.
# The buvid3 that rescues `search/type` does NOT rescue `view` — which is the measurement that
# keeps a device id out of these requests. `view` is still ATTEMPTED FIRST: it has the better
# answer, the refusal is the site's current posture rather than a law, and the second request
# is only ever spent where the first has already been refused.
VIEW_ENDPOINT="https://api.bilibili.com/x/web-interface/view"
PAGELIST_ENDPOINT="https://api.bilibili.com/x/player/pagelist"

# THE AUDIO-MENU ENDPOINTS, one GET each per page:
#
#   menu/info      the menu's own record: `.data.title`, and — the reason it is called at all
#                  — whether the menu EXISTS. Measured 2026-09-10: an am id nobody ever
#                  created answers HTTP 200, `code: 0`, `msg: "success"` and `data: null`. So
#                  the body code is no answer here and the id is judged by the SHAPE of what
#                  came back.
#   song/of-menu   the tracks: `.data.totalSize` and `.data.data[]{id,title,duration}`, with
#                  duration already in seconds. It cannot stand in for that existence check:
#                  a menu that does not exist answers `code: 0` with `totalSize: 0` and an
#                  empty array — the same body an existing EMPTY menu returns.
#
# Both live under the `music-service-c` host, which ignores Accept-Encoding and answers gzip
# whatever is asked: a curl without --compressed gets binary (measured). Every curl in this
# file carries it.
MENU_INFO_ENDPOINT="https://www.bilibili.com/audio/music-service-c/web/menu/info"
OF_MENU_ENDPOINT="https://www.bilibili.com/audio/music-service-c/web/song/of-menu"

# THE VIDEO-SIDE CONTAINER ENDPOINTS — a favourites list and a collection, each with its own
# host, its own page size and its own way of saying "does not exist" (measured 2026-09-12):
#
#   fav/folder/info      the list's own record, and the EXISTENCE check: a media_id nobody ever
#                        created answers 200 / `code: 0` / `data.title: null`, so here too the
#                        code says nothing and the shape says everything.
#   fav/resource/list    the entries, `ps` capped at 40 (`ps=41` answers `code -400`). It carries
#                        its OWN `data.has_more`, which is why this engine does not derive one
#                        for favourites: the site is the authority on its own tail.
#   seasons_archives_list  a collection's videos, `page_size` capped at 100 (`101` -> `-400`).
#                        This one DOES answer existence in the code (`-404`, "啥都木有"), so no
#                        second request buys anything. It also ignores `mid` entirely — the same
#                        season_id answers identically for mid 0, 1 and the real uploader — so
#                        the uid in the URL is carried for the canonical url and nothing else.
FAV_INFO_ENDPOINT="https://api.bilibili.com/x/v3/fav/folder/info"
FAV_LIST_ENDPOINT="https://api.bilibili.com/x/v3/fav/resource/list"
SEASON_ENDPOINT="https://api.bilibili.com/x/polymer/web-space/seasons_archives_list"

# THE REFERERS. The site root is REQUIRED by search — with it the endpoint answers code:0,
# without it 412 (measured 2026-08-23) — and is sent everywhere else for the same stale-client
# reason as the UA. It is a public constant, not an authentication mechanism: every Bilibili
# extractor in yt-dlp sends the same one. The space endpoint is the one request that needs a
# REFERER OF ITS OWN: bare curl answers `{"code":-352}`, and a desktop UA plus the space origin
# clears it (measured both ways, 2026-09-12).
SITE_REFERER="https://www.bilibili.com/"
SPACE_REFERER="https://space.bilibili.com/"

# The server's page sizes, not ours. Search pages at 20 regardless of what is asked, so `-n`
# spans pages without the caller knowing. An audio menu pages at 100 (ps=101 answers code
# 4511000 and no data), a favourites list at 40, a collection at 100 — each measured.
PAGE_SIZE=20
ITEMS_PAGE=100
FAV_PAGE=40
SEASON_PAGE=100
# One --items call spends at most this many rows' worth of pages. A caller learns it was
# truncated from the envelope, where `count` below `total` says so, and asks for the REST with
# the cursor the envelope hands back. ARCH-engine.md「容器（--items）」.
ITEMS_MAX=500

# A buvid3 is a DEVICE identifier, not a credential: no account, no token, nothing read from a
# browser profile — this engine generates a random one and throws it away when the process
# exits. Search sends it because without it the endpoint rate-limits a burst hard: measured
# 2026-08-23 over six consecutive searches, anonymous scored 200 200 412 412 412 200 and the
# same six with a stable buvid3 scored 200 six times. The `<uuid>infoc` spelling and the
# generate-locally choice are what yt-dlp does for every Bilibili request it makes.
#
# ONE per process, generated lazily and reused across pages: a fresh identifier on every page
# would present the burst as several brand-new devices, which is the shape the limiter is
# looking for. Overridable so a caller that has its own can pass it. If `uuidgen` is missing
# the engine degrades to anonymous rather than failing.
BILI_BUVID="${BILI_BUVID:-}"

# Cookies (login) are ON by default (browser: chrome), for --stream and --info — yt-dlp's
# verbs. On this site they buy AUDIO QUALITY rather than access: an account — more so a
# premium one — is offered Hi-Res / Dolby / lossless renditions an anonymous client is not.
# Public videos resolve fine without them, so an absent profile degrades to anonymous.
# Set BILI_COOKIE_BROWSER=none to force anonymous-only (skips the keychain read).
COOKIE_ARGS=()
if [[ -n "${BILI_COOKIE_BROWSER:-}" && "$BILI_COOKIE_BROWSER" != "none" ]]; then
    browser_exists=0
    case "$BILI_COOKIE_BROWSER" in
    chrome|chromium|brave)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            if [[ -d "$HOME/Library/Application Support/Google/Chrome" || -d "$HOME/Library/Application Support/BraveSoftware" || -d "$HOME/Library/Application Support/Chromium" ]]; then
                browser_exists=1
            fi
        else
            if [[ -d "$HOME/.config/google-chrome" || -d "$HOME/.config/chromium" || -d "$HOME/.config/BraveSoftware" ]]; then
                browser_exists=1
            fi
        fi
        ;;
    safari)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Safari" ]] && browser_exists=1
        fi
        ;;
    firefox)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Firefox" ]] && browser_exists=1
        else
            [[ -d "$HOME/.mozilla/firefox" ]] && browser_exists=1
        fi
        ;;
    edge)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Microsoft Edge" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/microsoft-edge" ]] && browser_exists=1
        fi
        ;;
    opera)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/com.operasoftware.Opera" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/opera" ]] && browser_exists=1
        fi
        ;;
    vivaldi)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Vivaldi" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/vivaldi" ]] && browser_exists=1
        fi
        ;;
    *)
        browser_exists=0
        ;;
    esac

    if ((browser_exists)); then
        COOKIE_ARGS=(--cookies-from-browser "$BILI_COOKIE_BROWSER")
    fi
fi

ACTION=""            # search | stream | info | items | auth | capabilities
VERB_FLAG=""         # the verb flag as typed — the one-verb-per-invocation gate reads it
COLOR_MODE="auto"
OUTPUT_MODE="list"   # list (prose) | json | json_full

# --search. The `-n` and --sort defaults are cross-engine: a caller who wants a different
# result count by default wants it from whichever source they asked. ARCH-cli-contract.md「配置面」.
NUM_RESULTS=$UT_SEARCH_RESULTS
MIN_DURATION=0
MAX_DURATION=0
SORT_FIELD="$UT_SORT_FIELD"
QUERY=""
FILTERED_JSON=""

# --stream. The `-f` default is cross-engine too: a user who listens rather than watches
# says so once.
PLAYBACK_MODE="$UT_PLAY_MODE"
FORMAT_SORT=""
QUALITY="auto"       # auto | low | medium | high — the tier abstraction (--quality)
FMT=""               # the yt-dlp format string the mode resolves to

TARGET=""            # the handle as the caller typed it
TARGET_URL=""        # the watch URL it normalises to
TARGET_START=""      # ?t= seconds carried by the handle, or "" — see parse_start_seconds
CONTAINER_KIND=""    # am | fav | season | series | video — what --items was handed
CONTAINER_ID=""      # the id --items resolves to (digits; the BV/av id for a video)
CONTAINER_MID=""     # the uploader id a collection URL carried, "" for the other kinds
CONTAINER_URL=""     # the canonical container URL
CURSOR=""            # the --cursor token as the caller typed it, "" when absent
CURSOR_OFFSET=0      # the item offset it decodes to; 0 is the first batch

# Glyph fallback shares ONE switch with ting (YT_ASCII, legacy alias YT_TUI_ASCII): a
# terminal whose font can't draw ♫ can't draw it in either surface, and a non-UTF-8 locale
# (bare cron/launchd) would emit mojibake. Empty = drop the glyph, as ting does.
MUSIC_CHAR="♫"
case "${YT_ASCII:-${YT_TUI_ASCII:-}}" in
1 | true | yes | on) MUSIC_CHAR="" ;;
"")
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8* | *utf-8* | *UTF8* | *utf8*) ;;
    *) MUSIC_CHAR="" ;;
    esac
    ;;
esac

# ==============================================================================
# 2. HELPERS
# ==============================================================================

err() {
    local red='' reset=''
    case "${COLOR_MODE:-auto}" in
    always)
        red=$'\033[31m'
        reset=$'\033[0m'
        ;;
    auto)
        if [[ -t 2 ]]; then
            red=$'\033[31m'
            reset=$'\033[0m'
        fi
        ;;
    never) ;;
    esac
    echo "${red}Error:${reset} $*" >&2
}

die() {
    err "$@"
    exit 1
}

# A missing tool is not a malformed call: `die` is exit 1 (the argv is wrong — fix it),
# `die_dep` is exit 2 (the argv was fine; the machine is missing something no rewrite of the
# argv will supply). An agent that read 1 here would loop editing its own parameters against
# a wall. docs/ARCH-cli-contract.md「退出码、TTY、依赖」.
die_dep() {
    err "required command not found: $1"
    exit 2
}

is_non_negative_int() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

validate_enum() {
    local value=$1
    shift
    local allowed
    for allowed in "$@"; do
        if [[ "$value" == "$allowed" ]]; then
            return 0
        fi
    done
    return 1
}

# ONE VERB PER INVOCATION. A caller who names two verbs has not said what it wants, and the
# gate model answers that by refusing rather than by guessing (ARCH-cli-contract.md「门模型」).
set_action() {
    local action=$1 flag=$2
    if [[ -n "$VERB_FLAG" && "$VERB_FLAG" != "$flag" ]]; then
        die "$VERB_FLAG and $flag are two verbs — pass one"
    fi
    VERB_FLAG="$flag"
    ACTION="$action"
}

require_cmd() {
    local cmd=$1
    command -v "$cmd" >/dev/null 2>&1 || die_dep "$cmd"
}

require_deps() {
    local cmd
    for cmd in "$@"; do
        require_cmd "$cmd"
    done
}

# The ONE implementation of duration formatting: seconds -> "[Nd ]HHh:MMm:SSs". A jq
# prelude, not a bash function, so a caller already shaping JSON pays one fork instead of
# one per row. The shared fact is the FORMAT, stated once in docs/ARCH-engine.md「搜索子系统」.
#
# bili_secs is the site-specific half: search's `duration` arrives as "MM:SS" with UNBOUNDED
# minutes and an UNPADDED seconds field ("222:28", "416:0", "682:4" all measured in one
# response). Parsing it here is what keeps every surface above reading plain seconds. A field
# that is missing, empty, or non-numeric yields null, and null renders as "--" rather than as
# a confident 00h:00m:00s.
#
# strip_t drops a `t=` from a URL yt-dlp hands back, because the start offset travels in
# `start_seconds` and a URL that also carried it would store a different record per offset.
JQ_PRELUDE='
def p2: tostring | if length < 2 then "0" + . else . end;
def fmt_dur:
  if type != "number" then null
  else (. | floor) as $t
    | ($t / 86400 | floor) as $d
    | (($t % 86400) / 3600 | floor) as $h
    | (($t % 3600) / 60 | floor) as $m
    | ($t % 60) as $s
    | (if $d > 0 then "\($d)d " else "" end) + "\($h | p2)h:\($m | p2)m:\($s | p2)s"
  end;
def bili_secs:
  if type == "number" then floor
  elif type != "string" or . == "" then null
  else (split(":") | map(tonumber? // null)) as $p
    | if ($p | any(. == null)) then null
      elif ($p | length) == 3 then ($p[0] * 3600 + $p[1] * 60 + $p[2])
      elif ($p | length) == 2 then ($p[0] * 60 + $p[1])
      elif ($p | length) == 1 then $p[0]
      else null end
  end;
def strip_t:
  if type != "string" then .
  else gsub("&t=[^&#]*"; "")
     | gsub("\\?t=[^&#]*&"; "?")
     | gsub("\\?t=[^&#]*(?<e>#|$)"; "\(.e)")
  end;
# THE COVER, normalised to one directly-GETtable https URL — the site field name stops here.
# It arrives PROTOCOL-RELATIVE — measured 2026-09-01 and again 2026-09-03,
# `//i0.hdslb.com/bfs/archive/<hash>.jpg` on every search row — so the scheme is the
# difference between a URL curl can fetch and a path it cannot. Anything that is not a
# non-empty string is null, and the key stays present (ARCH-cli-contract.md「数据契约」).
def https_cover:
  (. // "") as $p
  | if ($p | type) != "string" or $p == "" then null
    elif ($p | startswith("//")) then "https:" + $p
    elif ($p | startswith("http://")) then ($p | sub("^http://"; "https://"))
    elif ($p | startswith("https://")) then $p
    else null
    end;
'

# Search titles come back as SEARCH-RESULT HTML, not as text: the matched query is wrapped in
# <em class="keyword">…</em> and the rest is entity-escaped. Both have to go, and they have to
# go HERE — the width layer above measures display cells, so a title still carrying 24
# characters of markup reflows every row wrongly at a narrow width.
#
# `&amp;` is unescaped LAST on purpose. A title containing the literal text `&lt;` arrives as
# `&amp;lt;`; unescaping &amp; first would turn it into `&lt;` and the next rule would turn
# that into `<`, inventing markup the uploader never wrote.
JQ_CLEAN_TITLE='
def clean_title:
  if type != "string" then null
  else gsub("<[^>]*>"; "")
    | gsub("&quot;"; "\"") | gsub("&#39;"; "\u0027") | gsub("&apos;"; "\u0027")
    | gsub("&lt;"; "<") | gsub("&gt;"; ">") | gsub("&nbsp;"; " ")
    | gsub("&amp;"; "&")
  end;
'

# Map captured yt-dlp output + exit code to the suite's stable reason taxonomy so an agent
# caller can branch on `reason` instead of string-matching raw extractor wording. The ENUM is
# the shared fact and lives in ARCH-cli-contract.md「数据契约」 — no member may be added here
# that the enum does not already have; `unknown` is the conservative default.
#
# HTTP 412 and the body code -352 are how this host says "rate limited", and they land in
# `network` — the member that already means RETRYABLE — for the reason 429 does:
# `forbidden` would tell a caller these credentials never work.
classify_yt_dlp_error() {
    local text=$1 rc=$2
    if ((rc == 130)); then
        echo "stopped_by_user"
        return
    fi
    # The browser's cookie store could not be read, before any request was made. First,
    # because it says nothing about the site.
    if grep -qiE 'could not (find|copy) [a-z]+ cookies? database|failed to decrypt|cannot decrypt|find-generic-password|keyring|keychain|\[Errno [0-9]+\][^:]*: .*(Cookies|cookies\.sqlite|binarycookies)' <<<"$text"; then
        echo "cookies"
        return
    fi
    if grep -qiE 'HTTP Error 412|[^0-9-]-352[^0-9]|risk control|Precondition Failed' <<<"$text"; then
        echo "network"
        return
    fi
    if grep -qiE 'HTTP Error 403|[^a-z]403[^0-9]|Forbidden' <<<"$text"; then
        echo "forbidden"
        return
    fi
    if grep -qiE 'may be deleted or geo-restricted|Video unavailable|Private video|has been removed|no longer available|does not exist|paid video|premium|大会员|需要登录' <<<"$text"; then
        echo "unavailable"
        return
    fi
    if grep -qiE 'Requested format is not available|No video formats|requested format|only images are available' <<<"$text"; then
        echo "format_unavailable"
        return
    fi
    if grep -qiE 'Temporary failure in name resolution|Failed to resolve|Name or service not known|Network is unreachable|Connection (refused|timed out|reset)|Could not connect|getaddrinfo|Timed out|Operation timed out|HTTP Error 429|Too Many Requests|Unable to download (webpage|API page|JSON metadata)' <<<"$text"; then
        echo "network"
        return
    fi
    echo "unknown"
}

# The same enum read off a hand-built request: curl's status, the HTTP status, the body's own
# `code`, and whether the body was a risk-control challenge (see search_page_once).
#
# THREE LAYERS, ALL CHECKED. This host says "no" in three places: an HTTP status, a `code`
# inside a body served with HTTP 200, and — the quietest — a body served with HTTP 200 AND
# code:0 that carries a risk-control voucher instead of results. Reading only the first reports
# a rate limit as a success with zero results; reading only the first two reports a captcha
# challenge the same way.
#
# The distinction that earns the code table its lines: a bogus id answers HTTP 200 / code -400
# (measured), and calling that `network` would tell an agent to retry forever a handle that
# will never resolve.
classify_http_error() {
    local curl_rc=$1 http=$2 code=$3 risk=${4:-0}
    # curl never got an answer: DNS, connection refused, TLS, timeout. All transport.
    if ((curl_rc != 0)); then
        echo "network"
        return
    fi
    # A risk-control challenge is the same bursty limiter the 412 is, wearing a success's
    # clothes — so it gets the same retryable member, checked before the tables that read
    # it as fine.
    if ((risk)); then
        echo "network"
        return
    fi
    case "$http" in
    412 | 429 | 5??) echo "network"; return ;;
    403) echo "forbidden"; return ;;
    404) echo "unavailable"; return ;;
    esac
    case "$code" in
    -352 | -412 | -509 | -799) echo "network"; return ;;
    -403 | 62002) echo "forbidden"; return ;;
    -404 | -400) echo "unavailable"; return ;;
    esac
    echo "unknown"
}

# ONE TRANSPORT FOR EVERY HAND-BUILT REQUEST. Arguments reach curl as an ARRAY and values
# through --data-urlencode, so nothing in a handle or a query can be read as a further curl
# argument or a second parameter. Sets HTTP_RC / HTTP_STATUS / HTTP_CODE and leaves the body on
# disk; success is all three of curl exiting 0, HTTP 200 and a body `code` of 0 — this host
# answers 200 with a negative body code for a video that is gone. Globals rather than a return
# value because three of them travel together and a command substitution would lose the file.
#
# NO RETRY HERE. The one retry this file makes is search's, for a BURST (search_page); every
# other verb spends one request per question, and a retry there would be a request made on the
# caller's behalf without being asked. `network` already means retryable.
HTTP_RC=0
HTTP_STATUS=""
HTTP_CODE=""
http_get() { # <body> <referer> <url> [curl args...]
    local body=$1 referer=$2 url=$3
    shift 3
    local cmd=(
        curl -sS --compressed
        --max-time 15 --retry 0
        -o "$body" -w '%{http_code}'
        -G "$url"
        -H "User-Agent: $BILI_UA"
        -H "Referer: $referer"
        "$@"
    )
    HTTP_RC=0
    HTTP_STATUS=$("${cmd[@]}" 2>/dev/null) || HTTP_RC=$?
    HTTP_CODE=""
    if [[ -s "$body" ]]; then
        HTTP_CODE=$(jq -r '.code // empty' "$body" 2>/dev/null) || HTTP_CODE=""
    fi
    ((HTTP_RC == 0)) && [[ "$HTTP_STATUS" == "200" && "$HTTP_CODE" == "0" ]]
}

http_reason() {
    classify_http_error "$HTTP_RC" "$HTTP_STATUS" "$HTTP_CODE" "${1:-0}"
}

# ── the cookie store, diagnosed ─────────────────────────────────────────────────────────
# yt-dlp words several different causes as ONE sentence. A folder the calling terminal app
# is not allowed into (macOS privacy protection) is walked as empty and reported "could not
# find … cookies database" — the same words as a browser that was never used, and the same
# command then works from another terminal. cookie_probe tells them apart by doing what
# yt-dlp does: list the browser's folder, find its newest cookie file, read one byte of it.
# `[ -r ]` would not do: it consults Unix permissions, and privacy protection sits above
# them. Local — no network, no Keychain. The paths are site knowledge, so each engine carries
# its own copy (ARCH-engine.md, the anonymous-fallback section).
COOKIE_STATE=""; COOKIE_PATH=""; COOKIE_ERR=""
cookie_denied() {
    COOKIE_ERR=$1
    if [[ "$1" == *"Operation not permitted"* && "$(uname -s)" == "Darwin" ]]; then
        COOKIE_STATE="blocked"
    else
        COOKIE_STATE="denied"
    fi
    return 0
}
cookie_probe() {
    COOKIE_STATE="unknown"; COOKIE_PATH=""; COOKIE_ERR=""
    local b=$1 root="" name="Cookies" as="$HOME/Library/Application Support" mac=0 f newest="" err
    if [[ "$(uname -s)" == "Darwin" ]]; then mac=1; fi
    case "$b" in
    chrome)   if ((mac)); then root="$as/Google/Chrome"; else root="$HOME/.config/google-chrome"; fi ;;
    chromium) if ((mac)); then root="$as/Chromium"; else root="$HOME/.config/chromium"; fi ;;
    brave)    if ((mac)); then root="$as/BraveSoftware/Brave-Browser"; else root="$HOME/.config/BraveSoftware/Brave-Browser"; fi ;;
    edge)     if ((mac)); then root="$as/Microsoft Edge"; else root="$HOME/.config/microsoft-edge"; fi ;;
    opera)    if ((mac)); then root="$as/com.operasoftware.Opera"; else root="$HOME/.config/opera"; fi ;;
    vivaldi)  if ((mac)); then root="$as/Vivaldi"; else root="$HOME/.config/vivaldi"; fi ;;
    firefox)  name="cookies.sqlite"
              if ((mac)); then root="$as/Firefox"; else root="$HOME/.mozilla/firefox"; fi ;;
    safari)   ((mac)) || return 0
              name="Cookies.binarycookies"
              root="$HOME/Library/Containers/com.apple.Safari/Data/Library/Cookies"
              if [[ ! -d "$root" ]]; then root="$HOME/Library/Cookies"; fi ;;
    *) return 0 ;;
    esac
    COOKIE_PATH=$root
    if [[ ! -e "$root" ]]; then COOKIE_STATE="missing"; return 0; fi
    if ! err=$(ls "$root" 2>&1 >/dev/null); then cookie_denied "$err"; return 0; fi
    # Newest wins because that is the profile yt-dlp itself picks when none is named.
    while IFS= read -r f; do
        if [[ -z "$newest" || "$f" -nt "$newest" ]]; then newest=$f; fi
    done < <(find "$root" -maxdepth 3 -type f -name "$name" 2>/dev/null)
    if [[ -z "$newest" ]]; then COOKIE_STATE="missing"; return 0; fi
    COOKIE_PATH=$newest
    if ! err=$(head -c1 "$newest" 2>&1 >/dev/null); then cookie_denied "$err"; return 0; fi
    COOKIE_STATE="readable"
    return 0
}
# The app to name in the fix. TERM_PROGRAM is what the terminal says it is; tmux and screen
# replace it with themselves, and then the honest answer is that we cannot tell.
terminal_app() {
    case "${TERM_PROGRAM:-}" in
    Apple_Terminal) echo "Terminal" ;;
    iTerm.app) echo "iTerm" ;;
    ghostty) echo "Ghostty" ;;
    vscode) echo "VS Code" ;;
    WezTerm) echo "WezTerm" ;;
    WarpTerminal) echo "Warp" ;;
    "" | tmux | screen)
        if [[ "${TERM:-}" == "xterm-kitty" ]]; then echo "kitty"; else echo "your terminal app"; fi ;;
    *) echo "$TERM_PROGRAM" ;;
    esac
}
# ONE line on stderr that says what was lost, why, and the fix. stderr and not the envelope:
# it is prose for a person, and the -j envelope keeps its shape (ARCH-cli-contract.md).
cookie_diagnosis() {
    local b=${BILI_COOKIE_BROWSER:-} first="" app prog="$PROG" knob="BILI_COOKIE_BROWSER"
    cookie_probe "$b"
    first=$(printf '%s\n' "$1" | grep -m1 'ERROR' | sed 's/^ERROR: //') || first=""
    case "$COOKIE_STATE" in
    blocked)
        app=$(terminal_app)
        printf '%s: no %s cookies: macOS blocks %s from reading them - grant it Full Disk Access (System Settings > Privacy & Security), restart it; or set %s=none\n' \
            "$prog" "$b" "$app" "$knob" ;;
    denied)
        printf '%s: no %s cookies: %s reading %s; or set %s=none\n' \
            "$prog" "$b" "${COOKIE_ERR##*: }" "$COOKIE_PATH" "$knob" ;;
    missing)
        printf '%s: no %s cookies: %s has no cookie database - sign in to it once; or set %s=none (looked under %s)\n' \
            "$prog" "$b" "$b" "$knob" "$COOKIE_PATH" ;;
    readable)
        case "$b" in
        firefox | safari)
            printf '%s: no %s cookies: %s; or set %s=none\n' \
                "$prog" "$b" "${first:-yt-dlp could not load them}" "$knob" ;;
        *)
            printf '%s: no %s cookies: they could not be decrypted - allow Keychain access to "%s Safe Storage" when macOS asks; or set %s=none\n' \
                "$prog" "$b" "$b" "$knob" ;;
        esac ;;
    *)
        printf '%s: no %s cookies: %s; or set %s=none\n' \
            "$prog" "$b" "${first:-yt-dlp could not load them}" "$knob" ;;
    esac
    return 0
}
# Run one yt-dlp command ("$@", cookie args NOT included) with the configured cookie store,
# and once more WITHOUT it when the store itself is what failed — only then, so a network
# error is not paid for twice. stdout is the command's; yt-dlp's stderr lands in ERR_FILE for
# the caller's classifier; the diagnosis goes to this process's stderr.
ytdlp_cookied() {
    local out="" rc=0
    if ((${#COOKIE_ARGS[@]} > 0)); then
        out=$("$@" "${COOKIE_ARGS[@]}" 2>"$ERR_FILE") || rc=$?
        if ((rc != 0)) || [[ -z "$out" ]]; then
            if [[ "$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")" == "cookies" ]]; then
                cookie_diagnosis "$(cat "$ERR_FILE" 2>/dev/null)" >&2
                rc=0
                out=$("$@" 2>"$ERR_FILE") || rc=$?
            fi
        fi
    else
        out=$("$@" 2>"$ERR_FILE") || rc=$?
    fi
    printf '%s' "$out"
    return "$rc"
}

# This process's own scratch dir: 0700, created lazily, removed however we exit. Lazily
# because -h / -V must answer without touching the filesystem, and process-level rather
# than a function `local` because the EXIT trap runs after the function has returned — a
# `local` would be out of scope there and abort under `set -u`.
#
# 0700 rather than a bare /tmp path because a response body is content and the captured yt-dlp
# stderr can name a cookie database. `players/` has exactly one owner (t-play), not this file.
SCRATCH_DIR=""
ERR_FILE=""
cleanup_scratch() {
    [[ -n "$SCRATCH_DIR" ]] && rm -rf "$SCRATCH_DIR" 2>/dev/null
    return 0
}
trap cleanup_scratch EXIT

ensure_scratch() {
    [[ -n "$SCRATCH_DIR" ]] && return 0
    SCRATCH_DIR=$(mktemp -d "${TMPDIR:-/tmp}/t-engine-bili.XXXXXX") || die "cannot create a scratch directory"
    chmod 700 "$SCRATCH_DIR" 2>/dev/null || true
    ERR_FILE="$SCRATCH_DIR/yt-dlp.err"
    : >"$ERR_FILE"
}

is_json_out() {
    [[ "$OUTPUT_MODE" == "json" || "$OUTPUT_MODE" == "json_full" ]]
}

# ==============================================================================
# 3. HANDLES — what a Bilibili URL or id looks like
# ==============================================================================

# The hostname a URL names — lowercased, with userinfo, port, path, query and fragment
# removed. Lowercasing goes through `tr` because the parameter-expansion form for it is a
# bash-4 feature and the floor here is 3.2; one fork per invocation.
url_host() {
    local h=$1
    h="${h#*://}"
    h="${h%%/*}"
    h="${h%%\?*}"
    h="${h%%#*}"
    h="${h##*@}"
    h="${h%%:*}"
    printf '%s' "$h" | tr 'A-Z' 'a-z'
}

# Is this host THIS engine's? One engine, one site. An engine that resolves someone else's
# URL is lying in the `engine` field, and that field's whole job is letting a caller route
# a result back to the resolver that produced it. An explicit list rather than a substring
# test: `*.bilibili.com` matches `m.bilibili.com` and refuses `evilbilibili.com`.
is_own_host() {
    case "$1" in
    bilibili.com | b23.tv) return 0 ;;
    *.bilibili.com | *.b23.tv) return 0 ;;
    esac
    return 1
}

# A URL from another site is a USAGE error (1), not an extraction failure (2+): nothing was
# attempted and nothing is retryable — the caller named the wrong engine.
host_gate() {
    local host
    host=$(url_host "$1")
    is_own_host "$host" ||
        die "'$host' is not a Bilibili host — this engine resolves Bilibili only (another site needs its own engine: t-play --engine NAME)"
}

# Does a search token look like a URL? A URL is a thing to play or inspect, never a query.
looks_like_url() {
    case "$1" in
    http://* | https://* | www.* | bilibili.com/* | b23.tv/*) return 0 ;;
    esac
    return 1
}

# One query parameter's value, or "". Split by hand and ANCHORED: an unquoted expansion would
# glob, and ${var//pat/} is quadratic on bash 3.2 (CLAUDE.md).
query_value() {
    local q=$1 key=$2 v=""
    case "&$q" in
    *"&$key="*)
        v="${q##*"$key="}"
        v="${v%%&*}"
        ;;
    esac
    printf '%s' "$v"
}

# WHICH CONTAINER IS THIS, if any. Sets CONTAINER_KIND / CONTAINER_ID / CONTAINER_MID and
# returns 0; returns 1 and decides nothing when the handle names no container. It neither dies
# nor makes a request, because two verbs ask it different questions: --items asks which
# container this is, and the video verbs ask only whether it is one — so that they can say so
# instead of handing a list to yt-dlp and printing an empty stream.
#
# FOUR SHAPES, one per thing this site calls a list:
#   am<id>                                   an audio menu
#   ml<id>  /medialist/detail/ml<id>         a favourites list
#   space…/<uid>/favlist?fid=<fid>           the same list as the browser spells it
#   space…/<uid>/lists/<sid>?type=season     a collection, and …/channel/collectiondetail?sid=
#
# THE favlist URL NEEDS ARITHMETIC, and it is measured rather than reasoned: the browser URL
# carries the uploader's `fid`, while every API here takes `media_id`, and the two are related
# by `media_id = fid * 100 + uid % 100` (checked against four real lists, 2026-09-12, 4/4).
#
# A SERIES IS NOT A COLLECTION (`?type=series`): it has its own endpoint, so it is recognised
# here only to be refused by name — a wrong list is worse than a rejected one.
container_from_handle() {
    local t=$1 u="" path="" q="" seg="" mid="" sid="" fid=""
    case "$t" in
    am[0-9]*)
        [[ "$t" =~ ^am[0-9]+$ ]] || return 1
        CONTAINER_KIND="am"; CONTAINER_ID="${t#am}"; CONTAINER_MID=""
        return 0
        ;;
    ml[0-9]*)
        [[ "$t" =~ ^ml[0-9]+$ ]] || return 1
        CONTAINER_KIND="fav"; CONTAINER_ID="${t#ml}"; CONTAINER_MID=""
        return 0
        ;;
    http://* | https://*) u="$t" ;;
    bilibili.com/* | www.bilibili.com/* | m.bilibili.com/* | space.bilibili.com/* | b23.tv/*)
        u="https://$t"
        ;;
    *) return 1 ;;
    esac

    path="${u#*://}"
    path="${path#*/}"
    case "$path" in *\?*)
        q="${path#*\?}"
        path="${path%%\?*}"
        ;;
    esac
    path="${path%%#*}"
    path="${path%/}"
    seg="${path##*/}"

    case "$path" in
    */audio/am[0-9]* | audio/am[0-9]*)
        [[ "$seg" =~ ^am[0-9]+$ ]] || return 1
        CONTAINER_KIND="am"; CONTAINER_ID="${seg#am}"; CONTAINER_MID=""
        return 0
        ;;
    */medialist/detail/ml[0-9]* | medialist/detail/ml[0-9]*)
        [[ "$seg" =~ ^ml[0-9]+$ ]] || return 1
        CONTAINER_KIND="fav"; CONTAINER_ID="${seg#ml}"; CONTAINER_MID=""
        return 0
        ;;
    esac

    # Everything left is a space.bilibili.com path, which always opens with the uploader's uid.
    mid="${path%%/*}"
    [[ "$mid" =~ ^[0-9]+$ ]] || return 1
    case "$path" in
    */favlist)
        fid=$(query_value "$q" fid)
        [[ "$fid" =~ ^[0-9]+$ ]] || return 1
        CONTAINER_KIND="fav"; CONTAINER_MID="$mid"
        CONTAINER_ID=$((fid * 100 + mid % 100))
        return 0
        ;;
    */channel/collectiondetail)
        sid=$(query_value "$q" sid)
        [[ "$sid" =~ ^[0-9]+$ ]] || return 1
        CONTAINER_KIND="season"; CONTAINER_ID="$sid"; CONTAINER_MID="$mid"
        return 0
        ;;
    */channel/seriesdetail)
        CONTAINER_KIND="series"; CONTAINER_ID=""; CONTAINER_MID="$mid"
        return 0
        ;;
    */lists/[0-9]*)
        [[ "$seg" =~ ^[0-9]+$ ]] || return 1
        if [[ "$(query_value "$q" type)" == "series" ]]; then
            CONTAINER_KIND="series"; CONTAINER_ID="$seg"; CONTAINER_MID="$mid"
            return 0
        fi
        CONTAINER_KIND="season"; CONTAINER_ID="$seg"; CONTAINER_MID="$mid"
        return 0
        ;;
    esac
    return 1
}

# The ?t= seconds a handle carries, floored to a whole second, or "" when it carries none.
#
# This engine parses the timestamp ITSELF, and that asymmetry with the YouTube engine is
# measured, not stylistic: yt-dlp's YouTube extractor publishes .start_time for every writing
# that site has, and its Bilibili extractor publishes the key in NO form at all (measured
# 2026-08-30 against yt-dlp 2026.08.19: ?t=601, ?t=601.5 and ?p=2&t=60 all come back with no
# start_time). Only `?t=` is read, because only `?t=` was measured to exist here.
#
# Split by hand rather than `for p in $q` — an unquoted expansion would glob, and a query
# value really can hold a `*`. Every expansion below is ANCHORED (`%%`/`#`), never the
# ${var//pat/} substitution form, which is O(n2) on bash 3.2 (CLAUDE.md).
parse_start_seconds() {
    local url=$1 q p v=""
    case "$url" in
    *\?*) q=${url#*\?} ;;
    *) return 0 ;;
    esac
    q=${q%%#*}
    while [[ -n "$q" ]]; do
        p=${q%%&*}
        case "$q" in
        *\&*) q=${q#*&} ;;
        *) q="" ;;
        esac
        case "$p" in
        t=*) v=${p#t=} ;;
        esac
    done
    # An unreadable value is NOT an error: the envelope says null and the resolve carries on.
    # Fractions floor — the key counts seconds already gone by.
    [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 0
    TARGET_START=${v%%.*}
}

# The part number carried in ?p=N, or empty when N <= 1 or missing.
url_part_number() {
    local u=$1 q="" p=""
    case "$u" in
    *\?*) q="${u#*\?}" ;;
    esac
    q="${q%%#*}"
    case "&$q" in
    *[\&]p=*)
        p="${q##*p=}"
        p="${p%%&*}"
        ;;
    esac
    if [[ "$p" =~ ^[0-9]+$ ]] && ((p > 1)); then
        printf '%s' "$p"
    fi
}

# An audio single handle (/audio/au<digits>), or empty.
url_audio_id() {
    local u="${1%%#*}"
    u="${u%%\?*}"
    u="${u%/}"
    local seg="${u##*/}"
    if [[ "$seg" =~ ^au[0-9]+$ ]]; then
        printf '%s' "$seg"
    fi
}

# The BV/av id inside a normalised watch URL, or empty when it carries none. Both the path
# form (.../video/BV…) and the query form (?bvid=…) are read, because share URLs use both.
target_id() {
    local u="${1%%#*}" q="" seg
    case "$u" in *\?*)
        q="${u#*\?}"
        u="${u%%\?*}"
        ;;
    esac
    u="${u%/}"
    seg="${u##*/}"
    if [[ ! "$seg" =~ ^(BV[A-Za-z0-9]{10}|av[0-9]+)$ ]]; then
        case "&$q" in
        *[\&]bvid=*)
            seg="${q##*bvid=}"
            seg="${seg%%&*}"
            ;;
        *[\&]aid=*)
            seg="${q##*aid=}"
            seg="av${seg%%&*}"
            ;;
        *) seg="" ;;
        esac
        [[ "$seg" =~ ^(BV[A-Za-z0-9]{10}|av[0-9]+)$ ]] || seg=""
    fi
    printf '%s' "$seg"
}

# A handle is either a URL on one of this engine's hosts, or one of this site's two id
# spellings: BV (the modern "BV" + 10 characters, what --search returns as results[].id) or
# av<digits> (the legacy numeric one). Knowing those shapes is ENGINE knowledge.
#
# Every accepted handle collapses to its canonical form:
#   - Video: `https://www.bilibili.com/video/BV...` (or with `?p=N` when N > 1)
#   - Audio track: `https://www.bilibili.com/audio/au...`
#   - Short link: `https://b23.tv/...` (query stripped)
# All tracking parameters (spm_id_from, vd_source, share_source, …) are stripped, keeping the
# persistent stores idempotent across copy-pasting and searching.
normalize_target() {
    local t=$1 host vid part au_id
    case "$t" in
    http://* | https://*)
        host_gate "$t"
        ;;
    bilibili.com/* | www.bilibili.com/* | m.bilibili.com/* | b23.tv/*)
        t="https://$t"
        ;;
    BV*)
        [[ "$t" =~ ^BV[A-Za-z0-9]{10}$ ]] ||
            die "'$t' is not a BV id (expected BV followed by 10 characters)"
        TARGET_URL="https://www.bilibili.com/video/$t"
        return 0
        ;;
    av[0-9]*)
        [[ "$t" =~ ^av[0-9]+$ ]] ||
            die "'$t' is not a Bilibili handle (expected a BV id, an av id, or a URL)"
        TARGET_URL="https://www.bilibili.com/video/$t"
        return 0
        ;;
    am[0-9]* | ml[0-9]*)
        die "'$t' is a container, not a video — use --items to list what is in it"
        ;;
    *)
        die "'$t' is neither a Bilibili URL nor a BV/av id (to search, pass --search)"
        ;;
    esac

    # A CONTAINER URL IS REFUSED BY NAME rather than half-resolved: an album URL handed to
    # yt-dlp comes back status "ok" with an empty stream list, the one answer a caller cannot
    # act on. ARCH-engine.md「容器（--items）」.
    if container_from_handle "$t"; then
        die "'$t' is a container, not a video — use --items to list what is in it"
    fi

    parse_start_seconds "$t"

    vid=$(target_id "$t")
    if [[ -n "$vid" ]]; then
        part=$(url_part_number "$t")
        if [[ -n "$part" ]]; then
            TARGET_URL="https://www.bilibili.com/video/$vid?p=$part"
        else
            TARGET_URL="https://www.bilibili.com/video/$vid"
        fi
        return 0
    fi

    au_id=$(url_audio_id "$t")
    if [[ -n "$au_id" ]]; then
        TARGET_URL="https://www.bilibili.com/audio/$au_id"
        return 0
    fi

    host=$(url_host "$t")
    case "$host" in
    b23.tv | *.b23.tv)
        TARGET_URL="${t%%\?*}"
        return 0
        ;;
    esac

    TARGET_URL="$t"
}

# --items' OWN handle grammar. It takes TWO kinds of thing, because on this site one video
# number can be MANY playable files (`?p=N`), and a multi-part video is a container of parts
# in every way a caller cares about — so its parts are listed by the same verb, in the same
# envelope, as a menu's tracks (docs/PLAN-single-entry.md §3: one thing, one spelling).
#
# The HOST gate fires first: an off-site URL is the same usage error at every verb and must be
# reported before this engine's opinion about what a container looks like. A container is
# tried before a video, so a space URL is never read as a video; a video handle then needs an
# id, because the parts endpoints take `bvid=` / `aid=` and have no URL form. A b23.tv short
# link is a REDIRECT, not a spelling of an id — serving it would mean a request this verb
# deliberately does not make — so it is refused with the handle to pass instead.
normalize_container() {
    local t=$1
    case "$t" in
    http://* | https://*) host_gate "$t" ;;
    esac

    if container_from_handle "$t"; then
        case "$CONTAINER_KIND" in
        am) CONTAINER_URL="https://www.bilibili.com/audio/am$CONTAINER_ID" ;;
        fav) CONTAINER_URL="https://www.bilibili.com/medialist/detail/ml$CONTAINER_ID" ;;
        season) CONTAINER_URL="https://space.bilibili.com/$CONTAINER_MID/lists/$CONTAINER_ID?type=season" ;;
        series)
            die "'$t' is a series, not a collection — this site keeps the two in different endpoints and --items reads collections (…/lists/<sid>?type=season)"
            ;;
        esac
        return 0
    fi

    case "$t" in
    http://* | https://* | bilibili.com/* | www.bilibili.com/* | m.bilibili.com/* | b23.tv/* | BV* | av[0-9]*) ;;
    *)
        die "'$t' is not a Bilibili container — --items takes a video (BV/av id or URL: its parts), an audio menu (am<id>), a favourites list (ml<id> or a favlist URL) or a collection URL (space.bilibili.com/<uid>/lists/<sid>?type=season)"
        ;;
    esac
    normalize_target "$t"
    CONTAINER_ID=$(target_id "$TARGET_URL")
    [[ -n "$CONTAINER_ID" ]] ||
        die "--items needs a BV or av id and '$t' carries none (a b23.tv link is a redirect, not an id — open it once, or pass the BV id --search returns)"
    CONTAINER_KIND="video"
    CONTAINER_URL="https://www.bilibili.com/video/$CONTAINER_ID"
}

# ==============================================================================
# 4. --search (hand-built GETs: no yt-dlp, no credential)
# ==============================================================================

# Report a search that produced nothing usable. 2, not 1: 1 is reserved for usage/validation,
# and a caller branching on the exit code must be able to tell "you called me wrong" from
# "the site did not answer".
search_fail() {
    local reason=$1
    if is_json_out; then
        jq -nc --arg e "$ENGINE_NAME" --arg q "$QUERY" --arg reason "$reason" \
            '{status: "error", engine: $e, query: $q, count: 0, results: [], reason: $reason}'
    else
        echo "Error: search failed for '$QUERY' ($reason)" >&2
    fi
    exit 2
}

ensure_buvid() {
    [[ -n "$BILI_BUVID" ]] && return 0
    command -v uuidgen >/dev/null 2>&1 || return 0
    BILI_BUVID="$(uuidgen)infoc"
    return 0
}

# WHAT THE SITE WILL FILTER FOR US, and why that is a request-count question rather than a
# feature. The endpoint pages at 20 and has no page-size knob, so the only way to spend fewer
# requests on a filtered search is to make each page's 20 rows ones the local pass will keep.
# `duration` is the site's own filter and it is COARSE — four buckets: 1 under 10 minutes, 2
# for 10-30, 3 for 30-60, 4 over 60 (measured 2026-08-26).
#
# A bucket is chosen ONLY when every duration the local bounds would accept falls inside it —
# a superset of the answer, never a narrower cut: a bucket that clipped one accepted row would
# make the server filter change the ANSWER instead of the cost, and the bucket edges are not
# something this engine can know. A window straddling two buckets gets 0 and no server help.
# The local bounds stay in place either way: they are exact, and the bucket is not.
DURATION_BUCKET=0
duration_bucket() {
    local lo=$1 hi=$2
    if ((hi > 0 && hi <= 600)); then
        echo 1
    elif ((lo >= 600 && hi > 0 && hi <= 1800)); then
        echo 2
    elif ((lo >= 1800 && hi > 0 && hi <= 3600)); then
        echo 3
    elif ((lo >= 3600)); then
        echo 4
    else
        echo 0
    fi
}

# The site's `order`, for the one sort field it shares with us. `--sort view_count` asking the
# SITE (order=click) means the 20 rows that arrive are the most-played of the whole result set
# rather than the 20 most relevant re-ordered locally — a correctness gain at identical cost.
# `relevance` is the site's default and sends nothing; `duration` has NO server equivalent and
# stays a local re-order of the fetched set.
ORDER_PARAM=""

# One attempt at one page. PAGE_RISK catches the quiet refusal: HTTP 200, code:0, and a
# `data` holding a v_voucher — a captcha ticket — where the result array should be (measured
# 2026-08-26). Every layer above reads that as a search that found nothing, so it has to be
# caught here, where the body is still in front of us. Both halves are required: an exhausted
# page also omits `result`, and it is not a refusal.
PAGE_RISK=0
search_page_once() {
    local page=$1 body=$2
    local args=(
        --data-urlencode "search_type=video"
        --data-urlencode "keyword=$QUERY"
        --data-urlencode "page=$page"
    )
    ((DURATION_BUCKET > 0)) && args+=(--data-urlencode "duration=$DURATION_BUCKET")
    [[ -n "$ORDER_PARAM" ]] && args+=(--data-urlencode "order=$ORDER_PARAM")
    [[ -n "$BILI_BUVID" ]] && args+=(-H "Cookie: buvid3=$BILI_BUVID")

    local ok=0
    http_get "$body" "$SITE_REFERER" "$SEARCH_ENDPOINT" "${args[@]}" || ok=1
    PAGE_RISK=0
    if [[ -s "$body" ]] &&
        jq -e '(.data.v_voucher // null) != null and (.data.result | type) != "array"' \
            "$body" >/dev/null 2>&1; then
        PAGE_RISK=1
        ok=1
    fi
    return "$ok"
}

# IT RETURNS A STATUS AND WRITES A FILE; IT DOES NOT PRINT AND IT DOES NOT DIE. The caller
# runs it where a search_fail from in here would land its error envelope in a shell variable.
#
# The limiter is bursty rather than sticky: a 412 is very often followed by a 200. One retry,
# once, converts that into a success without turning a failing search into a hammering loop;
# only the retryable class earns it — a `forbidden` or `unavailable` answer will say the same
# thing a second later.
FETCH_REASON=""
search_page() {
    local page=$1
    local body="$SCRATCH_DIR/page.$page.json"
    ensure_buvid

    if ! search_page_once "$page" "$body"; then
        local reason
        reason=$(http_reason "$PAGE_RISK")
        if [[ "$reason" != "network" ]]; then
            FETCH_REASON="$reason"
            return 1
        fi
        sleep "$BILI_RETRY_PAUSE"
        if ! search_page_once "$page" "$body"; then
            FETCH_REASON=$(http_reason "$PAGE_RISK")
            return 1
        fi
    fi

    # An exhausted or empty search omits `data.result` entirely rather than sending [].
    jq -c '.data.result // []' "$body" >"$SCRATCH_DIR/chunk.json" 2>/dev/null ||
        echo '[]' >"$SCRATCH_DIR/chunk.json"
    return 0
}

search_fetch() {
    ensure_scratch

    # Decide the request plan ONCE, before the first page: every page of one search asks the
    # same question, and a filter that changed between pages would paginate two result sets.
    DURATION_BUCKET=$(duration_bucket "$MIN_DURATION" "$MAX_DURATION")
    case "$SORT_FIELD" in
    view_count) ORDER_PARAM="click" ;;
    esac

    # Pages are requested only while both the caller still wants rows and the site is still
    # sending them: a short tail must not cost the whole row budget in round trips against a
    # host that rate-limits. PAGE_SIZE is the server's, so pages are an implementation detail
    # of spending a row budget, never a number a caller states.
    local wanted=$NUM_RESULTS
    local pages=$(((wanted + PAGE_SIZE - 1) / PAGE_SIZE))

    local all="$SCRATCH_DIR/all.json"
    echo '[]' >"$all"
    local page=1 got=0
    while ((page <= pages)); do
        local chunk n
        search_page "$page" || search_fail "$FETCH_REASON"
        chunk="$SCRATCH_DIR/chunk.json"
        n=$(jq 'length' "$chunk" 2>/dev/null) || n=0
        ((n == 0)) && break
        jq -c --slurpfile chunk "$chunk" '. + $chunk[0]' "$all" >"$all.tmp" && mv "$all.tmp" "$all"
        got=$((got + n))
        ((got >= wanted)) && break
        page=$((page + 1))
    done

    # The local pass is the EXACT half of a filter the site did coarsely, and it runs even when
    # the site helped. Sort stays a client-side re-order even for view_count, which the site
    # also ordered: the emitted rows must be the published field descending with unknowns last,
    # a promise only this pass can keep. "relevance" keeps the site's own ranking.
    local sort_expr=""
    case "$SORT_FIELD" in
    duration) sort_expr=' | sort_by(.duration // -1) | reverse' ;;
    view_count) sort_expr=' | sort_by(.view_count // -1) | reverse' ;;
    esac

    local bounds="true"
    ((MIN_DURATION > 0)) && bounds+=" and (.duration != null and .duration > $MIN_DURATION)"
    ((MAX_DURATION > 0)) && bounds+=" and (.duration != null and .duration < $MAX_DURATION)"

    # ONE jq program does the whole shaping. The normalised fields are merged OVER the raw
    # record rather than replacing it, so -J keeps every field the site sent while -j projects
    # the row keys every engine projects — and `title` and `duration` are the cleaned,
    # correctly-typed values in BOTH, so no surface is ever handed the HTML or "MM:SS".
    #
    # `url` is built from the bvid rather than taken from `arcurl`: arcurl is the `av` spelling
    # served over http://, and the canonical BV URL is what a caller can hand straight back.
    #
    # `live_status` is null, not the raw `live_status: 0`: on search_type=video that field is
    # not the suite's is_live/was_live notion at all. A field this engine cannot know is null,
    # and the key is still present (ARCH-cli-contract.md「数据契约」).
    #
    # `kind` and `access` are the ENGINE'S JUDGEMENT about a row, merged LAST. Both are
    # constants here, and that is a MEASURED fact rather than a stub: search_type=video carries
    # no part-count signal — a 200-part video and a single track have byte-identical key sets —
    # while `is_pay` was 0 on every row of every query measured.
    #
    # `select(.url != null)` is the row's own premise: a result is a CALL or it is not a row.
    # search_type=video mixes in `ketang` (paid-course) records carrying no `bvid` — 3 of 20 on
    # "钢琴" — and an EMPTY bvid is TRUTHY in jq, so the url is the honest gate.
    FILTERED_JSON=$(jq "$JQ_PRELUDE $JQ_CLEAN_TITLE"'
        [ .[]
          | . + { id:         (.bvid // null),
                  title:      (.title | clean_title),
                  url:        (if (.bvid // "") == "" then null
                               else "https://www.bilibili.com/video/" + .bvid end),
                  channel:    (.author // null),
                  duration:   (.duration | bili_secs),
                  view_count: (if (.play | type) == "number" then .play else null end),
                  live_status: null,
                  description: (if ((.description // "") | type) == "string"
                                then (.description | clean_title | gsub("\\s+"; " ")
                                      | sub("^ "; "") | sub(" $"; ""))
                                else "" end) }
          | . + { duration_fmt: (.duration | fmt_dur), kind: "track", access: "full",
                  thumbnail: (.pic | https_cover) }
          | select(.url != null)
          | select('"$bounds"') ]'"$sort_expr"' | .[0:'"$wanted"']' "$all")
}

search_run() {
    # -n 0 is a legal, cheap answer: the empty envelope, without a round trip.
    if ((NUM_RESULTS == 0)); then
        FILTERED_JSON='[]'
    else
        search_fetch
    fi

    case "$OUTPUT_MODE" in
    list)
        # Prose, one jq program; unknowns render rather than leaking a raw JSON `null`.
        printf '%s' "$FILTERED_JSON" | jq -r --arg note "$MUSIC_CHAR" '
            to_entries[]
            | (.key + 1) as $i
            | .value
            | (if $note == "" then "" else $note + " " end) + "\($i). \(.title)",
              "  - " + (.duration_fmt // "--"),
              "  - " + (if .view_count == null then "n/a" else (.view_count | tostring) end) + " views",
              "  - \(.url)"'
        ;;
    json_full)
        printf '%s' "$FILTERED_JSON" | jq -c --arg e "$ENGINE_NAME" --arg q "$QUERY" \
            '{status: "ok", engine: $e, query: $q, count: length, results: .}'
        ;;
    *)
        # The same envelope every engine publishes, field for field: a caller that has to
        # branch on which engine answered is a caller for whom the contract has already failed.
        printf '%s' "$FILTERED_JSON" | jq -c --arg e "$ENGINE_NAME" --arg q "$QUERY" \
            '{status: "ok", engine: $e, query: $q, count: length,
              results: map({id, title, url, channel, duration, duration_fmt, view_count,
                            live_status, description, kind, access, thumbnail})}'
        ;;
    esac
}

# ==============================================================================
# 5. --stream (internal: the player's handle -> bytes)
# ==============================================================================

# The yt-dlp format string a playback mode resolves to. This table is the reason format
# selection belongs to the engine and not the player: `bv*+ba/b` is a yt-dlp expression,
# and the player must never learn to read one. t-play sends a MODE and gets back bytes.
format_for_mode() {
    case "$1" in
    video) echo "$BILI_VIDEO_FORMAT" ;;
    fast) echo "$BILI_VIDEO_FORMAT_FAST" ;;
    ascii) echo "$BILI_VIDEO_FORMAT" ;;
    *) echo "$BILI_AUDIO_FORMAT" ;; # audio, viz
    esac
}

# The yt-dlp format-sort a quality tier resolves to, for a given playback mode. Same rule as
# format_for_mode: a caller sends a canonical TIER, and the yt-dlp sort string exists only
# here. auto (or any pair this table maps to "") sends no --format-sort. -S, when the player
# still forwards one, EXPLICITLY wins (ARCH-engine.md「解析」).
quality_sort_for_tier() {
    local mode=$1 tier=$2
    case "$mode" in
    video | fast | ascii)
        case "$tier" in
        low) echo "res:360" ;;
        medium) echo "res:720" ;;
        high) echo "res:1080" ;;
        esac
        ;;
    *) # audio, viz — or absent, format_for_mode's own default arm
        case "$tier" in
        low) echo "+abr" ;;       # smallest bitrate
        medium) echo "abr:128" ;; # capped ~128k
        # high: empty — the default format table already picks the best audio
        esac
        ;;
    esac
}

# ONE yt-dlp call answers the whole question: the media URL(s) for the selected format, the
# per-format http_headers that must accompany them, and the title/duration the player needs.
#
# --no-playlist is load-bearing HERE: this site's music results are overwhelmingly multi-part
# collections, and a 50-track compilation would otherwise expand into 50 extractions. With it,
# the handle resolves to part one in 2.7s (measured). A caller that wants another part says so
# in the URL (`?p=7`), which is what --items hands back per part.
dump_once() {
    local cmd=(yt-dlp --dump-single-json --no-playlist -f "$FMT")
    if [[ -n "$FORMAT_SORT" ]]; then
        cmd+=(--format-sort "$FORMAT_SORT")
    else
        local sort
        sort=$(quality_sort_for_tier "$PLAYBACK_MODE" "$QUALITY")
        [[ -n "$sort" ]] && cmd+=(--format-sort "$sort")
    fi
    (($#)) && cmd+=("$@")
    cmd+=(--no-warnings --quiet "$TARGET_URL")
    "${cmd[@]}" 2>>"$ERR_FILE"
}

# Project a raw yt-dlp record down to [ {url, http_headers} ], VIDEO FIRST. jq's sort is
# stable, so a merge keeps yt-dlp's own ordering within each class and an audio-only selection
# stays a one-element list. The player reads position, not codec: element 0 is what mpv opens,
# element 1 (when present) is its --audio-file.
#
# Credential-bearing headers are STRIPPED. The player turns every header into an mpv
# `--http-header-fields-append=` argument, and mpv's argv is visible in `ps` to every process
# on the machine — so a Cookie carrying this account's SESSDATA would be world-readable for as
# long as playback lasts. This site's records were measured to carry only User-Agent / Accept /
# Accept-Language / Sec-Fetch-Mode / Referer, so today the filter removes nothing; it is here
# so a future extractor change cannot quietly turn a login into a leak.
JQ_STREAMS='
def safe_headers:
  (. // {}) | with_entries(select(.key | ascii_downcase
                                       | . != "cookie" and . != "authorization" and . != "set-cookie"));
[ if (.requested_formats | type) == "array"
  then (.requested_formats[] | {url: .url, http_headers: (.http_headers | safe_headers), vcodec: (.vcodec // "none")})
  else {url: .url, http_headers: (.http_headers | safe_headers), vcodec: (.vcodec // "none")}
  end
]
| map(select(.url != null))
| sort_by(if .vcodec == "none" then 1 else 0 end)
'

# The stream envelope (ARCH-cli-contract.md「数据契约」), key for key the one every engine
# emits, because the player must not be able to tell which engine answered. `format` is the
# format STRING this engine SENT and `selected` is what yt-dlp PICKED ("1080P 高清+30280 -
# audio only"). `http_headers` is a REQUIRED key, and on this site it is never empty in
# practice: the CDN checks Referer, and a bare URL 403s where the same URL with a Referer
# answers 206.
emit_stream() {
    local raw=$1 retried=$2
    local retried_json=false
    ((retried)) && retried_json=true

    if [[ "$OUTPUT_MODE" == "json_full" ]]; then
        printf '%s\n' "$raw" | jq -c '.'
        return 0
    fi
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        printf '%s\n' "$raw" | jq -c \
            --arg engine "$ENGINE_NAME" --arg mode "$PLAYBACK_MODE" --arg format "$FMT" \
            --argjson retried "$retried_json" --argjson start "${TARGET_START:-null}" \
            "$JQ_PRELUDE
             ($JQ_STREAMS) as \$s
             | {status: \"ok\", engine: \$engine,
                id: (.id // null), url: ((.webpage_url // null) | strip_t),
                title: (.title // null), duration: (.duration // null),
                start_seconds: \$start,
                mode: \$mode, format: \$format,
                selected: (.format // null),
                selected_resolution: (.resolution // null),
                stream_urls: [\$s[].url],
                http_headers: (\$s[0].http_headers // {}),
                retried: \$retried}"
        return 0
    fi
    # Prose: the stream URLs, one per line. On this site such a URL is NOT usable on its own;
    # the headers from -j have to go with it.
    printf '%s' "$raw" | jq -r "$JQ_STREAMS | .[].url"
}

# Report a resolve that produced nothing usable. 2+ is a PROPAGATED tool failure and 1 is
# reserved for usage, so a yt-dlp status of 0 or 1 is FLOORED to 2 — yt-dlp exits 1 for an
# unavailable video, and letting that through would make "this video is gone"
# indistinguishable from "you called me wrong".
stream_fail() {
    local rc=$1 reason
    reason=$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")
    ((rc <= 1)) && rc=2
    if is_json_out; then
        jq -nc --arg engine "$ENGINE_NAME" --arg url "$TARGET_URL" \
            --arg mode "$PLAYBACK_MODE" --arg reason "$reason" \
            '{status: "error", engine: $engine, url: $url, mode: $mode, reason: $reason}'
    else
        echo "$PROG: could not resolve a stream for $TARGET_URL ($reason)" >&2
    fi
    exit "$rc"
}

# Cookies are ON by default because on this site they buy audio quality. If the cookie attempt
# FAILS — a locked profile, a denied keychain, an expired session — the anonymous client is
# tried before giving up, because a public video plays either way and losing the Hi-Res
# rendition beats losing the track.
#
# There is deliberately NO fetch probe here. The YouTube engine test-fetches its resolved URL
# because a googlevideo link missing its proof-of-origin token resolves fine and then 403s at
# play time — a YouTube-specific defect. This site has no such failure mode, so the probe would
# be one extra round trip per play against a host that rate-limits, to answer a question that
# cannot come out wrong. A new engine inherits the CONTRACT, not another engine's workarounds.
stream_run() {
    ensure_scratch
    FMT=$(format_for_mode "$PLAYBACK_MODE")

    local raw_c="" rc_c=0 raw_a="" rc_a=0

    if ((${#COOKIE_ARGS[@]} > 0)); then
        raw_c=$(dump_once "${COOKIE_ARGS[@]}") || rc_c=$?
        # The anonymous attempt below already covers a store that cannot be read; this only
        # says so, once, in words (see cookie_diagnosis).
        if ((rc_c != 0)) && [[ "$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc_c")" == "cookies" ]]; then
            cookie_diagnosis "$(cat "$ERR_FILE" 2>/dev/null)" >&2
        fi
        if ((rc_c == 0)) && [[ -n "$raw_c" ]]; then
            emit_stream "$raw_c" 0
            return 0
        fi
        raw_a=$(dump_once) || rc_a=$?
        if ((rc_a == 0)) && [[ -n "$raw_a" ]]; then
            emit_stream "$raw_a" 1
            return 0
        fi
        # The COOKIE attempt's status is reported, not the fallback's: it is the one that
        # describes what the caller asked for.
        stream_fail "$rc_c"
    fi

    # Anonymous-only (BILI_COOKIE_BROWSER=none, or no profile on this machine).
    raw_a=$(dump_once) || rc_a=$?
    if ((rc_a == 0)) && [[ -n "$raw_a" ]]; then
        emit_stream "$raw_a" 0
        return 0
    fi
    stream_fail "$rc_a"
}

# ==============================================================================
# 6. --info (read-only: nothing plays, no mpv, no state file)
# ==============================================================================

# Rich metadata for a video WITHOUT playing. -j projects a lean schema (the raw record carries
# ~40 fields of formats and thumbnails that are pure token ballast); -J returns the full raw
# record; the default is a readable text block.
#
# THE ENVELOPE CARRIES EVERY FIELD A SEARCH ROW DOES — `kind`, `access` and `thumbnail`
# included — so a caller holding a URL instead of a search result can build the same row out of
# it: the same judgement search makes (track/full), and the cover under the same https rule,
# read from yt-dlp's `thumbnail` where search reads the site's `pic`.
info_run() {
    ensure_scratch
    local cmd=(yt-dlp --dump-single-json --no-playlist --skip-download)
    cmd+=(--no-warnings --quiet "$TARGET_URL")

    local raw rc=0
    raw=$(ytdlp_cookied "${cmd[@]}") || rc=$?

    if ((rc != 0)) || [[ -z "$raw" ]]; then
        local reason
        reason=$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")
        if is_json_out; then
            jq -nc --arg engine "$ENGINE_NAME" --arg url "$TARGET_URL" --arg reason "$reason" \
                '{status: "error", engine: $engine, url: $url, reason: $reason}'
            exit 1
        fi
        die "could not fetch metadata for: $TARGET_URL ($reason)"
    fi

    case "$OUTPUT_MODE" in
    json_full)
        printf '%s\n' "$raw" | jq -c '.'
        ;;
    json)
        # `channel` falls back to `uploader`: this extractor fills the uploader field and
        # leaves channel null on some records, and the envelope's shape must not depend on
        # which. live_status is passed through as whatever the record says, or null.
        printf '%s\n' "$raw" | jq -c --arg engine "$ENGINE_NAME" \
            --argjson start "${TARGET_START:-null}" \
            "$JQ_PRELUDE"'{
            status: "ok",
            engine: $engine,
            id, title,
            url: (.webpage_url | strip_t),
            channel: (.channel // .uploader // null),
            uploader: (.uploader // null),
            upload_date: (.upload_date // null),
            duration, duration_fmt: (.duration | fmt_dur),
            start_seconds: $start,
            view_count: (.view_count // null),
            like_count: (.like_count // null),
            live_status: (.live_status // null),
            description: (.description // null),
            kind: "track", access: "full",
            thumbnail: (.thumbnail | https_cover),
            chapters: (if (.chapters | type) == "array"
                       then [.chapters[] | {start_time, end_time, title}]
                       else null end)
        }'
        ;;
    *)
        printf '%s' "$raw" | jq -r --arg note "$MUSIC_CHAR" "$JQ_PRELUDE"'
            (if $note == "" then "" else $note + " " end) + (.title // "(untitled)"),
            "  - channel: \(.channel // .uploader // "?")",
            "  - uploaded: \(.upload_date // "?")",
            ((.duration | fmt_dur) // empty | "  - duration: \(.)"),
            "  - views: \(.view_count // "?")   likes: \(.like_count // "?")",
            (.webpage_url // empty | "  - url: \(.)"),
            (if (.chapters | type) == "array" and (.chapters | length) > 0 then
                "", "Chapters:",
                (.chapters[]
                 | ((.start_time // 0) | floor) as $s
                 | (($s / 60) | floor) as $m
                 | ($s - $m * 60) as $sec
                 | "  " + ($m | tostring) + ":" + (if $sec < 10 then "0" else "" end) + ($sec | tostring) + "  " + (.title // ""))
             else empty end),
            (if (.description // "") != "" then "", "Description:", .description else empty end)'
        ;;
    esac
}

# ==============================================================================
# 7. --items (read-only: hand-built GETs, no yt-dlp, no state file)
# ==============================================================================

# A CONTAINER IS NOT A ROW. A menu holds tens to hundreds of tracks and has no duration of its
# own; what it has is a track count and a cursor, and neither has anywhere to live on a search
# row — so a container gets its own verb and its own envelope. ARCH-engine.md「容器（--items）」.
#
# FIVE THINGS ANSWER IT on this site: an audio menu, a favourites list, a collection — and one
# multi-part VIDEO, whose `?p=N` parts are a list in every way a caller cares about. A
# single-part video lists one part; that is an answer, not an error.
#
# EVERY ITEM IS AN ITEM RECORD: `{engine, id, url, title, duration}` is what t-playlist stores
# and what t-play --queue consumes, so `--items -j` pipes into either with nothing renamed. Each
# record's id and url are the pair resolving that record answers with (measured 2026-09-26:
# yt-dlp reports `BV…_p2` for `?p=2` of a multi-part video, `BV…_p1` even for its bare URL, and
# the bare BV for a single-part one; an audio track reports its digits for `/audio/au…`).
#
# yt-dlp has these endpoints too and is still not used: for a video's parts `--flat-playlist`
# gives no title and no duration, and for a menu it fetches one page of 100 and never pages.

# Exit 2, never 1 and never 4: by the time a request has been made nothing here is the caller's
# usage error, and 4 is the lifecycle/storage code an engine never emits (ARCH-cli-contract.md
# 「数据契约」).
items_fail() {
    local reason=$1
    if is_json_out; then
        jq -nc --arg engine "$ENGINE_NAME" --arg url "$CONTAINER_URL" --arg reason "$reason" \
            '{status: "error", engine: $engine, url: $url, reason: $reason}'
    else
        echo "$PROG: could not list the items of $CONTAINER_URL ($reason)" >&2
    fi
    exit 2
}

# WHAT THE THREE PAGED CONTAINERS DIFFER BY, and it is only ever these six things — so there is
# one paging loop below rather than three. Each collector fills these in, then calls it.
ITEMS_PAGE_SIZE=0       # the site's cap for this endpoint, measured, never a guess
ITEMS_PAGE_PARAM=""     # pn | page_num
ITEMS_SIZE_PARAM=""     # ps | page_size
ITEMS_ROWS_PATH=""      # jq path to the rows on one page
ITEMS_TOTAL_PATH=""     # jq path to the count the site reports
ITEMS_MORE_PATH=""      # jq path to the site's OWN has_more, "" where it has none

ITEMS_TITLE=""          # the container's own name
ITEMS_TOTAL="null"      # what the site says it holds
ITEMS_RAW="[]"          # this batch's rows, upstream shape, unfiltered
ITEMS_TAKEN=0           # how many of them there are — the cursor's arithmetic, not the envelope's
ITEMS_HAS_MORE=false
ITEMS_PAGES=()

# THE PAGING LOOP. Pages are spent only while there is reason to: a short page is the last page,
# the site's own count says when the list is complete, its own has_more says so where it has one,
# and the batch ceiling stops a very long list. A page past the end answers an empty array
# (measured on all three), so the loop cannot run away on a site that keeps saying yes.
#
# THE BATCH IS THE CEILING ROUNDED DOWN TO A WHOLE PAGE (480 for a favourites list of 40s, 500
# for the two 100s), so every offset this verb hands out lands on a page boundary and continuing
# costs no re-reading. A cursor that does NOT land on one is still answered correctly — the loop
# starts at the page holding it and drops the rows before it.
items_page_loop() {
    local endpoint=$1 referer=$2
    shift 2
    local batch=$((ITEMS_MAX / ITEMS_PAGE_SIZE * ITEMS_PAGE_SIZE))
    local pn=$((CURSOR_OFFSET / ITEMS_PAGE_SIZE + 1))
    local skip=$((CURSOR_OFFSET % ITEMS_PAGE_SIZE))
    local page on_page=0 accum=0 i=0 fetched=0 upstream=""

    ITEMS_PAGES=()
    while :; do
        i=$((i + 1))
        page="$SCRATCH_DIR/items-$i.json"
        http_get "$page" "$referer" "$endpoint" "$@" \
            --data-urlencode "$ITEMS_PAGE_PARAM=$pn" \
            --data-urlencode "$ITEMS_SIZE_PARAM=$ITEMS_PAGE_SIZE" ||
            items_fail "$(http_reason)"
        ITEMS_PAGES+=("$page")

        on_page=$(jq -r "($ITEMS_ROWS_PATH // []) | length" "$page" 2>/dev/null) || on_page=0
        [[ "$on_page" =~ ^[0-9]+$ ]] || on_page=0
        if ((i == 1)); then
            ITEMS_TOTAL=$(jq -r "$ITEMS_TOTAL_PATH // \"null\"" "$page" 2>/dev/null) || ITEMS_TOTAL="null"
            [[ "$ITEMS_TOTAL" =~ ^[0-9]+$ ]] || ITEMS_TOTAL="null"
        fi
        if [[ -n "$ITEMS_MORE_PATH" ]]; then
            upstream=$(jq -r "$ITEMS_MORE_PATH // empty" "$page" 2>/dev/null) || upstream=""
        fi

        accum=$((accum + on_page))
        fetched=$((accum - skip))
        ((on_page < ITEMS_PAGE_SIZE)) && break
        ((fetched >= batch)) && break
        [[ "$upstream" == "false" ]] && break
        [[ "$ITEMS_TOTAL" != "null" ]] && ((CURSOR_OFFSET + fetched >= ITEMS_TOTAL)) && break
        pn=$((pn + 1))
    done

    ITEMS_RAW=$(jq -c -s --argjson skip "$skip" --argjson max "$batch" \
        "[ .[] | ($ITEMS_ROWS_PATH // [])[] ] | .[\$skip:] | .[0:\$max]" \
        "${ITEMS_PAGES[@]}" 2>/dev/null) || items_fail "unknown"
    ITEMS_TAKEN=$(printf '%s' "$ITEMS_RAW" | jq 'length' 2>/dev/null) || ITEMS_TAKEN=0
    [[ "$ITEMS_TAKEN" =~ ^[0-9]+$ ]] || ITEMS_TAKEN=0

    # has_more ANSWERS ABOUT THE CONTAINER, not about how many rows survived the filter
    # (ARCH-engine.md「容器（--items）」). Three sources, in the order of how much they know:
    # rows already fetched but cut off by the ceiling settle it outright; then the site's own
    # flag where it publishes one; then the count it reported.
    if ((fetched > ITEMS_TAKEN)); then
        ITEMS_HAS_MORE=true
    elif [[ -n "$upstream" ]]; then
        ITEMS_HAS_MORE="$upstream"
    elif [[ "$ITEMS_TOTAL" != "null" ]] && ((CURSOR_OFFSET + ITEMS_TAKEN < ITEMS_TOTAL)); then
        ITEMS_HAS_MORE=true
    else
        ITEMS_HAS_MORE=false
    fi
    [[ "$ITEMS_HAS_MORE" == "true" ]] || ITEMS_HAS_MORE=false
}

# The audio menu. Its own record answers EXISTENCE (see THE AUDIO-MENU ENDPOINTS), checked
# before the tracks, so a typo costs one request and is reported as a statement about the HANDLE.
items_am_rows() {
    local info="$SCRATCH_DIR/menu-info.json"
    http_get "$info" "$SITE_REFERER" "$MENU_INFO_ENDPOINT" \
        --data-urlencode "sid=$CONTAINER_ID" ||
        items_fail "$(http_reason)"
    jq -e '(.data | type) == "object"' "$info" >/dev/null 2>&1 ||
        items_fail "unavailable"
    ITEMS_TITLE=$(jq -r '.data.title // empty' "$info" 2>/dev/null) || ITEMS_TITLE=""

    ITEMS_PAGE_SIZE=$ITEMS_PAGE
    ITEMS_PAGE_PARAM="pn"
    ITEMS_SIZE_PARAM="ps"
    ITEMS_ROWS_PATH=".data.data"
    ITEMS_TOTAL_PATH=".data.totalSize"
    ITEMS_MORE_PATH=""
    items_page_loop "$OF_MENU_ENDPOINT" "$SITE_REFERER" --data-urlencode "sid=$CONTAINER_ID"
}

# The favourites list. Same two-request shape as the audio menu and for the same reason.
#
# WHAT IT CANNOT TELL APART, and this is a limit rather than an omission: an EMPTY list and one
# this anonymous client may not see return the same body (`code: 0`, `medias: null`,
# `has_more: false`). So a private list is reported as an empty container — the alternative
# would be guessing from a login the hand-built requests deliberately do not hold.
items_fav_rows() {
    local info="$SCRATCH_DIR/fav-info.json"
    http_get "$info" "$SITE_REFERER" "$FAV_INFO_ENDPOINT" \
        --data-urlencode "media_id=$CONTAINER_ID" ||
        items_fail "$(http_reason)"
    jq -e '(.data.title | type) == "string"' "$info" >/dev/null 2>&1 ||
        items_fail "unavailable"
    ITEMS_TITLE=$(jq -r '.data.title // empty' "$info" 2>/dev/null) || ITEMS_TITLE=""

    ITEMS_PAGE_SIZE=$FAV_PAGE
    ITEMS_PAGE_PARAM="pn"
    ITEMS_SIZE_PARAM="ps"
    ITEMS_ROWS_PATH=".data.medias"
    ITEMS_TOTAL_PATH=".data.info.media_count"
    ITEMS_MORE_PATH=".data.has_more"
    items_page_loop "$FAV_LIST_ENDPOINT" "$SITE_REFERER" \
        --data-urlencode "media_id=$CONTAINER_ID" --data-urlencode "platform=web"
}

# The collection. ONE request per page and no existence check of its own, because this endpoint
# answers in the code: a season_id nobody created comes back `-404` (measured 2026-09-12).
items_season_rows() {
    ITEMS_PAGE_SIZE=$SEASON_PAGE
    ITEMS_PAGE_PARAM="page_num"
    ITEMS_SIZE_PARAM="page_size"
    ITEMS_ROWS_PATH=".data.archives"
    ITEMS_TOTAL_PATH=".data.page.total"
    ITEMS_MORE_PATH=""
    items_page_loop "$SEASON_ENDPOINT" "$SPACE_REFERER" \
        --data-urlencode "mid=${CONTAINER_MID:-0}" \
        --data-urlencode "season_id=$CONTAINER_ID" \
        --data-urlencode "sort_reverse=false"
    ITEMS_TITLE=$(jq -r '.data.meta.name // empty' "${ITEMS_PAGES[0]}" 2>/dev/null) || ITEMS_TITLE=""
}

# A row is an item only if it can be PLAYED and can say how long it is: an id that builds a url
# and a numeric duration. Same judgement a search row passes (ARCH-cli-contract.md「数据契约」),
# minus its live_status arm — nothing in the audio catalogue is live.
JQ_ITEM_FILTER='[ .[] | select((.id | type) == "number" and .id > 0
                               and (.duration | type) == "number") ]'

# The video side needs two more, and BOTH are measurements (2026-09-12, two public lists):
#
#   type == 2      a favourites list is not all videos. `type: 24` rows are OGV episodes whose
#                  `link` is /bangumi/play/ep…, and they carry a bvid that does NOT name a
#                  /video/BV… page — a row built from one would point somewhere else.
#   attr bit 0     a dead upload stays in the list as `title: "已失效视频"` with attr 1 or 9 —
#                  and with a REAL duration. So the playable judgement cannot catch it, the
#                  title is a site string this file will not depend on, and the bit is the
#                  invariant.
JQ_FAV_FILTER='[ .[]
  | select((.type // 0) == 2)
  | select(((.attr // 0) % 2) == 0)
  | select((.bvid | type) == "string" and (.bvid | length) > 0)
  | select((.duration | type) == "number" and .duration > 0) ]'

JQ_SEASON_FILTER='[ .[]
  | select((.bvid | type) == "string" and (.bvid | length) > 0)
  | select((.duration | type) == "number" and .duration > 0) ]'

# `count` is what came back and `total` is what the site SAYS it holds; the gap covers both
# truncation and rows dropped by the filter, and the envelope does not add a key to tell those
# apart. `has_more` answers a different question — whether the CONTAINER has rows past this
# batch — and `next_cursor` is how to ask for them. `n` numbers the rows of THIS batch.
JQ_ITEMS_HEAD='
{status: "ok", engine: $engine, id: $id, url: $url,
 title: (if $title == "" then null else $title end),
 count: ($rows | length),
 total: $total,
 has_more: $has_more,
 next_cursor: $next_cursor,'

JQ_AUDIO_ITEMS="$JQ_ITEMS_HEAD"'
 items: [ $rows | to_entries[]
          | .key as $i | .value as $r
          | ($r.id | tostring) as $sid
          | {n: ($i + 1), engine: $engine, id: $sid,
             url: ("https://www.bilibili.com/audio/au" + $sid),
             title: ($r.title // null),
             duration: ($r.duration // null),
             duration_fmt: (($r.duration | fmt_dur) // null)} ]}
'

JQ_VIDEO_ITEMS="$JQ_ITEMS_HEAD"'
 items: [ $rows | to_entries[]
          | .key as $i | .value as $r
          | {n: ($i + 1), engine: $engine, id: $r.bvid,
             url: ("https://www.bilibili.com/video/" + $r.bvid),
             title: ($r.title // null),
             duration: ($r.duration // null),
             duration_fmt: (($r.duration | fmt_dur) // null)} ]}
'

# A VIDEO'S PARTS, off either parts endpoint. `$rows` is every part (the endpoint answers all
# of them in one body), so the batch is a slice of it and the cursor is plain arithmetic.
#
# The canonical id is the one the SITE returns (.data.bvid), not the one that was typed: an av
# handle resolves to its BV spelling. `pagelist` returns no bvid and no title, so off it the id
# stays as typed and the title is null — an already-legal value of the field, and the honest
# one. Every part's own number, title, duration and url come through whole either way.
JQ_PARTS_ITEMS='
((.data.bvid? // null) // $fallback) as $bv
| ("https://www.bilibili.com/video/" + $bv) as $base
| ($all | length) as $total
| ($all | .[$off:$off + $max]) as $batch
| ($off + ($batch | length) < $total) as $more
| {status: "ok", engine: $engine, id: $bv, url: $base,
   title: (.data.title? // null),
   count: ($batch | length),
   total: $total,
   has_more: $more,
   next_cursor: (if $more then "o:\($off + ($batch | length))" else null end),
   items: [ $batch | to_entries[]
            | .key as $i | .value as $r
            | {n: ($i + 1), engine: $engine,
               id: (if $total > 1 then $bv + "_p" + ($r.page | tostring) else $bv end),
               url: ($base + "?p=" + ($r.page | tostring)),
               title: ($r.part // null),
               duration: ($r.duration // null),
               duration_fmt: (($r.duration | fmt_dur) // null)} ]}
'

# Sets ITEMS_ENV (or prints -J and exits). `view` first, `pagelist` when it is refused — see
# THE PARTS ENDPOINTS for the measurement.
items_parts() {
    local id=$CONTAINER_ID args
    case "$id" in
    av*) args=(--data-urlencode "aid=${id#av}") ;;
    *) args=(--data-urlencode "bvid=$id") ;;
    esac

    local body="$SCRATCH_DIR/view.json" rows_path=".data.pages"
    if ! http_get "$body" "$SITE_REFERER" "$VIEW_ENDPOINT" "${args[@]}"; then
        # THE VIEW REASON IS THE REPORTED ONE: `view` has the richer error vocabulary (a bogus
        # id is 200 with body code -400 there), and a fallback that also fails should not
        # downgrade a verdict the preferred endpoint already gave. `unavailable` is a statement
        # about the HANDLE — a deleted video answers the same at every endpoint — so it is
        # reported without spending the second request.
        local reason
        reason=$(http_reason)
        [[ "$reason" == "unavailable" ]] && items_fail "$reason"

        body="$SCRATCH_DIR/pagelist.json"
        rows_path=".data"
        if ! http_get "$body" "$SITE_REFERER" "$PAGELIST_ENDPOINT" "${args[@]}"; then
            # …with one exception, the same distinction: whichever endpoint manages to say
            # `unavailable` is making a statement about the HANDLE, and that outranks a blanket
            # refusal of the REQUEST. While `view` answers 412 to everything, this is the only
            # path by which a nonexistent id is still reported as nonexistent.
            local fb_reason
            fb_reason=$(http_reason)
            [[ "$fb_reason" == "unavailable" ]] && reason="$fb_reason"
            items_fail "$reason"
        fi
    fi

    # A 200/code:0 whose record has no parts is not a video this verb can describe: every
    # video here has at least one, so an empty list would be a false answer.
    jq -e "($rows_path | type) == \"array\" and ($rows_path | length) > 0" "$body" >/dev/null 2>&1 ||
        items_fail "unavailable"

    if [[ "$OUTPUT_MODE" == "json_full" ]]; then
        jq -c '.' "$body"
        exit 0
    fi

    ITEMS_ENV=$(jq -c --arg engine "$ENGINE_NAME" --arg fallback "$id" \
        --argjson off "$CURSOR_OFFSET" --argjson max "$ITEMS_MAX" \
        "$JQ_PRELUDE ($rows_path) as \$all | $JQ_PARTS_ITEMS" "$body" 2>/dev/null) ||
        items_fail "unknown"
}

ITEMS_ENV=""
items_run() {
    ensure_scratch

    if [[ "$CONTAINER_KIND" == "video" ]]; then
        items_parts
    else
        local filter="$JQ_ITEM_FILTER" project="$JQ_AUDIO_ITEMS"
        case "$CONTAINER_KIND" in
        fav)
            items_fav_rows
            filter="$JQ_FAV_FILTER"
            project="$JQ_VIDEO_ITEMS"
            ;;
        season)
            items_season_rows
            filter="$JQ_SEASON_FILTER"
            project="$JQ_VIDEO_ITEMS"
            ;;
        *)
            items_am_rows
            ;;
        esac

        if [[ "$OUTPUT_MODE" == "json_full" ]]; then
            # The body that CARRIES the items, at full fidelity. When more than one page was
            # spent, every page's rows replace page one's, because a -J that answered about less
            # than -j would be the one output mode that loses information by widening.
            jq -c --argjson rows "$ITEMS_RAW" "$ITEMS_ROWS_PATH = \$rows" "${ITEMS_PAGES[0]}" ||
                items_fail "unknown"
            return 0
        fi

        local next_cursor="null"
        [[ "$ITEMS_HAS_MORE" == "true" ]] && next_cursor="\"o:$((CURSOR_OFFSET + ITEMS_TAKEN))\""

        local rows
        rows=$(printf '%s' "$ITEMS_RAW" | jq -c "$filter" 2>/dev/null) ||
            items_fail "unknown"
        ITEMS_ENV=$(jq -nc --argjson rows "$rows" \
            --arg engine "$ENGINE_NAME" --arg id "$CONTAINER_ID" --arg url "$CONTAINER_URL" \
            --arg title "$ITEMS_TITLE" --argjson total "$ITEMS_TOTAL" \
            --argjson has_more "$ITEMS_HAS_MORE" --argjson next_cursor "$next_cursor" \
            "$JQ_PRELUDE $project" 2>/dev/null) ||
            items_fail "unknown"
    fi

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        printf '%s\n' "$ITEMS_ENV"
        return 0
    fi

    # Prose: the title, a dashed summary line, then one line per item. An EMPTY container prints
    # its title and a count of 0 — that is an answer, not an error.
    printf '%s' "$ITEMS_ENV" | jq -r --arg note "$MUSIC_CHAR" '
        (if $note == "" then "" else $note + " " end) + (.title // "(untitled)"),
        "  - items: \(.count)   total: \(.total // "?")",
        (.items[] | "  \(.n). \(.title // "")  \(.duration_fmt // "")"),
        (if .has_more then "  … more — continue with --cursor \(.next_cursor)" else empty end)'
}

# ==============================================================================
# 8. --auth (read-only: no network, no yt-dlp, no state file)
# ==============================================================================

# Report the cookie DECISION this engine made at startup: which browser profile --stream and
# --info will read, and whether that profile exists on this machine. It answers BEFORE the
# yt-dlp dependency gate and makes no request, because it is a question about this process's
# own configuration, not about the site.
#
# What it deliberately does NOT claim is that the session behind those cookies buys anything.
# Measured 2026-08-26: 3159 cookies extracted from chrome, the profile browser-confirmed LOGGED
# IN, and this site still served exactly the anonymous audio ladder (30216/30232/30280, 181 kbps
# AAC top) — the account is not a premium member. So an accepted login can be
# indistinguishable from no login at all, which is why quality is never the evidence for this
# field, and this field is never the evidence for quality.
auth_run() {
    local auth="anonymous" found=false readable=null
    if ((${#COOKIE_ARGS[@]} > 0)); then
        auth="cookie"
        found=true
        # A profile folder that exists is not a store this process may read (cookie_probe),
        # and a status line that said "signed in" over a blocked read was the whole bug.
        # null = no probe for this browser, so no claim either way.
        cookie_probe "$BILI_COOKIE_BROWSER"
        case "$COOKIE_STATE" in
        readable) readable=true ;;
        unknown) readable=null ;;
        *) readable=false ;;
        esac
    fi
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg engine "$ENGINE_NAME" --arg auth "$auth" \
            --arg browser "$BILI_COOKIE_BROWSER" --argjson found "$found" --argjson readable "$readable" \
            '{status: "ok", engine: $engine, auth: $auth,
              cookie_browser: $browser, profile_found: $found, cookie_readable: $readable}'
        return 0
    fi
    if [[ "$auth" == "cookie" && "$readable" == "false" ]]; then
        printf 'cookie (%s, unreadable: %s)\n' "$BILI_COOKIE_BROWSER" "$COOKIE_STATE"
    elif [[ "$auth" == "cookie" ]]; then
        printf 'cookie (%s)\n' "$BILI_COOKIE_BROWSER"
    else
        printf 'anonymous\n'
    fi
}

