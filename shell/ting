#!/usr/bin/env bash
# ting — interactive terminal browser for whatever engines are installed (self-rendered
# menu). Owned glue, not a client: the human-facing surface, ZERO SITE logic. It composes the
# headless verbs with jq.
#
# Delegates core jobs to headless binaries:
#   search (network fetch) → t-play --search -j <query>   (JSON envelope)
#   play                   → t-play -d -j -f MODE -- url  (ASYNCHRONOUS: detached background player)
#   filter (narrow rows)   → pure bash, no external tool
#
# ting renders its OWN menu, and there is ONE view: the result list, its live Now-Playing
# status banner, and the details block under it. What used to be a second full-screen
# renderer is a fifth ROW SOURCE — b (a playlist), h (the listening log), c (a video's parts)
# and i (a video's chapters) each replace the rows in place and are pressed again to come
# back. No view toggle, so no Tab.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features (no ${v,,}, no mapfile); guard
# empty-array expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). ARCHITECTURE.md「可移植性契约」.

# Resolve this script's OWN symlink chain before looking for its siblings. The PATH entries
# (t-play / ting / …) are symlinks into a checkout that can live anywhere, so
# `dirname $0` is the symlink's directory, not the code's. This walks the chain to the real file and takes ITS
# directory — which is the one holding the rest of the suite.
#
# `cd -P` / `pwd -P`, not the logical forms: a relative symlink resolves to something like
# ~/bin/../../../elsewhere/shell, and logical `cd` would normalise those `..` textually against
# ~/bin instead of against what ~/bin actually points at. Physical resolution is the only one
# that lands in the right place. bash 3.2 has no `readlink -f`, hence the loop.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)

# THE version of the whole suite, declared once, in a data file (CLAUDE.md § one fact, one
# place). Read before any dependency gate, so --version answers on a machine with nothing
# installed.
if [[ -r "$SCRIPT_DIR/../VERSION" ]]; then
    TING_VERSION=$(cat "$SCRIPT_DIR/../VERSION")
else
    TING_VERSION="unknown"
fi

# WHAT THE ENVIRONMENT ALREADY PINS, noted BEFORE the chain below resolves — this is the one
# fact reading the config destroys. ting_read_config skips every key that is already set (that
# is what makes the environment beat a file), so once it has run, "the user exported it" and
# "the file supplied it" are indistinguishable. The write-back path needs the difference: a
# key the environment pins would be written to the file and then IGNORED at the next startup,
# and a file recording a value the program has already decided to throw away is a lie that
# surfaces months later. Ahead of the block below rather than inside it, because that block is
# duplicated verbatim in every entry point and this is ting's alone.
PREF_KEYS="TING_DEFAULT_ENGINE TING_THEME TING_PLAY_MODE TING_PLAY_QUALITY TING_SORT_FIELD TING_LANG TING_SEARCH_RESULTS TING_KEYS TING_ROW_INDEX TING_LIST_MODE TING_LOOP_MODE"
PREF_PINNED=""
for _pk in $PREF_KEYS; do
    if eval "[[ -n \"\${$_pk+x}\" ]]"; then PREF_PINNED="$PREF_PINNED $_pk"; fi
done
unset _pk

# CONFIGURATION — the chain is flag > environment > the user's config > the shipped defaults
# in `<checkout>/config`, which is where every default value in the suite is declared once.
# Duplicated VERBATIM in every entry point — see the same block in t-play for why, and
# ARCH-cli-contract.md「配置面」 for the keys.
TING_CONFIG="${TING_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/ting/config}"
TING_DEFAULTS="$SCRIPT_DIR/../config"
ting_read_config() {
    local file="$1" line key val
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        while [[ "$line" == [[:space:]]* ]]; do line="${line#[[:space:]]}"; done
        while [[ "$line" == *[[:space:]] ]]; do line="${line%[[:space:]]}"; done
        [[ -n "$line" && "$line" == *=* ]] || continue
        key="${line%%=*}"
        val="${line#*=}"
        while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
        while [[ "$val" == [[:space:]]* ]]; do val="${val#[[:space:]]}"; done
        [[ "$key" =~ ^TING_[A-Z0-9_]+$ ]] || continue
        case "$key" in
        TING_CONFIG | TING_ENGINE_DIR | TING_VERSION | TING_DEFAULTS | TING_IPC_SOCK | TING_DETACHED | TING_PLAYER_ID | TING_DETACHED_LOG) continue ;;
        esac
        if [[ ${#val} -ge 2 ]] && { [[ "$val" == \"*\" ]] || [[ "$val" == \'*\' ]]; }; then
            val="${val#?}"
            val="${val%?}"
        fi
        [[ "$val" == "~/"* ]] && val="$HOME/${val#\~/}"
        eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
    done < "$file"
}
# FAIL FAST AND SAY WHY. There is deliberately no escape hatch for --version or --help: they
# were tried, and letting execution continue past a missing defaults file replaced this one
# clear line with `TING_ASCII_VO: unbound variable` from set -u somewhere further down. A
# checkout missing part of itself is not a dependency gate (yt-dlp, jq and mpv still answer
# --version without being installed) — it is a broken checkout, and 2 is the exit code for a
# failure that is not the caller's usage error.
if [[ ! -r "$TING_DEFAULTS" ]]; then
    printf '%s: cannot read the shipped defaults at %s — that file declares every default value in the suite and is not optional\n' \
        "$(basename "$0")" "$TING_DEFAULTS" >&2
    exit 2
fi
ting_read_config "$TING_CONFIG"
ting_read_config "$TING_DEFAULTS"

# ── PREFERENCE WRITE-BACK ───────────────────────────────────────────────────────────────
# The eleven keys above are the ones this TUI changes at runtime, and they are written back to
# the USER's config file in place. A preference that has to be re-pressed every session is not
# a preference; the reasoning is ARCHITECTURE.md「两个根数据文件」 (reopen triggers: ROADMAP), the key table is
# ARCH-cli-contract.md「配置面」. What the code below is:
#
#   WHICH FILE  the user's own ($TING_CONFIG). The shipped `config` is NEVER written — it is
#               this checkout's declared defaults, not anybody's preferences.
#   WHICH KEYS  PREF_KEYS, and nothing else. pref_value is the whitelist as well as the
#               key→variable map, so a key it does not name has no value to write and the
#               path cannot reach it.
#   WHEN        deferred. A cycle sets a dirty bit and returns; the file is written from
#               nav_tick or from the exit trap. t and l are held down, and a rewrite per
#               keypress would put a whole file rewrite inside the same loop that is
#               reassembling a multi-byte character out of single bytes.
#   HOW         the value on the matching line is replaced and NOTHING else on it is: the
#               key's own spacing, the gap before a trailing comment and the comment itself
#               are carried over byte for byte. Re-padding the comment column was considered
#               and refused — the width layer that knows a CJK comment is two cells per
#               character lives in the RENDERER, and padding by bytes here would misalign
#               every Chinese comment in a file that stays perfectly legal and reports nothing.
#   ROUND TRIP  the only correctness test that matters: what is written must read back
#               identically through ting_read_config. That is what pref_value_ok enforces.
PREF_DIRTY=""      # keys whose value has changed and is not on disk yet
PREF_WRITE_OFF=0   # a write failed once; stop retrying at every tick
PREF_SAID=""       # keys already refused out loud, so the notice is said once each

# The whitelist AND the key→variable map. One case, because two of them would be two places
# to add a twelfth key and one place to forget it.
pref_value() {
    case "$1" in
    TING_DEFAULT_ENGINE) printf '%s' "$ENGINE" ;;
    TING_THEME)        printf '%s' "$THEME" ;;
    TING_PLAY_MODE)    printf '%s' "$PLAY_MODE" ;;
    TING_PLAY_QUALITY) printf '%s' "$PLAY_QUALITY" ;;
    TING_SORT_FIELD)   printf '%s' "$SORT_FIELD" ;;
    TING_LANG)         printf '%s' "$UI_LANG" ;;
    TING_SEARCH_RESULTS) printf '%s' "$RESULT_N" ;;
    TING_KEYS)         printf '%s' "$KEYS_TIER" ;;
    TING_ROW_INDEX)    if ((ROW_INDEX)); then printf 'on'; else printf 'off'; fi ;;
    TING_LIST_MODE)    printf '%s' "$LIST_MODE" ;;
    TING_LOOP_MODE)    printf '%s' "$LOOP_MODE" ;;
    esac
}

# pref_listed <needle> <space-separated haystack>. bash 3.2 has no associative arrays and
# these lists are ten long, so a set is a string and membership is a glob.
pref_listed() {
    case " $2 " in *" $1 "*) return 0 ;; esac
    return 1
}

# A value is acceptable only if ting_read_config would read it back UNCHANGED. The eleven are
# enumerations and a number, so this never fires today; it is here so a twelfth key cannot
# quietly write a line the loader mangles — `#` starts a comment, one matching quote pair is
# stripped, surrounding space is trimmed and a leading ~/ becomes $HOME.
pref_value_ok() {
    case "$1" in
    "" | *"#"* | *'"'* | *"'"* | "~/"*) return 1 ;;
    esac
    case "$1" in
    [[:space:]]* | *[[:space:]] | *$'\n'*) return 1 ;;
    esac
    return 0
}

# mark_pref <key> — called on the SUCCESS path of a cycle, never before it: a cycle whose
# re-fetch failed has been rolled back on screen, and the file must agree with the screen.
mark_pref() {
    local k="$1"
    if ! pref_listed "$k" "$PREF_KEYS"; then return 0; fi
    # REFUSED, not silently written: the environment wins over the file at every startup, so
    # writing this key would record a value the next run reads and discards.
    if pref_listed "$k" "$PREF_PINNED"; then
        if ! pref_listed "$k" "$PREF_SAID"; then
            PREF_SAID="$PREF_SAID $k"
            store_notice "$S_PREF_ACT:" "$k $S_PREF_PINNED"
        fi
        return 0
    fi
    if ! pref_listed "$k" "$PREF_DIRTY"; then PREF_DIRTY="$PREF_DIRTY $k"; fi
    return 0
}

# write_prefs <keys> — ONE pass over the file, one temp, one rename, however many keys are
# pending. Deliberately no lock: two ting sessions writing the same file is last-writer-wins
# on a whole file that is always internally consistent, and what is lost is one preference,
# not user data. A lock spin inside a key loop would be the worse trade.
write_prefs() {
    local keys="$1" line lhs rhs key val pre gap comment trimmed lead bare tmp
    local out="" seen="" k dest link
    # Resolve $TING_CONFIG along its symlink chain FIRST, and write to what it points at.
    # temp+mv came from t-playlist, but that store renames over files it created in its own
    # directory; this renames over a file the USER owns — quite possibly a symlink out of a
    # dotfiles repo. Renaming onto the link itself would leave a regular file here, orphan the
    # real dotfile (every later hand-edit there silently stops taking effect) and say nothing.
    # Same chain walk as this script's own self-resolution at the top — bash 3.2 has no
    # `readlink -f`. A dangling link resolves too, so the create path below makes the file the
    # link promises instead of replacing the link with one.
    dest="$TING_CONFIG"
    while [[ -L "$dest" ]]; do
        link=$(readlink "$dest")
        case "$link" in
        /*) dest="$link" ;;
        *)  dest="$(dirname "$dest")/$link" ;;
        esac
    done
    if [[ -e "$dest" ]]; then
        [[ -r "$dest" ]] || return 1
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" == *=* ]]; then
                lhs="${line%%=*}"
                key="$lhs"
                while [[ "$key" == [[:space:]]* ]]; do key="${key#[[:space:]]}"; done
                while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
                # A commented-out line keeps its `#`, so its key never matches and it is
                # carried through untouched — which is the right answer: the user disabled it.
                if pref_listed "$key" "$keys" && ! pref_listed "$key" "$seen"; then
                    val=$(pref_value "$key")
                    if pref_value_ok "$val"; then
                        rhs="${line#*=}"
                        comment=""
                        pre="$rhs"
                        if [[ "$rhs" == *"#"* ]]; then
                            pre="${rhs%%#*}"
                            comment="#${rhs#*#}"
                        fi
                        # Split the value off its own whitespace so both halves survive:
                        # `lead` is what sits between the = and the value, `gap` is the run
                        # of spaces that aligns the comment. Anchored strips only — pattern
                        # SUBSTITUTION is quadratic on bash 3.2 (ARCHITECTURE.md「可移植性契约」).
                        trimmed="$pre"
                        while [[ "$trimmed" == *[[:space:]] ]]; do trimmed="${trimmed%[[:space:]]}"; done
                        gap="${pre#"$trimmed"}"
                        bare="$trimmed"
                        while [[ "$bare" == [[:space:]]* ]]; do bare="${bare#[[:space:]]}"; done
                        lead="${trimmed%"$bare"}"
                        line="$lhs=$lead$val$gap$comment"
                        seen="$seen $key"
                    fi
                fi
            fi
            out="$out$line"$'\n'
        done < "$dest"
    else
        mkdir -p "$(dirname "$dest")" 2>/dev/null || return 1
        out="# ting — your own settings, and the file ting writes a changed one back to."$'\n'
        out="$out# Hand-edit it freely: comments and layout are preserved, only values move."$'\n'
        out="$out# Precedence: flag > environment > THIS FILE > the shipped <checkout>/config."$'\n'
    fi
    # A key the file does not carry yet is appended. This is the only line the write ADDS.
    for k in $keys; do
        if ! pref_listed "$k" "$seen"; then
            val=$(pref_value "$k")
            if pref_value_ok "$val"; then out="$out$k=$val"$'\n'; fi
        fi
    done
    tmp="$dest.tmp.$$"
    # cp -p FIRST, so a config the user chmod'ed 600 comes back 600: the redirect below
    # truncates the copy rather than creating a fresh file at whatever the umask says.
    if [[ -f "$dest" ]]; then cp -p "$dest" "$tmp" 2>/dev/null || true; fi
    if ! printf '%s' "$out" >"$tmp" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null || true
        return 1
    fi
    if ! mv -f "$tmp" "$dest" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null || true
        return 1
    fi
    return 0
}

# The flush. Both call sites are places that already exist: nav_tick, which the reader falls
# into when its read times out, and cleanup_on_exit, which is already trapped on
# EXIT/INT/TERM/HUP. The worst case is no longer "a rewrite per keypress" but "one preference
# lost if the process dies inside a tick window".
flush_prefs() {
    local keys="$PREF_DIRTY"
    [[ -n "$keys" ]] || return 0
    PREF_DIRTY=""
    # if-form, not `((PREF_WRITE_OFF)) && return 0`: a bare arithmetic list that evaluates to
    # zero is a FAILED command, and under set -e that would abort the TUI here (ARCHITECTURE.md「可移植性契约」).
    if ((PREF_WRITE_OFF)); then return 0; fi
    if ! write_prefs "$keys"; then
        PREF_WRITE_OFF=1
        # Soft failure: a read-only ~/.config must not kill a TUI that is playing music. It
        # must not be silent either — so it is a notice, on the next frame, and cleanup_on_exit
        # repeats it on the way out: this is the one message whose audience may already have
        # left the keyboard, and the exit line is what makes the frame's single life enough.
        store_notice "$S_PREF_ACT:" "$S_PREF_FAILED"
    fi
    return 0
}

if [[ -x "$SCRIPT_DIR/t-play" ]]; then
    PLAY_BIN="$SCRIPT_DIR/t-play"
elif command -v t-play >/dev/null 2>&1; then
    PLAY_BIN=$(command -v t-play)
else
    echo "ting: cannot locate t-play" >&2
    exit 1
fi

# The playlist store, located the same way and OPTIONAL. Absent, the two playlist keys say
# so once and the rest of the session is unchanged — the same "a capability is declared by
# being there" rule an engine follows with --transcript. This file never touches
# $TING_STATE_DIR itself: the store owns its layout, exactly as t-play owns players/.
PLAYLIST_BIN=""
if [[ -x "$SCRIPT_DIR/t-playlist" ]]; then
    PLAYLIST_BIN="$SCRIPT_DIR/t-playlist"
elif command -v t-playlist >/dev/null 2>&1; then
    PLAYLIST_BIN=$(command -v t-playlist)
fi

# The listening log, located the same way and just as optionally. HISTORY_BIN, not
# TING_HISTORY: that name is already the player's set-once switch for whether a row is
# written at all (ARCH-cli-contract.md「配置面」) — and like its two siblings above, an internal
# does not wear the TING_ prefix, which ting_read_config accepts as settable.
# This file only READS it, and only when h is pressed — the writing is the player's, where
# the fact "a track ended, and why" exists.
HISTORY_BIN=""
if [[ -x "$SCRIPT_DIR/t-history" ]]; then
    HISTORY_BIN="$SCRIPT_DIR/t-history"
elif command -v t-history >/dev/null 2>&1; then
    HISTORY_BIN=$(command -v t-history)
fi

# AN UPGRADE CAN TAKE THE TOOLS OUT FROM UNDER A RUNNING SESSION. The three paths above are
# resolved once, at startup, and a package manager installs each version into a directory of
# its own and deletes the old one when the new one lands (Homebrew's cleanup does it the same
# second). A session opened before the upgrade then holds paths to files that are gone — and
# the one call that must not fail quietly is the STOP: measured at the 0.14.0 release, `q`
# ran a deleted `t-play --stop`, and the mpv it should have stopped played on with nothing
# attached to it. So a path that no longer runs is looked up again on PATH, where a package
# manager keeps its stable name for whichever version is current. One `[[ -x ]]` per tool per
# loop turn (a stat, no fork); nothing is re-resolved while the file is still there, so an
# ordinary session never changes which copy it talks to.
relocate_tools() {
    local p
    if [[ ! -x "$PLAY_BIN" ]] && p=$(command -v t-play 2>/dev/null) && [[ -x "$p" ]]; then PLAY_BIN="$p"; fi
    if [[ -n "$PLAYLIST_BIN" && ! -x "$PLAYLIST_BIN" ]] && p=$(command -v t-playlist 2>/dev/null) && [[ -x "$p" ]]; then
        PLAYLIST_BIN="$p"
    fi
    if [[ -n "$HISTORY_BIN" && ! -x "$HISTORY_BIN" ]] && p=$(command -v t-history 2>/dev/null) && [[ -x "$p" ]]; then
        HISTORY_BIN="$p"
    fi
    return 0
}

# THE ENGINE REGISTRY — discovered, not listed, and not by this file. The suite's whole claim
# is that adding a source is adding ONE file (`t-engine-<name>`) and changing nothing else; a
# hardcoded list of engine names here would make that claim false at the fourth source, in
# the one place nobody looks, because the TUI would still run and simply not offer the new
# one.
#
# `t-play --engines` answers it: where engines may live (sibling, $TING_ENGINE_DIR, PATH, the
# first sight of a name winning so a plugin cannot shadow a built-in) and which verbs each
# accepts are the player's rule and the engine's statement, and a TUI that re-derived either
# would be a second copy that drifts. The PROSE form is read (name TAB bin TAB flags), not -j:
# this runs before the jq gate, and every field in it is a name, a path or a flag word.
#
# TING_ENGINE_DIR is still resolved here, for this file's usage text only; t-play resolves its
# own, from the same environment.
ENGINES=()
ENGINE_FLAG_SETS=()   # parallel to ENGINES: " --search -n … " as the engine states it
engine_seen() {
    local e
    for e in ${ENGINES[@]+"${ENGINES[@]}"}; do
        if [[ "$e" == "$1" ]]; then return 0; fi
    done
    return 1
}
TING_ENGINE_DIR="${TING_ENGINE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ting/engines}"
while IFS=$'\t' read -r _name _bin _flags; do
    [[ -n "$_name" ]] || continue
    ENGINES+=("$_name")
    ENGINE_FLAG_SETS+=(" $_flags ")
done < <("$PLAY_BIN" --engines 2>/dev/null)
unset _name _bin _flags
if ((${#ENGINES[@]} == 0)); then
    echo "ting: no engine found — need a t-engine-<name> file beside t-play, in $TING_ENGINE_DIR, or on PATH" >&2
    exit 1
fi

# One engine verb, asked the way any caller asks: through t-play, which forwards it to the
# engine and hands back the engine's own envelope and exit code. The name is safe to pass
# because every caller passes one that already passed engine_seen.
engine_verb() { # <name> <verb> [args…]
    local eng=$1
    shift
    "$PLAY_BIN" --engine "$eng" "$@"
}

# An engine's stderr line, cut to what a person reads: the engine's own "Error: " label (and
# the program-name prefix its advisory lines carry) says nothing the notice does not.
engine_msg() { # <name> <text>
    local m=${2##*$'\n'}
    m=${m#Error: }
    m=${m#t-engine-"$1": }
    printf '%s' "$m"
}

# The auth token in the status line comes from the ENGINE, never from this file: which
# browser a source reads cookies from is site knowledge, and ting holds none. It asks
# `t-play --auth`, which the engine answers with a local fork: no network and no yt-dlp.
#
# It reports the cookie DECISION, not a valid login — an expired session still answers
# "cookie". The status line therefore says which profile playback will READ, which is the
# question a user can act on; whether the site accepted it is not knowable without a round
# trip this suite does not make. What IS knowable locally is whether the store can be read
# at all (`cookie_readable`, one read of the cookie file): a terminal app macOS will not let
# into the browser's folder gets the anonymous client whatever the decision said.
#
# An engine without --auth exits non-zero and the field simply
# disappears — the same way a missing --transcript states a missing capability by not
# existing, so a third engine is never blocked on implementing this.
#
# Recomputed on each source switch rather than kept in a map: bash 3.2 has no associative
# array, and one fork (a directory listing and a one-byte read, behind t-play's own start) is
# cheaper than keeping parallel arrays correct.
ENGINE_AUTH=""
refresh_engine_auth() {
    ENGINE_AUTH=""
    local out a b
    out=$(engine_verb "$ENGINE" --auth -j 2>/dev/null) || return 0
    a=$(printf '%s' "$out" | jq -r '.auth // empty' 2>/dev/null) || return 0
    case "$a" in
    cookie)
        b=$(printf '%s' "$out" | jq -r '.cookie_browser // empty' 2>/dev/null) || b=""
        ENGINE_AUTH="${b:-cookie}"
        # A store the engine will try and cannot read is not "signed in". `false` only:
        # a missing field (an older engine) or null (a browser it cannot probe) claims nothing.
        if [[ "$(printf '%s' "$out" | jq -r '.cookie_readable' 2>/dev/null)" == "false" ]]; then
            ENGINE_AUTH="blocked"
        fi
        ;;
    anonymous) ENGINE_AUTH="anon" ;;
    esac
    return 0
}

# Which read-only verbs does this engine have? `c` needs `--items` (a video's parts are its
# items) and `i` needs `--info`, and both were stated by the engine in the registry above
# (ARCH-cli-contract.md「命令规格」) — no fork here at all. An engine that stated nothing lists
# with an empty set, so neither key is offered for it: a missing key costs less than a key
# that answers "unknown flag".
#
# Looked up per source switch, cached, exactly like ENGINE_AUTH above: the hint block is
# measured on every redraw and cannot afford to ask.
ENGINE_PARTS_OK=0
ENGINE_INFO_OK=0
refresh_engine_flags() {
    ENGINE_PARTS_OK=0
    ENGINE_INFO_OK=0
    local i flags=""
    for ((i = 0; i < ${#ENGINES[@]}; i++)); do
        [[ "${ENGINES[$i]}" == "$ENGINE" ]] && flags=${ENGINE_FLAG_SETS[$i]}
    done
    case "$flags" in *" --items "*) ENGINE_PARTS_OK=1 ;; esac
    case "$flags" in *" --info "*) ENGINE_INFO_OK=1 ;; esac
    return 0
}

# Every probe, one name for the callers. Two functions because they ask two different verbs;
# one caller-facing name because the two places that switch engines would otherwise each list
# every probe — the shape that drifts the day a third one lands, the way F11/F12 did
# (ARCHITECTURE.md).
refresh_engine_caps() {
    refresh_engine_auth
    refresh_engine_flags
}

# Which engine this session starts on. The SAME variable t-play reads, not a second one:
# a user who set a default source once should not have to set it again per surface.
ENGINE="$TING_DEFAULT_ENGINE"
engine_seen "$ENGINE" || ENGINE="${ENGINES[0]}"

print_usage() {
    cat <<'EOF'
ting — interactive terminal browser for the installed engines

Usage:
  ting [options] [search query]

With no query, prompts for one (interactive). Requires a terminal.

Search options (forwarded to t-play --search):
  -n NUM    Number of results to fetch (default: 20)
  -m SEC    Minimum duration in seconds
  -M SEC    Maximum duration in seconds
  -s FIELD  Sort field: relevance | view_count | duration (default: relevance)
  --engine NAME  Which source to search. Defaults to TING_DEFAULT_ENGINE (the same variable
            t-play reads), falling back to the first one installed. An engine is one
            t-engine-<name> file, as 't-play --engines' lists them — nothing here lists
            them, so whatever is installed is what the e key offers.

Menu options:
  -f MODE   Playback mode (default: audio): audio | video | fast
            (playback is detached — ascii/viz need a terminal to draw on)
  --volume N  mpv startup volume, 0-100 (default: unset -> mpv's own default;
              launch-time only, no live volume-cycle key)
  -p NUM    Rows per page (default: 10, capped to the terminal height)
  --color MODE  Color: auto | always | never (default: auto)
  --theme NAME  Palette: minimal (default) | mono | catppuccin | tokyonight | nord
                | gruvbox | onedark | dracula | rosepine | everforest | kanagawa
                | solarized | monokai. Every theme = a signature accent
                plus its own play/pause status hues; mono = gray hierarchy only,
                no hue. Community themes emit 24-bit color when
                COLORTERM=truecolor, else ANSI-16 fallbacks.
                Light/dark picks the theme's own light variant (see TING_BG below).
  -h        This help
  -V        Print the suite version

Keys (List View):
  ↑/↓      move selection              ←/→  change page (→ past the last page
           fetches one batch more; ← on page 1 drops one, no re-fetch)
  j / k    the same two, for the hand that already lives on them (List View only —
           with / open they are text you are typing). `j` is also what ends a row
           number typed with the digits — see 0 - 9 below
  Enter    play / switch track (non-blocking background playback); on a chapter row,
           play FROM that chapter — a seek if that item is already playing
  Space    pause / resume playback
  s        stop playback
  - / =    volume down / up (via IPC)
  0 - 9    type a row number; `j` jumps to it — `12j` goes to row 12, `3j` to row 3.
           The number is the ABSOLUTE one `#` prints, counted from the top of the
           list and not of the window; out of range does nothing. There is no
           timeout: any other key drops the number and then does its own job
  #        row numbers on / off (TING_ROW_INDEX). It is the jump's partner: the
           address `Nj` takes is only on screen while this is on
  Tab      list mode: scroll <-> page (TING_LIST_MODE)
  [ / ]    seek backward / forward 10s (via IPC)
  v        cycle playback mode: audio → video → fast (applies to next play)
  f        cycle quality tier: auto → medium → high (applies to next play; the
           engine reads it against the mode, so `high` is 1080p for video and a
           bitrate for audio). low is not on the cycle: set it with --quality
  l        switch chrome language (en <-> zh)
  t        cycle palette family live (minimal → catppuccin → tokyonight → nord →
           gruvbox → onedark → mono); no-op when colors are off
  n        new search (fetch a different query without interrupting music)
  o        rotate sort field / order (relevance → view_count → duration), re-fetch
  e        switch source, re-fetch the same query (only when >1 engine is installed)
  a        add the focused row to a playlist               (needs t-playlist)
  b        open a stored playlist as the row source; b again
           returns to the search results                    (needs t-playlist)
  d        remove the focused row from the playlist on screen; removing the last
           one leaves the list, empty. Stops the player when it was on that row,
           once the undo has closed; playlist rows only     (needs t-playlist)
  D        delete the entire playlist on screen; stops playback when active, once
           the undo has closed; playlist rows only          (needs t-playlist)
  R        rename the playlist on screen;
           playlist rows only                               (needs t-playlist)
  z        undo the last d / D / R / a / + / x / X, for 3 seconds after it — the
           frame says "z to undo" for exactly as long as it can. Nothing asks
           "are you sure" first; this is what replaced that question
  h        open the listening log as the row source; h again
           returns to the search results                    (needs t-history)
  c        open the focused row's parts as the row source; c again returns to the
           search results          (only when the engine has --items)
  i        open the focused row's CHAPTERS as the row source, with one metadata
           fetch (upload date and likes land on the status line); i again returns
           to the search results. A chapter row is a call: Enter plays from it,
           + queues from it, a stores it
                              (only when the engine has --info; the shipped ones all do)
  r        cycle what happens when a track ends: off → seq → one. off plays the row you
           picked and stops; seq plays the rows from the cursor DOWN, in order, by handing
           the player a queue — so they keep playing after this UI exits; one repeats the
           track. off/one take effect on a player that is already running; seq shapes the
           next Enter, and says so
  +        append the focused row to the running player's queue (nothing playing: says so)
  >        skip to the next queued track
  /        live filter — type to narrow instantly; ↑/↓ select, Enter play, Esc clear
  ?        show more / fewer keys (also ？). The hint block has three tiers:
           `core` is this view's own job, `full` is every key above, and `hidden`
           drops the hint block entirely for maximum content rows. TING_KEYS pins it
  q        quit (stops a player this session started; a player that was already
           running when ting opened is adopted on the banner and left running)

  The eleven settings these keys change — engine, sort field, playback mode, quality tier,
  theme, chrome language, the result count, the key-hint tier, row numbers, the list mode
  and the loop mode — are written back to YOUR config file
  (${XDG_CONFIG_HOME:-~/.config}/ting/config), in place: comments and layout are kept,
  only the value moves. The shipped defaults file is never written. A key you have pinned
  in the environment is left alone, and says so once.

Environment:
  Defaults for every knob below live in <checkout>/config, declared once for the whole
  suite. Override per user in ${XDG_CONFIG_HOME:-~/.config}/ting/config (KEY=value, one
  per line, # comments); TING_CONFIG relocates it. Chain: flag > environment > your
  config > the shipped defaults. See ARCH-cli-contract.md「配置面」.
  TING_ENGINE_DIR  Extra directory scanned for t-engine-<name> files, after t-play's own
                   directory and before PATH; an engine there is a source the
                   e key rotates through. A name already installed beside this file wins,
                   so a plugin cannot replace a built-in engine. ENVIRONMENT ONLY — it
                   names programs this UI runs, so neither config file can set it.
                   Default: ${XDG_DATA_HOME:-~/.local/share}/ting/engines
  TING_ASCII=1     Use ASCII glyphs (♫ ● ○ ❯ · ▶ ❚❚ • … → — arrows → ASCII) for
                   terminals whose font can't draw them. Auto-on for non-UTF-8 locales.
                   Shared with the rest of the suite.
  TING_LANG=en|zh  Language of the menu chrome. Default: zh under a zh* locale,
                   English otherwise (help text and errors are always English).
  TING_THEME=minimal|mono|catppuccin|tokyonight|nord|gruvbox|onedark|dracula
          |rosepine|everforest|kanagawa|solarized|monokai
                   Palette family (same as --theme; default: minimal).
  TING_BG=auto|light|dark  Background mode. auto: $COLORFGBG, then an OSC 11 terminal
                   query, then dark. For minimal/mono, light swaps cyan for blue; for
                   community themes it picks the theme's own light variant.
  TING_SYNC=0|1|auto  Synchronized redraws (DCS 1q/2q; default auto: on, off under tmux).
  TING_IMAGE=auto|on|off  Cover art for the focused row, over the terminal's graphics
                    protocol. auto probes the terminal and is off under tmux; off sends
                    no byte at all.
  NO_COLOR=1       Disables color in --color auto mode (an explicit --color wins).
  TING_AMBIG_WIDE=1  Measure East-Asian-Ambiguous glyphs (· — • … arrows ─ ━ ○ ● ▶) as
                   TWO cells. Only needed if your terminal is set to treat ambiguous
                   width as double-width; every terminal ships with that option off.
EOF
}

die() {
    echo "ting: $1" >&2
    exit 1
}

# A missing tool is not a malformed call: `die` is exit 1 (usage — the non-TTY refusal and a
# bad config value both land there), `die_dep` is exit 2 (the call was fine; the machine is
# missing something no rewrite of the call will supply). The nine headless verbs carry the
# same pair — ten peers, no shared library. docs/ARCH-cli-contract.md「退出码、TTY、依赖」.
die_dep() {
    echo "ting: $1" >&2
    exit 2
}

require_cmd() {
    for c in "$@"; do
        command -v "$c" >/dev/null 2>&1 || die_dep "requires '$c' (not found on PATH)"
    done
}

# The unix-socket client, resolved once at startup (t-play carries the same probe — ten
# peers, no shared library). BSD/OpenBSD nc take -U; netcat-traditional and busybox nc do
# not, and there nmap's ncat is the same primitive under its second name. Probed by
# CAPABILITY (' -U' in the -h text), never by version string. ncat's -w bounds only the
# connect, so the idle backstop nc spells -w1 is spelled -i 1 there.
NC_UNIX=()
resolve_nc_unix() {
    # CAPTURED, then matched — never `nc -h | grep -q`. Under pipefail that pipeline's status
    # is nc's, and BSD `nc -h` exits 1 after printing its usage, so the stock macOS client
    # was refused on every machine and only ever worked where nmap's ncat caught the fall.
    local nc_help=""
    command -v nc >/dev/null 2>&1 && nc_help=$(nc -h 2>&1 || true)
    # Whitespace either side, not a space: BSD indents its flag lines with a TAB.
    if [[ "$nc_help" =~ [[:space:]]-U[[:space:]] ]]; then
        NC_UNIX=(nc -U -w1)
    elif command -v ncat >/dev/null 2>&1; then
        NC_UNIX=(ncat -U -w 1 -i 1)
    else
        return 1
    fi
}

is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }

# Parse: search-shaping flags forwarded to t-play --search (and captured for status line);
# -f/-p/--color are menu-local. The rest is query. Reject anything else.
SEARCH_ARGS=()
# THE FETCH BATCH — the STEP the two edges move by: → past the last page adds one, ← on page
# one drops one. One knob, not two: they were the same 20 for the same reason, so a user who
# wants bigger bites should not have to say it twice. 20 because Bilibili's endpoint pages at
# 20 with no page-size knob (t-engine-bili PAGE_SIZE), so it keeps the first fetch — and every
# re-fetch — an exact page count. Cross-engine: this is the TUI's appetite, not a site's page
# size. Separate from TING_SEARCH_RESULTS even though that is 20 too: that one is a TOTAL an
# engine returns once, this one is the STEP each press moves by, so widening one must not
# widen the other. ARCH-cli-contract.md「配置面」.
#
# WHERE THE FIRST FETCH STARTS is the -n default every search takes, TING_SEARCH_RESULTS — one
# answer to "how many rows does a query return", whether an agent or this UI asks it.
RESULT_N=$TING_SEARCH_RESULTS  # -n overrides; → grows it, ← shrinks it
# THE FIVE KEY ROTATIONS are product design, not settings: each order below is chosen, and a
# knob per order tuned something nobody tuned. The v key: the three modes a detached player
# can take.
MODE_CYCLE=(audio video fast)
# The -f default, one value shared with t-play and both resolve halves.
PLAY_MODE="$TING_PLAY_MODE" # -f flag overrides. Runtime-mutable: v key rotates it (cycle_mode).
# The --quality default, forwarded to t-play on every launch and rotated live by the f key
# (cycle_quality). There is deliberately NO ting flag for it: a tier is set-once tuning, not
# a per-request choice, so it comes from the config chain and the key — CLAUDE.md's flag-vs-key
# rule, and the reason t-play's own --quality exists for the agent surface.
PLAY_QUALITY="$TING_PLAY_QUALITY"
# WHAT HAPPENS WHEN A TRACK ENDS, rotated live by the r key (cycle_loop_mode) and written
# back like the rest. THREE states here against the player's TWO, and the asymmetry is the
# design: `off` and `one` are the player's own `--loop` values, while `seq` is not a fact
# about a player at all — it is how THIS file builds the launch, as a queue of the rows from
# the cursor down (build_queue_from_selection). t-play cannot tell such a queue from ten
# presses of `+`, so it is never told. No ting flag, same rule as the quality tier: what
# happens after a track is set-once tuning, not a per-request choice. ARCH-tui.md「循环」.
LOOP_MODE="$TING_LOOP_MODE"
case "$LOOP_MODE" in
"") LOOP_MODE="off" ;;
off | seq | one) ;;
*) die "TING_LOOP_MODE must be off, seq or one (got '$TING_LOOP_MODE')" ;;
esac
# Which tier of key hints the view prints, rotated live by the ? key (cycle_keys) and
# written back like the other nine. There is deliberately NO ting flag for it, by the same
# rule as the quality tier above: how much of the keymap you want written down is set-once
# tuning, not a per-request choice. ARCH-tui.md.
KEYS_TIER="$TING_KEYS"
# Whether each row prints its ordinal, toggled live by the # key and written back like the
# rest. No ting flag, same rule as the key tier and the quality tier: how a list is
# LABELLED is set-once tuning, not a per-request choice. ARCH-tui.md.
# Which of the two list modes the rows are windowed by, toggled live by Tab and written back
# like the rest. `scroll` is a continuous window that follows the cursor; `page` is the fixed
# page this shipped with. No ting flag, same rule as the key tier: which shape of list you
# read in is set-once tuning. ARCH-tui.md.
LIST_MODE="$TING_LIST_MODE"
case "$LIST_MODE" in
"") LIST_MODE="scroll" ;;
scroll | page) ;;
*) die "TING_LIST_MODE must be scroll or page (got '$TING_LIST_MODE')" ;;
esac
ROW_INDEX=0
case "$TING_ROW_INDEX" in
"" | off | 0) ROW_INDEX=0 ;;
on | 1) ROW_INDEX=1 ;;
*) die "TING_ROW_INDEX must be on or off (got '$TING_ROW_INDEX')" ;;
esac
PLAY_VOLUME="$TING_VOLUME"  # --volume flag overrides
COLOR_MODE="auto"
THEME="minimal"          # --theme / TING_THEME override: minimal | mono (palette family)
BG_MODE="auto"           # TING_BG override: auto | light | dark (accent hue selection)
BG="dark"
# The background's ACTUAL colour, when the terminal was willing to say (detect_bg's OSC 11
# reply). Empty is the normal case, not an error: TING_BG=light|dark answers before the query
# runs, $COLORFGBG answers with a verdict and no colour, and tmux and dumb terminals are not
# asked at all. Everything downstream must work without it — it sharpens an answer, it does
# not enable one.
BG_R=""; BG_G=""; BG_B=""
[[ -n "${TING_THEME:-}" ]] && THEME="$TING_THEME"
[[ -n "${TING_BG:-}" ]] && BG_MODE="$TING_BG"
IMAGE_MODE="${TING_IMAGE:-auto}"  # auto | on | off — the focused row's cover art
# ROWS PER SCREEN PAGE — the display page, which is a different thing from both the fetch
# batch above and t-engine-bili's PAGE_SIZE (the remote API's own page, which is not a knob at
# all). It is only a request: display_list_menu reflows it down against terminal height.
PAGE_OPT=$TING_PAGE_ROWS
# The o key.
SORT_CYCLE=(relevance view_count duration)
# The f key: a SUBSET of the tier set. A rotation is a thing you land on by accident, and
# `low` is a choice you make on purpose, with --quality or TING_PLAY_QUALITY.
QUALITY_CYCLE=(auto medium high)
# The r key.
LOOP_CYCLE=(off seq one)
# The -s default, one value shared with both search halves.
SORT_FIELD="$TING_SORT_FIELD"  # -s flag overrides. Runtime-mutable: o rotates it (cycle_sort).
# WHICH THEME NAMES ARE LEGAL — one place. This used to be spelled five times (the cycle
# validator's allowed list, the --theme gate's pattern, that gate's message, and usage()'s
# two lists), and an eighth name meant editing five strings and forgetting one. The two
# GATES read this constant; the comma form the message wants is derived rather than rewritten.
# usage()'s two prose lists stay literal — they are English sentences, not data — and are
# held to this constant by a check in tests/contract.sh instead of by memory.
THEME_NAMES="minimal mono catppuccin tokyonight nord gruvbox onedark dracula rosepine everforest kanagawa solarized monokai"
THEME_NAMES_CSV=""
for _tn in $THEME_NAMES; do THEME_NAMES_CSV="${THEME_NAMES_CSV:+$THEME_NAMES_CSV, }$_tn"; done
unset _tn
# Membership by exact compare, not by `case " $THEME_NAMES " in *" $THEME "*`: that idiom is
# safe only when the candidate cannot contain a space, which is false of --theme's argv.
# `--theme "gruvbox onedark"` IS a substring of the name list and would pass a substring gate,
# then fall off the end of set_theme's case with no accent set at all.
theme_known() {
    local t
    for t in $THEME_NAMES; do
        if [[ "$1" == "$t" ]]; then return 0; fi
    done
    return 1
}
# The t key. Ordered so consecutive steps LAND SOMEWHERE ELSE: the four blues (tokyonight,
# nord, onedark, plus minimal's own cyan) are spread apart rather than run together, which is
# what made the old order read as one theme pressed seven times.
THEME_CYCLE=(minimal catppuccin tokyonight gruvbox rosepine nord kanagawa everforest onedark monokai solarized dracula mono)
MIN_DISP="0"
MAX_DISP="0"
query=()
while (($#)); do
    case "$1" in
    -h | --help) print_usage; exit 0 ;;
    # The same data file every other entry point reads, read the same way. This used to
    # fork t-play and awk the last field out of its PROSE — a second command's help-line
    # format turned into a dependency, in a suite whose whole argument is that callers
    # branch on envelopes rather than parse sentences.
    -V | --version) printf 'ting %s\n' "$TING_VERSION"; exit 0 ;;
    --engine)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        ENGINE="$2"; shift 2 ;;
    --engine=*) ENGINE="${1#*=}"; shift ;;
    -n)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        RESULT_N="$2"; shift 2 ;;
    -s)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        SORT_FIELD="$2"; shift 2 ;;
    -m)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        MIN_DISP="$2"; SEARCH_ARGS+=(--min-duration "$2"); shift 2 ;;
    -M)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        MAX_DISP="$2"; SEARCH_ARGS+=(--max-duration "$2"); shift 2 ;;
    -f)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PLAY_MODE="$2"; shift 2 ;;   # validated against the closed set below
    -p)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PAGE_OPT="$2"; shift 2 ;;
    --color)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        COLOR_MODE="$2"; shift 2 ;;
    --color=*) COLOR_MODE="${1#*=}"; shift ;;
    --theme)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        THEME="$2"; shift 2 ;;
    --theme=*) THEME="${1#*=}"; shift ;;
    --volume)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PLAY_VOLUME="$2"; shift 2 ;;
    --volume=*) PLAY_VOLUME="${1#*=}"; shift ;;
    --)
        shift
        while (($#)); do query+=("$1"); shift; done
        break ;;
    -*) die "unknown flag '$1' (ting flags: -n -m -M -s -f -p --color --theme --volume); run 'ting -h'" ;;
    *) query+=("$1"); shift ;;
    esac
done

is_uint "$PAGE_OPT" && ((PAGE_OPT > 0)) || die "-p must be a positive integer (TING_PAGE_ROWS)"
is_uint "$RESULT_N" && ((RESULT_N > 0)) || die "-n must be a positive integer (TING_SEARCH_RESULTS)"

# Duration bounds and volume are forwarded (-m/-M as t-play --search's --min/--max-duration,
# --volume to t-play),
# so the core would reject them anyway — but only at the first fetch or the first Enter, where
# it reads as "search failed" / a play that silently does not start. Same three checks the core
# makes (yt's is_non_negative_int), up front, in the core's own wording.
is_uint "$MIN_DISP" || die "-m must be a non-negative integer"
is_uint "$MAX_DISP" || die "-M must be a non-negative integer"
((MAX_DISP == 0 || MAX_DISP > MIN_DISP)) || die "-M must be greater than -m when both are set"
# Validated against the CLOSED SET, not against SORT_CYCLE: the cycle is the order the o key
# rotates through, not the set of fields the engines accept.
case "$SORT_FIELD" in relevance | view_count | duration) ;; *) die "-s must be one of: relevance, view_count, duration" ;; esac
# A mistyped engine is caught HERE, against what is actually installed, rather than at the
# first fetch as "search failed". The message lists what there is, because the answer to
# "which sources do I have" is not written down anywhere else.
engine_seen "$ENGINE" || die "--engine must be one of: ${ENGINES[*]}"
refresh_engine_caps
# Playback is DETACHED here (t-play -d), and a detached player has no terminal, so the
# terminal-rendering modes (ascii/viz) cannot work — the core rejects them for -d. Validate
# up front instead of letting an Enter fail silently. Same list the v key cycles.
# The closed set, for the same reason as -s above.
case "$PLAY_MODE" in audio | video | fast) ;; *) die "-f must be one of: audio, video, fast (ascii/viz need a terminal, which detached playback has none of)" ;; esac
case "$COLOR_MODE" in auto | always | never) ;; *) die "--color must be one of: auto, always, never" ;; esac
theme_known "$THEME" || die "--theme must be one of: $THEME_NAMES_CSV"
case "$BG_MODE" in auto | light | dark) ;; *) die "TING_BG must be one of: auto, light, dark" ;; esac
if [[ -n "$PLAY_VOLUME" ]]; then
    is_uint "$PLAY_VOLUME" && ((PLAY_VOLUME <= 100)) || die "--volume must be an integer 0-100"
fi
# The quality tier rides the same door: a bogus value in the user's config would otherwise
# surface as a play that silently defaults. Empty reads as auto (the engine sends no sort
# for blank or auto alike — ARCH-cli-contract.md「命令规格」); anything else is a mistyped knob
# and fails loud.
# NORMALISED to the spelling rather than left blank, because the f key rotates this value:
# a blank matches no member of the cycle, so the first press would land on the SECOND tier
# and auto would be reachable only by going all the way round.
case "$PLAY_QUALITY" in
"") PLAY_QUALITY="auto" ;;
auto | low | medium | high) ;;
*) die "TING_PLAY_QUALITY must be one of: auto, low, medium, high" ;;
esac
# The key-hint tier rides the same door, normalised the same way and for the same reason: the
# ? key rotates this value and writes it back, so the word that reaches the file has to be
# one of the two the loader will read back — a blank renders as core and would be written as
# core the moment anyone pressed the key, which is a file disagreeing with itself for one press.
case "$KEYS_TIER" in
"") KEYS_TIER="core" ;;
core | full | hidden) ;;
*) die "TING_KEYS must be one of: core, full, hidden" ;;
esac
# The resource readout's knob rides the same door. Config-only, no flag: whether the
# chrome shows the player's cpu/ram is set-once tuning, not a per-request choice.
case "$TING_RESOURCE" in 0 | 1) ;; *) die "TING_RESOURCE must be 0 or 1" ;; esac
# The cover art's one knob, and it is a KNOB rather than a key: whether this terminal draws
# pictures is set once for a terminal, not chosen per row (CLAUDE.md's flag/config split).
# The door is HERE, with the other scalar doors and before the TTY gate, so a mistyped value
# in a config file is answered by name instead of surfacing as a screen that quietly never
# draws — the failure mode a capability knob defaulting to `auto` is most likely to hide in.
case "$IMAGE_MODE" in auto | on | off) ;; *) die "TING_IMAGE must be one of: auto, on, off (got '$IMAGE_MODE')" ;; esac

# A unix-socket netcat as well as jq: every transport key (pause, seek, volume) and every
# time readout goes through the player's socket, so a machine without one loses half the
# TUI at the first keypress rather than at start-up. Any -U-capable variant passes —
# BSD/openbsd nc, or ncat (resolve_nc_unix).
require_cmd jq
resolve_nc_unix || die_dep "requires a unix-socket netcat: 'nc' with -U support, or 'ncat'"
# The self-rendered menu reads keys from stdin and draws to stdout, so BOTH must be a real
# terminal; refuse cleanly rather than hang/garble when piped (e.g. an agent).
{ [[ -t 0 ]] && [[ -t 1 ]]; } || die "requires a terminal (interactive menu); use 't-play --search' / t-play headless"

# ── Theme & Colors (init_theme): palette family + light/dark + protocol knobs ───────────
# Minimalist palette, terminal-native: minimal/mono use ANSI 16 indexed codes only, so the
# chrome follows the user's terminal theme, never imposes its own. The community themes
# (catppuccin/tokyonight/nord/gruvbox/onedark) emit 24-bit RGB only when the terminal
# advertises COLORTERM=truecolor; otherwise they fall back to the nearest ANSI-16 index.
# Hierarchy is by gray level (dim → normal → bold), and hue is THREE roles: the accent
# (C_CYAN — header, marker, rails) plus the two play-state hues, C_PLAY and C_PAUSE.
#
# THE SECOND HUE CAME BACK, and the reason the first attempt at it failed is worth keeping.
# It used to be a per-theme C_GREEN/C_YELLOW pair, and it read as "not this theme" wherever
# the accent was not green — gruvbox orange chrome beside an olive status. So both states
# were collapsed onto the accent and the GLYPH was left to carry them (▶ / ❚❚). That worked,
# and it cost the screen its only other colour: one hue over the whole frame, with 95% of it
# gray. The fix was never "no second hue" — it was that an OFF-PALETTE green is not this
# theme's green. Each palette now names its own, from its own official colours (catppuccin's
# green/yellow, rose-pine's pine/gold, kanagawa's springGreen/carpYellow…), so the status
# reads as part of the theme instead of beside it.
#
# AND THE LIGHTNESS IS NOT DECLARED — it is computed against the ground (tone_for_bg). That
# is not polish: measured, several of these palettes have NO legible green on their own light
# variant. Nord's aurora green on Snow Storm is 1.8:1 and its yellow 1.4:1; monokai, which has
# no official light variant at all, is 1.6:1 and 1.4:1 on white. A table of hexes cannot know
# that, because a hex never looks at what it is drawn on — the same thing row_hl_from_accent
# says about grounds. So the table declares the HUE and the ground decides the lightness.
#
# The ACCENT is NOT run through that, and stays exactly the hex each theme published. It is
# the one colour the theme's own authors chose for their own ground, and re-lighting it would
# be overriding them; the shipped accents measure 2.7:1 (everforest light) to 10.5:1 and that
# spread is the themes', not ours. C_MARK is the selection/filter marker (bold + accent).
# Light/dark (TING_BG=auto → $COLORFGBG → OSC 11 query → dark) picks the theme's own light
# variant (mocha/latte, night/day, polar-night/snow-storm, gruvbox dark/light,
# onedark/one-light, dracula/alucard, rose-pine/dawn, everforest dark/light, kanagawa
# wave/lotus); solarized and monokai are the two that keep ONE set across both grounds, each
# for its own reason, noted at their arms. For minimal it swaps cyan for blue, readable on
# white, and play/pause take ANSI 32/33 — on the palette whose whole property is that the
# user's terminal owns what a colour is, green is theirs to define too.
# --color auto honors NO_COLOR. TING_SYNC: synchronized redraws (DCS 1 q/2 q), on by default,
# off under tmux (see display_menu).
C_RESET=''; C_BOLD=''; C_CYAN=''; C_DIM=''; C_MARK=''; C_PLAY=''; C_PAUSE=''
# The playing row's ground. Reverse video is an ATTRIBUTE, not a hue, so THIS value is set
# unconditionally and survives --color never / NO_COLOR / a pipe: a terminal with colour
# turned off still has to be able to say which row is playing, and a screen that cannot is
# worse than one without an accent. It is the FLOOR, not the finish — set_theme replaces it
# with a tint of the accent wherever a tint can actually be drawn (row_hl_from_accent), and
# resets it back to this on every theme switch so a cycle out of a 24-bit theme cannot leave
# a ground behind that the new theme never asked for.
#
# C_ROW_END is its own reset for the same reason: C_RESET is the EMPTY STRING when colours
# are off, so ending the row with it would leave the ground running to the bottom of the
# screen. \033[0m is spelled out here and nowhere else in the row path.
C_ROW_HL=$'\033[7m'
C_ROW_END=$'\033[0m'
# The key block's keycap ground (phase 4). Empty unless a ground can be drawn at all: the
# packer closes every key with C_RESET, which is the empty string with colours off — so a
# ground set there would run to the bottom of the screen. Set only from set_theme, which
# only runs under COLORS_ON, so the existing close is exactly right and the row path's
# spelled-out C_ROW_END is not needed here.
C_KEYCAP=''
SYNC_ON=0
COLORTERM_TC=0
COLORS_ON=0             # set by init_colors; gates the live theme cycle (t key)
# TrueColor support: kitty/ghostty/wezterm/alacritty/konsole advertise COLORTERM.
# The community themes below emit 24-bit RGB ONLY then; otherwise they fall back to
# the nearest ANSI-16 index, so the chrome stays correct on limited terminals.
init_colorterm() {
    case "${COLORTERM:-}" in
    truecolor | 24bit) COLORTERM_TC=1 ;;
    esac
}
# minimal's own accent. It is the suite's floor — an ANSI-16 index whose actual color the user's
# terminal owns, which is the property minimal exists for (ARCHITECTURE.md).
accent_minimal() {
    if [[ "$BG" == light ]]; then
        C_CYAN=$'\033[34m'; C_MARK=$'\033[1;34m'
    else
        C_CYAN=$'\033[36m'; C_MARK=$'\033[1;36m'
    fi
}
# The playing row's ground, DERIVED from the accent rather than declared beside it. The
# palette has exactly one colour in it, and that is the whole design (ARCHITECTURE.md「人机面」);
# a ground written as its own constant would mean a second colour per theme per background —
# fourteen values to keep in step with seven. Mixing answers every theme at once.
#
# WHY REVERSE VIDEO WASN'T ENOUGH. It is the highest-contrast mark a terminal can make, which
# is exactly the complaint: an inverted row is a slab, it flips the text to the background
# colour, and it is louder than the fact it reports — the playing row is not more important
# than the row the reader is pointing at. A tint says the same thing at the strength the fact
# deserves and leaves the text alone. Reverse stays as the floor for terminals that cannot
# draw a tint at all, where "loud" beats "absent".
#
# The mix runs FROM THE BACKGROUND TOWARD THE ACCENT — a short step off the ground the row is
# already sitting on. Mixing from an assumed black instead is what the first cut did, and two
# themes came out invisible under it: nord's accent is a desaturated ice blue, so 30% of it is
# (40,57,62) against nord's own #2e3440 (46,52,64) — the same luminance, a ground you cannot
# see; gruvbox dark landed within five points of #282828 the same way. A percentage of the
# accent alone cannot know that, because it never looks at what it is drawn on.
#
# So look. detect_bg already ASKS the terminal for its background (OSC 11) and today keeps
# only the light/dark verdict; BG_R/G/B keep the colour from that same reply, and this mixes
# against it. Nord becomes (73,94,107) against (46,52,64) — plainly a different ground, still
# plainly a tint. No new query, no new dependency; the answer was already on the wire.
#
# When the terminal did not answer (tmux, dumb, TING_BG forced, $COLORFGBG), the assumed
# black-or-white is the SAME expression with an assumed background, not a second code path:
# mixing from black is exactly "k% of the accent", which is where this started.
#
# Two constants and not one because the eye is not symmetric about them: dark text on a pale
# ground shows a tint at a lower mix than pale text on a dark one, so the light rung is
# gentler. Both are percentages, so any theme added later gets a ground for free —
# which is the point, given the palette holds exactly one colour per theme by design.
ROW_HL_MIX_DARK=30
ROW_HL_MIX_LIGHT=18
row_hl_from_accent() {
    local r=$1 g=$2 b=$3 zr zg zb k
    if [[ "$BG" == light ]]; then
        zr=255; zg=255; zb=255; k=$ROW_HL_MIX_LIGHT
    else
        zr=0; zg=0; zb=0; k=$ROW_HL_MIX_DARK
    fi
    if [[ -n "$BG_R" ]]; then zr=$BG_R; zg=$BG_G; zb=$BG_B; fi
    printf -v C_ROW_HL '\033[48;2;%d;%d;%dm' \
        $((zr + (r - zr) * k / 100)) $((zg + (g - zg) * k / 100)) $((zb + (b - zb) * k / 100))
}

# ── The status hues: the palette names the HUE, the ground sets the lightness ───────────
# C_PLAY and C_PAUSE are the only colours on this screen that are COMPUTED from a declared
# value rather than printed as declared, and the measurement that forced it is in the palette
# note above: nord's own green is 1.8:1 on nord's own light variant, monokai's is 1.6:1 on
# white. Those are not bad choices by their authors — those palettes were drawn for a dark
# ground, and their green was never meant to sit on paper. A second hue that cannot be seen
# is worse than the single hue it replaced, so the hex declares which green this theme means
# and this walks its lightness until it clears the floor against the ground actually in use.
#
# SAME GROUND AS EVERY OTHER MIX HERE: BG_R/G/B from detect_bg's OSC 11 reply when the
# terminal answered, the assumed black/white when it would not. No new query, no new
# dependency — and on a terminal whose real background is not the theme's own (the common
# case: nord's palette on a pure-black terminal), this is measuring the truth rather than
# the theme author's assumption.
#
# DARKENING IS A PURE MULTIPLY (x*92/100 on all three channels), which holds the ratios
# between channels and therefore the hue EXACTLY — the light path is the one that matters,
# since it is where every failure was. Lightening mixes toward white instead, which does
# wash the hue out; it is the rarer path (one theme, one step: rose-pine's pine on its own
# near-black ground) and there is no way to raise a channel already at 255 without it.
#
# THE LUMINANCE IS A GAMMA-2 INTEGER PROXY, not WCAG's ((c+0.055)/1.055)^2.4 — that curve
# needs floating point, and bash has none. Checked against the real formula across all 13
# palettes on both grounds, a proxy floor of 3.50 lands every derived colour between 3.4:1
# and 4.5:1 true, which is the accuracy this needs: the floor is a legibility threshold, not
# a published number. Worst case is 8 iterations of integer multiply, zero forks, and it runs
# twice per set_theme — at startup and on the t key.
TONE_FLOOR=350          # contrast ratio x100, in proxy units
LUM8=0
lum8() { LUM8=$(( (2126 * ($1 * $1 / 255) + 7152 * ($2 * $2 / 255) + 722 * ($3 * $3 / 255)) / 255 )); }
TONE_R=0; TONE_G=0; TONE_B=0
tone_for_bg() {
    local r=$1 g=$2 b=$3 zr zg zb lg lc hi lo i=0
    if [[ "$BG" == light ]]; then zr=255; zg=255; zb=255; else zr=0; zg=0; zb=0; fi
    if [[ -n "$BG_R" ]]; then zr=$BG_R; zg=$BG_G; zb=$BG_B; fi
    lum8 "$zr" "$zg" "$zb"; lg=$LUM8
    while ((i < 40)); do
        lum8 "$r" "$g" "$b"; lc=$LUM8
        if ((lc > lg)); then hi=$lc; lo=$lg; else hi=$lg; lo=$lc; fi
        (( (hi + 500) * 100 / (lo + 500) >= TONE_FLOOR )) && break
        if ((lg > lc)); then
            r=$((r * 92 / 100)); g=$((g * 92 / 100)); b=$((b * 92 / 100))
            ((r == 0 && g == 0 && b == 0)) && break
        else
            r=$((r + (255 - r) * 8 / 100)); g=$((g + (255 - g) * 8 / 100)); b=$((b + (255 - b) * 8 / 100))
            ((r > 247 && g > 247 && b > 247)) && break
        fi
        i=$((i + 1))
    done
    TONE_R=$r; TONE_G=$g; TONE_B=$b
}

# ── The keycap's ground: a SURFACE, and therefore the one ground with no hue ────────────
# The hint block's keys sit on a ground instead of wearing brackets. Brackets are two more
# glyphs per key — 48 cells across the block — and measured, that is a whole extra line in
# English at both 100 and 62 columns; a line this block cannot spend, because its own gate
# (nav_ok) drops the WHOLE block when it no longer fits and falls back to the banner's three
# keys. A ground with no padding costs nothing: the separator goes from " · " to three
# spaces, three cells for three cells, and the block comes out exactly as tall as it was.
#
# NO HUE, and that is the difference from every other ground on this screen. A keycap is a
# surface the key is printed on, not a state — so it is mixed from the terminal's own
# background toward the OPPOSITE POLE (white on a dark terminal, black on a light one),
# which lands on a neutral grey. The playing row's ground is mixed toward the ACCENT and
# stays the only hued ground in the frame: two grounds that differ in hue read as two
# different kinds of fact, which is what they are. Mixing the caps toward the accent would
# have put twenty-four accent chips on the busiest line of the chrome and made "the accent"
# mean both "this row is playing" and "this is a key".
#
# The rungs are gentler than the row's (14/10 against 30/18): a cap has to read as a raised
# surface behind three cells of text, while the row's ground has to be findable at a glance
# from anywhere on the screen. Same expression, same BG_R/G/B from detect_bg's OSC 11 reply,
# same assumed black/white when the terminal would not answer.
#
# minimal takes the INDEX rung even on a truecolor terminal, for the reason the source pill
# does: minimal's property is that the user's terminal owns what a colour is. 100;97 sets
# both ends (bright-black ground, bright-white glyph) so it is legible on a light terminal
# and on a dark one — a bare 47 or 100 would be invisible on one of the two. mono gets
# nothing at all: its promise is bold and dim, and a chip is neither.
KEYCAP_MIX_DARK=14
KEYCAP_MIX_LIGHT=10
# The block's separator, declared beside the ground it replaces the dot for: three cells of
# air, exactly what " · " measured, so the swap cannot change the block's height.
KEYCAP_SEP="   "
keycap_ground() {
    C_KEYCAP=''
    [[ "$THEME" == "mono" ]] && return 0
    if ((COLORTERM_TC)) && [[ "$THEME" != "minimal" ]]; then
        local zr zg zb tr tg tb k
        if [[ "$BG" == light ]]; then
            zr=255; zg=255; zb=255; tr=0; tg=0; tb=0; k=$KEYCAP_MIX_LIGHT
        else
            zr=0; zg=0; zb=0; tr=255; tg=255; tb=255; k=$KEYCAP_MIX_DARK
        fi
        if [[ -n "$BG_R" ]]; then zr=$BG_R; zg=$BG_G; zb=$BG_B; fi
        printf -v C_KEYCAP '\033[48;2;%d;%d;%dm' \
            $((zr + (tr - zr) * k / 100)) $((zg + (tg - zg) * k / 100)) $((zb + (tb - zb) * k / 100))
    else
        C_KEYCAP=$'\033[100;97m'
    fi
}

set_theme() {
    # Back to the floor before anything is resolved. The t key re-enters this function on a
    # live screen, and a theme with no tint of its own (minimal and mono by design, and every
    # theme at all on a terminal that cannot draw 24-bit) must not inherit the ground the
    # PREVIOUS theme installed — that would be one theme's colour surviving into another's.
    C_ROW_HL=$'\033[7m'
    # The keycap ground follows the same rule, and it is resolved at the END of this function
    # rather than here: it depends on the theme and the background, not on the accent.
    C_KEYCAP=''
    # The eleven community themes pass through the same filter: a signature accent, that
    # palette's OWN green and yellow for the two play states, gray hierarchy for everything
    # else. Hexes are the official palettes; light/dark is the theme's own light variant
    # (catppuccin mocha/latte, tokyonight night/day, nord polar-night/snow-storm, gruvbox
    # dark/light, onedark/one-light, dracula/alucard, rose-pine/dawn, everforest dark/light,
    # kanagawa wave/lotus). The accent prints as declared; play/pause go through tone_for_bg.
    local acc_r acc_g acc_b a16
    local play_r play_g play_b p16
    local paus_r paus_g paus_b q16
    case "$THEME" in
    minimal)
        accent_minimal
        C_PLAY=$'\033[32m'; C_PAUSE=$'\033[33m'
        ;;
    mono)
        # mono's promise is bold and dim, and that is exactly enough to separate two states:
        # the steady one is bold, the held one is dim. A hue here would be the one thing the
        # name rules out.
        C_CYAN=''; C_MARK=$'\033[1m'; C_PLAY=$'\033[1m'; C_PAUSE=$'\033[2m'
        ;;
    catppuccin | tokyonight | nord | gruvbox | onedark | dracula | rosepine | everforest | kanagawa | solarized | monokai)
        case "$THEME:$BG" in
        catppuccin:dark)  acc_r=203; acc_g=166; acc_b=247; a16=35
                          play_r=166; play_g=227; play_b=161; p16=32
                          paus_r=249; paus_g=226; paus_b=175; q16=33 ;;
        catppuccin:light) acc_r=136; acc_g=57;  acc_b=239; a16=35
                          play_r=64;  play_g=160; play_b=43;  p16=32
                          paus_r=223; paus_g=142; paus_b=29;  q16=33 ;;
        tokyonight:dark)  acc_r=122; acc_g=162; acc_b=247; a16=34
                          play_r=158; play_g=206; play_b=106; p16=32
                          paus_r=224; paus_g=175; paus_b=104; q16=33 ;;
        tokyonight:light) acc_r=46;  acc_g=125; acc_b=233; a16=34
                          play_r=88;  play_g=117; play_b=57;  p16=32
                          paus_r=140; paus_g=108; paus_b=62;  q16=33 ;;
        # Nord publishes ONE aurora set, used on both the Polar Night and the Snow Storm
        # ground; #a3be8c on Snow Storm is the 1.8:1 that tone_for_bg exists for.
        nord:dark | nord:light)
                          acc_r=136; acc_g=192; acc_b=208; a16=36
                          play_r=163; play_g=190; play_b=140; p16=32
                          paus_r=235; paus_g=203; paus_b=139; q16=33
                          [[ "$BG" == light ]] && { acc_r=94; acc_g=129; acc_b=172; } ;;
        gruvbox:dark)     acc_r=214; acc_g=93;  acc_b=14;  a16=33
                          play_r=184; play_g=187; play_b=38;  p16=32
                          paus_r=250; paus_g=189; paus_b=47;  q16=33 ;;
        gruvbox:light)    acc_r=175; acc_g=58;  acc_b=3;   a16=31
                          play_r=121; play_g=116; play_b=14;  p16=32
                          paus_r=181; paus_g=118; paus_b=20;  q16=33 ;;
        onedark:dark)     acc_r=97;  acc_g=175; acc_b=239; a16=34
                          play_r=152; play_g=195; play_b=121; p16=32
                          paus_r=229; paus_g=192; paus_b=123; q16=33 ;;
        onedark:light)    acc_r=64;  acc_g=120; acc_b=242; a16=34
                          play_r=80;  play_g=161; play_b=79;  p16=32
                          paus_r=193; paus_g=132; paus_b=1;   q16=33 ;;
        # dracula's light variant is ALUCARD — the Dracula project's own, not a guess at one.
        dracula:dark)     acc_r=189; acc_g=147; acc_b=249; a16=35
                          play_r=80;  play_g=250; play_b=123; p16=32
                          paus_r=241; paus_g=250; paus_b=140; q16=33 ;;
        dracula:light)    acc_r=100; acc_g=74;  acc_b=201; a16=35
                          play_r=20;  play_g=113; play_b=10;  p16=32
                          paus_r=132; paus_g=110; paus_b=21;  q16=33 ;;
        # rose-pine has no green AT ALL — the palette is love/gold/rose/pine/foam/iris. Pine
        # is what it uses where other themes use green, so pine is what plays here, and p16
        # follows it to cyan rather than pretending an ANSI green was ever the fallback.
        rosepine:dark)    acc_r=235; acc_g=188; acc_b=186; a16=35
                          play_r=49;  play_g=116; play_b=143; p16=36
                          paus_r=246; paus_g=193; paus_b=119; q16=33 ;;
        rosepine:light)   acc_r=180; acc_g=99;  acc_b=122; a16=35
                          play_r=40;  play_g=105; play_b=131; p16=36
                          paus_r=234; paus_g=157; paus_b=52;  q16=33 ;;
        # everforest's ACCENT is the green, so the play state takes aqua: a second green
        # beside a green accent says nothing, which is the whole failure this design is
        # correcting, only in reverse.
        everforest:dark)  acc_r=167; acc_g=192; acc_b=128; a16=32
                          play_r=131; play_g=192; play_b=146; p16=36
                          paus_r=230; paus_g=152; paus_b=117; q16=33 ;;
        everforest:light) acc_r=141; acc_g=161; acc_b=1;   a16=32
                          play_r=53;  play_g=167; play_b=124; p16=36
                          paus_r=245; paus_g=125; paus_b=0;   q16=33 ;;
        kanagawa:dark)    acc_r=228; acc_g=104; acc_b=118; a16=31
                          play_r=152; play_g=187; play_b=108; p16=32
                          paus_r=230; paus_g=195; paus_b=132; q16=33 ;;
        kanagawa:light)   acc_r=200; acc_g=64;  acc_b=83;  a16=31
                          play_r=111; play_g=137; play_b=78;  p16=32
                          paus_r=204; paus_g=109; paus_b=0;   q16=33 ;;
        # Solarized's thesis is that ONE accent set works on both grounds — only the base
        # tones flip. Giving it a light variant would be contradicting the theme, not
        # completing it, so both grounds get the same hexes and tone_for_bg does the rest.
        solarized:dark | solarized:light)
                          acc_r=42;  acc_g=161; acc_b=152; a16=36
                          play_r=133; play_g=153; play_b=0;   p16=32
                          paus_r=181; paus_g=137; paus_b=0;   q16=33 ;;
        # monokai has NO official light variant, and its signature yellow (#e6db74) is 1.4:1
        # on white — unusable as an accent, and not something tone_for_bg is allowed to fix
        # since the accent prints as declared. So the accent is monokai's pink on both
        # grounds: it is equally a monokai signature, it is 10:1 on monokai's own ground and
        # 3.8:1 on white, and holding ONE hue across both grounds is what every other theme
        # here does — they shift lightness, never hue.
        monokai:dark | monokai:light)
                          acc_r=249; acc_g=38;  acc_b=114; a16=35
                          play_r=166; play_g=226; play_b=46;  p16=32
                          paus_r=253; paus_g=151; paus_b=31;  q16=33 ;;
        esac
        if ((COLORTERM_TC)); then
            printf -v C_CYAN '\033[38;2;%d;%d;%dm' "$acc_r" "$acc_g" "$acc_b"
            printf -v C_MARK '\033[1;38;2;%d;%d;%dm' "$acc_r" "$acc_g" "$acc_b"
            row_hl_from_accent "$acc_r" "$acc_g" "$acc_b"
            tone_for_bg "$play_r" "$play_g" "$play_b"
            printf -v C_PLAY '\033[38;2;%d;%d;%dm' "$TONE_R" "$TONE_G" "$TONE_B"
            tone_for_bg "$paus_r" "$paus_g" "$paus_b"
            printf -v C_PAUSE '\033[38;2;%d;%d;%dm' "$TONE_R" "$TONE_G" "$TONE_B"
        else
            # No tone_for_bg on this rung, and it is not an omission: what 31-36 render as is
            # the user's terminal to decide, so there is no colour here to re-light.
            C_CYAN=$'\033['"$a16"m
            C_MARK=$'\033[1;'"$a16"m
            C_PLAY=$'\033['"$p16"m
            C_PAUSE=$'\033['"$q16"m
        fi
        ;;
    esac
    # Last, and outside the case: it reads the theme and the background, not the accent, so
    # every arm above resolves it the same way and no arm has to remember to.
    keycap_ground
}
init_colors() {
    local on=0
    case "$COLOR_MODE" in
    auto) [[ -t 1 && -z "${NO_COLOR:-}" ]] && on=1 ;;
    always) on=1 ;;
    never) on=0 ;;
    esac
    COLORS_ON=0
    if ((on)); then
        COLORS_ON=1
        C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
        set_theme
    fi
}

# ── 音源胶囊：屏上唯一一处颜色不属于主题的地方 ────────────────────────────────────────
# 状态行第一段过去是裸的 `ne` / `yt` / `bili` —— 决定每一个其他段落含义的那一段，
# 却和它右边的计数、排序、模式印成同一个灰。胶囊给它一格底色与左右各半格空气：
# 一个词读成一个物件，而不是一串短语的第一个词。
#
# **字仍然是 `ne` 而不是 `NetEase`。** 那个 token 是 `--engine` 收的词、也是行按自己的
# `engine` 字段路由时用的词；屏上换成品牌全名，等于让读者在两套词汇之间做翻译，而它换来的
# 只是宽度：状态段从 39 格涨到 46，行内右贴的门槛（`st_w + 29`）从 68 列推到 75 列，
# 于是一台 72 列的终端从此多花一行 chrome、少一行结果。带底色的 token 是 41 格 / 70 列。
#
# **底色是身份，不是状态 —— 这就是它与被删掉的 `C_GREEN`/`C_YELLOW` 的区别。**
# 「一次运行只说一套主题、色相只有一个强调色」那条正本（本文档「chrome 一次运行只说一套主题」）
# 管的是**状态**色相：播放绿、暂停黄和强调色抢的是同一份工作（"这一处要你看"），
# 所以它们退场、由字形接手。品牌底色答的是另一个问题（"这些行是谁家的"），
# 它自带前景与背景两端、不与任何 chrome 元素争同一条视线，也从不随主题变 ——
# 它是外部服务的标识，不是我们调色板的一员。这是一个**例外**，按例外记账。
#
# 三档，按各自的主题已经许诺过的东西发：
#   mono      不发底色。mono 的承诺就是零色相，一块红疤是在替用户改他刚做的选择。
#   minimal   ANSI-16 的底色索引（41/45）。minimal 的性质是"红是什么由用户终端说"，
#             一个索引正好是这句话；它刻意不发 RGB，所以在真彩终端上也走这一档。
#   其余主题  真彩下发品牌自己的 RGB，否则退回同一个 ANSI-16 索引 —— 与强调色同一条阶梯。
#
# **未知引擎没有胶囊，退回裸 token。** 引擎是 `scan_engines` 探测出来的，这个文件不持有源
# 清单（本文档「引擎发现」）；一张写死的品牌表只能认识它写下的那几个，所以第四个引擎丢进来
# 时必须是"没有底色"，而不是"随便给一个颜色"。混源歌单（`PLAYLIST_ENGINES` 是
# `unique | join("+")`，`ne+yt`）走同一条出口：一块底色压在两个品牌上是一句假话。
#
# 段落是 PLAIN TEXT 加一个颜色，**不是一串带转义的字符串** —— `disp_w` 的契约是"量纯文本，
# 颜色在打印时施加"，而状态段两条路径（行内右贴那一串、`print_hints` 那条回退行）都要量它。
# 把 SGR 焙进段落里，那 20 个字节会被算成 20 格，右贴的 CHA 就落错列。所以颜色走
# `PILL_MARK` 这条自己的通道，两条路径共用同一份纯文本。
#
# **为什么不做成 `HINT_PILL` 这样一个按调用生效的全局**（`HINT_SEP` / `HINT_KEY_COLOR` 的形状）：
# 那样的全局只能表达"第一个 item 带底色"，也就是把底色钉在一个**位置**上。这个文件在同一个
# 打包器的另一头已经拒绝过这件事 —— `nav_items` 那段注释写着"按 index 往成品数组里插，
# index 就是位置，于是每加一个键都会挪动它"。底色是**那一个段落自己的**属性，
# 所以它跟着段落走，不跟着调用走。
PILL_MARK=$'\x1f'
SOURCE_SEG=""
source_seg() {
    local eng=$1 rgb="" a16=""
    SOURCE_SEG="$eng"
    ((COLORS_ON)) || return 0
    [[ "$THEME" == "mono" ]] && return 0
    case "$eng" in
    yt)   rgb='190;30;30';   a16=41 ;;
    bili) rgb='230;100;140'; a16=45 ;;
    ne)   rgb='180;20;20';   a16=41 ;;
    *) return 0 ;;
    esac
    local sgr
    if ((COLORTERM_TC)) && [[ "$THEME" != "minimal" ]]; then
        printf -v sgr '\033[48;2;%sm\033[38;2;255;255;255m' "$rgb"
    else
        printf -v sgr '\033[%d;97m' "$a16"
    fi
    SOURCE_SEG="${PILL_MARK}${sgr}${PILL_MARK} $eng "
}
init_sync() {
    case "${TING_SYNC:-auto}" in
    0 | off) SYNC_ON=0 ;;
    1 | on) SYNC_ON=1 ;;
    auto) [[ -z "${TMUX:-}" && "${TERM:-}" != dumb ]] && SYNC_ON=1 || SYNC_ON=0 ;;
    *) die "TING_SYNC must be 0, 1 or auto (got '$TING_SYNC')" ;;
    esac
}

# ── The cover art's capability layer: two queries, once, at startup ──────────────────────
# Both read the terminal the way detect_bg's OSC 11 query already does — write, then collect
# the reply byte by byte (bash 3.2 has no `read -d`), capped, with `read -t 1` as the only
# timeout the floor offers. The cost of an unanswered probe is therefore ONE SECOND, once,
# which is why neither runs under tmux or on a dumb terminal and why the answers are cached
# in globals rather than re-asked on the render path.
IMAGE_ON=0
# The fallback cell, and it is a real terminal's, not a neutral number: 8x16 is the classic
# VGA text cell and what a terminal that will not answer XTWINOPS most likely has. It is only
# ever a fallback — a cover sized from a guessed cell is the WRONG SIZE, not a smaller one.
IMAGE_CW=8
IMAGE_CH=16
# Does this terminal speak the kitty graphics protocol? The query is the protocol's own
# `a=q`: transmit one RGB pixel and ask about it, which a terminal that implements it answers
# `OK` and every other terminal ignores entirely. Nothing is displayed either way.
image_probe() {
    local resp="" b
    printf '\033_Gi=99,s=1,v=1,a=q,t=d,f=24;AAAA\033\\'
    while IFS= read -rsn1 -t 1 b; do
        resp+="$b"
        case "$resp" in *$'\033\\'*) break ;; esac
        if ((${#resp} > 64)); then break; fi
    done
    case "$resp" in *";OK"*) return 0 ;; esac
    return 1
}
# HOW BIG IS ONE CELL, in pixels. Measured 2026-09-03 on Ghostty at 16x36 — NOT the 8x16 the
# arithmetic "a cell is about twice as tall as it is wide" predicts, and not close enough to
# it to round: sizing the cover from the guess would draw it 12 cells wide where 24 was asked
# for, a quarter of the intended box, because the transcode target is in PIXELS and the
# placement is in CELLS. So it is asked, not derived. XTWINOPS `CSI 16 t` answers
# `CSI 6 ; <height> ; <width> t`, and a terminal that does not implement it stays silent —
# which is what the 8x16 fallback above is for.
image_cell_px() {
    local resp="" b code="" h="" w=""
    printf '\033[16t'
    while IFS= read -rsn1 -t 1 b; do
        resp+="$b"
        case "$resp" in *t) break ;; esac
        if ((${#resp} > 64)); then break; fi
    done
    # `6` is the reply's own discriminator — XTWINOPS answers 6 for the CELL size and 4/8 for
    # the window and text area, and a terminal that answered a DIFFERENT question must not have
    # its answer read as this one. Split on ';' rather than with ${var#*[…]} patterns: `[` opens
    # a bracket expression in a glob, so the obvious strip is a pattern that means something else.
    resp="${resp#*\[}"
    resp="${resp%t*}"
    IFS=';' read -r code h w <<<"$resp" || true
    if [[ "$code" == 6 ]] && is_uint "$h" && is_uint "$w" && ((h > 0 && w > 0)); then
        IMAGE_CH="$h"; IMAGE_CW="$w"
    fi
}
# `auto` resolves in the SAME ORDER, and every step is separately decidable — which is what
# makes each one a check that can go red on its own.
#
# The tmux step is TING_SYNC's precedent followed, not a new rule invented: a multiplexer needs
# the escape passed through, it commonly is not, and the honest default there is off. `on` is
# the door for the user who has configured passthrough themselves — it skips tmux, TERM and
# the probe alike, because a user who set it has already answered the question the probe asks.
init_image() {
    case "$IMAGE_MODE" in
    off) IMAGE_ON=0; return 0 ;;
    on) IMAGE_ON=1 ;;
    auto)
        if [[ -n "${TMUX:-}" || "${TERM:-}" == dumb ]]; then
            IMAGE_ON=0
            return 0
        fi
        case "${TERM:-}" in
        *kitty* | *ghostty*) IMAGE_ON=1 ;;
        *)
            case "${TERM_PROGRAM:-}" in
            ghostty | Ghostty | wezterm | WezTerm | kitty | Kitty) IMAGE_ON=1 ;;
            *)
                if image_probe; then IMAGE_ON=1; else IMAGE_ON=0; return 0; fi
                ;;
            esac
            ;;
        esac
        ;;
    esac
    # Only once we are going to draw — an unanswered XTWINOPS query costs the same second the
    # capability probe does, and there is no reason to spend it on a terminal we will not draw on.
    image_cell_px
}

# ── The cover art itself: cache, transcode, emit ─────────────────────────────────────────
# THE BOX is 24 columns by 7 rows, and both numbers are constants rather than knobs: it is
# sized to the detail block it hangs off, and a second way to say how big a picture is would
# be a second thing to keep in step with the budget gate below.
IMAGE_BOX_COLS=24
IMAGE_BOX_ROWS=7
# The two floors, and both are stated in what they PROTECT rather than in a terminal size:
# 50 columns of detail text, and 4 rows of list. Under either floor
# there is no cover at all — never a smaller one, because a second size means a second
# transcode target and a second layout to keep in step with the budget.
IMAGE_MIN_TEXT_COLS=50
IMAGE_MIN_ROWS=4
# ONE image is ever on screen, so its id is a constant. That is what lets the delete name
# this image (`d=i,i=`) instead of taking the `d` default, which is EVERY placement on the
# screen — inside a multiplexer, other applications' pictures included.
IMAGE_ID=99
IMAGE_GATE=0        # this frame is drawing a cover (charged to detail_h either way)
IMAGE_DIRTY=0       # the focused row has a cover that is not in the cache yet
IMAGE_DRAWN=0       # something is on the screen and has to be deleted before anything else
IMAGE_PLACED=""     # …and WHAT: the file, the column and the row it was placed at
IMAGE_DIR=""
IMAGE_KEY_URL=""    # the row image_png/image_cols were resolved for — the memo, not a cache
IMAGE_JOB_PID=""    # the fetch+transcode running off the key loop, if one is
IMAGE_JOB_URL=""    # …and which row it is for
IMAGE_FAIL_URL=""   # the one row already tried and not gettable: tried once, never again
IMAGE_PNG=""        # the file this frame should emit; "" = nothing to emit
IMAGE_COLS=0        # how many columns that file will take, for the right flush
IMAGE_TICK=0        # spinner frame for the in-flight cover status

# The cache lives under TMPDIR, NOT under $TING_STATE_DIR, and the distinction is the suite's
# own: the state dir holds what a person saved and what a player played, and its layout
# belongs to the two store commands (the note beside PLAYLIST_BIN says this file never
# touches it). A cover is neither — it is a CDN url's bytes, regenerable in 0.15s and
# expiring on someone else's schedule, which is the definition of a cache and not of state.
# Every other scratch file in this file is already ${TMPDIR:-/tmp}; this one is too.
image_cache_dir() {
    local f
    [[ -n "$IMAGE_DIR" ]] && return 0
    IMAGE_DIR="${TMPDIR:-/tmp}/ting-covers-$(id -u 2>/dev/null || echo 0)"
    mkdir -p "$IMAGE_DIR" 2>/dev/null || { IMAGE_DIR=""; return 1; }
    chmod 700 "$IMAGE_DIR" 2>/dev/null || true
    # Trimmed ONCE, here, and never on the render path: 200 files of this size is a few MB,
    # and a prune that ran per frame would be a `ls` fork per keypress to reclaim nothing.
    # `|| true` for the same pipefail reason as the two globs below: an empty cache dir is
    # the normal first run, not a failure, and it must not end the process.
    { ls -t "$IMAGE_DIR" 2>/dev/null | tail -n +201 | while IFS= read -r f; do
        [[ -n "$f" ]] && rm -f "$IMAGE_DIR/$f"
    done; } || true
    return 0
}

# A url to a filename, without a hash — bash 3.2 has no builtin one and shasum/md5 are a
# cross-platform divergence to maintain for a cache key. Keeping only the alphanumerics of
# the url is enough: two different urls that collide would have to differ in punctuation
# alone. Written as an anchored walk rather than ${url//[!A-Za-z0-9]/}, which is quadratic
# on 3.2 (the portability contract), and run once per SELECTION rather than once per frame.
IMAGE_KEY=""
image_key() {
    local u=$1 c out=""
    while [[ -n "$u" ]]; do
        c="${u:0:1}"
        u="${u:1}"
        case "$c" in [A-Za-z0-9]) out="$out$c" ;; esac
    done
    # The tail, not the head: every url from one site shares its head, and 80 characters of
    # `httpswwwyoutubecomwatchv` is a filename that says nothing.
    #
    # GUARDED, because `${out: -40}` on a string SHORTER than 40 evaluates to the EMPTY
    # STRING on the 3.2 floor (measured) rather than to the whole string — and an empty key
    # is one cache file that every short url would share.
    if ((${#out} > 40)); then IMAGE_KEY="${out: -40}"; else IMAGE_KEY="$out"; fi
}

# The PNG's own width, read from the PNG header rather than asked of a tool: bytes 16-19 are
# the IHDR width, big-endian. `od -tx1` is endian-safe where `-tu4` is not, and this runs
# once per TRANSCODE, never per frame — which is why the column count is baked into the
# cached file's NAME and not recomputed by anyone who wants to draw it.
image_png_cols() {
    local f=$1 b1 b2 b3 b4 w
    read -r b1 b2 b3 b4 <<<"$(od -An -tx1 -j16 -N4 "$f" 2>/dev/null)" || return 1
    [[ -n "$b4" ]] || return 1
    w=$(( (16#$b1 << 24) + (16#$b2 << 16) + (16#$b3 << 8) + 16#$b4 ))
    ((w > 0)) || return 1
    printf '%s' $(( (w + IMAGE_CW - 1) / IMAGE_CW ))
}

# Fetch and transcode, and it is called from the CLOCK, never from a frame — both halves are
# blocking (a request, then an mpv) and a keypress must not wait on either. On any failure at
# all the answer is silence: no cover for this row, no message, no retry. A cover is the one
# thing on this screen whose absence costs the user nothing.
image_prepare() {
    local url=$1 tmp png cols f
    image_cache_dir || return 1
    image_key "$url"
    tmp="$IMAGE_DIR/$IMAGE_KEY.src"
    # 5 seconds, not 3: a cover really can be 2MB (measured 2026-09-03, a 1400x1400 NetEase
    # album cover). A timeout is not an error path here, it is "no cover this time".
    curl -fsSL --max-time 5 -o "$tmp" "$url" 2>/dev/null || { rm -f "$tmp"; return 1; }
    # NO FORMAT SNIFFING, and that is the whole design: the extension lies (YouTube serves
    # WebP from a .jpg url) and so may the Content-Type, so the bytes go to the one dependency
    # that already knows every format the sites use. What mpv decodes, we draw; what it does
    # not, we do not. There is no mimetype table to maintain because there is no mimetype.
    #
    # The box is in PIXELS and comes from the cell size this terminal reported, not from a
    # constant: at 8x16 the box is 192x112 and at the 16x36 measured here it is 384x252, and
    # a cover transcoded to the wrong one is drawn at the wrong SIZE, not merely resampled.
    # force_original_aspect_ratio=decrease is what keeps a square album cover square and a
    # 16:9 still wide — the image is fitted INSIDE the box, never stretched to it.
    rm -f "$IMAGE_DIR/$IMAGE_KEY".*.png 2>/dev/null || true
    rm -rf "$IMAGE_DIR/$IMAGE_KEY.out" 2>/dev/null || true
    mkdir -p "$IMAGE_DIR/$IMAGE_KEY.out" 2>/dev/null || true
    # --no-terminal AND stdin from /dev/null, and this is the pair that makes running mpv
    # underneath a live TUI safe at all. mpv's default terminal handling puts the tty into
    # its own mode and READS KEYS FROM IT — sharing a terminal with the app that owns it, it
    # eats the user's keystrokes. Measured: with this transcode running in the background,
    # `tests/contract.sh` saw # and v stop toggling, because the bytes went to mpv. It costs
    # nothing here (this mpv has no user, it writes a file), and --really-quiet alone does
    # NOT cover it: that silences output, and the problem is input.
    mpv "$tmp" --frames=1 --no-audio --no-config --no-terminal \
        --vf="scale=w=$((IMAGE_BOX_COLS * IMAGE_CW)):h=$((IMAGE_BOX_ROWS * IMAGE_CH)):force_original_aspect_ratio=decrease" \
        --vo=image --vo-image-format=png --vo-image-outdir="$IMAGE_DIR/$IMAGE_KEY.out" \
        --really-quiet </dev/null >/dev/null 2>&1 || true
    rm -f "$tmp"
    # A GLOB, not `ls … | head -1`: with `set -o pipefail` a pipeline whose first command
    # finds nothing carries ITS status, the assignment inherits it, and `set -e` kills the
    # process — which is how the first version of this file quit mid-frame the moment a row
    # had no cached cover yet (the common case: every first look at a row).
    png=""
    for f in "$IMAGE_DIR/$IMAGE_KEY.out"/*.png; do
        [[ -e "$f" ]] || continue
        png="$f"
        break
    done
    [[ -n "$png" ]] || { rm -rf "$IMAGE_DIR/$IMAGE_KEY.out"; return 1; }
    cols=$(image_png_cols "$png") || cols=""
    [[ -n "$cols" ]] || cols=$IMAGE_BOX_COLS
    mv "$png" "$IMAGE_DIR/$IMAGE_KEY.$cols.png" 2>/dev/null || true
    rm -rf "$IMAGE_DIR/$IMAGE_KEY.out"
    return 0
}

# OFF THE KEY LOOP, and this is a correctness rule rather than a speed one. The two halves
# of getting a cover are a request and an mpv, and the request alone is allowed five seconds
# — run inline on the clock, that is a UI that stops answering the keyboard for five seconds
# the first time the cursor lands on a row. It is not hypothetical: it is what
# `tests/contract.sh` saw the moment the draw path landed, as a filter that would not narrow
# and a store key that would not open, because the keys were queued behind a download.
#
# ONE JOB AT A TIME. Holding a key down would otherwise start a fetch per row and the
# machine would spend its bandwidth on rows the user has already left; the frame that wants
# a cover simply asks again on the next tick, and the tick is one second.
#
# `trap -` INSIDE THE SUBSHELL, and it is not optional: a bash subshell inherits the EXIT
# trap, so without this every finished fetch would run cleanup_on_exit — restoring the tty
# mid-session, flushing preferences, and STOPPING THE USER'S PLAYER — from a child whose only
# job was to write a PNG.
image_prepare_bg() {
    local url=$1
    [[ -n "$url" ]] || return 0
    if [[ -n "$IMAGE_JOB_PID" ]] && kill -0 "$IMAGE_JOB_PID" 2>/dev/null; then return 0; fi
    IMAGE_JOB_URL="$url"
    ( trap - EXIT INT TERM HUP; image_prepare "$url" ) </dev/null >/dev/null 2>&1 &
    IMAGE_JOB_PID=$!
    return 0
}

# What the CURRENT frame can draw, memoised on the row's url so the glob below costs one
# stat per SELECTION rather than one per keypress. It never fetches: a frame that finds no
# cached cover says so by raising IMAGE_DIRTY, and the clock picks it up.
image_focus() {
    local url=$1 f c
    [[ "$url" == "$IMAGE_KEY_URL" ]] && return 0
    IMAGE_KEY_URL="$url"
    IMAGE_PNG=""
    IMAGE_COLS=0
    IMAGE_DIRTY=0
    [[ -n "$url" ]] || return 0
    image_cache_dir || return 0
    image_key "$url"
    # A glob and not `ls`, for the reason image_prepare states: an unmatched pipeline under
    # pipefail + set -e ends the process. It is also the cheaper of the two on a path that
    # runs once per selection — a glob is a builtin, `ls | head` is two forks.
    f=""
    for c in "$IMAGE_DIR/$IMAGE_KEY".*.png; do
        [[ -e "$c" ]] || continue
        f="$c"
        break
    done
    if [[ -n "$f" ]]; then
        IMAGE_PNG="$f"
        IMAGE_COLS="${f%.png}"; IMAGE_COLS="${IMAGE_COLS##*.}"
        is_uint "$IMAGE_COLS" || IMAGE_COLS=$IMAGE_BOX_COLS
    elif [[ -n "$IMAGE_FAIL_URL" && "$url" == "$IMAGE_FAIL_URL" ]]; then
        # Tried once, and the answer was no — a dead url, an undecodable byte stream, a
        # timeout. Leaving IMAGE_DIRTY clear is what stops that row arming the clock once a
        # second forever. Moving off the row and back is what retries it.
        IMAGE_DIRTY=0
    else
        IMAGE_DIRTY=1
    fi
    return 0
}

# Delete OUR placement, and only ours. `d=i` is not optional decoration: the `d` key defaults
# to `a`, which means every placement visible on the screen — inside tmux or a terminal with
# another program drawing, that is someone else's picture. Nothing else erases these: a kitty
# image is not in the character grid, so \033[K and \033[J go straight past it, which is why
# this has to be called from the redraw, from the resize and from the exit trap alike.
image_clear() {
    IMAGE_PLACED=""
    ((IMAGE_DRAWN)) || return 0
    printf '\033_Ga=d,d=i,i=%s\033\\' "$IMAGE_ID"
    IMAGE_DRAWN=0
    return 0
}

# Emit the cached PNG at the cursor's current row, right-flushed inside the gutter.
# `C=1` is load-bearing twice over: without it a=T advances the cursor past the placement,
# which at the bottom of a frame SCROLLS the screen and costs the header — the exact failure
# the reflow exists to prevent, arriving from underneath — and it also means this function
# does not have to put the cursor back, so the caller keeps writing where it was.
# `q=2` is load-bearing once: it tells the terminal to answer nothing at all, and an answer
# would arrive in read_nav_input as the user having pressed several keys.
# EVERY WRITE HERE IS ALLOWED TO FAIL, and that is the one thing this function must get
# right. A cover is ~39KB of base64 in 13 chunks — by a wide margin the largest write this
# program makes, and the only one long enough to be sitting in write(2) when a signal
# arrives. Two arrive routinely: SIGCHLD when the background transcode finishes, and
# SIGWINCH on every column of a drag-resize. The write then returns EINTR, `printf` reports
# a non-zero status, and under `set -e` the TUI DIES — which is exactly what it did, as
#   ting: line …: printf: write error: Interrupted system call
# caught in tests/contract.sh's tmux block, one frame after a resize.
#
# So a failed write is not an error, it is "no cover on this frame": the partial upload is
# deleted rather than left half-drawn, IMAGE_DRAWN stays 0, and the very next frame — one
# keypress or one tick away — emits it again from the same cached file. Nothing is retried
# here, because the redraw IS the retry.
image_emit() {
    local right_col=$1 first=1 line col ok=1
    [[ -n "$IMAGE_PNG" ]] || return 0
    col=$((right_col - IMAGE_COLS + 1))
    ((col < 1)) && col=1
    printf '\033[%dG' "$col" || ok=0
    local prev=""
    while IFS= read -r line || [[ -n "$line" ]]; do
        ((ok)) || break
        if [[ -n "$prev" ]]; then
            if ((first)); then
                printf '\033_Ga=T,f=100,i=%s,r=%s,q=2,C=1,m=1;%s\033\\' "$IMAGE_ID" "$IMAGE_BOX_ROWS" "$prev" || ok=0
                first=0
            else
                printf '\033_Gm=1;%s\033\\' "$prev" || ok=0
            fi
        fi
        prev="$line"
    done < <(base64 < "$IMAGE_PNG" 2>/dev/null | fold -w 4096)
    if [[ -z "$prev" ]]; then
        # base64 produced nothing: a truncated or unreadable cache file. Nothing was sent.
        printf '\033[1G' || true
        return 0
    fi
    if ((ok)); then
        if ((first)); then
            printf '\033_Ga=T,f=100,i=%s,r=%s,q=2,C=1,m=0;%s\033\\' "$IMAGE_ID" "$IMAGE_BOX_ROWS" "$prev" || ok=0
        else
            printf '\033_Gm=0;%s\033\\' "$prev" || ok=0
        fi
    fi
    printf '\033[1G' || true
    if ((ok)); then
        IMAGE_DRAWN=1
    else
        # A half-sent image is not an image. Take the id back so the terminal is not holding
        # a truncated upload, and leave IMAGE_DRAWN clear so the next frame starts over.
        printf '\033_Ga=d,d=I,i=%s\033\\' "$IMAGE_ID" || true
        IMAGE_DRAWN=0
    fi
    return 0
}

# THE FRAME'S ENTRY POINT, and the reason it exists is that a redraw is not a change.
# image_emit used to be called unconditionally, straight after image_clear, on every frame —
# and a frame is drawn once a second for as long as a track plays, because the rail is live.
# So a cover nobody had moved was DELETED and re-sent, 39KB of base64 at a time, once a
# second; the gap between the delete and the re-arrival of the placement is the flicker.
# Measured 2026-09-03 at 100x30, six idle seconds with the cursor untouched: six deletes,
# six transmissions, 1.16MB written at the pane for a picture that never changed.
#
# The cover is still PLACED by the cursor — that is image_emit's whole design, and nothing
# here knows the block's absolute row in order to draw it. The row is computed only to
# decide whether the picture already on the screen is still in the right place, and the
# frame prints exactly three things above this block: the chrome (chrome_h lines, counted
# by the same accounting the reflow budget rests on), one line per visible row (vis of
# them), and the spacer. A placement is not in the character grid, so a repaint that draws
# the same layout leaves it exactly where it was — which is what makes doing nothing the
# correct redraw. Anything that could move it moves one of those three numbers, or the
# right flush, or the file itself; all five are in the signature, so a stale picture cannot
# survive a change and an unchanged one is never sent twice.
image_place() {
    local right_col=$1 row=$2 sig
    sig="$IMAGE_PNG|$right_col|$row"
    ((IMAGE_DRAWN)) && [[ "$sig" == "$IMAGE_PLACED" ]] && return 0
    image_clear
    image_emit "$right_col"
    # Only a whole picture is on the screen. A write interrupted mid-upload leaves
    # IMAGE_DRAWN clear, and recording the signature anyway would tell the next frame that
    # the thing it just failed to draw is already there.
    ((IMAGE_DRAWN)) && IMAGE_PLACED="$sig"
    return 0
}

# Display transient loading status in the thumbnail area while the cover is being
# fetched and transcoded. Rendered at the vertical center of the 24x7 box.
image_status() {
    local right_edge=$1 text tw col up
    text="${GL_SPIN[IMAGE_TICK % ${#GL_SPIN[@]}]} $S_PIC_LOADING"
    disp_w "$text"
    tw=$DISP_W
    col=$((right_edge - IMAGE_BOX_COLS + 1 + (IMAGE_BOX_COLS - tw) / 2))
    ((col < 1)) && col=1
    up=$((IMAGE_BOX_ROWS - IMAGE_BOX_ROWS / 2))
    printf '\033[%dA\033[%dG%s%s%s\033[%dB\033[1G' "$up" "$col" "$C_DIM" "$text" "$C_RESET" "$up" || true
}
detect_bg() {
    local fgbg b resp="" rgb rr gg bb
    case "$BG_MODE" in
    light) BG=light; return ;;
    dark) BG=dark; return ;;
    auto) ;;
    *) die "TING_BG must be one of: auto, light, dark (got '$BG_MODE')" ;;
    esac
    # $COLORFGBG is "fg;bg" (rxvt family): bg == 15 (white) → light. Non-numeric → no signal.
    fgbg="${COLORFGBG:-}"
    if [[ "$fgbg" == *";"* ]]; then
        b="${fgbg##*;}"
        if [[ "$b" =~ ^[0-9]+$ ]]; then
            if ((b == 15)); then BG=light; else BG=dark; fi
            return
        fi
    fi
    # OSC 11 background query (kitty/ghostty/wezterm/iTerm2/xterm-family answer; tmux and
    # dumb terminals don't — skip so auto costs no startup stall there). bash 3.2's read -t
    # takes only WHOLE seconds, so one unanswered probe costs 1 s once at startup.
    if [[ -z "${TMUX:-}" && "${TERM:-}" != dumb ]]; then
        printf '\033]11;?\033\\'
        # Assemble the reply byte-by-byte (3.2 has no read -d) until BEL or ST ends it.
        while IFS= read -rsn1 -t 1 b; do
            resp+="$b"
            case "$resp" in
            *$'\a'*) break ;;
            *$'\033\\'*) break ;;
            esac
            if ((${#resp} > 64)); then break; fi
        done
        # kitty answers "rgb:1c1c/1c1c/1c1c" (16-bit); xterm "rgb:1c/1c/1c" (8-bit).
        rgb="${resp#*rgb:}"; rgb="${rgb%%[$'\a'$'\033'\\]*}"
        if [[ "$rgb" == *"/"* ]]; then
            rr=""; gg=""; bb=""
            IFS='/' read -r rr gg bb <<<"$rgb" || true
            if [[ "$rr" =~ ^[0-9a-fA-F]{2,4}$ && "$gg" =~ ^[0-9a-fA-F]{2,4}$ && "$bb" =~ ^[0-9a-fA-F]{2,4}$ ]]; then
                local r8=$((16#$rr)) g8=$((16#$gg)) b8=$((16#$bb))
                if (( ${#rr} == 4 )); then r8=$((r8 / 257)); fi
                if (( ${#gg} == 4 )); then g8=$((g8 / 257)); fi
                if (( ${#bb} == 4 )); then b8=$((b8 / 257)); fi
                if ((r8 + g8 + b8 > 384)); then BG=light; else BG=dark; fi  # mid-gray boundary
                # Keep the colour, not just the verdict. It costs nothing — the query has
                # already been paid for — and it is the difference between a row ground mixed
                # against a GUESS at the background and one mixed against the background
                # (row_hl_from_accent).
                BG_R=$r8; BG_G=$g8; BG_B=$b8
            fi
        fi
    fi
}
init_theme() {
    detect_bg
    init_sync
    init_colorterm
    init_colors
    init_image
}
init_theme

