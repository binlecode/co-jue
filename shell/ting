# Toggle the chrome language in place (key: l). The card redraws on its 1s tick; the list
# view redraws when the menu loop comes back around. The header wordmark is a language
# string too (set_brand), but it cannot live in the table above — it needs ASCII_GLYPHS,
# which does not exist yet when set_ui_lang first runs — so it is re-resolved here.
cycle_ui_lang() {
    if [[ "$UI_LANG" == "zh" ]]; then set_ui_lang en; else set_ui_lang zh; fi
    set_brand
    mark_pref TING_LANG
}

# Which tier the key-hint blocks print. A function rather than a second variable mirroring
# KEYS_TIER: the tier is ONE fact, and every block wants it as a status, not as a string to
# compare. Called once per conditional cell, so it must stay fork-free — it is.
keys_full()   { [[ "$KEYS_TIER" == "full" ]]; }
keys_hidden() { [[ "$KEYS_TIER" == "hidden" ]]; }

# Rotate the key-hint tier in place (key: ?). Three tiers: `core` is one line of
# this view's own job — move, act on the row, get back out, quit; `full` adds the
# engine / store / tuning / playback family; `hidden` completely suppresses the
# hint block and hands its rows back to the height budget — which scroll mode fills and
# page mode uses only up to TING_PAGE_ROWS (ARCH-tui.md, the key-tier section).
cycle_keys() {
    case "$KEYS_TIER" in
    core) KEYS_TIER="full" ;;
    full) KEYS_TIER="hidden" ;;
    hidden|*) KEYS_TIER="core" ;;
    esac
    mark_pref TING_KEYS
}

# Row numbers on / off (key: #). A pure display toggle — it changes what a row PRINTS and
# nothing about what a key DOES, which is why the digit jumps do not consult it. The reflow
# picks the new prefix width up on the next redraw for free: pfx_w is derived, not stored.
cycle_row_index() {
    if ((ROW_INDEX)); then ROW_INDEX=0; else ROW_INDEX=1; fi
    mark_pref TING_ROW_INDEX
}

# scroll <-> page (key: Tab). The CURSOR is the anchor across the switch, not the page number
# and not the window top: the user is looking at a row, and that row must still be on screen
# afterwards. Both derivations follow from it — page mode takes the page the cursor falls in,
# scroll mode lets the renderer pull VIEW_TOP to wherever the cursor is. So neither direction
# needs to remember anything: the renderer recomputes the window from the selection on the
# very next frame, which is the same anchor a resize already repages on.
cycle_list_mode() {
    if [[ "$LIST_MODE" == "scroll" ]]; then LIST_MODE="page"; else LIST_MODE="scroll"; fi
    mark_pref TING_LIST_MODE
}

# Cycle the palette family in place (key: t). set_theme is a pure function of
# (THEME, BG, COLORTERM_TC), so a live re-resolve is safe — the same function startup
# used. Gated on COLORS_ON so --color never / NO_COLOR / non-TTY sessions cannot paint
# the chrome mid-session. Order: minimal → catppuccin → tokyonight → nord → gruvbox →
# onedark → mono → back.
# THEME_CYCLE is built in the settings block up top, with the other two cycles.
cycle_theme() {
    ((COLORS_ON)) || return 0
    local i n=${#THEME_CYCLE[@]} cur=0
    for (( i = 0; i < n; i++ )); do
        [[ "${THEME_CYCLE[$i]}" == "$THEME" ]] && { cur=$i; break; }
    done
    THEME="${THEME_CYCLE[$(( (cur + 1) % n ))]}"
    set_theme
    mark_pref TING_THEME
}

init_ui_strings() {
    case "${TING_LANG:-}" in
    en | zh) set_ui_lang "$TING_LANG" ;;
    "")
        case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
        zh* | *_zh*) set_ui_lang zh ;;
        *) set_ui_lang en ;;
        esac
        ;;
    *) die "TING_LANG must be en or zh (got '$TING_LANG')" ;;
    esac
}
init_ui_strings

# ── Glyphs (init_glyphs): Unicode by default; ASCII fallbacks ───────────────────────────
GL_NOTE="♫ "; GL_LIVE="● LIVE"; GL_SEP="·"; GL_CARET="❯"; ASCII_GLYPHS=0
# Everything else the chrome draws. These used to be hardcoded, so TING_ASCII=1 still left
# ▶ / ❚❚ / ● and the arrow hints as tofu on a font that can't draw them.
GL_PLAY="▶"; GL_PAUSE="❚❚"; GL_AV="↑↓"; GL_AH="←→"; GL_ENTER="⏎"; GL_TAB="⇥"
# The key names in the hint block, and the rule that picks their spelling: A KEY IS DRAWN
# AS THE SYMBOL ITS OWN KEYCAP CARRIES, and spelled as a word when the keycap carries none.
# ⏎ (U+23CE) and ⇥ (U+21E5) are printed on the physical keys; the space bar is blank, so
# `Space` stays a word — ␣ (U+2423) is a glyph no keyboard shows, i.e. a rebus in a block
# whose whole job is to say which key to press. The arrows lost their slash rather than
# their shape: ↑↓ is the pair of keys, and the `/` was an "or" spent on the one item where
# the two glyphs already read as a pair (it still separates -/= , where the two keys have
# no shape in common).
#
# BOTH NEW GLYPHS ARE EAW NEUTRAL, so they go in CW_NARROW pinned to one cell and cannot
# double under TING_AMBIG_WIDE=1 — unlike the arrows, which are Ambiguous and already ride
# CW_AMBIG. Measured at one cell in tmux (`display-message -p '#{cursor_x}'`), the method
# the width layer's table records. ↵ (U+21B5) went out of CW_NARROW with this change:
# nothing draws it now, and a width table is a claim about what this UI draws.
# The CURSOR's marker. It was ▶ — the same glyph as GL_PLAY — and the name was split off
# first precisely so this could change without touching the player's: they are two different
# facts ("you are pointing here" versus "the player is playing this") and a row can carry
# both at once. With one glyph doing both, the overlap row said the same shape twice and the
# reader had to consult the ground to tell which triangle meant what.
#
# A BAR, not an arrow, and the difference is what the mark points AT. A triangle is a
# pointer: it aims at the first cell of the title, which makes it a decoration on that cell.
# The cursor is not selecting a cell, it is selecting a ROW — so the mark that says so is a
# vertical stroke standing beside the whole line, in the accent, the way a margin rule marks
# a paragraph. It is also quieter: ▶ is a filled triangle competing with the playing row's
# own ▶ two lines away, and ▎ has no second reading anywhere on the screen.
#
# U+258E is East-Asian AMBIGUOUS, so it goes in CW_AMBIG with the rest of the chrome and is
# worth CW_AMBIG_W cells — NOT in CW_NARROW pinned to one. The block-elements row is split by
# EAW exactly where the box-drawing row is (U+2580..U+2595 Ambiguous, U+2596..U+259F Neutral,
# which is why the spinner's quadrants sit in CW_NARROW and this does not). Pinned to one it
# would measure 1 and draw 2 under TING_AMBIG_WIDE=1 — the `╸` trap, in the one slot whose
# width every title on the screen is laid out against.
GL_CURSOR="▎"
# The scrollbar: thumb and track. BOTH are East-Asian Ambiguous (U+2588, U+2502) — so the
# gutter is CW_AMBIG_W cells wide, not one, and the width it takes off the rows has to be
# read from that variable rather than written as 2.
GL_BAR_THUMB="█"; GL_BAR_TRACK="│"
GL_ELL="…"; GL_ARROW="→"; GL_DASH="—"
# The duration bounds' comparators. Both are East-Asian Ambiguous and already behave like
# the rest of the chrome under TING_AMBIG_WIDE; they are named rather than inlined for the
# reason every other glyph here is — TING_ASCII=1 has to be able to reach them.
GL_GE="≥"; GL_LE="≤"
# The position readout's brackets. Lenticular rather than ASCII square brackets because this
# badge sits directly against a title that is usually CJK, and a Wide bracket is the pair that
# does not read as punctuation belonging to the title. They are East-Asian WIDE (U+3010/U+3011),
# not Ambiguous — two cells in every terminal, under TING_AMBIG_WIDE or not — so they need no
# CW table entry: char_w's default of 2 is already exact for them.
GL_TIME_L="【"; GL_TIME_R="】"
# The resource readout's two labels (TING_RESOURCE): geometric squares from the same family as
# the rails' stroke language — ▣ an abstract chip, ▤ a filled "storage cell". Both are
# East-Asian Ambiguous, so they are tabled in CW_AMBIG below, not hardcoded as one cell.
GL_CPU="▣"; GL_RAM="▤"
# Spinner frames: ONE quadrant block orbiting the corners of a cell — a rotating box drawn by
# a single glyph, so it animates without ever widening the line. Quadrants are the minimal
# choice on purpose: they are drawn from the same box-drawing block the rails use, they are
# unambiguously one cell wide, and they carry no color of their own.
GL_SPIN=("▘" "▝" "▗" "▖")
init_glyphs() {
    # One switch for the whole suite: TING_ASCII (the engines read the same one — a font that
    # can't draw ♫ can't draw it anywhere).
    case "${TING_ASCII:-}" in
    1 | true | yes | on) ASCII_GLYPHS=1 ;;
    *)
        case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
        *UTF-8* | *utf-8* | *UTF8* | *utf8*) ASCII_GLYPHS=0 ;;
        *) ASCII_GLYPHS=1 ;;   # empty / non-UTF-8 locale → assume a limited terminal
        esac
        ;;
    esac
    if ((ASCII_GLYPHS)); then
        GL_NOTE=""; GL_LIVE="LIVE"; GL_SEP="|"; GL_CARET=">"
        GL_PLAY=">"; GL_PAUSE="||"; GL_AV="Up/Dn"; GL_AH="Lt/Rt"; GL_ENTER="Enter"
        GL_TAB="Tab"
        GL_CURSOR=">"
        GL_BAR_THUMB="#"; GL_BAR_TRACK="|"
        GL_ELL="..."; GL_ARROW="->"; GL_DASH="-"
        GL_GE=">="; GL_LE="<="
        GL_TIME_L="["; GL_TIME_R="]"
        GL_CPU="cpu"; GL_RAM="ram"
        GL_SPIN=("|" "/" "-" "\\")
    fi
    # The header icon is a two-cell SLOT: ♫ U+266B is one cell (tabled in CW_NARROW), so it
    # carries a pad, and the wordmark starts at the same column in every frame.
    ((ASCII_GLYPHS)) || GL_NOTE="♫ "
    set_brand
}

# The header wordmark, and the ONE piece of chrome that is a glyph AND a language string —
# which is why it is neither in the glyph table above nor in set_ui_lang's: it needs
# ASCII_GLYPHS (set by init_glyphs) and UI_LANG (set by init_ui_strings, which runs first),
# so it is resolved here, from both, and re-resolved by cycle_ui_lang when `l` flips the
# language under a running frame.
#
# Under zh the wordmark is the project's Chinese name, 听 — the chrome around it is already
# Chinese, so a Latin "ting" in the one bold cyan slot read as the odd word out.
#
# It is drawn as a SEAL, 【 听 】, and the brackets are load-bearing rather than decoration:
# a lone 听 is two cells of Chinese sitting in a row of Latin keys and reads as a stray
# character, while the square brackets say "this is a mark, not a word". Their width is the
# other half of the argument — 2 + 1 + 2 + 1 + 2 is a CONSTANT 8 cells, in every state, so
# disp_w measures the same header width whether or not anything is playing and the query
# elision below never shifts by a cell. ASCII mode narrows the brackets to `[ 听 ]` (6),
# which is a different constant, not a variable one.
#
# The seal is also the suite's only piece of chrome that reports a STATE. While a player is
# actually playing — not paused, not still loading — the inner 听 is drawn in reverse video
# and the brackets stay as they were, so the mark lights up from the inside like an
# indicator lamp. It is deliberately not a second fact: the condition is CURRENT_PLAY_ID
# plus the same two flags the Now-Playing banner already reads, and the reverse-video run
# is closed before the closing bracket so the ESCAPES never reach disp_w (it measures
# GL_BRAND, which has none).
#
# ASCII mode does NOT force the Latin name: TING_ASCII covers the glyph table, never the
# language — set_ui_lang's labels stay Chinese under it, and so does this.
set_brand() {
    if [[ "$UI_LANG" == "zh" ]]; then
        if ((ASCII_GLYPHS)); then
            GL_BRAND="[ 听 ]"
        else
            GL_BRAND="【 听 】"
        fi
    else
        GL_BRAND="ting"
    fi
}
init_glyphs

# Field separator inside the row records that build_all_rows emits and load_rows /
# apply_filter split: ASCII US (0x1f), deliberately NOT tab. See build_all_rows.
US=$'\x1f'

# The one title cleaner, and the only copy of it. TWO ingest points reach a title — the row
# builders below (a search or an item envelope) and apply_player_record (a live player
# record) — and the list puts both spellings of the SAME subject on one screen, the banner
# over the row, so a title that changed writing as the selection moved onto the playing row
# would read as two different tracks. Prepended to every jq program that takes a title by adjacent quoting:
# the program itself stays single-quoted, so nothing inside it is exposed to the shell.
# `clean` strips the emoji/dingbat blocks a title carries as decoration; `oneline` only
# folds whitespace, for a field (a channel) where a symbol is part of the name.
JQ_TEXT_DEFS='
  def clean:
    gsub("[\\x{1F000}-\\x{1FAFF}\\x{2190}-\\x{21FF}\\x{2300}-\\x{27BF}\\x{2B00}-\\x{2BFF}\\x{FE00}-\\x{FE0F}\\x{200D}\\x{2122}\\x{2139}]"; "")
    | gsub("\\s+"; " ") | gsub("^ | $"; "");
  def oneline: gsub("\\s+"; " ") | gsub("^ | $"; "");
  def yt_thumb:
    if . == null then ""
    elif test("v=[a-zA-Z0-9_-]{11}") then "https://i.ytimg.com/vi/" + (capture("v=(?<id>[a-zA-Z0-9_-]{11})").id) + "/hqdefault.jpg"
    elif test("youtu\\.be/[a-zA-Z0-9_-]{11}") then "https://i.ytimg.com/vi/" + (capture("youtu\\.be/(?<id>[a-zA-Z0-9_-]{11})").id) + "/hqdefault.jpg"
    else "" end;
  # Seconds -> the wire spelling short_dur parses (`0h:03m:35s`), for the ONE source whose
  # items arrive as bare numbers: a queue. Both stores derive `duration_fmt` on read
  # (t-playlist and t-history each carry this same definition), but t-play has no engine
  # prelude and its queue has only ever published raw seconds. Rather than teach the player
  # a formatting vocabulary it has no other use for, the seconds are spelled here — one
  # place, in the pass that builds the rows, so every row on this screen still reaches
  # short_dur the same way and the duration column lines up whatever the rows came from.
  def p2: if . < 10 then "0\(.)" else "\(.)" end;
  def fmt_dur:
    if type != "number" then ""
    else (. | floor) as $t
      | ($t / 86400 | floor) as $d
      | (($t % 86400) / 3600 | floor) as $h
      | (($t % 3600) / 60 | floor) as $m
      | ($t % 60) as $s
      | (if $d > 0 then "\($d)d " else "" end) + "\($h | p2)h:\($m | p2)m:\($s | p2)s"
    end;
'

# ── Playback State Model ────────────────────────────────────────────────────────────────
CURRENT_PLAY_ID=""
CURRENT_PLAY_PID=""
CURRENT_PLAY_TITLE=""
CURRENT_PLAY_DURATION=""
# The same length in the ENGINE'S WIRE SPELLING (`0h:03m:30s`). CURRENT_PLAY_DURATION beside
# it is already display form, and the other consumer of a length on this screen is a ROW,
# whose duration field is the wire spelling short_dur parses. Two readers, two shapes, one
# fact — kept rather than converted back, because only one of the two sources this is filled
# from has a number to convert.
CURRENT_PLAY_DUR_WIRE=""
CURRENT_PLAY_SOCK=""
CURRENT_PLAY_PAUSED=0
# What the PLAYER is playing, as opposed to what this screen last launched. A detached player
# consumes a QUEUE (t-play: every detached player has one, a lone handle being a queue of
# one), so the track can change with no keypress here at all — and then every cached field
# above describes something that stopped playing. CURRENT_PLAY_MPV_TITLE is the cheap
# tripwire: media-title rides along in the round trip fetch_play_times already makes, so a
# track change costs nothing to NOTICE, and only then is one `t-play --status` spent to
# re-read the record. Polling --status every tick would be a process chain per second, which
# is the cost the read path exists to avoid (ARCHITECTURE.md「已知约束」).
CURRENT_PLAY_MPV_TITLE=""
# Where the running player is in its queue. Two numbers, not the tail: the tail had one
# reader and it was the card's queue-ahead block (D-g). These two stay because they are the
# only thing on screen that answers `+` — the status line prints them the moment there is a
# queue to report.
CURRENT_QUEUE_POS=0
CURRENT_QUEUE_LEN=0
# The CALL that is playing — `t-play --engine E -- URL`, the same pair a stored row holds.
# Seeded by the launch and then re-read from the record, because a queue moves to a track this
# screen never launched, and it may move to another SOURCE: only the record knows which engine
# resolved what is playing now. It is also what Enter on a chapter row compares against
# (play_chapter).
CURRENT_PLAY_URL=""
CURRENT_PLAY_ENGINE=""
# Third state, between "launched" and "playing": the -d envelope comes back as soon as the player
# has forked, but the detached child still has to ask the engine to resolve the stream and let
# mpv fill its cache, and that window is seconds long on a cold URL. (The extraction moved into
# the child when the player started resolving (ARCHITECTURE.md「调用栈」); the window it opens is the
# same one, so this state still earns its keep.) The banner used to claim "Playing" for all of it.
CURRENT_PLAY_LOADING=0
# A live stream has no meaningful position: mpv reports time-pos on the whole
# broadcast-so-far timeline with duration = the live edge, so percent-pos sits at
# ~99.98% from the first second and the progress bar is pinned full. Track liveness
# (from the row's own live_status, which build_all_rows already renders as GL_LIVE) and
# show elapsed listening time instead of a fake position. Measured on a 24/7 radio:
# time-pos=77390 duration=77403 percent-pos=99.98.
CURRENT_PLAY_IS_LIVE=0
CURRENT_PLAY_STARTED=0     # epoch seconds when WE attached, for the elapsed readout
# Did this session START the player, or find one already running and adopt it
# (probe_active_player)? ONE path asks: the exit trap. Every other path — s, Enter, the
# liveness poll, every verb — treats an adopted player exactly like a launched one, because
# it is one: same id, same socket, same verbs.
CURRENT_PLAY_ADOPTED=0
QUIT_KEEP_PLAYING=0

# ── The item one `t-play --info` describes (key: i) ─────────────────────────────────────
# `i` is the DOOR, and the fetch behind it is what keeps this from being a second spelling of
# the row: title, channel, duration, views, id, mode and quality are all on the list screen
# already. What the round trip buys is what the list cannot hold — the upload date and the
# like count (the status line prints them) and the CHAPTER TABLE, which becomes the rows
# themselves (build_chapter_rows).
ITEM_ENGINE=""
ITEM_URL=""
ITEM_TITLE=""
ITEM_UPLOADED=""
ITEM_LIKES=""
ITEM_CHAP_N=0
# The chapter table, three parallel arrays because bash 3.2 has no associative one: the start
# second (arithmetic — it becomes the row's `t=` and the --seek-to target), the end second
# (empty when the engine did not publish one) and the title.
# Filled once per `--info`, and read once more by build_chapter_rows; there is no cursor into
# them, because the rows built from them carry the list's own `selected`.
ITEM_CHAP_SEC=()
ITEM_CHAP_END=()
ITEM_CHAP_TITLE=()
# One slot, not a map: bash 3.2 has no associative arrays, and parallel arrays are a cache's
# complexity without a cache's behaviour — the rhythm this exists for is going back into the
# item you just looked at. Keyed `engine:url`, session-only, never written to disk.
INFO_CACHE_KEY=""
INFO_CACHE_JSON=""

# Cursor helpers
# Terminal size. NOT `$(tput cols)`: inside command substitution ncurses can miss the
# window-size ioctl and silently answer with terminfo's default 80x24 — measured here, a
# 60-column tmux pane reported 80, so the card drew 80-wide rails and every line (rails,
# wrapped title, progress bar) wrapped. `stty size` reads the real ioctl through /dev/tty,
# which this UI is guaranteed to have (it refuses to start without a TTY on stdin+stdout).
# tput stays as the fallback, then a hard default.
term_size() {
    local sz
    sz=$(stty size </dev/tty 2>/dev/null || true)
    TERM_LINES=${sz%% *}
    TERM_COLS=${sz##* }
    [[ "$TERM_COLS" =~ ^[0-9]+$ ]] || TERM_COLS=$(tput cols 2>/dev/null || echo 80)
    [[ "$TERM_LINES" =~ ^[0-9]+$ ]] || TERM_LINES=$(tput lines 2>/dev/null || echo 24)
}

cursor_hide() { tput civis 2>/dev/null || true; }
cursor_show() { tput cnorm 2>/dev/null || true; }

# The terminal driver's own echo is pure interference here: this UI draws every character the
# user types itself (read_query_input echoes as it assembles, the filter redraws the whole
# frame), and bash's `read -s` turns the driver's echo off only for the duration of ONE read.
# Restoring it between reads makes the driver echo whatever is still QUEUED, which a burst
# always leaves behind — measured, pasting 咖啡 (six bytes at once) at the new-search prompt:
# the terminal received the last character twice, ours plus the driver's. Pre-batch-E, byte at
# a time, the same burst sprayed U+FFFD replacement characters across the line; the reason it
# was never filed is that every multi-byte key was mojibake anyway, so there was nothing legible
# for the duplicate to spoil. Own it for the whole session and restore it exactly the way the
# cursor is restored — on every exit path, through the same trap.
#
# ECHO off is not enough on its own: it has to come WITH canonical mode off. `-echo` while
# ICANON is still SET is the exact termios signature of getpass(), and terminals poll the pty
# for it — Ghostty on that heuristic flips macOS Secure Input on (`macos-auto-secure-input`)
# and draws its indication, iTerm2 draws a padlock at the cursor. Nothing was echoing a
# password, but the fetch spinner parks the cursor on its own glyph (`printf '%s\b'`), so the
# padlock landed ON the spinner for the whole length of a search. bash's `read -rsn1` clears
# ICANON only for the duration of ONE read, which left every gap between keystrokes — and the
# entire fetch, where no read is running at all — advertising a password prompt. A full-screen
# app is `-echo -icanon` (which is why vi is never flagged), and that is what this is; `min 1
# time 0` keeps a raw read blocking on one byte rather than spinning on zero.
#
# Restore is the state `stty -g` saw on the way in, verbatim, rather than a guess at what the
# shell handed us: two flags are now being changed, and re-asserting defaults would silently
# "fix" a tty the caller had deliberately set up otherwise.
#
# BRACKETED PASTE (DECSET 2004) is turned on from the same two functions, for the same
# reason and with the same pairing: it is terminal state this app changes for the length of
# a session and must hand back. Without it a paste is indistinguishable from someone typing
# very fast, and every character of it is a KEY — pasting `jazz #hop` into the list moved the
# cursor on `j`, opened the playlist-name prompt on `a`, and typed the rest into it. `#`, `s`
# and `d` are worse: they toggle row numbers, stop the player and delete a stored row. The
# terminal is the only party that knows where a paste begins and ends, and 2004 is how it
# says so — nothing this side of the tty can tell a paste from typing by timing without
# guessing. A terminal that does not implement it ignores the sequence and behaves exactly as
# before, so this costs nothing where it is not supported.
TTY_ECHO_OFF=0
TTY_SAVED=""
tty_echo_off() {
    [[ -n "$TTY_SAVED" ]] || TTY_SAVED=$(stty -g </dev/tty 2>/dev/null || true)
    stty -echo -icanon min 1 time 0 </dev/tty 2>/dev/null && TTY_ECHO_OFF=1
    ((TTY_ECHO_OFF)) && printf '\033[?2004h'
    return 0
}
tty_echo_restore() {
    ((TTY_ECHO_OFF)) || return 0
    printf '\033[?2004l'
    if [[ -n "$TTY_SAVED" ]]; then
        stty "$TTY_SAVED" </dev/tty 2>/dev/null || true
    else
        stty echo icanon </dev/tty 2>/dev/null || true
    fi
    TTY_ECHO_OFF=0
    return 0
}

# ── IPC & Playback Controls ─────────────────────────────────────────────────────────────
# Two rules for every reader below, and one number that is NOT what this file used to say.
#
# 1. Correlate on request_id, never on line order. mpv multiplexes ASYNC EVENTS to every
#    client, interleaved with replies, so a positional read can seat an event where a
#    property belongs (the core learned this in do_set_volume). This is what makes asking
#    for three properties on ONE connection safe, which is why fetch_play_times opens one
#    socket per tick instead of three.
# 2. Do not WAIT for nc. Each reader runs it inside a process substitution and breaks on
#    the last reply it wants; `seen` bounds the loop so a chatty player cannot hold the
#    redraw open. A HEALTHY mpv closes as soon as nc half-closes, so this buys ~10 ms per
#    tick (0.026s -> 0.017s for the three properties, measured on a live player). A WEDGED
#    one never closes, and there `nc -U -w1` charges the full second per call — that is the
#    case this shape actually rescues (3.12s -> 0.07s against a peer that never closes).
#
# The number: real mpv answers a round trip in ~0.016 s. A probe that never closes the
# connection reads as ~1 s instead — that is the probe's number, not mpv's, and sizing this
# path by it is how a redraw budget gets set sixty times too high.
send_mpv_ipc() {
    # $1 is the command ARRAY body ("[\"cycle\",\"pause\"]"), not a finished object: this
    # function appends the request_id it then waits for, and the call sites lose a layer of
    # hand-escaped quotes.
    local body="$1" rid seen=0
    # return 0, not 1, on a missing socket: fire-and-forget is this function's contract (the
    # nc failure below is already swallowed), and it is the LAST command of adjust_volume —
    # a 1 here becomes the function's status, reaches the case arm, and set -e kills the TUI
    # on a keypress whose effect is optional anyway. (Pause and seek left for t-play's
    # verbs; the volume keys stayed for the cost measured at play_verb.)
    [[ -n "$CURRENT_PLAY_SOCK" && -S "$CURRENT_PLAY_SOCK" ]] || return 0
    # Fire-and-forget still, but now with delivery confirmation it never had: the reply is
    # read only to know it arrived, and a player that answers nothing costs the loop nothing.
    while IFS= read -r rid; do
        seen=$((seen + 1))
        [[ "$rid" == "1" ]] && break
        ((seen >= 12)) && break
    done < <(printf '{"command":%s,"request_id":1}\n' "$body" |
        "${NC_UNIX[@]}" "$CURRENT_PLAY_SOCK" 2>/dev/null |
        jq -r --unbuffered 'select(.request_id != null) | .request_id' 2>/dev/null)
    return 0
}

# The read side of the same socket: one property, on stdout, empty on any failure (a JSON
# null included, as the old `.data // empty` did). Callers that want several properties ask
# for them on ONE connection instead of calling this three times — see fetch_play_times.
mpv_get_prop() {
    local rid val out="" seen=0
    [[ -n "$CURRENT_PLAY_SOCK" && -S "$CURRENT_PLAY_SOCK" ]] || return 0
    while IFS="$US" read -r rid val; do
        seen=$((seen + 1))
        [[ "$rid" == "1" ]] && { out="$val"; break; }
        ((seen >= 12)) && break
    done < <(printf '{"command":["get_property","%s"],"request_id":1}\n' "$1" |
        "${NC_UNIX[@]}" "$CURRENT_PLAY_SOCK" 2>/dev/null |
        jq -r --unbuffered 'select(.request_id != null)
                            | "\(.request_id)\u001f\(.data)"' 2>/dev/null)
    [[ "$out" == "null" ]] && out=""
    printf '%s\n' "$out"
    return 0
}

fmt_sec() {
    local s=${1%.*}
    [[ "$s" =~ ^[0-9]+$ ]] || { echo "--:--"; return; }
    local h=$((s / 3600))
    local m=$(((s % 3600) / 60))
    local sec=$((s % 60))
    if ((h > 0)); then
        printf "%02d:%02d:%02d" "$h" "$m" "$sec"
    else
        printf "%02d:%02d" "$m" "$sec"
    fi
}

# The envelope's duration_fmt (`06h:10m:58s`, or `1d 00h:37m:03s` past a day) is a wire
# format, not a column: 11 cells of zero padding and unit letters for what reads as 6:10:58.
# Sets SHORT_DUR. Unparseable or empty -> "--:--"; a LIVE row is NOT detected here, because
# the row carries live_status as its own field and the caller reads that instead of
# inferring liveness from a missing duration.
# Pure bash by the same rule as the width layer: this runs once per row per redraw, so a
# sed/awk here would be one fork per row per keystroke in filter mode.
SHORT_DUR=""
short_dur() {
    local s=$1 d h m sec
    if [[ "$s" =~ ^(([0-9]+)d[[:space:]]+)?([0-9]+)h:([0-9]+)m:([0-9]+)s$ ]]; then
        d=${BASH_REMATCH[2]:-0}
        # 10# on every field: "06" and "08" are octal to $(( )), and "08" is not even valid
        # octal — an 8-minute video would have aborted the redraw.
        h=$((10#${BASH_REMATCH[3]} + 24 * 10#$d))
        m=$((10#${BASH_REMATCH[4]}))
        sec=$((10#${BASH_REMATCH[5]}))
        if ((h > 0)); then
            printf -v SHORT_DUR '%d:%02d:%02d' "$h" "$m" "$sec"
        else
            printf -v SHORT_DUR '%d:%02d' "$m" "$sec"
        fi
        return 0
    fi
    SHORT_DUR="--:--"
}

# Seconds -> the SAME display form short_dur produces (`2:30`, `1:02:19`), for the one caller
# that has a number rather than the engine's wire spelling: the chapter rail, which is built
# from two integers and must line up with every other time on the screen. Pure bash for the
# reason short_dur is — a fork per chapter per open is a fork this view does not need.
DISP_CLOCK=""
disp_clock() {
    local t=$1 h m sec
    h=$((t / 3600)); m=$(((t % 3600) / 60)); sec=$((t % 60))
    if ((h > 0)); then
        printf -v DISP_CLOCK '%d:%02d:%02d' "$h" "$m" "$sec"
    else
        printf -v DISP_CLOCK '%d:%02d' "$m" "$sec"
    fi
}

# 27264629 -> 27,264,629. Sets COMMAS. Same no-fork rule as short_dur (`sed -e :a -e
# s/.../` per row per redraw was the alternative). Non-numeric input passes through.
COMMAS=""
commas() {
    local n=$1 out=""
    if [[ ! "$n" =~ ^[0-9]+$ ]]; then
        COMMAS="$n"
        return 0
    fi
    while ((${#n} > 3)); do
        out=",${n: -3}$out"
        n=${n:0:${#n} - 3}
    done
    COMMAS="$n$out"
}

# Repeat a single-cell glyph n times (n may be 0). NOT `printf 'x%.0s' $(seq 1 $n)`:
# printf always walks its format at least once, so with zero arguments that idiom emits
# one stray cell — which is what made the bar 46 cells wide at 0% and 47 at 100%.
# Returns through GLYPH_RUN, the same no-fork discipline as the width layer below: every
# caller sits on the once-a-second redraw path, where $(...) is a subshell per call.
GLYPH_RUN=""
repeat_glyph() {
    local glyph=$1 n=$2 out=""
    while ((n > 0)); do
        out+="$glyph"
        ((n--))
    done
    GLYPH_RUN="$out"
}

# The width the view lays out against: the real terminal width, floored at 24. Sets
# LAYOUT_COLS. Every renderer carried this clamp inline once. It took an optional cap while
# the player cards existed — they passed 80 so their rails did not stretch across an
# ultrawide window, the list passed nothing and used the full width for its rows — and the
# cap went with them: one view, one width, and an unused parameter is a promise the caller
# does not make.
#
# The FLOOR was 40, and its comment said "below that nothing fits, and clamping beats
# drawing garbage". Clamping WAS the garbage: laying out for 40 cells in a 30-cell pane
# wraps every chrome row and every result row, and each extra physical line pushes the
# header off the top — the one failure the reflow exists to prevent, arriving from a
# terminal the layout had simply decided not to believe in. Measured on a fresh list, the
# break was exact: 40 columns clean, 39 and below wrapped. A 30-column pane is one tmux
# split, not an exotic size.
#
# 24, not lower, and the reason is a measurement gap rather than a taste: print_hints emits
# an item WIDER than the width unbroken (there is nowhere to break one), so a single long
# field wraps and its dry-run pass reports one line where the printer emits two — chrome
# the reflow then underspends. "mode=audio (audio-only)" is 23 cells, so 24 is the width at
# which the widest single field still fits. Below that the clamp is honest: it is the size
# at which one field of the status row cannot be drawn at all.
LAYOUT_MIN=24

# ── The rest of the layout budget, named ────────────────────────────────────────────────
# A literal earns a name here when the same fact appears at more than one site — prose tying
# them together does not go red when one of them moves — or when the number carries a
# measurement a reader cannot recover from the code. A `1` that only says "this block is one
# line" stays a `1` at its site: that is a row count, not a threshold, and naming it would
# buy a level of indirection and nothing else.

# A DROPPABLE field's floor: the cells it must still get, or the field goes entirely. Three
# sites spend it — the status row deciding whether it fits inline beside the query, and the
# banner's drop order twice (key tail, then footprint). The tie used to live in prose on the
# status row: "the same number the banner's own drop order uses".
LAYOUT_MIN_FIELD=12

# An UNDROPPABLE text budget's floor: what such a budget is clamped UP to, so a pane too
# narrow to hold everything beside the text elides the text rather than wrapping the row.
# Three sites spend it — two clamps on core titles (result row, playlist pick), and the
# banner's final drop rung for key tail. It is also what truncate_disp's
# contract leans on — no caller reaches its budget-cannot-hold-the-mark branch, because
# every caller clamps to at least this.
LAYOUT_MIN_BUDGET=8

# The cursor's resting row, charged by every budget that ends in rows: filling the last line
# and emitting its newline scrolls the screen up by one, which would cost the header again.
LAYOUT_CURSOR_ROW=1

# Rows that must survive BELOW the navigation block, or the block does not print: the blank
# line after the block, one result row, the blank line after the rows, and the cursor's
# resting row.
LAYOUT_NAV_KEEP=4

# Rows that must survive BELOW the details block, or the block does not print: one result
# row, and the pagination row the block would otherwise have eaten.
LAYOUT_DETAIL_KEEP=2
LAYOUT_COLS=0
layout_cols() {
    term_size
    LAYOUT_COLS=$TERM_COLS
    ((LAYOUT_COLS < LAYOUT_MIN)) && LAYOUT_COLS=$LAYOUT_MIN
    return 0
}


# ── Adaptive chrome layout ──────────────────────────────────────────────────────────────
# ── Cell width: ONE rule, in ONE place (char_w) ──────────────────────────────────────────
# The rule: a non-ASCII character counts as TWO cells — exact for CJK (East-Asian Wide) and
# conservative for everything else, which is the safety property. Over-counting packs a row
# a cell or two early and can never run off the edge; under-counting overflows. So the
# default stays two, and only characters MEASURED to be otherwise are tabled below.
#
# The chrome's own glyphs are one such table, and they are safe to table because the suite's
# glyph inventory is deliberately all text-presentation — "non-graphical". There is no emoji
# anywhere in the suite, so nothing that IS tabled can pick up a U+FE0F and silently become a
# 2-cell emoji behind the table's back. All 17 measured at ONE cell (tmux over Ghostty, `tmux display-message -p '#{cursor_x}'`):
#   Neutral EAW    ↵ ♫ ❚ ❯                      one cell in EVERY terminal
#   Ambiguous EAW  · — • … ← ↑ → ↓ ─ ━ ○ ● ▶    one cell unless a terminal is explicitly
#                                               configured ambiguous-wide
# The split is read off the UCD (unicodedata.east_asian_width), not guessed: ♫ U+266B is
# Neutral, so it stays one cell even under TING_AMBIG_WIDE.
# One cell is the DEFAULT everywhere in use here: Ghostty (grapheme-width-method = unicode),
# and Terminal.app / iTerm2 / tmux, where "treat ambiguous-width as double-width" is an
# opt-in that ships off. TING_AMBIG_WIDE=1 restores the conservative 2 for the Ambiguous row
# if that option is ON. It is an explicit knob and not a locale guess, because the locale
# says nothing: Ghostty under a zh_CN locale still renders these one cell.
# Note the bar already assumed this — render_prog_bar promises two runs of exactly <total>
# cells between them, built from ━ and ─, which only holds at one cell each.
# The table applies wherever these characters occur, titles included, not only to chrome.
#
# What IS corrected is the zero-width class, where "two cells" is wrong in every terminal.
# The base character is still counted as two, so each of these makes the whole sequence come
# out EXACT rather than merely conservative:
#   U+200D ZWJ, U+FE0E/U+FE0F VS15/VS16    joiner and presentation selectors  ☕️ = 2 (was 4)
#   U+1F3FB..U+1F3FF skin-tone modifiers                                      👍🏽 = 2 (was 4)
#   U+0300..U+036F, U+20D0..U+20F0, U+FE20..U+FE2F combining marks         e+◌́ = 1 (was 2)
# Regional indicators (U+1F1E6..U+1F1FF) count ONE each, so a flag pair is 2 (was 4).
# Combining marks outside those blocks (Arabic, Devanagari, Thai) are not in the table and
# stay over-counted — conservative, never short. A ZWJ emoji sequence still over-counts
# (👨‍👩‍👧 measures 6, drawn as 2); collapsing that needs a real grapheme-cluster walk, which is
# not worth its weight in bash 3.2.
#
# The tables are byte-built at startup instead of written as string literals: a source line
# full of invisible combining marks is unreadable and un-editable.
CW_ZWJ=$'\xe2\x80\x8d'
CW_ZERO=""      # characters that add no cells
CW_NARROW=""    # non-ASCII characters that still take only one, in any terminal
CW_AMBIG='·—•…←↑→↓─━○●▶▣▤≥≤█│▎' # East-Asian Ambiguous: one cell, or two under TING_AMBIG_WIDE
CW_AMBIG_W=1
CW_RANGE=""
cw_range() {
    local prefix=$1 lo=$2 hi=$3 pat ch
    CW_RANGE=""
    while ((lo <= hi)); do
        printf -v pat '%s\\x%02x' "$prefix" "$lo"
        printf -v ch "$pat"
        CW_RANGE+="$ch"
        ((lo++))
    done
}
init_cell_tables() {
    CW_ZERO="$CW_ZWJ"
    cw_range '\xef\xb8'     142 143; CW_ZERO+="$CW_RANGE"    # U+FE0E..U+FE0F  variation selectors
    cw_range '\xcc'         128 191; CW_ZERO+="$CW_RANGE"    # U+0300..U+033F  combining marks
    cw_range '\xcd'         128 175; CW_ZERO+="$CW_RANGE"    # U+0340..U+036F  combining marks
    cw_range '\xe2\x83'     144 176; CW_ZERO+="$CW_RANGE"    # U+20D0..U+20F0  marks for symbols
    cw_range '\xef\xb8'     160 175; CW_ZERO+="$CW_RANGE"    # U+FE20..U+FE2F  half marks
    cw_range '\xf0\x9f\x8f' 187 191; CW_ZERO+="$CW_RANGE"    # U+1F3FB..U+1F3FF skin tones
    cw_range '\xf0\x9f\x87' 166 191                          # U+1F1E6..U+1F1FF regional indicators
    # The four quadrant blocks are the spinner's frames (GL_SPIN) and are Neutral like the rest
    # of this row — U+2596..U+259F is the one Neutral island inside the Block Elements, which is
    # exactly why the spinner is drawn from quadrants and not from the ◐◓◑◒ circles or the
    # ▁▃▅▇ bars: those are Ambiguous, so a terminal could give the animation two cells and make
    # it jump. Nothing measures the spinner line today; tabling them anyway keeps "every glyph
    # this draws has a known width" true by construction rather than by where it happens to print.
    # The progress bar's `╸` playhead and the `╶` that compensated its white half used to be
    # tabled here too — a deliberate placement, because EastAsianWidth splits the box-drawing
    # block (the full-length horizontals are Ambiguous, the half-lines 2574..257F are
    # Neutral) and a head tabled Ambiguous would take two cells under TING_AMBIG_WIDE=1 and push
    # the bar one cell past the width it was measured at, which is a wrap the reflow does not
    # know about. The bar draws neither glyph now (render_prog_bar: the weight change IS the
    # playhead), so they are out — a width table is a claim about what this UI draws, and an
    # entry for a glyph nothing draws is a claim nobody can check.
    CW_NARROW="⏎⇥♫❚❯▘▝▗▖$CW_RANGE"                             # U+23CE U+21E5 U+266B U+275A U+276F
    case "${TING_AMBIG_WIDE:-}" in
    1 | true | yes | on) CW_AMBIG_W=2 ;;
    esac
}
init_cell_tables

# Cells taken by ONE character. Returns through CHAR_W: this is the innermost loop of every
# measurement, so no subshell, no command substitution. All five measuring sites (disp_w,
# disp_fits, truncate_disp, and both of wrap_print's loops) go through here — when the rule lived
# inline in each of them, a fix to one silently disagreed with the other three, and
# measurement disagreeing with line-breaking is worse than a uniform over-count.
CHAR_W=0
char_w() {
    local c=$1
    if [[ "$c" == [[:ascii:]] ]]; then CHAR_W=1; return; fi
    if [[ "$CW_ZERO" == *"$c"* ]]; then CHAR_W=0; return; fi
    if [[ "$CW_NARROW" == *"$c"* ]]; then CHAR_W=1; return; fi
    if [[ "$CW_AMBIG" == *"$c"* ]]; then CHAR_W=$CW_AMBIG_W; return; fi
    CHAR_W=2
}

# Display width of PLAIN text. Colours are applied at print time and never measured. Returns
# through a global (DISP_W) rather than stdout: this runs several times per redraw, and
# $(...) would mean a subshell fork per measurement. Pure-ASCII strings — most of the chrome
# — skip the per-character walk entirely, so this is FASTER than the inline test it replaced
# (300 measurements of a packed hint row: 94ms before, 5ms after).
# Accumulate with `n=$((n + CHAR_W))`, never `((n += CHAR_W))`: an arithmetic command whose
# result is 0 returns exit status 1, and a leading zero-width character would abort the whole
# script under `set -e`.
DISP_W=0
disp_w() {
    local s=$1 i n=0
    if [[ "$s" != *[![:ascii:]]* ]]; then
        DISP_W=${#s}
        return
    fi
    for ((i = 0; i < ${#s}; i++)); do
        char_w "${s:$i:1}"
        n=$((n + CHAR_W))
    done
    DISP_W=$n
}

# Does PLAIN text fit in <max> cells? Answers through DISP_FITS, without measuring past the
# point where the answer is settled. char_w's range is {0,1,2} — all non-negative, so the
# running total only ever grows, and the character that crosses <max> is the last one that
# can change the answer. Strictly equivalent to `disp_w "$s"; ((DISP_W <= max))`, but bounded
# by <max> instead of by the length of the text.
# That bound is the whole point where the text is long and the budget is not: the item card
# measures a ~3.6k-character description against a ~576-cell budget, and the handful of emoji
# a description uses as section markers knocks the entire string off disp_w's all-or-nothing
# ASCII fast path (54 non-ASCII characters, 3621 walked). Measured on 3.2.57 with that
# description: whole-string 0.479s, stop-at-budget 0.132s.
# Same no-fork, accumulate-with-$(( )) discipline as disp_w, and for the same reasons.
DISP_FITS=0
disp_fits() {
    local s=$1 max=$2 i n=0
    DISP_FITS=0
    if [[ "$s" != *[![:ascii:]]* ]]; then
        ((${#s} <= max)) && DISP_FITS=1
        # `return 0`, never a bare `return`: a bare one hands back the status of the LAST
        # COMMAND, which here is an arithmetic test that is false exactly when the text does
        # not fit — so every truncation aborted the whole TUI under set -e. It reached a
        # terminal 100 cells wide as "nothing ever truncates there"; contract.sh's 26x24
        # resize is what says it out loud. Same trap as the accumulate rule above, one step
        # further along: the status of a test is not the status of a function.
        return 0
    fi
    for ((i = 0; i < ${#s}; i++)); do
        char_w "${s:$i:1}"
        n=$((n + CHAR_W))
        ((n > max)) && return 0
    done
    DISP_FITS=1
    return 0
}

# Pull a cut point back out of the middle of a grapheme cluster. Severing a base character
# from its combining mark, joiner or flag partner does not merely mis-measure — it draws the
# WRONG GLYPH: half a flag renders as a lone letter tile, an orphaned VS16 or ZWJ attaches
# itself to the ellipsis instead. Given <text> and the index of the first character NOT being
# emitted, walk left until that index is a real cluster boundary. Sets CUT_AT.
#
# The live cases are a ZWJ sequence ("…👨" + a cut joiner) and a flag split between its two
# regional indicators — note an RI only blocks the cut when the character BEFORE it is also
# an RI, or every cut landing in front of a flag would needlessly eat the character before
# it. The zero-width test is a guard, not a live path: a 0-cell character never trips a
# budget test, so a cut can never land directly on one.
CUT_AT=0
cluster_back() {
    local text=$1 i=$2 c p
    while ((i > 0)); do
        c="${text:$i:1}"                 # first character NOT being emitted
        p="${text:$((i - 1)):1}"         # last character being emitted
        if [[ "$CW_ZERO" == *"$c"* || "$p" == "$CW_ZWJ" ]] ||
            [[ "$CW_NARROW" == *"$c"* && "$CW_NARROW" == *"$p"* ]]; then
            ((i--))
            continue
        fi
        break
    done
    CUT_AT=$i
}

# Cut PLAIN text to at most <cells> display columns, marking an elision. Sets TRUNC_TEXT
# (same no-fork discipline as disp_w). Used where a variable-length value shares a
# single-line budget with fixed chrome — the list view's Now-Playing banner.
TRUNC_TEXT=""
truncate_disp() {
    local text=$1 max=$2 mark="$GL_ELL" i w=0
    # Bounded on purpose: the only question here is whether the text already fits, and
    # disp_w would walk a 3.6k-character description to answer it. See disp_fits.
    disp_fits "$text" "$max"
    if ((DISP_FITS)); then
        TRUNC_TEXT="$text"
        return
    fi
    disp_w "$mark"
    local budget=$((max - DISP_W))
    # The one promise this function makes is "at most <max> cells". Clamping the budget up
    # to 1 broke it: at max=1 it emitted a character AND the mark, two cells. When the
    # budget cannot hold the mark, the mark goes. No caller reaches this today (they all
    # clamp their budget to >= LAYOUT_MIN_BUDGET) — it is the guard on the function's only
    # contract.
    if ((budget < 1)); then
        mark=""
        budget=$max
    fi
    if ((budget < 1)); then
        TRUNC_TEXT=""
        return
    fi
    for ((i = 0; i < ${#text}; i++)); do
        char_w "${text:$i:1}"
        ((w + CHAR_W > budget)) && break
        w=$((w + CHAR_W))
    done
    cluster_back "$text" "$i"
    TRUNC_TEXT="${text:0:$CUT_AT}${mark}"
}

# print_hints <width> <first_prefix> <cont_prefix> "key<TAB>label" | "field" …
# Packs items into as few lines as fit <width>, HINT_SEP between items (two spaces by
# default); an item with no TAB is a plain field (no label). The chrome used to print each view's hints as ONE fixed
# string, which simply ran off the right edge and wrapped mid-item below ~72 columns —
# sooner still because the labels are CJK, i.e. double-width. Every emitted line carries
# \033[K for the in-place render. HINT_KEY_COLOR overrides the key style for
# one call (the status row wants its fields dim, not key-bold); HINT_SEP overrides the
# item separator for one call (the key block joins with " · " so its keys pack into
# one line without brackets). Both are printed and MEASURED from the same value — a
# separator whose width the packer did not know would wrap one item early or late. HINT_LINES reports how many
# lines were emitted: this block is variable-height by design, and the list view has to know
# its real height to decide how many result rows fit (see the reflow in display_list_menu).
# HINT_MEASURE=1 runs the identical packing and reports HINT_LINES without drawing anything,
# so a caller can ask "how tall would this block be?" before committing the space to it. Same
# code path deliberately: a separate estimator would be free to disagree with the printer.
HINT_KEY_COLOR=""
HINT_SEP=""
HINT_LINES=0
HINT_MEASURE=0
print_hints() {
    local width=$1 first_p=$2 cont_p=$3
    shift 3
    HINT_LINES=0
    local item key label pill out="" out_w=0 iw ind_w first=1
    local kc=${HINT_KEY_COLOR:-$C_BOLD}
    local sep=${HINT_SEP:-"  "} sep_w
    disp_w "$sep"
    sep_w=$DISP_W
    disp_w "$first_p"
    ind_w=$DISP_W
    out_w=$ind_w
    for item in "$@"; do
        # A PILL item carries its own ground on a channel of its own: PILL_MARK, the SGR,
        # PILL_MARK, then the text. The text is what gets measured — the whole reason the
        # colour is not simply baked into the string (source_seg's note). A pill is always a
        # plain field, never a key/label pair: the ground is what makes it a thing, and a
        # label hanging off a coloured box reads as a caption on a button.
        pill=""
        if [[ "$item" == "$PILL_MARK"* ]]; then
            item=${item#"$PILL_MARK"}
            pill=${item%%"$PILL_MARK"*}
            item=${item#*"$PILL_MARK"}
        fi
        key=${item%%$'\t'*}
        label=""
        [[ "$item" == *$'\t'* ]] && label=${item#*$'\t'}
        disp_w "$key"
        iw=$DISP_W
        if [[ -n "$label" ]]; then
            disp_w "$label"
            iw=$((iw + 1 + DISP_W))
        fi
        if [[ -n "$out" ]] && ((out_w + sep_w + iw > width)); then
            if ((first)); then
                ((HINT_MEASURE)) || printf '%s%s%s%s\033[K\n' "$C_BOLD" "$first_p" "$C_RESET" "$out"
                first=0
                disp_w "$cont_p"
                ind_w=$DISP_W
            else
                ((HINT_MEASURE)) || printf '%s%s\033[K\n' "$cont_p" "$out"
            fi
            HINT_LINES=$((HINT_LINES + 1))
            out=""
            out_w=$ind_w
        fi
        if [[ -n "$out" ]]; then
            out+="${C_DIM}${sep}${C_RESET}"
            out_w=$((out_w + sep_w))
        fi
        if [[ -n "$pill" ]]; then
            # C_ROW_END, not C_RESET, on BOTH ends: a ground has to be closed with a real
            # \033[0m (C_RESET is the empty string with colours off), and it has to be
            # OPENED against one too — the caller wraps this line in C_DIM, and dim applied
            # to the pill's own white would print grey text on a brand ground.
            out+="${C_ROW_END}${pill}${key}${C_ROW_END}"
        elif [[ -n "$label" ]]; then
            out+="${kc}${key}${C_RESET} ${C_DIM}${label}${C_RESET}"
        else
            out+="${kc}${key}${C_RESET}"
        fi
        out_w=$((out_w + iw))
    done
    if [[ -n "$out" ]]; then
        if ((first)); then
            ((HINT_MEASURE)) || printf '%s%s%s%s\033[K\n' "$C_BOLD" "$first_p" "$C_RESET" "$out"
        else
            ((HINT_MEASURE)) || printf '%s%s\033[K\n' "$cont_p" "$out"
        fi
        HINT_LINES=$((HINT_LINES + 1))
    fi
}

# Elapsed wall-clock since we attached to a stream, as HH:MM:SS / MM:SS. Used for live
# streams, where mpv's own time-pos is a position on the broadcast timeline (hours in) and
# says nothing about how long this listener has been tuned in.
elapsed_since_play() {
    ((CURRENT_PLAY_STARTED > 0)) || { printf '%s' "--:--"; return; }
    local now
    now=$(date +%s 2>/dev/null || echo 0)
    ((now >= CURRENT_PLAY_STARTED)) || { printf '%s' "--:--"; return; }
    fmt_sec $((now - CURRENT_PLAY_STARTED))
}

# Position / duration / percent for the attached mpv, plus the PAUSE state, fetched in ONE
# place: sets PT_CUR, PT_TOTAL and PT_PCT (PT_PCT empty means "draw no bar") and refreshes
# CURRENT_PLAY_PAUSED. It was inlined per view back when there were two player views, and the
# copies had already drifted — one built its percent string and bar inline, the other deferred
# the bar. The live special case belongs here too: "mpv's clock describes the broadcast, not
# this listen" is a fact about the fetch, not about a view.
#
# Pause is read here rather than tracked locally because the local value LIES: toggle_pause
# flips CURRENT_PLAY_PAUSED, but anything else driving the same socket (t-play, an agent's
# own `nc -U`, a second TUI) moves the real state without telling us — the identical reason
# the core reads `volume` off the socket instead of the state file (ARCH-player.md「运行时 IPC」).
# The local flip STAYS: it is what repaints the banner on the keypress instead of up to a
# second later (tests/tui_pane.sh counts the repaint), and this read corrects it on the next
# tick. Optimism, then truth.
#
# The live path no longer returns before the socket read — it asks for `pause` ALONE. The
# early return used to spare the whole round trip, but it also froze the pause chrome for
# exactly the listener most likely to leave a stream parked. One property on one connection
# costs a live tick what a static tick already pays.
PT_CUR=""
PT_TOTAL=""
PT_PCT=""
# The playhead in SECONDS, beside the same reading formatted. PT_CUR is a string built for a
# row; the chapter block needs the number, and re-parsing a "MM:SS" back into seconds to get
# it would be the second spelling this file spends its width layer avoiding. Empty means no
# reading (a live stream, a socket that answered nothing) — never 0, which is a real position.
PT_POS_SEC=""
# The DURATION in seconds, beside PT_TOTAL's printed form, and for the same reason: the
# chapter bracket on the bar needs a denominator, and reading "1:01:14" back into one
# would be a second parser of a format fmt_sec already owns.
PT_DUR_SEC=""
# The player's own footprint — CPU percent and resident MB — summed over its PROCESS GROUP,
# not its pid: the recorded pid is the detached wrapper (a bash that costs nothing), and
# `set -m` at launch made it the group leader (pgid == pid), so the group is the wrapper,
# mpv, and any fallback mpv in one number. One `ps -A | awk` pass because it is the reading
# with ONE portable spelling: `ps -g` selects by pgid on macOS but by session/group name
# under procps, and rss is KB on both. Measured at 24ms — cheap, but not once-a-second
# cheap, so it rides every RES_STRIDE-th call of the shared clock (fetch_play_times,
# the one beat) and the banner reads the cached pair. %cpu is
# ps's own semantics on each platform (a decaying/lifetime average, not an instant) — the
# approximation is the price of the one-command reader. Empty means no reading: disabled,
# nothing playing, or the group already gone.
RES_CPU=""
RES_MEM=""
RES_TICK=0
RES_STRIDE=3   # the same stride t-play samples its heartbeat's resource fields at
fetch_play_res() {
    [[ "$TING_RESOURCE" != 0 ]] || return 0
    [[ -n "$CURRENT_PLAY_PID" ]] || { RES_CPU=""; RES_MEM=""; return 0; }
    RES_TICK=$((RES_TICK + 1))
    # -1 so the FIRST call samples: clear_play_state zeroes the counter, and a readout that
    # waited a full stride after Enter would sit empty exactly when the user looks for it.
    if (((RES_TICK - 1) % RES_STRIDE != 0)); then return 0; fi
    local out=""
    out=$(ps -A -o pgid=,%cpu=,rss= 2>/dev/null |
        awk -v g="$CURRENT_PLAY_PID" '
            $1 == g { c += $2; r += $3; n += 1 }
            END { if (n) printf "%.0f %.0f", c, r / 1024 }') || out=""
    if [[ -n "$out" ]]; then
        RES_CPU="${out%% *}"
        RES_MEM="${out##* }"
    else
        RES_CPU=""
        RES_MEM=""
    fi
    return 0
}
# THE MEDIA FACTS of whatever is playing — what is ACTUALLY DECODING, straight off mpv.
# This is the one half of a track no search envelope can carry: a search row is a flat
# extraction with no format list in it at all, so codec, geometry and bitrate do not exist
# until a player has the stream open. They are read in fetch_play_times' existing batch
# (see the reqs block there for why they ride it rather than a stride of their own).
#
# Each is EMPTY when the property does not apply or is not yet known, and both cases are
# normal rather than errors: an audio-only track has no video-format/width/height, and
# `video-bitrate` is a demuxer estimate that mpv reports as unavailable on plenty of streams
# while video decodes perfectly (measured 2026-09-04, mpv 0.41: a merged AV1+opus YouTube
# stream answered width/height/container-fps and refused video-bitrate). Empty means the
# field is dropped from the line, exactly as an absent view count is dropped from the meta
# line above it — printing a zero for a fact we do not have states something untrue.
PM_VCODEC=""
PM_W=""
PM_H=""
PM_FPS=""
PM_VBR=""
PM_ACODEC=""
PM_ABR=""
PM_SR=""
PM_CH=""

# mpv's raw answers -> the vocabulary the rest of this file speaks. NO FORKS: this runs once
# per tick on the redraw path, and a command substitution per property would be nine forks a
# second to reformat nine short strings. The literal string "null" is what the reader's jq
# produces for a JSON null (`\(.data)` stringifies it), so it is the empty case, not a value.
#
# The codec and channel names are mpv's own (h264 / av1 / opus / mp3 / stereo) and stay
# untouched: renaming them here would put a second spelling of the decoder's answer on
# screen, and these names are the ones a user can search for.
pm_normalise() {
    [[ "$PM_VCODEC" == "null" ]] && PM_VCODEC=""
    [[ "$PM_ACODEC" == "null" ]] && PM_ACODEC=""
    [[ "$PM_CH" == "null" ]] && PM_CH=""
    [[ "$PM_W" =~ ^[0-9]+ ]] && PM_W="${PM_W%.*}" || PM_W=""
    [[ "$PM_H" =~ ^[0-9]+ ]] && PM_H="${PM_H%.*}" || PM_H=""
    [[ "$PM_VBR" =~ ^[0-9]+ ]] && PM_VBR="${PM_VBR%.*}" || PM_VBR=""
    [[ "$PM_ABR" =~ ^[0-9]+ ]] && PM_ABR="${PM_ABR%.*}" || PM_ABR=""
    [[ "$PM_SR" =~ ^[0-9]+ ]] && PM_SR="${PM_SR%.*}" || PM_SR=""
    # fps keeps a fraction — 29.97 is not 30 and a reader who knows the difference is
    # exactly the reader this line is for — but loses mpv's six-digit tail. printf -v, not a
    # substitution, for the same no-fork reason as everything else here.
    if [[ "$PM_FPS" =~ ^[0-9]+\.?[0-9]*$ ]]; then
        printf -v PM_FPS '%.2f' "$PM_FPS" 2>/dev/null || PM_FPS=""
        [[ "$PM_FPS" == *.00 ]] && PM_FPS="${PM_FPS%.00}"
    else
        PM_FPS=""
    fi
    return 0
}

# bits/sec -> the unit a human reads it in. Integer arithmetic only (bash 3.2 has no floats
# and this must not fork a bc), so the tenth is taken by division rather than rounded into:
# 2_499_000 reads 2.4 Mbps, not 2.5. That is the honest direction for an estimate — it never
# claims a bitrate the stream did not carry.
FMT_BR=""
fmt_bitrate() {
    local n=$1 k
    FMT_BR=""
    [[ "$n" =~ ^[0-9]+$ ]] || return 0
    ((n > 0)) || return 0
    # Round to kbps FIRST, then pick the unit off the rounded number. Testing the raw value
    # against 1000000 instead printed "1000 kbps" for 999_999 — a reading that rounds up
    # into the next unit has to change unit with it, or the one number the scale exists to
    # keep short is the one that gets four digits.
    k=$(((n + 500) / 1000))
    if ((k >= 1000)); then
        FMT_BR="$((k / 1000)).$((k / 100 % 10)) Mbps"
    else
        FMT_BR="$k kbps"
    fi
    return 0
}

# Hz -> kHz, one decimal only when there is one to show: 48000 is "48 kHz" and 44100 is
# "44.1 kHz". A trailing ".0" on the common case is a digit that carries no information and
# costs a cell on the narrowest surface in the suite.
FMT_HZ=""
fmt_hz() {
    local n=$1 frac
    FMT_HZ=""
    [[ "$n" =~ ^[0-9]+$ ]] || return 0
    ((n > 0)) || return 0
    frac=$((n % 1000 / 100))
    if ((frac)); then
        FMT_HZ="$((n / 1000)).$frac kHz"
    else
        FMT_HZ="$((n / 1000)) kHz"
    fi
    return 0
}

# The media facts as ONE line, video part then audio part, each dropped entirely when the
# player has nothing to say about it. Empty when there is nothing at all to report, which is
# what lets the caller decide between printing a line and not spending one.
#
# Ordered video-first because that is the order they are asked about: a video stream's codec
# and geometry are what a viewer checks, and on an audio-only track the video half simply is
# not there and the line opens on the codec.
MEDIA_LINE=""
media_line() {
    local v="" a=""
    MEDIA_LINE=""
    if [[ -n "$PM_VCODEC" ]]; then
        v="$PM_VCODEC"
        [[ -n "$PM_W" && -n "$PM_H" ]] && v="$v ${PM_W}x${PM_H}"
        [[ -n "$PM_FPS" ]] && v="$v ${PM_FPS}fps"
        fmt_bitrate "$PM_VBR"
        [[ -n "$FMT_BR" ]] && v="$v $FMT_BR"
    fi
    if [[ -n "$PM_ACODEC" ]]; then
        a="$PM_ACODEC"
        fmt_bitrate "$PM_ABR"
        [[ -n "$FMT_BR" ]] && a="$a $FMT_BR"
        fmt_hz "$PM_SR"
        [[ -n "$FMT_HZ" ]] && a="$a $FMT_HZ"
        [[ -n "$PM_CH" ]] && a="$a $PM_CH"
    fi
    if [[ -n "$v" && -n "$a" ]]; then
        MEDIA_LINE="$v $GL_SEP $a"
    else
        MEDIA_LINE="$v$a"
    fi
    return 0
}

fetch_play_times() {
    fetch_play_res
    PT_CUR="--:--"
    PT_TOTAL="$CURRENT_PLAY_DURATION"
    PT_PCT=""
    PT_POS_SEC=""
    PT_DUR_SEC=""
    # The media facts reset with the clock and for the same reason: a tick that could not
    # reach the socket must not leave the PREVIOUS reading on screen as if it were current.
    PM_VCODEC=""; PM_W=""; PM_H=""; PM_FPS=""; PM_VBR=""
    PM_ACODEC=""; PM_ABR=""; PM_SR=""; PM_CH=""
    local live=0
    if ((CURRENT_PLAY_IS_LIVE)); then
        live=1
        PT_CUR=$(elapsed_since_play)
        PT_TOTAL="$GL_LIVE"
    fi
    [[ -n "$CURRENT_PLAY_SOCK" && -S "$CURRENT_PLAY_SOCK" ]] || return 0
    # Up to four properties, ONE connection, correlated by request_id and read without waiting
    # for nc — see send_mpv_ipc for both rules. `\(.data)` stringifies a
    # JSON null as "null", so a missing value keeps its slot and the guards below (which
    # already tested for "null") are unchanged. The live request set is `pause` only: mpv's
    # clock describes the broadcast, so its position/duration would be fetched to discard.
    local raw_pos="null" raw_dur="null" raw_pct="null" raw_pause="null" raw_title="null"
    local rid val got=0 seen=0
    local want=14
    # Requests 6-14 are the MEDIA FACTS — what is actually decoding, which is the half of a
    # track the search envelope can never carry: a flat search row has no format list at all
    # (verified against yt-dlp's own entry keys), so codec, geometry and bitrate exist only
    # once a player has one open. They ride THIS batch rather than a stride of their own
    # because the connection, the nc fork and the jq are all already paid for here — nine
    # more get_property lines down a pipe that is running is the cheapest read in the file,
    # and cheaper than the cache-invalidation a "fetch once per track" version would need
    # (the tripwire below already exists for the title, and a second consumer of it is a
    # second thing to keep correct). Fetching them every tick also keeps `audio-bitrate`
    # honest: mpv computes it from recently decoded packets, so it is a MOVING estimate and
    # is legitimately unavailable in the first seconds of a track.
    local -a reqs=(
        '{"command":["get_property","time-pos"],"request_id":1}'
        '{"command":["get_property","duration"],"request_id":2}'
        '{"command":["get_property","percent-pos"],"request_id":3}'
        '{"command":["get_property","pause"],"request_id":4}'
        '{"command":["get_property","media-title"],"request_id":5}'
        '{"command":["get_property","video-format"],"request_id":6}'
        '{"command":["get_property","width"],"request_id":7}'
        '{"command":["get_property","height"],"request_id":8}'
        '{"command":["get_property","container-fps"],"request_id":9}'
        '{"command":["get_property","video-bitrate"],"request_id":10}'
        '{"command":["get_property","audio-codec-name"],"request_id":11}'
        '{"command":["get_property","audio-bitrate"],"request_id":12}'
        '{"command":["get_property","audio-params/samplerate"],"request_id":13}'
        '{"command":["get_property","audio-params/hr-channels"],"request_id":14}'
    )
    # media-title is asked for on the live path too: what changes under a live stream is not
    # its clock, it is WHICH TRACK the queue is on, and that is exactly what this detects.
    # The media facts stay on the live path for the same reason in reverse: what a live
    # stream loses is its CLOCK, not its codec, and "what am I actually receiving" is if
    # anything the more useful question on a broadcast than on a file.
    if ((live)); then
        want=11
        reqs=('{"command":["get_property","pause"],"request_id":4}'
              '{"command":["get_property","media-title"],"request_id":5}'
              "${reqs[@]:5}")
    fi
    while IFS="$US" read -r rid val; do
        seen=$((seen + 1))
        case "$rid" in
        1) raw_pos="$val"; got=$((got + 1)) ;;
        2) raw_dur="$val"; got=$((got + 1)) ;;
        3) raw_pct="$val"; got=$((got + 1)) ;;
        4) raw_pause="$val"; got=$((got + 1)) ;;
        5) raw_title="$val"; got=$((got + 1)) ;;
        6) PM_VCODEC="$val"; got=$((got + 1)) ;;
        7) PM_W="$val"; got=$((got + 1)) ;;
        8) PM_H="$val"; got=$((got + 1)) ;;
        9) PM_FPS="$val"; got=$((got + 1)) ;;
        10) PM_VBR="$val"; got=$((got + 1)) ;;
        11) PM_ACODEC="$val"; got=$((got + 1)) ;;
        12) PM_ABR="$val"; got=$((got + 1)) ;;
        13) PM_SR="$val"; got=$((got + 1)) ;;
        14) PM_CH="$val"; got=$((got + 1)) ;;
        *) ;;                                  # an async event; not one of ours
        esac
        ((got >= want || seen >= 30)) && break
    done < <(printf '%s\n' "${reqs[@]}" |
        "${NC_UNIX[@]}" "$CURRENT_PLAY_SOCK" 2>/dev/null |
        jq -r --unbuffered 'select(.request_id != null)
                            | "\(.request_id)\u001f\(.data)"' 2>/dev/null)
    # "null" (the player did not answer, or answered null) leaves the local value alone —
    # a missing answer is not evidence that it resumed.
    [[ "$raw_pause" == "true" ]] && CURRENT_PLAY_PAUSED=1
    [[ "$raw_pause" == "false" ]] && CURRENT_PLAY_PAUSED=0
    # The tripwire. It fires ONCE per real change: refresh_player_record stores the title it
    # saw, so a row title that merely differs from the engine's media-title (different
    # escaping, an engine that cleaned it up) cannot make this re-read on every tick.
    if [[ -n "$raw_title" && "$raw_title" != "null" && "$raw_title" != "$CURRENT_PLAY_MPV_TITLE" ]]; then
        refresh_player_record "$raw_title"
    fi
    pm_normalise
    # if-form, not an AND-list: house rule for an arithmetic test (see player_check_ready).
    if ((live)); then return 0; fi
    if [[ -n "$raw_pos" && "$raw_pos" != "null" ]]; then
        PT_CUR=$(fmt_sec "$raw_pos")
        PT_POS_SEC=${raw_pos%.*}
        [[ "$PT_POS_SEC" =~ ^[0-9]+$ ]] || PT_POS_SEC=""
    fi
    if [[ -n "$raw_dur" && "$raw_dur" != "null" ]]; then
        PT_TOTAL=$(fmt_sec "$raw_dur")
        PT_DUR_SEC=${raw_dur%.*}
        [[ "$PT_DUR_SEC" =~ ^[0-9]+$ ]] || PT_DUR_SEC=""
    fi
    [[ -n "$raw_pct" && "$raw_pct" != "null" ]] && PT_PCT=${raw_pct%.*}
    return 0
}

# Progress bar sized to the caller's layout. $2 is the FULL cell width the bar may occupy,
# so the caller can lay it exactly over the divider rail it replaces while a track plays,
# instead of the old hardcoded 44 columns that ignored the terminal width entirely. The rendered string is ALWAYS exactly
# that many cells — filled + remaining, exactly, at every position, including a full heavy
# rail at 100%; a bar whose length changed with position made the whole line jitter
# every second.
#
# No [brackets]: the bar is not a widget sitting on the card, it is the card's LIVE RAIL —
# `━` elapsed and `─` remaining are the divider's own stroke family, so the played part reads
# as the rail thickening. HEAVY, not double: `═` was tried and it is
# two strokes where every other glyph on this line is one — it stops reading as a thicker
# rail and starts reading as a different rail, spliced onto the light one. The bar's whole
# premise is that ONE line changes weight as it fills, and a weight change is the thing on
# it that can be read without a legend. The
# ends had to go for that to work: a bracket is a boundary, and this line's whole job is to
# be boundary-less and exactly rail-wide. They were also 2 cells of the caller's width spent
# on punctuation, which now buy 2 more cells of resolution instead.
#
# NO HEAD GLYPH EITHER, for the same argument carried one step further. A `╸` sat between the
# two runs for a while: a heavy LEFT half-line, which inks its own left half and leaves its
# right half white — so the one seam that must not be a boundary was drawn with half a cell
# of white in it, and the eye read the elapsed run as ENDING rather than as the same rail at
# a different weight. The weight change IS the playhead, and a GLYPH marking it a second
# time can only get in its way — which is not the same as saying nothing else may say it:
# the caller's dim on the remaining run says the same seam over the whole of both runs
# rather than planting a second mark on the one cell where they meet. So the rail runs unbroken from `━` straight into `─`, and **the only white on this
# line is a chapter boundary** — which is what makes a break legible as one.
#
# TWO RUNS OUT, NOT ONE STRING, and that is the whole reason this returns a pair: the weight
# change above is the playhead, and the caller prints the remaining run one step DIMMER of
# the same accent so the same seam is said twice — once in stroke, once in intensity. Dim is
# this file's existing word for "this accent, but not the steady thing" (play_state_marks'
# LOADING rung), so it costs the palette nothing: still one hue on the line. It also degrades
# in the right direction — with colours off both halves print bare and the bar is exactly
# what it was, a weight change and nothing else.
#
# The split is at `filled` in BOTH paths, breaks included: a break substitutes for the cell
# it lands on and never moves the seam, so cells 0..filled-1 are the played run whatever is
# drawn in them. Colour is applied by the CALLER, not baked in here — these two strings stay
# plain text, which is the same contract the width layer asks of everything it measures.
PROG_PLAYED=""
PROG_REST=""
render_prog_bar() {
    local pct=${1%.*} total=${2:-44} mark_a=${3:-} mark_b=${4:-}
    PROG_PLAYED=""
    PROG_REST=""
    [[ "$pct" =~ ^[0-9]+$ ]] || return 0
    ((pct > 100)) && pct=100
    ((pct < 0)) && pct=0
    ((total < 10)) && total=10

    local width=$total                    # the track IS the full width; no brackets
    local filled=$((pct * width / 100))
    local empty=$((width - filled))       # track = filled + empty, and nothing between them

    local fill='━' rest='─' brk=' '
    if ((ASCII_GLYPHS)); then
        fill='='
        rest='-'
    fi
    # No interval asked for — every caller but the chapter list — and the bar stays what it
    # was: two runs butted together, no per-cell work on a line redrawn once a second.
    if [[ -z "$mark_a" ]]; then
        repeat_glyph "$fill" "$filled"; PROG_PLAYED=$GLYPH_RUN
        repeat_glyph "$rest" "$empty"; PROG_REST=$GLYPH_RUN
        return 0
    fi
    # THE INTERVAL. Two cells of the same track BROKEN OUT, so one line says where the
    # playhead is AND where the marked span sits in the whole item — which is the pairing a
    # reader of a chapter list actually wants and the two identical rails never gave.
    # The mark is the BREAK itself — one cell of nothing — not a glyph drawn in it. Two
    # candidates were drawn at the real width and both lost to it. `[`/`]` are punctuation
    # sitting ON a rail: two ink-heavy glyphs of a different family competing with the
    # playhead for the eye, on the one line whose job is to be read at a glance. `│` is lighter and in
    # the rail's own stroke family, and it still loses, for the reason the brackets do: a
    # VERTICAL crossing a horizontal rail stops the eye travelling along it. This line is
    # read as a sweep from left to right — that is what a progress bar IS — and a full-height
    # stroke is a wall across that sweep, twice. The break is the only mark that does not
    # interrupt the flow, because it is not a mark: the rail simply stops for a cell and
    # starts again, which is already a boundary, and is the same argument that took the bar's
    # own end brackets off. It costs nothing in either mode — a space is one cell under any
    # width table and needs no ASCII fallback.
    ((mark_a < 0)) && mark_a=0
    ((mark_a > width - 1)) && mark_a=$((width - 1))
    [[ "$mark_b" =~ ^[0-9]+$ ]] || mark_b=-1
    ((mark_b > width - 1)) && mark_b=$((width - 1))
    # A span under three cells wide gets its opening break alone. Two stops with nothing
    # between them is not a span, it is a gap in the rail where a plain track said more —
    # and the two breaks would be ADJACENT, which draws two cells of white and reads as one
    # wide gap rather than as two boundaries. Every gap on this line is one cell or it is
    # not a gap, so the closer is dropped rather than allowed to double the opener's.
    ((mark_b <= mark_a + 1)) && mark_b=-1
    # ONE CELL OF WHITE at every break, and it is a plain space at every one of them. It used
    # to need a compensating `╶` (light RIGHT half-line) wherever a break landed immediately
    # after the playhead, because `╸`'s white right half plus a space drew one and a HALF
    # cells and that break read wider than the others. With no head glyph on the line, every
    # cell either side of a break is a full-width stroke, so every break is one cell by
    # construction and the special case is gone with the glyph that caused it.
    local col c
    for (( col = 0; col < width; col++ )); do
        if ((col == mark_a || col == mark_b)); then c=$brk
        elif ((col < filled)); then c=$fill
        else c=$rest
        fi
        # The seam is the SAME cell index either way — a break replaces the glyph in its
        # cell, it does not shift the playhead — so the run a cell belongs to is decided by
        # the index alone and a break inherits the colour of the side it fell on.
        if ((col < filled)); then PROG_PLAYED="$PROG_PLAYED$c"; else PROG_REST="$PROG_REST$c"; fi
    done
    return 0
}

# One emit point for every line wrap_print produces, so WRAP_LINES and the measure switch
# cannot drift from the printer (a separate estimator would be free to disagree — the same
# reason print_hints measures through its own packing code).
WRAP_LINES=0
WRAP_MEASURE=0
# A ceiling on how many lines one wrap may spend, 0 for none. It lives HERE, at the single
# emit point, for the reason WRAP_LINES does: a caller that stopped feeding the wrapper early
# would be a second wrapper, free to disagree with this one about where the lines fall. The
# description is the one caller that sets it; the title deliberately does not, because
# "the full title" is the whole reason this block exists.
WRAP_MAX=0
wrap_emit() {
    ((WRAP_MAX > 0 && WRAP_LINES >= WRAP_MAX)) && return 0
    ((WRAP_MEASURE)) || printf '%s%s\033[K\n' "$1" "$2"
    WRAP_LINES=$((WRAP_LINES + 1))
}

wrap_print() {
    local text="$1" max_w="$2" first_p="$3" cont_p="$4"
    WRAP_LINES=0
    local words=()
    read -ra words <<< "$text"

    local line="" cur_w=0 first=1
    local w w_len i c c_w

    # Guarded like every other array expansion here (ARCHITECTURE.md「可移植性契约」): `read -ra words <<< ""` leaves
    # words UNSET, and "${words[@]}" on an unset array is an unbound-variable abort under
    # set -u on bash 3.2, and the abort takes the whole TUI down with no message. The path
    # that first hit it was print_details restating the row's title, which no longer exists;
    # the one caller left is the description, and it reaches here the same way — its `-n`
    # gate passes a description that is nothing but whitespace, and that splits to no words
    # at all. The guard is not historical: it is what stands between a blank field and a
    # dead terminal.
    for w in ${words[@]+"${words[@]}"}; do
        disp_w "$w"
        w_len=$DISP_W

        if ((w_len > max_w)); then
            if [[ -n "$line" ]]; then
                if ((first)); then
                    wrap_emit "$first_p" "$line"
                    first=0
                else
                    wrap_emit "$cont_p" "$line"
                fi
                line=""
                cur_w=0
            fi
            # A zero-width character has c_w=0, so it can never trip the test below and
            # never starts a continuation line — combining marks, VS and ZWJ stay attached to
            # their base for free. A flag pair (two 1-cell regional indicators) can still be
            # split here; this branch only runs for a single word wider than the whole line,
            # so it is not worth a cluster_back walk.
            for (( i = 0; i < ${#w}; i++ )); do
                c="${w:$i:1}"
                char_w "$c"
                c_w=$CHAR_W
                if ((cur_w + c_w > max_w)); then
                    if ((first)); then
                        wrap_emit "$first_p" "$line"
                        first=0
                    else
                        wrap_emit "$cont_p" "$line"
                    fi
                    line="$c"
                    cur_w=$c_w
                else
                    line+="$c"
                    cur_w=$((cur_w + c_w))
                fi
            done
            continue
        fi

        local need_w=$w_len
        [[ -n "$line" ]] && need_w=$((need_w + 1))

        if ((cur_w + need_w > max_w)); then
            if ((first)); then
                wrap_emit "$first_p" "$line"
                first=0
            else
                wrap_emit "$cont_p" "$line"
            fi
            line="$w"
            cur_w=$w_len
        else
            if [[ -z "$line" ]]; then
                line="$w"
                cur_w=$w_len
            else
                line="$line $w"
                cur_w=$((cur_w + w_len + 1))
            fi
        fi
    done

    if [[ -n "$line" ]]; then
        if ((first)); then
            wrap_emit "$first_p" "$line"
        else
            wrap_emit "$cont_p" "$line"
        fi
    fi
}

# One chapter's SPAN in seconds, or empty for "mark nothing". It answered in percent once,
# because there were two rails and the lower one drew the playhead's position inside the
# SELECTED chapter; there is one bar now, and what it marks on that bar is where the chapter
# begins and ends in the whole item — a span, not a fraction of itself. The percent went with
# the rail: nothing read it any more, and a function called `_pct` that returns no percent is
# a name that has to be disbelieved before it can be used.
#
# Empty is reserved for the questions this cannot answer — nothing playing, a live stream, no
# reading yet, a DIFFERENT item in the player, or a chapter whose engine published no end —
# and then the bar is drawn without a span, exactly as it is on every other row source.
#
# The END comes out of the item's own chapter table BY START, not by row index: the live
# filter and paging reorder the rows (the reason chapter_sec reads the offset back out of the
# row's own url), while ITEM_CHAP_* is the whole table as the engine published it — and the
# row's `duration` never reaches the row arrays, only its wire spelling does, so reading the
# end here costs no second parser of a format short_dur already owns.
CHAP_START_SEC=""
CHAP_END_SEC=""
chapter_span() {
    local i=$1 start end cur j
    CHAP_START_SEC=""
    CHAP_END_SEC=""
    [[ "$LIST_SOURCE" == "chapters" ]] || return 0
    [[ -n "$CURRENT_PLAY_ID" && -n "$PT_POS_SEC" ]] || return 0
    # if-form, not an AND-list: house rule for an arithmetic test (see player_check_ready).
    if ((CURRENT_PLAY_IS_LIVE)); then return 0; fi
    chapter_sec "${urls[$i]}" || return 0
    start=$CHAP_SEC
    # "The player holds THIS item" — the {engine, url} pair, asked exactly as play_chapter
    # asks it before it decides between a seek and a launch. A percent measured against
    # another video's clock is not a smaller error than no percent at all.
    handle_key "$CURRENT_PLAY_URL"; cur="$HANDLE_KEY"
    handle_key "${urls[$i]}"
    [[ -n "$cur" && "$cur" == "$HANDLE_KEY" ]] || return 0
    [[ "${R_ENGINE[$i]:-}" == "$CURRENT_PLAY_ENGINE" ]] || return 0
    end=""
    for ((j = 0; j < ITEM_CHAP_N; j++)); do
        if [[ "${ITEM_CHAP_SEC[$j]}" == "$start" ]]; then
            end="${ITEM_CHAP_END[$j]:-}"
            break
        fi
    done
    [[ -n "$end" ]] || return 0
    if ((end <= start)); then return 0; fi
    CHAP_START_SEC=$start
    CHAP_END_SEC=$end
    return 0
}

# print_details <width> <index> — the details section under the list, for the SELECTED row
# only: one dim metadata line (source position, channel, duration, views, id), then — when
# this row is the one PLAYING — what is actually decoding, then up to two lines of
# description. This is the half of a result a single row cannot show: the rows spend their
# width on titles and a duration rail, and everything else lives here.
#
# The three lines answer three different questions, in the order a reader asks them: WHAT is
# this (the meta line, from the search envelope), HOW is it reaching me (the media line,
# from the mpv socket), and WHAT IS IT ABOUT (the description, from the same envelope as the
# first). Only the middle one can be absent on a row that has everything else, because it is
# the only one whose source is a running process rather than a fetched record.
#
# DETAIL_MEASURE=1 runs the identical code path and reports DETAIL_LINES without drawing,
# mirroring HINT_MEASURE / print_hints. The measure mode is not a convenience: the block
# prints AFTER the rows but its height has to be known BEFORE them, or a long title costs
# the header instead of a row.
DETAIL_LINES=0
DETAIL_MEASURE=0
print_details() {
    local width=$1 i=$2 dur views vid meta
    DETAIL_LINES=0
    ((i >= 0 && i < NUM_ENTRIES)) || return 0
    if [[ "${R_LIVE[$i]}" == "is_live" ]]; then
        # Here a glyph reads as a badge, so the details line gets the "● LIVE" form the rows
        # deliberately do not (a numeric column wants no glyph in it).
        dur="$GL_LIVE"
        views="live now"
    else
        short_dur "${R_DUR[$i]}"
        dur="$SHORT_DUR"
        # An absent view count is NOT zero views: the envelope reports null when the count
        # was not published, and printing "0 views" for it states a fact we do not have.
        if [[ -n "${R_VIEWS[$i]}" ]]; then
            commas "${R_VIEWS[$i]}"
            views="$COMMAS views"
        else
            views=""
        fi
    fi
    # NO RAIL. This block opened with a full-width rule that was a boundary everywhere and,
    # in a chapter list, quietly a second progress bar — the playhead's position inside the
    # SELECTED chapter. Two identical rules a screen apart, each reading a different clock,
    # is a line the reader has to be told how to read. The boundary is now the blank line
    # this block already sits under, and the fact the rule carried moved UP onto the item's
    # own bar as a broken-out span (render_prog_bar's mark_a/mark_b) — where it is next to the
    # playhead it is measured against instead of six lines away from it.
    DETAIL_LINES=0
    # NO TITLE HERE. It used to be the first thing this block printed — the same cleaned
    # title the row measured — and the row carrying it is one line up, under the cursor,
    # which is how the reader got here. Restating it spent 1 to 3 lines (it is a WRAP, so a
    # long title costs more than one) on the only fact on this screen the reader cannot
    # possibly be missing, on the half of the screen with the least room. The description
    # below already carries the note this block's job is to add: it is the one line here
    # that is not on the row in some form.
    #
    # Removed for ALL row sources, chapters and parts included. A chapter's own identity is
    # its span and its number, and both are on the row and in the meta line below.
    # The id is DERIVED from the url rather than carried as a field of its own. The '?' below
    # is a glob metacharacter in this expansion and matches the literal '?' of "watch?v=".
    # The OFFSET comes off it: a chapter row's url ends `&t=961`, and `CLeZyIID9Bo&t=961` is
    # not an id — it is the id with this row's seek target stapled on, in the one place a
    # reader goes to copy an id out. The span above already says where the chapter starts.
    vid="${urls[$i]}"
    vid="${vid#*watch?v=}"
    vid="${vid%%[?&]t=*}"
    # Where this row sits in its SOURCE, for the two sources that have an order of their own
    # — a chapter and a part are numbered BY the item, and the number on screen is the
    # filter's, not the item's (filter to three chapters and they are rows 1-3). Gated on the
    # view rather than on the field, so a store that ever grew an `n` cannot borrow the word.
    meta=""
    case "$LIST_SOURCE" in
    chapters) [[ -n "${R_N[$i]}" && -n "$SOURCE_TOTAL" ]] &&
        meta="$S_CHAP_KEY ${R_N[$i]}/$SOURCE_TOTAL $GL_SEP " ;;
    parts) [[ -n "${R_N[$i]}" && -n "$SOURCE_TOTAL" ]] &&
        meta="$S_PARTS_KEY ${R_N[$i]}/$SOURCE_TOTAL $GL_SEP " ;;
    esac
    # A playlist row has no channel (not stored — it expires), so the field is dropped
    # rather than printed as an empty cell with a separator hanging off it, the same way an
    # absent view count is dropped above.
    [[ -n "${R_CHAN[$i]}" ]] && meta+="${R_CHAN[$i]} $GL_SEP "
    meta+="$dur"
    [[ -n "$views" ]] && meta+=" $GL_SEP $views"
    meta+=" $GL_SEP $vid"
    truncate_disp "$meta" $((width - 2))
    ((DETAIL_MEASURE)) || printf '  %s%s%s\033[K\n' "$C_DIM" "$TRUNC_TEXT" "$C_RESET"
    DETAIL_LINES=$((DETAIL_LINES + 1))
    # WHAT IS ACTUALLY DECODING — codec, geometry, bitrate, sample rate — and it prints for
    # the PLAYING row only, because that is the only row it can be true of. Every fact on
    # this line comes off the mpv socket (fetch_play_times' batch), so it exists exactly
    # while a player has this item open; under any other row it would be a caption from a
    # different track, which is the failure the meta line's own rules keep avoiding.
    #
    # Not from the engine, and that is the point. The player's record does carry `selected`
    # ("251 - audio only (medium)") — but that is the format string the engine ASKED FOR,
    # the request rather than the answer, and it says nothing about what the decoder ended
    # up with. mpv is the only party that knows, and it was already being asked.
    #
    # THE ROW IS MATCHED BY URL, not by index — the same normaliser and the same {engine,
    # url} pair chapter_span uses, for the same reasons (a re-sort, a filter or a page turn
    # moves the index and not the url). handle_key drops a `t=` segment, so a CHAPTER row
    # matches the item the player holds without a case of its own: the whole item is what is
    # decoding, whichever chapter the playhead is inside.
    if [[ -n "$CURRENT_PLAY_ID" && -n "$CURRENT_PLAY_URL" &&
          "${R_ENGINE[$i]:-}" == "$CURRENT_PLAY_ENGINE" ]]; then
        local pkey
        handle_key "$CURRENT_PLAY_URL"; pkey="$HANDLE_KEY"
        handle_key "${urls[$i]}"
        if [[ -n "$pkey" && "$pkey" == "$HANDLE_KEY" ]]; then
            media_line
            if [[ -n "$MEDIA_LINE" ]]; then
                truncate_disp "$MEDIA_LINE" $((width - 2))
                ((DETAIL_MEASURE)) || printf '  %s%s%s\033[K\n' "$C_DIM" "$TRUNC_TEXT" "$C_RESET"
                DETAIL_LINES=$((DETAIL_LINES + 1))
            fi
        fi
    fi
    # THE DESCRIPTION, and it is the only line here that is not already on the row in some
    # form. It arrives with the search envelope — both engines had it in the response they
    # were already making and threw it away — so it costs no request: the block used to
    # restate the row's title and its rail, which is what "details" that detail nothing look
    # like. Two lines at most, capped TWICE: pre-cut to what two lines can hold (that is
    # where the ellipsis comes from, since a wrap has no way to say "and more") and WRAP_MAX
    # as the fuse, because word wrapping can spend a line on less than it fits.
    if [[ -n "${R_DESC[$i]}" ]]; then
        truncate_disp "${R_DESC[$i]}" $(( (width - 2) * 2 - 2 ))
        WRAP_MEASURE=$DETAIL_MEASURE
        WRAP_MAX=2
        ((DETAIL_MEASURE)) || printf '%s' "$C_DIM"
        wrap_print "$TRUNC_TEXT" $((width - 2)) "  " "  "
        ((DETAIL_MEASURE)) || printf '%s' "$C_RESET"
        WRAP_MAX=0
        WRAP_MEASURE=0
        DETAIL_LINES=$((DETAIL_LINES + WRAP_LINES))
    fi
}

# The WRITE side of playback goes through t-play's verbs, not through this file's socket.
# Playback belongs to the player, so a fix there reaches every caller — the TUI, an agent, a
# script — instead of only this screen (CLAUDE.md: correctness is added DOWN). One keypress
# is one call, which is what makes the fork affordable here and not on the read path.
#
# Two paths deliberately do NOT follow:
#   - fetch_play_times, which runs on every 1 s tick: a process chain per tick is a real cost.
#   - the -/= volume keys, which are HELD DOWN. Measured on a live player, 10 presses each:
#     10 ms a press over the socket against 60 ms through `t-play --set-volume` (that verb
#     also resolves the target and patches the state file under a lock). Above the 50 ms line
#     this repo set for the choice, so they stay on the socket — the exception is recorded in
#     docs/ARCHITECTURE.md「已知约束」 with the number, because an unexplained inconsistency is the
#     thing to avoid, not an explained one.
# $1.. is the verb and its value; --id and -j are this function's business.
play_verb() {
    [[ -n "$CURRENT_PLAY_ID" ]] || return 0
    # Fire-and-forget, like send_mpv_ipc: a failed keypress must not be the status of the
    # case arm that ran it, or set -e kills the TUI over an optional effect.
    "$PLAY_BIN" "$@" --id "$CURRENT_PLAY_ID" -j 2>/dev/null || true
}

# Re-read what the player is actually playing, from the one command that knows: t-play. The
# queue, the title and the url all move together when a track ends, and this screen is not
# what moved them. One fork, at a track boundary only (see CURRENT_PLAY_MPV_TITLE).
refresh_player_record() {
    local seen=$1 rec
    CURRENT_PLAY_MPV_TITLE="$seen"
    [[ -n "$CURRENT_PLAY_ID" ]] || return 0
    rec=$("$PLAY_BIN" --status -j 2>/dev/null | jq -c --arg i "$CURRENT_PLAY_ID" \
        '.players[] | select(.id == $i)' 2>/dev/null) || return 0
    [[ -n "$rec" ]] || return 0
    apply_player_record "$rec"
    return 0
}

# One place that turns a player record (or a queue verb's envelope) into this screen's
# fields, so the three callers cannot drift about what a record means. Absent fields are
# LEFT ALONE rather than blanked: an envelope that carries only `queue` must not erase the
# title.
apply_player_record() {
    local rec=$1 t d u eng dw q
    IFS="$US" read -r t d u eng dw < <(printf '%s' "$rec" |
        jq -r "$JQ_TEXT_DEFS"'[(.title // "" | clean), (.duration // "" | tostring),
                               (.url // ""), (.engine // ""), (.duration | fmt_dur)]
                              | join("\u001f")' 2>/dev/null) || return 0
    [[ -n "$t" ]] && CURRENT_PLAY_TITLE="$t"
    [[ -n "$d" && "$d" != "null" ]] && CURRENT_PLAY_DURATION=$(fmt_sec "$d")
    [[ -n "$dw" ]] && CURRENT_PLAY_DUR_WIRE="$dw"
    [[ -n "$u" ]] && CURRENT_PLAY_URL="$u"
    [[ -n "$eng" ]] && CURRENT_PLAY_ENGINE="$eng"
    q=$(printf '%s' "$rec" | jq -c '.queue // empty' 2>/dev/null) || q=""
    if [[ -n "$q" ]]; then
        IFS="$US" read -r CURRENT_QUEUE_POS CURRENT_QUEUE_LEN < <(
            printf '%s' "$q" | jq -r '[(.pos // 0 | tostring), (.len // 0 | tostring)]
                                      | join("\u001f")' 2>/dev/null
        ) || true
    fi
    return 0
}

# The session this screen opens into may ALREADY have a player: `t-play -d` from a shell, a
# queue started by an agent, or a previous ting whose player outlived it (that is what
# detached playback is for). Nothing used to ask. The first frame then drew an empty banner
# over a track that was audibly playing, every key that needs a target fell through its
# `[[ -n "$CURRENT_PLAY_ID" ]]` guard as a silent no-op, and Enter launched a SECOND mpv over
# the first — two tracks in the speakers at once, and the older player unreachable from this
# screen for the rest of the session, because its id was never here to stop it with.
#
# ONE fork, once, before the first frame. The 0/1/many split is not this file's invention: it
# is t-play's own resolve_target rule reached from the client side, so "which player does a
# command with no --id mean" has ONE answer in this suite. Exactly one live player is
# unambiguous and gets adopted; two or more is `ambiguous` there and this screen guesses no
# harder than the core does — it says so in a notice and leaves the banner empty, and the
# next Enter is then the user's own explicit choice of what should be playing.
#
# The socket comes out of the ENVELOPE, never rebuilt from "$STATE_DIR/mpv-$id.sock": the
# same rule the launch path follows, and the reason --status carries sock at all
# (ARCH-player.md「运行时 IPC」).
probe_active_player() {
    local out n rec id pid sock paused pos pkey i
    out=$("$PLAY_BIN" --status -j 2>/dev/null) || return 0
    n=$(printf '%s' "$out" | jq -r '.players | length' 2>/dev/null) || return 0
    [[ "$n" =~ ^[0-9]+$ ]] || return 0
    if ((n != 1)); then
        if ((n > 1)); then store_notice "$S_ADOPT_ACT:" "$S_ADOPT_MANY"; fi
        return 0
    fi
    rec=$(printf '%s' "$out" | jq -c '.players[0]' 2>/dev/null) || return 0
    [[ -n "$rec" ]] || return 0
    # `(.pid // "" | tostring)`, not `(.pid | tostring // "")`: the second parses as
    # `.pid | (tostring // "")` and turns a null pid into the STRING "null", which
    # check_player_alive then hands to `kill -0` on the first tick — the adoption would undo
    # itself one second after the first frame. US for the same reason start_playback uses it.
    IFS="$US" read -r id pid sock paused pos < <(
        printf '%s' "$rec" | jq -r '[(.id // ""), (.pid // "" | tostring), (.sock // ""),
                                     (if .paused then "1" else "0" end),
                                     (.position // "" | tostring)] | join("\u001f")' 2>/dev/null
    ) || true
    # Same pair the launch path requires: without an id there is nothing to command and
    # without a socket nothing to read. -S is deliberately NOT tested — a player still on its
    # way up has a record before mpv has bound the socket, and every reader of the path
    # already guards on -S per tick, so it simply starts answering when it appears.
    [[ -n "$id" && -n "$sock" ]] || return 0

    CURRENT_PLAY_ID="$id"
    CURRENT_PLAY_PID="$pid"
    CURRENT_PLAY_SOCK="$sock"
    CURRENT_PLAY_PAUSED="$paused"
    # Not "Starting": this player is already up, and the loading state is a claim about a
    # launch THIS screen made and is waiting on. player_check_ready would have nothing to
    # resolve it against.
    CURRENT_PLAY_LOADING=0
    CURRENT_PLAY_ADOPTED=1
    # Title, duration, url, engine and the queue counters go through the one ingest point,
    # not through a second copy of the same jq: an adopted title has to be the SAME cleaned
    # spelling as the row it will be drawn over (apply_player_record).
    apply_player_record "$rec"
    # A player adopted in the seconds before its child has resolved has a record with a null
    # title, and a banner that says "Playing:" and nothing else names nothing. The url is what
    # this screen knows in that window — it is the other half of the CALL, it is already here,
    # and the record's own title replaces it on the first tick (fetch_play_times' tripwire
    # fires against an empty CURRENT_PLAY_MPV_TITLE as soon as mpv has one).
    [[ -n "$CURRENT_PLAY_TITLE" ]] || CURRENT_PLAY_TITLE="$CURRENT_PLAY_URL"
    # Where the player is, not when it started: the elapsed readout counts from
    # CURRENT_PLAY_STARTED, so a player found 40 minutes into a track has to be attached with
    # a start stamp 40 minutes in the past or the banner would restart its clock at 0:00.
    local now
    now=$(date +%s 2>/dev/null || echo 0)
    pos=${pos%%.*}                                 # mpv answers e.g. 137.402
    if [[ "$pos" =~ ^[0-9]+$ ]]; then
        CURRENT_PLAY_STARTED=$((now - pos))
    else
        CURRENT_PLAY_STARTED=$now
    fi
    # Liveness is the one fact the record cannot carry: mpv reports a live stream's duration
    # as the live edge, so nothing in the envelope distinguishes it from a long file (see
    # CURRENT_PLAY_IS_LIVE). The list is asked instead — the same source the launch path uses
    # (the row's own live_status) — matched on handle_key's normalised handle, which is how
    # the renderer already decides "the player holds this row". A player on a track that is
    # not in this list keeps the static readout, exactly as it did before adoption existed.
    if [[ -n "$CURRENT_PLAY_URL" ]]; then
        handle_key "$CURRENT_PLAY_URL"; pkey="$HANDLE_KEY"
        for ((i = 0; i < NUM_ENTRIES; i++)); do
            handle_key "${urls[$i]:-}"
            if [[ "$HANDLE_KEY" == "$pkey" ]]; then
                if [[ "${R_LIVE[$i]:-}" == "is_live" ]]; then
                    CURRENT_PLAY_IS_LIVE=1
                    CURRENT_PLAY_DURATION="$GL_LIVE"
                fi
                break
            fi
        done
    fi
    # The first tick's tripwire fires once against an empty CURRENT_PLAY_MPV_TITLE and
    # re-reads the record — one fork, and the right one: it is also how a track that changed
    # between this probe and the first frame gets noticed.
    return 0
}

# `+` — append the focused row to the RUNNING player's queue. The player owns the queue, so
# this is one verb call and no state of our own; the envelope answers with the queue it wrote,
# which is what the status line then counts.
enqueue_selected() {
    ((NUM_ENTRIES > 0)) || return 0
    if [[ -z "$CURRENT_PLAY_ID" ]]; then
        store_notice "$S_Q_ACT:" "$S_Q_NONE"
        return 0
    fi
    focused_payload || { store_notice "$S_Q_ACT:" "$S_PL_FAILED"; return 0; }
    local out rc=0
    out=$(printf '%s' "$FOCUSED_PAYLOAD" | "$PLAY_BIN" --enqueue - --id "$CURRENT_PLAY_ID" --owner $$ -j 2>/dev/null) || rc=$?
    if ((rc != 0)); then
        store_notice "$S_Q_ACT:" "$S_PL_FAILED"
        return 0
    fi
    # No notice on success: one keypress should cost one keypress, and the status line's
    # queue segment IS the confirmation. This was the first key to be given that rule; the
    # notice mechanism now applies it everywhere (see store_notice), so what used to be the
    # exception here is simply how the file works. The undo offer is the one line it does
    # draw, and only for as long as `z` can act on it.
    apply_player_record "$out"
    undo_arm queue "$out" "$S_Q_ACT:" "$S_Q_ADDED $GL_ARROW ${R_TITLE[$selected]:-}" || true
    return 0
}

# `>` — drop the current track and start the next. Exit 4 with queue_empty is the player
# saying there is none, which is a message rather than a failure.
skip_next() {
    local out rc=0
    if [[ -z "$CURRENT_PLAY_ID" ]]; then
        store_notice "$S_Q_ACT:" "$S_Q_NONE"
        return 0
    fi
    out=$("$PLAY_BIN" --next --id "$CURRENT_PLAY_ID" -j 2>/dev/null) || rc=$?
    if ((rc != 0)); then
        store_notice "$S_Q_ACT:" "$S_Q_END"
        return 0
    fi
    apply_player_record "$out"
    # The next track's title arrives on its own: the player resolves it, mpv gets it, and
    # fetch_play_times' tripwire re-reads the record on the next tick.
    return 0
}

toggle_pause() {
    local out state
    [[ -n "$CURRENT_PLAY_ID" ]] || return 0
    # Two idempotent verbs, never a toggle: t-play has no --toggle-pause on purpose (mpv's
    # `cycle pause` reports no resulting state), so the TARGET is decided here and the
    # envelope says what mpv actually did. That is strictly better than the old local flip —
    # it is a reading, not a guess — but the flip stays as the FALLBACK for a call that
    # answered nothing, because the banner has to repaint on the keypress either way.
    if ((CURRENT_PLAY_PAUSED)); then out=$(play_verb --resume); else out=$(play_verb --pause); fi
    state=$(printf '%s' "$out" | jq -r '.paused // empty' 2>/dev/null) || state=""
    case "$state" in
    true) CURRENT_PLAY_PAUSED=1 ;;
    false) CURRENT_PLAY_PAUSED=0 ;;
    # Assignment form, not ((CURRENT_PLAY_PAUSED = 1 - CURRENT_PLAY_PAUSED)): an arithmetic
    # command evaluating to 0 returns status 1, so UNPAUSING (1 -> 0) aborted the whole
    # script under set -e — the second Space press killed the TUI. Same trap as char_w and
    # the banner's b_fixed, which already carry this note.
    *) CURRENT_PLAY_PAUSED=$((1 - CURRENT_PLAY_PAUSED)) ;;
    esac
    # Pausing during the load window ends it: `core-idle` stays true while paused, so the probe
    # could never clear the loading state on its own, and "Starting" over a player the user just
    # paused is the wrong sentence anyway. Their keypress is the more specific truth.
    CURRENT_PLAY_LOADING=0
    return 0
}

seek_relative() {
    local offset="$1"
    [[ -n "$CURRENT_PLAY_ID" ]] || return 0
    # --seek REQUIRES the sign (a bare number is a usage error there, deliberately: it reads
    # as relative to some callers and absolute to others). The key table passes -10 with one
    # and 10 without, so this is where the positive case gets its +.
    [[ "$offset" == -* ]] || offset="+$offset"
    play_verb --seek "$offset" >/dev/null
    return 0
}

adjust_volume() {
    local delta="$1" cur target
    [[ -n "$CURRENT_PLAY_ID" ]] || return 0
    # Read-modify-set, not `add volume`: the raw add goes straight to mpv, whose own ceiling
    # is 130, so holding `0` reached a volume the rest of the suite's vocabulary says cannot
    # exist — the core's --set-volume 0-100 validation does not guard the socket path (ARCH-player.md「运行时 IPC」).
    # Verified: a player launched at --volume 10 and pressed `0` twenty times reads 100 in
    # `t-play --status`, where the old `add` left it at 110. The extra round trip costs
    # ~16 ms against a live player (see send_mpv_ipc).
    cur=$(mpv_get_prop volume)
    [[ -n "$cur" ]] || return 0
    cur=${cur%.*}                                  # mpv reports e.g. 55.000000
    [[ "$cur" =~ ^[0-9]+$ ]] || return 0
    target=$((cur + delta))
    ((target < 0)) && target=0
    ((target > 100)) && target=100
    send_mpv_ipc "[\"set_property\",\"volume\",$target]"
}

# One definition of "nothing is attached". Two paths reach it — the user pressing s and the
# liveness poll finding a dead player — and when each cleared its own list they drifted: the
# stop path was missing a field the poll cleared. Field order mirrors the declaration block
# above so a missing one is visible in a diff.
clear_play_state() {
    CURRENT_QUEUE_POS=0
    CURRENT_QUEUE_LEN=0
    CURRENT_PLAY_URL=""
    CURRENT_PLAY_ENGINE=""
    CURRENT_PLAY_MPV_TITLE=""
    CURRENT_PLAY_ID=""
    CURRENT_PLAY_PID=""
    CURRENT_PLAY_TITLE=""
    CURRENT_PLAY_DURATION=""
    CURRENT_PLAY_DUR_WIRE=""
    CURRENT_PLAY_SOCK=""
    CURRENT_PLAY_PAUSED=0
    CURRENT_PLAY_LOADING=0
    CURRENT_PLAY_IS_LIVE=0
    CURRENT_PLAY_STARTED=0
    CURRENT_PLAY_ADOPTED=0
    # The list reads the whole PT_* triple now — the rail reads PT_PCT to decide
    # live-vs-static, and the banner tail reads PT_CUR/PT_TOTAL — so all three clear here or
    # a stale one keeps drawing a position for a player that no longer exists. PT_CUR is the
    # one that bites: play_selected reaches this through stop_current_playback BEFORE
    # launching the next track, so leaving it set showed the PREVIOUS track's elapsed time in
    # the new track's banner until the first tick overwrote it. Empty is also exactly the
    # "no reading yet" signal the banner falls back on.
    PT_CUR=""
    PT_TOTAL=""
    PT_PCT=""
    PT_POS_SEC=""
    PT_DUR_SEC=""
    # The resource pair clears with them and for the same reason: a footprint drawn for a
    # player that no longer exists. The counter resets so the NEXT player's first tick
    # samples instead of finishing the old player's stride.
    RES_CPU=""
    RES_MEM=""
    RES_TICK=0
    # And the media facts, third in the same argument: a codec line under a row nothing is
    # playing describes a decoder that has exited. fetch_play_times resets them per tick too,
    # but only while it still runs — a stopped player stops the ticks, so the clear has to be
    # here as well or the last reading outlives the process it came from.
    PM_VCODEC=""; PM_W=""; PM_H=""; PM_FPS=""; PM_VBR=""
    PM_ACODEC=""; PM_ABR=""; PM_SR=""; PM_CH=""
}

# The detached player owns its own lifecycle, so ting only learns of its death by asking.
# Nothing used to ask: send_mpv_ipc swallows every failure and mpv_get_prop answers empty on a
# dead socket, so a track that ended (or an mpv crash) left the list banner showing its title
# forever against a stale title, and Space flipping a local paused flag with no IPC peer on
# the far end.
#
# kill -0 is the same truth the core reaps on (ARCH-player.md「运行时 IPC」, "process group alive"), reached from the
# client side: the -d envelope's pid is the bash WRAPPER's, and the wrapper blocks on mpv, so
# wrapper alive ⇔ still playing. One builtin, no fork — cheap enough for the 1 s tick.
# Pid reuse can false-positive it, exactly as ARCHITECTURE.md「风险登记」 records for the core's own group_alive;
# narrowed by the monotonic id, not closed, and not worth a second mechanism in the client.
check_player_alive() {
    [[ -n "$CURRENT_PLAY_ID" ]] || return 0
    # An empty pid is "unknown", not "dead": play_selected requires only id and sock to be
    # non-empty, so clearing on an absent pid would blank a healthy player's chrome.
    [[ -n "$CURRENT_PLAY_PID" ]] || return 0
    # if-form, not `kill -0 … && return 0`: this file has shipped three set -e regressions
    # already, and an `if` is unambiguously safe where an AND-list is only safe by way
    # of an exemption rule.
    if kill -0 "$CURRENT_PLAY_PID" 2>/dev/null; then
        return 0
    fi
    clear_play_state
    return 0
}

# The other half of check_player_alive: alive is not the same as AUDIBLE. mpv answers IPC well
# before it plays a note, so "did the sound start?" needs mpv's own answer — `core-idle` is true
# while the core is producing nothing (loading, seeking, waiting on cache) and flips false the
# moment output begins, which is exactly the edge the banner should turn on. time-pos was the
# other candidate and is worse: it goes non-null when the file is LOADED, so it would call a
# still-buffering stream "Playing" and put the third state back where it started.
#
# The 20 s cap is a promise about the UI, not about mpv: on a stream slow enough to still be
# buffering by then, the honest options are to keep an animated label running forever or to
# fall back to what this showed before the state existed. The cap picks the second, once, and
# the tick stops with it — a spinner that never resolves is worse than an optimistic label.
PS_TICK=0
PLAY_LOAD_CAP=20
player_check_ready() {
    ((CURRENT_PLAY_LOADING)) || return 0
    [[ -n "$CURRENT_PLAY_ID" ]] || { CURRENT_PLAY_LOADING=0; return 0; }
    # One frame per tick: the tick IS the animation clock (read -t 1, the only sub-forever
    # timer bash 3.2 offers — see the fetch spinner), so the frame advances here rather than in
    # the renderer, which can be called more than once per tick (a resize, a redraw after a key).
    PS_TICK=$((PS_TICK + 1))
    local idle now
    idle=$(mpv_get_prop core-idle)
    if [[ "$idle" == "false" ]]; then CURRENT_PLAY_LOADING=0; return 0; fi
    # if-form for the cap, not an AND-list: house rule from char_w — an `if` is unambiguously
    # safe under set -e where an AND-list is safe only by way of an exemption rule. No start
    # stamp means the cap cannot be timed at all, and an untimed loading state would tick once
    # a second forever, so that case gives up the state immediately instead.
    now=$(date +%s 2>/dev/null || echo 0)
    if ((CURRENT_PLAY_STARTED <= 0)); then
        CURRENT_PLAY_LOADING=0
        return 0
    fi
    if ((now - CURRENT_PLAY_STARTED >= PLAY_LOAD_CAP)); then
        CURRENT_PLAY_LOADING=0
    fi
    return 0
}

# THREE states, and the choice of glyph/label/colour lives here rather than at the print
# site. It was written for two views and outlived one of them; the glyph that means "playing"
# still comes in as an argument (▶ for the banner), because the state and the glyph are two
# facts and only one of them is this function's.
#
# This is the ONLY reader of C_PLAY and C_PAUSE, and that is the point: two states, one place
# that says what they look like. The glyph keeps carrying them too (▶ / ❚❚) — the hue is a
# second channel for the same fact, not a replacement, so a colourless session loses nothing.
#
# LOADING stays on the DIM ACCENT rather than taking a third hue. It is not a third state of
# the player, it is the search still finishing — same visual language as the fetch that got us
# here, and dim because it is not steady. A third colour would claim a distinction the palette
# has not got, and there is nowhere in the three-role system it would come from.
PS_ICON=""; PS_LABEL=""; PS_COLOR=""
play_state_marks() {
    if ((CURRENT_PLAY_LOADING)); then
        PS_ICON="${GL_SPIN[PS_TICK % ${#GL_SPIN[@]}]}"
        PS_LABEL="$S_STARTING"
        PS_COLOR="$C_DIM$C_CYAN"
    elif ((CURRENT_PLAY_PAUSED)); then
        PS_ICON="$GL_PAUSE"
        PS_LABEL="$S_PAUSED"
        # NOT dimmed on top of C_PAUSE. The dim was doing the "not the steady state" job back
        # when both states printed the same accent and only the glyph separated them; the hue
        # says it now, and dimming it would mute the one thing that was just added.
        PS_COLOR="$C_PAUSE"
    else
        PS_ICON="$1"
        PS_LABEL="$S_PLAYING"
        PS_COLOR="$C_PLAY"
    fi
}

# A stop that did not happen is SAID, never assumed: the banner stays (the player is still
# running, and the banner is the one thing on screen that says so), the notice names the
# command that stops it, and STOP_LOST_ID carries the id to cleanup_on_exit, which prints the
# same line after the screen is gone — on `q` that line is the only witness there will be.
STOP_LOST_ID=""
stop_current_playback() {
    # Whatever stops the player pays the stop a delete was holding back (undo_forget): Enter
    # on another row, s, q. There is nothing left for it to stop.
    UNDO_STOP_PENDING=0
    if [[ -n "$CURRENT_PLAY_ID" ]]; then
        relocate_tools
        if "$PLAY_BIN" --stop --id "$CURRENT_PLAY_ID" -j >/dev/null 2>&1; then
            STOP_LOST_ID=""
            clear_play_state
        else
            STOP_LOST_ID="$CURRENT_PLAY_ID"
            store_notice "$S_ADOPT_ACT:" "$S_STOP_LOST t-play --stop --id $CURRENT_PLAY_ID"
        fi
    fi
    return 0
}

cleanup_on_exit() {
    cursor_show
    tty_echo_restore
    # The cover goes back with the cursor and the echo, and for the same reason: a self-drawn
    # UI owns the terminal state it changed for the length of the session and hands all of it
    # back from one place. A kitty placement is not in the character grid, so quitting does
    # not remove it and neither does the shell's own clear — this is the only thing that does.
    image_clear
    # And the cover job goes with it. It is a curl and an mpv writing into a cache nobody is
    # going to read now, and leaving them running would outlive the session that started them.
    if [[ -n "$IMAGE_JOB_PID" ]]; then
        kill "$IMAGE_JOB_PID" 2>/dev/null || true
        IMAGE_JOB_PID=""
    fi
    # The other flush point. After the echo is back and before the player goes, so the one
    # line a failed write prints lands on a terminal that is behaving again.
    flush_prefs
    if ((PREF_WRITE_OFF)); then
        # Said twice on purpose: the copy printed at the moment of failure was wiped by the
        # next redraw, and nothing repaints after this one.
        printf '%s %s\n' "$S_PREF_ACT:" "$S_PREF_FAILED"
    fi
    # This process's undo copy goes with it: nothing can press `z` for it now. One store, one
    # call — the slot is suite-wide, so there is never a second copy to look for. A kill -9
    # skips this line, and the store's own sweep of dead owners covers that.
    undo_discard
    # When quitting via Q (detach-quit), preserve the player in background.
    # Otherwise, stop whatever is currently playing so quitting ting cleanly stops the sound.
    if ((QUIT_KEEP_PLAYING)); then
        return 0
    fi
    stop_current_playback
    if [[ -n "$STOP_LOST_ID" ]]; then
        printf 'ting: %s t-play --stop --id %s\n' "$S_STOP_LOST" "$STOP_LOST_ID" >&2
    fi
}
trap cleanup_on_exit EXIT INT TERM HUP

# Page size: default 10, so the FIRST load_rows has a NUM_PAGES to work with. It is only
# provisional: display_list_menu reflows PAGE_SIZE against the chrome it actually measured,
# every redraw (see the reflow block there), before anything reads either value.
term_size; LINES_N=$TERM_LINES
PAGE_SIZE=$PAGE_OPT
# scroll mode's window: the ABSOLUTE index of the first visible row. It is the mode's whole
# state — there is no page number and no page count — and the renderer pulls it to wherever
# the cursor is, never the other way round. It is the only window state published outside the
# renderer in this mode, and page mode publishes only page_index: the one caller that used to
# ask a third variable for "the first visible row" was jump_to_row, and absolute row numbers
# left it with one bound and no window at all.
VIEW_TOP=0
# The visible row the player is on, or -1. Resolved once per redraw ahead of the row loop and
# read inside it; declared here so it is a global by intent rather than by the accident of
# being assigned inside a function.
PLAYING_IDX=-1

# ── Fetch spinner ───────────────────────────────────────────────────────────────────────
# A search is the one moment this TUI has nothing to draw, and a still `searching…` line reads
# as hung — at startup it is the only thing on an otherwise blank terminal. The animation runs
# in a BACKGROUND subshell so fetch_json keeps its plain synchronous shape. Backgrounding the
# SEARCH instead would have cost more than it looks: `kill -0` still succeeds on an unreaped
# child, so the poll would spin forever, and getting the status back would mean an rc file and
# a done-marker for a call that already returns three distinct codes. Nothing else writes to
# the terminal while a fetch is in flight, so there is no interleaving to guard against.
#
# `sleep 0.12` is the timer because bash 3.2 has no other one: `read -t` truncates a fractional
# timeout there (measured — `-t 0.2` sat through a 5 s pipe instead of returning), and 1 s is
# not an animation. It forks ~8 times a second for the length of one fetch; BSD and GNU sleep
# both take decimals. Each frame prints the glyph and backs the cursor onto it, so the next
# frame overwrites in place and the line never grows.
SPIN_PID=""
spin_start() {
    # Echo off for the fetch, and deliberately NOT restored on stop: a key pressed while the
    # search is in flight would otherwise be echoed into the middle of the spinner line. Every
    # caller is on its way into the menu loop, which owns the terminal with echo off anyway.
    tty_echo_off
    cursor_hide
    printf ' '
    ( while :; do
        for f in ${GL_SPIN[@]+"${GL_SPIN[@]}"}; do printf '%s\b' "$f"; sleep 0.12; done
      done ) &
    SPIN_PID=$!
}
# Closes the line the caller opened: erases the frame the subshell left under the cursor, then
# newline, so whatever comes next (a redraw, or report_fetch_failure's sentence) starts clean.
spin_stop() {
    [[ -n "$SPIN_PID" ]] || { printf '\n'; return 0; }
    kill "$SPIN_PID" 2>/dev/null || true
    wait "$SPIN_PID" 2>/dev/null || true
    SPIN_PID=""
    printf ' \n'
}

# ── SEARCH delegate ─────────────────────────────────────────────────────────────────────
SEARCH_ERR=""
# Which engine produced the results currently on screen. Read back from the ENVELOPE rather
# than assumed from $ENGINE, because `engine` is the field whose entire job is routing a
# result to the resolver that can turn it into bytes — using it here means every Enter
# exercises that contract instead of trusting a variable this file set itself. It is a
# per-FETCH fact, not a per-row one (the envelope declares it once), so it needs no room in
# the row format.
CURRENT_ENGINE=""
json=""
fetch_json() {
    local out cnt errfile rc=0
    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-search-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-search-err.$$"
    spin_start
    out=$(engine_verb "$ENGINE" --search -j -n "$RESULT_N" --sort "$SORT_FIELD" ${SEARCH_ARGS[@]+"${SEARCH_ARGS[@]}"} -- "$QUERY_LABEL" 2>"$errfile") || rc=$?
    spin_stop
    SEARCH_ERR=$(<"$errfile")
    rm -f "$errfile"
    # Under -j an engine says WHY on stdout, in the envelope, and what a person can do about
    # it on stderr — one line, and only when there is something to do (the cookie diagnosis;
    # a clean search writes nothing there). A failed search used to reach the screen as a
    # bare "search failed" with both thrown away. Now the reason leads and the advice follows.
    # On SUCCESS the same line is a notice: results that came back without the login the
    # status line promised are the case that most needs saying, and it is the quiet one.
    local note
    note=$(engine_msg "$ENGINE" "$SEARCH_ERR")
    if ((rc != 0)); then
        local why
        why=$(printf '%s' "$out" | jq -r '.reason // empty' 2>/dev/null) || why=""
        if [[ -n "$why" ]]; then SEARCH_ERR="search failed ($why)${note:+: $note}"; fi
        return 1
    fi
    if [[ -n "$note" ]]; then store_notice "$S_SEARCH_ACT:" "$note"; fi
    cnt=$(printf '%s' "$out" | jq -r '.count // 0' 2>/dev/null || echo 0)
    [[ "$cnt" != "0" ]] || return 2
    json="$out"
    CURRENT_ENGINE=$(printf '%s' "$out" | jq -r '.engine // empty' 2>/dev/null) || CURRENT_ENGINE=""
    [[ -n "$CURRENT_ENGINE" ]] || CURRENT_ENGINE="$ENGINE"
    return 0
}

# ONE record per result: six raw fields, no composed display string. The composed string
# was the whole bug — a row was `title · dur · views · channel` elided from the right, so a
# narrow terminal spent the entire truncation budget on the metadata and left a chopped
# title with nothing beside it. Now the row renders title + duration rail, print_details
# renders the rest for the selected row, and apply_filter synthesizes its own haystack.
#
# Joined by US (0x1f), NOT tab: `IFS=$'\t' read` COLLAPSES RUNS OF TABS because tab is an
# IFS *whitespace* character, so one empty field shifts every field after it — and a live
# row has an empty duration_fmt, which is exactly how the mockup came to read a channel
# name as a view count. US is not IFS whitespace, so empty fields survive the split.
# `oneline` on the channel for the same reason `clean` collapses the title: a newline in a
# field would split one record into two.
# How many rows the SOURCE holds, as opposed to how many are on screen: `chapters 7/53` is
# a fact about the item, and NUM_ENTRIES is a fact about the current filter. Set in the two
# builders rather than at each of the six call sites that open a source — a total that is
# assigned by whoever remembers is a total that goes stale on the seventh source.
SOURCE_TOTAL=""
build_all_rows() {
    SOURCE_TOTAL=""
    ALL_ROWS=$(printf '%s' "$json" | jq -r "$JQ_TEXT_DEFS"'
      .engine as $e
      | .results[]
      | [ .url,
          (.title // "" | clean),
          (.duration_fmt // ""),
          (.view_count | if . == null then "" else tostring end),
          (.channel // "?" | oneline),
          (.live_status // ""),
          ($e // ""),
          "",
          (.description // "" | clean),
          "",
          (.thumbnail // "")
        ] | join("\u001f")')
}

# The same ten-field record, built from a PLAYLIST envelope instead of a search one. A
# playlist is engine-agnostic — its items can come from different sources — which is why
# the engine is a per-ROW field rather than one session-wide variable: play_selected reads
# the row's own engine, so a list mixing yt and bili plays either one correctly.
# Channel and view count are deliberately empty: they are not stored (they expire), and an
# empty field renders as absent rather than as a guess. t-playlist derives duration_fmt on
# read, so nothing here formats a duration.
# The eighth field is the row's own RAIL, in display form. Only the chapter table writes one
# (build_chapter_rows, where a row is a span and not a length) — a stored playlist, the log
# and a parts list all leave it absent and get short_dur on the duration, which is what the
# column means for them.
build_playlist_rows() {
    SOURCE_TOTAL=$(printf '%s' "$json" | jq -r '.count // ""' 2>/dev/null) || SOURCE_TOTAL=""
    ALL_ROWS=$(printf '%s' "$json" | jq -r "$JQ_TEXT_DEFS"'
      .items[]
      | [ .url,
          # An item stored without a title (an agent that had only a URL) falls back to the
          # URL rather than to an empty row: a blank line in a list you are steering with
          # arrow keys is unusable, and the URL is language-neutral, so no chrome string.
          (.title // .url // "" | clean),
          (.duration_fmt // ""),
          "",
          "",
          "",
          (.engine // ""),
          (.rail // ""),
          (.description // "" | clean),
          (if .n == null then "" else (.n | tostring) end),
          # ELEVENTH FIELD: preserved thumbnail or synthesized YouTube thumbnail
          # NO APOSTROPHE ANYWHERE IN THIS BLOCK — it is inside a single-quoted jq program.
          (.thumbnail // (.url | yt_thumb) // "")
        ] | join("\u001f")')
}

# The same record again, from a `t-play --queue-show` envelope. Two fields differ from the
# builder above, and both differences are the queue's own shape rather than a new kind of row:
#
#   DURATION arrives as bare seconds, so it is spelled here (fmt_dur) instead of being read
#   out of a `duration_fmt` the player does not publish. After that it is the same string
#   short_dur takes from a playlist, so the column lines up with every other source.
#
#   The TENTH field carries the item's own queue INDEX. Every other source leaves it empty or
#   puts a part/chapter number in it; here it is load-bearing twice over. It is what the
#   renderer compares against `pos` to decide which row is playing — by POSITION, because a
#   queue may hold the same url twice and url identity would then colour whichever copy came
#   first — and it is what every action key sends back as the index to act on, so it has to
#   survive a live filter and a re-sort, which a row's screen position does not.
#
#   SOURCE_TOTAL stays empty: it is read from `.count`, which a queue envelope does not carry,
#   and the rows are not numbered `n/total` in this view anyway.
#   THE PLAYING ROW borrows the title and length the BANNER is showing, when the queue item
#   itself has neither. That is not a second source of truth, it is the same one: a player
#   launched from a bare handle (which is what Enter on a search row does) writes a queue of
#   one with nothing but a url, because at that instant nobody has asked the engine anything
#   yet. The title arrives later, into the PLAYER RECORD — the queue file is written once and
#   never revisited — so `--queue-show` reports a url for a track this screen can name. Until
#   the player backfills its own queue item, the row prints what the line above it prints,
#   rather than a url under a banner holding the title.
build_queue_rows() {
    SOURCE_TOTAL=""
    # The two --arg flags go BEFORE the program and the program stays GLUED to the defs:
    # jq takes the first non-option argument as the filter, so a flag between the two makes
    # the defs the whole program and the filter a filename it cannot open.
    ALL_ROWS=$(printf '%s' "$json" |
      jq -r --arg ptitle "$CURRENT_PLAY_TITLE" --arg pdur "$CURRENT_PLAY_DUR_WIRE" "$JQ_TEXT_DEFS"'
      (.pos // -1) as $p
      | .items[]
      | (if .index == $p then $ptitle else "" end) as $pt
      | (if .index == $p then $pdur else "" end) as $pd
      | [ .url,
          (.title // (if ($pt | length) > 0 then $pt else null end) // .url // "" | clean),
          # The queue publishes bare seconds, so they are spelled here; the fallback is
          # already in the wire spelling, because it came off a row that was built from one.
          (if .duration == null then $pd else (.duration | fmt_dur) end),
          "",
          "",
          "",
          (.engine // ""),
          "",
          "",
          (.index | tostring),
          # NO APOSTROPHE ANYWHERE IN THIS BLOCK — it is inside a single-quoted jq program.
          (.thumbnail // (.url | yt_thumb) // "")
        ] | join("\u001f")')
}

# A handle with any `t=` taken off it, and no fragment: the KEY that says two handles name
# the same item. Both engines read `t=` off a handle into the resolve envelope's
# start_seconds (ARCH-engine.md「起播偏移」), so the same video at two offsets is two urls and
# one item — which is exactly the question Enter asks on a chapter row before it decides
# between a seek and a launch. Written as an anchored walk over the query rather than
# ${var//t=/}: pattern SUBSTITUTION is quadratic on 3.2 (ARCHITECTURE.md「可移植性契约」) and there is none left in this
# file.
HANDLE_KEY=""
handle_key() {
    local url=$1 base query seg out=""
    case "$url" in *\#*) url="${url%%#*}" ;; esac
    base="${url%%\?*}"
    query=""
    case "$url" in *\?*) query="${url#*\?}" ;; esac
    while [[ -n "$query" ]]; do
        seg="${query%%&*}"
        if [[ "$query" == *"&"* ]]; then query="${query#*&}"; else query=""; fi
        case "$seg" in t=* | "") continue ;; esac
        if [[ -n "$out" ]]; then out="$out&$seg"; else out="$seg"; fi
    done
    if [[ -n "$out" ]]; then HANDLE_KEY="$base?$out"; else HANDLE_KEY="$base"; fi
}

# The row url for one chapter: the item's own handle carrying `t=SEC`. This is what makes a
# chapter row a CALL and not a reference — the offset rides in the handle, where both engines
# already read it, so Enter, `+` and `a` inherit it with no new field in the record and no
# new state parallel to the rows (which the live filter would desynchronise anyway). An
# existing `t=` is dropped first: a handle carrying two of them starts wherever the engine's
# parser happens to look.
CHAP_URL=""
chapter_url() {
    local sec=$2
    handle_key "$1"
    case "$HANDLE_KEY" in
    *\?*) CHAP_URL="$HANDLE_KEY&t=$sec" ;;
    *) CHAP_URL="$HANDLE_KEY?t=$sec" ;;
    esac
}

# The seconds a chapter row carries, back out of its own url — the row IS the record, so the
# offset is read from it rather than from an index into ITEM_CHAP_SEC, which the live filter
# and paging would have made point at another chapter.
CHAP_SEC=""
chapter_sec() {
    local u=$1
    CHAP_SEC=""
    case "$u" in *[?\&]t=*) u="${u##*[?\&]t=}" ;; *) return 1 ;; esac
    u="${u%%[&#]*}"
    [[ "$u" =~ ^[0-9]+$ ]] || return 1
    CHAP_SEC="$u"
    return 0
}

# The chapter table as an ENVELOPE (CHAP_JSON), which build_playlist_rows then walks — this
# does not emit rows itself, for two reasons. `a` and `+` cut one item out of `json`
# (focused_payload), so a row source whose json did not match its rows would be a list you can
# play but cannot store; and the caller must be able to fail AFTER this returns without having
# touched ALL_ROWS, the way open_parts reshapes before it stashes. One jq call for the whole
# table, fed US-joined lines — the shape t-playlist and t-play --enqueue already read, and
# the same shape a part list's --items envelope already has.
#
# A CHAPTER IS A SPAN, AND THE RAIL PRINTS IT AS ONE (`2:30 → 5:42`). It used to print the
# start alone, in the same column, the same spelling and the same place a search row prints
# how LONG it is — so the one number on the row changed meaning between two lists that are
# otherwise identical, and nothing said so. A range cannot be read as a duration.
#
# The span is built HERE, as the row's own `rail`, rather than computed at render time from
# the neighbouring row: the live filter and paging reorder what is on screen, so "the next
# row's start" is not this chapter's end. It is the one field in the record that is already
# in display form (the eighth — see load_rows), and that is what it is for: a row may name
# its own rail, and a source that does not carries an empty one and gets short_dur.
#
# `duration` is the chapter's LENGTH, in seconds, and `duration_fmt` is the same number in
# the engine's wire spelling — so the details line, `a` and `+` all get a true duration.
# They used to get the START as the duration: a chapter stored into a playlist came back
# claiming to be 2 minutes 30 long because that is where it began.
#
# An engine that published no `end_time` leaves the span half open (`2:30 →`) and the
# duration absent, rather than guessing: the length of the last chapter is the item's
# duration minus its start, and this view does not read the item's duration.
CHAP_JSON=""
build_chapter_rows() {
    local i n=${#ITEM_CHAP_SEC[@]} sec end len h m ss lines="" out dfmt rail
    local ws=0 we=0
    local starts=() ends=() dfmts=()
    CHAP_JSON=""
    ((n > 0)) || return 1
    # TWO PASSES, because the arrow is a COLUMN. Right-flushing each span on its own aligns
    # the ends and nothing else: `5:42 → 8:00` and `8:00 → 11:32` put their arrows one cell
    # apart, and an hour in puts it four apart, so the eye scanning down the one column that
    # exists to be scanned finds it moving. The rails are therefore all built to the SAME
    # width — each time right-aligned in a field sized over the whole table — and the flush
    # then lands every arrow and every digit on one column. Sizing over the table, not over
    # the page, for the reason the row-number field is sized over NUM_ENTRIES: a column that
    # re-aligns as you page is the same ragged column, discovered later.
    for ((i = 0; i < n; i++)); do
        sec="${ITEM_CHAP_SEC[$i]}"
        end="${ITEM_CHAP_END[$i]:-}"
        disp_clock "$sec"
        starts[$i]="$DISP_CLOCK"
        ((${#DISP_CLOCK} > ws)) && ws=${#DISP_CLOCK}
        ends[$i]=""
        dfmts[$i]=""
        if [[ -n "$end" ]] && ((end > sec)); then
            len=$((end - sec))
            h=$((len / 3600)); m=$(((len % 3600) / 60)); ss=$((len % 60))
            printf -v dfmt '%02dh:%02dm:%02ds' "$h" "$m" "$ss"
            dfmts[$i]="$dfmt"
            disp_clock "$end"
            ends[$i]="$DISP_CLOCK"
            ((${#DISP_CLOCK} > we)) && we=${#DISP_CLOCK}
        fi
    done
    for ((i = 0; i < n; i++)); do
        # An item whose engine published no end at all leaves we at 0, and then the rail is
        # the start and the arrow with no field behind it — a column of trailing blanks would
        # spend cells of the title's budget to show nothing. A table where only SOME chapters
        # have an end still reserves the field: those rows are the ones being aligned to.
        if ((we > 0)); then
            printf -v rail '%*s %s %*s' "$ws" "${starts[$i]}" "$GL_ARROW" "$we" "${ends[$i]}"
        else
            printf -v rail '%*s %s' "$ws" "${starts[$i]}" "$GL_ARROW"
        fi
        len=""
        [[ -n "${ends[$i]}" ]] && len=$(( ITEM_CHAP_END[i] - ITEM_CHAP_SEC[i] ))
        chapter_url "$ITEM_URL" "${ITEM_CHAP_SEC[$i]}"
        printf -v out '%s%s%s%s%s%s%s%s%s%s%s' \
            "$CHAP_URL" "$US" "${ITEM_CHAP_TITLE[$i]}" "$US" "${dfmts[$i]}" "$US" "${len}" \
            "$US" "$rail" "$US" "$((i + 1))"
        lines="$lines$out"$'\n'
    done
    CHAP_JSON=$(printf '%s' "$lines" | jq -Rsc --arg eng "$ITEM_ENGINE" '
        [ split("\n")[] | select(length > 0) | split("\u001f")
          | {url: .[0], title: .[1], duration_fmt: .[2],
             duration: (if .[3] == "" then null else (.[3] | tonumber) end),
             rail: .[4], n: (.[5] | tonumber), engine: $eng} ]
        | {status: "ok", count: length, items: .}' 2>/dev/null) || CHAP_JSON=""
    [[ -n "$CHAP_JSON" ]] || return 1
    return 0
}

apply_search_results() {
    LIST_SOURCE="search"
    build_all_rows
    FILTER_LABEL=""
    FILTER_MODE=0
    selected=0
    page_index=1
    load_rows "$ALL_ROWS"
}

# Split the records into parallel arrays (bash 3.2 — no associative arrays, no array of
# arrays). `urls` keeps its name and its job: the play target. The R_ arrays are the fields
# the row rail and the details block read; nothing here is pre-rendered, so both can render
# from the same numbers and cannot disagree about a row.
load_rows() {
    urls=()
    R_TITLE=(); R_DUR=(); R_VIEWS=(); R_CHAN=(); R_LIVE=(); R_ENGINE=(); R_RAIL=()
    R_DESC=(); R_N=(); R_THUMB=()
    local url title dur views chan live engine rail desc n thumb
    while IFS="$US" read -r url title dur views chan live engine rail desc n thumb; do
        [[ -n "$url" ]] || continue
        urls+=("$url")
        R_TITLE+=("$title")
        R_DUR+=("$dur")
        R_VIEWS+=("$views")
        R_CHAN+=("$chan")
        R_LIVE+=("$live")
        R_ENGINE+=("$engine")
        R_RAIL+=("$rail")
        R_DESC+=("$desc")
        R_N+=("$n")
        R_THUMB+=("$thumb")
    done <<<"$1"
    NUM_ENTRIES=${#urls[@]}
    NUM_PAGES=$(( (NUM_ENTRIES + PAGE_SIZE - 1) / PAGE_SIZE ))
    ((NUM_PAGES > 0)) || NUM_PAGES=1
}

# ── THE VIEW ────────────────────────────────────────────────────────────────────────────
# One renderer. What used to be a second one is a row source (open_chapters), so everything
# below draws rows whatever they came from — a search, a playlist, the log, a video's parts,
# a video's chapters.

# List View: result rows + Now-Playing status banner
display_list_menu() {
    local page=$1 start end i n disp status_extra p row_w rail rail_w iw
    local pfx_w mark mark_w mark_on mark_off num pi pk pstart gcol gut vis th_len th_top vmax
    # One size read per redraw, shared by the banner (title elision), the result rows and the
    # packed navigation hints below. No width cap: unlike the player cards, the list wants the
    # whole width for its rows. LINES_N is refreshed here too — it is what the reflow below
    # divides up, so a resize has to reach it.
    local nav_cols chrome_h=0 right_edge
    layout_cols
    nav_cols=$LAYOUT_COLS
    # THE right edge. Everything on this screen that flushes right — the duration rail,
    # the progress bar, the status segments — lands on this column and derives from this
    # one expression rather than three of its own. Three flushes computed separately is
    # how one of them ends up a cell out and wraps, which is a line of height the reflow
    # does not know about (the plan's I-1).
    #
    # The last column(s) belong to the scrollbar, plus one cell of air. CW_AMBIG_W and not a
    # literal 2: █ and │ are East-Asian AMBIGUOUS, so under TING_AMBIG_WIDE=1 the gutter is
    # genuinely two cells wide and a hardcoded 2 would put the rail on top of it.
    right_edge=$((nav_cols - CW_AMBIG_W - 1))
    LINES_N=$TERM_LINES
    # In-place repaint: home the cursor and let every line
    # below erase its own tail (\033[K), then \033[J at the end wipes whatever the old frame
    # left underneath. This used to be `clear`, which blanks the screen and THEN redraws it —
    # two visible states per frame, so pause/resume (one changed glyph) flashed the whole list.
    # The DCS frame hold hides that on terminals that honour it; under tmux, where it is off by
    # default, nothing did. Erase-as-you-draw has no blank state to see in either case.
    #
    # This did NOT make the redraw incremental, and that is deliberate: a keypress still
    # recomputes and rewrites the whole frame (2413 bytes in 15-24 ms at 100x30 — the same frame
    # an arrow-down writes). What went away is the number of states the terminal shows, not the
    # work. The geometry below is measured per frame rather than fixed, so almost any state
    # change could move it; ARCH-tui.md records why a banner-only repaint for the one change
    # that cannot (pause) was rejected rather than forgotten.
    printf '\033[H'
    # ── The status, as SEGMENTS, built before the title line because it may share it ────
    # It used to be `engine=yt  results=40  sort=view_count  auth=chrome  mode=video
    # (video-enabled)` — a debug dump, and the widest thing on the screen. Every `key=` was
    # naming a field whose VALUE already names itself: nothing but a source is spelled `yt`,
    # nothing but a count is spelled `40 results`, and `mode=video (video-enabled)` said one
    # fact twice in two vocabularies. So the keys go and the values stay, separated by the
    # same GL_SEP the rest of the chrome uses.
    #
    # The values that are NOT self-naming keep one word in front of them, with a space where
    # the `=` was: `volume 40` and `queue 2/5` are readable, a bare `40` and a bare `2/5` are
    # not. That is the line: a segment is a value when the value can stand alone and a short
    # phrase when it cannot — never a field name plus punctuation.
    #
    # The DEFAULTS still cost nothing. min / max / quality / volume / queue appear only when
    # they are off their default, exactly as they did as key=value pairs, for the same reason
    # they did: a field at its default is pure width on the widest line of the chrome.
    if [[ "$PLAY_MODE" == "audio" ]]; then status_extra="$S_MODE_AUDIO"
    elif [[ "$PLAY_MODE" == "fast" ]]; then status_extra="$S_MODE_FAST"
    else status_extra="$S_MODE_VIDEO"; fi
    local st_items st_unit="$S_U_RESULTS"
    case "$LIST_SOURCE" in
    chapters) st_unit="$S_U_CHAP" ;;
    parts) st_unit="$S_PARTS_KEY" ;;
    playlist | history | queue) st_unit="$S_U_ITEMS" ;;
    esac
    # The source leads, for the reason `engine=` did: with more than one installed it is the
    # field that changes what every other segment means.
    if stored_rows; then
        source_seg "${PLAYLIST_ENGINES:-?}"
        st_items=("$SOURCE_SEG" "$NUM_ENTRIES $st_unit")
        # P8, and the only screen it can be said on: the search row a part list was opened
        # from prints the COLLECTION's duration — the only number that endpoint returns —
        # while Enter on that row plays part 1. Neither number is wrong, and nothing on the
        # search screen says they are different numbers. Here they sit one line apart: total=
        # against the per-part durations in the rows below, so the mismatch reads as the
        # structure it is. NOT repeated as "part 1 is 12:06": that row is on screen underneath.
        [[ "$LIST_SOURCE" == "parts" && -n "$PARTS_TOTAL_FMT" ]] && st_items+=("$S_TOTAL $PARTS_TOTAL_FMT")
    else
        local st_sort="$SORT_FIELD"
        case "$SORT_FIELD" in
        relevance) st_sort="$S_SORT_RELEVANCE" ;;
        view_count) st_sort="$S_SORT_VIEWS" ;;
        duration) st_sort="$S_SORT_DUR" ;;
        esac
        source_seg "$ENGINE"
        st_items=("$SOURCE_SEG" "$NUM_ENTRIES $st_unit" "$st_sort")
        # The auth segment sits next to the source because it qualifies it: same source,
        # different capability depending on whether playback will send cookies. It says
        # WHETHER, not which browser — "chrome" as a bare segment names a program, not a
        # state, and which profile the cookies came from is a thing to set, not to read on
        # every frame. Absent when the engine has no --auth. NOT offered on a stored list:
        # those rows mix engines, so one token would be a false statement about half of them.
        if [[ -n "$ENGINE_AUTH" ]]; then
            if [[ "$ENGINE_AUTH" == "anon" ]]; then st_items+=("$S_AUTH_ANON")
            elif [[ "$ENGINE_AUTH" == "blocked" ]]; then st_items+=("$S_AUTH_BLOCKED")
            else st_items+=("$S_AUTH_IN"); fi
        fi
    fi
    # The two fields the `--info` fetch paid for that no row can hold — the upload date and
    # the like count. They describe ONE item, so they are drawn while the cursor is standing
    # on that item's row (info_is_focused) rather than while a chapter list happens to be up.
    # That is the whole of D2: `i` on a row with no chapters opens no view, and the round
    # trip the user just bought must not be thrown away with the view that did not open
    # (ROADMAP.md「横切规范」付了的代价不丢). In a chapter list every row is an offset into
    # that same item, so the predicate is true for all of them and this line reads exactly as
    # it did when the test was on LIST_SOURCE.
    #
    # A date needs no label. A like count does — a bare number beside a bare number
    # ("35 chapters · 1121831") is two counts of nothing in particular.
    if info_is_focused; then
        [[ -n "$ITEM_UPLOADED" ]] && st_items+=("$ITEM_UPLOADED")
        [[ -n "$ITEM_LIKES" ]] && st_items+=("$S_LIKES $ITEM_LIKES")
    fi
    # A bound with its comparator needs no word: >=30s is already a sentence.
    [[ "$MIN_DISP" != "0" ]] && st_items+=("$GL_GE${MIN_DISP}s")
    [[ "$MAX_DISP" != "0" ]] && st_items+=("$GL_LE${MAX_DISP}s")
    st_items+=("$status_extra")
    # quality= follows mode= because the tier is read against it: the engine's table is
    # (mode, tier), and `high` means 1080p next to video and a bitrate next to audio. Absent
    # at `auto` — the same rule min=/max= follow above: a field at its default is pure width,
    # and auto is what every install that has never pressed f is sitting on.
    [[ "$PLAY_QUALITY" != "auto" ]] && st_items+=("$S_QUALITY $PLAY_QUALITY")
    [[ -n "$PLAY_VOLUME" ]] && st_items+=("$S_VOL $PLAY_VOLUME")
    # Same rule again — absent at the default, which is what every install that has never
    # pressed r is sitting on. It rides the status line rather than the banner because this
    # is the segment container that already exists; the banner's right edge is a different
    # budget (ARCH-tui.md「重排与分页」) and a mode is not a fact about the track playing.
    case "$LOOP_MODE" in
    seq) st_items+=("$S_LOOP $S_LOOP_SEQ") ;;
    one) st_items+=("$S_LOOP $S_LOOP_ONE") ;;
    esac
    # The only confirmation `+` has: the queue-ahead block that used to be it went with the
    # card (D-g), and a key whose whole effect is invisible is a key you press twice. Absent
    # below two, by the rule min=/max=/quality= already follow — a queue of one is what every
    # player has.
    ((CURRENT_QUEUE_LEN > 1)) && st_items+=("$S_Q_ACT $CURRENT_QUEUE_POS/$CURRENT_QUEUE_LEN")
    # Where the pagination row went. Only in the mode that HAS pages — in scroll mode the
    # scrollbar says where you are, continuously, and a page number would be a second answer
    # to the same question in a coarser unit. Derived from the selection rather than read
    # from page_index, for the reason the reflow derives it the same way: the cursor is the
    # anchor, and this line is printed before the reflow runs.
    if [[ "$LIST_MODE" == "page" ]] && ((PAGE_SIZE > 0 && NUM_ENTRIES > PAGE_SIZE)); then
        st_items+=("$S_U_PAGE $((selected / PAGE_SIZE + 1))/$(( (NUM_ENTRIES + PAGE_SIZE - 1) / PAGE_SIZE ))")
    fi

    # ── The title line, and the status flushed right onto it when both fit ──────────────
    # Two chrome lines became one: the segments are short enough now to ride the line that
    # already exists, and the line that already exists had a whole right half of nothing.
    # The field NAME stays on the title — `query='chill'` against `playlist='chill'` is the
    # one thing on screen saying where the rows came from, and no segment carries it (a
    # playlist and the log both count in the same word).
    #
    # Flushed with CHA at right_edge, never with computed padding — the width layer
    # over-counts non-ASCII on purpose, and five GL_SEPs are five cells of drift on a
    # Chinese status line. \033[K goes FIRST for the same reason it does on a result row:
    # the jump skips cells without writing them, so a trailing erase leaves the last frame
    # showing through the gap.
    #
    # It falls back to a line of its own rather than eliding: a status the reader has to
    # guess at is worse than one more chrome line, and print_hints already knows how to pack
    # it. The floor is LAYOUT_MIN_FIELD cells of query.
    # TWO strings out of one pass: the one that gets PRINTED (a pill carries its ground) and
    # the one that gets MEASURED (plain text, the only thing disp_w promises to be right
    # about). Building them together is what keeps them from disagreeing about the
    # separators; measuring the printed one instead would count ~20 bytes of SGR as ~20
    # cells and land the right-flush CHA that many columns off.
    local st_line="" st_plain="" st_w=0 st_inline=0 t_head_w q_room st_pill
    for p in ${st_items[@]+"${st_items[@]}"}; do
        st_pill=""
        if [[ "$p" == "$PILL_MARK"* ]]; then
            p=${p#"$PILL_MARK"}
            st_pill=${p%%"$PILL_MARK"*}
            p=${p#*"$PILL_MARK"}
        fi
        if [[ -n "$st_plain" ]]; then
            st_line="$st_line $GL_SEP "
            st_plain="$st_plain $GL_SEP "
        fi
        st_plain="$st_plain$p"
        # The dim is re-armed after the ground closes: the printf below opens the whole
        # status with one C_DIM, and the pill's own \033[0m ends that run as well as its
        # ground. C_ROW_END on the way IN for the mirror reason — dim over the pill's white
        # is grey text on a brand ground.
        if [[ -n "$st_pill" ]]; then
            st_line="$st_line${C_ROW_END}${st_pill}${p}${C_ROW_END}${C_DIM}"
        else
            st_line="$st_line$p"
        fi
    done
    disp_w "$st_plain"; st_w=$DISP_W
    local head_field="query"
    stored_rows && head_field="$LIST_SOURCE"
    disp_w "${GL_NOTE:+$GL_NOTE }$GL_BRAND  $head_field="; t_head_w=$DISP_W
    q_room=$((right_edge - t_head_w))
    if ((q_room - st_w - 2 >= LAYOUT_MIN_FIELD)); then
        st_inline=1
        q_room=$((q_room - st_w - 2))
    fi
    local brand_rendered="$GL_BRAND"
    if [[ "$UI_LANG" == "zh" ]] && ((COLORS_ON)) && ((!ASCII_GLYPHS)); then
        if [[ -n "$CURRENT_PLAY_ID" ]] && ((!CURRENT_PLAY_PAUSED)) && ((!CURRENT_PLAY_LOADING)); then
            brand_rendered="【${C_ROW_END}${C_BOLD}${C_CYAN}${C_ROW_HL} 听 ${C_ROW_END}${C_BOLD}${C_CYAN}】"
        fi
    fi
    truncate_disp "'$QUERY_LABEL'" "$q_room"
    if ((st_inline)); then
        printf '\033[K%s%s%s%s%s  %s=%s\033[%dG%s%s%s\n' \
            "$C_BOLD" "$C_CYAN" "${GL_NOTE:+$GL_NOTE }" "$brand_rendered" "$C_RESET" \
            "$head_field" "$TRUNC_TEXT" \
            $((right_edge - st_w + 1)) "$C_DIM" "$st_line" "$C_RESET"
        chrome_h=$((chrome_h + 1))
    else
        printf '%s%s%s%s%s  %s=%s\033[K\n' "$C_BOLD" "$C_CYAN" "${GL_NOTE:+$GL_NOTE }" "$brand_rendered" "$C_RESET" "$head_field" "$TRUNC_TEXT"
        chrome_h=$((chrome_h + 1))
        # The SAME separator the inline form uses. Two spaces was right when every item
        # carried its own `key=` to bound it; against bare values it reads as one run-on
        # phrase ("yt  40 results  views  signed in  audio"). HINT_SEP is what print_hints
        # measures with as well as prints with, so setting it here cannot make the packer
        # disagree with the line it produced.
        HINT_KEY_COLOR="$C_DIM"
        HINT_SEP=" $GL_SEP "
        print_hints "$nav_cols" "" "" "${st_items[@]}"
        HINT_SEP=""
        HINT_KEY_COLOR=""
        chrome_h=$((chrome_h + HINT_LINES))
    fi
    
    # ── The notice, one line, inside the measured chrome ───────────────────────────────
    # Where a key that could not do what it was pressed for answers: the line under the
    # title, gone by the next keypress (read_nav_input drops it). Charged to chrome_h like
    # every other band member, so the row budget below gives up one row while it is up
    # rather than letting it push the last row off the bottom — the reflow is a chain, and a
    # height decided after the budget is a height the budget did not know about.
    #
    # TRUNCATED, never wrapped: the text can be a line of an engine's stderr, and a wrapped
    # notice is exactly the extra line the measure pass exists to prevent. Bold label, dim
    # text — the two weights the status segments already use, so it reads as chrome and not
    # as a row.
    #
    # THE UNDO OFFER rides the same line, and it is drawn for exactly as long as `z` can act:
    # the offer alone when the line is free, or appended to whatever notice holds it. Appended
    # rather than waiting for a free line, because the frame right after a write is exactly
    # when the line is taken (the write's own words, or S_PL_EMPTY after the last track) and
    # exactly when the user wants the undo. The hint is measured FIRST and never truncated —
    # a title long enough to push `z` off the edge would hide the one part that is a key.
    local n_label="$NOTICE_LABEL" n_text="$NOTICE_TEXT" n_undo=""
    if undo_active; then
        n_undo=" $GL_SEP $S_UNDO_HINT"
        if [[ -z "$n_label" && -z "$n_text" ]]; then
            n_label="$UNDO_HEAD"
            n_text="$UNDO_LABEL"
        fi
    fi
    if [[ -n "$n_label" || -n "$n_text" ]]; then
        local nt_w nu_w=0
        disp_w "$n_label "; nt_w=$DISP_W
        if [[ -n "$n_undo" ]]; then disp_w "$n_undo"; nu_w=$DISP_W; fi
        truncate_disp "$n_text" $((right_edge - nt_w - nu_w))
        printf '\033[K%s%s%s %s%s%s%s\n' \
            "$C_BOLD" "$n_label" "$C_RESET" "$C_DIM" "$TRUNC_TEXT" "$C_RESET" "$n_undo"
        chrome_h=$((chrome_h + 1))
    fi

    # Key navigation hints are measured BEFORE the banner: the banner's inline key tail
    # and this block are ONE job, and two adjacent chrome lines must not both document
    # keys. When this block prints (its gate below passes), the banner stays pure status
    # — one key source per screen, and the playing title gains the tail's ~30 cells; when
    # the gate drops this block on a short terminal, the banner's tail carries
    # Space/s and the volume pair instead. A rail sits UNDER the block (Option B): one boundary
    # between the chrome band (status + banner + keys) and the result rows. It prints only
    # with the block: no keys, no rail.
    #
    # NO LABEL, and GL_SEP between items — a two-space indent and one separator. The label
    # went for the reason nothing else on the band carries one: the
    # keys ARE the content, and its neighbours (the banner above, the rail below) carry no
    # label either, so "Navigation:" was the only thing on the chrome band announcing what
    # the reader could already see. It also cost 12 cells on the widest line here.
    #
    # The PLAYBACK keys cluster at the end, before s/q: -/=, Space and [/] are all handled by
    # the universal case in the menu loop, so they work here exactly as they do in the card,
    # and all three were missing from the one view whose job is to write the keys down. The
    # card's hint block and the banner's short-terminal fallback already documented volume and
    # pause, which is what made their absence here a gap rather than a decision.
    #
    # The seek keys print as "[ ]", NOT "[/]": / is this line's "or" separator (-/=, ↑/↓), but
    # the two keys here ARE brackets, so wrapping a slash in them read as "a bracketed /" and
    # collided with the real / filter entry three items earlier. A space says "two keys" without
    # spending a character that already means something else on this line.
    #
    # S_SEEK is deliberately the bare word for BOTH sites at two different step sizes — the
    # card's arrows seek 5s, these brackets seek 10s. That is why it is no longer called
    # S_SEEK5: the label never named a number, so the only thing the old name did was promise
    # a step size that the second caller does not honour. Still undocumented on purpose: j/k
    # (↓/↑ aliases — you press them because you already have the habit, and the block above
    # them already shows the arrows, so a cell would be a second spelling of a key that is
    # printed) and Esc (a no-op in this view — the way out of a store is the key that opened
    # it, see the BACK section).
    #
    # HINT_SEP is set around the MEASURE call as well as the print call below, never just
    # one: the separator is 3 cells against the default 2, and across 11 gaps that is 11
    # cells — enough to move the block from one line to two. Measuring with a narrower
    # separator than the printer uses is how the reflow underestimates the chrome and lets
    # the header scroll off the top, which is the failure the measure pass exists to prevent.
    local nav_pad="  "
    # The block is built IN ORDER, with each conditional key at its own place, rather than
    # spliced into a finished array by index: an index is a position, so every key added
    # above one moved it, and the comment defending the number was the only thing keeping
    # `e` next to `/ filter`. Order is the same as it ever was — the conditionals just say
    # what they mean where they land.
    local search_view=0
    [[ "$LIST_SOURCE" == "search" ]] && search_view=1
    # TWO TIERS, one block (ARCH-tui.md). `core` is this view's own job — move, act
    # row, change view, filter, quit — and everything else is one press of ? away. The tier
    # is applied cell by cell with keys_full rather than by building a core array and
    # appending a full one, so the ORDER of the full block is byte-identical to the order it
    # has always had: the conditionals still say what they mean where they land.
    # No Tab: there is one view, so the key it toggled has nothing to reach. It is not
    # rebound — an empty key is better than a key spent on whatever was nearest — and it
    # leaves this block by the rule every other key here follows: a key that cannot act must
    # not spend a cell of a measured block.
    local nav_items=()
    local nav_h=0
    local nav_ok=0
    if ! keys_hidden; then
        nav_items+=("$GL_AV	$S_SELECT")
    # ←/→ only in the mode that has pages. In scroll mode they are a silent no-op, and the
    # rule this block has followed since `o` and the store keys — a key that cannot act must
    # not spend a cell of a measured block — does not stop applying because the thing that
    # disabled it is a mode rather than an install. It depends on the LIST MODE and on
    # nothing else; in particular not on the row count, which would turn the reflow's chain
    # into a loop (the plan's I-2).
    [[ "$LIST_MODE" == "page" ]] && nav_items+=("$GL_AH	$S_PAGE")
    # Enter RELABELS in the queue view rather than being printed twice: there it means "play
    # this waiting track now" (a jump within the queue the player is already consuming), not
    # "start a player on this row". One key, one cell, the word that is true where you stand —
    # the same rule the store keys follow when they relabel to the way back.
    if [[ "$LIST_SOURCE" == "queue" ]]; then
        nav_items+=("$GL_ENTER	$S_Q_PLAYNOW")
    else
        nav_items+=("$GL_ENTER	$S_PLAY")
    fi
    # The jump prints next to the arrows rather than with the playback cluster — it is a
    # movement key — and it is `full` because the arrows already say how to move: this is the
    # shortcut, not the way. `Nj` is two cells, one NARROWER than the `0-9` it replaced, so
    # the pair of them still cannot move this block from one line to two on its own.
    keys_full && nav_items+=("Nj	$S_JUMP" "#	$S_ROWNUM" "$GL_TAB	$S_LISTMODE")
    keys_full && nav_items+=("v	$S_MODE" "f	$S_QUALITY" "n	$S_SEARCH")
    # `o` re-sorts the SEARCH and refetches it, so on a store's rows it can only answer
    # "search rows only" (cycle_sort's own first line). A key whose whole effect is a notice
    # saying it does not apply here must not spend a cell of a measured block — the rule
    # `a`/`b`/`d`/`e` already follow off an install, applied to the VIEW instead.
    keys_full && ((search_view)) && nav_items+=("o	$S_SORT")
    nav_items+=("/	$S_FILTER")
    # Core and in every view, because every view can be where the user has just done
    # something they regret: the writes are spread over four row sources and two stores.
    nav_items+=("z	$S_UNDO_KEY")
    # The source key wants BOTH: a second engine installed (on a single-engine install
    # cycle_engine returns immediately) and search rows on screen (it refetches the query,
    # and a playlist is engine-agnostic — its rows route by their own stored engine).
    keys_full && ((search_view)) && ((${#ENGINES[@]} > 1)) && nav_items+=("e	$S_ENGINE")
    keys_full && nav_items+=("l	$S_LANGKEY")
    # `t` is a chrome key like `l`, and it sat in usage() and the README while printing in
    # NEITHER tier — the one key the block never documented. Its own condition is why it is
    # a line of its own: with colors off cycle_theme returns immediately, which is the same
    # "cannot act" the source key and the store keys are gated on.
    keys_full && ((COLORS_ON)) && nav_items+=("t	$S_THEMEKEY")
    keys_full && nav_items+=(
        "-/=	$S_VOL" "Space	$S_PAUSE" "[ ]	$S_SEEK" "r	$S_LOOP" "s	$S_STOP"
    )
    nav_items+=("q	$S_QUIT")
    # Same rule as the source key: a key that cannot do anything must not spend a cell of a
    # measured block. With no t-playlist installed, `a` and `b` genuinely do nothing.
    # A store key RELABELS itself while its own store is on screen, because that is when it
    # does the other half of its job. No extra entry for the way back: a toggle that spent a
    # second cell would be documenting one key twice in a block that is measured.
    # THE WAY BACK IS CORE, the way IN is full — the one place the tier split is not simply
    # "this view's job vs everything else". A relabelled store key is the only exit from the
    # room the user is standing in, and a core block that hid it would leave them there with
    # no printed way out; the same key OPENING that room is a place to go, which is what the
    # full tier is for. Same rule for h and c below.
    if [[ -n "$PLAYLIST_BIN" ]]; then
        if [[ "$LIST_SOURCE" == "playlist" ]]; then
            # d is the one store key that is not offered everywhere, for the same reason `e`
            # is not offered on a single-engine install: it can only act on a row a playlist
            # owns, so anywhere else it would spend a cell of a measured block to say no.
            keys_full && nav_items+=("a	$S_PL_ADD" "d	$S_PL_RM_KEY" "D	$S_PL_DEL_KEY" "R	$S_PL_RENAME_KEY")
            nav_items+=("b	$S_BACK_SEARCH")
        else
            keys_full && nav_items+=("a	$S_PL_ADD" "b	$S_PL_OPEN")
        fi
    fi
    # Same rule again: with no t-history installed, h genuinely does nothing.
    if [[ -n "$HISTORY_BIN" ]]; then
        if [[ "$LIST_SOURCE" == "history" ]]; then
            nav_items+=("h	$S_BACK_SEARCH")
        else
            keys_full && nav_items+=("h	$S_HIST_KEY")
        fi
    fi
    # The same rule a fourth time, off a CAPABILITY and a VIEW: `c` needs the session engine
    # to have --items (a video's parts are its items; on a site where one id is one file the
    # engine answers that the row is not a container) AND search rows to act on
    # (open_parts is search_only: a part belongs to the video a search row names, and the
    # return stack is one deep by decision). The probe was paid at the last source switch,
    # not here: this block runs on every redraw.
    #
    # The way BACK out of the parts view is offered whatever the capability now says: the
    # user is standing in that view, and a key that got them somewhere must document itself
    # from inside it.
    if [[ "$LIST_SOURCE" == "parts" ]]; then
        nav_items+=("c	$S_BACK_SEARCH")
    elif keys_full && ((search_view)) && ((ENGINE_PARTS_OK)); then
        nav_items+=("c	$S_PARTS_KEY")
    fi
    # And a fifth time, off the other capability and the same two conditions `c` carries:
    # `i` needs `--info`, and it replaces the rows, so it needs search rows to come back to
    # (open_chapters is search_only for the reason open_parts is — one stash slot). It
    # relabels from inside its own view exactly as c/b/h do: the way back is CORE, the way in
    # is full.
    if [[ "$LIST_SOURCE" == "chapters" ]]; then
        nav_items+=("i	$S_BACK_SEARCH")
    elif keys_full && ((search_view)) && ((ENGINE_INFO_OK)); then
        nav_items+=("i	$S_CHAP_KEY")
    fi
    # The queue keys are offered only while something is PLAYING: with no player they say
    # "nothing is playing" and nothing else, and a measured block must not spend cells on a
    # key that cannot act (the rule `e` and `a`/`b` already follow).
    if keys_full && [[ -n "$CURRENT_PLAY_ID" ]]; then
        nav_items+=("+	$S_Q_ADD" ">	$S_Q_SKIP")
    fi
    # The queue view, by the same relabelling rule b/h/c/i follow: the way BACK is core (it is
    # the only printed exit from the room the user is standing in), the way IN is full. And
    # the way in is offered only when there is a queue worth opening — with no player, or with
    # a queue of one, `u` can only print a notice, and a measured block does not spend a cell
    # on a key that cannot act (the rule `e` and `d` already follow).
    #
    # The write keys ride in the same block and only from inside the view, which is the only
    # place they do anything. Core rather than full, unlike the store keys they sit beside:
    # they are what this view IS, and a core block that printed only the way out would be
    # describing the queue as something you can look at.
    if [[ "$LIST_SOURCE" == "queue" ]]; then
        nav_items+=("x	$S_Q_RM_KEY" "pP	$S_Q_MV_KEY")
        keys_full && nav_items+=("X	$S_Q_CLEAR_KEY")
        nav_items+=("u	$S_BACK_SEARCH")
    elif keys_full && [[ -n "$CURRENT_PLAY_ID" ]] && ((CURRENT_QUEUE_LEN > 1)); then
        nav_items+=("u	$S_Q_KEY")
    fi
    # The door, and it is in BOTH tiers — it is the one cell that is not about the rows or
    # the player, and a core block without it would be a block with no printed way out of
    # itself. Last, so it reads as the block's own footer rather than one more key.
    nav_items+=("?	$S_KEYS")
    # Measure the block before committing the space: on a very short terminal it is 4 lines of
    # a 10-line screen, and printing it would push the header off the top no matter how the
    # rows are repaged. Then the keys go and the results stay, and the banner's tail picks up
    # the playback keys (see its short-terminal fallback).
    # THREE SPACES, not " $GL_SEP ". The keys wear a ground now (C_KEYCAP), and a ground is
    # already a boundary — a dot between two chips is a separator drawn twice. Air alone
    # groups them, which is what the dot was standing in for. It is a three-cell separator
    # either way, so the block is exactly as tall as it was with dots: measured 3/5 lines in
    # English and 3/4 in Chinese at 100/62 columns, both before and after.
    # The STATUS row keeps its dots: its segments have no ground, so there air alone would
    # read as one run-on phrase (the note where HINT_SEP is set for it).
    # Set around the MEASURE call as well as the print call, the rule this block has always
    # followed: a separator whose width the packer did not know wraps an item early or late.
    HINT_MEASURE=1
    HINT_SEP="$KEYCAP_SEP"
    print_hints "$nav_cols" "$nav_pad" "$nav_pad" "${nav_items[@]}"
    HINT_SEP=""
    HINT_MEASURE=0
    nav_h=$HINT_LINES
    fi
    # LAYOUT_NAV_KEEP is what has to survive below the block. The +1 is a SECOND fact — the
    # PAGINATION row — charged whenever the list can paginate at all: this gate only bites on
    # a short terminal, and on a short terminal more than one entry always means more than
    # one page. Measured without that +1 (and true of the shipped version too, at any width
    # where the block fits in one fewer line than the gate believes): a 62x10 terminal kept
    # the block and then printed 7 chrome lines, one row, a blank and the page counter —
    # eleven lines into ten, and the header went off the top, which is the one thing this
    # reflow exists to prevent.
    local nav_need=$LAYOUT_NAV_KEEP
    ((NUM_ENTRIES > 1)) && nav_need=$((LAYOUT_NAV_KEEP + 1))
    # The banner row counts here whether it prints or stands as a blank (+1). What used to
    # be charged beside it was the RAIL under the key block, which printed whenever the block
    # did; that line is gone. In its place is the progress bar, and the bar is charged on a
    # different condition — it exists only while a track plays, so an idle screen is now one
    # line shorter than it was and a playing one is the same height it always was.
    #
    # Live gets no bar. mpv's clock describes the broadcast, not a length, so there is no
    # denominator to draw against — the same fact the banner encodes by printing
    # "elapsed · LIVE" with no slash. Charged here, before the block is measured, because a
    # height decided after the budget is a height the budget did not know about.
    local bar_h=0
    if [[ -n "$CURRENT_PLAY_ID" ]] && ((CURRENT_PLAY_IS_LIVE == 0)); then bar_h=1; fi
    if ! keys_hidden && ((LINES_N - chrome_h - 1 - bar_h - nav_h >= nav_need)); then nav_ok=1; fi

    # Persistent Now-Playing banner (when background playback is active)
    if [[ -n "$CURRENT_PLAY_ID" ]]; then
        # A status hue, drawn from THIS palette: play and pause take the theme's own green
        # and yellow (see the palette block), so the banner still reads as this theme rather
        # than as a stock green bolted onto it. The glyph says the state too — a turning
        # quadrant while the stream is still coming up. play_state_marks owns both choices.
        play_state_marks "$GL_PLAY"
        local p_icon="$PS_ICON" p_label="$PS_LABEL" p_color="$PS_COLOR"
        # Pure status line: shares ONE line with a variable-length title, so measure the
        # fixed parts and give the title what is left (elided). The key tail appears only
        # when the Navigation block above was dropped (short-terminal fallback).
        local b_head="$p_icon $p_label: "
        # The tail is a POSITION readout, not a duration: elapsed / total, the same pairing
        # the bar on the next line draws, so the two cannot disagree about where the track
        # is — one says how much, the other says where.
        #
        # The banner's status section (bracketed position badge, resource footprint, and
        # fallback hints) is flushed right to right_edge via CHA (\033[%dG), anchoring it
        # to the same column as the duration rail below and the header status segments above.
        # \033[K goes FIRST on the row to erase the gap across frames.
        #
        # PT_CUR/PT_TOTAL come from the shared clock — nav_tick fetches them once a
        # second while the list is up — so the banner costs no IPC of its own and is at most
        # one second stale, the resolution it is drawn at anyway.
        #
        # Empty PT_CUR means NO reading has landed yet (the first frame after Enter, before
        # the first tick) and falls back to the duration alone, rather than printing a bare
        # "/" or an empty field. PT_TOTAL falls back the same way: fetch_play_times seeds it
        # from CURRENT_PLAY_DURATION and only replaces it once mpv answers, so the readout
        # never changes SHAPE a second into playback — it is short_dur and fmt_sec spelling
        # the same number (see CURRENT_PLAY_DURATION's note in play_selected).
        #
        # Live keeps its own form (elapsed, a space, GL_LIVE — no slash): mpv's clock
        # describes the broadcast, not this listen, so there is no total to divide by — the
        # same fact fetch_play_times encodes by returning early for live, and by seeding
        # PT_TOTAL with GL_LIVE rather than a number. The separator inside the brackets goes
        # with it: "00:42 / ● LIVE" reads as a ratio, which is the one thing the pair is not,
        # and the badge is short enough that a space alone divides it.
        local b_tail="${GL_TIME_L}${CURRENT_PLAY_DURATION}${GL_TIME_R}"
        if [[ -n "$PT_CUR" ]]; then
            if ((CURRENT_PLAY_IS_LIVE)); then
                b_tail="${GL_TIME_L}${PT_CUR} ${PT_TOTAL:-$CURRENT_PLAY_DURATION}${GL_TIME_R}"
            else
                b_tail="${GL_TIME_L}${PT_CUR}/${PT_TOTAL:-$CURRENT_PLAY_DURATION}${GL_TIME_R}"
            fi
        fi
        # The player's footprint (TING_RESOURCE): the pair fetch_play_res cached on the same
        # clock the position rode in on, so the field costs the banner no fork of its own.
        # Empty (disabled, or no reading yet) draws nothing rather than a bare label.
        local b_res=""
        [[ -n "$RES_CPU" ]] && b_res=" $GL_SEP $GL_CPU ${RES_CPU}% $GL_RAM ${RES_MEM}M"
        local b_hint=""
        if ((!nav_ok)) && ! keys_hidden; then
            b_hint="  [Space $S_PAUSE | s $S_STOP | -/= $S_VOL]"
        fi
        # Assignment form, not ((head_w += DISP_W)): an arithmetic command evaluating to 0
        # returns status 1, which `set -e` would take as a failure (see char_w).
        disp_w "$b_head"; local head_w=$DISP_W
        disp_w "$b_tail"; local tail_w=$DISP_W
        disp_w "$b_res"; local res_w=$DISP_W
        disp_w "$b_hint"; local hint_w=$DISP_W
        # The three fields are dropped in VALUE ORDER when the width cannot pay for them
        # all, the way the footer below reclaims its lines — and for the same reason: a
        # floor that wins against the width does not save the field, it wraps the row and
        # spends a line the reflow had already given to a result row. The old floor did
        # exactly that: `title_room=8` against fixed parts that already filled the pane put
        # 31 cells on a 30-cell banner, and the header went off the top (measured at 30x24
        # with a track playing).
        #
        # Key tail first: it only exists because the navigation block was dropped, and it is
        # a copy of that block. The FOOTPRINT next — it describes the player's cost, not the
        # track, and nothing else on screen depends on it. Then the POSITION readout — the
        # bar on the very next line carries the same percent, so the row loses a duplicate,
        # not a fact. The title is last because it is the only field that names
        # what is playing; below that there is nothing left to give and it takes the pane
        # minus its own label.
        local gap=2
        local title_room=$((right_edge - head_w - tail_w - res_w - hint_w - gap))
        if ((title_room < LAYOUT_MIN_FIELD)); then
            b_hint=""; hint_w=0
            title_room=$((right_edge - head_w - tail_w - res_w - gap))
        fi
        if ((title_room < LAYOUT_MIN_FIELD)); then
            b_res=""; res_w=0
            title_room=$((right_edge - head_w - tail_w - gap))
        fi
        if ((title_room < LAYOUT_MIN_BUDGET)); then
            b_tail=""; tail_w=0
            gap=0
            title_room=$((right_edge - head_w))
        fi
        # No clamp below zero: truncate_disp's contract already covers a budget that
        # cannot hold anything, and clamping UP to 1 would spend a cell the row has not got.
        truncate_disp "$CURRENT_PLAY_TITLE" "$title_room"
        local b_st="$b_tail$b_res$b_hint"
        local b_st_w=$((tail_w + res_w + hint_w))
        if ((b_st_w > 0)); then
            local st_col=$((right_edge - b_st_w + 1))
            ((st_col < 1)) && st_col=1
            printf '\033[K%s%s %s:%s %s%s%s\033[%dG%s%s%s\n' \
                "$p_color" "$p_icon" "$p_label" "$C_RESET" \
                "$C_CYAN" "$TRUNC_TEXT" "$C_RESET" \
                "$st_col" "$C_DIM" "$b_st" "$C_RESET"
        else
            printf '\033[K%s%s %s:%s %s%s%s\n' \
                "$p_color" "$p_icon" "$p_label" "$C_RESET" \
                "$C_CYAN" "$TRUNC_TEXT" "$C_RESET"
        fi
    fi
    # The banner used to leave a BLANK LINE standing in for itself when nothing was playing,
    # so that starting a track did not shift the list. With the key block moved to the bottom
    # that stand-in became the second of two blank lines in a row — the separator below is
    # the other — and two empty lines above the rows read as a rendering fault, not as air.
    # So the stand-in goes and the separator does its job alone.
    #
    # The cost is named rather than hidden: the list now moves by TWO rows when playback
    # starts (the banner and its bar) instead of by one. That is a shift on a frame which is
    # fully redrawn at that moment anyway, against a blank line that was on screen for the
    # whole of every session where nothing was playing.
    if [[ -n "$CURRENT_PLAY_ID" ]]; then chrome_h=$((chrome_h + 1)); fi

    # ── The progress bar, on a line of its own ──────────────────────────────────────────
    # It used to BE the boundary rail under the key block: one line doing two jobs, full
    # width because a boundary is, and six lines away from the banner whose readout it drew.
    # Now it is a bar AND the one horizontal rule on the screen — which is why it is the only
    # line here that does not respect the row gutter. It used to be indented two cells and cut
    # to right_edge so its ends lined up with the duration rail; that made it read as another
    # FIELD in the list's column grid, one more thing measured against the same margins. A
    # divider is not a field. It runs from column 0 straight past the scrollbar gutter, so the
    # band above it and the rows below it are separated by a line that is visibly wider than
    # either, and no reader has to decide whether its ends mean something.
    #
    # nav_cols - 1, not nav_cols: writing the terminal's LAST column leaves the cursor in the
    # deferred-wrap state, and a terminal that resolves that as a real newline spends a row the
    # reflow never charged for — the same class of fault as a field that measures one cell
    # over. One cell of air on the right costs nothing visually and cannot wrap.
    #
    # This is also what pays for the badge on the banner above: with elapsed/total bracketed up
    # there, the rail carries no numbers at either end and is pure track for its whole length.
    #
    # The first second draws 0% rather than nothing. PT_PCT is empty until the first tick
    # lands, and a line that appeared a second after Enter would push every row down by one
    # at exactly the moment the user is reading them.
    if ((bar_h)); then
        local bar_w=$((nav_cols - 1)) bar_a="" bar_b=""
        # In a chapter list the bar carries a span as well: where the chapter UNDER THE
        # CURSOR sits in the whole item, and how long it is. The cursor's, not the playing
        # one's — the playing chapter is already said by its own row, and a bar repeating it
        # would be the duplication this step exists to remove. So the reading is positional:
        # a span sitting entirely in the light run means "not there yet", entirely in the
        # heavy run means "played", straddling the weight change means "you are in it".
        # The dim carries the same three readings — the light run is also the dim one — so
        # the span reads at a glance on a wide rail where counting glyph weights does not.
        chapter_span "$selected"
        if [[ -n "$CHAP_START_SEC" && -n "$PT_DUR_SEC" ]] && ((PT_DUR_SEC > 0)); then
            bar_a=$(( CHAP_START_SEC * bar_w / PT_DUR_SEC ))
            bar_b=$(( CHAP_END_SEC * bar_w / PT_DUR_SEC - 1 ))
        fi
        render_prog_bar "${PT_PCT:-0}" "$bar_w" "$bar_a" "$bar_b"
        # The remaining run is the accent ONE STEP DOWN, not a second colour and not a
        # colourless gray: same hue, dim on top. The played run carries the accent at full
        # strength, so the seam the weight change already draws is drawn a second time in
        # intensity, and on a rail this wide that is the difference between reading the
        # position and counting the glyphs. C_DIM is empty with colours off and the whole
        # line falls back to the weight change alone — the floor this bar always had.
        printf '%s%s%s%s%s%s\033[K\n' \
            "$C_CYAN" "$PROG_PLAYED" "$C_RESET" \
            "$C_DIM$C_CYAN" "$PROG_REST" "$C_RESET"
        chrome_h=$((chrome_h + 1))
    fi

    # THE KEY BLOCK IS NOT HERE ANY MORE — it prints under the rows, at the very bottom of
    # the frame. Chrome belongs at the EDGES and the middle belongs to the content; what is
    # left at the top is what names the screen and what the player is doing, and everything
    # that is a reference card is at the other end. Its HEIGHT is still charged before a row
    # is printed (the lower band, below), and its CONTENT is still decided here, before the
    # banner — which is what keeps the measurement a chain rather than a loop.
    # NO RAIL HERE. A full-width rule used to close the chrome band, and a second identical
    # one opened the details block below the rows — two rules a screen apart, drawn in the
    # same accent, which is what made a reader look for a difference that was not there. The
    # band is separated by the blank line below, and that is enough: chrome and rows differ
    # in dimming and in position already.
    printf '\033[K\n'
    chrome_h=$((chrome_h + 1))

    # ── Reflow: how many rows fit is MEASURED, not guessed ──────────────────────────────
    # This replaced `PAGE_CAP = LINES_N - 8`, which hardcoded the chrome at 8 lines. The
    # chrome is variable-height by construction: print_hints packs to the terminal width, so
    # the status and navigation blocks take 1-4 lines depending on width and chrome language.
    # The constant is only right at ~72+ columns in English; at 40x20 the real chrome is 11
    # lines, so ten one-line rows plus the footer came to 21 lines in a 20-line terminal and
    # scrolled the header and status row off the top — the same failure one-line rows were
    # meant to end, arriving from the other side. Recomputed every redraw, so a resize or a
    # language switch repages instead of overflowing.
    # The footer below the rows, as separately droppable parts rather than one number: the
    # spacer, the filter's instruction line, the wrapped caret, and the pagination row. Which
    # of them survive is decided by the budget a few lines down — the caret and the pagination
    # row carry state, the other two do not.
    local avail psize row_gap=1 hint_gap=0 filter_hint=0 caret_h=0 foot_h
    if ((FILTER_MODE)); then
        filter_hint=1
        disp_w "> $FILTER_LABEL"
        caret_h=$(( (DISP_W + nav_cols - 1) / nav_cols ))
    fi
    # ── THE LOWER BAND ─────────────────────────────────────────────────────────────────
    # The frame is three bands: an upper one (title, banner, bar, spacer — already counted in
    # chrome_h), the rows, and this. Everything here is charged before a single row is
    # printed, exactly as the upper band is: a band measured after the rows is a band the
    # rows have already spent.
    #
    # The ORDER of the four steps below is what keeps this non-circular, and it is the same
    # chain the details block has always used — written out because the lower band now holds
    # two variable-height members instead of one:
    #
    #   1. clamp the cursor         — needs no window geometry at all
    #   2. measure the block for it — needs the cursor, not the row count
    #   3. derive the row budget from the measured chrome
    #   4. derive the window (page / VIEW_TOP) from the cursor
    #
    # Which is why the key block's CONTENT may depend on the width, the list mode, the row
    # source, the installed engines and the player — and never on the row count. The moment
    # it reads the row count, 1-4 stops being a chain and becomes a loop; and a loop that
    # converges on its first pass at 100x30 is a loop nobody finds until someone resizes.
    ((nav_ok)) && hint_gap=1
    foot_h=$(( row_gap + hint_gap + nav_ok * nav_h + filter_hint + caret_h ))
    # ── The details block is CHROME, and variable-height chrome at that ─────────────────
    # Its height is however far the selected title wraps, so it has to be charged against
    # the row budget before a single row is printed — measure it after the rows and a long
    # title costs the header instead of a row. The order below is what keeps that
    # non-circular: clamp the selection (needs no page geometry), measure the block for it,
    # derive PAGE_SIZE from the measured chrome, then derive the page from the selection.
    # Because the page follows the selection, the row this block describes is always on
    # screen, so the page can never move the selection out from under the measurement and
    # there is nothing to settle over multiple frames. PAGE_SIZE therefore changes by one as
    # the selection crosses a one-line/three-line title — the accepted cost of decision 1
    # (the block takes the space it needs; no fixed reservation, no cap on the title).
    ((selected < 0)) && selected=0
    ((NUM_ENTRIES > 0 && selected > NUM_ENTRIES - 1)) && selected=$((NUM_ENTRIES - 1))
    local detail_h=0 show_details=0 detail_w=$nav_cols
    # ── The cover's budget gate, struck BEFORE the detail block is measured ─────────────
    # A cover pins detail_h to 7 rows whether or not this row has one, and in `scroll` mode
    # those rows come straight out of the LIST — 19 rows become 15 at 100x30. So the gate
    # asks the list's question first: after paying 7 rows, are there still 10 to browse? Ten
    # is TING_PAGE_ROWS's shipped value, which is this file's existing answer to "enough list".
    # Under either floor the answer is no cover at all — never a smaller one, because a
    # smaller one means a second transcode target and a second layout to keep in step.
    #
    # It is decided HERE, before print_details is measured, because the detail text wraps to
    # a narrower width when the gate is open: measuring at one width and printing at another
    # is how a block comes to be a different height than the budget was told.
    IMAGE_GATE=0
    if ((IMAGE_ON && NUM_ENTRIES > 0)); then
        # The text's width is derived from right_edge, not from nav_cols, for the reason
        # every other flush on this screen is: right_edge is THE right edge, and the cover is
        # flushed to it so its edge and the duration rail's are one column. One blank column
        # between the text and the picture, so the two never touch at any width.
        detail_w=$((right_edge - IMAGE_BOX_COLS - 1))
        if ((detail_w >= IMAGE_MIN_TEXT_COLS &&
             LINES_N - chrome_h - foot_h - LAYOUT_CURSOR_ROW - IMAGE_BOX_ROWS >= IMAGE_MIN_ROWS)); then
            IMAGE_GATE=1
        else
            detail_w=$nav_cols
        fi
    fi
    if ((NUM_ENTRIES > 0)); then
        DETAIL_MEASURE=1
        print_details "$detail_w" "$selected"
        DETAIL_MEASURE=0
        detail_h=$DETAIL_LINES
        # THE COVER IS CHARGED WHETHER OR NOT THIS ROW HAS ONE. The block is 7 rows tall the
        # moment the gate is open, so a row with no cover leaves the gutter blank instead of
        # changing the layout — otherwise every arrow keypress that crossed from a row with a
        # cover to a row without one would reflow the list and the text's wrap width at once.
        ((IMAGE_GATE)) && detail_h=$IMAGE_BOX_ROWS
        # A terminal too short to pay for both drops the block and keeps the rows — the same
        # trade the navigation hints make above, and the reason "no cap on the title" is
        # safe. What has to survive underneath it is LAYOUT_DETAIL_KEEP.
        if ((LINES_N - chrome_h - foot_h - LAYOUT_CURSOR_ROW - detail_h >= LAYOUT_DETAIL_KEEP)); then
            show_details=1
        else
            detail_h=0
            IMAGE_GATE=0
        fi
    fi
    # LAYOUT_CURSOR_ROW is charged here and by every other budget that ends in rows.
    avail=$((LINES_N - chrome_h - foot_h - detail_h - LAYOUT_CURSOR_ROW))
    # ── The floor conflict: a budget of zero rows against a `psize` floor of one ────────
    # Every other block here can drop itself when the terminal is too short — the navigation
    # hints do, the details block does. The ROWS cannot: a list with no rows is not a list, so
    # `psize` has a hard floor of 1 further down. That floor used to win against a budget of
    # zero and the frame came out one line too tall, which scrolls the header off the top —
    # the exact failure the reflow exists to prevent, arriving from underneath. Measured at
    # 62x12 with `/` open: chrome 8 + spacer 1 + hint 1 + caret 1 + a page row 1 + one row = 13
    # lines in a 12-row pane, and the title row went.
    #
    # So when the budget cannot pay for the rows the list owes, reclaim from the footer in
    # value order — the spacer carries nothing, the filter hint teaches a mode the caret below
    # it already shows, the pagination row is real state and goes last, and the caret itself is
    # never dropped (it echoes what the user is typing). Only when there is nothing left to
    # drop does the floor overflow, and then it is honest: no arrangement of that terminal
    # shows a header, a row and a caret at once.
    #
    # Reclaimed in VALUE order, and the two blank separators go first because a separator
    # carries nothing — it only says that two things differ, which their content already
    # says. Then the filter's instruction line, which teaches a mode the caret beneath it is
    # demonstrating. The KEY BLOCK is not reclaimed here: its own gate decided it further up,
    # from the terminal's height and the block's own packed height, before the banner printed
    # and therefore before anything could depend on the row count. The caret is never
    # dropped — it echoes what the user is typing.
    while ((avail < 1)); do
        if ((row_gap)); then row_gap=0
        elif ((hint_gap)); then hint_gap=0
        elif ((filter_hint)); then filter_hint=0
        else break
        fi
        foot_h=$(( row_gap + hint_gap + nav_ok * nav_h + filter_hint + caret_h ))
        avail=$((LINES_N - chrome_h - foot_h - detail_h - LAYOUT_CURSOR_ROW))
    done
    # ONE AXIS PER MODE. In `page` the row count is TING_PAGE_ROWS pressed down to fit; in
    # `scroll` it is simply what fits, because a continuous window that stopped at a shipped
    # ceiling of 10 would be a window with a page size — the two facts the mode split exists
    # to separate. TING_PAGE_ROWS therefore does not change meaning so much as narrow: it is
    # page mode's ceiling, and its comment in `config` is true word for word about that mode.
    if [[ "$LIST_MODE" == "scroll" ]]; then
        psize=$avail
    else
        psize=$PAGE_OPT
        ((psize > avail)) && psize=$avail
    fi
    ((psize < 1)) && psize=1
    PAGE_SIZE=$psize
    ((selected < 0)) && selected=0
    ((NUM_ENTRIES > 0 && selected > NUM_ENTRIES - 1)) && selected=$((NUM_ENTRIES - 1))
    ((selected < 0)) && selected=0
    if [[ "$LIST_MODE" == "scroll" ]]; then
        # No pages at all here, and NUM_PAGES=1 says so to everything downstream rather than
        # being a second thing to keep in step. The window is pulled to the CURSOR — the
        # cursor is the user's and the window follows it, never the reverse — and then held
        # inside the list so the last screenful cannot show blank rows below the end.
        NUM_PAGES=1
        page=1
        vmax=$((NUM_ENTRIES - PAGE_SIZE))
        ((vmax < 0)) && vmax=0
        ((VIEW_TOP > vmax)) && VIEW_TOP=$vmax
        ((VIEW_TOP < 0)) && VIEW_TOP=0
        ((selected < VIEW_TOP)) && VIEW_TOP=$selected
        ((selected > VIEW_TOP + PAGE_SIZE - 1)) && VIEW_TOP=$((selected - PAGE_SIZE + 1))
        ((VIEW_TOP < 0)) && VIEW_TOP=0
        start=$VIEW_TOP
    else
        NUM_PAGES=$(( (NUM_ENTRIES + PAGE_SIZE - 1) / PAGE_SIZE ))
        ((NUM_PAGES > 0)) || NUM_PAGES=1
        # Across a repage the SELECTION is the anchor, not the page number: the user is
        # looking at a row. Deriving the page from `selected` keeps that row on screen —
        # clamping the selection into the old page number instead teleports it (measured:
        # resizing 24 -> 12 rows dropped the page from 10 entries to 2, and the selection on
        # row 15 snapped back to row 4, page 2's new window). It is the same anchor Tab uses
        # to cross between the modes, which is why neither mode has to remember the other's
        # position: both are derived from the row the user is looking at.
        page=$(( selected / PAGE_SIZE + 1 ))
        ((page > NUM_PAGES)) && page=$NUM_PAGES
        ((page < 1)) && page=1
        start=$(( (page - 1) * PAGE_SIZE ))
    fi
    # Handed back to the menu loop, which reads it on the next iteration: the renderer owns
    # the window geometry in both modes, and the page number is the half of it anything
    # outside this function still asks for.
    page_index=$page
    end=$(( start + PAGE_SIZE - 1 ))
    if ((NUM_ENTRIES > 0)); then
        ((selected < start)) && selected=$start
        ((selected > end)) && selected=$end
        ((selected > NUM_ENTRIES - 1)) && selected=$((NUM_ENTRIES - 1))
        ((selected < 0)) && selected=0
    fi

    # Result rows
    if ((NUM_ENTRIES == 0)); then
        # ONE empty line for every row source (ARCH-tui.md「一条提示是帧的内容，不是一次停顿」):
        # an empty playlist, a log with nothing in it, a filter that matched nothing, a first
        # search that did. So it names the keys that answer from ALL of them, in the order a
        # stuck user would try them. It used to name the filter alone — which told a mistyped
        # first search to "change filter" when no filter had ever been open.
        # THREE ENTRIES AND A GLYPH BETWEEN THEM, never one string with dots baked in: a
        # literal · outlives TING_ASCII=1, which is the one thing the glyph table exists to
        # prevent — the same rule that keeps GL_DASH out of S_NO_MATCH.
        truncate_disp "$S_NO_MATCH $GL_DASH $S_NO_MATCH_NEW $GL_SEP $S_NO_MATCH_FILT $GL_SEP $S_NO_MATCH_SRC" "$nav_cols"
        printf '%s%s%s\033[K\n' "$C_DIM" "$TRUNC_TEXT" "$C_RESET"
    else
        # The marker gets its own 2-cell slot in front of the row — the cursor glyph where
        # the cursor is, two spaces everywhere else — and the number, when it is on, is not
        # the selection's to take: it is what the user types to reach a row (`12j`),
        # and blanking it on the row under the cursor removes the one label saying which row
        # that is.
        #
        # The numbers are OFF by default and `#` toggles them. Most of the time the cursor
        # is the answer to "which row", and a right-aligned column of ordinals on every line
        # is chrome charged to every row to serve the one press in ten that jumps. The keys
        # do NOT depend on the toggle: `Nj` jumps whether or not the number is drawn, because
        # a key whose meaning followed a display state would be a second keymap wearing this
        # one's clothes — which is also why typing a digit does not switch the column on for
        # you. What the toggle decides is whether the address is VISIBLE: the number is an
        # absolute one, so with the column off it can only be counted on the first screenful.
        #
        # What the field fixes is alignment, not content. The prefixes used to be per-row
        # literals ("> 1. " / "  1. "), so their width was 4 + <digits> and a page that
        # reached two digits started every 1-digit title one cell left of the rows around it —
        # ragged in the one column the eye scans down. Now the number is right-aligned in a
        # fixed sub-field of iw - mark_w cells (digits of the largest index + 1 for the dot),
        # the marker slot is mark_w, and one space separates the field from the title, so
        # iw + 1 cells of prefix on every row whatever the page. Width comes from NUM_ENTRIES,
        # not from the page, so it does not move as you page.
        #
        # THE MARKER SLOT IS MEASURED, NOT ASSUMED. It was the literal 2, from when the marker
        # was ASCII-safe by luck; ▎ is East-Asian Ambiguous, so under TING_AMBIG_WIDE=1 it draws
        # two cells and a hardcoded slot would start the cursor row's title one cell right of
        # every other row's — ragged on the one column the eye scans down, and on the single
        # row the reader is looking at. Asking the width layer costs one disp_w per redraw (a
        # one-character string, not per row) and is exact in every mode: CW_AMBIG_W + 1 for ▎,
        # and still 2 for the ASCII ">" under TING_ASCII=1, which a CW_AMBIG_W + 1 written out
        # by hand would have got wrong. Both prefixes are built from it here, once, so the
        # filled slot and the empty one cannot disagree about how wide the column is.
        disp_w "$GL_CURSOR"; mark_w=$((DISP_W + 1))
        printf -v mark_on '%s%*s' "$GL_CURSOR" $((mark_w - DISP_W)) ''
        printf -v mark_off '%*s' "$mark_w" ''
        iw=$(( ${#NUM_ENTRIES} + 1 + mark_w ))
        # The prefix's real width: the cursor slot, plus the number field and its one
        # separating space only when the numbers are on. One expression, used both to size
        # the title and to lay the prefix out, so the two cannot drift.
        pfx_w=$mark_w
        ((ROW_INDEX)) && pfx_w=$((iw + 1))
        # ── The scrollbar, one cell per visible row in the last column ───────────────────
        # It is in BOTH modes, because both have a window and neither had any continuous way
        # to say where that window sits: page mode had ●○○○, which quantised the answer to a
        # page and gave up past twelve of them, and scroll mode would have had nothing at all.
        # A thumb sized to the fraction on screen says both facts — where, and how much — on
        # every row, in one column, with no line of its own.
        #
        # Rounded, not truncated (+ NUM_ENTRIES/2 before the divide): a truncating thumb never
        # reaches the bottom of the track, so the last screenful of a list reads as "nearly
        # there" forever. Floor of one cell, and clamped inside the track, so a very long list
        # still shows a thumb and it never runs off the end.
        gcol=$((nav_cols - CW_AMBIG_W + 1))
        vis=$((end - start + 1))
        ((vis > NUM_ENTRIES - start)) && vis=$((NUM_ENTRIES - start))
        th_len=0
        th_top=0
        if ((NUM_ENTRIES > vis && vis > 0)); then
            th_len=$(( (vis * vis + NUM_ENTRIES / 2) / NUM_ENTRIES ))
            ((th_len < 1)) && th_len=1
            th_top=$(( (vis * start + NUM_ENTRIES / 2) / NUM_ENTRIES ))
            ((th_top > vis - th_len)) && th_top=$((vis - th_len))
            ((th_top < 0)) && th_top=0
        fi
        # ── Which visible row the PLAYER is on, resolved once per redraw ─────────────────
        # Once, not per row: bash 3.2 has no associative array, so the obvious spelling is a
        # parallel-array scan inside the row loop — and one CJK keypress is three byte-reads,
        # which is three redraws, which would be three scans per character typed.
        #
        # By URL, not by index. "The row that is playing" has to stay true across a re-sort
        # (o), a live filter (/), a resize and a page turn, and the index changes under all
        # four while the url does not. handle_key is the same normaliser play_chapter asks
        # with, so "the player holds this row" is decided in one vocabulary.
        PLAYING_IDX=-1
        if [[ -n "$CURRENT_PLAY_ID" && -n "$CURRENT_PLAY_URL" ]]; then
            handle_key "$CURRENT_PLAY_URL"; pk="$HANDLE_KEY"
            if [[ "$LIST_SOURCE" == "chapters" ]]; then
                # A chapter row's url ends `&t=<seconds>`, so it can NEVER equal the item url
                # the player holds — the playing chapter is the one the playhead is inside.
                # The span is found once over the item's own chapter table (ordered, the
                # engine's) and then matched against the rows (unordered, the filter's),
                # rather than asking chapter_span per row: that would be a scan of the table
                # for every visible row, on every redraw.
                pstart=""
                handle_key "${urls[$start]}"
                if [[ -n "$PT_POS_SEC" && "$pk" == "$HANDLE_KEY" ]] && ((CURRENT_PLAY_IS_LIVE == 0)); then
                    for (( pi = 0; pi < ITEM_CHAP_N; pi++ )); do
                        [[ -n "${ITEM_CHAP_END[$pi]:-}" ]] || continue
                        if ((PT_POS_SEC >= ITEM_CHAP_SEC[pi] && PT_POS_SEC < ITEM_CHAP_END[pi])); then
                            pstart="${ITEM_CHAP_SEC[$pi]}"
                            break
                        fi
                    done
                fi
                if [[ -n "$pstart" ]]; then
                    for (( pi = start; pi <= end && pi < NUM_ENTRIES; pi++ )); do
                        chapter_sec "${urls[$pi]}" || continue
                        if [[ "$CHAP_SEC" == "$pstart" ]]; then PLAYING_IDX=$pi; break; fi
                    done
                fi
            elif [[ "$LIST_SOURCE" == "queue" ]]; then
                # The queue answers this by POSITION, and it is the one row source that must.
                # A queue can hold the same url twice — `+` pressed twice on one row, or a
                # playlist that already had it twice — and then the url walk below colours
                # whichever copy comes first, which is not necessarily the one playing. In
                # every other source that is a distinction without a difference; here the
                # colour would be pointing at a track that already finished while the cursor
                # sits on the one being heard, and this view prints no PLAY column to correct
                # it. `pos` is the player's own answer and it is never ambiguous.
                #
                # Against the row's OWN index (R_N), never against its screen position: `/`
                # is not gated by row source, and one keystroke of filter makes row N stop
                # being item N. Cheaper than what it replaces, too — an integer compare per
                # visible row instead of a url normalisation.
                for (( pi = start; pi <= end && pi < NUM_ENTRIES; pi++ )); do
                    if [[ "${R_N[$pi]:-}" == "$CURRENT_QUEUE_POS" ]]; then PLAYING_IDX=$pi; break; fi
                done
            else
                for (( pi = start; pi <= end && pi < NUM_ENTRIES; pi++ )); do
                    [[ "${R_ENGINE[$pi]:-}" == "$CURRENT_PLAY_ENGINE" ]] || continue
                    handle_key "${urls[$pi]}"
                    if [[ -n "$pk" && "$pk" == "$HANDLE_KEY" ]]; then PLAYING_IDX=$pi; break; fi
                done
            fi
        fi
        for (( i = start; i <= end && i < NUM_ENTRIES; i++ )); do
            n=$(( i + 1 ))
            # A row is a TITLE and a duration rail — nothing else. It used to be
            # `title · duration · views · channel` composed into one string and elided from
            # the right, which spent the whole truncation budget on the metadata: at 62
            # columns the ellipsis ate duration, views and channel first and left a chopped
            # title with no metadata beside it. Views and channel moved to print_details.
            # The rail prints a bare LIVE rather than the "● LIVE" badge: this is a numeric
            # column, and a glyph in it reads as noise (the badge form is in the details).
            # A row may name its own rail (the chapter span, `2:30 → 5:42`), and then the
            # column is that string: a chapter is not a length, and printing its start in
            # the place a search row prints its duration is the one number on the screen
            # that changed meaning without saying so. Everything else formats its duration.
            if [[ -n "${R_RAIL[$i]}" ]]; then
                rail="${R_RAIL[$i]}"
            elif [[ "${R_LIVE[$i]}" == "is_live" ]]; then
                rail="LIVE"
            else
                short_dur "${R_DUR[$i]}"
                rail="$SHORT_DUR"
            fi
            disp_w "$rail"
            rail_w=$DISP_W
            # The index field is iw cells plus one separating space; 2 more keep the longest
            # title off the rail. Truncating to that is what gives the rail room BY
            # CONSTRUCTION — the jump below only repairs measurement drift, it does not
            # license overflow.
            row_w=$(( right_edge - pfx_w - 2 - rail_w ))
            ((row_w < LAYOUT_MIN_BUDGET)) && row_w=$LAYOUT_MIN_BUDGET
            truncate_disp "${R_TITLE[$i]}" "$row_w"
            disp="$TRUNC_TEXT"
            # The rail is placed with CHA (\033[<n>G, cursor horizontal absolute), NOT with
            # computed padding. Padding emits `room - DISP_W` spaces, so the column lands
            # wherever OUR measurement says it should — and our width rule over-counts by
            # design (a non-ASCII character is two cells unless measured otherwise), so a
            # title of mathematical-bold letters (2 measured, 1 drawn) parks its duration
            # ~5 columns left of the row above it. Ragged, on the one column that exists to
            # be scanned. CHA ignores what came before and lands on the same cell every
            # time. Columns are 1-based, so a right-flush field of rail_w cells starts at
            # right_edge - rail_w + 1. If a title ever rendered WIDER than measured, the jump
            # moves backwards and cleanly overwrites the title tail instead of pushing the
            # rail into a wrap — the failure mode we want, and one the width layer's
            # over-counting rule already refuses to produce.
            # \033[K goes FIRST on a row, not last: the rail is placed with CHA, which jumps
            # over the cells between the title and the rail without writing them, so a
            # trailing erase would leave the previous frame's longer title showing through the
            # gap. Erasing the line before drawing it is the only order that covers a hole the
            # draw itself never touches.
            # ── The prefix, built once for all three forms below ──────────────────────
            # The cursor slot is mark_w cells whether it is filled or not, so the title
            # column never moves; the number field is the part that can vanish.
            mark="$mark_off"
            ((i == selected)) && mark="$mark_on"
            num=""
            ((ROW_INDEX)) && printf -v num '%*s ' $((iw - mark_w)) "$n."
            # ── The PLAYING row: ground first, then the jump ──────────────────────────
            # The order is the whole trick. \033[K after the title, with the reverse
            # attribute already set, is a back-colour erase: it carries the ground across the
            # cells CHA is about to jump over. Set the ground after the jump instead and the
            # row has a hole in the middle of it — the gap between the title and the rail,
            # which is most of the line.
            #
            # NOT a computed run of spaces. That is the same trap the rail's CHA exists to
            # avoid: the width layer over-counts non-ASCII on purpose, so a padded ground
            # would end where our measurement says the title ended rather than where the
            # terminal actually drew it — ragged on every row with CJK or a maths-bold title.
            #
            # A row that is playing AND under the cursor takes both: the ▶ and bold say
            # cursor, the ground says playing. The accent HUE is dropped there and only
            # there — a reversed accent is a colour on a colour, and the two facts are
            # already separately legible without it.
            # This row's cell of the scrollbar. Drawn OUTSIDE the playing row's ground, after
            # its reset: reversed, the thumb is a hole rather than a block, so a full-width
            # ground would erase the scrollbar on exactly the row a user is most likely to be
            # looking at. The ground still runs under the cell of air before it, which reads
            # as the highlight ending where the list ends and the chrome begins.
            gut="$GL_BAR_TRACK"
            ((th_len > 0 && i - start >= th_top && i - start < th_top + th_len)) &&
                gut="$GL_BAR_THUMB"
            if ((i == PLAYING_IDX)); then
                printf '\033[K%s%s%s%s%s\033[K\033[%dG%s%s\033[%dG%s%s%s\n' \
                    "$C_ROW_HL" "$mark" "$num" "$C_BOLD" "$disp" \
                    $((right_edge - rail_w + 1)) "$rail" "$C_ROW_END" \
                    "$gcol" "$C_DIM" "$gut" "$C_RESET"
            elif ((i == selected)); then
                # Marker AND number in C_MARK (accent), title in bold, rail back to its own
                # dim — the selected line no longer inherits one hue end-to-end.
                printf '\033[K%s%s%s%s%s%s%s\033[%dG%s%s\033[%dG%s%s\n' \
                    "$C_MARK" "$mark" "$num" "$C_RESET" "$C_BOLD" "$disp" "$C_RESET" \
                    $((right_edge - rail_w + 1)) "$C_DIM" "$rail" \
                    "$gcol" "$gut" "$C_RESET"
            else
                printf '\033[K%s%s%s%s\033[%dG%s\033[%dG%s%s\n' \
                    "$mark" "$num" "$disp" "$C_DIM" \
                    $((right_edge - rail_w + 1)) "$rail" \
                    "$gcol" "$gut" "$C_RESET"
            fi
        done
    fi
    # Spacer, unless the reflow above spent it on a result row.
    ((row_gap)) && printf '\033[K\n'

    # NO PAGINATION ROW. `●○○○` was a whole line spent on one number, it could not survive
    # more than twelve pages without falling back to text anyway, and it says nothing at all
    # in scroll mode, which has no pages. The number moved into the status segments, where it
    # costs no line and appears only in the mode that has one; where you are in the list is
    # now said continuously, by the scrollbar in the gutter.

    # Details for the selected row, in its own section under the rows — and, when the gate
    # above is open, the focused row's cover in the gutter to its right.
    #
    # THE COVER IS EMITTED FIRST, at the cursor's own row, which is the detail block's first
    # line: a kitty placement lands where the cursor is, so nothing here needs to know its
    # absolute row number — the one thing this frame cannot compute without duplicating the
    # whole budget. `C=1` leaves the cursor untouched, so the text below prints exactly as it
    # did before; and because a placement is not in the character grid, the \033[K each of
    # those lines ends with erases the cells UNDER it without touching the picture.
    #
    # The old placement is deleted the moment this frame draws anything ELSE, including
    # nothing at all — the gate closed on a resize, the row has no cover, the terminal got
    # too small. Nothing else removes it: \033[J does not. What it is NOT deleted for is a
    # frame that would only put it back unchanged, which is every frame the one-second clock
    # draws while a track plays; image_place is where that is decided.
    # NOT DRAWING MEANS NOT WANTING, and the dirty bit has to be told. It is raised by
    # image_focus, which only runs when the gate is open — so a frame that closes the gate
    # (the terminal got short, TING_IMAGE went off) would leave a 1 behind, and that 1 arms the
    # one-second clock in read_nav_input for the rest of the session: a wake-up per second,
    # each one starting a fetch for a cover no frame is going to draw.
    #
    # AND THE MEMO GOES WITH IT. image_focus is keyed on the row's url and returns early
    # when it has already answered for that row — so a gate that closes and reopens on the
    # SAME row would never ask again, and whatever the closed frames left behind is what the
    # row keeps. That is a stranded cover, not a missing one: resize small while the first
    # fetch is still running and back again, and the row shows nothing for the rest of the
    # session because IMAGE_DIRTY was cleared here while IMAGE_PNG was still empty, and the
    # memo says the question is settled. Measured 2026-09-03 at 100x30 through 62x20 and
    # 26x24 and back: twelve seconds of ticks, no cover, and the bytes already in the cache.
    # Clearing the key costs one glob on the frame that reopens the gate and nothing on any
    # other — image_focus is not called at all while it is shut.
    ((IMAGE_GATE)) || { IMAGE_DIRTY=0; IMAGE_KEY_URL=""; }
    if ((show_details)); then
        if ((IMAGE_GATE)); then
            image_focus "${R_THUMB[$selected]:-}"
            # chrome_h + vis + row_gap is what this frame has printed above this line, and
            # so the row the placement lands on. It is passed for the COMPARISON only —
            # see image_place; the cursor is still what puts the picture anywhere.
            image_place "$right_edge" $((chrome_h + ${vis:-0} + row_gap))
            print_details "$detail_w" "$selected"
            # Pad to the cover's full height so the blocks below start where the budget said
            # they would. DETAIL_LINES is what print_details actually printed.
            while ((DETAIL_LINES < IMAGE_BOX_ROWS)); do
                printf '\033[K\n'
                DETAIL_LINES=$((DETAIL_LINES + 1))
            done
            if [[ -z "$IMAGE_PNG" && -n "${R_THUMB[$selected]:-}" && "${R_THUMB[$selected]:-}" != "$IMAGE_FAIL_URL" ]]; then
                image_status "$right_edge"
            fi
        else
            image_clear
            print_details "$nav_cols" "$selected"
        fi
    else
        image_clear
    fi

    # ── The key block, at the bottom of the frame ──────────────────────────────────────
    # Its height was charged in the lower band, its content was decided before the banner
    # printed, and neither depended on how many rows there turned out to be. All that is
    # left here is the printing.
    if ((nav_ok)); then
        ((hint_gap)) && printf '\033[K\n'
        # The cap is applied here and NOT at the measure call above: the packer measures
        # plain text, so a colour there would be a value it never looks at. Ground plus bold
        # in one override — the key keeps the weight it always had and gains the surface.
        HINT_SEP="$KEYCAP_SEP"
        HINT_KEY_COLOR="${C_KEYCAP}${C_BOLD}"
        print_hints "$nav_cols" "$nav_pad" "$nav_pad" "${nav_items[@]}"
        HINT_KEY_COLOR=""
        HINT_SEP=""
    fi

    # Live filter input caret
    if ((FILTER_MODE)); then
        # Elided to one line like every other chrome row: this copy is 48 cells and wrapped
        # at 40 columns, costing a line the reflow above had already handed to a result row.
        # Dropped entirely when the terminal cannot afford both it and a row — the caret under
        # it is the part that cannot be dropped.
        if ((filter_hint)); then
            truncate_disp "$S_FILTER_HINT" "$nav_cols"
            printf '%s%s%s\033[K\n' "$C_DIM" "$TRUNC_TEXT" "$C_RESET"
        fi
        printf '%s>%s %s' "$C_MARK" "$C_RESET" "$FILTER_LABEL"
        # \033[J from the caret, not \033[K first: it erases the rest of THIS line and every
        # line below in one sequence, and it leaves the cursor where it is — which is where the
        # filter's next character has to land.
        printf '\033[J'
        cursor_show
    else
        printf '\033[J'
        # ── The pending row number, vim's showcmd ────────────────────────────────────────
        # Right-flushed on the cursor's parking row, and that row for three reasons that are
        # each on their own sufficient. (1) The frame height must not change: an echo on a
        # line of its own would take a result row away on the first digit and hand it back on
        # `j`, flickering once per jump — and worse, it would make a block's height depend on
        # something learned after the budget was struck, which is exactly what the four-step
        # chain forbids. This row is already charged to LAYOUT_CURSOR_ROW, so it costs no
        # cell. (2) It is never reclaimed: the footer sheds the gaps, the hint gap and the
        # filter note by value, and the parking row is the one thing under them that never
        # goes — so this canvas exists at 24x24 too. (3) The filter takes the other branch
        # above, where a digit is query text and there is no count to draw.
        #
        # \033[J has already run, so erasing the previous count is free — nothing to clear
        # when JUMP_COUNT is empty, and no branch needed for it either.
        #
        # CHA to right_edge - width + 1, the house right-flush (the status segment in the
        # header uses the same expression against the same local). NOT to right_edge itself:
        # that is where the LAST cell goes, and starting there would run every digit after
        # the first past nav_cols — a wrap on the bottom line is a newline, which scrolls the
        # screen and costs the header, the very failure this placement exists to avoid.
        if [[ -n "$JUMP_COUNT" ]]; then
            local sc_col=$((right_edge - ${#JUMP_COUNT} + 1))
            ((sc_col < 1)) && sc_col=1
            printf '\033[%dG%s%s%s\033[1G' "$sc_col" "$C_DIM" "$JUMP_COUNT" "$C_RESET"
        fi
        # No trailing newline, here or above: filling the last row and emitting its newline
        # scrolls the whole screen by one and the header goes off the top (the note on
        # LAYOUT_CURSOR_ROW). The cursor is parked back at column 1 of this row instead.
        cursor_hide
    fi
}

display_menu() {
    # Kitty-spec DCS 1 q / 2 q frame hold: the terminal shows the repaint only when DCS
    # 2 q arrives, so a full-screen redraw cannot flash a half-rendered frame. Skipped
    # under tmux by default (it buffers output and needs terminal-overrides passthrough).
    if ((SYNC_ON)); then printf '\033P=1q'; fi
    # The page counter on the title line is printed BEFORE the reflow decides PAGE_SIZE, so
    # it divides by the previous frame's size. Whenever the reflow moves it — a key tier that
    # grows or frees the hint block, a resize, the provisional size of the very first frame —
    # that frame said `1/17` over a list of ten. One more pass inside the same hold, and only
    # then: the size depends on geometry, not on the counter, so the second pass is final.
    local prev_psize=$PAGE_SIZE
    display_list_menu "$1"
    if [[ "$LIST_MODE" == "page" ]] && ((PAGE_SIZE != prev_psize)); then
        display_list_menu "$1"
    fi
    if ((SYNC_ON)); then printf '\033P=2q'; fi
}

# ── Terminal resize ─────────────────────────────────────────────────────────────────────
# Every frame is laid out against the size read at the TOP of its render — layout_cols for
# the width, LINES_N for the reflow — so a resize invalidates the frame on screen entire:
# the row count, the hint packing, every elision width and the CHA rail column all describe
# a terminal that no longer exists. Nothing noticed. With no track playing read_nav_input
# blocks with no timeout, so the stale frame stood until the next keypress, and the reflow
# that exists to fit the pane was fitting the pane it had two sizes ago. The geometry itself
# was already right — a fresh start at a size and a shrink to that size settle on the same
# frame — so what was missing was only the trigger.
#
# The redraw happens INSIDE the handler rather than through a flag the reader polls, because
# bash 3.2 does not interrupt `read` for a trapped signal: it runs the handler and then
# RESUMES the read (verified in a pty — the handler's output arrives while the read is still
# blocked, and that same read still returns the key typed a second later). A flag would
# therefore be seen at exactly the moment a keypress would have repainted anyway, which is
# the bug and not the fix.
#
# WINCH_OK gates it to the wait that owns the whole screen. Everywhere else something else
# owns the cursor — the `n` prompt is echoing a query mid-keystroke, the `a`/`b` picker is
# waiting for a name, the fetch spinner is animating one line — and a full-screen repaint there
# erases what the user is reading or typing. (A NOTICE is not on this list any more: it is
# drawn by the frame, so a repaint reproduces it instead of erasing it.) Setting it around
# the one blocking read in read_nav_input covers both key loops that own the screen (the
# menu loop and filter_live, which drive the same reader) and reaches neither of the others.
#
# No re-entrancy guard, and that is measured rather than assumed: bash defers a second
# WINCH until this handler returns, so a drag-resize (one signal per column, 66 of them
# from 100 columns down to 34) still settles on a frame drawn for the final size.
WINCH_OK=0
on_winch() {
    if ((! WINCH_OK)); then return 0; fi
    display_menu "$page_index"
    return 0
}
trap on_winch WINCH

# ── Failure reporting ───────────────────────────────────────────────────────────────────
# A failed play used to be silent: play_selected returned 1, the case arm's `|| true` swallowed
# it (that guard is what stops set -e from killing the TUI), and Enter on an
# unplayable row did nothing and said nothing.
#
# The reason exists ONLY on the core's stderr. `die` writes prose there and exits 1 whatever -j
# asked for, so a synchronous -d failure puts nothing on stdout — there is no envelope field to
# read it out of. ARCH-cli-contract.md「数据契约」's `reason` taxonomy belongs to the BLOCKING play path, which ting never
# takes.
#
# One notice mechanism for the whole file, and this is just its label: store_notice records,
# the frame draws (see the notice block). What USED to be here — and in every one of the 30-odd
# notice sites — was a printf into the scroll area followed by a blocking read that ate the
# next key; the reason that shape is gone is written down where store_notice now lives.
play_failed_notice() {
    store_notice "$S_PLAY_FAILED:" "$1"
}

# ── PLAY delegate (Asynchronous / Non-blocking) ─────────────────────────────────────────
# The rows from the cursor to the end of the list, in the item shape t-play --queue reads
# (ARCH-player.md「队列」). Built from the ROW ARRAYS and never from $json: `/` narrows what is
# on screen without touching the envelope, so a queue assembled from the envelope would play
# rows the user has just filtered away. Each item carries its OWN engine for the reason
# play_selected passes one — a playlist and the log both mix sources, and the player routes
# per item — and the duration only when the row has a plain number to give, because that
# field is metadata for --status and a guess there is worse than a null.
build_queue_from_selection() {
    local i
    for ((i = selected; i < NUM_ENTRIES; i++)); do
        printf '%s%s%s%s%s%s%s\n' \
            "${R_ENGINE[$i]:-$CURRENT_ENGINE}" "$US" "${urls[$i]}" "$US" \
            "${R_TITLE[$i]:-}" "$US" "${R_DUR[$i]:-}"
    done | jq -R -s -c 'split("\n") | map(select(length > 0) | split("\u001f")
        | {engine: .[0],
           url: .[1],
           title: (if (.[2] // "") == "" then null else .[2] end),
           duration: (if (.[3] // "") | test("^[0-9]+$") then (.[3] | tonumber) else null end)})'
}

play_selected() {
    ((NUM_ENTRIES > 0)) || return 0
    local url="${urls[$selected]}"
    local out id pid

    stop_current_playback

    # stderr goes to a temp file, not /dev/null, the same way fetch_json already keeps the
    # search's: it is the only place a launch failure's reason exists.
    local sock errfile rc=0 msg
    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-play-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-play-err.$$"
    # --engine is passed EXPLICITLY and comes from the envelope: t-play defaults to its own
    # TING_DEFAULT_ENGINE, and letting that default decide would send a second engine's URL to
    # the first engine's resolver — which since ARCHITECTURE.md「站点知识的边界」 is a hard usage error rather
    # than the silent mislabel it used to be.
    # The ROW's engine, not the session's: a playlist can mix sources, and passing the
    # session engine would hand a bili URL to t-engine-yt — a hard usage error since ARCHITECTURE.md「站点知识的边界」.
    # Falls back to the session engine for a row that predates the field (an empty string
    # never reaches t-play, which would reject it).
    local row_engine="${R_ENGINE[$selected]:-}"
    [[ -n "$row_engine" ]] || row_engine="$CURRENT_ENGINE"
    # --quality rides beside -f because the engine reads the pair: the tier alone selects
    # nothing. Forwarded as the canonical spelling, never as a format-sort string — this file
    # holds no yt-dlp vocabulary, and t-play holds none either (ARCH-engine.md「解析」).
    # WHAT ENTER LAUNCHES is the loop mode's only other job. off and one send the one row
    # under the cursor and differ by --loop alone; seq sends the rows from here to the end of
    # the list as a QUEUE, which is the only shape the player understands "keep going" in —
    # and the reason the connected playback survives this TUI exiting, since the queue is the
    # detached player's own state and not something this file drives from outside.
    # --engine is not passed on that path: every item carries its own.
    local loop_flag=off
    if [[ "$LOOP_MODE" == "one" ]]; then loop_flag=one; fi
    if [[ "$LOOP_MODE" == "seq" ]]; then
        out=$(build_queue_from_selection |
            "$PLAY_BIN" -d -j -f "$PLAY_MODE" --quality "$PLAY_QUALITY" \
                ${PLAY_VOLUME:+--volume "$PLAY_VOLUME"} --loop "$loop_flag" --queue - 2>"$errfile") || rc=$?
    else
        out=$("$PLAY_BIN" -d -j --engine "$row_engine" -f "$PLAY_MODE" --quality "$PLAY_QUALITY" \
            ${PLAY_VOLUME:+--volume "$PLAY_VOLUME"} --loop "$loop_flag" -- "$url" 2>"$errfile") || rc=$?
    fi
    msg=$(<"$errfile")
    rm -f "$errfile"
    if ((rc != 0)); then
        # Launch-time failures only, and that is the whole point of reporting them here: the
        # detached path is async, so a resolve failure INSIDE the child lands in the child's own
        # log and the player simply exits — check_player_alive clears the chrome then, and this
        # notice never fires. What reaches here is t-play refusing to start (a rejected flag,
        # a handle with whitespace in it, no mpv).
        msg=${msg##*$'\n'}                 # last line only; die can print context above it
        msg=${msg#Error: }                 # the core's own prefix, redundant under our label
        [[ "$msg" == *[![:space:]]* ]] || msg="playback failed"
        play_failed_notice "$msg"
        return 1
    fi
    # id/pid/sock in one jq pass. The socket path is READ FROM THE ENVELOPE, never rebuilt:
    # it is the core's private state layout, and hardcoding "$TMPDIR/ting-$(id -u)/mpv-
    # $id.sock" here duplicated it in a second script that would break silently if the core
    # ever moved its state dir. ARCH-player.md「运行时 IPC」.
    # US, not tab, for the same reason build_all_rows uses it: all three fields default to
    # "" here, and a run of tabs collapses, so a player that reported no pid would have had
    # its socket path read into `pid` — and then the guard below would reject a play that
    # actually started.
    IFS="$US" read -r id pid sock < <(
        printf '%s' "$out" | jq -r '[.id // "", .pid // "", .sock // ""] | join("\u001f")' 2>/dev/null
    ) || true

    # rc was 0, so the core thinks it launched something, but without an id and a socket there
    # is nothing to control — report it rather than dropping the keypress on the floor.
    [[ -n "$id" && -n "$sock" ]] || { play_failed_notice "malformed launch envelope"; return 1; }

    CURRENT_PLAY_ID="$id"
    CURRENT_PLAY_PID="$pid"
    CURRENT_PLAY_SOCK="$sock"
    CURRENT_PLAY_PAUSED=0
    # The call we just made, seeded from the argv rather than waited for: the record answers
    # the same pair, but not until mpv has a media-title to trip the re-read on, and Enter on
    # a chapter row has to know what is playing in that window too (play_chapter). From the
    # first track boundary on, the record wins — it is the one that knows a queue moved.
    CURRENT_PLAY_URL="$url"
    CURRENT_PLAY_ENGINE="$row_engine"
    # Launched, not yet audible. player_check_ready clears this when mpv says it is producing
    # output, and read_nav_input runs on a 1 s tick until it does, so the banner flips on its
    # own rather than waiting for the user to press something.
    CURRENT_PLAY_LOADING=1
    CURRENT_PLAY_ADOPTED=0

    # Metadata straight out of the row arrays. This used to re-parse the composed display
    # string by splitting on " $GL_SEP " — which mis-split any title that itself contained
    # that separator, and had to be kept in step with the compose step at the other end of
    # the file. Liveness now comes from the row's own live_status field rather than from
    # recognising a rendered badge.
    CURRENT_PLAY_TITLE="${R_TITLE[$selected]:-Unknown}"
    # The wire form is kept UNCONVERTED beside the display one, for the queue view: a player
    # started from a bare handle (which is what this function does) writes a queue item with
    # no length in it, and that row would otherwise print --:-- under a banner showing 3:30.
    # Empty on a live stream, which is the honest answer — it has no length to show.
    CURRENT_PLAY_DUR_WIRE=""
    if [[ "${R_LIVE[$selected]}" == "is_live" ]]; then
        CURRENT_PLAY_IS_LIVE=1
        CURRENT_PLAY_DURATION="$GL_LIVE"
    else
        CURRENT_PLAY_IS_LIVE=0
        CURRENT_PLAY_DUR_WIRE="${R_DUR[$selected]}"
        # short_dur here too, not the envelope's `11h:53m:45s`: the banner sits three lines
        # above the same video's row and details line, and two spellings of one duration in
        # one screen read as two different numbers. It also matches the form fetch_play_times
        # replaces it with once mpv answers (fmt_sec), so the readout does not change shape
        # a second after playback starts.
        short_dur "${R_DUR[$selected]}"
        CURRENT_PLAY_DURATION="$SHORT_DUR"
    fi
    CURRENT_PLAY_STARTED=$(date +%s 2>/dev/null || echo 0)
}

# ── Playlist actions (keys: a add · b browse) ───────────────────────────────────────────
#
# THIS FILE STORES NOTHING. Both actions shell out to `t-playlist` and hand it JSON, the
# same way play_selected shells out to `t-play`: the store owns the directory layout, the
# lock and the record shape, and a bug in any of the three is fixed in ONE file for every
# surface. A version of `a` that appended to a file here would be the exact shape
# CLAUDE.md forbids — correctness added up, in a UI, instead of down.
#
# ── The notice: ONE LINE IN THE FRAME, NOT A MODAL ──────────────────────────────────────
# A notice answers a key the user just pressed — an empty log, a one-part video, a row with
# no chapters, a store that is not installed, a fetch that failed, a preference the
# environment has pinned. None of those questions want an answer back, so a notice is
# CONTENT: this function only RECORDS it, display_list_menu draws it under the title line
# inside the measured chrome, and read_nav_input drops it the moment the next key is in
# hand. It lives exactly one frame — exactly as long as the question it answers.
#
# It used to be a printf into the scroll area (outside the frame model entirely) plus a
# blocking `read -rsn1` to hold it there, and that shape cost this suite twice. Once when
# the 1 the row-source openers return met `set -e` on the very keypress meant to dismiss
# the notice, taking the TUI down at the worst possible moment — the `|| true` still on the
# h/c/i arms is that scar. Once when tests/contract.sh's chapter walk had to feed that
# reader a Space and then wait for the notice to disappear before it could send another
# key, which made the walk race its own previous lap and go flaky: a check paying interest
# on a design debt. The debt itself is that a modal message turns the NEXT key into two
# things at once — dismiss, or command — and the user cannot know which one they pressed.
#
# So: a message stops the UI only when it is really asking something (ROADMAP.md「横切规范」
# 只为一个答案停下来). The two readers that ARE asking keep their own blocking read, because
# they have a question in them: prompt_name (a playlist name) and the picker built on it.
#
# The label is the caller's, because "Play failed:" is the wrong word for a store that is
# not there — and it is what lets one line serve every source without a second spelling.
NOTICE_LABEL=""
NOTICE_TEXT=""
store_notice() {
    NOTICE_LABEL="$1"
    NOTICE_TEXT="$2"
}

have_store() {
    [[ -n "$PLAYLIST_BIN" ]] && return 0
    store_notice "$S_PL_ACT:" "$S_PL_ABSENT"
    return 1
}

# What the store holds, fetched once per keypress into PL_LS_JSON. BOTH playlist keys need
# it — `b` to pick a list to open, `a` to pick one to add to — and the ten lines that fetch
# it (the errfile, the rc, the two-step message strip) are exactly the copy that drifted
# apart in F11/F12, so there is one of them. -j, not the prose --ls: the picker needs the
# names as DATA. The COUNT is left to the caller to judge, because the same number means
# different things to the two keys: an empty store is a dead end for `b` and a perfectly
# ordinary starting point for `a`.
# One list, read out of the store, in PL_SHOW_JSON. Two callers — opening a list and
# re-reading one that just changed — and the same ten lines list_playlists exists to stop
# being copied. The COUNT is again the caller's to judge: an empty answer means "there is
# nothing to open" on the way in and "you just removed the last one" on the way back.
PL_SHOW_JSON=""
PL_SHOW_COUNT=0
show_playlist() {
    local rc=0 errfile msg
    PL_SHOW_JSON=""
    PL_SHOW_COUNT=0
    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-pl-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-pl-err.$$"
    PL_SHOW_JSON=$("$PLAYLIST_BIN" --show "$1" -j 2>"$errfile") || rc=$?
    msg=$(<"$errfile")
    rm -f "$errfile"
    if ((rc != 0)); then
        msg=${msg##*$'\n'}
        msg=${msg#t-playlist: }
        store_notice "$S_PL_ACT:" "${msg:-$S_PL_FAILED}"
        return 1
    fi
    PL_SHOW_COUNT=$(printf '%s' "$PL_SHOW_JSON" | jq -r '.count // 0' 2>/dev/null) || PL_SHOW_COUNT=0
    return 0
}

PL_LS_JSON=""
PL_LS_COUNT=0
list_playlists() {
    local rc=0 errfile msg
    PL_LS_JSON=""
    PL_LS_COUNT=0
    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-pl-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-pl-err.$$"
    PL_LS_JSON=$("$PLAYLIST_BIN" --ls -j 2>"$errfile") || rc=$?
    msg=$(<"$errfile")
    rm -f "$errfile"
    if ((rc != 0)); then
        msg=${msg##*$'\n'}
        msg=${msg#t-playlist: }
        store_notice "$S_PL_ACT:" "${msg:-$S_PL_FAILED}"
        return 1
    fi
    PL_LS_COUNT=$(printf '%s' "$PL_LS_JSON" | jq -r '.count // 0' 2>/dev/null) || PL_LS_COUNT=0
    return 0
}

# ── Undo: `z` ──────────────────────────────────────────────────────────────────────────
# WHY THERE IS NO "ARE YOU SURE". A confirmation guards nothing once it has become a habit —
# `d` then `y` is one gesture after the tenth time — so d, D and X used to cost two keys and a
# frame that stopped for a question, for a protection that had already stopped working. What
# makes a key safe is that its effect is cheap to reverse, and `x` in the queue already lived
# by that. So every write the user can regret keeps a copy for three seconds, and `z` puts it
# back. ARCH-tui.md「可撤销取代预先确认」.
#
# THE COPY IS NOT HERE. It is written by the command that owns the object, under the lock of
# the write itself, keyed on this process (--owner $$), and only that command decides whether
# it can still be restored (docs/ARCH-player.md「撤销副本」). What this file keeps is which
# store to ask and until when to offer it — the four scalars below. One slot for the whole
# suite: a write to the OTHER store drops the copy in this one first, so `z` is always "the
# last thing I did" and never a stack.
#
# THE CLOCK IS $SECONDS. The deadline arrives as epoch seconds; converting it once, at the
# write, means every frame and every loop turn can ask "still open?" with arithmetic instead
# of forking `date` — bash 3.2 has neither EPOCHSECONDS nor printf %(%s)T. Both clocks are
# whole seconds, so the two answers can differ by one, and in that second `z` gets
# undo_expired from the store, which is simply the honest answer.
UNDO_STORE=""        # playlist | queue — the store holding this process's copy, if any
UNDO_END=0           # when the offer closes, on the $SECONDS clock; 0 = nothing on offer
UNDO_HEAD=""         # the notice label the offer is drawn under (the store's own)
UNDO_LABEL=""        # what was done, as the success notice would have said it
UNDO_STOP_PENDING=0  # a stop the write implied, held back until the offer closes
UNDO_BIN=""          # undo_bin's out-param: the command that owns UNDO_STORE

undo_active() {
    ((UNDO_END > 0 && SECONDS < UNDO_END))
}

undo_bin() {
    if [[ "$1" == "queue" ]]; then UNDO_BIN="$PLAY_BIN"; else UNDO_BIN="$PLAYLIST_BIN"; fi
}

# The offer is over and `z` did not take it — it closed, another write replaced it, or the
# store refused it. The one place that happens, because it is the one place the held-back stop
# has to be paid: the user deleted the row the player is on, the undo that would have made
# that harmless is gone, so the stop the delete implied happens now.
undo_forget() {
    UNDO_END=0
    UNDO_HEAD=""
    UNDO_LABEL=""
    if ((UNDO_STOP_PENDING)); then
        UNDO_STOP_PENDING=0
        stop_current_playback
    fi
    return 0
}

# Drop this process's copy in the store that holds it, restoring nothing. Idempotent in the
# store (no copy is 0), so it is safe to call whether the offer is still open or not.
undo_discard() {
    [[ -n "$UNDO_STORE" ]] || return 0
    undo_bin "$UNDO_STORE"
    [[ -n "$UNDO_BIN" ]] && "$UNDO_BIN" --undo --discard --owner $$ -j >/dev/null 2>&1 || true
    UNDO_STORE=""
    return 0
}

# undo_arm STORE ENVELOPE HEAD LABEL — a write succeeded; offer it. Returns 1 when the
# envelope carries no undo (a store that predates it, or a write that changed nothing), and the
# caller then says what happened in a plain notice instead.
#
# A write that left no copy leaves the previous offer standing: the store still holds that
# copy, and nothing has replaced it.
undo_arm() {
    local store=$1 env=$2 dl
    dl=$(printf '%s' "$env" | jq -r '.undo.deadline // empty' 2>/dev/null) || dl=""
    [[ "$dl" =~ ^[0-9]+$ ]] || return 1
    [[ "$UNDO_STORE" == "$store" ]] || undo_discard
    undo_forget
    UNDO_STORE="$store"
    UNDO_END=$((SECONDS + dl - $(date +%s)))
    UNDO_HEAD="$3"
    UNDO_LABEL="$4"
    return 0
}

# Once per loop turn, in BOTH loops that own the screen, and not in nav_tick: nav_tick runs
# only when the read times out, so a user holding `j` would keep a held-back stop waiting for
# as long as they held it.
undo_tick() {
    if ((UNDO_END > 0 && SECONDS >= UNDO_END)); then undo_forget; fi
    return 0
}

# The cursor on a row the STORE named (the envelope's index), never one this file remembered:
# the list may have moved under the undo, and only the store knows where the row went back.
undo_place_cursor() {
    local idx=$1
    ((idx < NUM_ENTRIES)) || idx=$((NUM_ENTRIES - 1))
    ((idx >= 0)) || idx=0
    selected=$idx
    page_index=$((idx / PAGE_SIZE + 1))
}

# Show what the undo restored, where it can be seen from here. A list on screen is re-read;
# a list the write took off the screen (a D, or a d that emptied it) is reopened when we are
# back on the search it left us on; anywhere else the notice is the whole answer. A rename's
# undo is recognised by `from` — the name the screen was left showing — because the name it
# restores is one this view has not been called since.
undo_show_playlist() {
    local env=$1 name from index verb
    IFS=$'\037' read -r verb name from index < <(printf '%s' "$env" |
        jq -r '[.undone // "", .name // "", .from // "", (.index // "" | tostring)] | join("\u001f")' 2>/dev/null) || return 0
    [[ -n "$name" ]] || return 0
    if [[ -n "$from" && "$LIST_SOURCE" == "playlist" && "$PLAYLIST_NAME" == "$from" ]]; then
        PLAYLIST_NAME="$name"
        QUERY_LABEL="$name"
    fi
    if [[ "$LIST_SOURCE" == "playlist" && "$PLAYLIST_NAME" == "$name" ]]; then
        reload_playlist "$name"
        [[ -n "$index" ]] && undo_place_cursor "$index"
    elif [[ "$LIST_SOURCE" == "search" ]] && [[ "$verb" == "del" || "$verb" == "rm" ]]; then
        if open_playlist "$name" && [[ -n "$index" ]]; then undo_place_cursor "$index"; fi
    fi
    return 0
}

# `z`. What the store answers decides everything: 0 restored it, 4 is the store saying no
# (and why), and only `locked` among the 4s keeps the offer — the copy is intact and a retry
# can succeed, where every other refusal is final.
undo_last() {
    if ! undo_active; then
        store_notice "$S_UNDO_ACT:" "$S_UNDO_NONE"
        return 0
    fi
    local store="$UNDO_STORE" out rc=0 errfile msg reason
    undo_bin "$store"
    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-undo-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-undo-err.$$"
    out=$("$UNDO_BIN" --undo --owner $$ -j 2>"$errfile") || rc=$?
    msg=$(<"$errfile")
    rm -f "$errfile"
    if ((rc == 0)); then
        # The copy is spent and the stop it was holding back is not owed any more.
        UNDO_STORE=""
        UNDO_STOP_PENDING=0
        undo_forget
        if [[ "$store" == "queue" ]]; then
            apply_player_record "$out"
            [[ "$LIST_SOURCE" == "queue" ]] && reload_queue "$selected"
        else
            undo_show_playlist "$out"
        fi
        store_notice "$S_UNDO_ACT:" "$S_UNDO_DONE"
        return 0
    fi
    reason=$(printf '%s' "$out" | jq -r '.reason // ""' 2>/dev/null) || reason=""
    msg=${msg##*$'\n'}
    msg=${msg#t-playlist: }
    msg=${msg#t-play: }
    if ((rc == 4)) && [[ "$reason" != "locked" ]]; then
        [[ "$reason" == "undo_none" ]] && UNDO_STORE=""
        undo_forget
        case "$reason" in
        undo_stale) store_notice "$S_UNDO_ACT:" "$S_UNDO_STALE" ;;
        undo_none | undo_expired) store_notice "$S_UNDO_ACT:" "$S_UNDO_NONE" ;;
        *) store_notice "$S_UNDO_ACT:" "${msg:-$S_PL_FAILED}" ;;
        esac
        return 0
    fi
    store_notice "$S_UNDO_ACT:" "${msg:-$S_PL_FAILED}"
    return 0
}

# Prompt for a playlist name, echoing what is typed. Esc / empty cancels, exactly like the
# n prompt this borrows its reader from — one reader owns UTF-8 assembly, backspace width
# and the cancel contract for every prompt in the app.
prompt_name() {
    PROMPT_NAME=""
    printf '\n%s%s %s%s: ' "$C_BOLD" "$GL_CARET" "$1" "$C_RESET"
    read_query_input || return 1
    [[ "$QUERY_INPUT" == *[![:space:]]* ]] || return 1
    PROMPT_NAME="$QUERY_INPUT"
    return 0
}

# Add the focused row to a playlist. The item is cut from the SEARCH ENVELOPE by url rather
# than rebuilt from the row arrays: the envelope carries the engine tag and the exact field
# spellings the store wants, so nothing here knows the item record — and the row arrays are
# filtered and re-ordered, so an index into them is not an index into .results.
# The focused row as a one-item ENVELOPE, in FOCUSED_PAYLOAD. Two shapes because the rows
# have two sources, and the shape carries the engine tag either way: a search result does not
# hold `engine` (that is on the envelope), a stored item does. Both t-playlist --add and
# t-play --enqueue read exactly these two, which is why one builder serves both.
FOCUSED_PAYLOAD=""
focused_payload() {
    local url="${urls[$selected]}"
    FOCUSED_PAYLOAD=""
    if stored_rows; then
        # [0:1], because the url is a KEY here and a store may hold it twice — trivially in a
        # playlist, by design in the history, where listening to one track five times is five
        # rows. Without the slice, `a` on a much-played row adds five copies of it.
        FOCUSED_PAYLOAD=$(printf '%s' "$json" | jq -c --arg u "$url" \
            '{items: [.items[] | select(.url == $u)][0:1]}' 2>/dev/null) || FOCUSED_PAYLOAD=""
    else
        FOCUSED_PAYLOAD=$(printf '%s' "$json" | jq -c --arg u "$url" \
            '{status: "ok", engine: .engine, count: 1, results: [.results[] | select(.url == $u)]}' 2>/dev/null) || FOCUSED_PAYLOAD=""
    fi
    [[ -n "$FOCUSED_PAYLOAD" ]] || return 1
    return 0
}

add_to_playlist() {
    ((NUM_ENTRIES > 0)) || return 0
    have_store || return 0
    local name payload rc=0 msg errfile out
    if ! focused_payload; then
        store_notice "$S_PL_ACT:" "$S_PL_FAILED"
        return 0
    fi
    payload="$FOCUSED_PAYLOAD"
    # The same question `b` asks, asked the same way: what exists, numbered, before the
    # caret. A prompt that wants a name typed from memory is a worse question than the store
    # can answer (see pick_playlist) — and it is worse HERE than it is there, because a
    # mistyped name does not fail, it silently makes a second playlist. An empty store is the
    # one case with nothing to show, and there the only useful question is the new name.
    list_playlists || return 0
    if [[ "$PL_LS_COUNT" == "0" ]]; then
        prompt_name "$S_PL_PROMPT_NEW" || return 0
    else
        pick_playlist "$PL_LS_JSON" "$S_PL_ADD" "$S_PL_PROMPT_ADD" || return 0
    fi
    name="$PROMPT_NAME"
    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-pl-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-pl-err.$$"
    out=$(printf '%s' "$payload" | "$PLAYLIST_BIN" --add "$name" --owner $$ -j 2>"$errfile") || rc=$?
    msg=$(<"$errfile")
    rm -f "$errfile"
    if ((rc != 0)); then
        msg=${msg##*$'\n'}
        msg=${msg#t-playlist: }
        [[ "$msg" == *[![:space:]]* ]] || msg="$S_PL_FAILED"
        store_notice "$S_PL_ACT:" "$msg"
        return 0
    fi
    # The success side is a notice too, and under the same label as every failure this key
    # can report: one keypress costs one keypress (the rule `+` already followed), and the
    # confirmation rides the next frame instead of holding the screen for a second key. It is
    # drawn as the undo offer while there is one — the same sentence, with `z` beside it.
    undo_arm playlist "$out" "$S_PL_ACT:" "$S_PL_ADDED $GL_ARROW $name" ||
        store_notice "$S_PL_ACT:" "$S_PL_ADDED $GL_ARROW $name"
}

# Which item of the STORE the focused row is, in PL_ITEM_INDEX — 0-based, which is what
# t-playlist --rm --index takes.
#
# `selected` would be that number TODAY, and only by luck: the rows are the items in order,
# and the one thing that reorders a view — the filter — does not outlive its own loop
# (filter_live ends with apply_filter ""), so `d` is never pressed against a subset. That is
# an invariant of another function, and the failure it buys if it ever changes is not a
# missing row, it is the WRONG row deleted. So the index is resolved from the row's own
# identity instead: the url, plus its OCCURRENCE — how many rows above it carry the same url
# — because a playlist may hold one url twice, and then the first match is not necessarily
# the row under the cursor. Both sequences are item order (build_playlist_rows emits items in
# order, apply_filter re-emits survivors in order), so the k-th occurrence in the view is the
# k-th occurrence in the store, subset or not.
PL_ITEM_INDEX=""
focused_index() {
    local url="${urls[$selected]}" i k=0
    PL_ITEM_INDEX=""
    for ((i = 0; i < selected; i++)); do
        if [[ "${urls[$i]}" == "$url" ]]; then k=$((k + 1)); fi
    done
    PL_ITEM_INDEX=$(printf '%s' "$json" | jq -r --arg u "$url" --argjson k "$k" \
        '[.items | to_entries[] | select(.value.url == $u) | .key][$k] // empty' 2>/dev/null) || PL_ITEM_INDEX=""
    [[ -n "$PL_ITEM_INDEX" ]] || return 1
    return 0
}

# Is the focused row the one the PLAYER is on? Decided in the renderer's vocabulary — the
# row's engine plus handle_key's normalised handle — so "the player holds this row" has one
# spelling in this file and not two that can drift. PLAYING_IDX is not reusable here: it is
# resolved over the VISIBLE page inside a redraw, so it answers for a page, and `d` needs the
# answer about one row at a moment no redraw has run.
focused_is_playing() {
    [[ -n "$CURRENT_PLAY_ID" && -n "$CURRENT_PLAY_URL" ]] || return 1
    [[ "${R_ENGINE[$selected]:-}" == "$CURRENT_PLAY_ENGINE" ]] || return 1
    local pk
    handle_key "$CURRENT_PLAY_URL"
    pk="$HANDLE_KEY"
    [[ -n "$pk" ]] || return 1
    handle_key "${urls[$selected]}"
    if [[ "$pk" == "$HANDLE_KEY" ]]; then return 0; fi
    return 1
}

# Remove the focused row from the playlist it is a row OF. The store does the removing, by
# index, exactly as `a` lets it do the adding: this file neither rewrites the file nor decides
# what a removal means. It asks nothing first — `z` takes it back (see the Undo section) —
# and it is the only store key that acts on the view it is already in, so it ends by
# re-reading the store rather than by opening something.
delete_from_playlist() {
    ((NUM_ENTRIES > 0)) || return 0
    playlist_only || return 0
    have_store || return 0
    local name="$PLAYLIST_NAME" rc=0 msg errfile out title playing=0
    if ! focused_index; then
        # The row is not in the envelope the view was built from, so the store and the screen
        # disagree and an --index taken from here would delete SOMETHING ELSE. Refuse.
        store_notice "$S_PL_ACT:" "$S_PL_FAILED"
        return 0
    fi
    # Asked while the row is still the focused one, because the answer is about THIS row and
    # nothing below still knows which row it was: reload_playlist repoints `selected` at
    # whatever moved up into the gap.
    if focused_is_playing; then playing=1; fi
    # Named in the offer, because a run of `d` leaves only the LAST one undoable and the user
    # has to be able to read which one that is.
    title="${R_TITLE[$selected]}"
    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-pl-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-pl-err.$$"
    out=$("$PLAYLIST_BIN" --rm "$name" --index "$PL_ITEM_INDEX" --owner $$ -j 2>"$errfile") || rc=$?
    msg=$(<"$errfile")
    rm -f "$errfile"
    if ((rc != 0)); then
        msg=${msg##*$'\n'}
        msg=${msg#t-playlist: }
        [[ "$msg" == *[![:space:]]* ]] || msg="$S_PL_FAILED"
        store_notice "$S_PL_ACT:" "$msg"
        return 0
    fi
    # The record is gone, so a player still holding it is playing something the user just
    # deleted. With an undo on offer the stop WAITS for the offer to close (undo_forget):
    # a stopped player is the one part of this that a copy cannot put back, so `z` inside the
    # window must find it still playing. With no offer it stops now, BEFORE the reload, so the
    # redraw that reload ends with already draws no player.
    if undo_arm playlist "$out" "$S_PL_ACT:" "$S_PL_REMOVED $GL_ARROW $name: $title"; then
        if ((playing)); then UNDO_STOP_PENDING=1; fi
    else
        store_notice "$S_PL_ACT:" "$S_PL_REMOVED $GL_ARROW $name"
        if ((playing)); then stop_current_playback; fi
    fi
    reload_playlist "$name"
}

# Delete the entire playlist on screen and return to the search view. No question first, for
# the reason `d` asks none: `z` takes it back. A track of this list that is playing stops when
# the offer closes, not before (see delete_from_playlist).
delete_current_playlist() {
    playlist_only || return 0
    have_store || return 0
    local name="$PLAYLIST_NAME" rc=0 msg errfile url out playing=0

    if [[ -n "$CURRENT_PLAY_ID" && -n "$CURRENT_PLAY_URL" ]] && ((${#urls[@]} > 0)); then
        for url in "${urls[@]}"; do
            handle_key "$CURRENT_PLAY_URL"
            local pk="$HANDLE_KEY"
            handle_key "$url"
            if [[ -n "$pk" && "$pk" == "$HANDLE_KEY" ]]; then
                playing=1
                break
            fi
        done
    fi

    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-pl-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-pl-err.$$"
    out=$("$PLAYLIST_BIN" --del "$name" --owner $$ -j 2>"$errfile") || rc=$?
    msg=$(<"$errfile")
    rm -f "$errfile"
    if ((rc != 0)); then
        msg=${msg##*$'\n'}
        msg=${msg#t-playlist: }
        [[ "$msg" == *[![:space:]]* ]] || msg="$S_PL_FAILED"
        store_notice "$S_PL_ACT:" "$msg"
        return 0
    fi
    if undo_arm playlist "$out" "$S_PL_ACT:" "$S_PL_DELETED $GL_ARROW $name"; then
        if ((playing)); then UNDO_STOP_PENDING=1; fi
    else
        store_notice "$S_PL_ACT:" "$S_PL_DELETED $GL_ARROW $name"
        if ((playing)); then stop_current_playback; fi
    fi
    back_to_search
}

# Rename the playlist currently on screen.
# Prompts for the new name, calls `t-playlist --rename`, and on success updates PLAYLIST_NAME
# and QUERY_LABEL in place without reloading tracks from disk.
rename_current_playlist() {
    playlist_only || return 0
    have_store || return 0
    local old_name="$PLAYLIST_NAME" new_name rc=0 msg errfile out
    prompt_name "$S_PL_RENAME_PROMPT" || return 0
    new_name="$PROMPT_NAME"
    [[ -n "$new_name" ]] || return 0
    if [[ "$new_name" == "$old_name" ]]; then return 0; fi

    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-pl-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-pl-err.$$"
    out=$("$PLAYLIST_BIN" --rename "$old_name" "$new_name" --owner $$ -j 2>"$errfile") || rc=$?
    msg=$(<"$errfile")
    rm -f "$errfile"
    if ((rc != 0)); then
        msg=${msg##*$'\n'}
        msg=${msg#t-playlist: }
        [[ "$msg" == *[![:space:]]* ]] || msg="$S_PL_FAILED"
        store_notice "$S_PL_ACT:" "$msg"
        return 0
    fi
    PLAYLIST_NAME="$new_name"
    QUERY_LABEL="$new_name"
    undo_arm playlist "$out" "$S_PL_ACT:" "$S_PL_RENAMED $GL_ARROW $new_name" ||
        store_notice "$S_PL_ACT:" "$S_PL_RENAMED $GL_ARROW $new_name"
}

# Re-open the list after it has CHANGED under us, keeping the user where they were. The
# re-fetch IS open_playlist (the stash it takes no-ops on rows that already belong to a
# store), so there is no second copy of the show + build + load sequence; the one thing this
# adds is the cursor, which must not jump back to the top after every delete — deleting three
# tracks is otherwise three trips back down the list. Nothing restores a filter, because
# there is none to restore: filter_live clears it on the way out, so a key handled by the
# menu loop always sees the whole list.
# A reload that FAILS lands on the search rather than on rows the store no longer agrees
# with: the item is already gone, so what is on screen is a picture of the past. The one
# expected failure is the list going empty, and there the notice is S_PL_EMPTY — the same
# sentence `b` gives for opening an empty list, because it is the same fact. The empty list
# STAYS: removing its last track is not a request to delete it, and asking at that moment was
# a question the user had not come to answer. It is D's to delete, like any other list.
reload_playlist() {
    local name=$1 keep=$selected
    if ! open_playlist "$name"; then
        back_to_search
        return 0
    fi
    if ((keep >= NUM_ENTRIES)); then keep=$((NUM_ENTRIES - 1)); fi
    if ((keep < 0)); then keep=0; fi
    selected=$keep
    page_index=$((keep / PAGE_SIZE + 1))
    return 0
}

# Load a playlist as the row source. The list view is unchanged — same renderer, same
# filter, same keys — because a playlist envelope produces the same ten-field row a
# search does (build_playlist_rows). What changes is LIST_SOURCE, which is what the
# search-only keys (o / e) test before re-fetching a query that is no longer on screen.
open_playlist() {
    local name="$1" out
    show_playlist "$name" || return 1
    if [[ "$PL_SHOW_COUNT" == "0" ]]; then
        store_notice "$S_PL_ACT:" "$S_PL_EMPTY"
        return 1
    fi
    out="$PL_SHOW_JSON"
    stash_search
    json="$out"
    LIST_SOURCE="playlist"
    # The name as DATA, next to the label that renders it: QUERY_LABEL is chrome (it holds a
    # query in one view and a translated string in another), and `d` needs the exact key the
    # store answers to. Nothing clears it, because nothing reads it outside a playlist view
    # and this is the only way into one.
    PLAYLIST_NAME="$name"
    # One label for the whole list, computed once: a mixed playlist says so rather than
    # claiming the session engine, which is not what its rows will play under.
    PLAYLIST_ENGINES=$(printf '%s' "$out" | jq -r '[.items[].engine] | unique | join("+")' 2>/dev/null) || PLAYLIST_ENGINES=""
    QUERY_LABEL="$name"
    build_playlist_rows
    FILTER_LABEL=""
    FILTER_MODE=0
    selected=0
    page_index=1
    load_rows "$ALL_ROWS"
    return 0
}

# The two keys that RE-FETCH a query (o / e) cannot run against a playlist, which has
# no query behind it. One guard, called by both: three copies of it drifted apart in
# every earlier duplication this file has had (ARCHITECTURE.md's F11/F12), and the
# no-shared-library trade that licenses copies BETWEEN the six commands does not license
# them WITHIN one file.
# The other half of search_only: rows that came from a STORE rather than from a search — a
# playlist, or the listening log. Everywhere the difference between those two is not the
# LABEL they are one case (same item record, same renderer, same one-item payload shape), and
# one predicate is what stops that from becoming three copies of a two-way test that drift
# apart the way F11/F12 did (ARCHITECTURE.md).
# `parts` belongs here even though no store holds it: what this predicate actually asks is
# "does `.items[]` read this envelope", and a part list's --items envelope is exactly that.
# `chapters` is the same answer for the same reason — build_chapter_rows writes that envelope
# from the chapter table. The name outlived its first meaning by two row sources; the
# behaviour it selects did not.
stored_rows() {
    [[ "$LIST_SOURCE" == "playlist" || "$LIST_SOURCE" == "history" ||
        "$LIST_SOURCE" == "parts" || "$LIST_SOURCE" == "chapters" ||
        "$LIST_SOURCE" == "queue" ]]
}

search_only() {
    [[ "$LIST_SOURCE" == "search" ]] && return 0
    store_notice "$S_PL_ACT:" "$S_PL_SEARCH_ONLY"
    return 1
}

# The mirror of search_only, for the one key that needs the opposite: `d` removes a row from
# the list it is a row of, and a search result is a row of nothing. Not stored_rows — the
# listening log is a store too, and t-history has no per-row removal (--ls --record --clear
# is its whole surface), so a `d` there would have nothing to call.
playlist_only() {
    [[ "$LIST_SOURCE" == "playlist" ]] && return 0
    store_notice "$S_PL_ACT:" "$S_PL_LIST_ONLY"
    return 1
}

# ── BACK action: the key that OPENED a store closes it (h, b) ───────────────────────────
# b and h REPLACE the rows on screen, so without this the only ways out of a store were `n`
# (retype a query) and `q`. Everything they replace is LOCAL state — the envelope, the rows
# built from it, the label, and where the cursor was — so the way back is to put that state
# back, not to re-run the search: a refetch would spend a network round trip rebuilding rows
# we still hold, and would silently change them under a user who only asked to go back.
#
# The stash is taken by the store openers themselves and only while the rows are still the
# search's, so search -> h -> b -> back lands on the search rather than on the history.
#
# NOT Esc, which is what this first shipped as. Esc is the one key on the keyboard that
# cannot be instant: `\x1b` is also the first byte of every arrow and function key, so a lone
# Esc is only knowable after a wait — and bash 3.2 cannot express a wait shorter than one
# whole second (`read -t` takes integers; ncurses calls the same window ESCDELAY and defaults
# it to 1000 ms, which is exactly the number everybody overrides to 25). A "back" key that
# takes a second reads as broken. `h` and `b` are plain bytes, they answer in the redraw, and
# a toggle needs no second key to learn: the one that opened it closes it.
stash_search() {
    stored_rows && return 0
    SEARCH_STASH_JSON="${json:-}"
    SEARCH_STASH_ROWS="${ALL_ROWS:-}"
    SEARCH_STASH_LABEL="${QUERY_LABEL:-}"
    SEARCH_STASH_ENGINES="${PLAYLIST_ENGINES:-}"
    SEARCH_STASH_SEL="${selected:-0}"
    SEARCH_STASH_PAGE="${page_index:-1}"
}

back_to_search() {
    stored_rows || return 0
    json="${SEARCH_STASH_JSON:-}"
    ALL_ROWS="${SEARCH_STASH_ROWS:-}"
    QUERY_LABEL="${SEARCH_STASH_LABEL:-}"
    PLAYLIST_ENGINES="${SEARCH_STASH_ENGINES:-}"
    LIST_SOURCE="search"
    FILTER_LABEL=""
    FILTER_MODE=0
    selected="${SEARCH_STASH_SEL:-0}"
    page_index="${SEARCH_STASH_PAGE:-1}"
    if [[ -z "$json" ]]; then
        json='{"count":0,"results":[]}'
    fi
    load_rows "$ALL_ROWS"
    # Explicit, like the two openers: this runs bare from a case arm, so its status is the
    # TUI's life. load_rows happens to end 0 today; that is not a promise it made.
    return 0
}

# List what is stored, then ask which one. A picker widget would be a second list renderer
# in a file that already has one, and the prose --ls output is the store's own answer to
# "what have I got" — printed, not re-rendered here.
# The picker BOTH playlist keys print, and the reason it is not a widget: it is PROSE in the
# scroll area,
# exactly where the store's own `--ls` output used to land, plus the two things that were
# missing from it. An INDEX, because a caret that looks identical to the search prompt and
# wants a name typed from memory is a worse question than the store can answer; and a name
# column MEASURED with disp_w, because `--ls` pads in bytes and a CJK name in a byte-padded
# column does not line up. No second list renderer, no keymap, no selection state.
#
# Sets PROMPT_NAME to the chosen NAME — a number is resolved HERE, so open_playlist still
# takes exactly what t-playlist takes and the store never hears about row numbers. The index
# wins over a numeric name, which costs nothing: the number is what is on screen, and a
# playlist actually called "7" is still reachable by ITS row number.
# The header and the prompt come from the CALLER, and they are the only difference between
# the two uses: `b` picks a list to open, `a` picks one to add to. Everything else — the
# numbering, the measured name column, the index-beats-a-numeric-name rule — is one
# behaviour, so the two keys cannot drift into two spellings of the same list.
PICK_NAMES=()
pick_playlist() {
    local out=$1 header=$2 prompt=$3
    local nm ct up i n idx num_w name_w=0 meta_w=0 cols date_ok=0 unit
    local counts=() metas=()
    PICK_NAMES=()
    while IFS=$'\t' read -r nm ct up; do
        [[ -n "$nm" ]] || continue
        PICK_NAMES+=("$nm"); counts+=("$ct")
        # jq's date is an ISO timestamp; the DAY is the part a human picks a list by.
        metas+=("${up:0:10}")
        disp_w "$nm"; ((DISP_W > name_w)) && name_w=$DISP_W
    done <<< "$(printf '%s' "$out" | jq -r '.playlists[] | [.name, (.count | tostring), (.updated_at // "")] | @tsv' 2>/dev/null)"
    n=${#PICK_NAMES[@]}
    ((n > 0)) || return 1

    layout_cols
    cols=$LAYOUT_COLS
    num_w=${#n}
    # The date is the first thing to go: it is the least of the three facts, and a narrow pane
    # would otherwise spend the name's cells on it. 46 = the width at which a 16-cell name,
    # the count and the date still fit behind the indent.
    ((cols >= 46)) && date_ok=1
    for ((i = 0; i < n; i++)); do
        if [[ "${counts[$i]}" == "1" ]]; then unit="$S_PL_ITEM"; else unit="$S_PL_ITEMS"; fi
        if ((date_ok)); then metas[$i]="${counts[$i]} $unit  ${metas[$i]}"; else metas[$i]="${counts[$i]} $unit"; fi
        disp_w "${metas[$i]}"; ((DISP_W > meta_w)) && meta_w=$DISP_W
    done
    # 3 indent + "N." + 1 + 2 gutter, then clamped at LAYOUT_MIN_BUDGET so a pane too narrow
    # to hold the meta elides the name rather than wrapping the row.
    idx=$((cols - 3 - num_w - 1 - 2 - meta_w))
    ((idx < LAYOUT_MIN_BUDGET)) && idx=$LAYOUT_MIN_BUDGET
    ((name_w > idx)) && name_w=$idx

    printf '\n  %s%s%s\n' "$C_BOLD" "$header" "$C_RESET"
    for ((i = 0; i < n; i++)); do
        truncate_disp "${PICK_NAMES[$i]}" "$name_w"
        disp_w "$TRUNC_TEXT"
        printf '  %*d. %s%*s  %s\n' "$num_w" "$((i + 1))" "$TRUNC_TEXT" "$((name_w - DISP_W))" "" "${metas[$i]}"
    done

    prompt_name "$prompt" || return 1
    # All digits and short enough that 10# cannot overflow the arithmetic. Anything else is a
    # name, including a number outside the range — the store will say `not_found` in its own
    # words, which is a better sentence than one invented here.
    case "$PROMPT_NAME" in
    "" | *[!0-9]*) return 0 ;;
    esac
    ((${#PROMPT_NAME} <= 9)) || return 0
    idx=$((10#$PROMPT_NAME))
    ((idx >= 1 && idx <= n)) && PROMPT_NAME="${PICK_NAMES[$((idx - 1))]}"
    return 0
}

browse_playlists() {
    # Same toggle, same reason (see the BACK section): whichever store is on screen, its own
    # key is the way out of it. The cost is that switching playlist A -> B is two presses
    # rather than one; the alternative was one key that means "open" in one view and "leave"
    # in none, which is the one-way door this replaced.
    if [[ "$LIST_SOURCE" == "playlist" ]]; then
        back_to_search
        return 0
    fi
    have_store || return 0
    # An empty store is answered here rather than by prompting for a name that cannot exist —
    # the one branch `a` does not share, because there an empty store is where a list starts.
    list_playlists || return 0
    if [[ "$PL_LS_COUNT" == "0" ]]; then
        store_notice "$S_PL_ACT:" "$S_PL_NONE"
        return 0
    fi
    pick_playlist "$PL_LS_JSON" "$S_PL_OPEN" "$S_PL_PROMPT_OPEN" || { display_menu "$page_index"; return 0; }
    # An empty list answers with open_playlist's own S_PL_EMPTY and nothing more: it is
    # still a list, and deleting it is D's job (see reload_playlist).
    if ! open_playlist "$PROMPT_NAME"; then
        return 0
    fi
}

have_history() {
    [[ -n "$HISTORY_BIN" ]] && return 0
    store_notice "$S_HIST_ACT:" "$S_HIST_ABSENT"
    return 1
}

# Open the listening log as the row source (key: h). There is no new renderer and no new key
# handling, because a history row IS the item record a playlist holds — t-history derives
# duration_fmt on read for exactly this reason — so build_playlist_rows reads its envelope
# unchanged and every key that works on a stored row already works here.
#
# NO PROMPT, unlike b: the log is one thing, so there is nothing to name. 50 rows rather than
# t-history's own default 20 — this is a list to page through, not a line to glance at — and
# it is a constant, not a knob: a number a user would set once is only a setting when someone
# would set it differently, and pagination already answers "show me more".
open_history() {
    # The toggle. LIST_SOURCE tested literally, not through stored_rows: with a PLAYLIST on
    # screen `h` opens the log (that is not "back", it is the other store), and only the log
    # itself is what `h` closes.
    if [[ "$LIST_SOURCE" == "history" ]]; then
        back_to_search
        return 0
    fi
    have_history || return 0
    local out rc=0 cnt errfile
    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-hist-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-hist-err.$$"
    out=$("$HISTORY_BIN" --ls -n 50 -j 2>"$errfile") || rc=$?
    local msg; msg=$(<"$errfile")
    rm -f "$errfile"
    if ((rc != 0)); then
        msg=${msg##*$'\n'}
        msg=${msg#t-history: }
        store_notice "$S_HIST_ACT:" "${msg:-$S_PL_FAILED}"
        return 1
    fi
    cnt=$(printf '%s' "$out" | jq -r '.count // 0' 2>/dev/null || echo 0)
    if [[ "$cnt" == "0" ]]; then
        store_notice "$S_HIST_ACT:" "$S_HIST_EMPTY"
        return 1
    fi
    stash_search
    json="$out"
    LIST_SOURCE="history"
    # The same one-label rule a mixed playlist follows: the rows carry their own engine, and
    # the status line must not claim the session's for them.
    PLAYLIST_ENGINES=$(printf '%s' "$out" | jq -r '[.items[].engine] | unique | join("+")' 2>/dev/null) || PLAYLIST_ENGINES=""
    QUERY_LABEL="$S_HIST_LABEL"
    build_playlist_rows
    FILTER_LABEL=""
    FILTER_MODE=0
    selected=0
    page_index=1
    load_rows "$ALL_ROWS"
    return 0
}

# Open the RUNNING PLAYER'S QUEUE as the row source (key: u). The sixth row source and the
# fifth that replaces the rows temporarily, built like the other four: no new renderer, no new
# item shape, no second view. What it adds that none of them have is a WRITE side — the rows
# are the only thing on this screen the user can reorder — and every one of those writes goes
# out as a `t-play` verb. This file never touches queue-<id>.json: the state dir belongs to
# the player, the queue has a second writer inside it (the player's own child, advancing the
# position at every track boundary), and a rewrite from out here would go around the lock that
# makes the two safe.
#
# WHY THE WHOLE QUEUE AND NOT JUST THE TAIL. Showing only what is still waiting would start
# the row numbers at something other than the index the verbs take, and then the number on
# screen and the number in the envelope are two spellings of one thing with arithmetic
# between them. The played rows cost a line or two and are worth it on their own: scrolling
# up is how you see what just went by.
open_queue() {
    # The toggle, LIST_SOURCE tested literally exactly as open_history tests it.
    if [[ "$LIST_SOURCE" == "queue" ]]; then
        back_to_search
        return 0
    fi
    # The stash holds ONE view, and stash_search silently declines to overwrite it (its first
    # line is `stored_rows && return 0`). So opening the queue from ON TOP of a playlist would
    # keep the search in the slot and make `u` drop the user back on the search with the
    # playlist gone — a list vanishing with no way back and nothing said about it. The other
    # openers avoid this with search_only; this one says so out loud instead, because unlike
    # `c` and `i` it is not about the focused row, so "not here" needs a reason.
    if stored_rows; then
        store_notice "$S_Q_ACT:" "$S_Q_ELSEWHERE"
        return 1
    fi
    if [[ -z "$CURRENT_PLAY_ID" ]]; then
        store_notice "$S_Q_ACT:" "$S_Q_NONE"
        return 1
    fi
    local out rc=0 len errfile msg
    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-queue-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-queue-err.$$"
    out=$("$PLAY_BIN" --queue-show --id "$CURRENT_PLAY_ID" -j 2>"$errfile") || rc=$?
    msg=$(<"$errfile")
    rm -f "$errfile"
    if ((rc != 0)); then
        # The player died between the last tick and this keypress — the same race every other
        # player key runs, and it says the same thing they say.
        msg=${msg##*$'\n'}
        msg=${msg#t-play: }
        store_notice "$S_Q_ACT:" "${msg:-$S_Q_NONE}"
        return 1
    fi
    len=$(printf '%s' "$out" | jq -r '.len // 0' 2>/dev/null) || len=0
    # A queue of one is what EVERY detached player has (a lone handle is a queue of one), so
    # this is not an empty-store message — it is "there is nothing here you could act on".
    # Every key in the view would refuse: the only row is the playing one.
    if [[ "$len" == "0" || "$len" == "1" ]]; then
        store_notice "$S_Q_ACT:" "$S_Q_ONE"
        return 1
    fi
    stash_search
    json="$out"
    LIST_SOURCE="queue"
    # The same one-label rule a mixed playlist follows: a queue can mix engines per item, so
    # the status line must not claim the session's for them.
    PLAYLIST_ENGINES=$(printf '%s' "$out" | jq -r '[.items[].engine] | unique | join("+")' 2>/dev/null) || PLAYLIST_ENGINES=""
    QUERY_LABEL="$S_Q_LABEL"
    build_queue_rows
    FILTER_LABEL=""
    FILTER_MODE=0
    # The cursor opens ON THE TRACK THAT IS PLAYING, which is the row the user came here
    # thinking about; everything they might act on is below it. Rows are items one-for-one at
    # this instant (nothing is filtered yet), so `pos` is both the item index and the row.
    selected=$(printf '%s' "$out" | jq -r '.pos // 0' 2>/dev/null) || selected=0
    [[ "$selected" == *[!0-9]* || -z "$selected" ]] && selected=0
    page_index=$((selected / PAGE_SIZE + 1))
    load_rows "$ALL_ROWS"
    return 0
}

# Re-read the queue in place, after a verb that changed it. NOT back_to_search and not a
# second open_queue: the user is standing in this view and expects to still be in it, with the
# cursor near where they left it.
#
# The rebuild is unfiltered, exactly as reload_playlist's is after `d` — the row set just
# changed under the query, so re-running it would be answering a question about a list that no
# longer exists. Which makes `keep` an ITEM index rather than a row number: with the filter
# gone the two are the same thing, and the item index is the one every caller already holds
# exactly. Clamped, because the item it names may have been the last one.
reload_queue() {
    local keep=$1 out rc=0 len
    out=$("$PLAY_BIN" --queue-show --id "$CURRENT_PLAY_ID" -j 2>/dev/null) || rc=$?
    if ((rc != 0)); then
        # The player is gone, so there is no queue to stand in any more.
        back_to_search
        store_notice "$S_Q_ACT:" "$S_Q_NONE"
        return 0
    fi
    len=$(printf '%s' "$out" | jq -r '.len // 0' 2>/dev/null) || len=0
    json="$out"
    PLAYLIST_ENGINES=$(printf '%s' "$out" | jq -r '[.items[].engine] | unique | join("+")' 2>/dev/null) || PLAYLIST_ENGINES=""
    build_queue_rows
    FILTER_LABEL=""
    FILTER_MODE=0
    load_rows "$ALL_ROWS"
    ((keep < NUM_ENTRIES)) || keep=$((NUM_ENTRIES - 1))
    ((keep >= 0)) || keep=0
    selected=$keep
    page_index=$((selected / PAGE_SIZE + 1))
    return 0
}

# The index the queue verbs take, for the row under the cursor — and the pin that goes with
# it. Two out-params because they travel together: an index without the url it was read
# beside is exactly the guess --expect-url exists to refuse.
#
# The index comes from the ROW (R_N) rather than from focused_index's url-plus-occurrence
# walk, and that is not a shortcut, it is the more exact answer: the queue is the one source
# whose items carry their own index, so there is nothing to reconstruct. The walk exists
# because a playlist envelope has no such field.
Q_ROW_INDEX=""
Q_ROW_URL=""
queue_row_target() {
    Q_ROW_INDEX=""
    Q_ROW_URL=""
    ((NUM_ENTRIES > 0)) || return 1
    local n="${R_N[$selected]:-}" u="${urls[$selected]:-}"
    [[ -n "$n" && "$n" != *[!0-9]* && -n "$u" ]] || return 1
    Q_ROW_INDEX="$n"
    Q_ROW_URL="$u"
    return 0
}

# Every queue write goes through here: run the verb, and turn what comes back into either a
# fresh view or one line of prose. The verb's own envelope is not parsed for the new rows —
# the view is re-read from --queue-show afterwards — because the player is the only thing that
# knows what the queue is now, and a screen built from what a call ASKED for is a screen that
# can disagree with the player.
#
# queue_stale is the one failure with its own message: it means the queue moved under the
# user (a track ended between the keypress and the write), and the honest response is to show
# them what it looks like now rather than to explain. The reload is what makes the refusal
# harmless, which is what lets the pin be mandatory.
Q_UNDO_LABEL=""
queue_verb() {
    local keep=$1; shift
    local out rc=0 errfile msg reason undo_label="$Q_UNDO_LABEL"
    Q_UNDO_LABEL=""
    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-queue-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-queue-err.$$"
    out=$("$PLAY_BIN" "$@" --id "$CURRENT_PLAY_ID" -j 2>"$errfile") || rc=$?
    msg=$(<"$errfile")
    rm -f "$errfile"
    if ((rc != 0)); then
        reason=$(printf '%s' "$out" | jq -r '.reason // ""' 2>/dev/null) || reason=""
        if [[ "$reason" == "queue_stale" || "$reason" == "queue_range" ]]; then
            reload_queue "$keep"
            store_notice "$S_Q_ACT:" "$S_Q_STALE"
            return 0
        fi
        msg=${msg##*$'\n'}
        msg=${msg#t-play: }
        store_notice "$S_Q_ACT:" "${msg:-$S_PL_FAILED}"
        return 0
    fi
    # The envelope carries the player's own {pos,len,next,upcoming}, so the banner and the
    # status line follow the write without waiting for the next tick.
    apply_player_record "$out"
    reload_queue "$keep"
    # The two callers that pass --owner name what they did in Q_UNDO_LABEL (taken on entry, so
    # a call that failed cannot leave it for the next one); the offer is made here, after the
    # reload, because it is the store's envelope that carries it.
    if [[ -n "$undo_label" ]]; then
        undo_arm queue "$out" "$S_Q_ACT:" "$undo_label" || true
    fi
    return 0
}

# `x` — drop the focused waiting track. No confirmation, and this was the key that showed none
# was needed: removing the wrong one is cheap to reverse. `z` reverses it exactly, in its own
# slot, which `+` could not. The refusal that DOES matter is the one below it.
queue_remove() {
    queue_row_target || { store_notice "$S_Q_ACT:" "$S_PL_FAILED"; return 0; }
    # Answered here rather than left to the player's queue_range, because this is the one
    # refusal a user will meet by accident — the cursor opens on this very row — and "that one
    # is playing, here is what stops it" is worth more than a generic failure.
    if [[ "$Q_ROW_INDEX" == "$CURRENT_QUEUE_POS" ]]; then
        store_notice "$S_Q_ACT:" "$S_Q_PLAYING_ROW"
        return 0
    fi
    # The cursor stays on the SLOT, not on the track: what lands under it is whatever moved
    # up into the gap, which is the next thing the user was going to consider.
    Q_UNDO_LABEL="$S_Q_REMOVED $GL_ARROW ${R_TITLE[$selected]:-}"
    queue_verb "$Q_ROW_INDEX" --queue-rm "$Q_ROW_INDEX" --expect-url "$Q_ROW_URL" --owner $$
    return 0
}

# `X` — drop everything still waiting. It used to be the one queue key that asked first,
# because nothing short of re-adding every track could reverse it; `z` reverses it in one key,
# so it asks nothing, like `D`.
queue_clear() {
    ((NUM_ENTRIES > 0)) || return 0
    # Only the played rows and the playing one survive, so the cursor goes to the last of them.
    Q_UNDO_LABEL="$S_Q_CLEARED"
    queue_verb "$CURRENT_QUEUE_POS" --queue-clear --owner $$
    return 0
}

# `p` / `P` — one slot earlier, one slot later. The same physical key in two registers, for
# the reason `-`/`=` are one rocker: they are one operation with a direction. Both are a
# --queue-mv, because "up one" and "down one" are destinations and the player has one verb
# for a destination.
#
# The cursor FOLLOWS the row it moved, which is what makes the key repeatable: pressing `p`
# three times walks a track up three slots instead of moving three different tracks once.
queue_move() {
    local dir=$1 to
    queue_row_target || { store_notice "$S_Q_ACT:" "$S_PL_FAILED"; return 0; }
    to=$((Q_ROW_INDEX + dir))
    # Both ends are the player's to enforce (it decides against the pos it has RIGHT NOW), but
    # a move off the end is a key the user pressed at a boundary rather than a call that went
    # wrong — so it is a quiet no-op here instead of a notice that says the obvious.
    ((to > CURRENT_QUEUE_POS)) || return 0
    ((to < NUM_ENTRIES)) || return 0
    queue_verb "$to" --queue-mv "$Q_ROW_INDEX" --to "$to" --expect-url "$Q_ROW_URL"
    return 0
}

# Enter, in the queue view only: play this one NOW. The queue's own Enter, and it does not
# mean what Enter means on a search row — there it launches a player, here there already is
# one and the row is a track it is going to reach anyway. Jumping is the queue's verb for
# "sooner", so this is --queue-jump and not a fresh play_selected, which would strand the
# queue and start a second player over the top of it.
play_queued_now() {
    queue_row_target || { store_notice "$S_Q_ACT:" "$S_PL_FAILED"; return 0; }
    if [[ "$Q_ROW_INDEX" == "$CURRENT_QUEUE_POS" ]]; then
        # Already the one playing. Nothing to do, and nothing worth saying about it.
        return 0
    fi
    # It lands at pos+1 and pos moves onto it, so that is where the cursor goes: still on the
    # track that is playing, which is where this view opens.
    queue_verb "$((CURRENT_QUEUE_POS + 1))" --queue-jump "$Q_ROW_INDEX" --expect-url "$Q_ROW_URL"
    return 0
}

# Open the focused row's parts (?p=N) as the row source (key: c). Third of the row-source
# family — b, h and c all do one job, replace the rows — and built like the other two: no new
# renderer, no new keys, no new item shape. A video's parts are its items, so `t-play --items`
# answers with the same container envelope a playlist has, and no adaptation at all is needed:
# build_playlist_rows walks the envelope unchanged, focused_payload cuts one item out of it
# unchanged, and every key that already works on a stored row works here.
#
# SEARCH ROWS ONLY, through search_only — the guard o and e already use, not a new one.
# stash_search has a single slot, so opening a part list from a playlist row would either
# lose the way back to the search or need a stack, and a stack is its own change on its own
# day (the one-deep return stack is ARCH-cli-contract.md「命令规格」).
#
# ONE fork on the KEY, never on the selection moving. Whether the key is offered at all was
# answered at the last source switch (refresh_engine_flags), so this costs nothing per redraw.
# The fetch behind `c`, and the twin of fetch_item_info — same single slot, same spinner,
# same error vocabulary, and a function for the same reason that one is: THE CACHE IS THE
# POINT. `c` asks "is there more of this than the row shows?", and on a one-part video the
# answer is no — an answer bought with a real round trip, which pressing the key again must
# not buy a second time (ROADMAP.md「横切规范」付了的代价不丢). `i` has had this since it
# shipped; `c` did not, so a second press paid again for a no it already owned.
#
# The round trip is unavoidable and that is measured, not assumed: 2026-09-03, nothing in a
# search page separates a multi-part row from a single one — a real 200-part row comes back
# with the same empty `episode_count_text`, the same `is_union_video: 0`, the same key set as
# a five-minute MV, and the site's own count lives one request per row away. So `c` is a
# QUESTION key by construction, and what a question key owes is that its answer is cheap the
# second time.
#
# The spinner is here for the reason `i` prints one: this is a moment the TUI has nothing to
# draw, and a key that freezes with no feedback reads as a key that was not received. The
# frame after it is a full in-place repaint, so the line needs no cleanup.
PARTS_CACHE_KEY=""
PARTS_CACHE_JSON=""
fetch_item_parts() {
    local eng=$1 url=$2 key out rc=0 errfile msg
    key="$eng:$url"
    if [[ "$key" != "$PARTS_CACHE_KEY" || -z "$PARTS_CACHE_JSON" ]]; then
        errfile=$(mktemp "${TMPDIR:-/tmp}/ting-parts-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-parts-err.$$"
        printf '\n  %s%s%s' "$C_DIM" "$S_PARTS_ACT$GL_ELL" "$C_RESET"
        spin_start
        out=$(engine_verb "$eng" --items -j -- "$url" 2>"$errfile") || rc=$?
        spin_stop
        msg=$(<"$errfile")
        rm -f "$errfile"
        if ((rc != 0)) || [[ -z "$out" ]]; then
            msg=$(engine_msg "$eng" "$msg")
            store_notice "$S_PARTS_ACT:" "${msg:-$S_PL_FAILED}"
            return 1
        fi
        PARTS_CACHE_KEY="$key"
        PARTS_CACHE_JSON="$out"
    fi
    return 0
}

PARTS_TOTAL_FMT=""
open_parts() {
    # The toggle, tested literally for the reason open_history gives: with a part list on
    # screen `c` is the way back, and a part list is the only thing `c` closes.
    if [[ "$LIST_SOURCE" == "parts" ]]; then
        back_to_search
        return 0
    fi
    # Typed blind on an engine without the verb: nothing, silently — the same answer `e`
    # gives on a single-engine install, and for the same reason (the hints never offered it).
    ((ENGINE_PARTS_OK)) || return 0
    ((NUM_ENTRIES > 0)) || return 0
    search_only || return 0

    local url="${urls[$selected]}" row_engine out cnt title reshaped
    # The ROW's engine, the way play_selected reads it. Under search_only every row carries
    # the session engine, so the two agree today; reading the row is what keeps them agreeing
    # if that ever stops being true.
    row_engine="${R_ENGINE[$selected]:-}"
    [[ -n "$row_engine" ]] || row_engine="$CURRENT_ENGINE"
    fetch_item_parts "$row_engine" "$url" || return 1
    out="$PARTS_CACHE_JSON"
    cnt=$(printf '%s' "$out" | jq -r '.total // .count // 0' 2>/dev/null || echo 0)
    # One part is not an error — the engine says so by answering total 1 rather than failing —
    # and it is not a view either: the row already on screen IS that one part, so opening a
    # one-row list would cost a keypress and a redraw to say nothing. The notice answers the
    # question the key actually asks, which is "is there more of this than the row shows?".
    if [[ "$cnt" == "0" || "$cnt" == "1" ]]; then
        store_notice "$S_PARTS_ACT:" "$S_PARTS_ONE"
        return 1
    fi
    # The collection's own two facts: the title is this view's label, and the total length is
    # the number the search row was showing (P8). The envelope no longer carries that sum, so
    # it is added up here — and only when every part is in hand (no has_more) and has a
    # length, because a partial sum shown as "total" would be a wrong number.
    title=$(printf '%s' "$out" | jq -r '.title // empty' 2>/dev/null) || title=""
    PARTS_TOTAL_FMT=$(printf '%s' "$out" | jq -r "$JQ_TEXT_DEFS"'
        if .has_more != true and (.items | length) > 0 and all(.items[]; (.duration | type) == "number")
        then [.items[].duration] | add | fmt_dur else empty end' 2>/dev/null) || PARTS_TOTAL_FMT=""
    [[ -n "$title" ]] || title="${R_TITLE[$selected]}"
    # The envelope as-is: `t-play --items -j | t-playlist --add` is the agent surface's same
    # pipe, so a shell caller and the TUI read it identically. Checked BEFORE the stash: an
    # unreadable one after it would leave the search stashed behind rows that do not exist.
    reshaped=$(printf '%s' "$out" | jq -ce 'select((.items | type) == "array")' 2>/dev/null) || reshaped=""
    if [[ -z "$reshaped" ]]; then
        store_notice "$S_PARTS_ACT:" "$S_PL_FAILED"
        return 1
    fi

    stash_search
    json="$reshaped"
    LIST_SOURCE="parts"
    # One label for the list, the rule a mixed playlist follows. A part list is single-engine
    # by construction; it is computed rather than assumed for the reason the other two compute
    # it — the status line must read the rows, not the session.
    PLAYLIST_ENGINES=$(printf '%s' "$json" | jq -r '[.items[].engine] | unique | join("+")' 2>/dev/null) || PLAYLIST_ENGINES=""
    QUERY_LABEL="$title"
    build_playlist_rows
    FILTER_LABEL=""
    FILTER_MODE=0
    selected=0
    page_index=1
    load_rows "$ALL_ROWS"
    return 0
}

# ── The focused row's chapters as the row source (key: i) ───────────────────────────────
# Fourth of the row-source family — b, h, c and i all do one job, replace the rows — and
# built like the other three: no new renderer, no new keys, no new item shape. The chapter
# table `--info` already returns becomes the same ten-field row a search does, so every key
# that works on a stored row works here, and a chapter row is a CALL (chapter_url).
#
# One fetch, on the KEY — never on the selection moving, the constraint `c` and the ←/→ edge
# fetch already respect. That fetch is also what keeps this view from being a repeat of the
# details block: entering costs a round trip, so what comes back is something the list did
# not already hold.
#
# SEARCH ROWS ONLY, through search_only — the guard o, e and c already use, not a new one.
# stash_search has a single slot, so opening a chapter list from a playlist row would either
# lose the way back to the search or need a stack, and a stack is its own change on its own
# day (the one-deep return stack is ARCH-cli-contract.md「命令规格」).
open_chapters() {
    # The toggle, tested literally for the reason open_history and open_parts give: with a
    # chapter list on screen `i` is the way back, and a chapter list is the only thing `i`
    # closes.
    if [[ "$LIST_SOURCE" == "chapters" ]]; then
        back_to_search
        return 0
    fi
    ((NUM_ENTRIES > 0)) || return 0
    # Typed blind on an engine without the verb: nothing, silently — the answer `e` gives on a
    # single-engine install, and for the same reason (the hints never offered it).
    ((ENGINE_INFO_OK)) || return 0
    search_only || return 0
    local url="${urls[$selected]}" row_engine
    # The ROW's engine, the way play_selected and open_parts read it: a mixed playlist plays
    # either source correctly, so it must describe either source correctly too.
    row_engine="${R_ENGINE[$selected]:-}"
    [[ -n "$row_engine" ]] || row_engine="$CURRENT_ENGINE"
    fetch_item_info "$row_engine" "$url" || return 1
    # No chapters is not an error and it is not a view either — an empty list would cost a
    # keypress and a redraw to say nothing, and there is no second axis on this screen to fall
    # back to (quality is `f`, parts are `c`). The notice answers the question the key asks,
    # exactly as `c` answers "is there more of this than the row shows?" with S_PARTS_ONE.
    if ((ITEM_CHAP_N == 0)); then
        store_notice "$S_INFO_ACT:" "$S_CHAP_NONE"
        return 1
    fi
    # Built BEFORE the stash, the order open_parts takes: a build that failed after it would
    # leave the search stashed behind rows that do not exist. It writes CHAP_JSON and nothing
    # else, so a failure here leaves the search on screen untouched.
    if ! build_chapter_rows; then
        store_notice "$S_INFO_ACT:" "$S_PL_FAILED"
        return 1
    fi
    stash_search
    json="$CHAP_JSON"
    LIST_SOURCE="chapters"
    # Single-engine by construction — every row is an offset into ONE item — so the label is
    # that item's engine rather than a jq pass over rows this file just wrote itself.
    PLAYLIST_ENGINES="$ITEM_ENGINE"
    QUERY_LABEL="$ITEM_TITLE"
    build_playlist_rows
    FILTER_LABEL=""
    FILTER_MODE=0
    selected=0
    page_index=1
    load_rows "$ALL_ROWS"
    # The view opens ON the chapter that is playing, when the player holds this item — the
    # same rule chapter_follow enforces from then on, applied once at the door rather than
    # waited a tick for. Row 1 with the track in chapter 9 is the frozen-view symptom in its
    # opening frame, and it also parks the cursor where no boundary crossing can reach it.
    # The anchor is reset HERE, not in chapter_follow's guard: this function is the one place
    # a chapter list begins, so re-opening the same item cannot inherit the last visit's.
    CHAP_FOLLOW_SEC=""
    chapter_follow
    return 0
}

# Enter on a chapter row: "start playing from here". Two branches, one meaning. If the player
# already holds THIS item, the offset is a seek inside the file it has open — nothing is
# re-resolved, which is what separates this axis from parts and from quality
# (ARCH-tui.md); otherwise the row plays like any other row, and the `t=` its url
# carries is what the engine turns into start_seconds.
play_chapter() {
    ((NUM_ENTRIES > 0)) || return 0
    local url="${urls[$selected]}" cur eng="${R_ENGINE[$selected]:-}"
    if [[ -n "$CURRENT_PLAY_ID" ]] && chapter_sec "$url"; then
        # The pair, not the url alone: a record is {engine, url} everywhere else in this file,
        # and "the player already holds this item" is a question about the call.
        handle_key "$CURRENT_PLAY_URL"; cur="$HANDLE_KEY"
        handle_key "$url"
        if [[ -n "$cur" && "$cur" == "$HANDLE_KEY" && "$eng" == "$CURRENT_PLAY_ENGINE" ]]; then
            play_verb --seek-to "$CHAP_SEC" >/dev/null
            return 0
        fi
    fi
    play_selected
}

# The other half of the chapter view: the CURSOR follows the playhead over a chapter boundary.
# Without it the view freezes — a chapter that ended stays selected and stays marked on the
# bar, while the chapter now playing has nothing on screen saying so. What was missing is
# that the selection is the thing the item's own clock moves.
#
# Follow, not jump: the user's cursor wins the moment they use it. CHAP_FOLLOW_SEC remembers
# which chapter the playhead was in at the last look, and the selection is moved only when it
# is still parked on THAT one — browse two chapters down while the track plays and nothing is
# taken away from you. Held as the start SECOND, never as an index, for the reason chapter_sec
# exists: the live filter and paging reorder the rows, and an index would point at a different
# chapter one keystroke later.
#
# Anchored on ITEM_URL/ITEM_ENGINE rather than on the selected row, because the question is
# about the VIEW — every row here is an offset into one item — and the answer must not change
# as the cursor moves. It is otherwise the same {engine, url} pair chapter_span and play_chapter
# ask, so all three agree on what "the player holds this item" means.
#
# Called from the menu loop ahead of the page clamp, so page_index is set HERE: a selection the
# loop then clamps back into the old page is a selection that did not move. The derivation is
# display_menu's own (`selected / PAGE_SIZE + 1`) — a chapter list long enough to page follows
# across the page break too.
CHAP_FOLLOW_SEC=""
chapter_follow() {
    local i j sec="" cur
    [[ "$LIST_SOURCE" == "chapters" ]] || return 0
    [[ -n "$CURRENT_PLAY_ID" && -n "$PT_POS_SEC" ]] || return 0
    # if-form, not an AND-list: house rule for an arithmetic test (see player_check_ready).
    if ((CURRENT_PLAY_IS_LIVE)); then return 0; fi
    ((ITEM_CHAP_N > 0 && NUM_ENTRIES > 0)) || return 0
    handle_key "$CURRENT_PLAY_URL"; cur="$HANDLE_KEY"
    handle_key "$ITEM_URL"
    [[ -n "$cur" && "$cur" == "$HANDLE_KEY" ]] || return 0
    [[ "$CURRENT_PLAY_ENGINE" == "$ITEM_ENGINE" ]] || return 0
    # Where the playhead is: the LAST start at or before it. The table is the engine's own
    # order, so the walk stops at the first start in the future — and a position before the
    # first chapter (an engine whose table does not begin at 0) leaves sec empty, which is
    # "no answer" and not chapter 1.
    for ((j = 0; j < ITEM_CHAP_N; j++)); do
        ((${ITEM_CHAP_SEC[$j]} <= PT_POS_SEC)) || break
        sec="${ITEM_CHAP_SEC[$j]}"
    done
    [[ -n "$sec" ]] || return 0
    [[ "$sec" != "$CHAP_FOLLOW_SEC" ]] || return 0
    # A boundary was crossed. Whether or not the cursor comes along, the new chapter is what
    # the next crossing is measured against — a user who wandered off must not be dragged back
    # by the crossing after this one.
    if [[ -n "$CHAP_FOLLOW_SEC" ]]; then
        if ! chapter_sec "${urls[$selected]}" || [[ "$CHAP_SEC" != "$CHAP_FOLLOW_SEC" ]]; then
            CHAP_FOLLOW_SEC="$sec"
            return 0
        fi
    fi
    CHAP_FOLLOW_SEC="$sec"
    for ((i = 0; i < NUM_ENTRIES; i++)); do
        chapter_sec "${urls[$i]}" || continue
        if [[ "$CHAP_SEC" == "$sec" ]]; then
            selected=$i
            page_index=$(( i / PAGE_SIZE + 1 ))
            return 0
        fi
    done
    # The row is not on screen — a live filter is up and it does not match. The cursor stays
    # where the user left it; the line above already moved the anchor, so the filter being
    # cleared later resumes the follow from wherever the playhead is by then.
    return 0
}

# The fetch behind `i`: one `--info`, one single-slot cache, one set of ITEM_* fields. It is
# a function rather than an inline block in open_chapters because the cache is the point —
# pressing i on the same row twice must not pay a second round trip, and the store verbs in
# this file already keep their spinner, their error vocabulary and their cache key in one
# place each.
fetch_item_info() {
    local eng=$1 url=$2 key out rc=0 errfile msg
    key="$eng:$url"
    if [[ "$key" != "$INFO_CACHE_KEY" || -z "$INFO_CACHE_JSON" ]]; then
        errfile=$(mktemp "${TMPDIR:-/tmp}/ting-info-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-info-err.$$"
        # The search spinner, not a still line: this is the other moment the TUI has nothing to
        # draw, and the label is printed by the caller exactly as fetch_json's callers print
        # theirs. The frame after this is a full in-place repaint, so the line needs no cleanup.
        printf '\n  %s%s%s' "$C_DIM" "$S_INFO_ACT$GL_ELL" "$C_RESET"
        spin_start
        out=$(engine_verb "$eng" --info -j -- "$url" 2>"$errfile") || rc=$?
        spin_stop
        msg=$(<"$errfile")
        rm -f "$errfile"
        if ((rc != 0)) || [[ -z "$out" ]]; then
            msg=$(engine_msg "$eng" "$msg")
            store_notice "$S_INFO_ACT:" "${msg:-$S_PL_FAILED}"
            return 1
        fi
        INFO_CACHE_KEY="$key"
        INFO_CACHE_JSON="$out"
    fi
    apply_item_info "$eng" "$url" || {
        store_notice "$S_INFO_ACT:" "$S_PL_FAILED"
        return 1
    }
    return 0
}

# Do the ITEM_* fields describe the row the cursor is ON? The {engine, url} pair, asked the
# way chapter_span and play_chapter ask it — handle_key drops the `t=`, so a chapter row and
# the search row it came from answer the same, which is what makes ONE predicate serve both
# views. In the search view only the row `i` was actually pressed on matches; in a chapter
# list every row does.
#
# This is what lets a chapterless `i` keep what it paid for. It is a question about the
# CURSOR, not about the fetch: move off that row and the fields stop being drawn, while the
# single-slot cache stays, so pressing `i` there again still costs no round trip
# (fetch_item_info). ITEM_TITLE is in the guard because apply_item_info refuses a record
# without one — an empty ITEM_URL with a stale title would otherwise match a row by accident.
info_is_focused() {
    local cur
    [[ -n "$ITEM_URL" && -n "$ITEM_TITLE" ]] || return 1
    ((NUM_ENTRIES > 0)) || return 1
    [[ "${R_ENGINE[$selected]:-}" == "$ITEM_ENGINE" ]] || return 1
    handle_key "$ITEM_URL"; cur="$HANDLE_KEY"
    handle_key "${urls[$selected]}"
    [[ -n "$cur" && "$cur" == "$HANDLE_KEY" ]]
}

# The `--info` envelope into the item fields. ONE jq call, US-joined, the way every other
# envelope read in this file works. It reads FOUR fields and not the eight it used to: the
# view count, the channel and the duration are already on the row this key was pressed from,
# and the description has nowhere to go now that the rows below are the chapter table (D-g) —
# a field nothing draws is a field nothing should read, and the description was also the one
# free-text value in the read (with IFS=US the last variable takes the whole remainder).
apply_item_info() {
    local eng=$1 url=$2 csec ctitle
    IFS="$US" read -r ITEM_TITLE ITEM_UPLOADED ITEM_LIKES < <(
        printf '%s' "$INFO_CACHE_JSON" | jq -r "$JQ_TEXT_DEFS"'[
            (.title // "" | clean),
            (.upload_date // "" | if length == 8 then .[0:4] + "-" + .[4:6] + "-" + .[6:8] else . end),
            (.like_count // "" | tostring)
          ] | join("\u001f")' 2>/dev/null
    ) || return 1
    # A record with no title is not a record: the envelope was not what it claimed, and `i`
    # would open onto rows labelled with nothing.
    [[ -n "$ITEM_TITLE" ]] || return 1
    ITEM_ENGINE="$eng"
    ITEM_URL="$url"
    # The chapter table, read on its own because it is a LIST and the US-joined read above is
    # a record. The start second is FLOORED here rather than at the row: `t=726.855` is a
    # legal handle, but the same number is also the row's printed time and the --seek-to
    # target, and one chapter having three spellings is how a row comes to disagree with the
    # player. A whole second is under the granularity of all three. The times are NOT
    # pre-formatted any more — the rows carry the engine's wire spelling and the rail's own
    # short_dur renders it, which is one fmt_sec fork per chapter that no longer happens.
    #
    # The END comes back in the same pass. A chapter is a SPAN, and the rail prints it as
    # one (`2:30 → 5:42`), which is the whole reason the column is no longer readable as a
    # duration; the length it implies is also the only honest `duration` for a row that `a`
    # can store and `+` can queue. `end_time` is yt-dlp's own field — derived here it would
    # be the NEXT row's start, which filtering reorders out from under it.
    ITEM_CHAP_SEC=()
    ITEM_CHAP_END=()
    ITEM_CHAP_TITLE=()
    while IFS="$US" read -r csec cend ctitle; do
        [[ "$csec" =~ ^[0-9]+$ ]] || continue
        ITEM_CHAP_SEC+=("$csec")
        [[ "$cend" =~ ^[0-9]+$ ]] || cend=""
        ITEM_CHAP_END+=("$cend")
        ITEM_CHAP_TITLE+=("$ctitle")
    done < <(
        printf '%s' "$INFO_CACHE_JSON" | jq -r "$JQ_TEXT_DEFS"'(.chapters // [])[]
            | "\((.start_time // 0) | floor)\u001f\(if .end_time == null then "" else (.end_time | floor) end)\u001f\(.title // "" | oneline)"' 2>/dev/null
    )
    ITEM_CHAP_N=${#ITEM_CHAP_SEC[@]}
    return 0
}

# ── MODE action (key: v) ────────────────────────────────────────────────────────────────
cycle_mode() {
    local i n=${#MODE_CYCLE[@]} cur=0
    for (( i = 0; i < n; i++ )); do
        [[ "${MODE_CYCLE[$i]}" == "$PLAY_MODE" ]] && { cur=$i; break; }
    done
    PLAY_MODE="${MODE_CYCLE[$(( (cur + 1) % n ))]}"
    mark_pref TING_PLAY_MODE
}

# ── QUALITY action (key: f) ─────────────────────────────────────────────────────────────
# The same shape as cycle_mode and for the same reason: a tier is a parameter of the NEXT
# launch, so nothing on screen has to be re-fetched and the player already running keeps the
# stream it resolved. What it selects is a (mode, tier) row in the ENGINE's format-sort table
# — this file never learns a yt-dlp expression, which is the whole point of a named tier
# (ARCH-engine.md「解析」). A value not in the cycle (set by config or the environment,
# e.g. `low` under
# the shipped cycle) leaves cur at 0, so the first press joins the rotation at its head.
cycle_quality() {
    local i n=${#QUALITY_CYCLE[@]} cur=0
    for (( i = 0; i < n; i++ )); do
        [[ "${QUALITY_CYCLE[$i]}" == "$PLAY_QUALITY" ]] && { cur=$i; break; }
    done
    PLAY_QUALITY="${QUALITY_CYCLE[$(( (cur + 1) % n ))]}"
    mark_pref TING_PLAY_QUALITY
}

# ── LOOP action (key: r) ────────────────────────────────────────────────────────────────
# The same rotation as the two above, plus one thing they do not do: it pushes the REPEAT
# half at the player that is already running, because repeat is a property of a track that
# is playing right now and waiting for the next Enter to apply it would be a badge that
# disagrees with the speakers. `seq` maps to the player's `off`: as far as t-play is
# concerned those two are one state, and the difference between them is which rows the NEXT
# launch packs into the queue.
#
# Which is also why `seq` says so out loud. Switching to it mid-playback deliberately does
# NOT enqueue the rest of the list behind the current track: pressing r twice more would
# then append it a second time, and there is no verb that takes a queued item back out —
# ROADMAP.md「还没定的事」 is still holding that whole question open, and a key that quietly
# settles it is not a key, it is a decision. So the notice names the moment it applies.
cycle_loop_mode() {
    local i n=${#LOOP_CYCLE[@]} cur=0 pushed
    for (( i = 0; i < n; i++ )); do
        [[ "${LOOP_CYCLE[$i]}" == "$LOOP_MODE" ]] && { cur=$i; break; }
    done
    LOOP_MODE="${LOOP_CYCLE[$(( (cur + 1) % n ))]}"
    mark_pref TING_LOOP_MODE
    if [[ -n "$CURRENT_PLAY_ID" ]]; then
        if [[ "$LOOP_MODE" == "one" ]]; then pushed=one; else pushed=off; fi
        # Best effort, like every other one-shot the banner fires: the player may have ended
        # between the keypress and here, and check_player_alive is the one place that gets to
        # say so.
        "$PLAY_BIN" --set-loop "$pushed" --id "$CURRENT_PLAY_ID" -j >/dev/null 2>&1 || true
    fi
    case "$LOOP_MODE" in
    one) store_notice "$S_LOOP_ACT:" "$S_LOOP_ONE" ;;
    seq) store_notice "$S_LOOP_ACT:" "$S_LOOP_SEQ$S_LOOP_NEXT" ;;
    *) store_notice "$S_LOOP_ACT:" "$S_LOOP_OFF" ;;
    esac
}

# One failure path for the re-fetch actions (n / → / o / e). It replaces three copies of this
# block that had already drifted in wording — the count and sort keys said "no results"
# where n said 'no results for "…"' — the standard signal that a block wants to be a function.
# rc is fetch_json's: 2 means the search ran and matched nothing, anything else means it failed
# and SEARCH_ERR holds the core's own sentence. The query is passed in rather than read off
# QUERY_LABEL because every caller restores its own mutated global BEFORE reporting, so by the
# time we run the label is already back to the one that still works.
report_fetch_failure() {
    local rc="$1" q="${2:-}" text
    if ((rc == 2)); then
        if [[ -n "$q" ]]; then
            text="no results for \"$q\""
        else
            text="no results"
        fi
    else
        text="${SEARCH_ERR:-search failed}"
    fi
    store_notice "$S_SEARCH_ACT:" "$text"
}

# ── URL LOADER (direct paste / URL query) ────────────────────────────────────────────────
# Checks if string looks like an HTTP/HTTPS URL or well-known shortlink
is_url_target() {
    case "$1" in
    http://* | https://* | www.* | youtu.be/* | b23.tv/* | 163cn.tv/*) return 0 ;;
    esac
    return 1
}

# Extracts clean URL from target string (stripping quotes, mobile share fluff)
extract_url_target() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    s="${s%\"}"; s="${s#\"}"
    s="${s%\'}"; s="${s#\'}"
    if [[ "$s" == *"https://"* ]]; then
        s="${s#*https://}"
        s="https://${s}"
        s="${s%%[[:space:]]*}"
        s="${s%%[\"\'\<\>\(\)]*}"
    elif [[ "$s" == *"http://"* ]]; then
        s="${s#*http://}"
        s="http://${s}"
        s="${s%%[[:space:]]*}"
        s="${s%%[\"\'\<\>\(\)]*}"
    fi
    printf '%s' "$s"
}

# Extracts clean lowercase host from URL or host string
url_extract_host() {
    local h=$1
    h="${h#*://}"
    h="${h%%/*}"
    h="${h%%\?*}"
    h="${h%%#*}"
    h="${h##*@}"
    h="${h%%:*}"
    printf '%s' "$h" | tr 'A-Z' 'a-z'
}

# Matches host to known engine: yt | bili | ne
sniff_engine_from_url() {
    local host
    host=$(url_extract_host "$1")
    case "$host" in
    youtube.com | youtu.be | youtube-nocookie.com | \
    *.youtube.com | *.youtu.be | *.youtube-nocookie.com)
        printf 'yt'
        return 0
        ;;
    bilibili.com | b23.tv | \
    *.bilibili.com | *.b23.tv)
        printf 'bili'
        return 0
        ;;
    music.163.com | y.music.163.com | 163cn.tv | \
    *.music.163.com | *.163cn.tv)
        printf 'ne'
        return 0
        ;;
    esac
    return 1
}

# Distinguishes container vs track URLs based on pattern
sniff_target_kind() {
    local eng=$1 u=$2
    case "$eng" in
    yt)
        case "$u" in
        *"/watch"* | *"youtu.be/"*) printf 'track'; return 0 ;;
        *"/playlist"* | *"list=PL"* | *"list=OLAK5uy_"* | *"list=UU"* | *"list=FL"*)
            printf 'container'; return 0 ;;
        *"youtube.com/@"* | *"youtube.com/channel/"* | *"youtube.com/c/"* | *"youtube.com/user/"*)
            printf 'container'; return 0 ;;
        esac
        ;;
    bili)
        case "$u" in
        *"/audio/am"* | *"am"[0-9]* | *"/medialist/"* | *"ml"[0-9]* | *"type=season"* | *"collectiondetail"*)
            printf 'container'; return 0 ;;
        esac
        ;;
    ne)
        case "$u" in
        *"/album"* | *"/playlist"*)
            printf 'container'; return 0 ;;
        esac
        ;;
    esac
    printf 'track'
    return 0
}

load_container_url() {
    local eng=$1 target_url=$2 out errfile rc=0
    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-url-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-url-err.$$"
    spin_start
    printf '\n%s%s %s...%s' "$C_BOLD" "$GL_CARET" "$S_CONTAINER_ACT" "$C_RESET"
    out=$(engine_verb "$eng" --items -j -- "$target_url" 2>"$errfile") || rc=$?
    spin_stop
    local err_msg; err_msg=$(<"$errfile"); rm -f "$errfile"
    if ((rc != 0)); then
        if [[ "$err_msg" == *"not a"* || "$err_msg" == *"drop --items"* || "$err_msg" == *"video id"* || "$err_msg" == *"BV id"* ]]; then
            load_track_url "$eng" "$target_url" 1
            return $?
        fi
        err_msg=$(engine_msg "$eng" "$err_msg")
        store_notice "$S_CONTAINER_ACT:" "${err_msg:-failed to expand container}"
        return 1
    fi
    local cnt
    cnt=$(printf '%s' "$out" | jq -r '.count // 0' 2>/dev/null || echo 0)
    if [[ "$cnt" == "0" ]]; then
        store_notice "$S_CONTAINER_ACT:" "$S_PL_EMPTY"
        return 1
    fi

    stash_search
    json="$out"
    LIST_SOURCE="playlist"
    local title
    title=$(printf '%s' "$out" | jq -r '.title // empty' 2>/dev/null) || title=""
    [[ -n "$title" ]] || title="Container"
    PLAYLIST_NAME="$title"
    PLAYLIST_ENGINES="$eng"
    QUERY_LABEL="$title"
    build_playlist_rows
    FILTER_LABEL=""
    FILTER_MODE=0
    selected=0
    page_index=1
    load_rows "$ALL_ROWS"
    return 0
}

load_track_url() {
    local eng=$1 target_url=$2 no_fallback=${3:-0} out errfile rc=0
    errfile=$(mktemp "${TMPDIR:-/tmp}/ting-url-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/ting-url-err.$$"
    spin_start
    printf '\n%s%s %s...%s' "$C_BOLD" "$GL_CARET" "$S_URL_ACT" "$C_RESET"
    out=$(engine_verb "$eng" --info -j -- "$target_url" 2>"$errfile") || rc=$?
    spin_stop
    local err_msg; err_msg=$(<"$errfile"); rm -f "$errfile"
    if ((rc != 0)); then
        if ((! no_fallback)) && [[ "$err_msg" == *"container"* || "$err_msg" == *"--items"* || "$err_msg" == *"not a song URL"* ]]; then
            load_container_url "$eng" "$target_url"
            return $?
        fi
        err_msg=$(engine_msg "$eng" "$err_msg")
        store_notice "$S_URL_ACT:" "${err_msg:-failed to resolve URL}"
        return 1
    fi

    # The --info envelope IS a search row plus a few fields (ARCH-cli-contract.md「数据契约」),
    # so the one-row search envelope is a projection of it — no site's raw record is read here.
    local synth_json
    synth_json=$(printf '%s' "$out" | jq -c --arg eng "$eng" "$JQ_TEXT_DEFS"'
        {
            status: "ok",
            engine: (.engine // $eng),
            query: (.url // ""),
            count: 1,
            results: [{
                id: .id,
                url: (.url // ""),
                title: (.title // "" | clean),
                duration: .duration,
                duration_fmt: (.duration_fmt // (.duration | fmt_dur) // ""),
                view_count: .view_count,
                channel: (.channel // .uploader // "?" | oneline),
                live_status: .live_status,
                kind: .kind,
                access: .access,
                description: (.description // "" | clean),
                thumbnail: (.thumbnail // "")
            }]
        }' 2>/dev/null) || synth_json=""
    if [[ -z "$synth_json" ]]; then
        store_notice "$S_URL_ACT:" "failed to parse metadata"
        return 1
    fi

    stash_search
    json="$synth_json"
    CURRENT_ENGINE="$eng"
    QUERY_LABEL="$target_url"
    apply_search_results
    return 0
}

load_url() {
    local target_url=$1 eng kind
    target_url=$(extract_url_target "$target_url")
    eng=$(sniff_engine_from_url "$target_url") || eng=""
    if [[ -z "$eng" ]]; then
        store_notice "$S_URL_ACT:" "unsupported media source ($target_url)"
        return 1
    fi
    if ! engine_seen "$eng"; then
        store_notice "$S_URL_ACT:" "engine '$eng' is not installed"
        return 1
    fi

    kind=$(sniff_target_kind "$eng" "$target_url")
    if [[ "$kind" == "container" ]]; then
        load_container_url "$eng" "$target_url"
    else
        load_track_url "$eng" "$target_url"
    fi
}

# ── SEARCH action (key: n) ──────────────────────────────────────────────────────────────
new_search() {
    local q prev="$QUERY_LABEL" rc=0
    printf '\n%s%s %s%s: ' "$C_BOLD" "$GL_CARET" "$S_NEW_SEARCH" "$C_RESET"
    read_query_input "${1:-}" || return 0
    q="$QUERY_INPUT"
    [[ "$q" == *[![:space:]]* ]] || return 0
    local clean_url
    clean_url=$(extract_url_target "$q")
    if is_url_target "$clean_url"; then
        load_url "$clean_url" || true
        return 0
    fi
    QUERY_LABEL="$q"
    printf '%s%s' "$S_SEARCHING" "$GL_ELL"
    fetch_json || rc=$?
    if ((rc != 0)); then
        QUERY_LABEL="$prev"
        report_fetch_failure "$rc" "$q"
        return 0
    fi
    apply_search_results
}

# ── MORE action (key: → past the last page) ─────────────────────────────────────────────
# No search_only here, and none in fewer_results either: both edges are reached through ONE
# arm of move_selection, which tests LIST_SOURCE itself so a stored row gets a silent stop
# rather than a notice about a query it never had. A guard the single call site already
# makes is not a defence, it is a second place to keep the same fact.
more_results() {
    local prev="$RESULT_N" rc=0 page="$page_index" sel="$selected"
    RESULT_N=$(( RESULT_N + TING_FETCH_BATCH ))
    printf '\n%s%s%s %s %s "%s" %s %s %s%s' \
        "$C_BOLD" "$S_MORE_ACT" "$C_RESET" "$GL_DASH" "$S_REFETCH" "$QUERY_LABEL" \
        "$GL_SEP" "$RESULT_N" "$S_RESULTS_N" "$GL_ELL"
    fetch_json || rc=$?
    if ((rc != 0)); then
        RESULT_N="$prev"
        report_fetch_failure "$rc"
        return 0
    fi
    apply_search_results
    # → APPENDS: rows 1..N are unchanged, so the page and row the user was looking at are
    # still the same video — apply_search_results' reset to page 1 threw away a position
    # that did not need to move. Safe to restore: no filter can be open here — and that is
    # now enforced at the call site (move_selection tests FILTER_MODE) rather than asserted,
    # because filter_live drives the same arrows and this comment used to be wrong.
    # display_list_menu clamps both against the new geometry, and this path only ever grows
    # the row count. Deliberately NOT done in cycle_sort.
    page_index=$page
    selected=$sel
    # Both edges record the same key: what is stored is the count a query STARTS from, so the
    # next session opens on the size this one settled at.
    mark_pref TING_SEARCH_RESULTS
}

# ── FEWER action (key: ← on page 1) ─────────────────────────────────────────────────────
# The mirror of the edge above, and deliberately not its equal: growing costs a network round
# trip, shrinking costs nothing at all. The rows are already in ALL_ROWS, so this is a
# truncation — no engine is asked anything, which is the whole reason it can sit on a bare
# arrow key. Before it existed the count only ever went up (the most passive gesture in the
# app, → held down past the last page, took 20 to 200) and the only way back down was to quit.
#
# RESULT_N is what was ASKED for and NUM_ENTRIES is what came back; the two differ whenever a
# query is thinner than the appetite. The step is taken off RESULT_N, because that is the
# number the next query starts from — a search that happened to return 37 rows must not pin
# the next one at 37.
#
# The floor is a screenful, never zero: one batch, or one page when the terminal is showing
# more rows than a batch holds. At the floor this returns without touching anything, which is
# exactly what ← on page 1 did before this function existed.
fewer_results() {
    local floor=$TING_FETCH_BATCH target
    ((floor >= PAGE_SIZE)) || floor=$PAGE_SIZE
    target=$(( RESULT_N - TING_FETCH_BATCH ))
    ((target >= floor)) || target=$floor
    ((target < RESULT_N)) || return 0
    RESULT_N=$target
    # `|| true` for the reason t-play:1985 already spells out: under `set -euo pipefail`
    # head closing early SIGPIPEs printf, the pipeline goes non-zero, and the script dies AT
    # the assignment. The unread tail here is exactly TING_FETCH_BATCH rows — a user-settable
    # key — so a large enough batch really does reach it. The truncation is untouched: the
    # guard rescues the pipeline's status, not its output.
    ALL_ROWS=$(printf '%s\n' "$ALL_ROWS" | head -n "$target") || true
    load_rows "$ALL_ROWS"
    mark_pref TING_SEARCH_RESULTS
    # No action echo, unlike the other edge: that one prints because it is about to block on a
    # fetch, and this one is already done by the time the frame repaints. The status row's
    # results= IS the feedback.
    #
    # Page and selection are left alone on purpose. This only runs on page 1, so the menu
    # loop's own clamp (page_min/page_max) already holds the highlight inside a list that got
    # shorter, and the floor guarantees page 1 is still full.
}

# ── SORT action (key: o) ────────────────────────────────────────────────────────────────
# Switch source and re-fetch the same query (key: e). Modelled on cycle_sort, including its
# page/selection reset: a different engine puts entirely different videos under the old
# index, so keeping the highlight would point it at a track the user never saw.
#
# The name is rolled back on a failed fetch, so the next fetch never queries one source under
# the other's label — the exact confusion the `engine` field exists to prevent.
cycle_engine() {
    search_only || return 0
    if ((${#ENGINES[@]} < 2)); then
        return 0
    fi
    local prev="$ENGINE" i n=${#ENGINES[@]} cur=0 rc=0
    for (( i = 0; i < n; i++ )); do
        if [[ "${ENGINES[$i]}" == "$ENGINE" ]]; then cur=$i; break; fi
    done
    ENGINE="${ENGINES[$(( (cur + 1) % n ))]}"
    printf '\n%s%s%s %s %s %s %s "%s"%s' \
        "$C_BOLD" "$S_ENGINE_ACT" "$C_RESET" "$GL_ARROW" "$ENGINE" "$GL_DASH" \
        "$S_REFETCH" "$QUERY_LABEL" "$GL_ELL"
    fetch_json || rc=$?
    if ((rc != 0)); then
        ENGINE="$prev"
        report_fetch_failure "$rc"
        return 0
    fi
    # After the revert window, not before it: a failed switch leaves ENGINE where it was,
    # and the token must describe the engine actually on screen.
    refresh_engine_caps
    apply_search_results
    # After the revert window too, and for the same reason: the file must record the engine
    # that is on screen, never the one a failed fetch just rolled back.
    mark_pref TING_DEFAULT_ENGINE
}

cycle_sort() {
    search_only || return 0
    # The page/selection reset in apply_search_results is DELIBERATE here, unlike in
    # more_results: re-sorted rows put a different video under the old index, so keeping the
    # index would move the highlight to a track the user never selected.
    local prev="$SORT_FIELD" i n=${#SORT_CYCLE[@]} cur=0 rc=0
    for (( i = 0; i < n; i++ )); do
        [[ "${SORT_CYCLE[$i]}" == "$SORT_FIELD" ]] && { cur=$i; break; }
    done
    SORT_FIELD="${SORT_CYCLE[$(( (cur + 1) % n ))]}"
    printf '\n%s%s%s %s %s %s %s "%s"%s' \
        "$C_BOLD" "$S_SORT_ACT" "$C_RESET" "$GL_ARROW" "$SORT_FIELD" "$GL_DASH" \
        "$S_REFETCH" "$QUERY_LABEL" "$GL_ELL"
    fetch_json || rc=$?
    if ((rc != 0)); then
        SORT_FIELD="$prev"
        report_fetch_failure "$rc"
        return 0
    fi
    apply_search_results
    mark_pref TING_SORT_FIELD
}

# ── FILTER action (key: /) — LIVE incremental narrow ─────────────────────────────────────
apply_filter() {
    local q="$1" url title dur views chan live engine rail desc n thumb hay tok ok matched="" tokens=()
    selected=0
    page_index=1
    if [[ "$q" != *[![:space:]]* ]]; then
        FILTER_LABEL=""
        load_rows "$ALL_ROWS"
        return 0
    fi
    FILTER_LABEL="$q"
    read -ra tokens <<<"$q"
    shopt -s nocasematch
    # ELEVEN fields, and the count is load-bearing. `read` gives the last variable everything
    # that is left, so with six names `live` arrived as "is_live<US>yt" and the is_live test
    # below could never be true — the LIVE token matched nothing for as long as the engine
    # field was the unnamed one. The re-emit hid it: pasting that trailing variable back
    # produced a byte-identical row, so every row survived and only the haystack was wrong.
    while IFS="$US" read -r url title dur views chan live engine rail desc n thumb; do
        [[ -n "$url" ]] || continue
        # The haystack is SYNTHESIZED here, not carried as a seventh field: the row already
        # has the pieces, it is never printed, and a stored key would be one more thing to
        # keep in step with the renderer. It holds BOTH duration forms on purpose — the
        # envelope's `11h:53m:45s` for parity with what the filter always matched, and
        # short_dur's `11:53:45` because that is the form the rail actually shows, and a
        # filter that will not match what is on the screen is a filter that looks broken.
        # The literal LIVE is what keeps typing `live` working now that no row carries a
        # rendered "● LIVE" string to match against.
        # A row that names its own rail contributes THAT — the chapter span is what is on
        # screen, and the rule this haystack follows is "match what is shown".
        #
        # THE DESCRIPTION IS DELIBERATELY NOT IN IT, and this is the one place the rule bends
        # on purpose: a description is shown for the FOCUSED row only, so matching it would
        # drop rows whose visible text does not hold the word and keep rows that show no
        # reason for being kept. The field is carried through the re-emit all the same — a
        # filter must never degrade a row.
        short_dur "$dur"
        hay="$title $chan $dur $SHORT_DUR $views $rail"
        [[ "$live" == "is_live" ]] && hay+=" LIVE"
        ok=1
        for tok in ${tokens[@]+"${tokens[@]}"}; do
            if [[ "$hay" != *"$tok"* ]]; then ok=0; break; fi
        done
        # Re-emitted unchanged, so ALL_ROWS stays the one source and a filter never
        # degrades a row.
        ((ok)) && matched+="${url}${US}${title}${US}${dur}${US}${views}${US}${chan}${US}${live}${US}${engine}${US}${rail}${US}${desc}${US}${n}${US}${thumb}"$'\n'
    done <<<"$ALL_ROWS"
    shopt -u nocasematch
    load_rows "$matched"
}

filter_live() {
    local query=""
    FILTER_MODE=1
    apply_filter ""
    while true; do
        # BOTH halves, exactly as the menu loop runs them: this loop never returns to the main
        # loop while / is open, so whatever it skips is frozen for the whole filter session.
        # It used to call only the first, and player_check_ready is the one that ADVANCES the
        # starting-state spinner and clears it when mpv reports audio — so pressing / right
        # after Enter parked a dead spinner frame and a "starting" label on screen until Esc,
        # cap and all.
        check_player_alive
        player_check_ready
        # Third half, same reason: a chapter list is still a chapter list with / open, and a
        # rail that stopped following the playhead for the length of a filter session is the
        # same frozen view the key was pressed to search out of. The cursor still only moves
        # when it is parked on the chapter that was playing — and a filter that hides the new
        # one simply leaves it where it is (chapter_follow).
        chapter_follow
        # Fourth: an undo offer that has closed pays its held-back stop here as well — this
        # loop owns the screen for as long as / is open (undo_tick).
        undo_tick
        relocate_tools
        display_menu "$page_index"
        read_nav_input || continue
        case "$READ_NAV_KEY" in
        "" | $'\n' | $'\r')
            _target_u=$(extract_url_target "$query")
            if is_url_target "$_target_u"; then
                FILTER_MODE=0
                apply_filter ""
                load_url "$_target_u" || true
                return 0
            fi
            play_selected || true ;;  # Enter → play highlighted match in background
        ESC) break ;;                            # Esc → leave filter mode
        "[A" | "OA" | "["*A | "O"*A | "[B" | "OB" | "["*B | "O"*B | \
        "[C" | "OC" | "["*C | "O"*C | "[D" | "OD" | "["*D | "O"*D)
            move_selection "$READ_NAV_KEY" ;;
        $'\x7f' | $'\b') query="${query%?}"; apply_filter "$query" ;;
        $'\t') ;;   # Tab is a control character, never part of a query — ignore, not append
        # Text, not a command: with `/` open the user is typing a query, and a paste is the
        # fastest way to type one. Narrows on the whole payload in one apply_filter.
        # If the paste is a media URL, exit filter and resolve the URL directly.
        PASTE | $'\x16')
            local ptext="$PASTE_TEXT"
            [[ "$READ_NAV_KEY" == $'\x16' ]] && ptext=$(clipboard_get)
            _target_u=$(extract_url_target "$ptext")
            if is_url_target "$_target_u"; then
                FILTER_MODE=0
                apply_filter ""
                load_url "$_target_u" || true
                return 0
            fi
            query="$query$ptext"; apply_filter "$query" ;;
        # An escape sequence the arms above did not claim (PageUp `[5~`, F1 `OP`, Home, a
        # modified arrow `[1;5A`) is not text the user typed, and appending its bytes would put
        # `[5~` in the query. The introducer alone IS text, though — a sequence always carries
        # something after it — so this matches `[`/`O` followed by at least one more character
        # and a bare `[` or `O` falls through to be appended, exactly as today.
        "["?* | "O"?*) ;;
        # Widened from `?)`, which matched a single BYTE and so could never match a whole CJK
        # character now that utf8_complete assembles one (F9's other half; the widening is only
        # safe because of that assembly, which is why the two shipped together).
        *) query="$query$READ_NAV_KEY"; apply_filter "$query" ;;
        esac
    done
    FILTER_MODE=0
    apply_filter ""
}

# ── UTF-8 input assembly ────────────────────────────────────────────────────────────────
# bash 3.2's `read -rsn1` delivers one BYTE, not one character (verified: 你 arrives as
# e4 bd a0). Both readers below used to treat each byte as a key, so a CJK character typed at
# the filter or the new-search prompt became 2-3 garbage keys — the filter matched nothing and
# the prompt echoed mojibake.
#
# A UTF-8 lead byte announces how many continuation bytes follow, so one table lookup per
# keypress is enough: C2-DF -> 1, E0-EF -> 2, F0-F4 -> 3. Built once with cw_range and tested
# by MEMBERSHIP, the way char_w tests its cell tables — not by range comparison. Two idioms
# that look like they would work do not: `LC_ALL=C [[ … ]]` is not valid bash (an assignment
# prefix applies to a simple command, and [[ is a reserved word, so bash tries to run the raw
# byte as a command name and the test silently answers under the wrong collation), and a
# ( LC_ALL=C … ) subshell would fork on every keypress and could not set a global anyway.
# Verified on this machine's 3.2.57 by building the tables in a scratch script and asserting
# every byte 0x00-0xFF falls in exactly one class: cw_range with an EMPTY prefix does build
# lone 0x80-0xFF bytes, and the membership test compares bytes even though the haystack is
# invalid UTF-8 — every lead byte C2-F4 lands in exactly one class, and continuation bytes,
# 0xC1, 0xF5-0xFF and ASCII land in none.
CW_LEAD2=""; CW_LEAD3=""; CW_LEAD4=""
init_lead_tables() {
    cw_range '' 194 223; CW_LEAD2="$CW_RANGE"    # C2..DF -> 1 continuation byte
    cw_range '' 224 239; CW_LEAD3="$CW_RANGE"    # E0..EF -> 2
    cw_range '' 240 244; CW_LEAD4="$CW_RANGE"    # F0..F4 -> 3
}
init_lead_tables

# Assemble one whole UTF-8 character from its lead byte in $1, through CHAR_IN. ASCII and any
# byte that is not a lead byte pass through untouched — an invalid byte is one "character" here,
# which is also how bash's own ${q%?} treats it, so backspace can still take it back off.
# The continuation reads TIME OUT rather than blocking: a lone lead byte (a torn paste, a
# terminal that drops bytes) must not wedge the once-a-second tick behind a read that
# never completes. An incomplete sequence is passed through as-is for the same reason a discard
# would be worse — it would eat a keypress silently, and the main loop's catch-all already
# ignores anything it cannot use.
CHAR_IN=""
utf8_complete() {
    CHAR_IN="$1"
    local extra=0 b
    # EMPTY returns before the lead-byte tests, because `*""*` matches EVERY pattern — an
    # empty $1 was classified as a 2-byte lead and then sat in the `read -t 1` below waiting
    # for a continuation byte that cannot arrive. And empty is exactly what the Enter key
    # reads as: `read` strips its \n delimiter, and ICRNL turns Return into \n even in the
    # non-canonical mode `read -n1` sets up, so `read -rsn1` returns "" (which is why the
    # case arms downstream all list "" alongside $'\n' and $'\r'). Cost: a full second of
    # dead screen after EVERY Enter — measured at 1015 ms between the startup prompt's Enter
    # and its `Searching` line, where the same run with an argv query showed 20 ms — plus the
    # same second before every play_selected, plus a SWALLOWED keystroke whenever the user
    # did press something inside that second (it was appended to CHAR_IN and read as one key).
    [[ -n "$1" ]] || return 0
    if   [[ "$CW_LEAD2" == *"$1"* ]]; then extra=1
    elif [[ "$CW_LEAD3" == *"$1"* ]]; then extra=2
    elif [[ "$CW_LEAD4" == *"$1"* ]]; then extra=3
    fi
    while ((extra > 0)); do
        IFS= read -rsn1 -t 1 b || break
        CHAR_IN+="$b"
        extra=$((extra - 1))
    done
}

# ── Key Input Readers ───────────────────────────────────────────────────────────────────

# What one tick of the shared clock does before the caller redraws: the position, which the
# banner prints and the rail draws as a bar. Doing that poll on the CLOCK rather than in the
# renderer is the point: a keypress redraw then costs no IPC at all (fetch_play_times is an
# `nc` + `jq` pair, i.e. two forks), and a view that repaints between ticks simply reuses the
# last values — at most one second old, which is the resolution the rail is drawn at anyway.
nav_tick() {
    # The idle flush, ahead of every early return below: a preference changed with nothing
    # playing must land too. What ARMS the timeout that gets us here when
    # nothing is playing is the PREF_DIRTY test in read_nav_input.
    flush_prefs
    # THE COVER IS FETCHED HERE AND NOWHERE ELSE, and that is the performance premise rather
    # than an optimisation to make later. A frame is redrawn on every keypress, and the two
    # halves of getting a cover are a request and an mpv (0.15s measured) — holding `j` down
    # through ten rows would be ten of each, and the nine covers in the middle would never be
    # looked at. On the clock it is one, for the row the cursor actually stopped on: the
    # intermediate frames simply have nothing to draw, which is also why the cover cannot
    # flicker — it was never drawn in the states being passed through.
    #
    # The caller redraws as soon as this returns (both key loops `continue` into
    # display_menu), so the frame that finds the cover in the cache is the very next one.
    if ((IMAGE_DIRTY)); then
        IMAGE_TICK=$((IMAGE_TICK + 1))
        local iu="$IMAGE_KEY_URL"
        if [[ -n "$IMAGE_JOB_PID" ]] && kill -0 "$IMAGE_JOB_PID" 2>/dev/null; then
            : # still working — the next tick asks again, which is what the 1 s clock is for
        else
            # A job that has FINISHED for this very row, with the frame still finding no
            # file, is a row that cannot be got. Recorded so it is tried once and not once a
            # second (image_focus reads it).
            if [[ -n "$IMAGE_JOB_PID" && -n "$iu" && "$IMAGE_JOB_URL" == "$iu" ]]; then
                IMAGE_FAIL_URL="$iu"
                IMAGE_DIRTY=0
            fi
            IMAGE_JOB_PID=""
            [[ -n "$iu" && "$iu" != "$IMAGE_FAIL_URL" ]] && image_prepare_bg "$iu"
        fi
        # Force the next frame to look at the cache again: the memo is keyed on the url, and
        # the file it answered "absent" for may have landed since.
        IMAGE_KEY_URL=""
    fi
    if [[ -z "$CURRENT_PLAY_ID" ]]; then return 0; fi
    fetch_play_times
    return 0
}

READ_NAV_KEY=""
# What was read one key too early. A lone Esc is only known to BE lone once the byte after it
# has been read, and that byte is the user's next key — it was being dropped on the floor, so
# every key typed inside Esc's one-second window vanished (proved both ways: `Esc` then `o`
# left the sort field alone; `Esc` then Right left the page on 1). Esc did not matter in the
# list until it became the way out of a store, which is what made a decade-old terminal
# nuisance into a key that "does nothing".
#
# Two slots because the byte read early is one of two different things. A plain key can be
# handed up whole (PENDING_KEY). A second \x1b is the START of another key whose remaining
# bytes have not arrived yet, so what carries over is the position in the parse, not a value
# (PENDING_ESC) — without it those bytes are read as literal keys on the next call, and `[`
# is the seek key, so `Esc` + an arrow did not merely lose the arrow, it seeked.
PENDING_KEY=""
PENDING_ESC=0
# A third carry-over, from the unbracketed-paste probe rather than the Esc parse: keys that
# arrived as one burst but are keystrokes, not text (see check_unbracketed_tail). REPLAY_KEYS
# is what is left of the burst; REPLAY_UNIT is the one character it repeats, or "" when the
# burst is digits — ASCII, so `${:0:1}` takes exactly one under any locale.
REPLAY_KEYS=""
REPLAY_UNIT=""

# The row-jump count register: the digits typed so far, "" when there are none. A global for
# the reason PENDING_KEY is one — it is an intent that outlives the keypress that made it,
# not a value some function computed — and it is read and written by the LIST VIEW case block
# alone, plus the one clearing point in front of both blocks. Never by the universal block:
# with `/` open a digit is query text (`2026` is a real query) and filter_live runs its own
# reader that reaches neither block, so keeping the digits out of the universal case is what
# makes the filter safe by construction rather than by a guard someone has to remember.
#
# There is no timer anywhere near it. The count is ended by a KEY (`j`), which is why 1-9 and
# 10+ are one rule instead of two: `3j` costs a keystroke more than `3` did, and buys a
# keyboard with one jump gesture on it instead of two.
JUMP_COUNT=""

# The byte after an Esc, or nothing — the ONE question whose answer used to cost a second.
#
# A lone Esc is only known to be lone once the terminal has been given a chance to send what
# follows, and on the bash 3.2 floor that chance was `read -rsn1 -t 1`: `read -t` takes
# integer seconds only ("invalid timeout specification" on 0.1), and `-t 0` is not bash 4's
# "is input available" poll — here it FAILS even with a byte already queued (both measured).
# In the list the second is mostly hidden, because the user's next key ends the wait early.
# At the startup prompt nothing follows an Esc — the app exits — so the whole second was paid
# every single time, and a second of dead terminal before the shell prompt comes back reads
# as a hang. Measured through tmux: Escape at the prompt to exit, 1062 ms.
#
# The tty can wait in tenths, so the wait moves there: `min 0 time 1` makes read(2) return as
# soon as anything is queued, or empty after 100 ms. Neither of bash's own readers can use
# that. `read -n` forces cbreak (`min 1 time 0`) for its own duration, so it blocks regardless
# — measured still waiting at 631 ms under `min 0 time 1`. Plain `read` (no -n) does honour it
# — and is BUFFERED: it asks for a chunk, keeps up to its delimiter and DISCARDS the rest,
# which on a tty cannot be pushed back. That is not a corner case here, it is the paste path:
# slurping `\e[200~jazz\n#ch\e[201~` returned `[200~jazz` and ate `#ch\e[201~` off the tty
# for good. `-d` avoids the delimiter and loses everything instead — on 3.2 a `read` that hits
# its `-t` returns NOTHING, partial input on timeout being a bash 4 addition.
#
# So the read is one `dd bs=1 count=1`: exactly one read(2), which is precisely what VTIME
# bounds, and nothing beyond that byte is consumed — measured, the paste's whole payload is
# still in the tty afterwards. Every byte after the first is queued by then and comes back
# through the caller's own loop at no wait at all. 100 ms is not a corner cut either: it is
# the generous end of what terminal libraries allow for this exact question (vim's
# `ttimeoutlen` ships at 50).
#
# ONE CALLER, and that is the point of the measurement: two stty and one dd cost ~69 ms of
# forks, so this pays for itself only where the alternative is the full second EVERY time.
# That is the query prompt — an Esc there is followed by nothing, because the app is leaving.
# The list's reader keeps `read -rsn1 -t 1` and read_esc_tail says why.
#
# `$(…)` cannot carry a trailing newline, so an Esc followed by Return reads as a lone Esc and
# the Return is dropped. That is what the old reader did with it too — `read -rsn1` reports a
# newline as an EMPTY read, which fell through to a PENDING_KEY nothing picks up.
ESC_C=""
# Probed once, not per keypress. `dd` is POSIX base and sits at the same tier as the `stty`
# this file already forks on every resize, so it is not a dependency in the sense the suite
# forbids — but "not a dependency" has to be TRUE on the host, not assumed. Without the probe
# an absent dd would make `$(dd …)` empty, which this function reports as "nothing followed
# the Esc" — and a paste would then close the prompt, the exact bug read_query_input's \x1b
# arm exists to prevent. So a host without it falls back to the one-second wait: slower, and
# correct, which is the right way round.
ESC_DD=-1
esc_first_byte() {
    ESC_C=""
    ((ESC_DD >= 0)) || { command -v dd >/dev/null 2>&1 && ESC_DD=1 || ESC_DD=0; }
    # Only the two control characters move; -echo -icanon are the session's (tty_echo_off owns
    # them) and are not touched. Restored to the blocking one-byte read the rest of the app is
    # written against, which is the pair tty_echo_off itself set.
    if ((ESC_DD == 0)) || ! stty min 0 time 1 </dev/tty 2>/dev/null; then
        IFS= read -rsn1 -t 1 ESC_C     # no dd, or no tty to tune: the old wait, unchanged
        return $?
    fi
    ESC_C=$(dd bs=1 count=1 2>/dev/null </dev/tty || true)
    stty min 1 time 0 </dev/tty 2>/dev/null || true
    [[ -n "$ESC_C" ]]
}

# Everything after the \x1b introducer has been consumed. Split out of read_nav_input for one
# reason: PENDING_ESC has to re-enter the parse HERE, and a copy of it would be a second escape
# decoder to keep in step with the first.
read_esc_tail() {
    local next="" seq=""
    # THE LIST KEEPS THE ONE-SECOND WAIT, deliberately — see esc_first_byte for what it would
    # buy and what it costs. This read is the ARROW-KEY path, and an arrow's bytes are already
    # queued when it runs, so it returns at no wait at all; esc_first_byte would put its ~69 ms
    # of forks on every single arrow (measured: 69 ms with the sequence queued, 179 ms without).
    # A held arrow at ~11 rows a second to save a second on a key that is not the hot one is the
    # wrong trade. The second is also mostly hidden here for the reason PENDING_KEY exists: the
    # user's NEXT key ends this read early, so it is paid only by an Esc pressed alone.
    if ! IFS= read -rsn1 -t 1 next; then
        READ_NAV_KEY="ESC"
        return 0
    fi
    if [[ "$next" == $'\x1b' ]]; then
        # Two introducers: the first Esc stood alone, and the second belongs to the key still
        # arriving. Report the Esc and resume mid-parse next time. Double-Esc therefore now
        # delivers TWO Escs where it used to collapse into one — which is what a user pressing
        # it twice (leave the filter, then leave the store) is asking for.
        PENDING_ESC=1
        READ_NAV_KEY="ESC"
        return 0
    fi
    if [[ "$next" != "[" && "$next" != "O" ]]; then
        # Not an introducer, so the Esc was lone and this byte opens the next key. Completed
        # here rather than stashed raw: it may be the lead byte of a CJK character whose
        # continuation bytes are still in the tty buffer, and the next call comes after a
        # redraw — utf8_complete has to run while they are still queued.
        utf8_complete "$next"
        PENDING_KEY="$CHAR_IN"
        READ_NAV_KEY="ESC"
        return 0
    fi
    seq="$next"
    while IFS= read -rsn1 -t 1 next; do
        seq+="$next"
        case "$next" in
        [[:alpha:]~]) break ;;
        esac
    done
    # `\e[200~` is not a key, it is the announcement that TEXT follows. Reported as one
    # key with its payload beside it, the way ESC is reported as one key, so every caller
    # decides what a paste MEANS to it instead of decoding the protocol again.
    if [[ "$seq" == "[200~" ]]; then
        read_paste_tail
        READ_NAV_KEY="PASTE"
        return 0
    fi
    READ_NAV_KEY="$seq"
    return 0
}

# The text of the paste whose opener read_esc_tail just decoded. One slot, consumed by the
# same call that reports the key, exactly as PENDING_KEY is.
PASTE_TEXT=""
# Consume a bracketed paste's payload, the \e[200~ opener already read, and stop on its
# \e[201~ closer. Split out because BOTH readers need it: the list decodes a paste through
# read_esc_tail, and the query prompt runs its own byte loop and would otherwise treat the
# opener's \x1b as the cancel key — which is what it did, so turning 2004 on without this
# would have made a paste at the `n` prompt close the prompt instead of filling it.
#
# A newline inside the payload becomes a SPACE rather than a submit. That is the whole point
# of knowing it is a paste: the bytes after a line break are part of what the user pasted,
# not keys they pressed, and letting the first line submit was the other half of this bug —
# `jazz\n#ch` searched for `jazz` and then ran # and c and h as commands.
# The cap is a refusal, not a truncation policy: a stray paste of a whole file must not lock
# the UI in this loop, and 4096 bytes is far past any query. Bytes past it are read and
# dropped so the closer is still found and the terminal is not left mid-paste.
read_paste_tail() {
    local b x seq
    local -i n=0
    PASTE_TEXT=""
    while :; do
        IFS= read -rsn1 -t 1 b || break
        if [[ "$b" == $'\x1b' ]]; then
            seq=""
            while :; do
                IFS= read -rsn1 -t 1 x || break 2
                seq+="$x"
                case "$x" in [[:alpha:]~]) break ;; esac
            done
            [[ "$seq" == "[201~" ]] && break
            continue    # any other sequence inside a paste is not text; drop it
        fi
        # `read -n1` reports a newline as an EMPTY read (it is the delimiter), and a pasted
        # CRLF arrives as \r plus that empty. One space for the pair, none for the \r alone.
        [[ "$b" == $'\r' ]] && continue
        [[ -n "$b" ]] || b=" "
        if ((n < 4096)); then PASTE_TEXT+="$b"; n=$((n + 1)); fi
    done
    return 0
}

# Detect unbracketed paste (e.g. Cmd+V in macOS Terminal.app without DECSET 2004).
# If the character read is followed immediately by queued bytes in the tty buffer,
# slurp all pending bytes (MIN=0, TIME=0: what is already there, never a wait). A paste
# lands in the tty as one write, so its tail is queued before the first byte is even read;
# waiting for more is what turned two separate keystrokes 100 ms apart into one "paste",
# and it cost every non-exempt key a 100 ms stall when nothing followed.
UNBRACKETED_TAIL=""
check_unbracketed_tail() {
    UNBRACKETED_TAIL=""
    ((ESC_DD >= 0)) || { command -v dd >/dev/null 2>&1 && ESC_DD=1 || ESC_DD=0; }
    ((ESC_DD == 1)) || return 1
    if ! stty min 0 time 0 </dev/tty 2>/dev/null; then
        return 1
    fi
    UNBRACKETED_TAIL=$(dd bs=4096 count=1 2>/dev/null </dev/tty || true)
    stty min 1 time 0 </dev/tty 2>/dev/null || true
    [[ -n "$UNBRACKETED_TAIL" ]]
}

clipboard_get() {
    if command -v pbpaste >/dev/null 2>&1; then
        pbpaste 2>/dev/null
    elif command -v wl-paste >/dev/null 2>&1; then
        wl-paste 2>/dev/null
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard -o 2>/dev/null
    elif command -v xsel >/dev/null 2>&1; then
        xsel -b -o 2>/dev/null
    fi
}

paste_from_clipboard() {
    local clip
    clip=$(clipboard_get) || clip=""
    [[ -n "$clip" ]] || return 0
    local target
    target=$(extract_url_target "$clip")
    if is_url_target "$target"; then
        load_url "$target" || true
    else
        new_search "$clip"
    fi
}

# A NOTICE DIES ON A KEY, NOT ON A CLOCK, and this is the one place that knows the
# difference: every path below that returns 0 has a real keypress in hand, and the one that
# returns 1 is the tick. Clearing it here rather than in the two loops that call this gives
# the notice a single owner — and clearing it on the tick instead would give a notice a
# one-second life whenever a track is playing, which is not long enough to read one.
read_nav_input() {
    READ_NAV_KEY=""
    local input=""
    # A key already in hand is handed up before anything blocks: no tick, no WINCH gate, no
    # read. Both slots are consumed by the very NEXT call, whichever loop makes it — so a key
    # typed after an Esc that changed the view is handled by the view it arrives in, exactly
    # as if it had been typed there.
    if [[ -n "$PENDING_KEY" ]]; then
        READ_NAV_KEY="$PENDING_KEY"
        PENDING_KEY=""
        NOTICE_LABEL=""; NOTICE_TEXT=""
        return 0
    fi
    if [[ -n "$REPLAY_KEYS" ]]; then
        READ_NAV_KEY="${REPLAY_UNIT:-${REPLAY_KEYS:0:1}}"
        REPLAY_KEYS="${REPLAY_KEYS#"$READ_NAV_KEY"}"
        NOTICE_LABEL=""; NOTICE_TEXT=""
        return 0
    fi
    if ((PENDING_ESC)); then
        PENDING_ESC=0
        NOTICE_LABEL=""; NOTICE_TEXT=""
        read_esc_tail
        return 0
    fi
    local -a t_opt=()
    # ONE clock, shared by everything that reads through this function (the list and the live
    # filter, which drives the same reader). It used to belong to the focus card alone, which
    # is why the list could not carry a live element at all: two timers would also be two
    # places to change the cadence, and they drift.
    #
    # The gate is not WHICH view is up but whether anything on screen can change without a
    # keypress — that is playback, so it is one condition in one place. Consequences both
    # ways: the list ticks while a track plays (its rail is live), and nothing ticks when
    # nothing is playing — the card that used to repaint a static "(nothing playing)" once a
    # second forever is gone, and the condition that made that wrong is still the one here. LOADING is in the test because the pre-socket window has a
    # spinner to advance before there is any play id to poll.
    #
    # Deliberately NOT shared: read_query_input, the `n` new-search prompt. A tick there would
    # repaint the screen mid-keystroke while a query is being typed.
    # A pending preference arms the same clock: without this the reader BLOCKS with nothing
    # playing, nav_tick never runs, and a change made in a silent session would sit in memory
    # until the user quit. One extra wake-up per burst of cycle keys, and the burst is what
    # the deferral exists to absorb.
    # A pending COVER arms the same clock, for the same reason a pending preference does and
    # by the same one-clause addition: with nothing playing this read blocks outright, so a
    # cover the frame could not draw would wait for the user's next keypress to appear —
    # which is to say it would appear one row late, on the row they had already left.
    # An undo offer arms it too: with nothing playing and no key pressed, the frame where the
    # offer closes has to be drawn by the clock, or the hint would outlive the offer.
    if [[ -n "$CURRENT_PLAY_ID" ]] || ((CURRENT_PLAY_LOADING)) || [[ -n "$PREF_DIRTY" ]] || ((IMAGE_DIRTY)) ||
        ((UNDO_END > 0)); then
        t_opt=(-t 1)
    fi
    # The resize gate is armed for THIS read only — the wait that owns the whole screen —
    # and not for the escape-sequence reads below: their bytes are the tail of a key already
    # pressed, and a repaint between them would draw a frame from a state that key is about
    # to change. See on_winch.
    WINCH_OK=1
    if ! IFS= read -rsn1 ${t_opt[@]+"${t_opt[@]}"} input; then
        WINCH_OK=0
        nav_tick
        return 1
    fi
    WINCH_OK=0
    NOTICE_LABEL=""; NOTICE_TEXT=""
    if [[ "$input" != $'\x1b' ]]; then
        # One byte is not one key: finish the character before handing it up. The ESC/arrow
        # decoding in read_esc_tail is untouched — those sequences are all ASCII.
        utf8_complete "$input"
        case "$CHAR_IN" in
        " " | "" | $'\n' | $'\r' | $'\t' | j | J | k | K | "-" | "=" | "[" | "]") ;;
        *)
            if check_unbracketed_tail; then
                # A burst is not always a paste. Held-key repeat, a double-tapped `?`, or
                # a row jump typed fast (`12j`) all queue behind the first byte, and nobody
                # pastes one repeated character or a run of digits ending in the `j` that
                # fires it into a list. Those two shapes are handed back as keystrokes, one
                # per call; anything else is text. Capped at 64 so the repeat test stays a
                # short-string operation — a longer run is a paste of whatever it is.
                if ((${#UNBRACKETED_TAIL} <= 64)); then
                    local burst="$CHAR_IN$UNBRACKETED_TAIL"
                    burst="${burst%[jJ]}"
                    if [[ -n "$burst" && "$burst" != *[!0-9]* ]]; then
                        REPLAY_UNIT=""; REPLAY_KEYS="$UNBRACKETED_TAIL"
                        READ_NAV_KEY="$CHAR_IN"
                        return 0
                    fi
                    if [[ -z "${UNBRACKETED_TAIL//"$CHAR_IN"/}" ]]; then
                        REPLAY_UNIT="$CHAR_IN"; REPLAY_KEYS="$UNBRACKETED_TAIL"
                        READ_NAV_KEY="$CHAR_IN"
                        return 0
                    fi
                fi
                PASTE_TEXT="$CHAR_IN$UNBRACKETED_TAIL"
                READ_NAV_KEY="PASTE"
                return 0
            fi
            ;;
        esac
        READ_NAV_KEY="$CHAR_IN"
        return 0
    fi
    read_esc_tail
    return 0
}

# $1, when given, is text the prompt OPENS with — a paste the list decoded before the prompt
# existed. It is echoed and then edited like anything typed, rather than searched immediately:
# a paste is what the user has, not yet what they meant, and the one keystroke it costs buys
# the chance to fix a stray newline or a tracking suffix before a network round trip.
read_query_input() {
    local b="" query="${1:-}" gone rest i seq x
    cursor_show
    [[ -z "$query" ]] || printf '%s' "$query"
    while true; do
        IFS= read -rsn1 b || return 1
        utf8_complete "$b"
        case "$CHAR_IN" in
        "" | $'\n' | $'\r') printf '\n'; QUERY_INPUT="$query"; return 0 ;;
        # One cancel code, not two. Esc used to return 2 and EOF 1, and the only caller
        # (new_search) does `read_query_input || return 0` — both always meant cancel, so the
        # distinction was dead weight that read like a promise.
        # A paste opens with \e[200~, so this arm has to look before it cancels: with 2004 on
        # and without this, pasting at the prompt would CLOSE the prompt. Anything else after
        # \x1b is still a cancel, as it always was.
        $'\x1b')
            # Nothing behind the Esc = the user pressed it = cancel, in ~150 ms rather than
            # ~1060 (see esc_first_byte). Anything behind it is the rest of a sequence whose
            # bytes are all queued by now, so the loop below runs at no wait.
            if ! esc_first_byte; then printf '\n'; return 1; fi
            seq="$ESC_C"
            while [[ "$seq" != *[[:alpha:]~] ]]; do
                IFS= read -rsn1 -t 1 x || break
                seq+="$x"
            done
            if [[ "$seq" == "[200~" ]]; then
                read_paste_tail
                query+="$PASTE_TEXT"
                printf '%s' "$PASTE_TEXT"
                continue
            fi
            printf '\n'; return 1 ;;
        $'\x16')
            local cp; cp=$(clipboard_get)
            if [[ -n "$cp" ]]; then
                query+="$cp"
                printf '%s' "$cp"
            fi
            continue ;;
        # bash's own `read -n` puts the tty in non-canonical mode, so Ctrl-D arrives as the
        # BYTE 0x04, not as EOF — the catch-all below used to append it to the query and send a
        # control character to the search. Give it the shell's meaning instead: cancel on an
        # empty line, ignored once there is something to keep.
        $'\x04')
            [[ -z "$query" ]] || continue
            printf '\n'; return 1 ;;
        $'\x7f' | $'\b')
            if [[ -n "$query" ]]; then
                # ${query%?} strips a whole CHARACTER on 3.2 under a UTF-8 locale (verified with
                # 你好), so the query itself needs no byte repair. The ECHO does: `\b \b`
                # erases exactly one cell and a CJK glyph occupies two, so measure what was
                # removed and erase that many. A zero-width character erases nothing, which is
                # also right — it drew nothing.
                rest=${query%?}
                gone=${query#"$rest"}
                query="$rest"
                disp_w "$gone"
                for ((i = 0; i < DISP_W; i++)); do printf '\b \b'; done
            fi ;;
        *) query+="$CHAR_IN"; printf '%s' "$CHAR_IN" ;;
        esac
    done
}

# `$1` is an ABSOLUTE row number, 1-based — the very number the row-index column prints when
# `#` is on. It used to be a single digit naming a row of the VISIBLE window, with `0` meaning
# the tenth; that spelling could not name row 12 at all, and it disagreed with the column
# beside it, which has always counted from the top of the LIST. One notion of "row 12" now.
#
# Out of range is a SILENT no-op, matching ← on page 1 of a store: a list holding 71 rows has
# no 999th to jump to, and a measured block does not spend a line saying no. A row that has
# not been FETCHED yet is out of range by the same test — fetching is ←/→'s axis, and a jump
# key that quietly lengthened the list would make "row 12" mean two different rows one frame
# apart.
#
# It does NOT depend on whether the row numbers are being printed. A key whose meaning
# changed with a display toggle would be a second keymap wearing one keymap's clothes;
# the toggle decides whether the user can SEE the address, not whether the key acts.
jump_to_row() {
    # 10# is a guard, not a style: JUMP_COUNT is a run of digit literals and `0` is a legal
    # leading one, so `010` reads as octal 8 — and `08` is worse, because on the 3.2 floor it
    # is not a wrong answer but
    #     bash: ((: 08: value too great for base (error token is "08")
    # on stderr, into the frame, from an expansion that then fails the assignment carrying it.
    # MEASURED against a deliberately broken copy, 2026-09-02: the TUI does not survive `08j`
    # — the whole pane goes. Which is also why contract.sh watches for the pane still taking
    # keys afterwards rather than for that message: a dead pane captures empty and greps
    # clean, so the obvious check would go green on the one build it exists to catch.
    local n=$((10#$1))
    ((n >= 1)) || return 0                  # 0j and 00j land here, by the same rule as 999j
    ((n <= NUM_ENTRIES)) || return 0        # …and so does a row that has not been fetched
    # Page mode has to be carried by hand. The menu loop clamps `selected` into the current
    # page BEFORE display_menu (the `page_min`/`page_max` block), and the jump happens at the
    # END of the previous turn — so a jump to row 12 with page_index still 1 is clamped back
    # to row 10 before anything renders, and display_list_menu's "derive the page from
    # selected" runs after that clamp and cannot undo it. move_selection's page branch keeps
    # page_index for exactly this reason.
    [[ "$LIST_MODE" == "page" ]] && page_index=$(( (n - 1) / PAGE_SIZE + 1 ))
    selected=$((n - 1))
    return 0
}

move_selection() {
    local input="$1" pmin pmax prev_pages prev_n
    pmin=$(( (page_index - 1) * PAGE_SIZE ))
    pmax=$(( pmin + PAGE_SIZE - 1 ))
    # ── scroll mode: ONE axis, and it is the vertical one ────────────────────────────
    # The cursor walks the whole list and the renderer drags the window after it, so there is
    # no page arithmetic to do here at all. The two ENDS of the list carry what ←/→ carry in
    # page mode — the row count — because that is the one axis this mode has, and a mode with
    # two ways to change the same number is the thing `m`/`M` were retired for. ←/→ are a
    # SILENT no-op: there are no pages to turn, and a measured block does not spend a line
    # saying so.
    #
    # The known asymmetry, kept deliberately (the plan's O-2): fewer_results drops rows from
    # the TAIL while the gesture happens at the HEAD. It is the exact mirror of ← on page 1,
    # which has always been the same trade; on a continuous axis the distance between the
    # gesture and its effect is just longer. If it reads wrong once it is real, the way back
    # is to move it to the other end — both ends under ↓ — which changes a caller, not a
    # function.
    if [[ "$LIST_MODE" == "scroll" ]]; then
        case "$input" in
        "[A" | "OA" | "["*A | "O"*A | k | K)
            if ((selected > 0)); then
                selected=$(( selected - 1 ))
            elif [[ "$LIST_SOURCE" == "search" ]] && ((FILTER_MODE == 0)); then
                fewer_results
            fi ;;
        "[B" | "OB" | "["*B | "O"*B | j | J)
            if ((selected < NUM_ENTRIES - 1)); then
                selected=$(( selected + 1 ))
            elif [[ "$LIST_SOURCE" == "search" ]] && ((FILTER_MODE == 0)); then
                # Step onto the first new row if the fetch actually brought some, the way the
                # page arm steps onto the first new page — so the keypress does the thing the
                # user pressed it for and not only the thing it paid for. A failed or
                # exhausted fetch appends nothing and the cursor stays put, which is the
                # same silence the edges keep everywhere else.
                prev_n=$NUM_ENTRIES
                more_results
                ((NUM_ENTRIES > prev_n)) && selected=$(( selected + 1 ))
            fi ;;
        esac
        return 0
    fi
    # `k`/`j` ride the SAME arms as ↑/↓ rather than arms of their own: an alias that were a
    # second case would be a second copy of the page-crossing arithmetic, which is the drift
    # every duplicated block in this file has been rewritten to remove. Only the desktop
    # pair, never hjkl entire — `h` is already history, and `g/G` is closed off by binding
    # case together, so half a vim is worse than none (ARCH-tui.md).
    case "$input" in
    "[A" | "OA" | "["*A | "O"*A | k | K) # up
        if ((selected > 0)); then
            selected=$(( selected - 1 ))
            if ((selected < pmin && page_index > 1)); then
                page_index=$(( page_index - 1 )); selected=$(( page_index * PAGE_SIZE - 1 ))
            fi
        fi ;;
    "[B" | "OB" | "["*B | "O"*B | j | J) # down
        if ((selected < NUM_ENTRIES - 1)); then
            selected=$(( selected + 1 ))
            if ((selected > pmax && page_index < NUM_PAGES)); then
                page_index=$(( page_index + 1 )); selected=$(( (page_index - 1) * PAGE_SIZE ))
            fi
        fi ;;
    "[C" | "OC" | "["*C | "O"*C) # right → next page
        if ((page_index < NUM_PAGES)); then
            page_index=$(( page_index + 1 )); selected=$(( (page_index - 1) * PAGE_SIZE ))
        elif [[ "$LIST_SOURCE" == "search" ]] && ((FILTER_MODE == 0)); then
            # Past the last page of a SEARCH, → keeps going: fetch one more batch
            # and step onto the first new page. Only if the row count actually
            # grew — on a fetch failure more_results rolled back and reported, and
            # an exhausted query appends nothing; in both cases the cursor must
            # stay where it was. Stored rows (playlist / history) have nothing more
            # to fetch, so there the arrow just stops: this LIST_SOURCE test is
            # what keeps that a silent no-op rather than a notice about a query
            # those rows never had — and it is the same test the ← arm below makes.
            #
            # FILTER_MODE is the second half of the same guard, and it was MISSING
            # (measured 2026-08-29: `/` then `zzz` then → against 20 rows fetched
            # 20 more and dropped the filter). filter_live drives this very
            # function for its arrows, so "no filter can be open here" was an
            # assertion, not a fact — the page a filter is showing is a page of the
            # MATCHES, and running off its end is not a request for more rows. Both
            # edges take the test, so growing cannot discard the filter and
            # shrinking cannot reload ALL_ROWS underneath it.
            prev_pages=$NUM_PAGES
            more_results
            if ((NUM_PAGES > prev_pages)); then
                page_index=$(( page_index + 1 )); selected=$(( (page_index - 1) * PAGE_SIZE ))
            fi
        fi ;;
    "[D" | "OD" | "["*D | "O"*D) # left → prev page
        if ((page_index > 1)); then
            page_index=$(( page_index - 1 )); selected=$(( (page_index - 1) * PAGE_SIZE ))
        elif [[ "$LIST_SOURCE" == "search" ]] && ((FILTER_MODE == 0)); then
            # Before page 1 of a SEARCH, ← keeps going the other way: drop the last batch
            # of rows. The exact mirror of the arm above — same key grammar, no modifier,
            # same LIST_SOURCE guard — and it lands on what was a dead no-op. It cannot be
            # Shift+←: the `["*D glob two lines up eats every modified arrow into a bare
            # one, and Terminal.app does not send the modified form at all, so the key
            # would silently do nothing on the terminal this suite's floor is named after.
            fewer_results
        fi ;;
    esac
}

# ── Initial fetch ───────────────────────────────────────────────────────────────────────
# Where the rows on screen came from. Everything that RE-FETCHES a query (→ / o / e) is
# search-only and tests this; everything that works on the rows themselves (arrows, Enter,
# /, v, the playback keys) does not care and is left alone.
LIST_SOURCE="search"
PLAYLIST_ENGINES=""
# The playlist a `playlist` LIST_SOURCE is showing, as the store spells it. Read only under
# that source, so it is never stale where it is read.
PLAYLIST_NAME=""
# What Esc puts back when a store (b / h) replaced the search on screen.
SEARCH_STASH_JSON=""
SEARCH_STASH_ROWS=""
SEARCH_STASH_LABEL=""
SEARCH_STASH_ENGINES=""
SEARCH_STASH_SEL=0
SEARCH_STASH_PAGE=1
PROMPT_NAME=""
FILTER_LABEL=""
FILTER_MODE=0
selected=0
page_index=1
# Interactive: with no query on command line, prompt for one. Esc / empty / Ctrl-D all cancel.
# Deliberately down HERE and not up with the other startup setup: the plain `read -r` this used
# to be had no way to see Esc, so the first prompt of the session was the one place in the app
# where Esc did nothing. read_query_input already owns that contract (and UTF-8 assembly, and
# backspace) for the in-app new-search prompt, and bash cannot call a function before its
# definition — so the prompt moves to the reader rather than the reader being duplicated.
# Echo off for the duration: read_query_input echoes what it assembles, so the driver's copy
# would print every character twice (see tty_echo_off).
if ((${#query[@]} == 0)); then
    # The prompt names the ENGINE, not a site: this file learned "YouTube" back when there
    # was only one, and that string was the last piece of source knowledge left in it.
    printf '%s %s %s: ' "$GL_CARET" "$S_PROMPT_SEARCH" "$ENGINE" >&2
    tty_echo_off
    # if-form, not `read_query_input; rc=$?`: a cancel returns status 1, and under set -e that
    # bare call kills the script at status 1 before this block can say what it meant (see
    # char_w). Cancelling the first prompt is a clean quit, so it exits 0.
    if ! read_query_input; then tty_echo_restore; exit 0; fi
    tty_echo_restore
    [[ "$QUERY_INPUT" == *[![:space:]]* ]] || { echo "ting: no query entered" >&2; exit 0; }
    query=("$QUERY_INPUT")
fi
QUERY_LABEL="${query[*]}"

_startup_url=$(extract_url_target "$QUERY_LABEL")
if is_url_target "$_startup_url"; then
    QUERY_LABEL="$_startup_url"
    if ! load_url "$QUERY_LABEL"; then
        json='{"count":0,"results":[]}'
        CURRENT_ENGINE="$ENGINE"
        build_all_rows
        load_rows "$ALL_ROWS"
    fi
else
    # The first fetch is a network round trip and nothing has been drawn yet, so without this the
    # session opens on a blank terminal for a couple of seconds and reads as hung. Same wording as
    # the `n` prompt's line, plus the query — a query that came from argv was never echoed back, and
    # this is the only thing on screen until the list paints over it.
    printf '%s "%s"%s' "$S_SEARCHING" "$QUERY_LABEL" "$GL_ELL"

    rc=0
    fetch_json || rc=$?
    if ((rc != 0)); then
        # A first search that matched nothing is not a failed session. This used to `die`, so one
        # mistyped character threw away the whole menu loop — and with it the `n` that fixes the
        # typo, the `e` that asks another source the same question, and the `b`/`h` that need no
        # network at all. It now takes the shape every other empty row source takes
        # (ARCH-tui.md「一条提示是帧的内容，不是一次停顿」): a notice, and a list with no rows.
        # rc 2 ONLY. An engine that actually broke still dies, because then there is nothing on
        # screen to steer and SEARCH_ERR is the only thing worth saying.
        if ((rc == 2)); then
            # fetch_json sets neither of these until it has an envelope, and this is the ONE path
            # that reaches the menu loop without it ever having had one — so they are completed
            # here rather than left at their startup values.
            # An ENVELOPE, not an empty ALL_ROWS: `json` is the document focused_payload cuts a
            # row out of and back_to_search stashes, so a source on screen that is not a jq
            # document would be a second shape for both of them to survive.
            json='{"count":0,"results":[]}'
            # Not a copy of fetch_json's fallback. With no rows nothing reads CURRENT_ENGINE —
            # until `b` opens a stored item carrying no engine tag of its own, where play_selected
            # falls back to it; empty there is the one thing that hands t-play `--engine ""`.
            CURRENT_ENGINE="$ENGINE"
            report_fetch_failure 2 "$QUERY_LABEL"
        else
            die "${SEARCH_ERR:-search failed}"
        fi
    fi
    apply_search_results
fi
# After the rows exist, because the adopted track may be one of them (the liveness lookup in
# there), and before the first frame, because an empty banner over a playing track is the
# whole bug. It is also the last thing that may fork before the tty changes hands.
probe_active_player


# From here on every keystroke belongs to the UI, so take the driver's echo out of the way.
# After the trap is installed, never before: the restore has to be reachable from every exit.
tty_echo_off

# ── Menu loop ─────────────────────────────────────────────────────────────────────────
while true; do
    check_player_alive   # a player that ended or crashed must not keep its banner
    player_check_ready   # …and one that has not started yet must not claim it is playing
    chapter_follow       # …and a chapter list must move with the playhead, not with the keys
    undo_tick            # …and a closed undo offer must stop what its delete held back
    relocate_tools       # …and an upgrade that moved the tools must not strand the player
    # Page mode's clamp only. In scroll mode the cursor is free to be anywhere in the list
    # and it is the WINDOW that follows — clamping it into a page-sized box here would undo
    # every move the moment it crossed one, which is the whole difference between the modes.
    if [[ "$LIST_MODE" == "page" ]]; then
        page_min=$(( (page_index - 1) * PAGE_SIZE ))
        page_max=$(( page_min + PAGE_SIZE - 1 ))
        if ((selected < page_min)); then selected=$page_min; fi
        if ((selected > page_max && selected < NUM_ENTRIES)); then selected=$page_max; fi
    fi

    display_menu "$page_index"

    if ! read_nav_input; then continue; fi

    # The jump count dies on any key that is not building it or ending it — vim's rule, and
    # the reason it is HERE, in front of both case blocks, is that the universal block's arms
    # all end in `continue`: Space, s, -, =, [, ], ?, # and Tab never reach the list block at
    # all, so a clearing point after it would let `1` `=` `j` jump to row 1. One point rather
    # than a clear in every arm, which is a list to maintain and a register that survives
    # whichever key gets forgotten. This does not read or write the count from a universal
    # arm — it runs before either block picks a key up.
    case "$READ_NAV_KEY" in
    [0-9] | j | J) ;;
    *) JUMP_COUNT="" ;;
    esac

    # Universal controls (active in all views): playback, and the key-hint tier.
    case "$READ_NAV_KEY" in
    " ") toggle_pause; continue ;;
    s | S) stop_current_playback; continue ;;
    # Loop is a playback key, so it lives with the playback keys, for the reason written over
    # the volume pair below: what happens when a track ends belongs to the player and not to
    # a view, and every row source can have one running.
    #
    # LOWER CASE ONLY, and the one arm in this block that does not also take its shifted
    # twin: ROADMAP.md「还没做的事」 has `R` down for renaming the playlist on screen, and a
    # greedy `r | R` here would eat that key before it is written.
    r) cycle_loop_mode; continue ;;
    # Volume moved off 9/0 because the digits are worth more as row jumps: a ten-row
    # window whose rows can be NAMED by a digit and not REACHED by one is a readout
    # pretending to be a control. `=` and not `+`, because `+` is already enqueue and `=`
    # is the unshifted key in the same physical place, so the two read as one rocker.
    # They stay UNIVERSAL for the reason they always were: volume belongs to the player,
    # not to a view, and every row source can have one running.
    "-") adjust_volume -5; continue ;;
    "=") adjust_volume 5; continue ;;
    "[") seek_relative -10; continue ;;
    "]") seek_relative 10; continue ;;
    # The door to the other key tier, universal for the same reason the playback keys are:
    # BOTH views print a tiered block, so a door that opened from only one of them would
    # leave the other showing a core block it could not expand. QUOTED, because a bare ? in a
    # case pattern is the glob for any single character and would swallow every key below it.
    # `？` is the full-width form a zh input method makes of shift-/ — utf8_complete already
    # assembles it into one key, so binding it is one more pattern and not a second path.
    "?" | "？") cycle_keys; continue ;;
    # Row numbers, and universal for the same reason the key tier is: every row source
    # prints rows, so a toggle that worked in only one of them would leave the others with a
    # labelling the user could not change. `＃` is the full-width form a zh input method
    # makes of shift-3, bound beside it exactly as `？` is beside `?`.
    "#" | "＃") cycle_row_index; continue ;;
    # Tab was left deliberately unbound when the second renderer went — an empty key beats a
    # key spent on whatever was nearest. It has something to reach again: two windowings of
    # ONE renderer, which is the gesture Tab means everywhere else. Universal, like the two
    # toggles above it: every row source is windowed, so a mode that worked in one of them
    # would leave the others in a shape the user could not change.
    $'\t') cycle_list_mode; continue ;;
    esac

    # List View specific handlers
    case "$READ_NAV_KEY" in
    # j/k reach move_selection ONLY from here. filter_live drives the same function for its
    # arrows and deliberately does not add them: with `/` open they are text the user is
    # typing into the query, and a navigation key that ate a letter would be unusable.
    "[A" | "OA" | "["*A | "O"*A | "[B" | "OB" | "["*B | "O"*B | \
    "[C" | "OC" | "["*C | "O"*C | "[D" | "OD" | "["*D | "O"*D | k | K)
        move_selection "$READ_NAV_KEY" ;;
    # `j` is two keys in one, told apart by the register and never by a clock: with a count
    # pending it ENDS the count and jumps, with none it is the down-arrow it has always been.
    # It has to be lifted out of the arrow pattern above to be either — bash's case takes the
    # FIRST matching arm, so a `j` left up there makes this one dead code and `12j` silently
    # does nothing at all. The vim reading of `3j` is "down three", not "to row 3"; that is a
    # known and accepted mis-read, taken because `j` is where the hand already is.
    j | J)
        if [[ -n "$JUMP_COUNT" ]]; then
            jump_to_row "$JUMP_COUNT"
            JUMP_COUNT=""
        else
            move_selection "$READ_NAV_KEY"
        fi ;;
    # Enter → start/switch track in background. A chapter row means the same thing with an
    # offset, and says so through play_chapter's two branches.
    "" | $'\n' | $'\r')
        if [[ "$LIST_SOURCE" == "chapters" ]]; then play_chapter || true
        elif [[ "$LIST_SOURCE" == "queue" ]]; then play_queued_now
        else play_selected || true; fi ;;
    # A digit does not move anything: it appends to the pending row number, which `j` then
    # ends. In THIS case block and deliberately not the universal one above — with `/` open a
    # digit is query text the user is typing (`2026` is a real query), and filter_live runs
    # its own reader that reaches neither block, so keeping the digits out of the universal
    # case is what makes the filter safe by construction instead of by a guard that has to be
    # remembered. Same trap j/k already walked into.
    #
    # Six digits is an ARITHMETIC guard and not a semantic one: a 20-digit run overflows the
    # 64-bit $(( )) that reads it. Everything past the sixth is dropped in silence; being out
    # of range is jump_to_row's business, not this line's.
    [0-9])
        if ((${#JUMP_COUNT} < 6)); then JUMP_COUNT="$JUMP_COUNT$READ_NAV_KEY"; fi ;;
    n | N) new_search ;;      # new search (non-blocking: music continues)
    # A paste is a URL or QUERY. If a URL is pasted directly in the list, resolve
    # and present it immediately; otherwise open the prompt with the text in it.
    PASTE)
        _target_url=$(extract_url_target "$PASTE_TEXT")
        if is_url_target "$_target_url"; then
            load_url "$_target_url" || true
        else
            new_search "$PASTE_TEXT"
        fi
        ;;
    o | O) cycle_sort ;;      # rotate sort
    e | E) cycle_engine ;;    # switch source (engine), re-fetch the same query
    v | V) cycle_mode ;;      # rotate playback mode
    f | F) cycle_quality ;;   # rotate quality tier (the engine maps (mode, tier) to a sort)
    l | L) cycle_ui_lang ;;   # toggle chrome language (en <-> zh)
    t | T) cycle_theme ;;     # cycle palette family live
    a | A) add_to_playlist ;; # add the focused row to a playlist
    b | B) browse_playlists ;;# open a stored playlist as the row source
    d) delete_from_playlist ;;        # remove the focused row from the playlist on screen
    D) delete_current_playlist ;;     # delete the entire playlist on screen
    R) rename_current_playlist ;;     # rename the playlist on screen
    z | Z) undo_last ;;               # take back the last d/D/R/a/+/x/X, while it is offered
    # The three row sources say "did not open" with 1 — an empty log, a one-part video, a
    # video with no chapters, and every fetch that failed — and each of those paths has
    # already stored its notice (a frame line the next key clears). Without `|| true` set -e
    # reads that 1 as a dying TUI and takes the whole loop down on the very key that opened
    # the view, which is the worst possible moment to exit: the user asked for something. Same guard, same reason, as the Enter arm above.
    h | H) open_history || true ;;    # open the listening log as the row source
    c | C) open_parts || true ;;      # open the focused row's parts (?p=N) as the row source
    i | I) open_chapters || true ;;   # open the focused row's chapters as the row source (one --info)
    "+") enqueue_selected ;;  # append the focused row to the running player's queue
    ">") skip_next ;;         # skip to the next queued track
    # The sixth row source, and the second half of what `+` starts: `+` writes into the queue
    # blind, `u` is where you look at what you wrote. `|| true` for the reason the three
    # openers above carry it — a row source that answers "not here" returns 1, and a bare 1
    # under set -e takes the whole TUI down on the keypress meant to dismiss the notice.
    u | U) open_queue || true ;;
    # The four keys that only mean anything with the queue on screen. Gated on LIST_SOURCE
    # rather than bound globally, because each of them acts on a QUEUE POSITION and a search
    # row does not have one — and an unguarded `x` would be a destructive key that fires from
    # anywhere. The keys themselves were free; nothing was taken from another view to get them.
    x | X | p | P)
        if [[ "$LIST_SOURCE" == "queue" ]]; then
            case "$READ_NAV_KEY" in
            x) queue_remove ;;          # drop the focused waiting track
            X) queue_clear ;;           # drop every waiting track
            p) queue_move -1 ;;         # one slot earlier
            P) queue_move 1 ;;          # one slot later
            esac
        else
            case "$READ_NAV_KEY" in
            p | P) paste_from_clipboard ;;
            esac
        fi ;;
    $'\x16') paste_from_clipboard ;;   # Ctrl+V
    "/") filter_live ;;       # LIVE incremental filter
    q)
        stop_current_playback
        printf '%s%s\n' "$S_QUITTING" "$GL_ELL"
        exit 0
        ;;
    Q)
        QUIT_KEEP_PLAYING=1
        printf '%s%s\n' "$S_QUITTING" "$GL_ELL"
        exit 0
        ;;
    ESC) ;;
    *) ;;
    esac
done
