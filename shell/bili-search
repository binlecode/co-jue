#!/usr/bin/env bash
# bili-search — the Bilibili SEARCH ENGINE: query -> result envelope. Agent-facing.
#
# One half of the bilibili engine pair (`bili-search` + `bili-resolve`); the player
# (`t-play`) is source-agnostic and knows neither. This file owns everything that is
# Bilibili-specific about searching: the HTTP call, the result shaping, and the three data
# shapes this site returns that no other one does. It has NO playback, lifecycle, or mpv
# logic and never starts a process that outlives it.
#
# WHY THIS HALF TALKS HTTP WHILE ITS SIBLING SHELLS OUT TO yt-dlp. Measured 2026-08-23,
# and the split is not a preference — it is the only combination that works:
#   yt-dlp --flat-playlist  1 request, 0.9s, and ZERO metadata: entries carry an av id and
#                           nothing else (BiliBiliSearchIE yields url_result(arcurl, aid)
#                           and drops the title/author/duration/play sitting in the very
#                           response it just parsed).
#   yt-dlp full extraction  N+1 requests, and it does not merely cost more: Bilibili's music
#                           results are overwhelmingly multi-part COLLECTIONS, so each entry
#                           recurses into its own parts. `bilisearch10:周杰伦` did not
#                           finish in 120s.
#   this file               1 request, 0.71s, every field the envelope needs.
# So the search half is HTTP and the resolve half is yt-dlp, which also puts a useful line
# through the middle of the engine: the hand-written HTTP path NEVER TOUCHES A CREDENTIAL.
# The only cookie it sends is a buvid3 it generates itself (see below) — no account, no
# token, nothing read from a browser profile. Login lives entirely in `bili-resolve`, where
# yt-dlp owns it. docs/ARCHITECTURE.md「原语与接缝」; ARCHITECTURE.md「站点知识的边界」.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features; guard empty-array
# expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). ARCHITECTURE.md「可移植性契约」.

# Resolve this script's OWN symlink chain before looking for its siblings — see the same
# block in yt-search for why `cd -P`/`pwd -P` and a hand-rolled loop (bash 3.2 has no
# `readlink -f`).
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)

# THE version of the whole suite, declared once — in a data file, not in code. See the same
# block in yt-search / yt-resolve / t-play. CLAUDE.md § one fact, one place.
if [[ -r "$SCRIPT_DIR/../VERSION" ]]; then
    UT_VERSION=$(cat "$SCRIPT_DIR/../VERSION")
else
    UT_VERSION="unknown"
fi

# CONFIGURATION — the chain is flag > environment > the user's config > the shipped defaults
# in `<checkout>/config`, which is where every default value in the suite is declared once.
# Duplicated VERBATIM in all ten entry points — see the same block in t-play for why, and
# ARCH-cli-contract.md「配置面」 for the keys.
TING_CONFIG="${TING_CONFIG:-${UT_CONFIG:-}}"
if [[ -z "$TING_CONFIG" ]]; then
    if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/ting/config" ]]; then
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ting/config"
    else
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/uting/config"
    fi
fi
UT_CONFIG="$TING_CONFIG"
for _v in STATE_DIR ENGINE_DIR HISTORY THEME ACCENT VOLUME LANG IMAGE KEYS RESOURCE RESOURCE_TICKS BRAND ASCII SYNC PLAY_QUALITY VIZ_STYLE VIZ_COLOR DEAD_KEEP DEFAULT_ENGINE MODE_CYCLE SORT_CYCLE THEME_CYCLE QUALITY_CYCLE LOOP_CYCLE; do
    eval "[[ -n \"\${TING_$_v+x}\" ]] && UT_$_v=\"\$TING_$_v\" || true"
    eval "[[ -n \"\${UT_$_v+x}\" && -z \"\${TING_$_v+x}\" ]] && TING_$_v=\"\$UT_$_v\" || true"
done
UT_DEFAULTS="$SCRIPT_DIR/../config"
ut_read_config() {
    local file="$1" line key val _ting_k _ut_k
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        while [[ "$line" == [[:space:]]* ]]; do line="${line#[[:space:]]}"; done
        while [[ "$line" == *[[:space:]] ]]; do line="${line%[[:space:]]}"; done
        [[ -n "$line" && "$line" == *=* ]] || continue
        key="${line%%=*}"
        val="${line#*=}"
        while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
        while [[ "$val" == [[:space:]]* ]]; do val="${val#[[:space:]]}"; done
        [[ "$key" =~ ^(TING|UT|YT|BILI|NE)_[A-Z0-9_]+$ ]] || continue
        case "$key" in
        TING_CONFIG | TING_DEFAULTS | TING_ENGINE_DIR | TING_VERSION | UT_CONFIG | UT_DEFAULTS | UT_ENGINE_DIR | UT_VERSION | YT_IPC_SOCK | YT_DETACHED | YT_PLAYER_ID | YT_DETACHED_LOG) continue ;;
        esac
        if [[ ${#val} -ge 2 ]] && { [[ "$val" == \"*\" ]] || [[ "$val" == \'*\' ]]; }; then
            val="${val#?}"
            val="${val%?}"
        fi
        [[ "$val" == "~/"* ]] && val="$HOME/${val#\~/}"
        if [[ "$key" == TING_* ]]; then
            _ut_k="UT_${key#TING_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ut_k+x}\" ]] || $_ut_k=\$val"
        elif [[ "$key" == UT_* ]]; then
            _ting_k="TING_${key#UT_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ting_k+x}\" ]] || $_ting_k=\$val"
        else
            eval "[[ -n \"\${$key+x}\" ]]" && continue
            eval "$key=\$val"
        fi
    done < "$file"
}
# FAIL FAST AND SAY WHY. There is deliberately no escape hatch for --version or --help: they
# were tried, and letting execution continue past a missing defaults file replaced this one
# clear line with `YT_ASCII_VO: unbound variable` from set -u somewhere further down. A
# checkout missing part of itself is not a dependency gate (yt-dlp, jq and mpv still answer
# --version without being installed) — it is a broken checkout, and 2 is the exit code for a
# failure that is not the caller's usage error.
if [[ ! -r "$UT_DEFAULTS" ]]; then
    printf '%s: cannot read the shipped defaults at %s — that file declares every default value in the suite and is not optional\n' \
        "$(basename "$0")" "$UT_DEFAULTS" >&2
    exit 2
fi
ut_read_config "$UT_CONFIG"
ut_read_config "$UT_DEFAULTS"

# The engine's own name, as it appears in the envelope AND as the command prefix its two
# executables carry. Name == prefix is what lets `t-play --engine bili` find `bili-resolve`
# by string concatenation, with no name->command registry. docs/ARCHITECTURE.md「命令拓扑」.
ENGINE_NAME="bili"

# ==============================================================================
# 1. SETTINGS
# ==============================================================================

SEARCH_ENDPOINT="https://api.bilibili.com/x/web-interface/search/type"

# The Referer is REQUIRED and is the only thing that is: with it the endpoint answers
# code:0, without it 412 (measured 2026-08-23). It is a public constant, not an
# authentication mechanism — every Bilibili extractor in yt-dlp sends the same one.
#
# UNPREFIXED, like SEARCH_ENDPOINT above and for the same reason: since ARCHITECTURE.md「两个根数据文件」 the prefix IS
# config reachability — ut_read_config accepts every UT_/YT_/BILI_/NE_ name that is not in its
# refusal list — so a BILI_ spelling would be taken off disk and then silently overwritten
# by this line 16 lines later. A constant must not wear a settable name.
SEARCH_REFERER="https://www.bilibili.com/"

# A browser User-Agent. Overridable because the site is known to start refusing a UA that
# has gone stale (yt-dlp carried a commit for exactly that), and a suite that cannot be
# nudged without an edit would need a release to survive it. It must not contain `curl` or
# `python`: those substrings are refused.

# A buvid3 is a DEVICE identifier, not a credential: no account, no token, nothing read
# from a browser profile — this engine generates a random one and throws it away when the
# process exits. It is sent because without it the endpoint rate-limits a burst hard:
# measured 2026-08-23 over six consecutive searches, anonymous scored 200 200 412 412 412
# 200 and the same six with a stable buvid3 scored 200 six times. An engine that fails half
# the time is not an engine, so this is a correctness requirement rather than a nicety.
#
# The `<uuid>infoc` spelling and the generate-locally-rather-than-ask-the-server choice are
# both what yt-dlp already does for every Bilibili request it makes, so nothing site-
# specific is being invented here.
#
# ONE per process, generated lazily and reused across pages: a fresh identifier on every
# page would present the burst as several brand-new devices, which is the shape the limiter
# is looking for. Overridable so a caller that has its own can pass it. If `uuidgen` is
# missing the engine degrades to anonymous rather than failing — the same graceful
# degradation the sibling engines apply to an absent browser profile.
BILI_BUVID="${BILI_BUVID:-}"

# The limiter is bursty rather than sticky: a 412 is very often followed by a 200. One
# retry, once, converts that into a success without turning a failing search into a
# hammering loop. Anything past this is the caller's to decide — it gets `network`, which
# is the enum member that already means "retryable".
#
# ENGINE-SPECIFIC on purpose: this pause exists for THIS host's burst limiter, and this file
# is the only place in the suite that builds an HTTP request by hand. `yt-search` shells out
# to yt-dlp and has no retry path for a shared knob to govern. ARCH-cli-contract.md「配置面」.

# The server's page size, not ours: the endpoint returns 20 per page regardless of what we
# ask. It is a constant here so `-n` can span pages without the caller knowing that.
PAGE_SIZE=20
# THE FETCH CEILING IS COUNTED IN ROWS, NOT PAGES — and it is CROSS-ENGINE. Requests
# against this host are the scarce resource (rate limiting has been observed at roughly 15
# in a session), so a fat `-n` must cost a bounded number of them rather than however many
# it asks for. That budget used to be spelled as a page count, which could only ever be this
# engine's: a page is 20 rows HERE, and `yt-search` has no page loop at all for a page count
# to bind on. Rows are what the envelope contains, so a row ceiling is a promise both
# engines can keep — this one converts it to a page plan below, `yt-search` clamps its
# `ytsearchN`. The default is 200, which is exactly the ten pages this engine spent before,
# so the measured budget is unchanged. ARCH-cli-contract.md「配置面」.

# The `-n` default. Cross-engine: a caller who wants a different result count by default
# wants it from whichever source they asked. ARCH-cli-contract.md「配置面」.
NUM_RESULTS=$UT_SEARCH_RESULTS
MIN_DURATION=0
MAX_DURATION=0
# The `-s` default, cross-engine like `-n`.
SORT_FIELD="$UT_SORT_FIELD"
COLOR_MODE="auto"
OUTPUT_MODE="list"
QUERY=""
FILTERED_JSON=""

# Glyph fallback shares ONE switch with ting (YT_ASCII, legacy alias YT_TUI_ASCII): a
# terminal whose font can't draw ♫ can't draw it in either surface, and a non-UTF-8 locale
# (bare cron/launchd) would emit mojibake. Empty = drop the glyph, as ting does.
MUSIC_CHAR="♫"
case "${YT_ASCII:-${YT_TUI_ASCII:-}}" in
1 | true | yes | on) MUSIC_CHAR="" ;;
"")
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8* | *utf-8* | *UTF8* | *utf8*) ;;
    *) MUSIC_CHAR="" ;;
    esac
    ;;
esac

# ==============================================================================
# 2. HELPERS
# ==============================================================================

err() {
    local red='' reset=''
    case "${COLOR_MODE:-auto}" in
    always)
        red=$'\033[31m'
        reset=$'\033[0m'
        ;;
    auto)
        if [[ -t 2 ]]; then
            red=$'\033[31m'
            reset=$'\033[0m'
        fi
        ;;
    never) ;;
    esac
    echo "${red}Error:${reset} $*" >&2
}

die() {
    err "$@"
    exit 1
}

# A missing tool is not a malformed call: `die` is exit 1 (the argv is wrong — fix it),
# `die_dep` is exit 2 (the argv was fine; the machine is missing something no rewrite of the
# argv will supply). An agent that read 1 here would loop editing its own parameters against
# a wall. docs/ARCH-cli-contract.md「退出码、TTY、依赖」.
die_dep() {
    err "required command not found: $1"
    exit 2
}

is_non_negative_int() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

validate_enum() {
    local value=$1
    shift
    local allowed
    for allowed in "$@"; do
        if [[ "$value" == "$allowed" ]]; then
            return 0
        fi
    done
    return 1
}

require_cmd() {
    local cmd=$1
    command -v "$cmd" >/dev/null 2>&1 || die_dep "$cmd"
}

require_deps() {
    local cmd
    for cmd in "$@"; do
        require_cmd "$cmd"
    done
}

# The ONE implementation of duration formatting: seconds -> "[Nd ]HHh:MMm:SSs". A jq
# prelude, not a bash function, so a caller already shaping JSON pays one fork instead of
# one per row. Each engine carries its own copy: they are independent executables sharing
# no library, and the shared fact is the FORMAT, which is stated once in
# docs/ARCH-engine.md「搜索子系统」.
#
# Bilibili adds the site-specific half: `duration` arrives as "MM:SS" with UNBOUNDED
# minutes and an UNPADDED seconds field ("222:28", "416:0", "682:4" all measured in one
# response), which is a third duration spelling the suite had not seen. Parsing it here,
# in the engine, is what keeps every surface above it reading plain seconds. The `//`
# fallbacks are not decoration: a field that is missing, empty, or non-numeric yields null,
# and null renders as "--" rather than as a confident 00h:00m:00s.
JQ_PRELUDE='
def p2: tostring | if length < 2 then "0" + . else . end;
def fmt_dur:
  if type != "number" then null
  else (. | floor) as $t
    | ($t / 86400 | floor) as $d
    | (($t % 86400) / 3600 | floor) as $h
    | (($t % 3600) / 60 | floor) as $m
    | ($t % 60) as $s
    | (if $d > 0 then "\($d)d " else "" end) + "\($h | p2)h:\($m | p2)m:\($s | p2)s"
  end;
def bili_secs:
  if type == "number" then floor
  elif type != "string" or . == "" then null
  else (split(":") | map(tonumber? // null)) as $p
    | if ($p | any(. == null)) then null
      elif ($p | length) == 3 then ($p[0] * 3600 + $p[1] * 60 + $p[2])
      elif ($p | length) == 2 then ($p[0] * 60 + $p[1])
      elif ($p | length) == 1 then $p[0]
      else null end
  end;
# THE COVER, normalised to one directly-GETtable https URL — the site field name stops here.
# `pic` is what this site calls it, and a caller must never learn that (CLAUDE.md: site
# knowledge lives in an engine); it arrives PROTOCOL-RELATIVE — measured 2026-09-01 and
# again 2026-09-03, `//i0.hdslb.com/bfs/archive/<hash>.jpg` on every row of every query —
# so the scheme is not optional decoration, it is the difference between a URL curl can
# fetch and a path it cannot. Anything that is not a non-empty string is null, and the key
# stays present (ARCH-cli-contract.md「数据契约」).
def pick_thumb:
  (.pic // "") as $p
  | if ($p | type) != "string" or $p == "" then null
    elif ($p | startswith("//")) then "https:" + $p
    elif ($p | startswith("http://")) then ($p | sub("^http://"; "https://"))
    elif ($p | startswith("https://")) then $p
    else null
    end;
'

# Titles come back as SEARCH-RESULT HTML, not as text: the matched query is wrapped in
# <em class="keyword">…</em> and the rest is entity-escaped. Both have to go, and they have
# to go HERE — the width layer above measures display cells, so a title still carrying 24
# characters of markup reflows every row wrongly at a narrow width.
#
# `&amp;` is unescaped LAST on purpose. A title containing the literal text `&lt;` arrives
# as `&amp;lt;`; unescaping &amp; first would turn it into `&lt;` and the next rule would
# turn that into `<`, inventing markup the uploader never wrote.
JQ_CLEAN_TITLE='
def clean_title:
  if type != "string" then null
  else gsub("<[^>]*>"; "")
    | gsub("&quot;"; "\"") | gsub("&#39;"; "\u0027") | gsub("&apos;"; "\u0027")
    | gsub("&lt;"; "<") | gsub("&gt;"; ">") | gsub("&nbsp;"; " ")
    | gsub("&amp;"; "&")
  end;
'

# Map an HTTP status + the response body's own `code` to the suite's stable reason taxonomy
# so an agent caller can branch on `reason` instead of on Bilibili's numbers. The ENUM is
# the shared fact and lives in ARCH-cli-contract.md「数据契约」 — no member may be added here that
# it does not already have.
#
# THREE LAYERS, ALL CHECKED. This host says "no" in three different places: an HTTP status,
# a `code` inside a body served with HTTP 200, and — the quietest one — a body served with
# HTTP 200 AND code:0 that carries a risk-control voucher instead of results. Reading only
# the first reports a rate limit as a success with zero results; reading only the first two
# reports a captcha challenge the same way.
#
# The rate-limit codes (-352, -412, and HTTP 412) land in `network`, not `forbidden` or
# `unknown`: they are RETRYABLE, and `network` is the member that already means "try again
# later" — the same call 429 gets in the yt-dlp-side classifiers. `forbidden` would tell a
# caller these credentials never work, which is the wrong instruction.
classify_http_error() {
    local curl_rc=$1 http=$2 code=$3 risk=${4:-0}
    # curl never got an answer: DNS, connection refused, TLS, timeout. All transport.
    if ((curl_rc != 0)); then
        echo "network"
        return
    fi
    # A risk-control challenge (see fetch_page_once) is the same bursty limiter the 412 is,
    # wearing a success's clothes — so it gets the same retryable member, and it is checked
    # BEFORE the status/code tables because both of those read as "fine" here.
    if ((risk)); then
        echo "network"
        return
    fi
    case "$http" in
    412 | 429 | 5??) echo "network"; return ;;
    403) echo "forbidden"; return ;;
    404) echo "unavailable"; return ;;
    esac
    case "$code" in
    -352 | -412 | -509 | -799) echo "network"; return ;;
    -403 | 62002) echo "forbidden"; return ;;
    -404 | -400) echo "unavailable"; return ;;
    esac
    echo "unknown"
}

# This process's own scratch dir: 0700, created lazily, removed however we exit. Lazily
# because -h / -V must answer without touching the filesystem, and process-level rather
# than a function `local` because the EXIT trap runs after the function has returned — a
# `local` would be out of scope there and abort under `set -u`.
#
# The engine does not write into the player's state dir: `players/` has exactly one owner
# (t-play). 0700 rather than a bare /tmp path because a response body is content.
SCRATCH_DIR=""
cleanup_scratch() {
    [[ -n "$SCRATCH_DIR" ]] && rm -rf "$SCRATCH_DIR" 2>/dev/null
    return 0
}
trap cleanup_scratch EXIT

ensure_scratch() {
    [[ -n "$SCRATCH_DIR" ]] && return 0
    SCRATCH_DIR=$(mktemp -d "${TMPDIR:-/tmp}/bili-search.XXXXXX") || die "cannot create a scratch directory"
    chmod 700 "$SCRATCH_DIR" 2>/dev/null || true
}

# ==============================================================================
# 3. SEARCH
# ==============================================================================

# Report a search that produced nothing usable, in whichever shape the caller asked for.
# Exit code follows the suite taxonomy: ARCH-cli-contract.md「退出码」 reserves 1 for usage/validation, so a failure
# to reach or parse the site is 2 — a caller branching on the exit code must be able to
# tell "you called me wrong" from "the site did not answer".
search_fail() {
    local reason=$1
    if [[ "$OUTPUT_MODE" == "json" || "$OUTPUT_MODE" == "json_full" ]]; then
        jq -nc --arg e "$ENGINE_NAME" --arg q "$QUERY" --arg reason "$reason" \
            '{status: "error", engine: $e, query: $q, count: 0, results: [], reason: $reason}'
    else
        echo "Error: search failed for '$QUERY' ($reason)" >&2
    fi
    exit 2
}

# One page of results, as the raw `data.result` array. Arguments reach curl as an ARRAY and
# the query values through --data-urlencode, so a query containing `&`, a space or a quote
# is a value and never a second parameter.
ensure_buvid() {
    [[ -n "$BILI_BUVID" ]] && return 0
    command -v uuidgen >/dev/null 2>&1 || return 0
    BILI_BUVID="$(uuidgen)infoc"
    return 0
}

# WHAT THE SITE WILL FILTER FOR US, and why that is a request-count question rather than a
# feature. The endpoint pages at 20 and has no page-size knob, so the only way to spend
# fewer requests on a filtered search is to make each page's 20 rows ones the local pass
# will keep. `duration` is the site's own filter and it is COARSE — four buckets: 1 under
# 10 minutes, 2 for 10-30, 3 for 30-60, 4 over 60 (measured 2026-08-26: duration=1 returns
# a full page whose every row is under 10 minutes).
#
# A bucket is chosen ONLY when every duration the local bounds would accept falls inside it
# — a superset of the answer, never a narrower cut. That is the whole discipline here: a
# bucket that clipped one accepted row would make the server filter change the ANSWER
# instead of the cost, and the bucket edges (is exactly 600s bucket 1 or 2?) are not
# something this engine can know. A window straddling two buckets — `-M 900`, the very
# example in the help text — therefore gets 0 and no server help. The local bounds stay in
# place either way: they are exact, and the bucket is not.
DURATION_BUCKET=0
duration_bucket() {
    local lo=$1 hi=$2
    if ((hi > 0 && hi <= 600)); then
        echo 1
    elif ((lo >= 600 && hi > 0 && hi <= 1800)); then
        echo 2
    elif ((lo >= 1800 && hi > 0 && hi <= 3600)); then
        echo 3
    elif ((lo >= 3600)); then
        echo 4
    else
        echo 0
    fi
}

# The site's `order`, for the one sort field it shares with us. `-s view_count` asks for the
# most-played tracks, and asking the SITE for them (order=click) means the 20 rows that
# arrive are the most-played of the whole result set rather than the 20 most relevant
# re-ordered locally — a correctness gain at identical cost. `relevance` is the site's own
# default (totalrank), so it sends nothing and the request stays byte-for-byte the measured
# one. `-s duration` has NO server equivalent — this endpoint orders by click, pubdate,
# danmaku, favourite and comment, and not by length — so it stays a local re-order of the
# fetched set, which is the honest limit of a sort the site does not offer.
ORDER_PARAM=""

# One attempt. Sets PAGE_HTTP / PAGE_CODE / PAGE_RISK / PAGE_CURL_RC and leaves the body on
# disk; the caller decides whether the answer is worth a second try. Globals rather than a
# return value because four of them travel together and bash 3.2 command substitution would
# strip the file the fifth wrote.
PAGE_HTTP=""
PAGE_CODE=""
PAGE_RISK=0
PAGE_CURL_RC=0
fetch_page_once() {
    local page=$1 body=$2
    local cmd=(
        curl -sS --compressed
        --max-time 15 --retry 0
        -o "$body" -w '%{http_code}'
        -G "$SEARCH_ENDPOINT"
        --data-urlencode "search_type=video"
        --data-urlencode "keyword=$QUERY"
        --data-urlencode "page=$page"
        -H "User-Agent: $BILI_UA"
        -H "Referer: $SEARCH_REFERER"
    )
    ((DURATION_BUCKET > 0)) && cmd+=(--data-urlencode "duration=$DURATION_BUCKET")
    [[ -n "$ORDER_PARAM" ]] && cmd+=(--data-urlencode "order=$ORDER_PARAM")
    [[ -n "$BILI_BUVID" ]] && cmd+=(-H "Cookie: buvid3=$BILI_BUVID")

    PAGE_CURL_RC=0
    PAGE_HTTP=$("${cmd[@]}" 2>/dev/null) || PAGE_CURL_RC=$?
    PAGE_CODE=""
    PAGE_RISK=0
    if [[ -s "$body" ]]; then
        PAGE_CODE=$(jq -r '.code // empty' "$body" 2>/dev/null) || PAGE_CODE=""
        # The quiet refusal: HTTP 200, code:0, and a `data` holding a v_voucher — a captcha
        # ticket — where the result array should be (measured 2026-08-26 against the wbi
        # endpoint unsigned). Every layer above reads this as a search that found nothing,
        # so it has to be caught HERE, where the body is still in front of us. Both halves
        # are required: an exhausted page also omits `result`, and it is not a refusal.
        jq -e '(.data.v_voucher // null) != null and (.data.result | type) != "array"' \
            "$body" >/dev/null 2>&1 && PAGE_RISK=1
    fi
    ((PAGE_CURL_RC == 0)) && ((PAGE_RISK == 0)) && [[ "$PAGE_HTTP" == "200" && "$PAGE_CODE" == "0" ]]
}

# IT RETURNS A STATUS AND WRITES A FILE; IT DOES NOT PRINT AND IT DOES NOT DIE. Reporting a
# failure by calling `search_fail` from in here swallowed it: the caller runs this inside a
# command substitution, so the error envelope landed in a shell variable and a JSON caller got
# an empty stdout with a bare exit 2 — no `status`, no `reason`, the one thing the envelope
# exists to guarantee (ARCH-cli-contract.md「数据契约」). The exit code was right the whole
# time, which is why it went unnoticed.
FETCH_REASON=""
fetch_page() {
    local page=$1
    local body="$SCRATCH_DIR/page.$page.json"
    ensure_buvid

    if ! fetch_page_once "$page" "$body"; then
        local reason
        reason=$(classify_http_error "$PAGE_CURL_RC" "$PAGE_HTTP" "$PAGE_CODE" "$PAGE_RISK")
        # Only the retryable class earns a second attempt. A `forbidden` or `unavailable`
        # answer will say the same thing a second later, and asking again is just another
        # request against a host that counts them.
        if [[ "$reason" != "network" ]]; then
            FETCH_REASON="$reason"
            return 1
        fi
        sleep "$BILI_RETRY_PAUSE"
        if ! fetch_page_once "$page" "$body"; then
            FETCH_REASON=$(classify_http_error "$PAGE_CURL_RC" "$PAGE_HTTP" "$PAGE_CODE" "$PAGE_RISK")
            return 1
        fi
    fi

    # An exhausted or empty search omits `data.result` entirely rather than sending [].
    jq -c '.data.result // []' "$body" >"$SCRATCH_DIR/chunk.json" 2>/dev/null ||
        echo '[]' >"$SCRATCH_DIR/chunk.json"
    return 0
}

fetch_results() {
    ensure_scratch

    # Decide the request plan ONCE, before the first page: every page of one search asks the
    # same question, and a filter that changed between pages would paginate two result sets.
    DURATION_BUCKET=$(duration_bucket "$MIN_DURATION" "$MAX_DURATION")
    case "$SORT_FIELD" in
    view_count) ORDER_PARAM="click" ;;
    esac

    # Pages are requested only while both the caller still wants rows and the site is still
    # sending them: a short tail must not cost the whole row budget in round trips against a
    # host that rate-limits.
    # The row ceiling is applied to `wanted` FIRST, and the page plan is derived from what
    # survives it: PAGE_SIZE is the server's, so pages are an implementation detail of
    # spending a row budget, never a number a caller states.
    local wanted=$NUM_RESULTS
    ((UT_MAX_SEARCH_RESULTS > 0 && wanted > UT_MAX_SEARCH_RESULTS)) && wanted=$UT_MAX_SEARCH_RESULTS
    local pages=$(((wanted + PAGE_SIZE - 1) / PAGE_SIZE))

    local all="$SCRATCH_DIR/all.json"
    echo '[]' >"$all"
    local page=1 got=0
    while ((page <= pages)); do
        local chunk n
        fetch_page "$page" || search_fail "$FETCH_REASON"
        chunk="$SCRATCH_DIR/chunk.json"
        n=$(jq 'length' "$chunk" 2>/dev/null) || n=0
        ((n == 0)) && break
        jq -c --slurpfile chunk "$chunk" '. + $chunk[0]' "$all" >"$all.tmp" && mv "$all.tmp" "$all"
        got=$((got + n))
        ((got >= wanted)) && break
        page=$((page + 1))
    done

    # The local pass is the EXACT half of a filter the site did coarsely, and it runs even
    # when the site helped: `duration=1` means "under ten minutes", never "under $MAX_DURATION".
    #
    # Sort stays a client-side re-order of the fetched set even for view_count, which the
    # site also ordered (ORDER_PARAM above): the field this engine PUBLISHES is `.play`, and
    # the emitted rows must be that field descending with unknowns last, which is a promise
    # only this pass can keep. "relevance" keeps the site's own ranking — no re-sort.
    # SORT_FIELD is validated at startup, so there is no unknown-field branch here.
    local sort_expr=""
    case "$SORT_FIELD" in
    duration) sort_expr=' | sort_by(.duration // -1) | reverse' ;;
    view_count) sort_expr=' | sort_by(.view_count // -1) | reverse' ;;
    esac

    local bounds="true"
    ((MIN_DURATION > 0)) && bounds+=" and (.duration != null and .duration > $MIN_DURATION)"
    ((MAX_DURATION > 0)) && bounds+=" and (.duration != null and .duration < $MAX_DURATION)"

    # ONE jq program does the whole shaping. The normalised fields are merged OVER the raw
    # record rather than replacing it, so -J keeps every field the site sent while -j
    # projects the same twelve fields yt-search projects — and `title` and `duration` are
    # the cleaned, correctly-typed values in BOTH, so no surface can ever be handed the
    # HTML or the "MM:SS" string.
    #
    # `url` is built from the bvid rather than taken from `arcurl`: arcurl is the `av`
    # spelling and is served over http://, and the canonical BV URL is what a caller can
    # hand straight back to bili-resolve.
    #
    # `live_status` is null, not the raw `live_status: 0`. This search is search_type=video,
    # where that field is not the suite's is_live/was_live notion at all — carrying the 0
    # over would let a renderer draw a liveness state the site never claimed. A field this
    # engine cannot know is null, and the key is still present (ARCH-cli-contract.md「数据契约」).
    #
    # `kind` and `access` (ARCH-cli-contract.md「数据契约」) are the ENGINE'S JUDGEMENT about a row, not
    # site fields carried over, so they are merged LAST and win over any response key of the
    # same name. Both are constants here, and that is a MEASURED fact rather than a stub:
    # search_type=video carries no part-count signal at all — a 200-part video and a single
    # track have byte-identical key sets, and the site's own `videos: 200` lives only in
    # x/web-interface/view, which is one extra request per row — while `is_pay` was 0 on every
    # row of every query measured, including the one genuinely paid record that leaks in. An
    # engine states what it knows; a signal it does not have is not a field it may guess.
    #
    # `select(.url != null)` is the row's own premise: a result is a CALL (`t-play --engine
    # bili -- <url>`) or it is not a row. search_type=video mixes in `ketang` (paid-course)
    # records carrying no `bvid` — 3 of 20 on "钢琴" — and an EMPTY bvid is TRUTHY in jq, so
    # gating on `.id != null` let them ship with `id: ""` and `url: null`: a row no caller in
    # the suite can consume. The url is the honest gate, and it covers every future shape
    # whose handle cannot be built rather than just the one that leaks today.
    FILTERED_JSON=$(jq "$JQ_PRELUDE $JQ_CLEAN_TITLE"'
        [ .[]
          | . + { id:         (.bvid // null),
                  title:      (.title | clean_title),
                  url:        (if (.bvid // "") == "" then null
                               else "https://www.bilibili.com/video/" + .bvid end),
                  channel:    (.author // null),
                  duration:   (.duration | bili_secs),
                  view_count: (if (.play | type) == "number" then .play else null end),
                  live_status: null,
                  description: (if ((.description // "") | type) == "string"
                                then (.description | clean_title | gsub("\\s+"; " ")
                                      | sub("^ "; "") | sub(" $"; ""))
                                else "" end) }
          | . + { duration_fmt: (.duration | fmt_dur), kind: "track", access: "full",
                  thumbnail: pick_thumb }
          | select(.url != null)
          | select('"$bounds"') ]'"$sort_expr"' | .[0:'"$wanted"']' "$all")
}

# Prose list. One jq program, and it renders the unknowns rather than leaking a raw JSON
# `null` into human output.
print_list() {
    printf '%s' "$FILTERED_JSON" | jq -r --arg note "$MUSIC_CHAR" '
        to_entries[]
        | (.key + 1) as $i
        | .value
        | (if $note == "" then "" else $note + " " end) + "\($i). \(.title)",
          "  - " + (.duration_fmt // "--"),
          "  - " + (if .view_count == null then "n/a" else (.view_count | tostring) end) + " views",
          "  - \(.url)"'
}

# Structured search output for agent callers. The envelope is the one yt-search publishes,
# field for field — {status, engine, query, count, results} with the same twelve keys per
# result — because a caller that has to branch on which engine answered is a caller for
# whom the contract has already failed. `engine` is what lets it route a chosen result back
# to the matching <engine>-resolve without pattern-matching a URL.
#
# `jq -c`, both arms: every machine envelope in this suite is ONE line.
emit_search_json() {
    if [[ "$OUTPUT_MODE" == "json_full" ]]; then
        printf '%s' "$FILTERED_JSON" | jq -c --arg e "$ENGINE_NAME" --arg q "$QUERY" \
            '{status: "ok", engine: $e, query: $q, count: length, results: .}'
    else
        printf '%s' "$FILTERED_JSON" | jq -c --arg e "$ENGINE_NAME" --arg q "$QUERY" \
            '{status: "ok", engine: $e, query: $q, count: length,
              results: map({id, title, url, channel, duration, duration_fmt, view_count,
                            live_status, description, kind, access, thumbnail})}'
    fi
}

# ==============================================================================
# 4. CLI
# ==============================================================================

print_usage() {
    cat <<'EOF'
bili-search — the Bilibili search engine (non-interactive)

Usage:
  bili-search [options] <search query>
  bili-search --capabilities [-j]

Options:
  -n NUM   Number of results to fetch (default: 20 = exactly one of the site's pages)
  -m SEC   Minimum duration in seconds
  -M SEC   Maximum duration in seconds
           A -m/-M window that fits inside one of the site's own 10 / 30 / 60-minute
           buckets is filtered by the SITE, so a page's 20 rows arrive already short
           instead of being fetched and discarded. The bounds are applied exactly either way
  -s FIELD Sort field: relevance | view_count | duration (default: relevance)
           view_count asks the site for its most-played; duration re-orders what was fetched
  -l       Plain text list output (default)
  -j       JSON: {status, engine, query, count, results[]} — 10 lean fields per result
  -J       JSON with every field the site sent per result (same envelope)
  --capabilities  The flags this half accepts, less the --color -h -V every command has.
           No network, no query, no dependency: how a caller learns what to ask
  --color MODE  auto | always | never (default: auto)
  -h       This help
  -V       Print the suite version

Output (JSON, -j): {"status","engine","query","count","results":[{id,title,url,channel,
                    duration,duration_fmt,view_count,live_status,description,kind,access,
                    thumbnail}, ...]}
  Identical to yt-search's envelope, field for field. results[].id is a BV id — the input
  to `bili-resolve`. live_status is always null: this search cannot know it, and
  kind/access are always track/full: search_type=video carries neither signal — see
  docs/ARCH-engine.md.

Searching sends no credential of any kind: no account, no token, nothing read from a
browser profile. The one cookie it sends is a randomly generated per-process buvid3 (a
device id), because without it the site rate-limits a burst of searches. Login — the
higher-quality audio an account gets — applies to bili-resolve, which reaches it through
yt-dlp.

Note: this site's music results are dominated by multi-hour COLLECTIONS — the top hits for
an artist name are routinely 50- to 100-track compilations. -M is the blunt instrument for
excluding them (e.g. -M 900 for tracks under 15 minutes; -M 600 is the value the site can
filter itself, so it comes back a full page of short tracks rather than 20 rows to discard).

Exit codes: 0 ok · 1 usage/validation · 2 a missing dependency, or the site did
            not answer usefully (see .reason)

Environment:
  Defaults for every knob below live in <checkout>/config, declared once for the whole
  suite. Override per user in ${XDG_CONFIG_HOME:-~/.config}/ting/config (KEY=value, one
  per line, # comments; the pre-rename .../uting/config is read when there is no ting
  one); TING_CONFIG relocates it, and UT_CONFIG still does. Chain: flag > environment > your
  config > the shipped defaults. See ARCH-cli-contract.md「配置面」.
  BILI_UA     User-Agent sent with the search request (a browser UA; must not contain
              "curl" or "python", which the site refuses)
  BILI_BUVID  Device id to send instead of a freshly generated one

To play a result, pass its BV id to: t-play --engine bili
EOF
}

# Every flag this half takes beyond the --color -h -V every command has, stated ONCE: the
# unknown-flag refusal prints it for a person and --capabilities answers with it for a caller
# (ARCH-cli-contract.md「命令规格」).
SEARCH_FLAGS=(-n -m -M -s -l -j -J --capabilities)
CAPABILITIES=0
SEARCH_FLAG=""       # which of -n -m -M -s was given (gate: --capabilities runs no search)

# Value-taking flags (consume the next token) vs boolean flags, restricted to the search
# surface. Anything outside these is rejected — playback/lifecycle flags get a pointer to
# t-play so the caller learns the right tool instead of a bare error. ARCH-cli-contract.md「门模型」
has_format=0
query=()
reject_url() {
    echo "bili-search: '$1' looks like a URL — use 't-play --engine bili $1' to play it" >&2
    exit 1
}
while (($#)); do
    case "$1" in
    -h | --help)
        print_usage
        exit 0
        ;;
    -V | --version)
        # Answered before ANY dependency gate: a version is the first thing a bug report
        # needs, and needing curl installed to find out which version you have is backwards.
        printf 'bili-search %s\n' "$UT_VERSION"
        exit 0
        ;;
    -l | --list)
        has_format=1
        OUTPUT_MODE="list"
        shift
        ;;
    -j | --json)
        has_format=1
        OUTPUT_MODE="json"
        shift
        ;;
    -J | --json-full)
        has_format=1
        OUTPUT_MODE="json_full"
        shift
        ;;
    --color=*)
        COLOR_MODE="${1#*=}"
        shift
        ;;
    --color)
        [[ $# -ge 2 ]] || { echo "bili-search: $1 requires a value" >&2; exit 1; }
        COLOR_MODE="$2"
        shift 2
        ;;
    -n | -m | -M | -s)
        [[ $# -ge 2 ]] || { echo "bili-search: $1 requires a value" >&2; exit 1; }
        SEARCH_FLAG="$1"
        case "$1" in
        -n) NUM_RESULTS="$2" ;;
        -m) MIN_DURATION="$2" ;;
        -M) MAX_DURATION="$2" ;;
        -s) SORT_FIELD="$2" ;;
        esac
        shift 2
        ;;
    -S)
        # -S sorts STREAM FORMATS, and a search resolves none: whatever engine it is
        # pointed at, the value cannot change one byte of a search's output. Both search
        # halves reject it (yt-search used to forward it into a --flat-playlist dump, where
        # it did nothing); the resolve half is where it belongs.
        echo "bili-search: -S selects a stream format — searching resolves none (see bili-resolve -S)" >&2
        exit 1
        ;;
    -f | -d | --detach | --status | --stop | --set-volume | --id | --all)
        echo "bili-search: $1 is a playback flag — use t-play for playback" >&2
        exit 1
        ;;
    --info | --transcript | --subtitles | --sub-lang | --sub-langs)
        echo "bili-search: $1 belongs to the other half of this engine — use bili-resolve $1" >&2
        exit 1
        ;;
    --capabilities)
        CAPABILITIES=1
        shift
        ;;
    --)
        shift
        # `--` stops FLAG parsing, it does not stop argument validation: a query token that
        # looks like a URL is still the wrong tool, and a query beginning with '-' must
        # survive as a query. ARCHITECTURE.md「端到端控制流」.
        while (($#)); do
            case "$1" in
            http://* | https://* | www.* | bilibili.com/* | b23.tv/*) reject_url "$1" ;;
            esac
            query+=("$1")
            shift
        done
        break
        ;;
    -*)
        echo "bili-search: unknown flag '$1' (search flags: ${SEARCH_FLAGS[*]})" >&2
        exit 1
        ;;
    http://* | https://* | www.* | bilibili.com/* | b23.tv/*)
        reject_url "$1"
        ;;
    *)
        query+=("$1")
        shift
        ;;
    esac
done

# --capabilities asks about the ENGINE, not a query, so it answers before the query is required
# and ahead of every dependency gate, jq included: it is how a caller learns what to ask, so it
# must answer on a machine that cannot run a search yet. Anything that would shape a search is
# refused rather than ignored (ARCH-cli-contract.md「门模型」).
if ((CAPABILITIES)); then
    ((${#query[@]} == 0)) ||
        die "--capabilities takes no query — it reports what this engine accepts"
    [[ -z "$SEARCH_FLAG" ]] || die "$SEARCH_FLAG shapes a search — --capabilities runs none"
    [[ "$OUTPUT_MODE" != "json_full" ]] ||
        die "-J returns raw per-result fields — --capabilities has no results; use -j"
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        caps=""
        for f in "${SEARCH_FLAGS[@]}"; do caps+="${caps:+,}\"$f\""; done
        printf '{"status":"ok","engine":"%s","flags":[%s]}\n' "$ENGINE_NAME" "$caps"
    else
        printf '%s\n' "${SEARCH_FLAGS[*]}"
    fi
    exit 0
fi

if ((${#query[@]} == 0)); then
    echo "bili-search: a search query is required (see 'bili-search -h')" >&2
    exit 1
fi
QUERY="${query[*]}"
if [[ "$QUERY" != *[![:space:]]* ]]; then
    echo "bili-search: a search query is required (see 'bili-search -h')" >&2
    exit 1
fi

# The default output is the plain list; -j/-J/-l override.
((has_format)) || OUTPUT_MODE="list"

if ! is_non_negative_int "$NUM_RESULTS"; then
    die "-n must be a non-negative integer"
fi
if ! is_non_negative_int "$UT_MAX_SEARCH_RESULTS"; then
    die "UT_MAX_SEARCH_RESULTS must be a non-negative integer (0 = no ceiling)"
fi
if ! is_non_negative_int "$MIN_DURATION"; then
    die "-m must be a non-negative integer"
fi
if ! is_non_negative_int "$MAX_DURATION"; then
    die "-M must be a non-negative integer"
fi
if ((MAX_DURATION > 0 && MAX_DURATION <= MIN_DURATION)); then
    die "-M must be greater than -m when both are set"
fi
if ! validate_enum "$SORT_FIELD" relevance view_count duration; then
    die "-s must be one of: relevance, view_count, duration"
fi
if ! validate_enum "$COLOR_MODE" auto always never; then
    die "--color must be one of: auto, always, never"
fi

require_deps curl jq

# -n 0 is a legal, cheap answer: the empty envelope, without a round trip.
if ((NUM_RESULTS == 0)); then
    FILTERED_JSON='[]'
else
    fetch_results
fi
if [[ "$OUTPUT_MODE" == "list" ]]; then
    print_list
else
    emit_search_json
fi
exit 0
