#!/usr/bin/env bash
# ting-playlist — the PLAYLIST STORE: durable, user-level, engine-agnostic. Agent-facing.
#
# The seventh command, and the first one that owns state a user would be upset to lose.
# It knows nothing about sites (no yt-dlp, no cookie, no host grammar) and nothing about
# playback (no mpv, no lifecycle, no players/). It knows two things: the item record and
# the file. docs/ARCH-player.md「持久状态层」 (why this is user-level and how it locks),
# docs/ARCH-cli-contract.md「命令规格」 (the surface) and 「数据契约」 (the record).
#
# WHY IT IS NOT PART OF THE PLAYER. `players/` lives in ${TMPDIR}/ting-$(id -u) and dies
# with the reboot — correct for a running process, fatal for a list a user spent six months
# building. This store is user-level and permanent; the queue (a playlist being consumed)
# stays with the player. A queue that survives a reboot IS a playlist, which is the whole
# reason these are two different things. ARCH-player.md「状态机」.
#
# ONE INPUT SHAPE: JSON on stdin, either a search envelope (`ting-play --search -j` verbatim) or a
# bare array of items. Taking the envelope is correctness, not convenience — a search
# RESULT carries no `engine` field, the envelope does, so only the whole package tags the
# items with the engine that produced them. ARCH-cli-contract.md「数据契约」.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features; guard empty-array
# expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). ARCHITECTURE.md「可移植性契约」.

# Resolve this script's OWN symlink chain before looking for its siblings — the PATH entry
# is a symlink into a checkout that can live anywhere. Physical `cd -P`/`pwd -P`, and a
# loop rather than `readlink -f` (bash 3.2 / BSD readlink has neither). Same preamble as
# every other command in the suite; it is duplicated because there is no library to share.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)

# THE version of the whole suite, declared once, in a data file. CLAUDE.md § one fact, one place.
if [[ -r "$SCRIPT_DIR/../VERSION" ]]; then
    TING_VERSION=$(cat "$SCRIPT_DIR/../VERSION")
else
    TING_VERSION="unknown"
fi

# CONFIGURATION — the chain is flag > environment > the user's config > the shipped defaults
# in `<checkout>/config`, which is where every default value in the suite is declared once.
# Duplicated VERBATIM in every entry point — see the same block in ting-play for why, and
# ARCH-cli-contract.md「配置面」 for the keys.
TING_CONFIG="${TING_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/ting/config}"
TING_DEFAULTS="$SCRIPT_DIR/../config"
ting_read_config() {
    local file="$1" line key val
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        while [[ "$line" == [[:space:]]* ]]; do line="${line#[[:space:]]}"; done
        while [[ "$line" == *[[:space:]] ]]; do line="${line%[[:space:]]}"; done
        [[ -n "$line" && "$line" == *=* ]] || continue
        key="${line%%=*}"
        val="${line#*=}"
        while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
        while [[ "$val" == [[:space:]]* ]]; do val="${val#[[:space:]]}"; done
        [[ "$key" =~ ^TING_[A-Z0-9_]+$ ]] || continue
        case "$key" in
        TING_CONFIG | TING_ENGINE_DIR | TING_VERSION | TING_DEFAULTS | TING_IPC_SOCK | TING_DETACHED | TING_PLAYER_ID | TING_DETACHED_LOG) continue ;;
        esac
        if [[ ${#val} -ge 2 ]] && { [[ "$val" == \"*\" ]] || [[ "$val" == \'*\' ]]; }; then
            val="${val#?}"
            val="${val%?}"
        fi
        [[ "$val" == "~/"* ]] && val="$HOME/${val#\~/}"
        eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
    done < "$file"
}
# FAIL FAST AND SAY WHY. There is deliberately no escape hatch for --version or --help: they
# were tried, and letting execution continue past a missing defaults file replaced this one
# clear line with `TING_ASCII_VO: unbound variable` from set -u somewhere further down. A
# checkout missing part of itself is not a dependency gate (yt-dlp, jq and mpv still answer
# --version without being installed) — it is a broken checkout, and 2 is the exit code for a
# failure that is not the caller's usage error.
if [[ ! -r "$TING_DEFAULTS" ]]; then
    printf '%s: cannot read the shipped defaults at %s — that file declares every default value in the suite and is not optional\n' \
        "$(basename "$0")" "$TING_DEFAULTS" >&2
    exit 2
fi
ting_read_config "$TING_CONFIG"
ting_read_config "$TING_DEFAULTS"

# ==============================================================================
# 1. SETTINGS
# ==============================================================================

# The user-level state root. XDG rather than ~/Library/Application Support because this
# suite's user surface is a terminal and its neighbours (yt-dlp, mpv) live there too — and
# because a Linux port would not need a second layout. The override is not a convenience:
# without it `tests/contract.sh` would write into the user's real playlists.
# ARCH-cli-contract.md「配置面」.
TING_STATE_DIR="${TING_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ting}"
PLAYLISTS_DIR="$TING_STATE_DIR/playlists"

COLOR_MODE="auto"
OUTPUT_MODE="list"
ACTION=""
NAME=""
NEW_NAME=""
INDEX=""

# ==============================================================================
# 2. HELPERS
# ==============================================================================

err() {
    local red='' reset=''
    case "${COLOR_MODE:-auto}" in
    always) red=$'\033[31m'; reset=$'\033[0m' ;;
    auto) if [[ -t 2 ]]; then red=$'\033[31m'; reset=$'\033[0m'; fi ;;
    never) ;;
    esac
    echo "${red}Error:${reset} $*" >&2
}

die() {
    err "$@"
    exit 1
}

# A missing tool is not a malformed call: `die` is exit 1 (the argv is wrong — fix it),
# `die_dep` is exit 2 (the argv was fine; the machine is missing something no rewrite of the
# argv will supply). An agent that read 1 here would loop editing its own parameters against
# a wall. docs/ARCH-cli-contract.md「退出码、TTY、依赖」.
die_dep() {
    err "required command not found: $1"
    exit 2
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die_dep "$1"
}

validate_enum() {
    local value=$1; shift
    local allowed
    for allowed in "$@"; do
        [[ "$value" == "$allowed" ]] && return 0
    done
    return 1
}

# An OPERATIONAL failure — one that happens after argv is understood, so the caller asked a
# well-formed question that the store cannot answer. Prose goes to stderr in both modes (a
# -j caller debugging a pipeline still wants the sentence); the machine envelope goes to
# stdout only under -j, exactly as the engines do with their extraction failures.
#
# The reason enum here is the STATE enum and is deliberately NOT the playback/extraction one
# (forbidden|unavailable|…): nothing in a file store can be `format_unavailable`, and
# widening a taxonomy three other readers branch on would be the wrong kind of sharing.
# Members: not_found | exists | invalid_name | invalid_input | locked | corrupt |
# undo_none | undo_expired | undo_stale.
# ARCH-cli-contract.md「数据契约」.
#
# WHICH CODE EACH REASON CARRIES, and why it is not all 1. The suite reserves 1 for "the
# argv was wrong" and 4 for "the request was well formed and did not take effect"
# (ARCH-cli-contract.md「退出码」) — the split `ting-play` already makes when `--set-volume` finds no
# player (4) rather than calling the caller's flags bad. So:
#
#   1  invalid_name · invalid_input   the caller's own argv or stdin is malformed
#   4  not_found · exists · locked · corrupt · undo_*   argv understood, store said no
#
# `--del` on a missing list stays 0 with `deleted:false`: the caller asked for an end state
# and the end state holds, exactly as `--stop` does on a player that already exited.
fail() {
    local code=$1 reason=$2 msg=$3
    echo "ting-playlist: $msg" >&2
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg name "$NAME" --arg reason "$reason" \
            '{status: "error", name: (if $name == "" then null else $name end), reason: $reason}'
    fi
    exit "$code"
}

now_utc() { date -u +%FT%TZ 2>/dev/null || echo unknown; }

# A playlist name is also its filename, with no slug in between: a slug would make the name
# printed by --ls and the name on disk two different facts, and then one of them would be
# wrong. The cost of that choice is this validator — it is what keeps a name from escaping
# the directory or colliding with the lock dirs.
#
# NOT validated: case. On a case-insensitive filesystem (APFS by default) `Rock` and `rock`
# ARE the same playlist. Accepted and documented rather than fought: bash 3.2 has no
# case-folding parameter expansion (that one is bash 4) and `tr` is wrong on UTF-8, so any
# normalisation written here would be a lie for exactly the names most likely to need it.
validate_name() {
    local n=$1
    [[ -n "$n" ]] || fail 1 invalid_name "a playlist name is required"
    ((${#n} <= 64)) || fail 1 invalid_name "playlist name is longer than 64 characters"
    case "$n" in
    .*)   fail 1 invalid_name "playlist name must not begin with '.'" ;;
    */*)  fail 1 invalid_name "playlist name must not contain '/'" ;;
    esac
    if [[ "$n" =~ [[:cntrl:]] ]]; then
        fail 1 invalid_name "playlist name must not contain control characters"
    fi
}

playlist_file() { echo "$PLAYLISTS_DIR/$1.json"; }
playlist_lock() { echo "$PLAYLISTS_DIR/.lock-$1"; }

ensure_store() {
    mkdir -p -m 700 "$PLAYLISTS_DIR" 2>/dev/null || die "cannot create the state directory: $PLAYLISTS_DIR"
    chmod 700 "$TING_STATE_DIR" "$PLAYLISTS_DIR" 2>/dev/null || true
}

# `mkdir` is atomic on POSIX, which makes it the portable lock on bash 3.2 (no flock on
# stock macOS) — the same one `ting-play` uses for its player records. Two differences from
# that one, both because this data is durable and the player's is not:
#
#   1. On timeout we FAIL (exit 4, did-not-take-effect) rather than proceeding unlocked.
#      The player's patches were best-effort field updates; here proceeding unlocked can
#      drop a track the user just added.
#   2. A lock older than a minute is STOLEN. The EXIT trap releases the lock on every
#      normal death including `die`, so a stale dir means a SIGKILL — and a playlist that
#      can never be written again is a worse failure than a torn write we have never seen.
# A SET of held locks, not one: --rename writes a second playlist and has to hold that one
# too (a concurrent `--add NEWNAME` was otherwise overwritten unlocked). Empty-array
# expansion is guarded — a bare "${arr[@]}" on an empty array aborts under set -u on the
# bash 3.2 floor.
LOCKS_HELD=()
release_lock() {
    local d
    if ((${#LOCKS_HELD[@]})); then
        for d in "${LOCKS_HELD[@]}"; do rmdir "$d" 2>/dev/null || true; done
    fi
    LOCKS_HELD=()
    return 0
}
# A copy half-built when the write died goes with the locks: it is this process's own
# scratch, and a `.tmp.` directory the reaper would only find once its owner is gone.
on_exit() {
    release_lock
    [[ -z "${UNDO_TMP:-}" ]] || rm -rf "$UNDO_TMP" 2>/dev/null || true
}
trap on_exit EXIT

lock_playlist() {
    local dir i aged=0
    dir=$(playlist_lock "$1")
    for ((i = 0; i < 50; i++)); do
        if mkdir "$dir" 2>/dev/null; then
            LOCKS_HELD+=("$dir")
            return 0
        fi
        # Staleness is tested on the FIRST failure, not after the spin. The holder of a lock
        # older than a minute is GONE (the EXIT trap releases it on every normal death, `die`
        # included), so waiting five seconds for it teaches nobody anything — it is five
        # seconds every caller pays, the TUI included, for a writer that was SIGKILLed. The
        # spin is for a LIVE writer; the steal is for a dead one, and they are different
        # questions asked in the wrong order.
        #
        # Once per call, not per iteration: the test is a fork, and a lock that was fresh at
        # i=0 cannot age past a minute inside a 5s spin. A steal that LOSES the race to
        # another stealer falls back into the spin rather than failing on the spot — the
        # winner holds a real lock, which is exactly what the spin is for.
        if ((! aged)); then
            aged=1
            # -mmin +1 is understood by both BSD and GNU find; -maxdepth 0 tests the dir itself.
            if [[ -n "$(find "$dir" -maxdepth 0 -mmin +1 2>/dev/null)" ]]; then
                rmdir "$dir" 2>/dev/null || true
                continue
            fi
        fi
        sleep 0.1
    done
    fail 4 locked "playlist '$1' is locked by another process"
}

# temp + mv in the SAME directory, so the rename is atomic and a reader never sees a half
# written list. $$ in the temp name keeps two writers from colliding on the temp itself.
write_playlist() {
    local name=$1 json=$2 f
    f=$(playlist_file "$name")
    printf '%s\n' "$json" >"$f.tmp.$$" || die "cannot write $f"
    mv -f "$f.tmp.$$" "$f" || { rm -f "$f.tmp.$$" 2>/dev/null || true; die "cannot persist $f"; }
}

# ------------------------------------------------------------------------------
# UNDO — one copy per owning process, written under the same lock as the write it undoes.
# docs/ARCH-player.md「撤销副本」 has the why; the shape, in the order a write takes it:
#
#   undo_begin -> undo_obj per playlist the write touches -> undo_commit -> the write itself
#
# The copy holds each object's bytes BEFORE and AFTER, so --undo can refuse to restore over a
# list somebody else has changed since (it compares, byte for byte, what is on disk against
# the AFTER half). A write that dies after undo_commit leaves an AFTER that is not on disk,
# which is the same refusal — a failed write can never be "undone" into a duplicate.
#
# Only a caller that names itself with --owner gets a copy. An agent's writes leave nothing
# behind, and without --owner every verb's behaviour and envelope are what they always were.
#
# The copy lives OUTSIDE playlists/, whose *.json glob is --ls's namespace. One slot per
# owner: the next write by the same owner replaces it, which is what keeps `z` one level deep.
UNDO_GRACE=3
UNDO_DIR="$TING_STATE_DIR/undo"
OWNER=""
DISCARD=0
undo_slot() { echo "$UNDO_DIR/playlist-$1"; }

# The copies of owners that are gone. An owner that exits normally discards its own (ting's
# cleanup_on_exit); this is the kill -9 path, run by every call, so a copy never outlives its
# owner by more than one invocation of this command. Keyed on the directory NAME, so it costs
# a glob and a `kill -0` per copy and no jq. The `.tmp.` half-written ones go the same way.
reap_dead_copies() {
    local d o
    [[ -d "$UNDO_DIR" ]] || return 0
    for d in "$UNDO_DIR"/playlist-*; do
        [[ -e "$d" ]] || continue
        o=${d##*/playlist-}
        o=${o%%.*}
        [[ "$o" =~ ^[0-9]+$ ]] || continue
        kill -0 "$o" 2>/dev/null || rm -rf "$d" 2>/dev/null || true
    done
    return 0
}

UNDO_TMP=""
UNDO_OBJS="[]"
UNDO_N=0
UNDO_DEADLINE=""
undo_begin() {
    [[ -n "$OWNER" ]] || return 0
    mkdir -p -m 700 "$UNDO_DIR" 2>/dev/null || die "cannot create the undo directory: $UNDO_DIR"
    UNDO_TMP="$(undo_slot "$OWNER").tmp.$$"
    rm -rf "$UNDO_TMP" 2>/dev/null || true
    mkdir -m 700 "$UNDO_TMP" 2>/dev/null || die "cannot create $UNDO_TMP"
    UNDO_OBJS="[]"
    UNDO_N=0
}

# undo_obj NAME [AFTER_JSON] — one playlist the write touches. No second argument means the
# write leaves NAME not existing (--del, the old name of --rename); a file that does not exist
# yet is recorded as that too (--add creating a list), so "not there" restores as "not there".
# AFTER is written the way write_playlist writes it, so cmp compares like with like.
undo_obj() {
    [[ -n "$OWNER" ]] || return 0
    local key=$1 f pre=false post=false
    f=$(playlist_file "$key")
    if [[ -f "$f" ]]; then
        cp "$f" "$UNDO_TMP/$UNDO_N.pre" 2>/dev/null || die "cannot write the undo copy of $f"
        pre=true
    fi
    if (($# > 1)); then
        printf '%s\n' "$2" >"$UNDO_TMP/$UNDO_N.post" || die "cannot write the undo copy of $f"
        post=true
    fi
    UNDO_OBJS=$(jq -c --arg k "$key" --argjson pre "$pre" --argjson post "$post" \
        '. + [{key: $k, pre_exists: $pre, post_exists: $post}]' <<<"$UNDO_OBJS")
    UNDO_N=$((UNDO_N + 1))
}

# undo_commit VERB [INDEX] — the copy goes into place whole. The deadline is epoch seconds
# with no timestamp beside it: now_utc is whole seconds too, so two writes in one second
# could not be told apart by one, and the bytes are what --undo compares anyway.
undo_commit() {
    [[ -n "$OWNER" ]] || return 0
    local slot
    slot=$(undo_slot "$OWNER")
    UNDO_DEADLINE=$(($(date +%s) + UNDO_GRACE))
    jq -nc --argjson owner "$OWNER" --arg verb "$1" --arg index "${2:-}" \
        --argjson deadline "$UNDO_DEADLINE" --argjson objs "$UNDO_OBJS" \
        '{schema: 1, owner: $owner, verb: $verb, deadline: $deadline, objects: $objs}
         + (if $index == "" then {} else {index: ($index | tonumber)} end)' \
        >"$UNDO_TMP/meta.json" 2>/dev/null || die "cannot write the undo copy"
    rm -rf "$slot" 2>/dev/null || true
    mv "$UNDO_TMP" "$slot" 2>/dev/null || die "cannot persist the undo copy: $slot"
    UNDO_TMP=""
}

# The envelope's `undo` field, only on a call that left a copy — which is only a call that
# passed --owner, so an agent's envelope stays byte-for-byte what it was.
with_undo() {
    if [[ -n "$UNDO_DEADLINE" ]]; then
        jq -c --argjson d "$UNDO_DEADLINE" '. + {undo: {deadline: $d}}'
    else
        cat
    fi
}

# ONE reader for every verb that opens a playlist file, and the only place jq is pointed at
# one. Before it existed the two READ verbs had no guard at all: a single unparseable file
# aborted on set -e with jq's raw parse error, exit 5 — outside this command's own taxonomy —
# and NO envelope under -j. That is the exact failure the search verb was fixed for (an agent
# gets a jq parse error instead of a shape it can branch on); it must not come back through
# a second command. The three write verbs had a guard each, spelled three times; this is it,
# spelled once.
#
# It also spends the `schema` field. Writing a version nobody reads buys nothing — a file
# from a future build would simply be misread as this one — so a schema this build does not
# understand is refused here, once, for every verb.
#
# `corrupt` is a STORE failure, not a usage error: the argv was understood and the store
# could not answer, which is the 4 side of the split stated at fail().
PLAYLIST_SCHEMA_MAX=1
PLAYLIST_JSON=""
read_playlist() {
    local f=$1 name=$2 schema
    PLAYLIST_JSON=$(jq -c . "$f" 2>/dev/null) \
        || fail 4 corrupt "playlist '$name' is not readable JSON: $f"
    schema=$(printf '%s' "$PLAYLIST_JSON" | jq -r '.schema // 0' 2>/dev/null) || schema=0
    [[ "$schema" =~ ^[0-9]+$ ]] || schema=0
    ((schema <= PLAYLIST_SCHEMA_MAX)) \
        || fail 4 corrupt "playlist '$name' was written by a newer ting (schema $schema; this build reads $PLAYLIST_SCHEMA_MAX)"
}

# The ONE duration formatter, as a jq prelude rather than a bash function — same reason the
# engines carry theirs: every consumer here is already shaping JSON, and a bash version
# would fork jq once per row to read a field back out. It is one of the identical copies of
# these six lines the suite carries because it has no library, which is the trade
# ARCHITECTURE.md「命令拓扑」 already made — and「命令拓扑」is where the count lives, so this comment does not
# restate one that the next engine pair would make stale.
JQ_PRELUDE='
def p2: tostring | if length < 2 then "0" + . else . end;
def fmt_dur:
  if type != "number" then null
  else (. | floor) as $t
    | ($t / 86400 | floor) as $d
    | (($t % 86400) / 3600 | floor) as $h
    | (($t % 3600) / 60 | floor) as $m
    | ($t % 60) as $s
    | (if $d > 0 then "\($d)d " else "" end) + "\($h | p2)h:\($m | p2)m:\($s | p2)s"
  end;
'

# Normalise whatever arrived on stdin into the item record (ARCH-cli-contract.md「数据契约」): the
# search envelope's own field names, minus the ones that expire (channel, view_count,
# live_status), plus our timestamp. `engine` + `url` are exactly the two arguments of
# `ting-play --engine E -- URL`, so a stored record IS a call.
#
# The result lands in a GLOBAL, not on stdout. `items=$(read_items)` reads better and was
# how this was first written, but a command substitution runs in a SUBSHELL: `fail`'s -j
# error envelope went into the variable instead of to the caller, and its `exit` ended only
# the subshell. A function that can fail with an envelope cannot return its value through
# stdout.
ITEMS_JSON=""
read_items() {
    [[ -t 0 ]] && fail 1 invalid_input "--add reads items from stdin (try: ting-play --search -j -- QUERY | ting-playlist --add NAME)"
    local raw items rc=0
    raw=$(cat)
    # A MATCH, not `${raw//[[:space:]]/}`. That substitution has a fast path when the pattern
    # occurs NOWHERE, which is why it read as free — but the moment one space exists ahead,
    # bash 3.2 walks every byte position running a glob match, each attempt costing O(remaining)
    # in a UTF-8 locale. Measured on the floor: a 7KB search envelope — i.e. `ting-play --search -j -n 25`,
    # the example in this command's own usage — spent 16s in that one expansion, against 5ms
    # here. Every real title contains a space, so the slow path was the only path.
    [[ "$raw" == *[![:space:]]* ]] || fail 1 invalid_input "no input on stdin"
    items=$(printf '%s' "$raw" | jq -c --arg now "$(now_utc)" '
        (if type == "object" and has("results") then
            (.engine) as $e
            | (if ($e | type) != "string" or ($e | length) == 0 then
                 error("search envelope has no engine field")
               else . end)
            | [ .results[] | {engine: $e, id: (.id // null), url: .url,
                              title: (.title // null), duration: (.duration // null)} ]
         elif type == "object" and has("items") then
            # A playlist envelope, i.e. the --show output of this same command. Items
            # already carry their own engine, so no envelope-level tag is needed: this is
            # what makes `ting-playlist --show a -j | ting-playlist --add b` work.
            [ .items[] | {engine: (.engine // null), id: (.id // null), url: (.url // null),
                          title: (.title // null), duration: (.duration // null)} ]
         elif type == "array" then
            [ .[] | {engine: (.engine // null), id: (.id // null), url: (.url // null),
                     title: (.title // null), duration: (.duration // null)} ]
         else
            error("input must be a search envelope or a JSON array of items")
         end)
        | (map(select((.engine | type) != "string" or (.engine | length) == 0
                      or (.url | type) != "string" or (.url | length) == 0)) | length) as $bad
        | if $bad > 0 then error("every item needs a non-empty engine and url") else . end
        | map(. + {added_at: $now})
    ' 2>/dev/null) || rc=$?
    if ((rc != 0)) || [[ -z "$items" ]]; then
        fail 1 invalid_input "stdin is not a search envelope or a valid item array (every item needs engine + url)"
    fi
    ITEMS_JSON="$items"
}

# ==============================================================================
# 3. VERBS
# ==============================================================================

# --show NAME is a question about NAME, so NAME being unreadable IS the answer and it fails.
# --ls is a question about the whole store, and there one bad file must not hide the rest:
# unreadable files are skipped with a line on stderr (prose in both modes, like fail()) and
# the listing still answers. Skipping silently would make the count a lie.
do_ls() {
    ensure_store
    local files=() f
    for f in "$PLAYLISTS_DIR"/*.json; do
        [[ -e "$f" ]] || continue
        if ! jq -e . "$f" >/dev/null 2>&1; then
            echo "ting-playlist: skipping unreadable playlist file: $f" >&2
            continue
        fi
        files+=("$f")
    done

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        if ((${#files[@]} == 0)); then
            jq -nc '{status: "ok", count: 0, playlists: []}'
            return 0
        fi
        # -s slurps the files jq reads itself; the name comes from the FILE's own field, not
        # from its basename, so a manually renamed file is reported as what it says it is.
        jq -sc '{status: "ok", count: length,
                 playlists: map({name, count: (.items | length), updated_at})}' "${files[@]}"
        return 0
    fi

    if ((${#files[@]} == 0)); then
        echo "No playlists yet."
        echo "  Add one:  ting-play --search -j -n 5 -- \"lofi\" | ting-playlist --add chill"
        return 0
    fi
    jq -r '"\(.name) - \(.items | length) items - updated \(.updated_at)"' "${files[@]}"
}

do_show() {
    ensure_store
    local f; f=$(playlist_file "$NAME")
    [[ -f "$f" ]] || fail 4 not_found "no such playlist: $NAME"
    read_playlist "$f" "$NAME"

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        # `duration_fmt` is DERIVED here, never stored: a stored copy would be a second
        # truth about the same number. It is emitted because it makes an item field-for-
        # field row-compatible with a search result — which is what lets `ting` render a
        # playlist through the same loader it renders a search with, and lets this output
        # be piped straight back into --add.
        jq -c "$JQ_PRELUDE"'{status: "ok", name, count: (.items | length),
              items: (.items | map(. + {duration_fmt: (.duration | fmt_dur)}))}' <<<"$PLAYLIST_JSON"
        return 0
    fi
    jq -r "$JQ_PRELUDE"'
        "\(.name) - \(.items | length) items",
        (.items | to_entries[]
         | "  [\(.key)] \(.value.title // "(untitled)")",
           "        \(.value.duration | fmt_dur // "--") - \(.value.engine)",
           "        \(.value.url)")
    ' <<<"$PLAYLIST_JSON"
}

do_add() {
    ensure_store
    read_items
    local items="$ITEMS_JSON"
    lock_playlist "$NAME"
    local f now json added
    f=$(playlist_file "$NAME")
    now=$(now_utc)
    added=$(printf '%s' "$items" | jq 'length')
    if [[ -f "$f" ]]; then
        read_playlist "$f" "$NAME"
        json=$(printf '%s' "$PLAYLIST_JSON" | jq -c --argjson new "$items" --arg now "$now" \
            '.items += $new | .updated_at = $now | .count = (.items | length)')
    else
        json=$(jq -nc --arg name "$NAME" --arg now "$now" --argjson new "$items" \
            '{schema: 1, name: $name, created_at: $now, updated_at: $now,
              count: ($new | length), items: $new}')
    fi
    undo_begin
    undo_obj "$NAME" "$json"
    undo_commit add
    write_playlist "$NAME" "$json"
    release_lock

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        printf '%s' "$json" | jq -c --argjson added "$added" \
            '{status: "ok", name, added: $added, count: (.items | length)}' | with_undo
    else
        printf 'Added %s item(s) to %s (%s total)\n' "$added" "$NAME" "$(printf '%s' "$json" | jq '.items | length')"
    fi
}

do_rm() {
    ensure_store
    local f; f=$(playlist_file "$NAME")
    [[ -f "$f" ]] || fail 4 not_found "no such playlist: $NAME"
    lock_playlist "$NAME"
    read_playlist "$f" "$NAME"
    local len
    len=$(printf '%s' "$PLAYLIST_JSON" | jq '.items | length')
    if ((INDEX >= len)); then
        fail 1 invalid_input "index $INDEX is out of range (playlist '$NAME' has $len items)"
    fi
    local json
    json=$(printf '%s' "$PLAYLIST_JSON" | jq -c --argjson i "$INDEX" --arg now "$(now_utc)" \
        'del(.items[$i]) | .updated_at = $now | .count = (.items | length)')
    undo_begin
    undo_obj "$NAME" "$json"
    undo_commit rm "$INDEX"
    write_playlist "$NAME" "$json"
    release_lock

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        printf '%s' "$json" | jq -c '{status: "ok", name, removed: 1, count: (.items | length)}' | with_undo
    else
        printf 'Removed item %s from %s (%s left)\n' "$INDEX" "$NAME" "$(printf '%s' "$json" | jq '.items | length')"
    fi
}

# Deleting something that is already gone is not a failure — the caller asked for an end
# state and the end state holds. Same rule as `ting-play --stop` on a player that already
# exited (ARCH-cli-contract.md「退出码」); `deleted` is the field that says which happened.
# A delete that found nothing leaves no copy either: nothing was written, so there is nothing
# to take back, and the owner's copy of its previous write stays where it is.
do_del() {
    ensure_store
    local f deleted=false
    f=$(playlist_file "$NAME")
    if [[ -f "$f" ]]; then
        lock_playlist "$NAME"
        undo_begin
        undo_obj "$NAME"
        undo_commit del
        rm -f "$f" || die "cannot delete $f"
        release_lock
        deleted=true
    fi
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg name "$NAME" --argjson deleted "$deleted" \
            '{status: "ok", name: $name, deleted: $deleted}' | with_undo
    elif [[ "$deleted" == "true" ]]; then
        printf 'Deleted playlist %s\n' "$NAME"
    else
        printf 'No such playlist: %s (nothing to delete)\n' "$NAME"
    fi
}

do_rename() {
    ensure_store
    local from to
    from=$(playlist_file "$NAME")
    to=$(playlist_file "$NEW_NAME")
    # BOTH playlists, and in LEXICOGRAPHIC order. Locking only the source left the
    # destination writable by a concurrent --add, which this then overwrote; taking them in
    # a fixed order is what keeps two renames pointed at each other from deadlocking.
    if [[ "$NAME" == "$NEW_NAME" ]]; then
        lock_playlist "$NAME"
    elif [[ "$NAME" < "$NEW_NAME" ]]; then
        lock_playlist "$NAME"; lock_playlist "$NEW_NAME"
    else
        lock_playlist "$NEW_NAME"; lock_playlist "$NAME"
    fi
    [[ -f "$from" ]] || fail 4 not_found "no such playlist: $NAME"
    if [[ -f "$to" ]] && [[ "$NAME" != "$NEW_NAME" ]]; then
        fail 4 exists "a playlist named '$NEW_NAME' already exists"
    fi
    read_playlist "$from" "$NAME"
    local json
    json=$(printf '%s' "$PLAYLIST_JSON" | jq -c --arg name "$NEW_NAME" --arg now "$(now_utc)" \
        '.name = $name | .updated_at = $now')
    # Two objects, old name first: --undo reports the first as the list it restored and the
    # second as `from`, the name the screen may still be showing.
    undo_begin
    if [[ "$NAME" == "$NEW_NAME" ]]; then
        undo_obj "$NAME" "$json"
    else
        undo_obj "$NAME"
        undo_obj "$NEW_NAME" "$json"
    fi
    undo_commit rename
    write_playlist "$NEW_NAME" "$json"
    [[ "$NAME" == "$NEW_NAME" ]] || rm -f "$from"
    release_lock

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg from "$NAME" --arg name "$NEW_NAME" \
            '{status: "ok", name: $name, from: $from}' | with_undo
    else
        printf 'Renamed %s to %s\n' "$NAME" "$NEW_NAME"
    fi
}

# --undo --owner PID: put back what that owner's last write changed, or say why not. Every
# check is made under the locks of every playlist the copy names (in the order --rename takes
# them), because a check made outside them is a check about a list that can still move.
#
# The order of the refusals is the order a caller can act on: no copy at all, then a copy
# whose window has closed, then a copy the store has moved away from. `undo_stale` restores
# NOTHING — not the one object that still matches either — because half an undo of a rename
# is a third state nobody asked for.
#
# The copy survives a refusal (expired or stale). It is harmless — nothing will ever match it
# again — and it goes with the owner's next write, its exit, or the reaper.
do_undo() {
    local slot line verb="" deadline="" index="" k pre post i f n=0
    local keys=() pres=() posts=()
    slot=$(undo_slot "$OWNER")
    if ((DISCARD)); then
        local had=false
        [[ -e "$slot" ]] && had=true
        rm -rf "$slot" 2>/dev/null || die "cannot remove $slot"
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            jq -nc --argjson d "$had" '{status: "ok", discarded: $d}'
        fi
        return 0
    fi
    [[ -f "$slot/meta.json" ]] || fail 4 undo_none "nothing to undo for owner $OWNER"
    # One read, one field per line; joined on \037 because a name may hold a space and may not
    # hold a control character (validate_name), so `read` is a parse rather than a guess.
    while IFS=$'\037' read -r k pre post; do
        if ((n == 0)); then
            verb=$k; deadline=$pre; index=$post
        else
            keys+=("$k"); pres+=("$pre"); posts+=("$post")
        fi
        n=$((n + 1))
    done < <(jq -r '([.verb, (.deadline | tostring), (if has("index") then (.index | tostring) else "" end)]
                     | join("\u001f")),
                    (.objects[] | [.key, (.pre_exists | tostring), (.post_exists | tostring)] | join("\u001f"))' \
        "$slot/meta.json" 2>/dev/null)
    ((${#keys[@]})) && [[ "$deadline" =~ ^[0-9]+$ ]] || fail 4 corrupt "the undo copy for owner $OWNER is not readable: $slot"
    NAME="${keys[0]}"
    if ((${#keys[@]} == 1)); then
        lock_playlist "${keys[0]}"
    elif [[ "${keys[0]}" < "${keys[1]}" ]]; then
        lock_playlist "${keys[0]}"; lock_playlist "${keys[1]}"
    else
        lock_playlist "${keys[1]}"; lock_playlist "${keys[0]}"
    fi
    (($(date +%s) < deadline)) || fail 4 undo_expired "the undo window for owner $OWNER has closed"
    for ((i = 0; i < ${#keys[@]}; i++)); do
        f=$(playlist_file "${keys[$i]}")
        if [[ "${posts[$i]}" == "true" ]]; then
            [[ -f "$f" ]] && cmp -s "$f" "$slot/$i.post" ||
                fail 4 undo_stale "playlist '${keys[$i]}' changed after the write; nothing was undone"
        elif [[ -e "$f" ]]; then
            fail 4 undo_stale "playlist '${keys[$i]}' was created after the write; nothing was undone"
        fi
    done
    for ((i = 0; i < ${#keys[@]}; i++)); do
        f=$(playlist_file "${keys[$i]}")
        if [[ "${pres[$i]}" == "true" ]]; then
            cp "$slot/$i.pre" "$f.tmp.$$" 2>/dev/null && mv -f "$f.tmp.$$" "$f" ||
                { rm -f "$f.tmp.$$" 2>/dev/null || true; die "cannot restore $f"; }
        else
            rm -f "$f" || die "cannot remove $f"
        fi
    done
    rm -rf "$slot" 2>/dev/null || true
    release_lock

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg verb "$verb" --arg name "$NAME" --arg index "$index" \
            --arg from "${keys[1]:-}" \
            '{status: "ok", undone: $verb, name: $name}
             + (if $index == "" then {} else {index: ($index | tonumber)} end)
             + (if $from == "" then {} else {from: $from} end)'
    else
        printf 'Undid --%s on %s\n' "$verb" "$NAME"
    fi
}

# ==============================================================================
# 4. CLI
# ==============================================================================

print_usage() {
    cat <<'EOF'
ting-playlist — the playlist store (durable, user-level, engine-agnostic)

Usage:
  ting-playlist --ls
  ting-playlist --show NAME
  ting-playlist --add NAME         < items on stdin
  ting-playlist --rm NAME --index N
  ting-playlist --del NAME
  ting-playlist --rename NAME NEWNAME
  ting-playlist --undo --owner PID [--discard]

Options:
  --index N     Which item --rm removes (0-based, as printed by --show)
  --owner PID   On --add/--rm/--del/--rename: keep a copy that --undo can put back, for
                3 seconds, in PID's one slot (the next write by PID replaces it). The -j
                envelope then carries undo.deadline (epoch seconds). Without it, no copy.
  --discard     With --undo: drop PID's copy without restoring it (0 even if none)
  -j            JSON envelope, one line
  --color MODE  auto | always | never (default: auto)
  -h            This help
  -V            Print the suite version

Input (--add): JSON on stdin — a search envelope (ting-play --search -j, verbatim), this
  command's own --show envelope, or an array of {engine, url, [id], [title], [duration]}.
  The search-envelope form is preferred: a search RESULT carries no engine field, the
  envelope does.

    ting-play --search -j -n 5 -- "lofi hip hop" | ting-playlist --add chill
    ting-playlist --show chill -j | jq '.items[0]'

Storage: $TING_STATE_DIR/playlists/<name>.json
  (default $XDG_STATE_HOME/ting, else ~/.local/state/ting) — one file per playlist,
  written atomically under a lock. Names may not contain '/' or control characters,
  may not start with '.', and are capped at 64 characters. On a case-insensitive
  filesystem (macOS default) two names differing only in case are the SAME playlist.

Exit codes: 0 ok
            1 the call was malformed   (.reason: invalid_name, invalid_input)
            2 a dependency is missing  (jq — stderr says which)
            4 the store said no        (.reason: not_found, exists, locked, corrupt,
                                        undo_none, undo_expired, undo_stale)
  --del on a playlist that is not there is 0 with deleted:false — the end state holds.
  --undo restores nothing unless every list it names is byte-for-byte what the write left.

This store holds no playback state: to play a list, hand it to the player —
  ting-playlist --show chill -j | ting-play -d --queue -
EOF
}

set_action() {
    [[ -z "$ACTION" ]] || { echo "ting-playlist: only one action per call ($ACTION and $1)" >&2; exit 1; }
    ACTION="$1"
}

while (($#)); do
    case "$1" in
    -h | --help) print_usage; exit 0 ;;
    -V | --version)
        # Answered before any dependency gate, like every other command in the suite.
        printf 'ting-playlist %s\n' "$TING_VERSION"
        exit 0
        ;;
    -j | --json) OUTPUT_MODE="json"; shift ;;
    --color=*) COLOR_MODE="${1#*=}"; shift ;;
    --color)
        [[ $# -ge 2 ]] || { echo "ting-playlist: $1 requires a value" >&2; exit 1; }
        COLOR_MODE="$2"; shift 2
        ;;
    # One spelling each. --playlists and --delete used to be accepted as second names for
    # --ls and --del; a second official spelling is a second thing to keep in sync and it
    # doubles the surface a small model has to choose from (CLAUDE.md, ARCHITECTURE.md「平级动词，没有内核」).
    --ls) set_action ls; shift ;;
    --undo) set_action undo; shift ;;
    --discard) DISCARD=1; shift ;;
    --owner | --owner=*)
        case "$1" in
        --owner=*) OWNER="${1#*=}"; shift ;;
        *)
            [[ $# -ge 2 ]] || { echo "ting-playlist: --owner requires a process id" >&2; exit 1; }
            OWNER="$2"; shift 2
            ;;
        esac
        ;;
    --show | --add | --rm | --del)
        [[ $# -ge 2 ]] || { echo "ting-playlist: $1 requires a playlist name" >&2; exit 1; }
        case "$1" in
        --show) set_action show ;;
        --add)  set_action add ;;
        --rm)   set_action rm ;;
        *)      set_action del ;;   # --del
        esac
        NAME="$2"; shift 2
        ;;
    --rename)
        [[ $# -ge 3 ]] || { echo "ting-playlist: --rename requires two names (OLD NEW)" >&2; exit 1; }
        set_action rename
        NAME="$2"; NEW_NAME="$3"; shift 3
        ;;
    --index | --index=*)
        case "$1" in
        --index=*) INDEX="${1#*=}"; shift ;;
        *)
            [[ $# -ge 2 ]] || { echo "ting-playlist: --index requires a value" >&2; exit 1; }
            INDEX="$2"; shift 2
            ;;
        esac
        ;;
    # The gate arms. ting-play and ting-playlist are one suffix apart, so the two most likely
    # wrong turns get a sentence naming the right verb rather than a bare unknown-flag
    # error — the same thing every other command in this suite does at its edges
    # (ARCH-cli-contract.md「门模型」).
    -d | --detach | --status | --stop | --set-volume | --all | --engine | -f)
        echo "ting-playlist: $1 is a playback flag — this command stores lists, use ting-play to play one" >&2
        exit 1
        ;;
    -n | -m | -M | -s | --info | --transcript)
        echo "ting-playlist: $1 belongs to an engine — use <engine>-search / <engine>-resolve" >&2
        exit 1
        ;;
    --)
        shift
        # `--` stops FLAG parsing, not argument validation. This command takes NO
        # positional argument: every name is attached to its verb, so anything here is a
        # caller who meant a different command — most likely the player.
        if (($#)); then
            echo "ting-playlist: unexpected argument '$1' — names belong to a verb (--add NAME); to play a handle use ting-play" >&2
            exit 1
        fi
        break
        ;;
    -*)
        echo "ting-playlist: unknown flag '$1' (verbs: --ls --show --add --rm --del --rename --undo)" >&2
        exit 1
        ;;
    *)
        echo "ting-playlist: unexpected argument '$1' — names belong to a verb (see 'ting-playlist -h')" >&2
        exit 1
        ;;
    esac
done

[[ -n "$ACTION" ]] || { echo "ting-playlist: an action is required: --ls --show --add --rm --del --rename --undo (see 'ting-playlist -h')" >&2; exit 1; }
validate_enum "$COLOR_MODE" auto always never || die "--color must be one of: auto, always, never"

# A selector with no action to select for. `ting-play` rejects the same shape (--id without
# --stop/--set-volume); silently ignoring it would let a caller believe --add --index 3
# inserted at a position. ARCH-cli-contract.md「门模型」. Checked for EVERY verb — it used to live
# inside the name-taking branch, so `--ls --index 3` alone escaped it and exited 0.
if [[ "$ACTION" == "rm" ]]; then
    [[ -n "$INDEX" ]] || { echo "ting-playlist: --rm requires --index N (0-based, from --show)" >&2; exit 1; }
    [[ "$INDEX" =~ ^[0-9]+$ ]] || { echo "ting-playlist: --index must be a non-negative integer" >&2; exit 1; }
elif [[ -n "$INDEX" ]]; then
    echo "ting-playlist: --index belongs to --rm, not --$ACTION" >&2
    exit 1
fi
# The same kind of gate for the undo pair. --owner is not checked for being ALIVE: a dead
# owner only means its copy goes to the reaper on the next call, which is not a usage error.
if ((DISCARD)) && [[ "$ACTION" != "undo" ]]; then
    echo "ting-playlist: --discard belongs to --undo, not --$ACTION" >&2
    exit 1
fi
if [[ -n "$OWNER" ]]; then
    [[ "$OWNER" =~ ^[1-9][0-9]{0,9}$ ]] || { echo "ting-playlist: --owner must be a positive integer (a process id)" >&2; exit 1; }
    case "$ACTION" in
    add | rm | del | rename | undo) ;;
    *) echo "ting-playlist: --owner belongs to --add, --rm, --del, --rename and --undo, not --$ACTION" >&2; exit 1 ;;
    esac
elif [[ "$ACTION" == "undo" ]]; then
    echo "ting-playlist: --undo requires --owner PID (the process whose write it takes back)" >&2
    exit 1
fi

require_cmd jq
reap_dead_copies

case "$ACTION" in
ls) do_ls ;;
undo) do_undo ;;
show | add | rm | del | rename)
    validate_name "$NAME"
    if [[ "$ACTION" == "rename" ]]; then
        # Validate the NEW name with it in NAME's place: fail() reports the global, and an
        # envelope that named the OLD playlist for a bad new name would send a caller to
        # retry the wrong one.
        _name_save="$NAME"; NAME="$NEW_NAME"
        validate_name "$NEW_NAME"
        NAME="$_name_save"
    fi
    "do_$ACTION"
    ;;
esac
exit 0
