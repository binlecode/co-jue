# 5. CLI OPTIONS PARSING & VALIDATION
# ==============================================================================

# The `-f` and `--volume` defaults, both cross-engine: set-once choices about how this user
# listens, not about where the bytes came from. ARCH-cli-contract.md「配置面」.
PLAYBACK_MODE="$TING_PLAY_MODE"
PLAY_QUALITY="$TING_PLAY_QUALITY" # --quality flag overrides; the engine maps (mode, tier)
VOLUME="$TING_VOLUME"
PLAY_START=""        # --start: seconds to open at, beating the handle's own offset
VIZ_COLOR="${TING_VIZ_COLOR:-cyan}"
VIZ_COLOR_FLAG=0
COLOR_MODE="auto"
# Default output is prose; -j selects the machine envelope.
OUTPUT_MODE="list"
# Playback lifecycle / structured-output state.
DETACH=0
ENGINE="$TING_DEFAULT_ENGINE"  # which ting-engine-<name> turns a handle into bytes
ENGINE_SPECIFIED=0
ACTION=""            # "" (normal) | status | stop | set-volume | pause | resume | seek |
                     # seek-to | enqueue | next | set-loop | queue-show | queue-rm |
                     # queue-mv | queue-jump | queue-clear | undo | watch
ACTION_FLAG=""       # the flag that set ACTION, for conflict messages
PLAYBACK_RETRIED=0   # relayed from the resolve envelope; surfaced in the playback JSON
SET_VOLUME_ARG=""    # value from --set-volume N
# REPEAT, and only repeat: `one` is mpv's loop-file=inf, `off` is no repeat at all. Playing
# ON to the next track is not a mode of this flag — it is a QUEUE (--queue), which is a
# different thing the player already has, and giving it a second spelling here would put a
# word in --status that the player cannot verify: a queue of ten looks the same whether it
# came from a UI's "sequential" or from ten presses of --enqueue. ARCH-player.md「循环」.
#
# Deliberately NOT defaulted from a config key. ting's own three-state cycle writes
# TING_LOOP_MODE back to the user's config, and its third state (seq) is not a value this flag
# has — reading it here would make every later ting-play call die on the caller's own
# preference file. The player's default is off, full stop.
LOOP_MODE="off"      # --loop
LOOP_SET=0           # whether --loop was actually given (the flag is launch-only)
SET_LOOP_ARG=""      # value from --set-loop
SEEK_ARG=""          # value from --seek ±N / --seek-to N
QUEUE_INPUT=""       # value from --queue / --enqueue: always "-", i.e. stdin
QUEUE_INDEX_ARG=""   # value from --queue-rm / --queue-mv / --queue-jump: which track
QUEUE_TO_ARG=""      # value from --to: where --queue-mv puts it
# The identity pin the three rewrite verbs require. MANDATORY and not optional, because the
# thing it prevents is unrecoverable — a queue dies with its player, so a track removed by a
# stale index is gone from everywhere — and because --queue-show prints this url beside the
# index it belongs to, so quoting it back costs a caller nothing. An opt-in guard against an
# irreversible mistake is a guard that is missing exactly when it was needed.
QUEUE_EXPECT_URL=""  # value from --expect-url
TARGET_ID=""         # value from --id (target a specific detached player)
STOP_ALL=0           # --stop --all
RESOLVED_ID=""       # resolve_target out-param: the resolved player id
RESOLVE_ERR=""       # resolve_target out-param: "not_playing" | "ambiguous"
RESOLVE_PLAYERS_JSON="[]"  # resolve_target out-param: candidates on ambiguity
STATE_DIR="${TMPDIR:-/tmp}/ting-$(id -u)"
PLAYERS_DIR="$STATE_DIR/players"   # one <id>.json per detached player

# Actions are mutually exclusive; a caller asking for two used to silently get whichever
# flag came last. Name both flags in the error instead of guessing an intent.
set_action() {
    local want=$1 flag=$2
    if [[ -n "$ACTION" && "$ACTION" != "$want" ]]; then
        die "conflicting actions: $ACTION_FLAG and $flag"
    fi
    ACTION="$want"
    ACTION_FLAG="$flag"
}

((! $#)) || forward_engine_verb "$@"

normalized_args=()
while (($#)); do
    case "$1" in
    --)
        # End of options: everything after it is the query/URL, VERBATIM. Without this the
        # loop kept scanning past `--`, so a query that merely LOOKS like a long flag became
        # an action (`yt -l -- --status` listed players instead of searching for the text).
        # The `--` is forwarded to getopts too — getopts stops there (verified on bash 3.2),
        # so a query/URL starting with a single dash survives as well. This is the guard the
        # wrappers rely on when they delegate (ARCHITECTURE.md「端到端控制流」).
        normalized_args+=("--")
        shift
        while (($#)); do
            normalized_args+=("$1")
            shift
        done
        break
        ;;
    --help)
        normalized_args+=("-h")
        shift
        ;;
    --version)
        normalized_args+=("-V")
        shift
        ;;
    --color)
        [[ $# -ge 2 ]] || die "--color requires a value"
        COLOR_MODE="$2"
        shift 2
        ;;
    --color=*)
        COLOR_MODE="${1#*=}"
        shift
        ;;
    --engine)
        [[ $# -ge 2 ]] || die "--engine requires a value"
        ENGINE="$2"
        ENGINE_SPECIFIED=1
        shift 2
        ;;
    --engine=*)
        ENGINE="${1#*=}"
        ENGINE_SPECIFIED=1
        shift
        ;;
    --volume)
        [[ $# -ge 2 ]] || die "--volume requires a value"
        VOLUME="$2"
        shift 2
        ;;
    --volume=*)
        VOLUME="${1#*=}"
        shift
        ;;
    --viz-color)
        [[ $# -ge 2 ]] || die "--viz-color requires a value"
        VIZ_COLOR="$2"
        VIZ_COLOR_FLAG=1
        shift 2
        ;;
    --viz-color=*)
        VIZ_COLOR="${1#*=}"
        VIZ_COLOR_FLAG=1
        shift
        ;;
    # Seconds only, and no sign — deliberately NOT mpv's own --start grammar. Passing that
    # through (--start=-60 counts from the end, --start=50% is a fraction) would publish
    # mpv's syntax on a frozen surface and make the player impossible to reimplement over
    # anything else. Seconds is also what the rest of this suite means by a time: duration,
    # position, --seek-to, and the listening row's `seconds` are all plain seconds.
    --start)
        [[ $# -ge 2 ]] || die "--start requires a value"
        PLAY_START="$2"
        shift 2
        ;;
    --start=*)
        PLAY_START="${1#*=}"
        shift
        ;;
    --json|-j)
        normalized_args+=("-j")
        shift
        ;;
    --detach)
        normalized_args+=("-d")
        shift
        ;;
    --status)
        set_action status --status
        shift
        ;;
    --stop)
        set_action stop --stop
        shift
        ;;
    --get-url)
        # Retired: a stream URL is the engine's internal hand-off to the player, not a
        # public verb — what a caller wants from a handle is to play it or to read about it.
        die "--get-url is gone — play the handle ('ting-play -- <id|URL>'), or read about it with 'ting-play --info -- <id|URL>'"
        ;;
    --sub-lang | --sub-langs | --sub-lang=* | --sub-langs=* | --cursor | --cursor=* | --segments \
        | --min-duration | --max-duration | --sort | --min-duration=* | --max-duration=* | --sort=*)
        # An engine verb's modifier without its verb. The verbs themselves never get here —
        # forward_engine_verb has exec'd them — so the caller has the right flag and no verb.
        die "${1%%=*} modifies an engine verb — see --search, --items, --transcript, --feed, --playlists and --related in 'ting-play -h'"
        ;;
    --set-volume)
        [[ $# -ge 2 ]] || die "--set-volume requires a value"
        set_action set-volume --set-volume
        SET_VOLUME_ARG="$2"
        shift 2
        ;;
    --set-volume=*)
        set_action set-volume --set-volume
        SET_VOLUME_ARG="${1#*=}"
        shift
        ;;
    --pause)
        set_action pause --pause
        shift
        ;;
    --watch)
        set_action watch --watch
        shift
        ;;
    --engines)
        set_action engines --engines
        shift
        ;;
    --resume)
        set_action resume --resume
        shift
        ;;
    --seek)
        [[ $# -ge 2 ]] || die "--seek requires a value"
        set_action seek --seek
        SEEK_ARG="$2"
