    --quality=*)
        validate_enum "${1#*=}" auto low medium high ||
            die "--quality must be one of: auto, low, medium, high"
        PLAY_QUALITY="${1#*=}"
        shift
        ;;
    --all)
        STOP_ALL=1
        shift
        ;;
    --*)
        # Every long flag is handled in THIS loop (getopts below sees only short ones), so
        # an unmatched one can never be valid — and left to fall through it reached getopts
        # as `-`, which reported the useless "invalid option: --". The wrapper used to hold
        # this arm; naming the real flags is the half of a gate that helps a caller recover.
        die "unknown flag '$1' (play flags: -f --quality -d -j --engine --volume --start --loop --status --stop --set-volume --pause --resume --seek --seek-to --set-loop --queue --enqueue --next --queue-show --queue-rm --queue-mv --queue-jump --queue-clear --undo --owner --discard --to --expect-url --id --all --engines --color --viz-color)"
        ;;
    *)
        normalized_args+=("$1")
        shift
        ;;
    esac
done
if ((${#normalized_args[@]})); then
    set -- "${normalized_args[@]}"
else
    set --
fi

while getopts ":f:djhV" opt; do
    case "$opt" in
    f) PLAYBACK_MODE=$(normalize_playback_mode "$OPTARG") ;;
    d) DETACH=1 ;;
    j) OUTPUT_MODE="json" ;;
    h)
        usage
        exit 0
        ;;
    # Answered before ANY dependency gate: a version is the first thing a bug report needs,
    # and needing yt-dlp installed to find out which version you have is backwards.
    V)
        printf 'ting-play %s\n' "$TING_VERSION"
        exit 0
        ;;
    :)
        die "option -$OPTARG requires an argument"
        ;;
    \?)
        # The gate the yt-play wrapper used to hold: a search flag here is a caller who
        # picked the wrong verb, and "invalid option: -n" does not say which verb is right.
        case "$OPTARG" in
        n) die "-n is an engine modifier — see --search, --feed, --related and --playlists in 'ting-play -h'" ;;
        esac
        die "invalid option: -$OPTARG"
        ;;
    esac
done

shift $((OPTIND - 1))

QUERY="$*"

if ! validate_enum "$COLOR_MODE" auto always never; then
    die "--color must be one of: auto, always, never"
fi
if [[ -n "$VOLUME" ]]; then
    if ! is_non_negative_int "$VOLUME"; then
        die "--volume must be a non-negative integer"
    fi
    if ((VOLUME > 100)); then
        die "--volume must be between 0 and 100"
    fi
fi

# Flag combinations that used to be accepted and silently ignored. --id/--all only mean
# something to the lifecycle verbs, -d is a launch rather than an action, and a detached
# player has no terminal for the terminal-rendering modes to draw into (ARCH-player.md「状态机」).
case "$ACTION" in
stop | set-volume | pause | resume | seek | seek-to | enqueue | next | set-loop | \
    queue-show | queue-rm | queue-mv | queue-jump | queue-clear | watch) ;;
*)
    # --id names ONE running player, so it is meaningless to a verb that does not address
    # one. Listing the verbs beats "invalid combination": the caller has the right idea and
    # the wrong verb.
    [[ -z "$TARGET_ID" ]] || die "--id applies only to the verbs that address one player: --stop, --set-volume, --pause, --resume, --seek, --seek-to, --set-loop, --watch, --enqueue, --next and the five queue verbs"
    ;;
esac
if ((STOP_ALL)) && [[ "$ACTION" != stop ]]; then
    die "--all applies only to --stop"
fi
# The undo pair, gated like --all: a modifier on a verb it does not belong to is refused,
# not ignored. --owner is not checked for being alive — a dead owner's copy just goes to the
# sweep on the next call.
if ((UNDO_DISCARD)) && [[ "$ACTION" != undo ]]; then
    die "--discard applies only to --undo"
fi
if [[ -n "$UNDO_OWNER" ]]; then
    [[ "$UNDO_OWNER" =~ ^[1-9][0-9]{0,9}$ ]] || die "--owner must be a positive integer (a process id)"
    case "$ACTION" in
    enqueue | queue-rm | queue-clear | undo) ;;
    *) die "--owner applies only to --enqueue, --queue-rm, --queue-clear and --undo" ;;
    esac
elif [[ "$ACTION" == undo ]]; then
    die "--undo requires --owner PID (the process whose queue write it takes back)"
fi
if [[ -n "$PLAY_START" ]]; then
    # Rejected AT THE DOOR rather than clamped or coerced: --start 10:00 and --start -60 are
    # both a caller who believes something about this flag that is not true, and playing
    # from the top instead would hide that belief until they noticed the wrong minute.
    if ! is_non_negative_int "$PLAY_START"; then
        die "--start must be a whole number of seconds (0 or more), not '$PLAY_START'"
    fi
    # --start belongs to the PLAYBACK path. The lifecycle verbs address a player that is
    # already running, and moving a running playhead is what --seek-to is for.
    [[ -z "$ACTION" ]] || die "--start applies to starting playback, not to $ACTION_FLAG (to move a running player, use --seek-to)"
fi
# --loop is a LAUNCH modifier, the same shape --start has: it says how the player about to
# start should behave, and a player that is already running is --set-loop's business. Gated
# on LOOP_SET rather than on the value, so `--loop off --pause` is refused too — it is the
# same misunderstanding, not a harmless no-op.
if ((LOOP_SET)) && [[ -n "$ACTION" ]]; then
    die "--loop applies to starting playback, not to $ACTION_FLAG (to change a player that is already running, use --set-loop)"
fi
if ((DETACH)) && [[ -n "$ACTION" ]]; then
    die "-d/--detach cannot be combined with $ACTION_FLAG"
fi
# A DETACHED PLAYER IS ONLY REACHABLE THROUGH ITS SOCKET, and a unix socket path has a hard
# ceiling. sun_path is 104 bytes on macOS and the BSDs (108 on Linux), and mpv refuses one
# byte short of that: measured on mpv 0.41 / macOS, 2026-09-26, a 102-byte path gets a
# socket and a 103-byte one logs "Could not create IPC socket". Past it mpv does not fail —
# it plays on with NO IPC server — so the launch used to answer `started` for a player every
# socket verb then answered 4 about, and --watch polled for a socket that would never exist.
# Go's per-test temp dirs (…/T/TestName123456789/001/) put "$STATE_DIR/mpv-XXXXXX.sock" at
# 111 bytes. Linux's 106 is the same rule over its 108, measured on mpv 0.40 / Linux 7.0
# (Debian trixie container), 2026-09-26: 106 bytes gets a socket, 107 does not.
#
# Refused HERE, before a player or even an id exists, because the path is known from the
# environment alone: the id is always mktemp's six characters. Exit 1 like every other
# environment value this file validates (TING_VIZ_STYLE) — the call cannot
# succeed as configured, and the message says which variable to change. Counted in BYTES
# (LC_ALL=C), because that is what the kernel counts; a CJK directory name is three per glyph.
# Checked ahead of the -f ascii|viz refusal below only so the suite can pin the boundary
# offline: one byte either side of it, the other refusal answers instead.
detach_sock_fits() {
    local LC_ALL=C
    local sock="$STATE_DIR/mpv-XXXXXX.sock" max=102
    [[ "$(uname -s 2>/dev/null)" == Linux ]] && max=106
    ((${#sock} <= max)) && return 0
    die "-d/--detach: the player's control socket would be $sock (${#sock} bytes), past the $max bytes a player socket path can have here — set TMPDIR to a shorter directory"
}
if ((DETACH)); then
    detach_sock_fits
fi
if ((DETACH)) && [[ "$PLAYBACK_MODE" == "ascii" || "$PLAYBACK_MODE" == "viz" ]]; then
    die "-d/--detach cannot use -f $PLAYBACK_MODE: a detached player has no terminal to render into (use audio, video, or fast)"
fi
# …and the same impossibility from the OUTPUT side, which used to be the one arm missing.
# play_url_json captures the player's whole stdout into a temp file so it can emit exactly one
# JSON line, and tct's escape stream is stdout — so -f viz -j ran the track to its end and drew
# nothing, answering with an envelope that looked like a success. That was the suite's only
# silent trap: a caller (an agent especially) got no exit code, no message, and no picture, and
# so had no way to learn it had asked for something that cannot work. Documented in
# ARCH-player.md as 「实测」 precisely because a trap that does not refuse cannot be checked;
# refusing it is what makes it provable. Guarded on the PLAYBACK path only — with a lifecycle
# verb, -f is not drawing anything and -j is the normal way to read the answer.
if [[ "$OUTPUT_MODE" == "json" && -z "$ACTION" ]] &&
    [[ "$PLAYBACK_MODE" == "ascii" || "$PLAYBACK_MODE" == "viz" ]]; then
    die "-j cannot use -f $PLAYBACK_MODE: the JSON envelope captures stdout, which is where the picture is drawn (drop -j, or use audio, video, or fast)"
fi

# --queue turns a LAUNCH into a queued launch: the handles come from stdin, and the first
# item is what this player starts on. Read here, before the handle rules below, because
# QUERY is what those rules judge — and read in the PARENT so a malformed queue is a usage
# error (1) from the caller's own shell rather than a line in a detached player's log.
if [[ -n "$QUEUE_INPUT" ]] && [[ "$ACTION" != enqueue ]]; then
    ((DETACH)) || die "--queue starts a detached player: use 'ting-play -d --queue -'"
    [[ -z "$ACTION" ]] || die "--queue cannot be combined with $ACTION_FLAG"
    [[ "$QUEUE_INPUT" == "-" ]] || die "--queue takes '-': the items are read from stdin"
    [[ "$QUERY" != *[![:space:]]* ]] || die "--queue takes its handles from stdin, not from the command line"
    require_cmd jq
    read_queue_items --queue
    # The engine is per ITEM (a playlist may mix sources), so --engine is only the fallback
    # read_queue_items already applied. What the LAUNCH needs is the first item's.
    IFS=$'\037' read -r ENGINE QUERY < <(
        printf '%s' "$QUEUE_ITEMS_JSON" | jq -r '.[0] | [.engine, .url] | join("\u001f")'
    )
    ENGINE_RESOLVE=""
fi

# A HANDLE is what the player forwards to an engine: a URL, or an engine-specific media id
# (`dQw4w9WgXcQ`, `BV1FPjy6TEiE`). The player deliberately CANNOT tell a good id from a bad
# one — that shape is engine knowledge, and giving it up is the whole point of the split — so
# it rejects only what is not a handle at all: empty, or containing whitespace, which is a
# search query and belongs to a different verb. An unresolvable handle therefore surfaces as
# a propagated engine failure (2+), not a usage error. docs/ARCHITECTURE.md「端到端控制流」.
IS_HANDLE=0
if [[ -n "$QUERY" && "$QUERY" != *[[:space:]]* ]]; then
    IS_HANDLE=1
    if ((! ENGINE_SPECIFIED)) && is_url_target "$QUERY"; then
        _sniffed=$(sniff_engine_from_url "$QUERY") || _sniffed=""
        if [[ -n "$_sniffed" ]]; then
            ENGINE="$_sniffed"
            ENGINE_RESOLVE=""
        fi
    fi
fi

# Every remaining ACTION (status / stop / set-volume) addresses a running PLAYER, not a
# piece of media, so --detach is the only verb left that needs a handle.
if ((DETACH)) && ((! IS_HANDLE)); then
    die "--detach requires a video id or URL"
fi

# Positional arguments belong to a new playback launch; no lifecycle or control verb accepts
# them. Reject stray arguments early rather than silently ignoring them — a caller typing
# `ting-play --status -- <player-id>` or `ting-play --stop -- <player-id>` has the wrong syntax.
if [[ -n "$ACTION" ]] && [[ "$QUERY" == *[![:space:]]* ]]; then
    if [[ "$ACTION" == "status" ]]; then
        die "--status takes no positional arguments (to query detached players, run 'ting-play --status [-j]')"
    elif [[ "$ACTION" == "enqueue" ]]; then
        die "--enqueue takes its items from stdin, not from the command line"
    elif [[ "$ACTION" == "engines" ]]; then
        die "--engines takes no positional arguments — it lists every installed engine"
    else
        die "$ACTION_FLAG takes no positional arguments (to address a player, use --id ID)"
    fi
fi

# A bare invocation (no handle, no lifecycle action) is a usage error (ARCHITECTURE.md「调用形状」). Report it before
# the heavier mpv dependency check so the message is about the missing input, not a missing
# player. Searching is --search; interactive browsing is ting.
if ((! IS_HANDLE)) && [[ "$QUERY" != *[![:space:]]* ]] && [[ -z "$ACTION" ]]; then
    die "provide a video id or URL (to search, run 'ting-play --search -- <query>'; for interactive browsing, ting)"
fi

# Every call, whatever it is for, sweeps away the undo copies of owners that are gone (the
# kill -9 path; see reap_dead_undo_copies). A glob and nothing else when there are none.
# --engines touches no state, so it answers before the sweep below, and before every
# dependency gate (do_engines). --engine is the one flag refused with it: a caller passing
# both expects a filtered answer, and would read the whole list as "yes, installed".
if [[ "$ACTION" == "engines" ]]; then
    ((! ENGINE_SPECIFIED)) || die "--engines lists every installed engine — it takes no --engine"
    do_engines
fi

reap_dead_undo_copies

# Lifecycle queries need only jq and take no handle — answer them before the heavier
# mpv dependency check and before any routing.
if [[ "$ACTION" == "status" ]]; then
    require_cmd jq
    do_status
fi
if [[ "$ACTION" == "stop" ]]; then
    require_cmd jq
    do_stop "${TARGET_ID:-}" "$STOP_ALL"
fi
# --set-volume drives a running player over its IPC socket: needs jq + a unix-socket
# netcat, but NOT mpv, and takes no handle. The client is gated lazily HERE (not in
# require_deps) so a plain play never demands it. BSD `nc -U` is stock on macOS; on Linux
# any -U-capable variant is accepted — netcat-openbsd's nc, or ncat (resolve_nc_unix).
if [[ "$ACTION" == "set-volume" ]]; then
    require_cmd jq
    resolve_nc_unix || die_dep "a unix-socket netcat (nc with -U, or ncat)"
    do_set_volume "$SET_VOLUME_ARG" "${TARGET_ID:-}"
fi
# The same socket, the same lazy nc gate, the same exit taxonomy. The value is validated
# HERE rather than inside the verb so a malformed one is a usage error (1) that never
# reaches a player — "did not take effect" (4) is for a well-formed call mpv refused.
if [[ "$ACTION" == "seek" ]]; then
    is_signed_int "$SEEK_ARG" ||
        die "--seek takes a SIGNED number of seconds (+30 / -15); for an absolute position use --seek-to N"
fi
if [[ "$ACTION" == "seek-to" ]]; then
    is_non_negative_int "$SEEK_ARG" || die "--seek-to takes a non-negative number of seconds"
fi
case "$ACTION" in
pause | resume | seek | seek-to)
    require_cmd jq
    resolve_nc_unix || die_dep "a unix-socket netcat (nc with -U, or ncat)"
    do_playback_verb "$ACTION" "$SEEK_ARG" "${TARGET_ID:-}"
    ;;
watch)
    require_cmd jq
    resolve_nc_unix || die_dep "a unix-socket netcat (nc with -U, or ncat)"
    do_watch "${TARGET_ID:-}"
    ;;
esac
# The queue verbs address a player's own state on disk, so they need jq and NOT nc — the
# queue never goes near the socket. --next signals the child instead (do_next).
if [[ "$ACTION" == "enqueue" ]]; then
    [[ "$QUEUE_INPUT" == "-" ]] || die "--enqueue takes '-': the items are read from stdin"
    [[ "$QUERY" != *[![:space:]]* ]] || die "--enqueue takes its items from stdin, not from the command line"
    require_cmd jq
    read_queue_items --enqueue
    do_enqueue "${TARGET_ID:-}"
fi
if [[ "$ACTION" == "next" ]]; then
    require_cmd jq
    do_next "${TARGET_ID:-}"
fi
# The five queue verbs, gated on jq alone for the reason --enqueue and --next are: what they
# rewrite is a file, and the only thing they say to the running player is --queue-jump's
# signal, which is a kill and not a socket write.
#
# EVERY CHECK IN THIS BLOCK IS A USAGE ERROR (1) AND HAPPENS BEFORE A PLAYER IS ADDRESSED.
# That is the line the exit taxonomy draws: a value that is not a queue position at all is
# the argv being wrong and no player can make it right, while a value that is a position but
# not a WAITING one depends on where the player has got to — it is a well-formed call that
# did not take effect, which is 4 and is decided under the lock in queue_edit.
case "$ACTION" in
queue-show | queue-clear | undo)
    require_cmd jq
    [[ -z "$QUEUE_EXPECT_URL" ]] || die "--expect-url applies only to --queue-rm, --queue-mv and --queue-jump"
    [[ -z "$QUEUE_TO_ARG" ]] || die "--to applies only to --queue-mv"
    ;;
queue-rm | queue-mv | queue-jump)
    require_cmd jq
    is_non_negative_int "$QUEUE_INDEX_ARG" ||
        die "$ACTION_FLAG takes a non-negative queue index (see 'ting-play --queue-show')"
    # The pin is REQUIRED, and the message says what to do rather than only what was missing:
    # the url is printed beside its index by the verb the caller has to run anyway.
    [[ -n "$QUEUE_EXPECT_URL" ]] ||
        die "$ACTION_FLAG requires --expect-url: pass the url --queue-show prints for that index"
    if [[ "$ACTION" == "queue-mv" ]]; then
        [[ -n "$QUEUE_TO_ARG" ]] || die "--queue-mv requires --to N (the position to move it to)"
        is_non_negative_int "$QUEUE_TO_ARG" ||
            die "--to takes a non-negative queue index (see 'ting-play --queue-show')"
    else
        [[ -z "$QUEUE_TO_ARG" ]] || die "--to applies only to --queue-mv"
    fi
    ;;
esac
case "$ACTION" in
queue-show) do_queue_show "${TARGET_ID:-}" ;;
queue-rm) do_queue_rm "$QUEUE_INDEX_ARG" "${TARGET_ID:-}" ;;
queue-mv) do_queue_mv "$QUEUE_INDEX_ARG" "$QUEUE_TO_ARG" "${TARGET_ID:-}" ;;
queue-jump) do_queue_jump "$QUEUE_INDEX_ARG" "${TARGET_ID:-}" ;;
queue-clear) do_queue_clear "${TARGET_ID:-}" ;;
undo) do_queue_undo ;;
esac
# The third disk-state verb, and the reason it is here rather than up with the socket verbs:
# what it writes is the player's record. It TRIES the socket afterwards (do_set_loop) so the
# current track picks the change up immediately, but it does not depend on one, so it is
# gated on jq alone — no nc, exactly like --enqueue and --next.
if [[ "$ACTION" == "set-loop" ]]; then
    require_cmd jq
    do_set_loop "$SET_LOOP_ARG" "${TARGET_ID:-}"
fi
# yt-dlp is no longer a dependency of the PLAYER: extraction belongs to the engine, which
# gates its own tools. What is left here is what actually plays and shapes output.
require_deps jq mpv

if [[ "$PLAYBACK_MODE" == "ascii" ]]; then
    if ! mpv_supports_vo "$TING_ASCII_VO"; then
        die "mpv does not support --vo=$TING_ASCII_VO (run 'mpv --vo=help' to choose a supported terminal VO)"
    fi
fi

if [[ "$PLAYBACK_MODE" == "viz" ]]; then
    if ! validate_enum "$TING_VIZ_STYLE" bars wave; then
        die "TING_VIZ_STYLE must be one of: bars, wave"
    fi
    if [[ ! "$VIZ_COLOR" =~ ^[a-zA-Z0-9#_|]+$ ]]; then
        if ((VIZ_COLOR_FLAG)); then
            die "--viz-color must be a valid color name or hex (got '$VIZ_COLOR')"
        else
            die "TING_VIZ_COLOR must be a valid color name or hex (got '$VIZ_COLOR')"
        fi
    fi
fi

# A TERMINAL-RENDERING MODE UNDER A NON-UTF-8 LOCALE REFUSES; it does not degrade. tct draws
# with U+2584, so under the C locale the picture was mojibake or an empty pane and nothing
# said why — the same silent shape `-j -f viz` had, arriving from the environment instead of
# from argv.
#
# REFUSE rather than fall back, decided 2026-09-01. The two candidates were an ASCII canvas
# (drop the half-block algo and shrink the filter to match) and this. Degrading loses the
# vertical half of the resolution the doubled canvas exists to buy (ARCH-player.md
# 「终端可视化」) and hands back a picture bad enough to read as a bug, which is worse than a
# sentence saying what to change — and `--vo-tct-algo=plain`, the obvious lever, is already a
# recorded NO in ROADMAP.md for exactly that reason. A refusal the caller can act on beats a
# picture they cannot trust.
#
# NOT read from TING_ASCII: that is `ting`'s chrome switch for its own renderer, the player
# does not read it, and it must not start — a UI's knowledge does not descend into the player
# (CLAUDE.md's governing principle). The locale is the fact; TING_ASCII is one surface's opinion
# about it.
#
# Scoped to the modes that actually draw half blocks: viz hardcodes --vo=tct, ascii takes
# TING_ASCII_VO, so a user who pointed that at sixel or kitty is not affected and is not asked
# about a glyph their VO never emits.
if { [[ "$PLAYBACK_MODE" == "viz" ]] ||
    [[ "$PLAYBACK_MODE" == "ascii" && "$TING_ASCII_VO" == "tct" ]]; } &&
    ! locale_is_utf8; then
    die "-f $PLAYBACK_MODE needs a UTF-8 locale: --vo=tct draws in half blocks (U+2584), which '${LC_ALL:-${LC_CTYPE:-${LANG:-unset}}}' cannot encode (re-run as 'LC_ALL=en_US.UTF-8 ting-play …', or use -f audio, video or fast)"
fi

# =-----------------------------------------------------------------------------
# ROUTING: play a handle. The engine verbs were forwarded before the parse.
# =-----------------------------------------------------------------------------
if ((IS_HANDLE)); then
    if ((DETACH)); then
        detach_play "$QUERY"
        exit 0
    fi
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        rc=0
        play_url_json "$QUERY" "$PLAYBACK_MODE" || rc=$?
        exit "$rc"
    fi
    # The detached child takes the loop (it owns a queue, even a queue of one) and never
    # returns from it. Every other prose caller plays once: rc is captured rather than left
    # to set -e so detached_epitaph gets to run, and the exit status is what set -e would
    # have exited with anyway.
    if [[ -n "${TING_PLAYER_ID:-}" && -n "${TING_DETACHED:-}" ]]; then
        detached_child_loop "$QUERY"
    fi
    rc=0
    play_url_directly "$QUERY" || rc=$?
    detached_epitaph "$rc"
    exit "$rc"
fi

# =-----------------------------------------------------------------------------
# Not a handle: nothing left to route. A bare query is not a play — searching is its own
# verb, so a query reaching here is a caller who left it out. docs/ARCH-engine.md「搜索子系统」.
# =-----------------------------------------------------------------------------
die "'$QUERY' is not a video id or URL — run 'ting-play --search -- $QUERY' to search for it"
