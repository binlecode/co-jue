#!/usr/bin/env bash

# Portability: must run on bash 3.2 (macOS system bash). No bash-4 features; guard
# every empty-array expansion (a bare "${arr[@]}" on an empty array aborts under
# `set -u` on 3.2). See ARCHITECTURE.md「可移植性契约」.
#
# set -e means any unguarded failing command aborts the script. This is desired for
# this core: single-handle playback is non-interactive, so if the engine or mpv fails the
# script should abort and propagate a real exit code. Where a failure must
# be captured rather than abort (e.g. classifying a playback error for JSON output),
# the `cmd || rc=$?` idiom keeps set -e from firing — see play_url_json().
set -euo pipefail

# ==============================================================================
# 1. CORE LIBRARY & DEFAULT SETTINGS (Merged from yt-common.sh)
# ==============================================================================
# Resolve the symlink chain before taking a directory from it. ~/bin/ting-play is a SYMLINK
# into the checkout (the documented install), so a plain dirname yields ~/bin — which holds
# no VERSION and no engines, leaving --version reading "unknown" and the engine lookup
# falling through to PATH. The other six entry points already resolve this way; this file
# was the outlier. bash 3.2 has no `readlink -f`, hence the loop, and physical resolution
# (-P) because a relative link must be normalised against what it points at, not against the
# directory the link happens to sit in.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)
# THE version of the whole suite, declared once — in a data file, not in code. The player and
# the engines are independent executables that share no library, so a shell variable in any
# one of them would make the others ask IT for the version, which is the wrong dependency
# direction for a player that must not know its engines. A one-line file each reads keeps
# "one fact, one place" with zero code sharing. CLAUDE.md § one fact, one place.
if [[ -r "$SCRIPT_DIR/../VERSION" ]]; then
    TING_VERSION=$(cat "$SCRIPT_DIR/../VERSION")
else
    TING_VERSION="unknown"
fi

# CONFIGURATION — TWO FILES, FOUR LAYERS. Set-once tuning arrives from a file as well as the
# environment, because an agent invoking these commands never sources a shell profile, so a
# knob that exists only as an export is a knob half the callers cannot set.
#
#   flag  >  environment  >  the user's config  >  the shipped defaults
#
# The shipped defaults are `<checkout>/config`, read from one level above this script's own
# RESOLVED location — the same mechanism, and the same reason, as the VERSION read above.
# That file is where every default value in the suite is declared, ONCE, for every entry
# point. Before it existed each default was inlined per script, which meant a cross-engine
# value like TING_SEARCH_RESULTS was written twice and could drift apart with nothing to
# catch it. It is therefore NOT optional: a checkout without it is broken, and says so with
# exit 2 rather than letting set -u abort somewhere further in. --version and --help still
# answer, because those two must work on a broken checkout to be worth having.
#
# The user's own file is ${XDG_CONFIG_HOME:-~/.config}/ting/config — read FIRST, so it wins
# over the shipped defaults; TING_CONFIG relocates it (environment only: a file cannot move
# itself, and the two suites set it so they never read a real user's config). Both files are
# optional to WRITE and neither is written by any command — nothing in the suite persists
# configuration.
#
# `KEY=value`, one per line, `#` to end of line is a comment, one matching quote pair
# stripped, a leading ~/ expanded. Deliberately NOT sourced as shell: a config file that is
# executed can run anything, and this suite's safety story is that its inputs are DATA.
# `eval` assigns from a variable, never from the line, so `TING_X=$(cmd)` stores those nine
# characters. Only TING_ keys are read, so no file can reach PATH, TMPDIR or LD_PRELOAD.
# Every name the suite owns is TING_, so the ones a file must not set are refused by name.
# The names the suite sets itself: TING_VERSION (the VERSION line read in above),
# TING_DEFAULTS, and the four the player sets for its own detached child (TING_IPC_SOCK and its
# siblings — a file-level socket path would aim every player at one socket). TING_CONFIG,
# because a file cannot move itself. And TING_ENGINE_DIR, which IS a knob — refused for what its
# VALUE is rather than for what the name means. It points at a directory of EXECUTABLES this
# suite runs, so a config file that could set it would be PATH under another spelling, and
# the sentence above would stop being true. Environment only, like the config path.
#
# Four defaults stay inline and are named in `config`'s own header: TING_STATE_DIR and
# TING_ENGINE_DIR (both chain through an XDG variable, which a flat file cannot express),
# TING_LANG and TING_ASCII (unset IS the locale probe for both).
#
# The key list is ARCH-cli-contract.md「配置面」. This block is duplicated VERBATIM in every
# entry point: independent executables share no library, and a byte-for-byte copy is
# greppable for drift where a sourced file would invert the dependency direction the VERSION
# data file exists to keep straight.
TING_CONFIG="${TING_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/ting/config}"
TING_DEFAULTS="$SCRIPT_DIR/../config"
ting_read_config() {
    local file="$1" line key val
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        while [[ "$line" == [[:space:]]* ]]; do line="${line#[[:space:]]}"; done
        while [[ "$line" == *[[:space:]] ]]; do line="${line%[[:space:]]}"; done
        [[ -n "$line" && "$line" == *=* ]] || continue
        key="${line%%=*}"
        val="${line#*=}"
        while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
        while [[ "$val" == [[:space:]]* ]]; do val="${val#[[:space:]]}"; done
        [[ "$key" =~ ^TING_[A-Z0-9_]+$ ]] || continue
        case "$key" in
        TING_CONFIG | TING_ENGINE_DIR | TING_VERSION | TING_DEFAULTS | TING_IPC_SOCK | TING_DETACHED | TING_PLAYER_ID | TING_DETACHED_LOG) continue ;;
        esac
        if [[ ${#val} -ge 2 ]] && { [[ "$val" == \"*\" ]] || [[ "$val" == \'*\' ]]; }; then
            val="${val#?}"
            val="${val%?}"
        fi
        [[ "$val" == "~/"* ]] && val="$HOME/${val#\~/}"
        eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
    done < "$file"
}
# FAIL FAST AND SAY WHY. There is deliberately no escape hatch for --version or --help: they
# were tried, and letting execution continue past a missing defaults file replaced this one
# clear line with `TING_ASCII_VO: unbound variable` from set -u somewhere further down. A
# checkout missing part of itself is not a dependency gate (yt-dlp, jq and mpv still answer
# --version without being installed) — it is a broken checkout, and 2 is the exit code for a
# failure that is not the caller's usage error.
if [[ ! -r "$TING_DEFAULTS" ]]; then
    printf '%s: cannot read the shipped defaults at %s — that file declares every default value in the suite and is not optional\n' \
        "$(basename "$0")" "$TING_DEFAULTS" >&2
    exit 2
fi
ting_read_config "$TING_CONFIG"
ting_read_config "$TING_DEFAULTS"
# Path to this script, used to re-exec a detached playback child (see detach_play).
SELF="${BASH_SOURCE[0]}"

# Optional custom mpv input.conf path; empty means use mpv defaults.

# WHICH ENGINE turns a handle into bytes. An engine is ONE file per site, `ting-engine-<name>`;
# the player calls its --stream verb to play and forwards the public engine verbs to it, and
# only by that name — it carries no idea what a format string or a cookie store looks like.
# Name == file suffix is what keeps the lookup a string concatenation instead of a registry
# the player and the TUI would both have to hold. Per-call override: --engine.
# ARCH-cli-contract.md「命令规格」

# THE LISTENING LOG, on by default; `TING_HISTORY=0` turns it off. A history that ships off is
# not a history — nobody finds the knob that has to be found before the feature has ever
# produced a row, so the default is the feature. What it buys is bounded on purpose: a local
# file, on this machine, with a --clear verb of its own. The reopen condition is a SHARED
# account, where "what this login listened to" stops being one person's record.
# The writing happens here (the child is the only process that knows a track ended and why);
# the storing is ting-history's, called by name like an engine. ARCH-cli-contract.md「配置面」

MPV_AUDIO_OPTIONS=(--msg-level=display-tags=warn,osd/libass=error --term-osd-bar --no-video)
# Keep video output auto-selected by mpv for compatibility across terminals/displays.
# Video-mode terminal-noise fix (video/fast). mpv draws the media TITLE as a video OSD via
# libass; a title with glyphs no font covers (emoji — pervasive on YouTube) makes libass emit
# a per-frame "[osd/libass] fontselect: failed … glyph" warning AND macOS CoreText a
# ".LastResort" note. At ~30/s these interrupt mpv's in-place status line so it scrolls
# endlessly, burying ting's menu. Two-part fix that KEEPS the on-window OSD/OSC (so the video
# window still shows its seek bar / controls): (1) --msg-level=osd/libass=error suppresses the
# libass warnings at the source while keeping error level for the -j classifier; (2) the
# leftover CoreText notes — which no mpv flag can reach — are dropped by a stderr filter in
# run_mpv. Crucially the useful --term-osd-bar/AV status prints on STDOUT and the noise on
# STDERR, so filtering stderr never touches the progress bar. audio is immune (--no-video → no
# OSD); ascii uses --really-quiet. Rejected: --osd-level=0 (kills the noise but also the
# on-window OSD/OSC); --msg-level=all=error (blanks the status bar); OS_ACTIVITY_MODE=disable
# (does NOT stop CoreText). See ARCH-player.md「终端噪声压制」.
MPV_VIDEO_OPTIONS=(--msg-level=display-tags=warn,osd/libass=error --term-osd-bar)
# mpv docs suggest sw-fast/really-quiet for terminal VOs to reduce glitches and improve speed.
MPV_ASCII_OPTIONS=(--vo="${TING_ASCII_VO}" --profile=sw-fast --really-quiet --term-osd-bar)


# ==============================================================================
# 2. CORE HELPER FUNCTIONS
# ==============================================================================

usage() {
    # UNQUOTED heredoc: the two `default:` lines below report the EFFECTIVE default engine,
    # which comes from config (ARCHITECTURE.md「两个根数据文件」) and is not this file's to restate. Everything else in
    # this block is literal, so a `$` or a backtick meant as prose must be BACKSLASHED —
    # there are three of them today (the XDG path and two code spans).
    cat <<EOF
ting-play — the suite's one command-line entry: play, detached-playback lifecycle, and the
engine verbs (search, metadata, containers, captions, auth). It knows nothing about any one
site: an ENGINE (one file, ting-engine-<name>) holds everything about a site, and this file
forwards the engine verbs to it and plays what it resolves.

  ting-playlist  saved playlists       ting-history  the listening log
  ting        interactive terminal browser (pick + play)

A HANDLE is a URL or an engine media id (dQw4w9WgXcQ). Whether an id is well formed is the
engine's knowledge, not this file's, so a bad one fails as an extraction (2+), not usage (1).

Usage (everything after -- is the handle, so it may start with '-'):
  ting-play [-f mode] [--volume N] [-j] -- <id|URL>      play (blocks until done)
  ting-play -d [-f mode] [--volume N] [-j] -- <id|URL>   detached background playback
  ting-play --status [-j]                                list live detached players
  ting-play --stop [--id ID | --all] [-j]                stop one player (or all)
  ting-play --set-volume N [--id ID] [-j]                live volume on a detached player
  ting-play --pause | --resume [--id ID] [-j]            pause/resume a detached player
  ting-play --seek ±N | --seek-to N [--id ID] [-j]       seek (relative needs the sign)
  ting-play --watch [--id ID] [-j]                       follow a detached player: one
                                                         line per change, until it ends
  ting-play [--loop off|one] -d ... -- <id|URL>         repeat the track it is playing
  ting-play --set-loop off|one [--id ID] [-j]            turn repeat on/off while it plays
  ting-play -d --queue - [-j]                            play a QUEUE: items on stdin
  ting-play --enqueue - [--id ID] [-j]                   append to a running queue
  ting-play --next [--id ID] [-j]                        skip to the next queued track
  ting-play --queue-show [--id ID] [-j]                  the WHOLE queue, uncapped
  ting-play --queue-rm N --expect-url U [--id ID] [-j]   drop one waiting track
  ting-play --queue-mv N --to M --expect-url U [--id ID]
                                                         move one waiting track
  ting-play --queue-jump N --expect-url U [--id ID] [-j]
                                                         play one waiting track NOW
  ting-play --queue-clear [--id ID] [-j]                 drop every waiting track
  ting-play --undo --owner PID [--discard] [-j]          take back PID's last queue write
  ting-play --engines [-j]                               the installed engines, the file
                                                         each runs, and its engine flags
  ting-play (no handle, no action)                       usage error; use ting to browse

Engine verbs — forwarded to ting-engine-<engine> unchanged; that engine gates its own flags,
so a flag its site has no use for is refused (1), and --engines lists what each accepts:
  ting-play --search [--engine E] [-n N] [--min-duration S] [--max-duration S]
                     [--sort relevance|view_count|duration] [-j] -- <query>
  ting-play --feed <type> [--engine E] [-n N] [-j]       personalized/dynamic feed (e.g. home)
  ting-play --playlists [--engine E] [-n N] [-j]         user's online playlists under account
  ting-play --related [--engine E] [-n N] [-j] -- <id|URL>
                                                         related video recommendations
  ting-play --info [--engine E] [-j] -- <id|URL>         metadata, as a search row +
                                                         chapters
  ting-play --items [--engine E] [--cursor C] [-j] -- <container>
                                                         a playlist / album / channel /
                                                         a video's parts
  ting-play --transcript [--engine E] [--sub-lang L] [-j [--segments]] -- <id|URL>
                                                         captions or lyrics; --segments
                                                         keeps the timed cues in the envelope
  ting-play --auth [--engine E] [-j]                     the engine's cookie decision
  Engine modifier: --account ACC                         preferred account email or index
  Without --engine a URL picks its own engine (as a play does), anything else uses
  the default. -n counts what is FETCHED; the duration bounds shorten it.

Options:
  --engine N  Which engine a play or an engine verb goes to (default: $TING_DEFAULT_ENGINE;
              set TING_DEFAULT_ENGINE). The name is the file: --engine yt runs ting-engine-yt.
  --start SEC Open at SEC seconds instead of the beginning. Whole seconds, 0 or more.
              A handle carrying its own timestamp (…&t=601s) starts there on its own;
              this overrides it, and in a queue it applies to the first track only.
  --quality TIER  Quality tier: auto|low|medium|high (default: TING_PLAY_QUALITY / auto).
              The (mode, tier) -> format table lives in the engine
  -f MODE     Playback mode (default: audio)
              audio|ba  audio-only          video|bv  high-quality video+audio
              fast|fst  progressive video   ascii|asc terminal video (mpv terminal VO)
              viz|waves live audio visualizer (TING_VIZ_STYLE picks the picture)
              (-d rejects ascii/viz: a detached player has no terminal to draw on)
  --viz-color C  Visualizer color for -f viz: an ffmpeg color name (cyan, magenta, …),
              0xRRGGBB, or #RRGGBB (default: TING_VIZ_COLOR / cyan). In the CONFIG FILE
              only 0xRRGGBB works — there a # starts a comment. The gate checks the
              SHAPE, not the name: an unknown name reaches mpv and draws its default.
  --volume N  mpv startup volume, 0-100 (default: mpv's own). For -d this is the STARTING
              volume; change it live with --set-volume.
  --seek ±N   Seek N seconds RELATIVE to the playhead; the sign is required, because a bare
              number reads as relative to some callers and absolute to others. --seek-to N
              is the absolute spelling. Past the end is not an error: mpv clamps and the
              envelope reports where it actually landed.
  -j          JSON output: one-line status JSON for play/lifecycle (prose is the default)
  --queue -   Start a detached player on a QUEUE read from stdin, which is any of: a JSON
              array of items, a \`ting-playlist --show -j\` envelope, or a search envelope. An
              item is {engine, url, title?, duration?} — engine PER ITEM, so one queue can
              mix sources; --engine is only the fallback for an item without one. The first
              item starts playing and the rest wait. Each is resolved when it is reached,
              never up front: a stream URL expires (hours), so a queue resolved at enqueue
              time would 403 halfway down.
  --enqueue - Append the same shapes to a RUNNING player's queue.
  --next      Drop the current track and start the next one. Exit 4 when there is none.
  --queue-show  The whole queue, every item with the INDEX the four verbs below take. Not
              capped the way --status's tail is: that one projects every live player at
              once, this one was asked for by name.
  --queue-rm N    Drop the waiting track at index N.
  --queue-mv N --to M   Move the waiting track at N to position M. One verb for up-one,
              down-one and to-the-front, because they are one move with three arguments.
  --queue-jump N  Move the track at N to the front of the wait and START it, in one
              locked write — as two calls a track ending in between would skip it.
  --queue-clear   Drop every waiting track. The one playing keeps playing (--stop stops it).
  --owner PID     On --enqueue/--queue-rm/--queue-clear: keep a copy of the queue that
              --undo can put back, for 3 seconds, in PID's one slot (PID's next queue
              write replaces it). The envelope then carries undo.deadline (epoch seconds),
              and a busy queue lock fails the call (reason locked) instead of writing
              unlocked. Without it, no copy and no change.
  --undo          With --owner: restore the queue that copy was taken from — only if the
              queue is still byte-for-byte what the write left (a track boundary moves
              pos, so it will not be), else undo_stale and nothing changes.
  --discard       With --undo: drop the copy without restoring it (0 even if there is none).
  --expect-url U  REQUIRED by --queue-rm/--queue-mv/--queue-jump: the url that index held
              when you read it. An index into a queue is a guess about a moment — the
              player advances on its own — and a queue dies with its player, so a removal
              aimed by a stale index is not recoverable. Pass back the url --queue-show
              printed beside the index; if the two disagree nothing is written and the
              call fails with queue_stale.
              An index that IS current but names the playing track, or no track at all,
              fails with queue_range: only a WAITING track is a queue verb's business.
  -d          --detach: background playback; manage with --status/--stop/--set-volume/
              --pause/--resume/--seek/--enqueue/--next; follow it with --watch
  --watch     Stream a detached player's state until it ends: one line per change, never
              per frame. It follows the player across its queue, not one mpv.
  --engines   List every installed engine — a ting-engine-<name> file beside this file, in
              \$TING_ENGINE_DIR, or on PATH (first sight of a name wins) — with the file a
              call would run and the engine flags it accepts. Needs no jq; touches no state.
  --color M   auto|always|never (default: auto). No -c short form.
  -h          This help
  -V          Print the suite version (answered before any dependency check)

Long-only flags: --engine --detach --status --stop --set-volume --pause --resume --seek
                 --seek-to --watch --queue --enqueue --next --queue-show --queue-rm --queue-mv
                 --queue-jump --queue-clear --to --expect-url --id --all --engines --json
                 --color --viz-color, and every engine verb and modifier above but -n
                 --volume  (--help and --version also have short forms: -h, -V)

Output contracts (one line of JSON each; the why behind each shape: ARCH-cli-contract.md):
  play -j   {status, url, mode, exit_code, reason, retried}
            reason: forbidden|unavailable|format_unavailable|network|cookies|
                    stopped_by_user|unknown|null(ok)   (network also covers HTTP 429
                    rate limiting; cookies = the browser cookie store could not be read)
  -d -j     {status:"started", id, pid, url, mode, started_at, title, sock, log}
  --status  {status:"players", players:[{id,pid,url,engine,mode,volume,paused,position,
            duration,title,selected,selected_resolution,media,loop,started_at,queue,
            sock,log}],
            failed:[{id,url,engine,mode,started_at,ended_at,exit_code,reason}]}
            volume/paused/position/duration are read live off the player (null = could
            not ask); selected is the format the ENGINE picked, backfilled after the
            resolve (null until then), while media is what is ACTUALLY DECODING, read off
            the same socket: {video_codec,width,height,fps,video_bitrate,audio_codec,
            audio_bitrate,sample_rate,channels} — always present, each member null when the
            property does not apply (audio-only has no video_codec) or is not yet known;
            bitrates are bits per second and are demuxer estimates. engine and url
            together are the CALL that is playing (\`ting-play --engine E -- URL\`), and
            both follow the queue from track to track; sock/log are the same two paths
            -d -j hands back, so a caller that did not start the player (a TUI adopting
            one) can control it without rebuilding the state-dir layout; failed lists
            players that died on their own
  --stop    {status:"stopped", id, stopped} | {status:"stopped", scope:"all", stopped}
  --watch   one line per event (NDJSON), each the WHOLE --status player record plus
            {status:"watch", event, ready, cpu, mem}; exits 0 after the last line
            event: snapshot (first line of every connection, i.e. of every track) |
                   ready (sound started) | pause | resume | volume | seek |
                   heartbeat (the playhead crossed a whole second; none while paused) |
                   transitioning (+ ended: finished|interrupted|failed — the track that
                   just ended; the next one arrives as a snapshot) |
                   end (the player is gone; last known state + exit_code, reason from
                   its tombstone, both null when it finished or was stopped)
            cpu (percent) and mem (MB) are summed over the player's process group and
            sampled every 3rd heartbeat; null with TING_RESOURCE=0
  --set-vol {status:"ok", id, volume} | {status:"not_playing"} | {status:"ambiguous", …}
            | {status:"error", reason:"ipc_failed"}
  --pause   {status:"ok", id, paused:true|false}   (same not_playing/ambiguous/error shapes)
  --resume  as --pause
  --seek    {status:"ok", id, position:<seconds>}  position is READ BACK from mpv after the
  --seek-to seek, never computed — it is clamped at the ends and refused on a live stream
  --enqueue {status:"ok", id, added:<n>, queue:{pos,len,next,upcoming}}
  --next    {status:"ok", id, queue:{pos,len,next,upcoming}}
            | {status:"error", reason:"queue_empty"}
            queue is read back off the player's own queue file, never predicted. Every
            detached player has one (a lone handle is a queue of one), and --status carries
            the same object per player; \`next\` is null on the last track. \`upcoming\` is the
            same tail as a LIST — [{title,url,engine,duration}], at most $QUEUE_UPCOMING_MAX
            entries (\`len\` stays the honest total); upcoming[0] is \`next\` plus its duration.
  --queue-show {status:"ok", id, pos, len, items:[{index,engine,url,title,duration}]}
            Every item, in queue order, each carrying the index the rewrite verbs take.
            No per-item \`state\`: \`pos\` already names the one that is playing.
  --queue-rm   {status:"ok", id, removed:{index,url}, queue:{pos,len,next,upcoming}}
  --queue-mv   {status:"ok", id, moved:{index,to,url}, queue:{…}}
  --queue-jump {status:"ok", id, playing:{index,url}, queue:{…}}
  --queue-clear {status:"ok", id, cleared:<n>, queue:{…}}
            | {status:"error", reason:"queue_range"}   index/--to is not a WAITING track
            | {status:"error", reason:"queue_stale"}   --expect-url named a different track
            | {status:"error", reason:"locked"}        (--owner only) the queue lock was busy
            with --owner, the ok envelope adds undo:{deadline}
  --undo    {status:"ok", undone:<verb>, id, queue:{…}}
            | {status:"error", reason:"undo_none"|"undo_expired"|"undo_stale"|"locked"}
  --undo --discard {status:"ok", discarded:<bool>}
  --engines {status:"ok", engines:[{name, bin, flags}]}   discovery order; [] is an
            answer (exit 0), not a failure. bin is for diagnosis (which copy is in use), not
            for callers to run; flags are the engine verbs and modifiers it accepts ([] when
            it does not say). Prose: one "name<TAB>bin<TAB>flags" line each
  engine verbs  the engine's own envelope and exit code, passed through untouched
            \`queue\` is the same object --enqueue and --next publish, read back off the file
            after the write — never predicted from what the call asked for.

Exit codes: 0 ok · 1 usage/validation · 2+ a missing dependency or a propagated
            engine/mpv failure · 4 lifecycle call did not take effect (no such
            player / ambiguous / IPC failure)

Playback keys (mpv, during a blocking 'ting-play -- <handle>' playback):
  _  toggle video track on/off        q  stop playback and exit

Dependencies: mpv (playback) + jq; a unix-socket netcat — BSD/OpenBSD 'nc -U' or nmap's
              'ncat' — for every socket verb: --set-volume, --pause, --resume,
              --seek, --seek-to, --watch (the queue verbs need only jq); a ting-engine-<name>
              next to this file, in \$TING_ENGINE_DIR, or on PATH. yt-dlp / curl / cookies are
              the ENGINE's business, not the player's; an engine verb needs none of mpv, jq
              or nc from this file — only what that engine gates for itself.

Environment:
  Defaults for every knob below live in <checkout>/config, declared once for the whole
  suite. Override per user in \${XDG_CONFIG_HOME:-~/.config}/ting/config (KEY=value, one
  per line, # comments); TING_CONFIG relocates it. Chain: flag > environment > your
  config > the shipped defaults. See ARCH-cli-contract.md「配置面」.
  TING_DEFAULT_ENGINE  Engine used when --engine is not given (default: $TING_DEFAULT_ENGINE)
  TING_ENGINE_DIR      Extra directory searched for ting-engine-<name>, after this file's own
                       directory and before PATH. ENVIRONMENT ONLY — it names programs the
                       player runs, so neither config file can set it.
                       (default: \${XDG_DATA_HOME:-~/.local/share}/ting/engines)
  TING_HISTORY         0 stops a detached player writing to the listening log (default: on)
  TING_VIZ_STYLE       -f viz picture: bars (log-scaled spectrum) | wave (waveform)
                       (default: $TING_VIZ_STYLE)
  TING_ASCII_VO        mpv terminal video output driver (default: tct)
  TING_MPV_INPUT_CONF  Path to an optional custom mpv input.conf
EOF
}

err() {
    local red='' reset=''
    case "${COLOR_MODE:-auto}" in
    always)
        red=$'\033[31m'
        reset=$'\033[0m'
        ;;
    auto)
        if [[ -t 2 ]]; then
            red=$'\033[31m'
            reset=$'\033[0m'
        fi
        ;;
    never) ;;
    esac
    echo "${red}Error:${reset} $*" >&2
}

die() {
    err "$@"
    exit 1
}

# A missing tool is not a malformed call: `die` is exit 1 (the argv is wrong — fix it),
# `die_dep` is exit 2 (the argv was fine; the machine is missing something no rewrite of the
# argv will supply). An agent that read 1 here would loop editing its own parameters against
# a wall. docs/ARCH-cli-contract.md「退出码、TTY、依赖」.
die_dep() {
    err "required command not found: $1"
    exit 2
}

is_non_negative_int() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

# Does the CTYPE locale encode UTF-8? `--vo=tct` draws in HALF BLOCKS — one text row carries
# two pixel rows via U+2584 — so under a C/POSIX locale the terminal-rendering modes emit a
# character the encoding cannot carry, and the picture arrives as mojibake or as nothing.
#
# Read from the ENVIRONMENT rather than from `locale charmap`: mpv resolves its own CTYPE by
# the same three variables in the same order, so the answer is already here, and running one
# more command to learn what three variables say would be a dependency bought for nothing.
# Unset counts as not-UTF-8 — that is the C locale, which is exactly the cron/launchd case
# where this breaks. Spellings are enumerated rather than case-folded: the 3.2 floor has no
# lowercasing parameter expansion at all (docs/ARCHITECTURE.md「可移植性契约」 lists it).
locale_is_utf8() {
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8* | *utf-8* | *UTF8* | *utf8*) return 0 ;;
    *) return 1 ;;
    esac
}

# A SIGNED integer, sign REQUIRED. --seek is relative and mpv's own seek defaults to
# relative too, so a bare `--seek 30` reads as "+30" to every caller who did not check —
# and would be an absolute jump to second 30 if we guessed the other way. Neither guess is
# safe, so the sign is the contract and --seek-to is the absolute spelling.
is_signed_int() {
    [[ "$1" =~ ^[+-][0-9]+$ ]]
}

validate_enum() {
    local value=$1
    shift
    local allowed
    for allowed in "$@"; do
        if [[ "$value" == "$allowed" ]]; then
            return 0
        fi
    done
    return 1
}

require_cmd() {
    local cmd=$1
    command -v "$cmd" >/dev/null 2>&1 || die_dep "$cmd"
}

require_deps() {
    local cmd
    for cmd in "$@"; do
        require_cmd "$cmd"
    done
}

# ── The unix-socket client, resolved once ──────────────────────────────────────────────
# BSD/OpenBSD nc take -U; Debian's netcat-traditional and busybox nc do not, and on those
# systems nmap's ncat is the same primitive under its second name. Probed by CAPABILITY
# (' -U' in the -h text), never by version string — the flag either exists or it does not.
# ncat's -w bounds only the connect, so the idle backstop nc spells -w1 is spelled -i 1
# there; both ends of every read are still closed early by the callers' head/SIGPIPE.
# Resolved lazily and cached: a plain play never runs the probe (same reason the nc gate
# was lazy before this existed). Empty NC_UNIX after a failed resolve = no capable client.
NC_UNIX=()
resolve_nc_unix() {
    ((${#NC_UNIX[@]})) && return 0
    # CAPTURED, then matched — never `nc -h | grep -q`. Under pipefail that pipeline's status
    # is nc's, and BSD `nc -h` exits 1 after printing its usage, so the stock macOS client
    # was refused on every machine and only ever worked where nmap's ncat caught the fall.
    local nc_help=""
    command -v nc >/dev/null 2>&1 && nc_help=$(nc -h 2>&1 || true)
    # Whitespace either side, not a space: BSD indents its flag lines with a TAB.
    if [[ "$nc_help" =~ [[:space:]]-U[[:space:]] ]]; then
        NC_UNIX=(nc -U -w1)
    elif command -v ncat >/dev/null 2>&1; then
        NC_UNIX=(ncat -U -w 1 -i 1)
    else
        return 1
    fi
}

mpv_supports_vo() {
    local vo=$1
    mpv --vo=help 2>/dev/null | awk 'NR > 1 {print $1}' | grep -Fxq "$vo"
}


normalize_playback_mode() {
    case "$1" in
    audio | ba) echo "audio" ;;
    video | bv) echo "video" ;;
    fast | fst) echo "fast" ;;
    ascii | asc) echo "ascii" ;;
    viz | waves | wave) echo "viz" ;;
    *) die "-f must be one of: audio, video, fast, ascii, viz, waves, ba, bv, fst, asc, wave" ;;
    esac
}

# ==============================================================================
# 3. THE ENGINE SEAM & PLAYBACK PIPELINES
# ==============================================================================

# An engine is ONE executable per site, `ting-engine-<name>`. The player calls its --stream verb
# with a mode and a handle and gets an envelope back; it never learns what a format string
# is, whether cookies exist, or what a media id looks like on any given site. Name == file
# suffix is what makes this lookup a string concatenation instead of a name->command
# registry that the player and the TUI would each have to carry. Sibling first so a bare
# checkout runs with nothing on PATH, then PATH so an installed engine works from anywhere.
#
# `ting` carries a function of the SAME NAME with the OPPOSITE failure contract, and the
# split is deliberate. This one takes no argument (it reads $ENGINE), memoizes into a
# global, validates the name, and DIES: the player has exactly one job, so an engine it
# cannot find means there is nothing left to play. The TUI's takes the name as an argument,
# PRINTS the path, and returns non-zero silently — it asks for engine verbs it can live
# without (refresh_engine_auth drops the whole auth field when an engine has no --auth), so
# a die there would kill a working menu over an optional field. Merging them would cost one
# side or the other exactly that.
ENGINE_RESOLVE=""
# One gate for both spellings of the loop mode, because both take the same two values and a
# caller who guesses the third has guessed a REAL feature under the wrong flag — so the
# message routes them to it instead of just listing what is legal.
validate_loop_mode() {
    local val=$1 flag=$2
    validate_enum "$val" off one && return 0
    case "$val" in
    single | sequential | seq | all | list | repeat-one | one-repeat)
        die "$flag takes off or one (repeat the current track). Playing on to the NEXT track is a queue, not a loop mode: 'ting-play -d --queue -' (items on stdin)"
        ;;
    esac
    die "$flag must be off or one (got '$val')"
}

# WHERE A THIRD-PARTY ENGINE IS ALLOWED TO LIVE. Sibling, then the user's plugin dir, then
# PATH — the same three places, in the same order, that `ting` builds its registry from, and
# the two files have to agree or the TUI offers a source the player cannot open. The default
# chains through XDG_DATA_HOME, which is why it is inline here and not in the shipped
# `config`: a flat KEY=value file cannot express a chain (TING_STATE_DIR is the precedent).
# It is refused from BOTH config files — see the ting_read_config block above for why.
#
# The suite writes nothing here and does not create it; a checkout with no plugin dir loses
# one failed glob per lookup and nothing else.
TING_ENGINE_DIR="${TING_ENGINE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ting/engines}"

# Checks if string looks like an HTTP/HTTPS URL or well-known shortlink
is_url_target() {
    case "$1" in
    http://* | https://* | www.* | youtu.be/* | b23.tv/* | 163cn.tv/*) return 0 ;;
    esac
    return 1
}

# Extracts clean lowercase host from URL or host string
url_extract_host() {
    local h=$1
    h="${h#*://}"
    h="${h%%/*}"
    h="${h%%\?*}"
    h="${h%%#*}"
    h="${h##*@}"
    h="${h%%:*}"
    printf '%s' "$h" | tr 'A-Z' 'a-z'
}

# Matches host to known engine: yt | bili | ne
sniff_engine_from_url() {
    local host
    host=$(url_extract_host "$1")
    case "$host" in
    youtube.com | youtu.be | youtube-nocookie.com | \
    *.youtube.com | *.youtu.be | *.youtube-nocookie.com)
        printf 'yt'
        return 0
        ;;
    bilibili.com | b23.tv | \
    *.bilibili.com | *.b23.tv)
        printf 'bili'
        return 0
        ;;
    music.163.com | y.music.163.com | 163cn.tv | \
    *.music.163.com | *.163cn.tv)
        printf 'ne'
        return 0
        ;;
    esac
    return 1
}

engine_resolve_bin() {
    if [[ -n "$ENGINE_RESOLVE" ]]; then
        return 0
    fi
    # The name is pasted into a path, so it is validated as a NAME — not sanitised as a path.
    if [[ ! "$ENGINE" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
        die "invalid engine name: '$ENGINE'"
    fi
    ENGINE_RESOLVE=$(engine_file_bin "$ENGINE") ||
        die "unknown engine '$ENGINE': no 'ting-engine-$ENGINE' next to ting-play, in $TING_ENGINE_DIR, or on PATH"
    return 0
}

# An engine's one file, by name: sibling, then the plugin dir, then PATH. The lookup the
# player plays and forwards through AND the path --engines publishes, so what a caller is told
# it would run is what this file does run. Prints the path; non-zero and silent when there is
# none.
engine_file_bin() { # <name>
    if [[ -x "$SCRIPT_DIR/ting-engine-$1" ]]; then
        printf '%s\n' "$SCRIPT_DIR/ting-engine-$1"
    elif [[ -x "$TING_ENGINE_DIR/ting-engine-$1" ]]; then
        printf '%s\n' "$TING_ENGINE_DIR/ting-engine-$1"
    else
        command -v "ting-engine-$1" 2>/dev/null
    fi
}

# THE ENGINE REGISTRY, published: `--engines` answers which sources are installed and what each
# accepts, so no caller has to carry the rule below — a TUI runs `ting-play` and never learns
# that TING_ENGINE_DIR exists (PLAN-go-tui.md「未决」, decided 2026-09-25).
#
# All three places are always scanned and the first sight of a name wins, so a plugin dir
# cannot shadow a built-in. A name the player would refuse as `--engine` (the regex in
# engine_resolve_bin) is not listed: listing a source the player then refuses is the
# disagreement this verb exists to end. The path is engine_file_bin's, i.e. what a call would
# actually run, which for a name in two places is the higher-precedence copy.
ENGINE_NAMES=()
engines_scan_dir() {
    local dir=$1 f name e
    # No nullglob on 3.2: an unmatched glob is the pattern itself, and -x rejects it.
    for f in "$dir"/ting-engine-*; do
        [[ -x "$f" ]] || continue
        name=${f##*/ting-engine-}
        [[ "$name" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || continue
        for e in ${ENGINE_NAMES[@]+"${ENGINE_NAMES[@]}"}; do
            [[ "$e" == "$name" ]] && continue 2
        done
        ENGINE_NAMES+=("$name")
    done
    return 0
}

# Answered before every dependency gate, jq included: it is the question a caller asks before
# it knows what to run, and it touches nothing — no state dir, no socket. So the envelope is
# printf'd; a path is the only free text in it, and one holding a control character is
# skipped rather than escaped (no real install has one).
#
# CAPABILITIES ARE THE ENGINE'S TO STATE, asked with one fork each (`--capabilities -j`,
# about 25 ms). The answer is copied, not interpreted: its flags array is taken only when every
# member is a quoted flag word, so a malformed answer cannot put text of its own into this
# envelope. An engine that does not answer lists with flags [] — installed, claiming nothing.
json_path() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    printf '"%s"' "$s"
}
ENGINE_FLAGS_RE='^("-[-a-z0-9_]*"(,"-[-a-z0-9_]*")*)?$'
do_engines() {
    local d name bin caps flags sep="" out=""
    engines_scan_dir "$SCRIPT_DIR"
    engines_scan_dir "$TING_ENGINE_DIR"
    local saved_ifs=$IFS
    IFS=:
    for d in $PATH; do
        [[ -n "$d" && -d "$d" ]] && engines_scan_dir "$d"
    done
    IFS=$saved_ifs
    for name in ${ENGINE_NAMES[@]+"${ENGINE_NAMES[@]}"}; do
        bin=$(engine_file_bin "$name") || continue
        [[ "$bin" == *[[:cntrl:]]* ]] && continue
        caps=$("$bin" --capabilities -j 2>/dev/null </dev/null) || caps=""
        flags=""
        if [[ "$caps" == *'"flags":['*']'* ]]; then
            flags=${caps#*\"flags\":\[}
            flags=${flags%%\]*}
            [[ "$flags" =~ $ENGINE_FLAGS_RE ]] || flags=""
        fi
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            out+="$sep{\"name\":\"$name\",\"bin\":$(json_path "$bin"),\"flags\":[$flags]}"
        else
            flags=${flags//\"/}
            printf '%s\t%s\t%s\n' "$name" "$bin" "${flags//,/ }"
        fi
        sep=","
    done
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        printf '{"status":"ok","engines":[%s]}\n' "$out"
    elif [[ -z "$sep" ]]; then
        echo "no engines: need a ting-engine-<name> file beside ting-play, in $TING_ENGINE_DIR, or on PATH" >&2
    fi
    exit 0
}

# THE ENGINE VERBS, FORWARDED. ting-play is the one public entry, so searching, metadata,
# containers, captions and the cookie decision are asked of it — and answered by the engine,
# because they are site knowledge. The forward is an `exec` of `ting-engine-<name>` with the argv
# as given, less --engine: this file recognises only WHICH verb it is and which engine, so the
# flag gate exists once, inside the engine (a --sub-lang to an engine without captions, a -d
# next to --search, two verbs at once — each is the engine's refusal, exit 1). The envelope and
# the exit code are the engine's own, untouched, because nothing is left running to touch them.
#
# Called before argv parsing and before every dependency gate: searching must not need mpv
# installed. The internal verbs (--stream, --capabilities) are not in the table, so asked of
# ting-play they fall through to the ordinary unknown-flag refusal. Only argv ahead of `--` is
# looked at, so a query that happens to read `--info` is still a query.
#
# Without --engine, a URL handle picks its engine by host, exactly as a play does; a bare id
# or a query takes the default. ARCH-cli-contract.md「命令规格」.
forward_engine_verb() {
    local a verb="" engine="$TING_DEFAULT_ENGINE" specified=0 last="" bin sniffed
    for a in "$@"; do
        [[ "$a" == "--" ]] && break
        case "$a" in
        --search | --info | --items | --transcript | --auth | --feed | --related | --playlists) verb=$a; break ;;
        esac
    done
    [[ -n "$verb" ]] || return 0

    local fwd=()
    while (($#)); do
        case "$1" in
        --)
            fwd+=("$@")
            break
            ;;
        --engine)
            [[ $# -ge 2 ]] || die "--engine requires a value"
            engine=$2
            specified=1
            shift 2
            continue
            ;;
        --engine=*)
            engine=${1#*=}
            specified=1
            ;;
        # The one flag refused HERE: --raw is an engine's self-check against its site (the
        # unprojected record). Site fields cannot be versioned, so the one public entry does
        # not hand them out; -j is the contract, and --segments the transcript's full form.
        --raw) die "--raw is an engine self-check, not part of ting-play — use -j" ;;
        *) fwd+=("$1") ;;
        esac
        shift
    done
    last=${fwd[${#fwd[@]} - 1]}
    if ((! specified)) && [[ "$verb" != "--search" && "$verb" != "--feed" && "$verb" != "--playlists" ]] && is_url_target "$last"; then
        sniffed=$(sniff_engine_from_url "$last") || sniffed=""
        [[ -z "$sniffed" ]] || engine=$sniffed
    fi
    [[ "$engine" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "invalid engine name: '$engine'"
    bin=$(engine_file_bin "$engine") ||
        die "unknown engine '$engine': no 'ting-engine-$engine' next to ting-play, in $TING_ENGINE_DIR, or on PATH"
    exec "$bin" "${fwd[@]}"
}

# Out-params of resolve_media. Globals rather than a return value because bash 3.2 arrays do
# not survive command substitution — the same discipline reap_dead_players already uses.
# Together they are the ENTIRE vocabulary the playback path has for "what am I playing".
RESOLVED_URLS=()          # [0] = what mpv opens; [1] = its separate audio track, if any
RESOLVED_HEADER_ARGS=()   # ready-made --http-header-fields-append=... mpv flags
RESOLVED_MEDIA_ID=""      # the item's site id from the resolve envelope
RESOLVED_TITLE=""
RESOLVED_DURATION=""      # seconds, or "" for a live stream: read for the listening row only
RESOLVED_START=""         # where the HANDLE asked to start, or "" — the engine read it, not us
RESOLVED_HANDLE=""        # what was asked for: the queue moves, so the record must follow
RESOLVED_FORMAT=""        # the engine's format string: recorded verbatim, never read
RESOLVED_SELECTED=""      # …and what the engine says it PICKED, recorded the same way
RESOLVED_SELECTED_RES=""  # its resolution ("audio only" when there is no video)
RESOLVED_REASON=""        # on failure, the engine's own reason enum member
RESOLVED_RC=0

# Turn a handle into bytes by asking the engine. This ONE call replaces everything the
# player used to know about YouTube: the mode->format table, the cookie decision, and the
# proof-of-origin probe that picks a client which can actually fetch. Returns 0 with the
# RESOLVED_* globals filled, or the engine's own exit code with RESOLVED_RC/RESOLVED_REASON
# set. Callers must reach it through `|| rc=$?` (or `if !`), never bare under set -e.
resolve_media() {
    local handle=$1 mode=$2
    engine_resolve_bin

    RESOLVED_HANDLE="$handle"
    RESOLVED_URLS=()
    RESOLVED_HEADER_ARGS=()
    RESOLVED_MEDIA_ID=""
    RESOLVED_TITLE=""
    RESOLVED_DURATION=""
    RESOLVED_START=""
    RESOLVED_FORMAT=""""
    RESOLVED_SELECTED=""
    RESOLVED_SELECTED_RES=""
    RESOLVED_REASON=""
    RESOLVED_RC=0
    PLAYBACK_RETRIED=0

    # --quality is forwarded because the (mode, tier) -> format table is the engine's concept;
    # everything else the engine decides for itself (ARCH-player.md「模式 → 格式 → mpv」).
    local out rc=0
    out=$("$ENGINE_RESOLVE" --stream -j -f "$mode" \
        ${PLAY_QUALITY:+--quality "$PLAY_QUALITY"} -- "$handle" 2>/dev/null) || rc=$?

    if ((rc != 0)) || [[ -z "$out" ]]; then
        # An engine that exits 0 with nothing usable still failed a tool call, which the
        # taxonomy scores 2+, never 0. Its own `reason` is trusted when it sent one.
        RESOLVED_RC=$rc
        ((RESOLVED_RC == 0)) && RESOLVED_RC=2
        RESOLVED_REASON=$(printf '%s' "$out" | jq -r '.reason // empty' 2>/dev/null) || RESOLVED_REASON=""
        [[ -n "$RESOLVED_REASON" ]] || RESOLVED_REASON="unknown"
        return "$RESOLVED_RC"
    fi

    local u h
    while IFS= read -r u; do
        if [[ -n "$u" ]]; then RESOLVED_URLS+=("$u"); fi
    done < <(printf '%s' "$out" | jq -r '.stream_urls[]? // empty' 2>/dev/null)
    while IFS= read -r h; do
        if [[ -n "$h" ]]; then RESOLVED_HEADER_ARGS+=(--http-header-fields-append="$h"); fi
    done < <(printf '%s' "$out" | jq -r '(.http_headers // {}) | to_entries[] | "\(.key): \(.value)"' 2>/dev/null)

    if ((${#RESOLVED_URLS[@]} == 0)); then
        RESOLVED_RC=2
        RESOLVED_REASON="unknown"
        return 2
    fi

    RESOLVED_MEDIA_ID=$(printf '%s' "$out" | jq -r 'if (.id | type) == "string" or (.id | type) == "number" then (.id | tostring) else "" end' 2>/dev/null) || RESOLVED_MEDIA_ID=""
    RESOLVED_TITLE=$(printf '%s' "$out" | jq -r '.title // ""' 2>/dev/null) || RESOLVED_TITLE=""
    # Nothing in the PLAYBACK path wants this — mpv learns the length from the stream. It is
    # read for the listening row, where `seconds` alone cannot tell a track played through
    # from one abandoned at the third minute. Empty for a live stream, which has no length.
    RESOLVED_DURATION=$(printf '%s' "$out" | jq -r 'if (.duration | type) == "number" then (.duration | tostring) else "" end' 2>/dev/null) || RESOLVED_DURATION=""
    # Where the handle asked to start. Read as a NUMBER test rather than `// ""`, because
    # the answer 0 is real and different from "no offset": a link ending in ?t=0 says start
    # at the beginning, and `// ""` would throw that away along with null. The engine did
    # the site-specific reading (ARCH-engine.md「搜索子系统」) — here it is just a number.
    RESOLVED_START=$(printf '%s' "$out" | jq -r 'if (.start_seconds | type) == "number" then (.start_seconds | tostring) else "" end' 2>/dev/null) || RESOLVED_START=""
    RESOLVED_FORMAT=$(printf '%s' "$out" | jq -r '.format // ""' 2>/dev/null) || RESOLVED_FORMAT=""
    # The answer beside the request. Read for the same reason `format` is — so --status can
    # say what is playing rather than what was asked for — and read here rather than probed
    # later because the engine already spent the round trip that knows it.
    RESOLVED_SELECTED=$(printf '%s' "$out" | jq -r '.selected // ""' 2>/dev/null) || RESOLVED_SELECTED=""
    RESOLVED_SELECTED_RES=$(printf '%s' "$out" | jq -r '.selected_resolution // ""' 2>/dev/null) || RESOLVED_SELECTED_RES=""
    # The anonymous-client fallback is now the ENGINE's decision, so `retried` is relayed
    # rather than observed — but it is still the playback envelope's field (ARCH-cli-contract.md「数据契约」).
    if printf '%s' "$out" | jq -e '.retried == true' >/dev/null 2>&1; then
        PLAYBACK_RETRIED=1
    fi

    patch_player_meta
    return 0
}

# Backfill the player-record fields detach_play could not know at launch. This is what
# retired the old background title updater: that was a whole extra `yt-dlp --print title`
# round trip whose only job was to answer a question the resolve envelope already answers,
# held open in a detached background job whose fds had to be redirected so a capturing
# caller would not block on it. Here it is a jq call in a child that already has the data.
#
# Self-guarding exactly as the updater was: it patches ONLY while this pid still owns the
# state file, so a --stop during the resolve window wins and is never clobbered (jq emits
# nothing when the pid no longer matches, and the empty temp is dropped without touching the
# live file). Best-effort throughout — a failure leaves title:null, which callers tolerate.
patch_player_meta() {
    local id="${TING_PLAYER_ID:-}" sf tmp i
    if [[ -z "$id" ]]; then
        return 0
    fi

    # detach_play writes players/<id>.json AFTER launching this child, so a fast resolve can
    # arrive first. Bounded poll, not a fixed sleep: the ordinary case costs one stat.
    sf=$(player_state "$id")
    for ((i = 0; i < 50; i++)); do
        if [[ -f "$sf" ]]; then break; fi
        sleep 0.1
    done
    if [[ ! -f "$sf" ]]; then
        return 0
    fi

    tmp="$sf.tmp.$$"
    lock_player_state "$id" || true
    # `url` is patched too, not only backfilled: a player consuming a queue moves from track
    # to track, and a record still naming the first one would make --status describe
    # something that stopped playing ten minutes ago.
    if jq --arg t "$RESOLVED_TITLE" --arg f "$RESOLVED_FORMAT" --arg u "$RESOLVED_HANDLE" --arg p "$$" \
        --arg sel "$RESOLVED_SELECTED" --arg selres "$RESOLVED_SELECTED_RES" --arg eng "$ENGINE" \
        'if ((.pid | tostring) == $p)
         then .title = (if $t == "" then null else $t end)
              | .format = (if $f == "" then null else $f end)
              | .selected = (if $sel == "" then null else $sel end)
              | .selected_resolution = (if $selres == "" then null else $selres end)
              | .url = (if $u == "" then .url else $u end)
              | .engine = (if $eng == "" then .engine else $eng end)
         else empty end' \
        "$sf" >"$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
        mv -f "$tmp" "$sf"
    else
        rm -f "$tmp" 2>/dev/null || true
    fi
    unlock_player_state "$id"
    return 0
}

