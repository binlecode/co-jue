# Play the ALREADY-RESOLVED stream(s) with mpv. There is no ytdl_hook any more: the engine
# handed us direct URLs plus the headers they must be fetched with, so mpv is told
# --no-ytdl and never makes an extraction of its own. That closes the asymmetry where the
# LAST yt-dlp call in a play was one we did not make and could not classify — from here
# there is exactly one extraction and we made it. docs/ARCH-player.md「模式 → 格式 → mpv」.
#
# The media comes from the RESOLVED_* globals rather than arguments because bash 3.2 arrays
# do not survive command substitution; resolve_media sets them in place and every path into
# here runs after a successful resolve. Positional args are the caller's mode options.
run_mpv() {
    local mpv_cmd=(mpv --no-ytdl)

    # LAST POSSIBLE MOMENT, and that is the whole reason the read is here rather than at the
    # top of the child's queue loop: between the two lies a JIT resolve, i.e. seconds of
    # engine round trip during which a --set-loop would land on a record nobody reads again
    # until the track after next. Measured as exactly that hole — repeat turned on in the gap
    # between two tracks did not reach the track that was starting. A no-op off the detached
    # path (no TING_PLAYER_ID, no record), so a foreground play keeps the value its flag gave it.
    refresh_loop_mode

    # Optionally load caller-provided mpv input bindings.
    if [[ -n "$TING_MPV_INPUT_CONF" && -r "$TING_MPV_INPUT_CONF" ]]; then
        mpv_cmd+=(--input-conf="$TING_MPV_INPUT_CONF")
    fi

    # Launch-time volume. For a foreground/blocking session this is the only lever
    # (mpv's own volume keys work via the TTY); for detached playback it is just the
    # STARTING volume — live adjustment happens over the per-instance IPC socket
    # (see TING_IPC_SOCK below and do_set_volume). ARCHITECTURE.md「已知约束」.
    if [[ -n "$VOLUME" ]]; then
        mpv_cmd+=(--volume="$VOLUME")
    fi

    # Where to put the playhead at launch. Two sources, and --start wins: the flag is the
    # caller's per-request choice and the envelope's start_seconds is what the handle
    # carried, which is the suite's usual direction (flag beats everything below it).
    # `:-` rather than a test on emptiness, so a --start of 0 — "ignore the ?t= in this
    # link and play from the top" — is honoured instead of falling through to the engine.
    #
    # Beside --volume rather than among the mode options: those are last because mpv lets
    # the LAST occurrence win and they are overriding the ones before them. This one has
    # nothing to override, so it goes with the other launch-time settings.
    local start_at="${PLAY_START:-$RESOLVED_START}"
    if [[ -n "$start_at" ]]; then
        mpv_cmd+=(--start="$start_at")
    fi

    # REPEAT THE FILE, and the only mpv-side half of the loop contract: `one` is
    # loop-file=inf, `off` is mpv's own default. It goes here, among the launch-time
    # settings, because it has nothing to override — and it is set at LAUNCH as well as over
    # the socket because every track in a queue is a NEW mpv process (detached_child_loop),
    # so a value that lived only in the running process would evaporate at the first track
    # boundary. ARCH-player.md「循环」.
    if [[ "$LOOP_MODE" == "one" ]]; then
        mpv_cmd+=(--loop-file=inf)
    fi

    # Runtime control channel: only when launched under detach_play, which exports
    # TING_IPC_SOCK. mpv's --input-ipc-server is per-process, so each detached player
    # points at its own socket and is driven independently. A foreground/blocking
    # session has a real TTY and needs no IPC. ARCHITECTURE.md「已知约束」.
    if [[ -n "${TING_IPC_SOCK:-}" ]]; then
        mpv_cmd+=(--input-ipc-server="$TING_IPC_SOCK")
    fi

    # The headers the engine says these URLs must be fetched with — one of the two things
    # ytdl_hook used to do for free (it called mpv's set_http_headers itself). Repeated
    # `-append` rather than one comma-joined --http-header-fields: that option is a LIST,
    # so a header value containing a comma would be split into two broken headers.
    #
    # These land on mpv's argv and are therefore visible in `ps`. An engine must not return
    # a credential header (Cookie / Authorization) here; the YouTube engine returns only
    # User-Agent / Accept / Accept-Language / Sec-Fetch-Mode. ARCH-cli-contract.md「数据契约」
    if ((${#RESOLVED_HEADER_ARGS[@]})); then
        mpv_cmd+=("${RESOLVED_HEADER_ARGS[@]}")
    fi

    # ytdl_hook also set the media title from the extractor record; without it the OSD and
    # the window would read a googlevideo path. The resolve envelope already carries the
    # title, so hand it over rather than fetch it a second time.
    if [[ -n "$RESOLVED_TITLE" ]]; then
        mpv_cmd+=(--force-media-title="$RESOLVED_TITLE")
    fi

    # The third thing ytdl_hook did for free: when the chosen format merges a video-only and
    # an audio-only stream it built an EDL out of the pair. mpv joins them natively with
    # --audio-file, so the synthesis is one flag — element 0 is the video (the engine sorts
    # it first), element 1 its audio track.
    local media=("${RESOLVED_URLS[0]}")
    if ((${#RESOLVED_URLS[@]} > 1)); then
        media+=(--audio-file="${RESOLVED_URLS[1]}")
    fi

    # Detached playback has no terminal, so nobody ever reads mpv's status line — but mpv
    # keeps writing it into mpv-<id>.log anyway (~2.4 MB/h measured on a 24/7 stream, i.e.
    # unbounded growth in TMPDIR for exactly the long-lived players -d exists for). Silence
    # the cosmetic chatter there and keep error level, so the log stays small and still
    # explains a failure. These go AFTER the caller's mode options so they win (mpv: last
    # flag wins). ARCH-player.md「进程组模型」.
    local detached_opts=()
    if [[ -n "${TING_DETACHED:-}" ]]; then
        detached_opts=(--no-term-osd-bar --msg-level=all=error)
    fi

    # Execute mpv natively. The STDERR filter drops the macOS CoreText ".LastResort" notes
    # (no mpv flag reaches them) plus any residual libass fontselect warning that
    # emoji-titled video would otherwise flood (see MPV_VIDEO_OPTIONS). The useful
    # --term-osd-bar/AV status prints on STDOUT, so the progress bar is never touched; real
    # (non-noise) errors still pass through to >&2 for the -j classifier. Process
    # substitution (not a pipe) leaves $? as mpv's own exit code.
    #
    # It runs ONLY when a human is watching this terminal. Under -j the caller captures
    # stdout+stderr into a temp file that is never displayed, and a detached child writes to
    # its log — there the filter buys nothing and costs correctness: process substitution is
    # not waited on, so play_url_json (which reads the temp file the instant mpv exits) could
    # miss a late-flushed error line and classify a real 403 as `unknown`.
    if [[ -n "${TING_DETACHED:-}" ]]; then
        # BACKGROUND + `wait`, never foreground, and this is a bash 3.2 fact rather than a
        # style choice: 3.2 does not dispatch a trap while a FOREGROUND child runs. Measured
        # on 3.2.57 — a foreground `sleep 5` sent SIGUSR1 ran its trap five seconds later
        # and `sleep` still returned 0; `cmd & wait "$!"` entered the trap inside a second
        # and `wait` returned 158. So a --next delivered to a child playing mpv in the
        # foreground would mean "skip a track once this one is over", which is not a skip.
        # MPV_PID is what the signal handler kills; `wait` yields mpv's own status because
        # this branch execs nothing and substitutes no process.
        # A signal that landed while the ENGINE call was running would otherwise start the
        # very track it was meant to skip: the handler had no mpv to kill, and bash 3.2 only
        # ran the trap once that foreground call returned. Check before spending a play.
        if [[ -n "$CHILD_REASON" ]]; then
            return 0
        fi
        # WHEN THE TRACK ACTUALLY STARTED, for the listening row — recorded here rather
        # than around the play in the loop, because the loop's call also contains the engine
        # round trip (measured median 4.3s between tracks) and four seconds of resolve is not
        # four seconds of listening. One fork answers both fields. The loop clears them per
        # track, so an EMPTY epoch means mpv never opened and the row says 0 seconds instead
        # of billing the listener for a failed extraction.
        local started
        started=$(date -u +"%FT%TZ %s" 2>/dev/null) || started=""
        TRACK_STARTED_AT=${started%% *}
        TRACK_STARTED_EPOCH=${started##* }
        local wrc=0
        "${mpv_cmd[@]}" "$@" ${detached_opts[@]+"${detached_opts[@]}"} "${media[@]}" &
        MPV_PID=$!
        wait "$MPV_PID" || wrc=$?
        MPV_PID=""
        return "$wrc"
    fi
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        "${mpv_cmd[@]}" "$@" ${detached_opts[@]+"${detached_opts[@]}"} "${media[@]}"
    else
        "${mpv_cmd[@]}" "$@" "${media[@]}" 2> >(grep --line-buffered -vE 'CoreText note|\.LastResort|fontselect' >&2)
    fi
}


play_audio_url() {
    run_mpv "${MPV_AUDIO_OPTIONS[@]}"
}


play_video_url() {
    run_mpv "${MPV_VIDEO_OPTIONS[@]}"
}


play_ascii_url() {
    run_mpv "${MPV_ASCII_OPTIONS[@]}"
}

play_viz_url() {
    # Real terminal size via the ioctl. `$(tput cols)` can answer with terminfo's
    # default 80x24 inside command substitution (measured: 80 in a 60-column pane), which
    # would size the visualizer for a window that isn't there.
    local width height size sz
    sz=$(stty size </dev/tty 2>/dev/null || true)
    height=${sz%% *}
    width=${sz##* }
    [[ "$width" =~ ^[0-9]+$ ]] || width=$(tput cols 2>/dev/null || echo 80)
    [[ "$height" =~ ^[0-9]+$ ]] || height=$(tput lines 2>/dev/null || echo 24)
    # Cap size to prevent terminal lag
    if ((width > 120)); then width=120; fi
    if ((height > 30)); then height=30; fi
    # HEIGHT IS DOUBLED because --vo=tct draws in HALF BLOCKS (its default --vo-tct-algo):
    # one text row carries two pixel rows via ▄ with a foreground and a background colour.
    # Asking the filter for `rows` pixels hands mpv a frame it then upscales 2x vertically,
    # which cost the visualiser half its vertical detail for nothing. `rows * 2` is 1:1 with
    # what the pane can actually show. Verified in a real 120x30 tmux pane, not reasoned:
    # the glyph mpv emits is ▄. ARCH-player.md「终端可视化」
    size="${width}x$((height * 2))"

    # WHICH picture is taste, so it is a config key and not a flag (TING_VIZ_STYLE) — nobody
    # picks a visualiser style per track. The COLOUR beside it has both, and that asymmetry
    # is deliberate: it follows the pane this call draws on, not the taste of the person.
    # ARCH-player.md「终端可视化」. Both chains were measured at this geometry
    # (120x30 @ 15fps, 2026-08): mpv burns 0.5s of CPU per 10s of audio for the waveform and
    # 0.9s for the bars, against a 0.5s floor for decode alone, and --vo=tct itself costs
    # 0.02s — the terminal emulator eats the other end, ~300KB/s of truecolor escapes. So
    # the two differ by under 5% of one core and the choice is legibility, not price.
    # showcqt — the visualiser the ffmpeg community reaches for — is deliberately NOT here:
    # it lays out a fixed bar + axis + sonogram band sized for 1080p, and in 30 rows it
    # collapses to a black smear even when rendered large and downscaled. showspectrum is
    # out for a second reason: its default slide=scroll ignores r= and runs at the audio
    # frame rate, which measured 202MB of escape sequences for 10s against 3MB here.
    # ARCH-player.md「终端可视化」
    # One colour, and bars are fed a MONO downmix. Both filters draw every channel into the
    # same frame, and the overlap is additive: two channels in two colours came out white
    # wherever they agreed, which for a stereo mix is most of the picture. Downmixing before
    # showfreqs also makes the reading honest — one bar per terminal column, not two summed.
    local filter
    case "$TING_VIZ_STYLE" in
    bars) filter="aformat=channel_layouts=mono,showfreqs=s=${size}:mode=bar:ascale=log:fscale=log:colors=${VIZ_COLOR}:r=15" ;;
    *) filter="showwaves=s=${size}:mode=cline:colors=${VIZ_COLOR}:r=15" ;;
    esac

    run_mpv \
        --vo=tct \
        --lavfi-complex="[aid1]asplit[ao][v];[v]${filter}[vo]"
}

# Single mode-dispatch table for playback, shared by play_url_directly() (prose
# `yt <url>`) and play_url_json() (structured output). Kept as one function so the
# callers can never drift out of sync on which modes exist or what they print.
play_mode_url() {
    local url=$1
    local mode=$2

    case "$mode" in
    video)
        printf "Playing video: %s\n" "$url"
        play_video_url
        ;;
    fast)
        printf "Playing fast video: %s\n" "$url"
        play_video_url
        ;;
    ascii)
        printf "Playing ascii video: %s\n" "$url"
        play_ascii_url
        ;;
    viz)
        printf "Playing audio with live visualizer: %s\n" "$url"
        play_viz_url
        ;;
    *)
        printf "Playing audio: %s\n" "$url"
        play_audio_url
        ;;
    esac
}


# Prose entry (a blocking `ting-play <handle>`) and the detached child's own path. A resolve
# failure has no envelope to carry a reason here, so it goes to stderr carrying the
# machine-readable marker detached_epitaph reads back out of the log. It RETURNS rather than
# exits so the caller still gets to write that epitaph.
play_url_directly() {
    local url=$1
    if ! resolve_media "$url" "$PLAYBACK_MODE"; then
        echo "ting-play: ting-engine-$ENGINE could not resolve $url (yt_reason=$RESOLVED_REASON)" >&2
        return "$RESOLVED_RC"
    fi
    play_mode_url "$url" "$PLAYBACK_MODE"
}


# Map captured mpv output + exit code to the suite's stable reason taxonomy so an agent
# caller can branch on `reason` instead of string-matching raw player wording (which is not
# a contract and drifts across versions).
#
# This is the PLAYER's half of that job and it only knows mpv. The yt-dlp wordings — video
# unavailable, requested format, sign in to confirm — left with the extraction; they reach a
# caller as the ENGINE's own reason, replayed here from the marker play_url_directly logs
# rather than re-derived from prose. The ENUM is the shared fact (ARCH-cli-contract.md「数据契约」),
# and no member may appear here that it does not already have. `unknown` is the conservative
# default — we never guess a specific cause we didn't positively identify.
classify_playback_error() {
    local text=$1 rc=$2
    if ((rc == 130)); then
        echo "stopped_by_user"
        return
    fi
    # A resolve that failed was already classified, by the half of the suite that can read
    # extractor wording. Trust that verdict instead of guessing from the prose around it.
    if [[ "$text" =~ yt_reason=([a-z_]+) ]]; then
        echo "${BASH_REMATCH[1]}"
        return
    fi
    # mpv's own transport failure on a URL it was handed. 403 stays reachable here because
    # a signed media URL can expire or be refused between resolve and open.
    if grep -qiE 'HTTP Error 403|[^a-z]403[^0-9]|Forbidden' <<<"$text"; then
        echo "forbidden"
        return
    fi
    # 429 lands in `network`, not `unknown`: it is a transport-level, RETRYABLE refusal, and
    # `network` is the enum member that already means "try again later". Adding a
    # `rate_limited` member instead would grow a contract three verbs publish (ARCH-cli-contract.md「数据契约」) for no
    # branch a caller would take differently. It is grouped here rather than with `forbidden`
    # (403) deliberately — 403 means these credentials never work, 429 means not right now.
    if grep -qiE 'Temporary failure in name resolution|Failed to resolve|Name or service not known|Network is unreachable|Connection (refused|timed out|reset)|Could not connect|getaddrinfo|Timed out|Operation timed out|HTTP Error 429|Too Many Requests' <<<"$text"; then
        echo "network"
        return
    fi
    echo "unknown"
}


# The ONE place the playback envelope is written, so the mpv path and the resolve-failure
# path cannot drift on its shape.
emit_play_json() {
    local url=$1 mode=$2 rc=$3 status=$4 reason=$5
    local retried_json="false"
    if ((PLAYBACK_RETRIED)); then
        retried_json="true"
    fi
    jq -nc \
        --arg status "$status" \
        --arg url "$url" \
        --arg mode "$mode" \
        --argjson exit_code "$rc" \
        --arg reason "$reason" \
        --argjson retried "$retried_json" \
        '{status: $status, url: $url, mode: $mode, exit_code: $exit_code, reason: (if $reason == "" then null else $reason end), retried: $retried}'
}

# Opt-in structured playback (ting-play -j). Captures the player's stdout+stderr (suppressing
# its chatter) and emits exactly one final JSON line describing the outcome. rc 130 (user hit
# q/ctrl-c) is a normal stop, reported as status "ok" with reason "stopped_by_user". The real
# non-zero exit is still propagated so the process exit code stays truthful.
play_url_json() {
    local url=$1 mode=$2
    local tmp rc=0 status reason

    # A failed extraction is reported as the play's failure, with the engine's own reason:
    # there is no mpv output to classify because mpv was never launched.
    if ! resolve_media "$url" "$mode"; then
        emit_play_json "$url" "$mode" "$RESOLVED_RC" "error" "$RESOLVED_REASON"
        return "$RESOLVED_RC"
    fi

    # Keep the capture file inside the 0700 state dir: the mktemp-less fallback name is
    # predictable, and on Linux ${TMPDIR:-/tmp} is a shared world-writable directory.
    ensure_state_dir
    tmp=$(mktemp "$STATE_DIR/play.XXXXXX" 2>/dev/null) || tmp="$STATE_DIR/play.$$"

    play_mode_url "$url" "$mode" >"$tmp" 2>&1 || rc=$?

    if ((rc == 0)); then
        status="ok"
        reason=""
    elif ((rc == 130)); then
        status="ok"
        reason="stopped_by_user"
    else
        status="error"
        reason=$(classify_playback_error "$(cat "$tmp" 2>/dev/null)" "$rc")
    fi
    rm -f "$tmp"

    emit_play_json "$url" "$mode" "$rc" "$status" "$reason"

    ((rc == 130)) && return 0
    return "$rc"
}

# A detached playback is tracked by its PROCESS GROUP, not a PID tree. The child bash
# is launched as its own process-group leader (see detach_play), so its pgid == its
# pid, and every descendant it forks — the engine's own yt-dlp/curl, and mpv — inherits
# that pgid. This is what a PID-tree
# walk cannot handle: a late-spawned mpv appears after any one-time snapshot, and once
# bash exits the mpv reparents to init (ppid=1) so it is no longer findable by parentage.
# The pgid is invariant under reparenting, so group operations always reach it.
# pgrep -g / kill -<pgid> are available on macOS and Linux.

# A PID READ BACK FROM DISK IS UNTRUSTED INPUT, and one value must never reach pgrep or
# kill: 0 is a WILDCARD in both. `pgrep -g 0` matches the CALLER's own process group
# (measured on macOS: it returns the shell asking the question), so an unchecked
# `group_alive 0` is permanently true, and the `kill -TERM 0` / `kill -KILL -0` that
# follows broadcasts to that same group — this process, the shell that ran it, and the
# terminal's whole foreground group, in place. A player record whose pid never got written,
# lost a race, or was truncated therefore does not end one playback, it ends the session.
# Negative values are kill's explicit group form and would let a record name any group at
# all; non-numeric text pgrep rejects on its own but has no business here either. So the
# gate is a positive integer or nothing, asked once, of every path that signals: reaping and
# --stop reach it through group_alive, stop_group re-asks because it is the one that
# broadcasts, and --next's USR1 (whose default disposition is terminate, so pid 0 is lethal
# there too) asks at its own call site.
is_live_pid() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]
}

# True if any process in group $pgid is still alive.
group_alive() {
    local pgid=${1:-}
    is_live_pid "$pgid" && [[ -n "$(pgrep -g "$pgid" 2>/dev/null)" ]]
}

# Stop the whole process group: SIGINT (mpv treats it as a clean stop, like q), wait
# briefly for graceful exit, then SIGKILL any survivor. Negative PID targets the group.
stop_group() {
    local pgid=$1
    # Asked again here rather than trusted from the caller: two of the three call sites come
    # through group_alive and the third hands over its own `$!`, but this is the function
    # that broadcasts, and a future fourth caller must not be able to reintroduce the group
    # wildcard by forgetting a check that lives somewhere else (see is_live_pid).
    is_live_pid "$pgid" || return 1
    # The LEADER is told by SIGTERM and everything else in the group by SIGINT: mpv treats
    # INT as the clean stop `q` is, and the child is told by name so a --stop ends a QUEUE
    # rather than the one track playing out of it.
    #
    # BOTH ARE TRAPPED IN THE CHILD, and that is not the belt-and-braces it looks like. bash
    # sets SIGINT to SIG_IGN in an asynchronous child ONLY when job control is off, and
    # detach_play launches under `set -m` — measured on 3.2.57, the same child with and
    # without monitor mode: with it, `trap … INT` fires and `wait` returns 130; without it,
    # a group INT does not reach the child at all. So an UNtrapped INT here is a plain kill,
    # and the child that took a TERM a microsecond earlier dies inside its own handler.
    # Measured before the INT was added to that trap: three --stop runs out of three left no
    # listening row at all, because the handler never reached its first line.
    # THE FIRST TICK IS TERM ALONE, and the 0.2s before the INT joins it is the child's
    # whole opportunity to say what happened. Measured on 3.2.57: TERM alone reaches the
    # handler every time and so does a group INT alone, but the two delivered back to back —
    # which is what this function used to do — kill the child BETWEEN them, before its handler
    # runs a single line. It cost the listening row of whichever player was signalled first
    # (0 rows out of 2 for `--stop --all`, reproducibly) and it was invisible before there was
    # a row to lose: the child was going to die anyway, and dying one way rather than the
    # other left no trace. mpv does not need this tick — the child's own handler kills it —
    # and neither does a straggler yt-dlp, which gets the INT 200ms later like everything else.
    kill -TERM "$pgid" 2>/dev/null || true

    # Say it AGAIN on every tick, because the group is not a fixed set. The child spends the
    # gap between two tracks inside an ENGINE call, and that call spawns fresh processes as it
    # goes (yt-dlp, then its anonymous retry, then curl for the probe): one started a
    # millisecond after the first signal never saw it, and while it runs the child's own TERM
    # trap cannot run either — bash 3.2 does not dispatch a trap while a foreground command
    # is running. One late straggler is therefore enough to make a --stop wait out the whole
    # escalation, and the repeat costs nothing: both signals are idempotent here (the child's
    # handler is, since `stopped` is final in child_signal).
    local i
    for ((i = 0; i < 15; i++)); do
        group_alive "$pgid" || return 0
        sleep 0.2
        kill -TERM "$pgid" 2>/dev/null || true
        kill -INT -"$pgid" 2>/dev/null || true
    done

    kill -KILL -"$pgid" 2>/dev/null || true
}

# Create the per-user state dir (and the players/ dir under it) with a pinned 0700 mode.
# SECURITY: 0700 so no other local user can traverse in and connect to a player's IPC
# socket (a control channel — a peer could drive mpv). macOS $TMPDIR is already per-user;
# the /tmp fallback (Linux) is world-traversable at umask 022, so pin the mode explicitly
# on both dirs. `mkdir -p -m 700` only applies the mode to dirs it actually creates, so the
# chmod re-asserts it on both; idempotent and cheap (two syscalls), deliberately re-run on
# every use as a safety net rather than trusting the mode was never widened after creation.
ensure_state_dir() {
    mkdir -p -m 700 "$PLAYERS_DIR" 2>/dev/null || true
    chmod 700 "$STATE_DIR" "$PLAYERS_DIR" 2>/dev/null || true
}

# Live property read straight off a player's IPC socket. The state file's `volume` is only
# what was recorded at launch or by the last --set-volume, so anything driving the socket
# directly (ting's 9/0 keys — see ARCH-player.md「运行时 IPC」) moves the real value without
# telling us; mpv is the source of truth. `pause` and the playback position are worse still:
# the state file has never held them at all.
#
# ONE connection carries every property asked for — that is why this is a property list and
# not four calls: --status pays the same single round trip it always did (~10ms measured; a
# healthy mpv closes as soon as the reader breaks, so the -w1 timeout is never reached).
# Soft-gated on the socket client so --status keeps working with jq alone
# (ARCH-cli-contract.md「退出码」): no capable nc/ncat, no socket, no output, and the caller
# reports nulls.
#
# Emits one "<request_id><US><value>" line per answer, in whatever order mpv sent them —
# correlation is the CALLER's job and must be by request_id, never by line order: mpv
# multiplexes async events into every client's stream (the rule do_set_volume already
# carries). `\(.data)` stringifies a JSON null as the four characters "null", so a property
# the player answered null keeps its slot and stays distinguishable from one it never
# answered at all. `|| true` guards the pipeline: under set -euo pipefail an nc timeout or a
# SIGPIPE from the caller breaking early is a non-zero status that would abort the script.
#
# `head -n $i` is load-bearing, not tidiness — it is what CLOSES the pipe. mpv answers every
# command exactly once and jq has already dropped the id-less async events, so the i-th line
# is the last one coming; head exiting there SIGPIPEs nc, which is how the read ends against a
# peer that never closes its side, instead of waiting out the full `nc -w1` second. Kept as
# DEFENCE, not as a measured win: the 1.11s -> 0.03s figure came from a scripted test peer that
# has since been deleted, and against real mpv the same read costs 0.04s with head or with a
# bare `cat` (measured 2026-08-24), so no check in tests/ can go red on this line. The caller
# breaking its own read loop does NOT achieve it either: nothing writes again to notice.
live_props() {
    local sock=$1
    shift
    resolve_nc_unix || return 0
    [[ -S "$sock" ]] || return 0
    local prop i=0
    local reqs=()
    for prop in "$@"; do
        i=$((i + 1))
        reqs+=("$(printf '{"command":["get_property","%s"],"request_id":%d}' "$prop" "$i")")
    done
    ((${#reqs[@]})) || return 0
    printf '%s\n' "${reqs[@]}" |
        "${NC_UNIX[@]}" "$sock" 2>/dev/null |
        jq -r --unbuffered 'select(.request_id != null) | "\(.request_id)\u001f\(.data)"' 2>/dev/null |
        head -n "$i" || true
}

# The policy half of the read above, shared by both --status output modes so the correlation
# and the normalisation exist once. Sets thirteen globals, each EMPTY when the player did not
# answer (no nc, dead socket, property null) — empty becomes JSON null at the call site, and
# the distinction matters: `false` means "playing", null means "could not ask".
#
# THE MEDIA FACTS (LP_VCODEC..LP_CHANNELS) RIDE A ROUND TRIP WE WERE MAKING ANYWAY. What is
# actually decoding — codec, geometry, bitrate, sample rate — is a question only the player
# can answer, and until now nothing in the suite asked it: the record's `selected` is the
# format string the ENGINE picked ("251 - audio only (medium)"), which is the request, not
# the answer. A stream can be renegotiated, a merge can fail back to progressive, and an
# engine's format id says nothing about what the decoder ended up with. Nine more
# get_property lines on the ONE connection live_props already opens is the whole cost; a
# second connection, or a yt-dlp call to re-derive them, would not be.
#
# Every one of them is legitimately null on a normal player, which is why none is an error:
# an audio-only track has no video-format/width/height (measured 2026-09-04, mp3 via the ne
# engine: all four unavailable), and `video-bitrate` is a demuxer ESTIMATE that is simply
# absent on some streams even while video decodes — measured on the same date, mpv 0.41
# answered `property unavailable` for a merged AV1+opus YouTube stream eight seconds in
# while width/height/container-fps all answered. A null here means "not applicable or not
# yet known", never "the player is broken".
LP_VOLUME=""
LP_PAUSED=""
LP_POSITION=""
LP_DURATION=""
LP_VCODEC=""
LP_WIDTH=""
LP_HEIGHT=""
LP_FPS=""
LP_VBITRATE=""
LP_ACODEC=""
LP_ABITRATE=""
LP_SAMPLERATE=""
LP_CHANNELS=""
read_player_live() {
    local sock=$1 rid val got=0 seen=0
    LP_VOLUME=""
    LP_PAUSED=""
    LP_POSITION=""
    LP_DURATION=""
    LP_VCODEC=""
    LP_WIDTH=""
    LP_HEIGHT=""
    LP_FPS=""
    LP_VBITRATE=""
    LP_ACODEC=""
    LP_ABITRATE=""
    LP_SAMPLERATE=""
    LP_CHANNELS=""
    # Breaking on the last answer is what keeps a WEDGED player cheap: a peer that never
    # closes its side would otherwise charge the full `nc -w1` second per player. `seen`
    # bounds the loop so a chatty one cannot hold --status open either. An UNAVAILABLE
    # property still answers (data null), so `got` reaches the full count on an audio-only
    # track too — the break is not waiting on video that will never arrive.
    while IFS=$'\037' read -r rid val; do
        seen=$((seen + 1))
        case "$rid" in
        1) LP_VOLUME="$val"; got=$((got + 1)) ;;
        2) LP_PAUSED="$val"; got=$((got + 1)) ;;
        3) LP_POSITION="$val"; got=$((got + 1)) ;;
        4) LP_DURATION="$val"; got=$((got + 1)) ;;
        5) LP_VCODEC="$val"; got=$((got + 1)) ;;
        6) LP_WIDTH="$val"; got=$((got + 1)) ;;
        7) LP_HEIGHT="$val"; got=$((got + 1)) ;;
        8) LP_FPS="$val"; got=$((got + 1)) ;;
        9) LP_VBITRATE="$val"; got=$((got + 1)) ;;
        10) LP_ACODEC="$val"; got=$((got + 1)) ;;
        11) LP_ABITRATE="$val"; got=$((got + 1)) ;;
        12) LP_SAMPLERATE="$val"; got=$((got + 1)) ;;
        13) LP_CHANNELS="$val"; got=$((got + 1)) ;;
        *) ;; # an async event; not one of ours
        esac
        ((got >= 13 || seen >= 32)) && break
    done < <(live_props "$sock" volume pause time-pos duration \
        video-format width height container-fps video-bitrate \
        audio-codec-name audio-bitrate audio-params/samplerate audio-params/hr-channels)
    # mpv answers with floats (100.000000, 83.437000); report integers, the unit the rest of
    # the contract speaks — --set-volume takes one, and the search envelope's `duration` is
    # integer seconds. A value that is not a number (including the literal "null") is dropped.
    [[ "$LP_VOLUME" =~ ^[0-9]+ ]] && LP_VOLUME="${LP_VOLUME%.*}" || LP_VOLUME=""
    [[ "$LP_POSITION" =~ ^[0-9]+ ]] && LP_POSITION="${LP_POSITION%.*}" || LP_POSITION=""
    [[ "$LP_DURATION" =~ ^[0-9]+ ]] && LP_DURATION="${LP_DURATION%.*}" || LP_DURATION=""
    [[ "$LP_PAUSED" == "true" || "$LP_PAUSED" == "false" ]] || LP_PAUSED=""
    # Same rule for the numeric media facts, and it is the ONE guard that matters here: the
    # literal string "null" would otherwise reach --argjson and be a valid JSON null by
    # accident on some fields and a parse error on none — an accident is not a contract.
    # fps keeps its fraction (29.97 is not 29) but loses mpv's six-digit tail.
    [[ "$LP_WIDTH" =~ ^[0-9]+ ]] && LP_WIDTH="${LP_WIDTH%.*}" || LP_WIDTH=""
    [[ "$LP_HEIGHT" =~ ^[0-9]+ ]] && LP_HEIGHT="${LP_HEIGHT%.*}" || LP_HEIGHT=""
    [[ "$LP_VBITRATE" =~ ^[0-9]+ ]] && LP_VBITRATE="${LP_VBITRATE%.*}" || LP_VBITRATE=""
    [[ "$LP_ABITRATE" =~ ^[0-9]+ ]] && LP_ABITRATE="${LP_ABITRATE%.*}" || LP_ABITRATE=""
    [[ "$LP_SAMPLERATE" =~ ^[0-9]+ ]] && LP_SAMPLERATE="${LP_SAMPLERATE%.*}" || LP_SAMPLERATE=""
    if [[ "$LP_FPS" =~ ^[0-9]+\.?[0-9]* ]]; then
        LP_FPS=$(printf '%.2f' "$LP_FPS" 2>/dev/null) || LP_FPS=""
        # A whole-number rate reads as 30, not 30.00 — the two decimals exist for 29.97.
        [[ "$LP_FPS" == *.00 ]] && LP_FPS="${LP_FPS%.00}"
    else
        LP_FPS=""
    fi
    # The string fields carry mpv's own vocabulary (h264 / av1 / opus / mp3 / stereo) and are
    # NOT normalised: renaming a codec here would put a second spelling of the decoder's own
    # answer in the contract, and the caller who cares about codecs already knows these names.
    [[ "$LP_VCODEC" == "null" ]] && LP_VCODEC=""
    [[ "$LP_ACODEC" == "null" ]] && LP_ACODEC=""
    [[ "$LP_CHANNELS" == "null" ]] && LP_CHANNELS=""
    return 0
}

# The media half of read_player_live as ONE JSON object, built where the globals are, so
# both --status arms and any future reader share the null policy instead of restating it.
# ALWAYS an object, never null: `media` present with nine null members says "asked, nothing
# to report", and a caller that has to distinguish an absent key from an absent value is a
# caller we made work for nothing (the same argument `failed:[]` is built on).
LP_MEDIA_JSON='{}'
media_json() {
    LP_MEDIA_JSON=$(jq -nc \
        --arg vcodec "$LP_VCODEC" --arg acodec "$LP_ACODEC" --arg channels "$LP_CHANNELS" \
        --argjson width "${LP_WIDTH:-null}" --argjson height "${LP_HEIGHT:-null}" \
        --argjson fps "${LP_FPS:-null}" \
        --argjson video_bitrate "${LP_VBITRATE:-null}" \
        --argjson audio_bitrate "${LP_ABITRATE:-null}" \
        --argjson sample_rate "${LP_SAMPLERATE:-null}" \
        '{video_codec: (if $vcodec == "" then null else $vcodec end),
          width: $width, height: $height, fps: $fps, video_bitrate: $video_bitrate,
          audio_codec: (if $acodec == "" then null else $acodec end),
          audio_bitrate: $audio_bitrate, sample_rate: $sample_rate,
          channels: (if $channels == "" then null else $channels end)}') ||
        LP_MEDIA_JSON='{"video_codec":null,"width":null,"height":null,"fps":null,"video_bitrate":null,"audio_codec":null,"audio_bitrate":null,"sample_rate":null,"channels":null}'
    return 0
}

# The last thing a DETACHED child says, written to its own stdout — i.e. as the final line
# of the log the launch envelope already handed the caller. Without it a detached player that
# dies leaves nothing behind at all: `-d -j` returned {"status":"started"} + exit 0 long
# before the failure, reap_dead_players then deletes the record AND the log, and `--status`
# goes empty — indistinguishable from a track that simply finished. The reaper cannot fill
# that gap on its own: it has no exit code, and "played fine" and "failed for a reason we do
# not recognise" are the same text in a log (classify_playback_error answers `unknown` to
# both). The child is the only process that knows rc, so the child writes the epitaph.
#
# Nothing is written on success, so a normal finish leaves no trace here — this is an ERROR
# record, and the listening log is the other side of that line, not a duplicate of it
# (history_record, and ARCH-player.md「状态机」's separation rule): failures only, bounded, in
# $TMPDIR, gone at the reboot, against every track and durable in the user-level store. A
# player told to --stop reaches this line with rc 0 and writes nothing, which is the same
# distinction from the other direction: a stop is not a failure.
# ------------------------------------------------------------------------------
# The detached child: one player, one queue
# ------------------------------------------------------------------------------
# detach_play re-execs this script with TING_PLAYER_ID set; this is what that re-exec runs. A
# player plays a QUEUE, and a lone handle is a queue of one, so there is one loop rather than
# two paths.
#
# CHILD_REASON is the second rule the queue turns on (the first is run_mpv's background
# `wait`): THE REASON A TRACK ENDED COMES FROM THIS VARIABLE, never from mpv's exit code.
# Measured on mpv 0.41: a normal finish is 0 and an interrupted one is 4 — man mpv,
# "4 = Quit due to a signal" — one code covering "--next killed it", "--stop killed it" and
# "the user killed it" alike. The handler sets the reason BEFORE it kills mpv, so the epitaph
# describes what happened instead of guessing. A sentinel FILE was considered and rejected:
# that is another lock, and it would let the death record lie in a new way.
CHILD_REASON=""
MPV_PID=""
# Set by run_mpv the instant mpv is launched, cleared by the loop before every play, so
# "mpv never opened" is representable instead of inferred from the previous track's clock.
TRACK_STARTED_AT=""
TRACK_STARTED_EPOCH=""
child_signal() {
    # STOPPED IS FINAL. Both signals can be pending at once — bash 3.2 defers a trap while a
    # foreground command runs, and the engine call between two tracks IS such a command — and
    # the order the pending handlers then run in is not ours to pick. Letting a late `next`
    # overwrite `stopped` restarts the loop on a player that was told to die, and it plays on
    # until stop_group's KILL escalation: measured at 3.5s (3/3) against 0.37s once this line
    # existed, for `--next; --next mid-resolve; --stop`.
    [[ "$CHILD_REASON" == "stopped" ]] && return 0
    CHILD_REASON=$1
    if [[ -n "$MPV_PID" ]]; then
        kill "$MPV_PID" 2>/dev/null || true
    fi
    return 0
}

# The loop mode is the PLAYER's state and lives on disk, so the child re-reads it rather
# than remembering the flag it was launched with: --set-loop writes that file from ANOTHER
# process, and a child holding its launch value would keep replaying the track the user
# turned repeat off on (or drop the repeat they turned on) at the next boundary. Silent on
# every failure, keeping the value in hand: the first track can arrive before detach_play
# has written the record at all (the race patch_player_meta already polls through).
refresh_loop_mode() {
    local sf v
    [[ -n "${TING_PLAYER_ID:-}" ]] || return 0
    sf=$(player_state "$TING_PLAYER_ID")
    [[ -f "$sf" ]] || return 0
    v=$(jq -r '.loop // empty' "$sf" 2>/dev/null) || return 0
    case "$v" in
    off | one) LOOP_MODE="$v" ;;
    esac
    return 0
}

detached_child_loop() {
    local handle=$1 rc=0 played=0
    # SIGUSR1 is --next's channel; TERM and INT are both --stop's, because stop_group sends
    # the child one of each (mpv gets the INT too, which is how it stops cleanly). CATCHING
    # THE INT IS LOAD-BEARING, not defensive: untrapped it is a plain kill arriving while the
    # TERM handler runs, and the child dies before it can say what happened — no listening
    # row, and the reason a track ended lost with it. The measurement, and why the "an async
    # child cannot trap INT" rule does not apply under `set -m`, are in stop_group.
    trap 'child_signal next' USR1
    trap 'child_signal stopped' TERM INT

    if [[ ! -f "$(player_queue "${TING_PLAYER_ID:-}")" ]]; then
        # No queue file: an older parent, or someone running this child by hand. Play the
        # handle once, exactly as this path did before queues existed.
        rc=0
        TRACK_STARTED_AT=""
        TRACK_STARTED_EPOCH=""
        play_url_directly "$handle" || rc=$?
        history_record "$handle" "$ENGINE" "$rc" "$RESOLVED_MEDIA_ID" "$RESOLVED_TITLE"
        detached_epitaph "$rc"
        exit "$rc"
    fi

    while :; do
        queue_current "$TING_PLAYER_ID" || break
        played=$QUEUE_POS
        # A queue may mix engines (a playlist can), so the engine is per ITEM and the
        # resolved-binary cache has to be dropped with it.
        ENGINE=$QUEUE_ENGINE
        ENGINE_RESOLVE=""
        CHILD_REASON=""
        TRACK_STARTED_AT=""
        TRACK_STARTED_EPOCH=""
        rc=0
        play_url_directly "$QUEUE_URL" || rc=$?
        # --start is a one-shot launch intent ("pick it up from here"), not a queue-wide
        # policy — nobody wants every track in a list to skip its first ten minutes. Cleared
        # here rather than in either branch of the case below, so a SKIPPED first track
        # spends it too: --next means the caller moved on from the track the offset was
        # about. Each item's OWN ?t= is unaffected — that arrives through RESOLVED_START,
        # which resolve_media refills per track.
        PLAY_START=""
        # BEFORE the case, because two of its three branches leave the loop or skip the rest
        # of the body: a row is owed for a stopped track and a skipped one exactly as much as
        # for one that played out. This is the line that keeps the log from becoming a record
        # of what went uninterrupted.
        history_record "$QUEUE_URL" "$ENGINE" "$rc" "$QUEUE_ID" "$QUEUE_TITLE"
        case "$CHILD_REASON" in
        stopped)
            # --stop already took the process group down. Leave WITHOUT an epitaph, which is
            # what makes a stopped player produce no tombstone (record_player_death) — that
            # rule predates queues and is not this loop's to change.
            rc=0
            break
            ;;
        next)
            # The parent moved pos before it signalled, so the top of the loop already reads
            # the track it chose. Nothing to advance, and a skip is not a failure.
            rc=0
            continue
            ;;
        esac
        # A JIT resolve turns an N-item queue into N chances for an upstream to be having a
        # bad minute, so one failure ADVANCES the queue instead of killing the player —
        # otherwise yt-dlp's availability is welded to the player's lifetime. No retry
        # either: a retry is the gap between tracks, doubled.
        #
        # ADVANCE FIRST, then decide whether the track needs a tombstone. When the queue is
        # exhausted the PLAYER is what died, and the parent writes that record from the
        # epitaph in the log (record_player_death); writing one here as well reports a single
        # failure twice — measured, before this order: a bad handle produced both <id> and
        # <id>-q0 in failed[].
        queue_advance_from "$TING_PLAYER_ID" "$played" || break
        if ((rc != 0)); then
            queue_note_failure "$TING_PLAYER_ID" "$played" "$QUEUE_URL" "$rc"
        fi
    done

    # The exit status is the LAST track's, which is also the whole player's when the queue
    # held one item — the pre-queue behaviour, unchanged.
    detached_epitaph "$rc"
    exit "$rc"
}

detached_epitaph() {
    local rc=$1 reason ended_at
    [[ -n "${TING_DETACHED_LOG:-}" ]] || return 0
    ((rc == 0 || rc == 130)) && return 0
    # Same taxonomy every other surface publishes (ARCH-cli-contract.md「数据契约」) — the reason a caller branches on
    # must not depend on which verb produced it. The tail bound keeps a long mpv log from
    # becoming an argument the classifier has to grep in full.
    reason=$(classify_playback_error "$(tail -c 4000 "$TING_DETACHED_LOG" 2>/dev/null)" "$rc")
    ended_at=$(date -u +%FT%TZ 2>/dev/null || echo unknown)
    jq -nc --argjson rc "$rc" --arg reason "$reason" --arg ended_at "$ended_at" \
        '{yt_event: "exit", rc: $rc, reason: $reason, ended_at: $ended_at}' 2>/dev/null || true
    return 0
}

# ------------------------------------------------------------------------------
# The listening row: written here, stored by ting-history
# ------------------------------------------------------------------------------
# WHY THE PLAYER WRITES IT. The child is the only process that knows a track ended and why.
# The parent's verb returned minutes ago, and mpv's exit code cannot tell "--next killed it"
# from "--stop killed it" (both 4) — which is the fact CHILD_REASON already exists for, used
# a second time here.
#
# WHY NOT ONLY AT THE END OF A TRACK. --stop takes the whole process group down, so a row
# written only on a natural finish would record just the tracks nobody interrupted: a
# systematically skewed log, and more misleading than none, because "what I listen to" would
# read out as "what I never skipped". The call therefore sits after EVERY play, whatever
# ended it, and only a SIGKILL loses a row.
#
# WHY IT IGNORES THE SIGNAL THAT CAUSED IT. During a --stop the group is signalled every
# 0.2s for three seconds (stop_group) and ting-history would be a child of this child: the very
# stop being recorded would kill the recorder. A disposition of SIG_IGN survives exec — the
# same inheritance rule stop_group's own comment turns on, from the other side — so the write
# runs in a subshell that has ignored INT/TERM before ting-history is started. It cannot hang
# the escalation for long: this is a local append with no network in it, and the KILL still
# backstops it.
#
# STORAGE IS NOT OURS. ting-history is called BY NAME, exactly as an engine is; the player owns
# the row, never the file, and knows nothing about JSONL or month shards. Not on PATH, nothing
# is written and nothing is said: a capability this suite does not have is stated by not
# having the command, the rule that also gives ting-engine-bili no --transcript.
HISTORY_BIN=""
HISTORY_LOOKED=0
history_bin() {
    if ((HISTORY_LOOKED == 0)); then
        HISTORY_LOOKED=1
        if [[ -x "$SCRIPT_DIR/ting-history" ]]; then
            HISTORY_BIN="$SCRIPT_DIR/ting-history"
        elif command -v ting-history >/dev/null 2>&1; then
            HISTORY_BIN=$(command -v ting-history)
        fi
    fi
    [[ -n "$HISTORY_BIN" ]]
}

# history_record <url> <engine> <rc> <id> <title>   — best-effort, ALWAYS 0. Nothing about a
# log of what was played may cost the playing of the next thing.
history_record() {
    local url=$1 engine=$2 rc=$3 id=$4 title=$5
    [[ "$TING_HISTORY" == 0 ]] && return 0
    [[ -n "$url" && -n "$engine" ]] || return 0
    history_bin || return 0

    # The engine's title when there is one, the queue's stored title when the resolve failed
    # — a row for a track that would not play should still name it. resolve_media clears
    # RESOLVED_TITLE on entry, so this can never be the previous track's.
    [[ -n "$RESOLVED_TITLE" ]] && title=$RESOLVED_TITLE
    [[ -n "$RESOLVED_MEDIA_ID" ]] && id=$RESOLVED_MEDIA_ID

    # EVERYTHING ELSE HAPPENS INSIDE THE SUBSHELL, and the reason is the four lines above it.
    # This function is called the instant a track ends, which is most often the instant a
    # --stop arrived, and stop_group hands the child a TERM and a group INT back to back. On
    # bash 3.2 a second signal landing while the first one's handler runs can take the process
    # down between them — measured on the two-player stop, where whichever child was signalled
    # first lost its row while the second wrote one. Nothing can be done about the window
    # before the handler; what CAN be done is to make the window this function adds as close
    # to zero as bash allows. So the reason, the clock, the row and the write all run under
    # `trap '' INT TERM`, whose SIG_IGN survives into ting-history as well — once this subshell
    # is forked, the row lands even if the child it came from is killed a millisecond later.
    (
        trap '' INT TERM

        # The REASON comes from CHILD_REASON and never from mpv's exit code, which spells a
        # skip and a stop the same way (4). Both are `stopped_by_user`: the user acted, and
        # `seconds` is what separates a skip at 0:05 from a stop at 3:20. A clean finish
        # carries no reason at all — which is what lets a caller ask "did this play through?"
        local reason=""
        case "$CHILD_REASON" in
        stopped | next) reason="stopped_by_user" ;;
        *)
            if ((rc != 0)); then
                reason=$(classify_playback_error "$(tail -c 4000 "${TING_DETACHED_LOG:-/dev/null}" 2>/dev/null)" "$rc")
            fi
            ;;
        esac

        # A TRACK THAT NEVER OPENED AND NEVER FAILED IS NOT A LISTENING. A --stop or a --next
        # landing in the gap between two tracks (the engine round trip) would otherwise write
        # a zero-second row for a track nobody heard a note of. A FAILURE in the same gap is
        # still written: "I tried to play this and it would not play" is exactly what a
        # history is for, and it is the one row whose seconds being 0 says something true.
        if [[ -z "$TRACK_STARTED_EPOCH" && "$reason" == "stopped_by_user" ]]; then
            exit 0
        fi

        local now now_at now_epoch played_at seconds=0
        now=$(date -u +"%FT%TZ %s" 2>/dev/null) || now=""
        now_at=${now%% *}
        now_epoch=${now##* }
        [[ "$now_epoch" =~ ^[0-9]+$ ]] || now_epoch=""
        played_at=$TRACK_STARTED_AT
        [[ -n "$played_at" ]] || played_at=$now_at
        # No clock, no row: played_at names the shard file, and ting-history rejects one that is
        # not a timestamp. Dropping it here keeps that rejection off the track boundary.
        [[ -n "$played_at" ]] || exit 0
        if [[ -n "$TRACK_STARTED_EPOCH" && -n "$now_epoch" ]]; then
            seconds=$((now_epoch - TRACK_STARTED_EPOCH))
            ((seconds < 0)) && seconds=0
        fi

        local row
        row=$(jq -nc --arg engine "$engine" --arg url "$url" --arg id "$id" --arg title "$title" \
            --arg duration "$RESOLVED_DURATION" --arg played_at "$played_at" \
            --arg ended_at "${now_at:-$played_at}" --argjson seconds "$seconds" --arg reason "$reason" \
            '{engine: $engine, url: $url,
              id: (if $id == "" then null else $id end),
              title: (if $title == "" then null else $title end),
              duration: (if $duration == "" then null else ($duration | tonumber? // null) end),
              played_at: $played_at, ended_at: $ended_at, seconds: $seconds,
              reason: (if $reason == "" then null else $reason end)}' 2>/dev/null) || exit 0
        [[ -n "$row" ]] || exit 0

        printf '%s' "$row" | "$HISTORY_BIN" --record - >/dev/null 2>&1
    ) || true
    return 0
}

# Per-instance derived paths. Functions, not constants, since they key off the id;
# every detached player owns players/<id>.json, mpv-<id>.sock, mpv-<id>.log.
player_state() { echo "$PLAYERS_DIR/$1.json"; }
player_sock() { echo "$STATE_DIR/mpv-$1.sock"; }
player_log() { echo "$STATE_DIR/mpv-$1.log"; }
player_lock_dir() { echo "$STATE_DIR/lock-$1"; }

# Serialize concurrent read-modify-write patches to the same player state file (e.g. a
# detached child's title/format backfill racing a --set-volume call): both
# do temp+mv RMW with no version check, so without mutual exclusion whichever mv lands
# last silently clobbers the other's field. `mkdir` is atomic on POSIX, making it a
# portable lock on bash 3.2 (no flock binary on stock macOS). Bounded spin (5s) so a
# lock left behind by a crashed holder can't wedge callers forever; on timeout the
# caller proceeds unlocked, same best-effort risk these patches already tolerated
# before this lock existed.
lock_player_state() {
    local id=$1 dir
    dir=$(player_lock_dir "$id")
    local i
    for ((i = 0; i < 50; i++)); do
        mkdir "$dir" 2>/dev/null && return 0
        sleep 0.1
    done
    return 1
}

unlock_player_state() {
    rmdir "$(player_lock_dir "$1")" 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# The queue: a detached player's own runtime state
# ------------------------------------------------------------------------------
# A queue is a playlist BEING CONSUMED, so it belongs to the player and dies with it — a
# queue that survived a restart would just be a playlist, and playlists belong to
# ting-playlist (docs/ARCH-player.md「持久状态层」与「队列」). It lives beside the socket and the log
# rather than under players/ because that directory's *.json glob IS the player-record
# namespace: reap_dead_players walks it, and would read <id>.queue.json as a player whose
# record it could not parse — and then delete it.
#
# EVERY detached launch writes one, a lone handle included: a detached player is then always
# "a queue being consumed", so --enqueue and --next need no separate does-this-player-have-a-
# queue path and --status never has to answer null.
player_queue() { echo "$STATE_DIR/queue-$1.json"; }

# Everything a player leaves behind EXCEPT its record, removed in one place because three
# call sites remove it (the reaper and both --stop paths) and a file added to two of them is
# a leak in the third. The lock dirs are here too: a holder killed mid-write leaves one, and
# a stale lockdir costs every later caller a five-second spin.
rm_player_files() {
    rm -f "$(player_sock "$1")" "$(player_log "$1")" "$(player_queue "$1")" 2>/dev/null || true
    rmdir "$(queue_lock_dir "$1")" "$(player_lock_dir "$1")" 2>/dev/null || true
    undo_drop_for_player "$1"
    return 0
}
queue_lock_dir() { echo "$STATE_DIR/lock-queue-$1"; }

# The queue gets its OWN lock, deliberately not lock_player_state's: the player record and
# the queue are two entities whose update rates differ by an order of magnitude (one title
# backfill per track against one advance per track plus every --enqueue), and one lock for
# both would make each wait on the other's clock.
#
# HARD RULE: NO PATH EVER HOLDS BOTH LOCKS. Take one, write, release, then take the other —
# never nested. One lock can only stall; two can deadlock, and under these bounded spins the
# symptom would not even be a hang: it would be two five-second pauses followed by a SILENT
# unlocked write, which is worse, because nobody would notice.
lock_queue_state() {
    local dir i
    dir=$(queue_lock_dir "$1")
    for ((i = 0; i < 50; i++)); do
        mkdir "$dir" 2>/dev/null && return 0
        sleep 0.1
    done
    return 1
}

unlock_queue_state() {
    rmdir "$(queue_lock_dir "$1")" 2>/dev/null || true
}

# The lock for a write that leaves an undo copy (--owner). Everywhere else the queue lock is
# best effort, as it always was: on timeout the caller writes unlocked. A write with a copy
# may not, because a copy taken outside the lock records a queue that can still move and the
# undo that trusts it would restore the wrong thing. So with --owner a timeout is a failure
# (exit 4, reason locked), and without it nothing here changes.
queue_lock_write() {
    lock_queue_state "$1" && return 0
    [[ -z "$UNDO_OWNER" ]]
}

# ------------------------------------------------------------------------------
# UNDO — the queue's copy, the same rule ting-playlist keeps for playlists (docs/ARCH-player.md
# 「撤销副本」): written under the queue lock between reading the queue and replacing it, only
# for a caller that names itself with --owner, one slot per owner. It lives beside the queue
# in $STATE_DIR, outside players/ (reap_dead_players' namespace), because a copy that
# outlived the queue it restores could only ever be refused.
#
# The `id` file names the player in plain text, so dropping a dead player's copies (below)
# is a `read` per copy rather than a jq.
# ------------------------------------------------------------------------------
UNDO_GRACE=3
UNDO_OWNER=""
UNDO_DISCARD=0
UNDO_DEADLINE=""
undo_slot() { echo "$STATE_DIR/undo-queue-$1"; }

# undo_save ID QUEUE_FILE NEW_FILE — call with the queue lock held, after NEW_FILE is
# complete and before it is moved over QUEUE_FILE. Returns 1 if the copy could not be written,
# and the caller then does not write either.
undo_save() {
    [[ -n "$UNDO_OWNER" ]] || return 0
    local id=$1 qf=$2 new=$3 slot tmpd deadline
    slot=$(undo_slot "$UNDO_OWNER")
    tmpd="$slot.tmp.$$"
    deadline=$(($(date +%s) + UNDO_GRACE))
    rm -rf "$tmpd" 2>/dev/null || true
    if mkdir -m 700 "$tmpd" 2>/dev/null &&
        cp "$qf" "$tmpd/0.pre" 2>/dev/null &&
        cp "$new" "$tmpd/0.post" 2>/dev/null &&
        printf '%s\n' "$id" >"$tmpd/id" &&
        jq -nc --argjson owner "$UNDO_OWNER" --arg verb "$ACTION" --argjson deadline "$deadline" --arg id "$id" \
            '{schema: 1, owner: $owner, verb: $verb, deadline: $deadline,
              objects: [{key: $id, pre_exists: true, post_exists: true}]}' >"$tmpd/meta.json" 2>/dev/null; then
        rm -rf "$slot" 2>/dev/null || true
        if mv "$tmpd" "$slot" 2>/dev/null; then
            UNDO_DEADLINE=$deadline
            return 0
        fi
    fi
    rm -rf "$tmpd" 2>/dev/null || true
    return 1
}

# Every call's sweep (run before any verb): the copies of owners that are gone. An owner that
# exits normally discards its own; this is the kill -9 path. Keyed on the directory name, so
# it is a glob and a `kill -0` per copy.
reap_dead_undo_copies() {
    local d o
    for d in "$STATE_DIR"/undo-queue-*; do
        [[ -e "$d" ]] || continue
        o=${d##*/undo-queue-}
        o=${o%%.*}
        [[ "$o" =~ ^[0-9]+$ ]] || continue
        kill -0 "$o" 2>/dev/null || rm -rf "$d" 2>/dev/null || true
    done
    return 0
}

# The copies whose OBJECT is gone: a player that stopped takes its queue with it, and a copy
# of that queue is a copy of nothing. Called from rm_player_files, the one place a player's
# files go.
undo_drop_for_player() {
    local d pid_of=""
    for d in "$STATE_DIR"/undo-queue-*; do
        [[ -f "$d/id" ]] || continue
        pid_of=""
        IFS= read -r pid_of <"$d/id" 2>/dev/null || true
        [[ "$pid_of" == "$1" ]] && rm -rf "$d" 2>/dev/null
    done
    return 0
}

# The envelope's `undo` field, on a call that left a copy and on no other.
with_undo() {
    if [[ -n "$UNDO_DEADLINE" ]]; then
        jq -c --argjson d "$UNDO_DEADLINE" '. + {undo: {deadline: $d}}'
    else
        cat
    fi
}

# stdin -> QUEUE_ITEMS_JSON, an array of {engine,url,title,duration}. THREE shapes, the same
# three `ting-playlist --add` takes and for the same reason: a search result does not carry
# `engine` — that field is on the ENVELOPE — so only taking the whole envelope can label an
# item with the source it came from. A bare array is the hand-written case, and an object
# with .items is what `ting-playlist --show -j` emits, which is what makes
# `ting-playlist --show jazz -j | ting-play -d --queue -` mean "play that playlist" without the
# player ever learning that playlists exist.
#
# Every rejection here is a USAGE error (1) in the parent, so a malformed queue never
# reaches a player. $1 is the flag being served, so the message names the caller's own verb.
QUEUE_ITEMS_JSON="[]"
read_queue_items() {
    local flag=$1 raw
    raw=$(cat)
    # A MATCH, not `${raw//[[:space:]]/}` — the same fix `ting-playlist`'s read_items carries,
    # for the same measured reason: that substitution is quadratic-with-a-multibyte-constant
    # in bash 3.2 once the string contains one space, and a queue arrives as a KB-sized
    # envelope. Measured: 16s for a 7KB envelope, against 5ms for this.
    [[ "$raw" == *[![:space:]]* ]] ||
        die "$flag reads JSON on stdin (an item array, a --show envelope, or a search envelope); got nothing"
    QUEUE_ITEMS_JSON=$(printf '%s' "$raw" | jq -c --arg fallback "$ENGINE" '
        (if type == "array" then {items: ., engine: null}
         elif type == "object" and (.items | type) == "array" then {items: .items, engine: .engine}
         elif type == "object" and (.results | type) == "array" then {items: .results, engine: .engine}
         else null end)
        | if . == null then error("shape") else . end
        | (.engine // $fallback) as $env
        | [ .items[]
            | {engine: (.engine // $env // ""),
               url: (.url // ""),
               title: (.title // null),
               duration: (.duration // null)} ]' 2>/dev/null) ||
        die "$flag: stdin is not a JSON item array, a --show envelope or a search envelope"
    printf '%s' "$QUEUE_ITEMS_JSON" | jq -e 'length > 0' >/dev/null 2>&1 ||
        die "$flag: no items on stdin"
    # The url is checked the way a handle on argv is checked and no further (a whitespace-free
    # non-empty string): which ids are good is ENGINE knowledge, and the player not holding it
    # is the point of the split. The engine NAME is checked here because it is pasted into a
    # command name later, in a child where a die would only reach a log.
    printf '%s' "$QUEUE_ITEMS_JSON" |
        jq -e 'all(.[]; (.url | type == "string" and test("^[^[:space:]]+$"))
                        and (.engine | type == "string" and test("^[a-z0-9][a-z0-9_-]*$")))' >/dev/null 2>&1 ||
        die "$flag: every item needs a whitespace-free url and a valid engine name"
    return 0
}

# A fresh queue at pos 0. detach_play writes this BEFORE it launches the child, so the child
# can never reach the end of its first track and find no queue to advance.
queue_write_new() {
    local id=$1 items=$2 qf tmp
    qf=$(player_queue "$id")
    tmp="$qf.tmp.$$"
    if jq -nc --argjson items "$items" '{schema: 1, pos: 0, items: $items}' >"$tmp" 2>/dev/null &&
        mv -f "$tmp" "$qf"; then
        return 0
    fi
    rm -f "$tmp" 2>/dev/null || true
    return 1
}

# Append (--enqueue). Read-modify-write, so it runs under the queue lock — the other writer
# is the player's own child advancing the position.
queue_append() {
    local id=$1 items=$2 qf tmp rc=0
    QUEUE_EDIT_ERR=""
    qf=$(player_queue "$id")
    [[ -f "$qf" ]] || return 1
    tmp="$qf.tmp.$$"
    queue_lock_write "$id" || { QUEUE_EDIT_ERR="locked"; return 1; }
    if jq -c --argjson add "$items" '.items = (.items + $add)' "$qf" >"$tmp" 2>/dev/null && [[ -s "$tmp" ]] &&
        undo_save "$id" "$qf" "$tmp"; then
        mv -f "$tmp" "$qf" || rc=1
    else
        rm -f "$tmp" 2>/dev/null || true
        rc=1
    fi
    unlock_queue_state "$id"
    return "$rc"
}

# Every REWRITE of the queue (--queue-rm, --queue-mv, --queue-jump), because all three want
# the same four things checked and the same lock held across the check and the write. A
# rewrite that checked outside the lock would be checking a queue that can move: the child
# advances `pos` on every track boundary, which is the one clock nobody controls.
#
# WHY AN IDENTITY PIN AND NOT JUST AN INDEX. An index into a queue is a guess about a moment.
# The caller read the queue, a track ended, `pos` moved, and now the index it holds names a
# different song — and unlike a playlist, a queue dies with its player, so a wrong removal is
# not recoverable from anywhere. So the caller names the item it MEANT (--expect-url) and
# this is where the two are made to agree, at the last instant before the write.
#
# WHAT CANNOT MOVE AN INDEX, which is what makes the pin cheap enough to be mandatory: `pos`
# advancing does not touch `items`, and --enqueue only appends. The only thing that reorders
# `items` is a queue verb — which is exactly what the pin catches.
#
# $4 is the destination for --queue-mv and empty otherwise; it is checked against the SAME
# bounds as the index, because "a position to move to" and "a position to move" are the same
# kind of thing: a waiting track's slot.
QUEUE_EDIT_ERR=""     # queue_range | queue_stale | queue_failed, for the caller's envelope
QUEUE_EDIT_URL=""     # the item the write acted on, read back under the lock
queue_edit() {
    local id=$1 idx=$2 prog=$3 to=${4:-}
    local qf tmp line pos len url rc=0
    QUEUE_EDIT_ERR=""
    QUEUE_EDIT_URL=""
    qf=$(player_queue "$id")
    [[ -f "$qf" ]] || { QUEUE_EDIT_ERR="queue_failed"; return 1; }
    queue_lock_write "$id" || { QUEUE_EDIT_ERR="locked"; return 1; }
    # One read for all three checks, joined on \037 for the reason queue_current joins on it:
    # a url carries no whitespace, so `read` is a parse rather than a guess.
    line=$(jq -r --argjson i "$idx" \
        '[(.pos | tostring), (.items | length | tostring), (.items[$i].url // "")]
         | join("\u001f")' "$qf" 2>/dev/null) || line=""
    if [[ -z "$line" ]]; then
        unlock_queue_state "$id"
        QUEUE_EDIT_ERR="queue_failed"
        return 1
    fi
    IFS=$'\037' read -r pos len url <<<"$line"
    # RANGE BEFORE IDENTITY, and the order is the message: an index past the end reads back
    # an empty url, so identity-first would report every out-of-range call as a stale pin and
    # tell the caller to re-read a queue that was never the problem.
    #
    # `<= pos` and not `< pos`: the track at pos is PLAYING. Removing or moving it is not a
    # queue edit, it is a playback command, and the player has those already (--next, --stop).
    if ((idx <= pos || idx >= len)) || { [[ -n "$to" ]] && ((to <= pos || to >= len)); }; then
        unlock_queue_state "$id"
        QUEUE_EDIT_ERR="queue_range"
        return 1
    fi
    if [[ "$url" != "$QUEUE_EXPECT_URL" ]]; then
        unlock_queue_state "$id"
        QUEUE_EDIT_ERR="queue_stale"
        return 1
    fi
    tmp="$qf.tmp.$$"
    if jq -c --argjson i "$idx" --argjson t "${to:-0}" "$prog" "$qf" >"$tmp" 2>/dev/null &&
        [[ -s "$tmp" ]] && undo_save "$id" "$qf" "$tmp"; then
        mv -f "$tmp" "$qf" || rc=1
    else
        rm -f "$tmp" 2>/dev/null || true
        rc=1
    fi
    unlock_queue_state "$id"
    if ((rc != 0)); then
        QUEUE_EDIT_ERR="queue_failed"
        return 1
    fi
    QUEUE_EDIT_URL="$url"
    return 0
}

# Drop every track still waiting, keeping the one that is playing. No pin, because there is
# no index to get wrong: the caller is naming the whole tail, and the only thing this can be
# wrong about is a track enqueued in the same instant — which the caller did not know about
# and would have cleared anyway. The playing track survives for the reason a queue edit may
# not touch it: stopping playback is --stop's job, not this verb's.
queue_clear_tail() {
    local id=$1 qf tmp rc=0
    QUEUE_EDIT_ERR=""
    qf=$(player_queue "$id")
    [[ -f "$qf" ]] || return 1
    tmp="$qf.tmp.$$"
    queue_lock_write "$id" || { QUEUE_EDIT_ERR="locked"; return 1; }
    if jq -c '.items = .items[0:(.pos + 1)]' "$qf" >"$tmp" 2>/dev/null && [[ -s "$tmp" ]] &&
        undo_save "$id" "$qf" "$tmp"; then
        mv -f "$tmp" "$qf" || rc=1
    else
        rm -f "$tmp" 2>/dev/null || true
        rc=1
    fi
    unlock_queue_state "$id"
    return "$rc"
}

# The CHILD's advance, and the one reason it is a compare-and-swap rather than `pos += 1`:
# --next advances pos in the PARENT — so its envelope reports a position it read rather than
# one it predicted — and then signals the child. If the track ends in that same instant, a
# blind increment here would skip a second item. Advancing only while pos is still the
# position we played makes the two orders indistinguishable: whoever moves it first wins and
# the other is a no-op. Returns 1 when there is nothing left to play.
queue_advance_from() {
    local id=$1 played=$2 qf tmp rc=0
    qf=$(player_queue "$id")
    [[ -f "$qf" ]] || return 1
    tmp="$qf.tmp.$$"
    lock_queue_state "$id" || true
    if jq -c --argjson p "$played" 'if .pos == $p then .pos = (.pos + 1) else . end' "$qf" >"$tmp" 2>/dev/null &&
        [[ -s "$tmp" ]]; then
        mv -f "$tmp" "$qf" || rc=1
    else
        rm -f "$tmp" 2>/dev/null || true
        rc=1
    fi
    unlock_queue_state "$id"
    ((rc == 0)) || return 1
    jq -e '.pos < (.items | length)' "$qf" >/dev/null 2>&1 || return 1
    return 0
}

# --next's advance, in the PARENT: move to the next item, or report that there is none.
# Returns 1 when pos already names the last item (or there is no queue at all) — the caller
# turns that into exit 4 with reason queue_empty, never into a skip that did nothing.
queue_bump() {
    local id=$1 qf tmp rc=0
    qf=$(player_queue "$id")
    [[ -f "$qf" ]] || return 1
    lock_queue_state "$id" || true
    if ! jq -e '(.pos + 1) < (.items | length)' "$qf" >/dev/null 2>&1; then
        unlock_queue_state "$id"
        return 1
    fi
    tmp="$qf.tmp.$$"
    if jq -c '.pos = (.pos + 1)' "$qf" >"$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
        mv -f "$tmp" "$qf" || rc=1
    else
        rm -f "$tmp" 2>/dev/null || true
        rc=1
    fi
    unlock_queue_state "$id"
    return "$rc"
}

# What the CHILD plays next: the item at the current pos. Out-params, not stdout, so a
# multi-field answer needs no parsing and no subshell (the discipline resolve_media uses).
# Returns 1 when the queue is exhausted or unreadable, which is the loop's exit condition.
QUEUE_POS=0
QUEUE_URL=""
QUEUE_ENGINE=""
# Read for the LISTENING ROW, not for playback: a track whose resolve failed has no engine
# title to record, and the row that says so should still name what it could not play.
QUEUE_ID=""
QUEUE_TITLE=""
queue_current() {
    local id=$1 qf line
    qf=$(player_queue "$id")
    [[ -f "$qf" ]] || return 1
    line=$(jq -r '.items[.pos] as $i
        | if $i == null then empty
          else [(.pos|tostring), $i.engine, $i.url, ($i.id // ""), ($i.title // "")]
               | join("\u001f") end' "$qf" 2>/dev/null) || return 1
    [[ -n "$line" ]] || return 1
    # TITLE LAST, which is the only thing that keeps this a parse rather than a guess: it is
    # the one field that can hold anything (a url and an id carry no whitespace, and the
    # engine name is validated as a name). Last, it absorbs a stray separator; a title holding
    # a NEWLINE loses only its own tail, because `read` stops at the first one and every field
    # the playback path needs has been filled by then.
    IFS=$'\037' read -r QUEUE_POS QUEUE_ENGINE QUEUE_URL QUEUE_ID QUEUE_TITLE <<<"$line"
    [[ -n "$QUEUE_URL" ]] || return 1
    return 0
}

# {pos, len, next, upcoming} — the queue as the --status record and the queue verbs' envelopes
# report it. `next` is the item AFTER pos, or null at the end: a caller asking what is coming
# gets an answer or an honest null, never a guess. `upcoming` is that same tail as a LIST, and
# it carries each item's DURATION, which `next` never did — it is the read half of a thing a
# caller could until now only write. The overlap is deliberate: `upcoming[0]` is `next` with a
# duration, and `next` stays because it is the shape three envelopes already promise.
#
# The tail is CAPPED, because a queue is unbounded (--enqueue appends) and --status --all
# prints one record per live player: projecting the whole remainder would put a caller's
# envelope size at the mercy of how many tracks someone queued. `len` is still the honest
# total, so a caller can always tell a capped tail from the end of the queue.
#
# Read without the lock on purpose: a reader sees either the file before an mv or the file
# after it, never a half-written one.
QUEUE_UPCOMING_MAX=5
QUEUE_JSON=null
queue_snapshot() {
    local id=$1 qf
    QUEUE_JSON=null
    qf=$(player_queue "$id")
    [[ -f "$qf" ]] || return 0
    QUEUE_JSON=$(jq -c --argjson cap "$QUEUE_UPCOMING_MAX" '(.pos + 1) as $s
                        | (.items[$s] // null) as $n
                        | {pos: .pos, len: (.items | length),
                           next: (if $n == null then null else {title: $n.title, url: $n.url, engine: $n.engine} end),
                           upcoming: [.items[$s:($s + $cap)][]
                                      | {title: .title, url: .url, engine: .engine, duration: .duration}]}' \
        "$qf" 2>/dev/null) || QUEUE_JSON=null
    [[ -n "$QUEUE_JSON" ]] || QUEUE_JSON=null
    return 0
}

# A queue item that failed while the player plays on. The player's own death is recorded by
# the PARENT from the epitaph in the log (record_player_death); this is the same tombstone
# for a TRACK rather than a process, so a caller reading failed[] sees the track that did not
# play instead of a silent gap. Keyed <id>-q<pos>, which cannot collide with a player id
# (new_player_id mints six mktemp characters, no dash) and keeps prune_dead_players' rule
# that the file name is the record's own id.
queue_note_failure() {
    local id=$1 pos=$2 url=$3 rc=$4 reason dead ended_at rec
    dead="$PLAYERS_DIR/dead"
    [[ -d "$dead" ]] || mkdir -m 700 "$dead" 2>/dev/null || return 0
    reason=$(classify_playback_error "$(tail -c 4000 "${TING_DETACHED_LOG:-/dev/null}" 2>/dev/null)" "$rc")
    ended_at=$(date -u +%FT%TZ 2>/dev/null || echo unknown)
    rec="$dead/$id-q$pos.json"
    jq -nc --arg id "$id-q$pos" --arg url "$url" --arg engine "$ENGINE" --arg mode "$PLAYBACK_MODE"         --arg started_at "$ended_at" --arg ended_at "$ended_at"         --argjson exit_code "$rc" --arg reason "$reason"         '{id: $id, url: $url, engine: $engine, mode: $mode, started_at: $started_at,
          ended_at: $ended_at, exit_code: $exit_code, reason: $reason}' >"$rec.tmp.$$" 2>/dev/null &&
        mv -f "$rec.tmp.$$" "$rec" 2>/dev/null ||
        rm -f "$rec.tmp.$$" 2>/dev/null || true
    prune_dead_players
    return 0
}

# Mint a fresh, collision-free player id by atomically creating a reservation file
# with mktemp; the id is its basename. Done BEFORE launch so the socket path is
# known up front (the child's pid isn't available until $! after launch) and so the
# handle is immune to pid reuse. detach_play removes the bare reservation file once
# the real <id>.json is written.
new_player_id() {
    basename "$(mktemp "$PLAYERS_DIR/XXXXXX")"
}

# Background a playback and record it in a per-player state file (players/<id>.json)
# so a later --status/--stop/--set-volume can find it. Re-execs this script (SELF)
# with a plain, non-detached play invocation via nohup so it survives the launching
# process exiting; the child is tracked by its PROCESS GROUP. Multiple detached
# players run concurrently — each gets its own id, IPC socket, state file, and log,
# so a 2nd -d is NOT refused (that is the point).
#
# THE CHILD RESOLVES, NOT US. Extraction is a ~3s round trip and detach must return in
# milliseconds (ting captures this call), so the parent launches first and writes `title`
# and `format` as null; the child backfills both from its own resolve envelope the moment it
# has one (patch_player_meta). Doing it the other way — resolve here, then launch — would
# put the whole engine round trip on the -d hot path. docs/ARCHITECTURE.md「调用栈」. Audio only in practice: a detached
# process has no controlling terminal, so video/ascii/viz have nowhere to render.
detach_play() {
    local url=$1
    ensure_state_dir

    local started_at pid volume_json id sock log
    started_at=$(date -u +%FT%TZ 2>/dev/null || echo unknown)
    volume_json=null
    [[ -n "$VOLUME" ]] && volume_json="$VOLUME"

    # Mint the handle BEFORE launch so the socket path is known up front (see
    # new_player_id): the child's pid isn't available until $! after launch, but the
    # socket must be named at launch via TING_IPC_SOCK. The id is a monotonic token,
    # immune to pid reuse; the pid is stored in the state file for liveness only.
    id=$(new_player_id)
    sock=$(player_sock "$id")
    log=$(player_log "$id")
    rm -f "$sock" 2>/dev/null || true

    # The queue is written BEFORE the launch, so the child cannot finish its first track and
    # find nothing to advance. A launch without --queue still gets one, holding exactly the
    # handle being played: a detached player is always a queue being consumed, which is what
    # lets --enqueue and --next address any of them without a special case.
    if [[ "$QUEUE_ITEMS_JSON" == "[]" ]]; then
        QUEUE_ITEMS_JSON=$(jq -nc --arg e "$ENGINE" --arg u "$url" \
            '[{engine: $e, url: $u, title: null, duration: null}]')
    fi
    queue_write_new "$id" "$QUEUE_ITEMS_JSON" || die "failed to write the queue for $url"

    # Launch the child in its OWN process group so the whole playback (incl. any
    # fallback mpv) can be stopped as a unit later (see stop_group). Enabling monitor
    # mode (set -m) makes a backgrounded job a process-group leader whose pgid == its
    # pid; nohup + disown detach it from this shell so it survives our exit. TING_IPC_SOCK
    # is exported into the child's environment so its run_mpv adds --input-ipc-server.
    # Job-control chatter is routed away from stdout so -j output stays one JSON line.
    # TING_DETACHED tells the child's run_mpv there is no terminal to draw on (quiet mpv,
    # no stderr filter); TING_DETACHED_LOG hands it the path its own stdout goes to, which is
    # all detached_epitaph needs to read back what mpv said before classifying its own death.
    # --quality is forwarded like --volume so a quality tier isn't silently lost on the
    # detached path; `--` guards a URL that begins with a dash.
    set -m
    TING_IPC_SOCK="$sock" TING_DETACHED=1 TING_DETACHED_LOG="$log" TING_PLAYER_ID="$id" \
        nohup bash "$SELF" --engine "$ENGINE" -f "$PLAYBACK_MODE" --loop "$LOOP_MODE" \
        ${VOLUME:+--volume "$VOLUME"} \
        ${PLAY_QUALITY:+--quality "$PLAY_QUALITY"} ${PLAY_START:+--start "$PLAY_START"} \
        -- "$url" >"$log" 2>&1 &
    pid=$!
    set +m
    disown "$pid" 2>/dev/null || true

    # Persist state under a guarded write. new_player_id created a bare "$PLAYERS_DIR/$id"
    # (mktemp) to reserve the id; the real state lives in "$id.json". The reservation token
    # is only reaped AFTER the real file lands, so under `set -euo pipefail` a bare jq/mv
    # failure (disk full, permissions changed mid-run by a concurrent reap) would abort
    # before cleanup and orphan the token forever — the *.json reap globs never touch a
    # bare non-.json file. Guard both steps so the token is reaped on every path, and stop
    # the just-launched mpv group if we can't track it (else it plays on as an orphan the
    # lifecycle verbs can't find).
    local sf; sf=$(player_state "$id")
    if ! jq -n \
        --arg id "$id" \
        --argjson pid "$pid" \
        --arg url "$url" \
        --arg engine "$ENGINE" \
        --arg mode "$PLAYBACK_MODE" \
        --arg started_at "$started_at" \
        --arg log "$log" \
        --arg sock "$sock" \
        --argjson volume "$volume_json" \
        --arg loop "$LOOP_MODE" \
        '{id: $id, pid: $pid, url: $url, engine: $engine, mode: $mode, format: null, selected: null, selected_resolution: null, started_at: $started_at, log: $log, sock: $sock, title: null, volume: $volume, loop: $loop}' >"$sf.tmp.$pid"; then
        rm -f "$sf.tmp.$pid" "$PLAYERS_DIR/$id" 2>/dev/null || true
        rm_player_files "$id"
        stop_group "$pid"
        die "failed to write player state for $url"
    fi
    if ! mv -f "$sf.tmp.$pid" "$sf"; then
        rm -f "$sf.tmp.$pid" "$PLAYERS_DIR/$id" 2>/dev/null || true
        rm_player_files "$id"
        stop_group "$pid"
        die "failed to persist player state for $url"
    fi
    rm -f "$PLAYERS_DIR/$id" 2>/dev/null || true

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        # sock/log are part of the envelope so a caller never has to RECONSTRUCT them from
        # the state-dir layout (ting used to hardcode "$TMPDIR/ting-$(id -u)/mpv-$id.sock",
        # duplicating a private path in a second script). ARCH-player.md「运行时 IPC」.
        jq -nc \
            --arg id "$id" --argjson pid "$pid" --arg url "$url" --arg mode "$PLAYBACK_MODE" \
            --arg started_at "$started_at" --arg sock "$sock" --arg log "$log" \
            '{status: "started", id: $id, pid: $pid, url: $url, mode: $mode, started_at: $started_at, title: null, sock: $sock, log: $log}'
    else
        printf "Detached playback started (id %s, pid %s, mode %s): %s\n" "$id" "$pid" "$PLAYBACK_MODE" "$url"
        printf "  status: ting-play --status   stop: ting-play --stop --id %s   log: %s\n" "$id" "$log"
    fi
}

# Scan $PLAYERS_DIR once, reaping any player whose process group is gone (rm its
# state/sock/log). "What counts as dead" (currently: group not alive) lives here in exactly
# one place, shared by resolve_target, do_status, and do_stop --all so those verbs can never
# disagree about which players exist.
#
# RETURN-VALUE DISCIPLINE (do NOT capture in $(...); bash 3.2 arrays don't survive command
# substitution): sets three PARALLEL GLOBAL arrays for the survivors, index-aligned —
#   LIVE_PLAYER_FILES[i] = players/<id>.json path
#   LIVE_PLAYER_IDS[i]   = its .id
#   LIVE_PLAYER_PIDS[i]  = its .pid
# reading .id/.pid once here means no caller has to reopen the file for them.
reap_dead_players() {
    LIVE_PLAYER_FILES=()
    LIVE_PLAYER_IDS=()
    LIVE_PLAYER_PIDS=()
    local f id pid
    [[ -d "$PLAYERS_DIR" ]] || return 0
    for f in "$PLAYERS_DIR"/*.json; do
        [[ -e "$f" ]] || continue
        id=$(jq -r '.id // empty' "$f" 2>/dev/null || true)
        pid=$(jq -r '.pid // empty' "$f" 2>/dev/null || true)
        if group_alive "$pid"; then
            LIVE_PLAYER_FILES+=("$f")
            LIVE_PLAYER_IDS+=("$id")
            LIVE_PLAYER_PIDS+=("$pid")
        else
            # Read the epitaph BEFORE the log goes: this is the only moment both the record
            # and the log still exist, and a failure that is not captured here is gone.
            [[ -n "$id" ]] && record_player_death "$id" "$f"
            rm -f "$f" 2>/dev/null || true
            [[ -n "$id" ]] && rm_player_files "$id"
        fi
    done
}

# Map a request to a single live player, reaping any dead ones along the way. The single
# place --set-volume and --stop share for target selection.
#
# RETURN-VALUE DISCIPLINE (do NOT capture in $(...)): on success sets the GLOBAL
# RESOLVED_ID and returns 0; on failure sets RESOLVE_ERR ("not_playing"|"ambiguous")
# (+ RESOLVE_PLAYERS_JSON for ambiguous) and returns non-zero. Nothing is echoed to
# stdout — the caller decides how to render (a --stop treats not_playing as idempotent
# success; a --set-volume treats it as exit 4), so the error text must not be trapped
# by command substitution.
#   --id given          -> that player if live, else not_playing
#   no --id, exactly 1  -> that player (common case, zero-friction)
#   no --id, 0 players   -> not_playing
#   no --id, 2+ players  -> ambiguous (candidates in RESOLVE_PLAYERS_JSON)
resolve_target() {
    local want_id=$1
    RESOLVED_ID=""
    RESOLVE_ERR=""
    RESOLVE_PLAYERS_JSON="[]"

    # Read the live set from reap_dead_players' globals directly — copying via
    # ("${arr[@]}") would abort under `set -u` on bash 3.2 when the array is empty (the
    # common "nothing playing" case). Index access and count are safe on an empty array.
    reap_dead_players
    local n=${#LIVE_PLAYER_IDS[@]}

    if [[ -n "$want_id" ]]; then
        local i
        for ((i = 0; i < n; i++)); do
            if [[ "${LIVE_PLAYER_IDS[$i]}" == "$want_id" ]]; then
                RESOLVED_ID="$want_id"
                return 0
            fi
        done
        RESOLVE_ERR="not_playing"
        return 1
    fi

    if ((n == 0)); then
        RESOLVE_ERR="not_playing"
        return 1
    elif ((n == 1)); then
        RESOLVED_ID="${LIVE_PLAYER_IDS[0]}"
        return 0
    else
        RESOLVE_ERR="ambiguous"
        RESOLVE_PLAYERS_JSON=$(jq -s '[.[] | {id, pid, title, url}]' "${LIVE_PLAYER_FILES[@]}")
        return 1
    fi
}

# Turn a dead player's last log line into a tombstone under players/dead/, so `--status` can
# answer "it stopped, and here is why" instead of going silently empty (see detached_epitaph
# for why the child, not this function, decides rc). Failures ONLY: no epitaph — a normal
# finish, a --stop that took the whole process group down, a truncated log, a kill -9 — means
# no tombstone. Silence is reported as silence; a death is never inferred.
record_player_death() {
    local id=$1 f=$2 log ev rc reason ended_at dead
    log=$(player_log "$id")
    [[ -f "$log" ]] || return 0
    ev=$(tail -n 1 "$log" 2>/dev/null | jq -c 'select(.yt_event == "exit")' 2>/dev/null) || ev=""
    [[ -n "$ev" ]] || return 0
    IFS=$'\037' read -r rc reason ended_at < <(
        printf '%s' "$ev" | jq -r '[(.rc // 0), (.reason // "unknown"), (.ended_at // "unknown")] | join("\u001f")' 2>/dev/null
    ) || return 0
    [[ "$rc" =~ ^[0-9]+$ ]] && ((rc != 0)) || return 0

    # No -p: reap_dead_players only reaches here with PLAYERS_DIR already present, and -p
    # would apply the mode to the deepest component only (the SC2174 note at ensure_state_dir).
    dead="$PLAYERS_DIR/dead"
    [[ -d "$dead" ]] || mkdir -m 700 "$dead" 2>/dev/null || return 0
    # Only the fields that answer "which launch was this, and what happened to it" — the
    # socket, log and format paths described a process that no longer exists. `engine` is part
    # of WHICH LAUNCH: with the url it is the call that died, so a caller reading failed[] can
    # re-issue it instead of guessing which engine owned the handle.
    jq -c --argjson exit_code "$rc" --arg reason "$reason" --arg ended_at "$ended_at" \
        '{id, url, engine, mode, started_at, ended_at: $ended_at, exit_code: $exit_code, reason: $reason}' \
        "$f" >"$dead/$id.json.tmp" 2>/dev/null &&
        mv -f "$dead/$id.json.tmp" "$dead/$id.json" 2>/dev/null ||
        rm -f "$dead/$id.json.tmp" 2>/dev/null || true
    prune_dead_players
    return 0
}

# Two bounds, both enforced on disk rather than at render time, so the directory cannot grow
# into a history nobody asked for: nothing older than an hour, and never more than 8 records.
# `find -mmin` is stock on macOS and Linux alike; the count cap reuses jq's sort so "oldest"
# means the same thing here as it does in the output. Cross-engine — the player is
# source-agnostic, so nothing about this number belongs to a site.
DEAD_KEEP=8
prune_dead_players() {
    local dead="$PLAYERS_DIR/dead" files=() extra x
    [[ -d "$dead" ]] || return 0
    find "$dead" -name '*.json' -mmin +60 -delete 2>/dev/null || true
    files=("$dead"/*.json)
    [[ -e "${files[0]}" ]] || return 0
    ((${#files[@]} > DEAD_KEEP)) || return 0
    extra=$(jq -sr --argjson keep "$DEAD_KEEP" \
        'sort_by(.ended_at) | reverse | .[$keep:] | .[].id' "${files[@]}" 2>/dev/null) || return 0
    while IFS= read -r x; do
        [[ -n "$x" ]] && rm -f "$dead/$x.json" 2>/dev/null || true
    done <<<"$extra"
    return 0
}

# The read side of the same directory: newest first, capped, as a JSON array in FAILED_JSON.
# Always a valid array — `failed` is a key that is ALWAYS present in the --status envelope,
# because a key that appears only when something went wrong is harder to consume than an
# empty one (a caller would have to distinguish "no failures" from "old version").
FAILED_JSON='[]'
collect_failed_players() {
    local dead="$PLAYERS_DIR/dead" files=()
    FAILED_JSON='[]'
    [[ -d "$dead" ]] || return 0
    files=("$dead"/*.json)
    # The glob is unexpanded when the directory is empty; test the first element rather than
    # the count, and skip the prune entirely — the common case must cost no fork at all.
    [[ -e "${files[0]}" ]] || return 0
    prune_dead_players
    files=("$dead"/*.json)
    [[ -e "${files[0]}" ]] || return 0
    FAILED_JSON=$(jq -sc --argjson keep "$DEAD_KEEP" \
        'sort_by(.ended_at) | reverse | .[0:$keep]' "${files[@]}" 2>/dev/null) || FAILED_JSON='[]'
    [[ -n "$FAILED_JSON" ]] || FAILED_JSON='[]'
    return 0
}

# List ALL live detached players (reaping dead ones). Always exits 0 (an agent polling
# status must not see a non-zero exit as failure); empty set is still a success.
# `volume`, `paused`, `position` and `duration` are reported LIVE (one round trip per player
# off its IPC socket, see read_player_live) rather than from the state file: the record only
# knows about launch --volume and --set-volume, so a client driving the socket itself
# (ting's 9/0 keys) would make `volume` lie — and it has never held the other three at all.
# `volume` keeps the recorded value as its fallback; the other three are null when unread,
# which is NOT the same as false/0 ("could not ask" vs "playing at zero"). read_player_live
# is a no-op without nc, keeping the jq-only dep contract.
do_status() {
    reap_dead_players
    collect_failed_players

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        local n=${#LIVE_PLAYER_FILES[@]}
        if ((n)); then
            local i parts=()
            for ((i = 0; i < n; i++)); do
                read_player_live "$(player_sock "${LIVE_PLAYER_IDS[$i]}")"
                media_json
                # The queue comes off disk rather than the socket: it is the PLAYER's state,
                # not mpv's — mpv is told one URL at a time and never learns there is a list.
                queue_snapshot "${LIVE_PLAYER_IDS[$i]}"
                # sock/log ride along for the same reason the -d envelope carries them: a
                # caller that wants to CONTROL a player it did not start (ting adopting a
                # background player at startup) needs the socket, and the only other way to
                # get it is to rebuild "$STATE_DIR/mpv-$id.sock" in a second script — the
                # duplication this envelope exists to prevent. ARCH-player.md「运行时 IPC」.
                parts+=("$(jq -c \
                    --argjson live "${LP_VOLUME:-null}" \
                    --argjson paused "${LP_PAUSED:-null}" \
                    --argjson position "${LP_POSITION:-null}" \
                    --argjson duration "${LP_DURATION:-null}" \
                    --argjson media "$LP_MEDIA_JSON" \
                    --argjson queue "$QUEUE_JSON" \
                    '{id, pid, url, engine, mode, volume: ($live // .volume),
                      paused: $paused, position: $position, duration: $duration,
                      title, selected, selected_resolution, media: $media,
                      loop: (.loop // "off"), started_at, queue: $queue,
                      sock, log}' \
                    "${LIVE_PLAYER_FILES[$i]}")")
            done
            # -sc: one line, like the empty branch below and every other envelope. The
            # pretty form only ever showed up with a player present, i.e. exactly when a
            # caller is polling this.
            printf '%s\n' "${parts[@]}" |
                jq -sc --argjson failed "$FAILED_JSON" '{status: "players", players: ., failed: $failed}'
        else
            jq -nc --argjson failed "$FAILED_JSON" '{status: "players", players: [], failed: $failed}'
        fi
    else
        if ((${#LIVE_PLAYER_FILES[@]})); then
            local f id pid mode started_at url loop title volume vol_suffix pause_suffix queue_suffix
            for f in "${LIVE_PLAYER_FILES[@]}"; do
                vol_suffix=""
                pause_suffix=""
                # One jq call for the structural fields (never contain tabs/newlines) via
                # @tsv, instead of five separate per-field forks. title stays on its own
                # jq -r so a title with an embedded tab/newline round-trips byte-for-byte
                # rather than being @tsv-escaped.
                IFS=$'\t' read -r id pid mode started_at url loop < <(
                    jq -r '[.id, .pid, .mode, .started_at, .url, (.loop // "off")] | @tsv' "$f" 2>/dev/null
                ) || true
                title=$(jq -r '.title // empty' "$f" 2>/dev/null || true)
                read_player_live "$(player_sock "$id")"
                volume="$LP_VOLUME"
                [[ -n "$volume" ]] || volume=$(jq -r '.volume // empty' "$f" 2>/dev/null || true)
                [[ -n "$volume" ]] && vol_suffix=", volume $volume"
                # Only `paused` joins the human line: a person reading this wants to know why
                # it went quiet. The position pair stays JSON-only — the human who wants a
                # playhead has `ting`, which draws one, and this line is already long.
                # `media` stays JSON-only for exactly that reason, one step further: nine
                # fields cannot ride a line that already refuses two, and the human surface
                # for "what is actually decoding" is ting's details block, which has room
                # to lay it out. read_player_live still reads all thirteen properties here —
                # it is ONE function so the null policy exists once, and the cost is lines
                # on a connection this arm was opening anyway, not a second round trip.
                [[ "$LP_PAUSED" == "true" ]] && pause_suffix=", paused"
                # Only a queue of MORE THAN ONE earns a word here: every detached player has
                # a queue now, and printing "track 1/1" on every line would be noise.
                queue_snapshot "$id"
                queue_suffix=$(printf '%s' "$QUEUE_JSON" |
                    jq -r 'if . != null and .len > 1 then ", track \(.pos + 1)/\(.len)" else "" end' 2>/dev/null) || queue_suffix=""
                vol_suffix="$vol_suffix$queue_suffix"
                # Same rule as the queue segment above: only a NON-default state earns a
                # word. Every player has a loop mode; almost none of them are repeating.
                [[ "$loop" == "one" ]] && vol_suffix="$vol_suffix, repeat one"
                if [[ -n "$title" ]]; then
                    printf "playing (id %s, pid %s, mode %s%s%s, since %s): %s\n  %s\n" \
                        "$id" "$pid" "$mode" "$vol_suffix" "$pause_suffix" "$started_at" "$title" "$url"
                else
                    printf "playing (id %s, pid %s, mode %s%s%s, since %s): %s\n" \
                        "$id" "$pid" "$mode" "$vol_suffix" "$pause_suffix" "$started_at" "$url"
                fi
            done
        else
            echo "idle (nothing playing)"
        fi
        # After the live list, not instead of it: a player can have failed while another is
        # still playing. Same wording as the JSON `failed` entries, one line each.
        if [[ "$FAILED_JSON" != "[]" ]]; then
            jq -r '.[] | "failed (id \(.id), mode \(.mode), \(.reason), exit \(.exit_code), ended \(.ended_at)): \(.url)"' \
                <<<"$FAILED_JSON" 2>/dev/null || true
        fi
    fi
    exit 0
}

# Stop detached playback. Idempotent: exits 0 when nothing (or nothing matching) is
# playing. --all stops every live player; otherwise a single target is resolved
# (exactly-one is zero-friction; 2+ without --id is ambiguous → exit 4).
do_stop() {
    local want_id=$1 stop_all=$2
    local id any=false

    if ((stop_all)); then
        # reap_dead_players already rm'd every dead player's state/sock/log; the survivors
        # are exactly the ones to stop. Kill each group, then remove its state/sock/log.
        reap_dead_players
        local i n=${#LIVE_PLAYER_FILES[@]}
        ((n > 0)) && any=true
        for ((i = 0; i < n; i++)); do
            stop_group "${LIVE_PLAYER_PIDS[$i]}"
            rm -f "${LIVE_PLAYER_FILES[$i]}" 2>/dev/null || true
            rm_player_files "${LIVE_PLAYER_IDS[$i]}"
        done
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            jq -nc --argjson stopped "$any" '{status: "stopped", scope: "all", stopped: $stopped}'
        else
            if [[ "$any" == true ]]; then echo "stopped all playback"; else echo "nothing to stop"; fi
        fi
        exit 0
    fi

    if ! resolve_target "$want_id"; then
        if [[ "$RESOLVE_ERR" == "ambiguous" ]]; then
            if [[ "$OUTPUT_MODE" == "json" ]]; then
                jq -nc --argjson players "$RESOLVE_PLAYERS_JSON" '{status: "ambiguous", reason: "multiple_players", players: $players}'
            else
                echo "multiple players playing; specify --id or --all (see 'ting-play --status')" >&2
            fi
            exit 4
        fi
        # not_playing → idempotent success, not an error.
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            jq -nc '{status: "stopped", stopped: false}'
        else
            echo "nothing to stop"
        fi
        exit 0
    fi

    local sf pid_stop
    id=$RESOLVED_ID
    sf=$(player_state "$id")
    pid_stop=$(jq -r '.pid // empty' "$sf" 2>/dev/null || true)
    if group_alive "$pid_stop"; then
        stop_group "$pid_stop"
        any=true
    fi
    rm -f "$sf" 2>/dev/null || true
    rm_player_files "$id"

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --argjson stopped "$any" '{status: "stopped", id: $id, stopped: $stopped}'
    else
        if [[ "$any" == true ]]; then echo "stopped playback (player $id)"; else echo "nothing to stop"; fi
    fi
    exit 0
}

# Resolve the target of a verb that MUTATES a running player, or emit that verb's
# "did not take effect" envelope and exit 4. Shared by every socket-driven verb
# (--set-volume, --pause/--resume/--seek/--seek-to) and by the queue verbs, so the
# not_playing/ambiguous shapes exist ONCE rather than per verb.
#
# --stop deliberately does NOT use this: it treats not_playing as idempotent success
# (do_stop), which is the whole difference between "stop what is playing" and "change what
# is playing". On success, resolve_target's RESOLVED_ID is set for the caller.
require_live_target() {
    local want_id=$1
    resolve_target "$want_id" && return 0
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        if [[ "$RESOLVE_ERR" == "ambiguous" ]]; then
            jq -nc --argjson players "$RESOLVE_PLAYERS_JSON" '{status: "ambiguous", reason: "multiple_players", players: $players}'
        else
            echo '{"status":"not_playing"}'
        fi
    else
        if [[ "$RESOLVE_ERR" == "ambiguous" ]]; then
            echo "multiple players playing; specify --id (see 'ting-play --status')" >&2
        else
            echo "nothing playing" >&2
        fi
    fi
    exit 4
}

# One mpv IPC command, one correlated reply. Returns 0 with IPC_DATA set to the reply's
# `data` (the literal "null" when mpv answered null, exactly as live_props reports it) when
# mpv said success; returns non-zero otherwise, INCLUDING when there is no socket to talk to.
#
# request_id correlation: mpv multiplexes ASYNC EVENTS to every client, interleaved with
# replies (mpv ipc.rst), so head -1 alone can grab an event. Filter by request_id.
# `|| true` is REQUIRED — under set -euo pipefail the pipeline exits non-zero on nc
# timeout / SIGPIPE (head closing early) and would abort the script AT the assignment.
IPC_DATA=""
ipc_command() {
    local sock=$1 cmd=$2 reply
    IPC_DATA=""
    resolve_nc_unix || return 1
    [[ -S "$sock" ]] || return 1
    reply=$(printf '%s\n' "$cmd" |
        "${NC_UNIX[@]}" "$sock" 2>/dev/null |
        jq -c 'select(.request_id==1)' 2>/dev/null | head -1) || true
    [[ "$(jq -r '.error // empty' <<<"$reply" 2>/dev/null)" == success ]] || return 1
    IPC_DATA=$(jq -r '.data' <<<"$reply" 2>/dev/null) || IPC_DATA=""
    return 0
}

# The "it did not take effect" exit shared by every socket verb: mpv is there but would not
# do it (or the socket is gone). Always 4, never 1 — the call itself was well formed.
ipc_failed() {
    local what=$1
    [[ "$OUTPUT_MODE" == "json" ]] && echo '{"status":"error","reason":"ipc_failed"}' || echo "failed to $what" >&2
    exit 4
}

# Adjust volume on a detached player via mpv's per-instance JSON IPC socket. One-shot:
# open, send, read the matching ack, close, exit (stateless-per-call). Exit 4 for any
# "did not take effect" (no such/no player, ambiguous, or IPC failure); the -j
# status/reason carries the why. See ARCH-cli-contract.md「数据契约」/ARCH-cli-contract.md「退出码」.
do_set_volume() {
    local n=$1 want_id=$2
    is_non_negative_int "$n" || die "--set-volume must be a non-negative integer"
    ((n <= 100)) || die "--set-volume must be between 0 and 100" # symmetry w/ launch --volume

    require_live_target "$want_id"

    local id sock
    id=$RESOLVED_ID
    sock=$(player_sock "$id")
    ipc_command "$sock" "$(printf '{"command":["set_property","volume",%d],"request_id":1}' "$n")" ||
        ipc_failed "set volume"

    # Atomic patch of this player's state file (temp+mv, same idiom as patch_player_meta),
    # under the same per-id lock so this can't interleave with a concurrent title backfill.
    local sf tmp
    sf=$(player_state "$id")
    tmp="$sf.tmp.$$"
    lock_player_state "$id" || true
    if jq --argjson v "$n" '.volume = $v' "$sf" >"$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
        mv -f "$tmp" "$sf"
    else
        rm -f "$tmp" 2>/dev/null || true
    fi
    unlock_player_state "$id"

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --argjson volume "$n" '{status: "ok", id: $id, volume: $volume}'
    else
        echo "volume set to $n (player $id)"
    fi
    exit 0
}

# Pause / resume / seek on a detached player, over the same one-shot IPC as --set-volume and
# with the same exit taxonomy: 4 for no target, ambiguity, or an mpv that would not do it;
# 1 (from the arg parser, before we get here) for a malformed value.
#
# THE ENVELOPE REPORTS THE PROPERTY READ BACK, NEVER A COMPUTED ONE. A seek is clamped by
# mpv at the ends of the file and refused outright on a live stream, so "the position I
# asked for" and "the position it is at" are different numbers exactly when a caller most
# needs the truth. One extra round trip buys that, and --set-volume already pays it in
# spirit (it reports the value mpv accepted). Overshooting the end is NOT an error: mpv
# clamps, we report where it landed, exit 0.
#
# No --toggle-pause: mpv's `cycle pause` does not report the resulting state, so the
# envelope could only guess it. Two idempotent verbs are also what a machine caller wants —
# no read-modify-write race. The toggle is a KEY, and keys live in ting.
do_playback_verb() {
    local verb=$1 arg=$2 want_id=$3
    require_live_target "$want_id"

    local id sock cmd prop
    id=$RESOLVED_ID
    sock=$(player_sock "$id")
    # The sign is REQUIRED on the command line (is_signed_int) and ILLEGAL in the JSON that
    # carries it: JSON numbers have no leading `+`, so `["seek",+10,…]` is not JSON at all
    # and mpv rejects the whole command — which surfaces as ipc_failed, i.e. a relative seek
    # that silently never worked while --seek-to did. Strip it here, at the one place the
    # value crosses from argv into JSON.
    arg="${arg#+}"
    case "$verb" in
    pause) cmd='{"command":["set_property","pause",true],"request_id":1}'; prop=pause ;;
    resume) cmd='{"command":["set_property","pause",false],"request_id":1}'; prop=pause ;;
    # A live stream has no seekable timeline; mpv is the one that knows, so let it refuse
    # and translate that refusal into ipc_failed. Predicting it here from a null duration
    # would be the player holding a piece of site knowledge it deliberately does not have.
    seek) cmd=$(printf '{"command":["seek",%s,"relative"],"request_id":1}' "$arg"); prop=time-pos ;;
    seek-to) cmd=$(printf '{"command":["seek",%s,"absolute"],"request_id":1}' "$arg"); prop=time-pos ;;
    esac

    ipc_command "$sock" "$cmd" || ipc_failed "$verb"
    # Read back. A failure HERE is not a failed verb — the command was accepted — so the
    # value goes null rather than the whole call turning into an error.
    local value=""
    ipc_command "$sock" "$(printf '{"command":["get_property","%s"],"request_id":1}' "$prop")" && value="$IPC_DATA"

    if [[ "$prop" == pause ]]; then
        [[ "$value" == "true" || "$value" == "false" ]] || value=""
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            jq -nc --arg id "$id" --argjson paused "${value:-null}" '{status: "ok", id: $id, paused: $paused}'
        else
            echo "${verb}d (player $id)"
        fi
    else
        # Integers, the unit the rest of the contract speaks (read_player_live does the same
        # truncation on the same property).
        [[ "$value" =~ ^[0-9]+ ]] && value="${value%.*}" || value=""
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            jq -nc --arg id "$id" --argjson position "${value:-null}" '{status: "ok", id: $id, position: $position}'
        else
            echo "seeked to ${value:-?}s (player $id)"
        fi
    fi
    exit 0
}

# --watch: the player's state as a STREAM, one line per thing that happened, so a caller that
# wants to draw a clock (ting) or follow a queue (an agent) stops re-polling --status or, worse,
# reading the mpv socket itself. docs/PLAN-go-tui.md holds the decisions; the reasons that
# are properties of THIS code are here.
#
# EVERY LINE IS A WHOLE STATE — the --status record for this player plus `event`, `ready`,
# `cpu` and `mem`. A reader never merges and never keeps state, and one that joins late (or
# drops a line) is not wrong about anything. The mpv half is read off ONE long connection
# with observe_property; the player half (title, url, queue, loop) is re-read off disk for
# every line, because an --enqueue or a track change moves it without telling mpv.
#
# THE CADENCE IS DECIDED IN THE RESIDENT jq, NOT HERE. mpv pushes time-pos about 19 times a
# second; forwarding that is noise to an agent paying per token, and a fork per event would be
# the cost this verb exists to remove. The jq below turns the event stream into the few lines
# worth sending: discrete changes (pause/resume, volume, seek, ready, end-file) and a heartbeat
# each time the playhead crosses a WHOLE second, which is what makes the integer `position`
# on a heartbeat exact at the moment it is sent. Media facts and duration change silently and
# ride the next line: audio_bitrate is a moving estimate and would be an event per packet.
#
# THE STREAM FOLLOWS THE PLAYER, NOT THE SOCKET. Each queued track is a new mpv, and between
# two there is a JIT resolve with no mpv at all. mpv also LEAVES ITS SOCKET FILE BEHIND when it
# exits (measured, mpv 0.41), so `-S` does not mean connectable and the gap is spent on
# refused connects. What decides "is there more to watch" is therefore the process group,
# the same test reap_dead_players uses.
#
# nc NEEDS ITS STDIN OPEN for as long as the connection should live. The stdin is a FIFO this
# shell opens read-write and hands over; nc then holds both ends itself, so nothing ever sends
# it EOF and there is no second process to reap. A `{ printf; tail -f /dev/null; } | nc`
# holder was measured to outlive nc. And no -w: on BSD nc that is an IDLE timeout, and a
# paused player is idle.
WATCH_OBSERVE=(pause volume time-pos duration core-idle
    video-format width height container-fps video-bitrate
    audio-codec-name audio-bitrate audio-params/samplerate audio-params/hr-channels)
# The same null/number policy read_player_live applies, restated in jq because the values
# never pass through bash here. `ended` is the player's own vocabulary for mpv's end-file
# reason: eof is a track that played out, error one that failed, and everything else (stop,
# quit — --next and --stop both reach mpv as a signal) one that was interrupted.
WATCH_JQ='
def int: if type == "number" then floor else null end;
def str: if type == "string" and . != "" then . else null end;
def fps: if type == "number" then (. * 100 | round) / 100 else null end;
def view($p): {volume: ($p.volume | int),
    paused: (if ($p.pause | type) == "boolean" then $p.pause else null end),
    position: ($p["time-pos"] | int), duration: ($p.duration | int),
    media: {video_codec: ($p["video-format"] | str), width: ($p.width | int),
            height: ($p.height | int), fps: ($p["container-fps"] | fps),
            video_bitrate: ($p["video-bitrate"] | int),
            audio_codec: ($p["audio-codec-name"] | str),
            audio_bitrate: ($p["audio-bitrate"] | int),
            sample_rate: ($p["audio-params/samplerate"] | int),
            channels: ($p["audio-params/hr-channels"] | str)}};
foreach inputs as $e (
    {p: {}, seen: {}, snap: false, ready: false, sec: null, seeking: false, out: null, ended: null};
    .out = null
    | if $e.event == "property-change" then
        $e.name as $n | .p[$n] as $old | .p[$n] = $e.data
        | if (.snap | not) then
            .seen[$n] = true
            | if (.seen | length) >= $want then
                .snap = true | .out = "snapshot"
                | .ready = (.p["core-idle"] == false) | .sec = (.p["time-pos"] | int)
              else . end
          elif $n == "pause" and ($e.data | type) == "boolean" and $e.data != $old then
            .out = (if $e.data then "pause" else "resume" end)
          elif $n == "volume" and ($e.data | int) != ($old | int) then .out = "volume"
          elif $n == "core-idle" and $e.data == false and (.ready | not) then
            .ready = true | .out = "ready"
          elif $n == "time-pos" and (.seeking | not) and ($e.data | int) != null
               and ($e.data | int) != .sec then
            .sec = ($e.data | int) | .out = "heartbeat"
          else . end
      elif $e.event == "seek" then .seeking = true
      elif $e.event == "playback-restart" and .seeking then
        .seeking = false | .sec = (.p["time-pos"] | int)
        | if .snap then .out = "seek" else . end
      elif $e.event == "end-file" then
        .out = "transitioning"
        | .ended = ({eof: "finished", error: "failed"}[$e.reason // ""] // "interrupted")
      else . end;
    select(.out != null)
    | view(.p) + {event: .out, ready: .ready}
      + (if .out == "transitioning" then {ended: .ended} else {} end)
    | "\(.event)\u001f\(tojson)")'
# The player half of every line, joined onto the mpv half ($m) — the same projection
# do_status makes, so a field means one thing on both verbs.
WATCH_MERGE='{status: "watch", event: $m.event, id, pid, url, engine, mode,
    volume: ($m.volume // .volume), paused: $m.paused, position: $m.position,
    duration: $m.duration, title, selected, selected_resolution, media: $m.media,
    loop: (.loop // "off"), started_at, queue: $queue, ready: $m.ready,
    cpu: $cpu, mem: $mem, sock, log}
    + (if $m.ended then {ended: $m.ended} else {} end)'
WATCH_NC_PID=""
WATCH_GUARD_PID=""
WATCH_FIFO=""
WATCH_LAST=""
WATCH_CPU=""
WATCH_MEM=""
WATCH_BEATS=0

# The reader went away (SIGPIPE on our stdout) or we were told to stop. Take nc down with us,
# or it would sit on mpv's socket until the track ended.
#
# A closed pipe is only NOTICED ON A WRITE, and a paused player writes nothing (no heartbeat
# while the playhead stands still), so a reader that leaves during a pause leaves this verb
# and its nc alive until the next event — a resume, a volume change, a --stop. Bounded by the
# player's own life, and measured to clear on that next event. A caller that owns the process
# (ting) kills it instead of waiting.
watch_bail() {
    [[ -n "$WATCH_GUARD_PID" ]] && kill "$WATCH_GUARD_PID" 2>/dev/null
    [[ -n "$WATCH_NC_PID" ]] && kill "$WATCH_NC_PID" 2>/dev/null
    [[ -n "$WATCH_FIFO" ]] && rm -f "$WATCH_FIFO" 2>/dev/null
    exit 0
}

# CPU percent and resident MB over the player's PROCESS GROUP — the one fact about a player
# a caller could only get by knowing that the recorded pid leads a group (`set -m` at launch).
# Sampled on the snapshot and every RES_STRIDE-th heartbeat after it, the stride ting
# samples at too; between samples the last reading rides along. Why ps -A | awk and not
# `ps -g`: one portable spelling (ARCH-player.md).
RES_STRIDE=3
watch_sample_res() {
    local pid=$1 out=""
    [[ "${TING_RESOURCE:-1}" != 0 ]] || return 0
    out=$(ps -A -o pgid=,%cpu=,rss= 2>/dev/null |
        awk -v g="$pid" '$1 == g { c += $2; r += $3; n += 1 }
                         END { if (n) printf "%.0f %.0f", c, r / 1024 }') || out=""
    if [[ -n "$out" ]]; then
        WATCH_CPU="${out%% *}"
        WATCH_MEM="${out##* }"
    else
        WATCH_CPU=""
        WATCH_MEM=""
    fi
    return 0
}

# One line out. A record that is gone (--stop took it between two events) skips the line
# rather than inventing one; the loop's liveness test ends the stream on its next turn.
#
# `transitioning` is the one line whose player half is NOT re-read: it describes the track
# that just ended, and by end-file the disk may already describe the next one — --next and
# --queue-jump move `pos` BEFORE they signal the child (measured: a re-read reported the old
# url beside the new pos). So it takes the previous line's player half, which was true of
# the track mpv was playing, and lays the mpv half on top.
watch_emit() {
    local id=$1 m=$2 f line ev=$3
    if [[ "$ev" == transitioning && -n "$WATCH_LAST" ]]; then
        line=$(jq -c --argjson m "$m" \
            '. + {event: $m.event, volume: ($m.volume // .volume), paused: $m.paused,
                  position: $m.position, duration: $m.duration, media: $m.media,
                  ready: $m.ready, ended: $m.ended}' <<<"$WATCH_LAST" 2>/dev/null) || return 0
        WATCH_LAST=$line
        watch_print "$line"
        return 0
    fi
    f=$(player_state "$id")
    queue_snapshot "$id"
    line=$(jq -c --argjson m "$m" --argjson queue "$QUEUE_JSON" \
        --argjson cpu "${WATCH_CPU:-null}" --argjson mem "${WATCH_MEM:-null}" \
        "$WATCH_MERGE" "$f" 2>/dev/null) || return 0
    [[ -n "$line" ]] || return 0
    WATCH_LAST=$line
    watch_print "$line"
}

watch_print() {
    local line=$1
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        printf '%s\n' "$line" 2>/dev/null || watch_bail
    else
        jq -r '"\(.event) \(.position // "-")s/\(.duration // "-")s, volume \(.volume // "-")"
               + (if .paused then ", paused" else "" end)
               + (if .ended then ", " + .ended else "" end)
               + (if .reason then ", " + .reason else "" end)
               + ": " + (.title // .url // .id)' <<<"$line" 2>/dev/null || watch_bail
    fi
}

# One connection, start to EOF. Returns 0 if it got as far as a snapshot (so the caller
# reconnects at once, for the next track), 1 if mpv refused or was not there.
watch_connect() {
    local id=$1 pid=$2 sock=$3 line ev got=0 ticks=$RES_STRIDE p
    WATCH_FIFO="$STATE_DIR/watch-$$.out"
    rm -f "$WATCH_FIFO" "$STATE_DIR/watch-$$.in" "$STATE_DIR/watch-$$.tick" 2>/dev/null
    mkfifo "$STATE_DIR/watch-$$.in" "$WATCH_FIFO" 2>/dev/null || return 1
    exec 3<>"$STATE_DIR/watch-$$.in"
    rm -f "$STATE_DIR/watch-$$.in"
    for p in "${WATCH_OBSERVE[@]}"; do
        printf '{"command":["observe_property",1,"%s"]}\n' "$p" >&3
    done
    "${NC_UNIX[0]}" -U "$sock" <&3 >"$WATCH_FIFO" 2>/dev/null &
    WATCH_NC_PID=$!
    exec 3>&-
    # THE CONNECTION ENDS WHEN THIS TRACK'S MPV DOES, whatever the client makes of it. BSD and
    # OpenBSD nc leave when the peer closes; nmap's ncat does not while its stdin is still open —
    # and the FIFO above holds it open on purpose — so under ncat this loop sat on a dead
    # connection: no next track, and no `end` once the player was gone. ncat's -i would end it,
    # but -i is an idle timeout and a paused player is idle. Measured on Debian trixie, ncat
    # 7.95, 2026-09-26; Debian's ncat also takes over /usr/bin/nc through alternatives, so the
    # nc branch of resolve_nc_unix can be ncat too. So the end is decided here, for every
    # client, and never by asking which client it is — in two layers:
    #
    #   - mpv SAYS it is leaving: every track is its own mpv, so its end-file (the
    #     `transitioning` line below) is that mpv's last word, and the client is taken down on
    #     it. That is the path every track change and every normal end takes, at once.
    #   - a guard for the mpv that never got to say it (kill -9, a crash): it polls the one mpv
    #     in the player's group (tracks run one after another) and takes the client down when
    #     that pid is gone. Its tick is `read -t 1` on a FIFO nobody writes — bash 3.2's read
    #     takes whole seconds only, and a builtin tick forks nothing, where the `sleep 0.2`
    #     it replaced cost ~2% of a core for the whole of a track (measured, macOS, 2026-09-26).
    #     A second is the price of the crash case only.
    #
    # No mpv found means it is already gone and the connect was refused; nothing to guard.
    p=$(pgrep -g "$pid" -x mpv 2>/dev/null | head -1)
    if [[ -n "$p" ]] && mkfifo "$STATE_DIR/watch-$$.tick" 2>/dev/null; then
        (
            exec 4<>"$STATE_DIR/watch-$$.tick"
            rm -f "$STATE_DIR/watch-$$.tick"
            while kill -0 "$p" 2>/dev/null && kill -0 "$WATCH_NC_PID" 2>/dev/null; do
                read -r -t 1 -u 4 _ || :
            done
            kill "$WATCH_NC_PID" 2>/dev/null
        ) </dev/null >/dev/null 2>&1 &
        WATCH_GUARD_PID=$!
    fi
    # The event name arrives in front of its line so the stride below costs no jq.
    while IFS=$'\037' read -r ev line; do
        case "$ev" in
        snapshot)
            got=1
            WATCH_BEATS=0
            watch_sample_res "$pid"
            ;;
        heartbeat)
            WATCH_BEATS=$((WATCH_BEATS + 1))
            ((WATCH_BEATS % ticks)) || watch_sample_res "$pid"
            ;;
        esac
        watch_emit "$id" "$line" "$ev"
        # mpv's last word on this connection (see the guard above): take the client down now,
        # and the loop ends on the EOF that follows.
        [[ "$ev" == transitioning ]] && kill "$WATCH_NC_PID" 2>/dev/null
    done < <(jq -n -r --unbuffered --argjson want "${#WATCH_OBSERVE[@]}" "$WATCH_JQ" <"$WATCH_FIFO" 2>/dev/null)
    wait "$WATCH_NC_PID" 2>/dev/null || true
    WATCH_NC_PID=""
    if [[ -n "$WATCH_GUARD_PID" ]]; then
        kill "$WATCH_GUARD_PID" 2>/dev/null
        wait "$WATCH_GUARD_PID" 2>/dev/null || true
        WATCH_GUARD_PID=""
    fi
    rm -f "$WATCH_FIFO" 2>/dev/null
    WATCH_FIFO=""
    ((got))
}

do_watch() {
    local want_id=$1
    require_live_target "$want_id"
    local id=$RESOLVED_ID pid sock f tomb
    f=$(player_state "$id")
    pid=$(jq -r '.pid // empty' "$f" 2>/dev/null) || pid=""
    sock=$(player_sock "$id")
    ensure_state_dir
    trap watch_bail PIPE TERM INT HUP
    # The line `end` falls back to when the player dies before mpv ever answered (a handle
    # the engine could not resolve): the record as it stood, nothing live.
    WATCH_LAST=$(jq -c --argjson queue null --argjson cpu null --argjson mem null \
        --argjson m '{"event":"end","paused":null,"position":null,"duration":null,"ready":false,"media":{"video_codec":null,"width":null,"height":null,"fps":null,"video_bitrate":null,"audio_codec":null,"audio_bitrate":null,"sample_rate":null,"channels":null}}' \
        "$WATCH_MERGE" "$f" 2>/dev/null) || WATCH_LAST=""
    # Poll the gap on a 0.2 s tick: each turn is a refused connect or a pgrep, and the gap is
    # a resolve — seconds, not minutes.
    while group_alive "$pid"; do
        if [[ -S "$sock" ]] && watch_connect "$id" "$pid" "$sock"; then
            continue
        fi
        sleep 0.2
    done
    # The reaper writes the tombstone (a failure's exit code and reason) as it removes the
    # record; a player that finished or was stopped leaves none, and says so with nulls.
    reap_dead_players
    collect_failed_players
    tomb=$(jq -c --arg i "$id" '[.[] | select(.id == $i)][0]' <<<"$FAILED_JSON" 2>/dev/null) || tomb=null
    [[ -n "$WATCH_LAST" ]] || WATCH_LAST=$(jq -nc --arg id "$id" '{status: "watch", id: $id}')
    watch_print "$(jq -c --argjson t "${tomb:-null}" \
        'del(.ended) + {event: "end", exit_code: ($t.exit_code // null), reason: ($t.reason // null)}' \
        <<<"$WATCH_LAST" 2>/dev/null)"
    exit 0
}

# Append to a running player's queue. The items were parsed and validated in the parent
# before we got here, so everything left to fail is the store itself.
#
# It shares require_live_target with the socket verbs, and therefore their exit taxonomy —
# no target or an ambiguous one is 4, because the call was well formed and did not take
# effect. What it does NOT share is the socket: a queue is the player's own state on disk,
# and mpv is never told there is a list.
do_enqueue() {
    local want_id=$1
    require_live_target "$want_id"

    local id added
    id=$RESOLVED_ID
    if ! queue_append "$id" "$QUEUE_ITEMS_JSON"; then
        [[ "$QUEUE_EDIT_ERR" == "locked" ]] && queue_edit_fail locked "the queue of player $id is locked by another process"
        [[ "$OUTPUT_MODE" == "json" ]] && echo '{"status":"error","reason":"queue_failed"}' || echo "failed to enqueue" >&2
        exit 4
    fi
    added=$(printf '%s' "$QUEUE_ITEMS_JSON" | jq 'length' 2>/dev/null) || added=0
    queue_snapshot "$id"
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --argjson added "$added" --argjson queue "$QUEUE_JSON" \
            '{status: "ok", id: $id, added: $added, queue: $queue}' | with_undo
    else
        printf 'queued %s (player %s)\n' "$added" "$id"
    fi
    exit 0
}

# Skip to the next track. The POSITION MOVES HERE, in the parent, and only then is the child
# signalled — so this envelope reports a queue it read rather than one it predicted, the same
# rule the socket verbs follow for paused/position. The child's own advance is a
# compare-and-swap against the position it played (queue_advance_from), which is what makes
# the two orders safe when a track ends in the same instant.
do_next() {
    local want_id=$1
    require_live_target "$want_id"

    local id pid
    id=$RESOLVED_ID
    if ! queue_bump "$id"; then
        # Nothing after the current track — a well-formed call that did not take effect (4),
        # never a usage error and never a silent no-op reported as success.
        [[ "$OUTPUT_MODE" == "json" ]] && echo '{"status":"error","reason":"queue_empty"}' || echo "nothing queued after the current track" >&2
        exit 4
    fi
    # SIGUSR1 goes to the CHILD's pid, never to the process group: USR1's default
    # disposition is to terminate, so a group-wide signal would kill mpv out from under the
    # loop it is supposed to advance. If the child is gone the position still moved, which
    # is why the envelope reports what is on disk rather than "skipped".
    pid=$(jq -r '.pid // empty' "$(player_state "$id")" 2>/dev/null) || pid=""
    is_live_pid "$pid" && kill -USR1 "$pid" 2>/dev/null
    queue_snapshot "$id"
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --argjson queue "$QUEUE_JSON" '{status: "ok", id: $id, queue: $queue}'
    else
        printf 'skipped to track %s (player %s)\n' \
            "$(printf '%s' "$QUEUE_JSON" | jq -r '(.pos + 1) | tostring' 2>/dev/null)" "$id"
    fi
    exit 0
}

# The WHOLE queue, which is the one thing --status cannot give: its tail is capped
# (QUEUE_UPCOMING_MAX) because it prints one record per live player, and a caller that wants
# to act on a track has to be able to see the track. Uncapped here because this envelope is
# about ONE queue and the caller asked for it by name.
#
# Read WITHOUT the lock, for the reason queue_snapshot documents: a reader sees the file
# before an mv or after it, never a half-written one. So a --queue-show is never a reason for
# the child to wait at a track boundary.
#
# The items are what the queue HOLDS — {engine, url, title, duration} — plus the index they
# sit at, which is the handle every rewrite verb takes. Deliberately no `id`: read_queue_items
# normalises every accepted shape down to those four fields, so an `id` here would be a key
# that is always null. And deliberately no per-item `state`: `pos` already says which one is
# playing, and a second spelling of one fact is a second thing that can disagree.
do_queue_show() {
    local want_id=$1
    require_live_target "$want_id"

    local id qf out
    id=$RESOLVED_ID
    qf=$(player_queue "$id")
    # Every detached player writes a queue file before it launches (a lone handle is a queue
    # of one), so a live player with no queue file is a broken state dir rather than a state
    # a caller has to branch on — it gets the same "did not take effect" 4 as the rest.
    if [[ ! -f "$qf" ]] || ! out=$(jq -c '{status: "ok", pos: .pos, len: (.items | length),
              items: [.items | to_entries[]
                      | {index: .key, engine: .value.engine, url: .value.url,
                         title: .value.title, duration: .value.duration}]}' "$qf" 2>/dev/null); then
        [[ "$OUTPUT_MODE" == "json" ]] && echo '{"status":"error","reason":"queue_failed"}' || echo "could not read the queue" >&2
        exit 4
    fi
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        printf '%s' "$out" | jq -c --arg id "$id" '{status, id: $id, pos, len, items}'
    else
        # The index is printed because it is the ARGUMENT the rewrite verbs take, and the
        # playing track is marked because `pos` on the header line is a number the reader
        # would otherwise have to count rows to use. Same two columns ting-playlist --show
        # prints, for the same reason: a list you are going to act on by index shows it.
        printf '%s' "$out" | jq -r --arg id "$id" \
            '"queue \(.pos + 1)/\(.len) (player \($id))",
             (.pos as $p | .items[]
              | "  \(if .index == $p then ">" else " " end) [\(.index)] \(.title // .url)")'
    fi
    exit 0
}

# The three rewrites, which differ only in the jq program and what they say they did. Each
# one names the item it acted on in the envelope, because a caller that pinned a url is owed
# the confirmation that the pin is what moved.
#
# `queue` is queue_snapshot's whole object and not a shortened copy of it: --enqueue and
# --next already publish {pos, len, next, upcoming} under that key, and a same-named object
# with fewer fields is how a contract drifts without anybody deciding to change it.
queue_edit_fail() {
    local reason=$1 human=$2
    [[ "$OUTPUT_MODE" == "json" ]] && printf '{"status":"error","reason":"%s"}\n' "$reason" || echo "$human" >&2
    exit 4
}

do_queue_rm() {
    local idx=$1 want_id=$2
    require_live_target "$want_id"

    local id
    id=$RESOLVED_ID
    if ! queue_edit "$id" "$idx" '.items = (.items[0:$i] + .items[($i + 1):])'; then
        case "$QUEUE_EDIT_ERR" in
        locked) queue_edit_fail locked "the queue of player $id is locked by another process" ;;
        queue_range) queue_edit_fail queue_range "index $idx is not a waiting track in this queue" ;;
        queue_stale) queue_edit_fail queue_stale "index $idx is not the track --expect-url named; re-read the queue" ;;
        *) queue_edit_fail queue_failed "failed to rewrite the queue" ;;
        esac
    fi
    queue_snapshot "$id"
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --argjson index "$idx" --arg url "$QUEUE_EDIT_URL" --argjson queue "$QUEUE_JSON" \
            '{status: "ok", id: $id, removed: {index: $index, url: $url}, queue: $queue}' | with_undo
    else
        printf 'removed track %s (player %s)\n' "$idx" "$id"
    fi
    exit 0
}

# One verb for "up one", "down one" and "to the front", because they are one operation with
# three arguments. A --queue-swap would be more general than any caller needs and would need
# two pins to be safe; this needs one, and the arithmetic that makes "move to N" land at N
# whichever direction it came from is four characters of jq.
do_queue_mv() {
    local idx=$1 to=$2 want_id=$3
    require_live_target "$want_id"

    local id
    id=$RESOLVED_ID
    if ! queue_edit "$id" "$idx" \
        '.items as $a | $a[$i] as $it | ($a[0:$i] + $a[($i + 1):]) as $rest
         | .items = ($rest[0:$t] + [$it] + $rest[$t:])' "$to"; then
        case "$QUEUE_EDIT_ERR" in
        queue_range) queue_edit_fail queue_range "index $idx and destination $to must both be waiting tracks in this queue" ;;
        queue_stale) queue_edit_fail queue_stale "index $idx is not the track --expect-url named; re-read the queue" ;;
        *) queue_edit_fail queue_failed "failed to rewrite the queue" ;;
        esac
    fi
    queue_snapshot "$id"
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --argjson index "$idx" --argjson to "$to" --arg url "$QUEUE_EDIT_URL" \
            --argjson queue "$QUEUE_JSON" \
            '{status: "ok", id: $id, moved: {index: $index, to: $to, url: $url}, queue: $queue}'
    else
        printf 'moved track %s to %s (player %s)\n' "$idx" "$to" "$id"
    fi
    exit 0
}

# --queue-mv to pos+1 plus --next, and the reason it is ONE verb rather than those two calls:
# between them the lock is released, and a track ending in that window advances pos past the
# slot the move just filled — the player skips the song the caller asked to hear next. One
# jq program under one lock makes the pair atomic, so the only orders that exist are
# before-it and after-it.
do_queue_jump() {
    local idx=$1 want_id=$2
    require_live_target "$want_id"

    local id pid
    id=$RESOLVED_ID
    # $t is unused by the program — the destination IS pos+1, read inside the lock, because a
    # destination computed outside it would be computed against a pos that can move.
    if ! queue_edit "$id" "$idx" \
        '(.pos + 1) as $t
         | .items as $a | $a[$i] as $it | ($a[0:$i] + $a[($i + 1):]) as $rest
         | .items = ($rest[0:$t] + [$it] + $rest[$t:])
         | .pos = $t'; then
        case "$QUEUE_EDIT_ERR" in
        queue_range) queue_edit_fail queue_range "index $idx is not a waiting track in this queue" ;;
        queue_stale) queue_edit_fail queue_stale "index $idx is not the track --expect-url named; re-read the queue" ;;
        *) queue_edit_fail queue_failed "failed to rewrite the queue" ;;
        esac
    fi
    # do_next's tail, and it has to be: SIGUSR1 goes to the CHILD's pid and never to the
    # process group, because USR1's default disposition is to terminate and a group-wide
    # signal would kill mpv out from under the loop it is supposed to advance. The child's
    # `next` branch then re-reads the queue rather than advancing it, which is what makes the
    # position this function already wrote the one that stands.
    pid=$(jq -r '.pid // empty' "$(player_state "$id")" 2>/dev/null) || pid=""
    is_live_pid "$pid" && kill -USR1 "$pid" 2>/dev/null
    queue_snapshot "$id"
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --argjson index "$idx" --arg url "$QUEUE_EDIT_URL" --argjson queue "$QUEUE_JSON" \
            '{status: "ok", id: $id, playing: {index: ($queue.pos), url: $url}, queue: $queue}'
    else
        printf 'jumped to track %s (player %s)\n' "$idx" "$id"
    fi
    exit 0
}

do_queue_clear() {
    local want_id=$1
    require_live_target "$want_id"

    local id before
    id=$RESOLVED_ID
    before=$(jq -r '(.items | length) - (.pos + 1)' "$(player_queue "$id")" 2>/dev/null) || before=0
    [[ -n "$before" ]] || before=0
    if ! queue_clear_tail "$id"; then
        [[ "$QUEUE_EDIT_ERR" == "locked" ]] && queue_edit_fail locked "the queue of player $id is locked by another process"
        queue_edit_fail queue_failed "failed to rewrite the queue"
    fi
    queue_snapshot "$id"
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --argjson cleared "$before" --argjson queue "$QUEUE_JSON" \
            '{status: "ok", id: $id, cleared: $cleared, queue: $queue}' | with_undo
    else
        printf 'cleared %s waiting track(s) (player %s)\n' "$before" "$id"
    fi
    exit 0
}

# --undo --owner PID: put the queue back the way that owner's last queue write found it, or
# say why not. Checked under the queue lock, strictly (a timeout is `locked`, never an
# unlocked restore), in the order a caller can act on: no copy, a closed window, a queue
# that has moved since. The last one is the common one, and it is the RIGHT answer: the
# player rewrites `pos` at every track boundary, and putting back the bytes from before it
# would rewind the queue into a replay.
#
# No --id: the copy names its player. A player that has stopped took its copies with it
# (rm_player_files), so that case is undo_none, not stale.
do_queue_undo() {
    local slot id="" verb deadline qf line
    slot=$(undo_slot "$UNDO_OWNER")
    if ((UNDO_DISCARD)); then
        local had=false
        [[ -e "$slot" ]] && had=true
        rm -rf "$slot" 2>/dev/null || true
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            jq -nc --argjson d "$had" '{status: "ok", discarded: $d}'
        fi
        exit 0
    fi
    [[ -f "$slot/meta.json" && -f "$slot/id" ]] ||
        queue_edit_fail undo_none "nothing to undo for owner $UNDO_OWNER"
    IFS= read -r id <"$slot/id" || true
    line=$(jq -r '[.verb, (.deadline | tostring)] | join("\u001f")' "$slot/meta.json" 2>/dev/null) || line=""
    IFS=$'\037' read -r verb deadline <<<"$line"
    [[ -n "$id" && "$deadline" =~ ^[0-9]+$ ]] ||
        queue_edit_fail queue_failed "the undo copy for owner $UNDO_OWNER is not readable: $slot"
    qf=$(player_queue "$id")
    lock_queue_state "$id" || queue_edit_fail locked "the queue of player $id is locked by another process"
    if (($(date +%s) >= deadline)); then
        unlock_queue_state "$id"
        queue_edit_fail undo_expired "the undo window for owner $UNDO_OWNER has closed"
    fi
    if ! [[ -f "$qf" ]] || ! cmp -s "$qf" "$slot/0.post"; then
        unlock_queue_state "$id"
        queue_edit_fail undo_stale "the queue of player $id changed after the write; nothing was undone"
    fi
    if ! { cp "$slot/0.pre" "$qf.tmp.$$" 2>/dev/null && mv -f "$qf.tmp.$$" "$qf"; }; then
        rm -f "$qf.tmp.$$" 2>/dev/null || true
        unlock_queue_state "$id"
        queue_edit_fail queue_failed "failed to rewrite the queue"
    fi
    rm -rf "$slot" 2>/dev/null || true
    unlock_queue_state "$id"
    queue_snapshot "$id"
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --arg verb "$verb" --argjson queue "$QUEUE_JSON" \
            '{status: "ok", undone: $verb, id: $id, queue: $queue}'
    else
        printf 'undid --%s (player %s)\n' "$verb" "$id"
    fi
    exit 0
}

# Turn repeat on or off on a running player. A STATE verb rather than a socket verb, and
# that is the whole of the design: the loop mode's home is players/<id>.json, because every
# track in a queue gets a FRESH mpv (detached_child_loop) and a value that lived only in the
# running process would be lost at the first boundary. The socket write below is what makes
# it take effect on the track playing RIGHT NOW; the disk write is what makes it true.
#
# So the exit taxonomy is --enqueue's, not --pause's: 4 for no target or an ambiguous one,
# 0 otherwise — a socket that would not answer does NOT fail the call, because the intent is
# already recorded and the next track honours it. It also means this verb needs no nc: it
# asks for one (through ipc_command) and shrugs when there is none.
do_set_loop() {
    local want=$1 want_id=$2
    require_live_target "$want_id"

    local id sf tmp prop ok=1
    id=$RESOLVED_ID
    sf=$(player_state "$id")
    tmp="$sf.tmp.$$"
    # The same lock the title backfill takes, for the same reason: both are read-modify-write
    # on one file with no version check, so the loser of a race silently drops a field.
    lock_player_state "$id" || true
    if jq --arg l "$want" '.loop = $l' "$sf" >"$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
        mv -f "$tmp" "$sf" || ok=0
    else
        rm -f "$tmp" 2>/dev/null || true
        ok=0
    fi
    unlock_player_state "$id"
    if ((! ok)); then
        # The record IS the contract here, so a record that did not change is a call that did
        # not take effect — 4, the same as a socket mpv refused.
        [[ "$OUTPUT_MODE" == "json" ]] && echo '{"status":"error","reason":"state_failed"}' || echo "failed to record the loop mode" >&2
        exit 4
    fi

    case "$want" in
    one) prop=inf ;;
    *) prop=no ;;
    esac
    ipc_command "$(player_sock "$id")" \
        "$(printf '{"command":["set_property","loop-file","%s"],"request_id":1}' "$prop")" || true

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --arg loop "$want" '{status: "ok", id: $id, loop: $loop}'
    else
        printf 'repeat %s (player %s)\n' "$want" "$id"
    fi
    exit 0
}

