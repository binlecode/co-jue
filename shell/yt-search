#!/usr/bin/env bash
# yt-search — the YouTube SEARCH ENGINE: query -> result envelope. Agent-facing.
#
# One half of the youtube engine pair (`yt-search` + `yt-resolve`); the player
# (`t-play`) is source-agnostic and knows neither. This file owns everything that is
# YouTube-specific about searching: the yt-dlp invocation, the cookie decision, the
# result shaping, and the duration formatter. It has NO playback, lifecycle, or mpv
# logic and never starts a process that outlives it. See docs/ARCHITECTURE.md「命令拓扑」.
#
# It used to be a gating wrapper that exec'd the core. The gate and the implementation
# are merged here because after the engine/player split there is no longer a second
# caller to gate against: this file IS the search verb. ARCH-cli-contract.md「门模型」
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features; guard empty-array
# expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). ARCHITECTURE.md「可移植性契约」.

# Resolve this script's OWN symlink chain before looking for its siblings. The PATH entry
# is a symlink into a checkout that can live anywhere, so `dirname $0` is the symlink's
# directory, not the code's. This walks the chain to the real file and takes ITS directory.
#
# `cd -P` / `pwd -P`, not the logical forms: a relative symlink resolves to something like
# ~/bin/../../../elsewhere/shell, and logical `cd` would normalise those `..` textually
# against ~/bin instead of against what ~/bin actually points at. Physical resolution is the
# only one that lands in the right place. bash 3.2 has no `readlink -f`, hence the loop.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)

# THE version of the whole suite, declared once — in a data file, not in code. The engines
# and the player are independent executables that share no library, so a shell variable in
# any one of them would make the others ask IT for the version, which is the wrong
# dependency direction for a player that must not know its engines. A one-line file each
# reads keeps "one fact, one place" with zero code sharing. CLAUDE.md § one fact, one place.
if [[ -r "$SCRIPT_DIR/../VERSION" ]]; then
    UT_VERSION=$(cat "$SCRIPT_DIR/../VERSION")
else
    UT_VERSION="unknown"
fi

# CONFIGURATION — the chain is flag > environment > the user's config > the shipped defaults
# in `<checkout>/config`, which is where every default value in the suite is declared once.
# Duplicated VERBATIM in all ten entry points — see the same block in t-play for why, and
# ARCH-cli-contract.md「配置面」 for the keys.
TING_CONFIG="${TING_CONFIG:-${UT_CONFIG:-}}"
if [[ -z "$TING_CONFIG" ]]; then
    if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/ting/config" ]]; then
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ting/config"
    else
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/uting/config"
    fi
fi
UT_CONFIG="$TING_CONFIG"
for _v in STATE_DIR ENGINE_DIR HISTORY THEME ACCENT VOLUME LANG IMAGE KEYS RESOURCE RESOURCE_TICKS BRAND ASCII SYNC PLAY_QUALITY VIZ_STYLE VIZ_COLOR DEAD_KEEP DEFAULT_ENGINE MODE_CYCLE SORT_CYCLE THEME_CYCLE QUALITY_CYCLE LOOP_CYCLE; do
    eval "[[ -n \"\${TING_$_v+x}\" ]] && UT_$_v=\"\$TING_$_v\" || true"
    eval "[[ -n \"\${UT_$_v+x}\" && -z \"\${TING_$_v+x}\" ]] && TING_$_v=\"\$UT_$_v\" || true"
done
UT_DEFAULTS="$SCRIPT_DIR/../config"
ut_read_config() {
    local file="$1" line key val _ting_k _ut_k
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        while [[ "$line" == [[:space:]]* ]]; do line="${line#[[:space:]]}"; done
        while [[ "$line" == *[[:space:]] ]]; do line="${line%[[:space:]]}"; done
        [[ -n "$line" && "$line" == *=* ]] || continue
        key="${line%%=*}"
        val="${line#*=}"
        while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
        while [[ "$val" == [[:space:]]* ]]; do val="${val#[[:space:]]}"; done
        [[ "$key" =~ ^(TING|UT|YT|BILI|NE)_[A-Z0-9_]+$ ]] || continue
        case "$key" in
        TING_CONFIG | TING_DEFAULTS | TING_ENGINE_DIR | TING_VERSION | UT_CONFIG | UT_DEFAULTS | UT_ENGINE_DIR | UT_VERSION | YT_IPC_SOCK | YT_DETACHED | YT_PLAYER_ID | YT_DETACHED_LOG) continue ;;
        esac
        if [[ ${#val} -ge 2 ]] && { [[ "$val" == \"*\" ]] || [[ "$val" == \'*\' ]]; }; then
            val="${val#?}"
            val="${val%?}"
        fi
        [[ "$val" == "~/"* ]] && val="$HOME/${val#\~/}"
        if [[ "$key" == TING_* ]]; then
            _ut_k="UT_${key#TING_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ut_k+x}\" ]] || $_ut_k=\$val"
        elif [[ "$key" == UT_* ]]; then
            _ting_k="TING_${key#UT_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ting_k+x}\" ]] || $_ting_k=\$val"
        else
            eval "[[ -n \"\${$key+x}\" ]]" && continue
            eval "$key=\$val"
        fi
    done < "$file"
}
# FAIL FAST AND SAY WHY. There is deliberately no escape hatch for --version or --help: they
# were tried, and letting execution continue past a missing defaults file replaced this one
# clear line with `YT_ASCII_VO: unbound variable` from set -u somewhere further down. A
# checkout missing part of itself is not a dependency gate (yt-dlp, jq and mpv still answer
# --version without being installed) — it is a broken checkout, and 2 is the exit code for a
# failure that is not the caller's usage error.
if [[ ! -r "$UT_DEFAULTS" ]]; then
    printf '%s: cannot read the shipped defaults at %s — that file declares every default value in the suite and is not optional\n' \
        "$(basename "$0")" "$UT_DEFAULTS" >&2
    exit 2
fi
ut_read_config "$UT_CONFIG"
ut_read_config "$UT_DEFAULTS"

# The engine's own name, as it appears in the envelope AND as the command prefix its two
# executables carry. Name == prefix is deliberate: it lets `t-play --engine yt` find
# `yt-resolve` by string concatenation, with no name->command registry to keep in sync in
# both the player and the TUI. docs/ARCHITECTURE.md「命令拓扑」.
ENGINE_NAME="yt"

# ==============================================================================
# 1. SETTINGS
# ==============================================================================


# Cookies (login) are ON by default (browser: chrome) so login-gated / members / age-
# restricted videos — invisible to an anonymous client — are searchable. Verify the browser
# profile exists on this platform; if not, run anonymously rather than break, so a machine
# without the configured browser degrades gracefully to no-login.
# Set YT_COOKIE_BROWSER=none to force anonymous-only (skips the keychain read).
# The browser's cookie DB should be readable (Chrome ideally closed) for a clean extraction.
COOKIE_ARGS=()
if [[ -n "${YT_COOKIE_BROWSER:-}" && "$YT_COOKIE_BROWSER" != "none" ]]; then
    browser_exists=0
    case "$YT_COOKIE_BROWSER" in
    chrome|chromium|brave)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            if [[ -d "$HOME/Library/Application Support/Google/Chrome" || -d "$HOME/Library/Application Support/BraveSoftware" || -d "$HOME/Library/Application Support/Chromium" ]]; then
                browser_exists=1
            fi
        else
            if [[ -d "$HOME/.config/google-chrome" || -d "$HOME/.config/chromium" || -d "$HOME/.config/BraveSoftware" ]]; then
                browser_exists=1
            fi
        fi
        ;;
    safari)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Safari" ]] && browser_exists=1
        fi
        ;;
    firefox)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Firefox" ]] && browser_exists=1
        else
            [[ -d "$HOME/.mozilla/firefox" ]] && browser_exists=1
        fi
        ;;
    edge)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Microsoft Edge" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/microsoft-edge" ]] && browser_exists=1
        fi
        ;;
    opera)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/com.operasoftware.Opera" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/opera" ]] && browser_exists=1
        fi
        ;;
    vivaldi)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Vivaldi" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/vivaldi" ]] && browser_exists=1
        fi
        ;;
    *)
        browser_exists=0
        ;;
    esac

    if ((browser_exists)); then
        COOKIE_ARGS=(--cookies-from-browser "$YT_COOKIE_BROWSER")
    fi
fi

# THE FETCH CEILING, in rows and cross-engine — see the same knob in bili-search for why it
# is counted in rows rather than pages. Here it clamps the `ytsearchN` count: yt-dlp owns
# YouTube's continuation paging, so this engine has no page loop of its own, and before this
# knob a fat `-n` was bounded only by what the site would eventually stop sending.

# The `-n` default. Cross-engine: a caller who wants a different result count by default
# wants it from whichever source they asked. ARCH-cli-contract.md「配置面」.
NUM_RESULTS=$UT_SEARCH_RESULTS
MIN_DURATION=0
MAX_DURATION=0
# The `-s` default, cross-engine like `-n`.
SORT_FIELD="$UT_SORT_FIELD"
COLOR_MODE="auto"
OUTPUT_MODE="list"
QUERY=""
FILTERED_JSON=""

# Glyph fallback shares ONE switch with ting (YT_ASCII, legacy alias YT_TUI_ASCII): a
# terminal whose font can't draw ♫ can't draw it in either surface, and a non-UTF-8 locale
# (bare cron/launchd) would emit mojibake. Empty = drop the glyph, as ting does.
MUSIC_CHAR="♫"
case "${YT_ASCII:-${YT_TUI_ASCII:-}}" in
1 | true | yes | on) MUSIC_CHAR="" ;;
"")
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8* | *utf-8* | *UTF8* | *utf8*) ;;
    *) MUSIC_CHAR="" ;;
    esac
    ;;
esac

# ==============================================================================
# 2. HELPERS
# ==============================================================================

err() {
    local red='' reset=''
    case "${COLOR_MODE:-auto}" in
    always)
        red=$'\033[31m'
        reset=$'\033[0m'
        ;;
    auto)
        if [[ -t 2 ]]; then
            red=$'\033[31m'
            reset=$'\033[0m'
        fi
        ;;
    never) ;;
    esac
    echo "${red}Error:${reset} $*" >&2
}

die() {
    err "$@"
    exit 1
}

# A missing tool is not a malformed call: `die` is exit 1 (the argv is wrong — fix it),
# `die_dep` is exit 2 (the argv was fine; the machine is missing something no rewrite of the
# argv will supply). An agent that read 1 here would loop editing its own parameters against
# a wall. docs/ARCH-cli-contract.md「退出码、TTY、依赖」.
die_dep() {
    err "required command not found: $1"
    exit 2
}

is_non_negative_int() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

validate_enum() {
    local value=$1
    shift
    local allowed
    for allowed in "$@"; do
        if [[ "$value" == "$allowed" ]]; then
            return 0
        fi
    done
    return 1
}

require_cmd() {
    local cmd=$1
    command -v "$cmd" >/dev/null 2>&1 || die_dep "$cmd"
}

require_deps() {
    local cmd
    for cmd in "$@"; do
        require_cmd "$cmd"
    done
}

# The ONE implementation of duration formatting: seconds -> "[Nd ]HHh:MMm:SSs". It is a
# jq prelude, not a bash function, because every consumer is already shaping JSON with jq —
# a bash version meant forking jq once per row just to read a field back out (25 results =
# 50+ forks, measured 40x slower than one jq program) and keeping two copies of the same
# padding logic. An unknown duration yields NULL rather than a fake "00h:00m:00s", so each
# caller decides how to render it (a live stream has no duration). ARCH-engine.md「搜索子系统」.
JQ_PRELUDE='
def p2: tostring | if length < 2 then "0" + . else . end;
def fmt_dur:
  if type != "number" then null
  else (. | floor) as $t
    | ($t / 86400 | floor) as $d
    | (($t % 86400) / 3600 | floor) as $h
    | (($t % 3600) / 60 | floor) as $m
    | ($t % 60) as $s
    | (if $d > 0 then "\($d)d " else "" end) + "\($h | p2)h:\($m | p2)m:\($s | p2)s"
  end;
def oneline: if type != "string" then "" else gsub("\\s+"; " ") | sub("^ "; "") | sub(" $"; "") end;
# THE COVER, normalised to one directly-GETtable https URL — the site field name stops here.
# A caller (ting, or an agent) must never learn what `thumbnails[]` is: that is site
# knowledge, and site knowledge lives in an engine (CLAUDE.md).
#
# SMALLEST AT OR ABOVE 200px WIDE, not the biggest and not the first. A flat search entry
# really does carry two sizes (measured 2026-09-03: 360x202 and 720x404 on `lofi hip hop`,
# every row), which is what makes `.[0]` and `.[-1]` both wrong in a way only a real
# envelope shows. Below 200 there is nothing to be picky about: take the largest.
#
# WHY A FIXED THRESHOLD RATHER THAN THE RIGHT ONE: the right one depends on how many pixels
# a terminal cell is, and an engine cannot know that — a cell size is a rendering fact and
# belongs to whoever draws (this file must not learn it, the same way it must not learn what
# a cover is FOR). So the threshold is a policy, and 200 is where it pays: the same cover at
# 720px is 170KB of escape payload against 39KB at 360px, measured, for a picture the
# terminal is going to downsample anyway. On a terminal with a 16px-wide cell the box is
# 384px and a 360px source is very slightly upscaled — the honest cost of not making the
# engine ask a question about the display.
def pick_thumb:
  ((.thumbnails // []) | map(select((.url // "") != ""))) as $t
  | if ($t | length) == 0 then null
    else ( ([$t[] | select((.width // 0) >= 200)] | sort_by(.width) | first)
           // ($t | sort_by(.width // 0) | last) ).url
    end;
'

# Map captured yt-dlp output + exit code to the suite's stable reason taxonomy so an agent
# caller can branch on `reason` instead of string-matching raw extractor wording (which is
# not a contract and drifts across versions). The ENUM is the shared fact and lives in
# ARCH-cli-contract.md「数据契约」 — this is the yt-dlp-side reader of it; the player carries its own
# mpv-side reader. No member may be added here that the enum does not already have.
# `unknown` is the conservative default — never guess a cause we did not positively identify.
classify_yt_dlp_error() {
    local text=$1 rc=$2
    if ((rc == 130)); then
        echo "stopped_by_user"
        return
    fi
    # The browser's cookie store could not be read — before any request was made. First,
    # because it says nothing about the site: a store the calling terminal app is not allowed
    # to read (macOS privacy protection) is reported by yt-dlp's directory walk as "could not
    # find", and that looked like a search that fails for no reason.
    if grep -qiE 'could not (find|copy) [a-z]+ cookies? database|failed to decrypt|cannot decrypt|find-generic-password|keyring|keychain|\[Errno [0-9]+\][^:]*: .*(Cookies|cookies\.sqlite|binarycookies)' <<<"$text"; then
        echo "cookies"
        return
    fi
    if grep -qiE 'HTTP Error 403|[^a-z]403[^0-9]|Forbidden' <<<"$text"; then
        echo "forbidden"
        return
    fi
    if grep -qiE 'Video unavailable|Private video|has been removed|no longer available|does not exist|account.*terminated|members-only|Sign in to confirm' <<<"$text"; then
        echo "unavailable"
        return
    fi
    if grep -qiE 'Requested format is not available|No video formats|requested format|only images are available' <<<"$text"; then
        echo "format_unavailable"
        return
    fi
    # 429 lands in `network`, not `unknown`: it is a transport-level, RETRYABLE refusal, and
    # `network` is the enum member that already means "try again later". It is grouped here
    # rather than with `forbidden` (403) deliberately — 403 means these credentials never
    # work, 429 means not right now.
    if grep -qiE 'Temporary failure in name resolution|Failed to resolve|Name or service not known|Network is unreachable|Connection (refused|timed out|reset)|Could not connect|getaddrinfo|Timed out|Operation timed out|HTTP Error 429|Too Many Requests|Unable to download (webpage|API page|JSON metadata)' <<<"$text"; then
        echo "network"
        return
    fi
    echo "unknown"
}

# ── the cookie store, diagnosed ─────────────────────────────────────────────────────────
# yt-dlp words several different causes as ONE sentence. A folder the calling terminal app
# is not allowed into (macOS privacy protection) is walked as empty and reported "could not
# find … cookies database" — the same words as a browser that was never used, and the same
# command then works from another terminal. cookie_probe tells them apart by doing what
# yt-dlp does: list the browser's folder, find its newest cookie file, read one byte of it.
# `[ -r ]` would not do: it consults Unix permissions, and privacy protection sits above
# them. Local — no network, no Keychain. The paths are site knowledge, so each engine carries
# its own copy (ARCH-engine.md, the anonymous-fallback section).
COOKIE_STATE=""; COOKIE_PATH=""; COOKIE_ERR=""
cookie_denied() {
    COOKIE_ERR=$1
    if [[ "$1" == *"Operation not permitted"* && "$(uname -s)" == "Darwin" ]]; then
        COOKIE_STATE="blocked"
    else
        COOKIE_STATE="denied"
    fi
    return 0
}
cookie_probe() {
    COOKIE_STATE="unknown"; COOKIE_PATH=""; COOKIE_ERR=""
    local b=$1 root="" name="Cookies" as="$HOME/Library/Application Support" mac=0 f newest="" err
    if [[ "$(uname -s)" == "Darwin" ]]; then mac=1; fi
    case "$b" in
    chrome)   if ((mac)); then root="$as/Google/Chrome"; else root="$HOME/.config/google-chrome"; fi ;;
    chromium) if ((mac)); then root="$as/Chromium"; else root="$HOME/.config/chromium"; fi ;;
    brave)    if ((mac)); then root="$as/BraveSoftware/Brave-Browser"; else root="$HOME/.config/BraveSoftware/Brave-Browser"; fi ;;
    edge)     if ((mac)); then root="$as/Microsoft Edge"; else root="$HOME/.config/microsoft-edge"; fi ;;
    opera)    if ((mac)); then root="$as/com.operasoftware.Opera"; else root="$HOME/.config/opera"; fi ;;
    vivaldi)  if ((mac)); then root="$as/Vivaldi"; else root="$HOME/.config/vivaldi"; fi ;;
    firefox)  name="cookies.sqlite"
              if ((mac)); then root="$as/Firefox"; else root="$HOME/.mozilla/firefox"; fi ;;
    safari)   ((mac)) || return 0
              name="Cookies.binarycookies"
              root="$HOME/Library/Containers/com.apple.Safari/Data/Library/Cookies"
              if [[ ! -d "$root" ]]; then root="$HOME/Library/Cookies"; fi ;;
    *) return 0 ;;
    esac
    COOKIE_PATH=$root
    if [[ ! -e "$root" ]]; then COOKIE_STATE="missing"; return 0; fi
    if ! err=$(ls "$root" 2>&1 >/dev/null); then cookie_denied "$err"; return 0; fi
    # Newest wins because that is the profile yt-dlp itself picks when none is named.
    while IFS= read -r f; do
        if [[ -z "$newest" || "$f" -nt "$newest" ]]; then newest=$f; fi
    done < <(find "$root" -maxdepth 3 -type f -name "$name" 2>/dev/null)
    if [[ -z "$newest" ]]; then COOKIE_STATE="missing"; return 0; fi
    COOKIE_PATH=$newest
    if ! err=$(head -c1 "$newest" 2>&1 >/dev/null); then cookie_denied "$err"; return 0; fi
    COOKIE_STATE="readable"
    return 0
}
# The app to name in the fix. TERM_PROGRAM is what the terminal says it is; tmux and screen
# replace it with themselves, and then the honest answer is that we cannot tell.
terminal_app() {
    case "${TERM_PROGRAM:-}" in
    Apple_Terminal) echo "Terminal" ;;
    iTerm.app) echo "iTerm" ;;
    ghostty) echo "Ghostty" ;;
    vscode) echo "VS Code" ;;
    WezTerm) echo "WezTerm" ;;
    WarpTerminal) echo "Warp" ;;
    "" | tmux | screen)
        if [[ "${TERM:-}" == "xterm-kitty" ]]; then echo "kitty"; else echo "your terminal app"; fi ;;
    *) echo "$TERM_PROGRAM" ;;
    esac
}
# ONE line on stderr that says what was lost, why, and the fix. stderr and not the envelope:
# it is prose for a person, and the -j envelope keeps its shape (ARCH-cli-contract.md).
cookie_diagnosis() {
    local b=${YT_COOKIE_BROWSER:-} first="" app prog="yt-search" knob="YT_COOKIE_BROWSER"
    cookie_probe "$b"
    first=$(printf '%s\n' "$1" | grep -m1 'ERROR' | sed 's/^ERROR: //') || first=""
    case "$COOKIE_STATE" in
    blocked)
        app=$(terminal_app)
        printf '%s: no %s cookies: macOS blocks %s from reading them - grant it Full Disk Access (System Settings > Privacy & Security), restart it; or set %s=none\n' \
            "$prog" "$b" "$app" "$knob" ;;
    denied)
        printf '%s: no %s cookies: %s reading %s; or set %s=none\n' \
            "$prog" "$b" "${COOKIE_ERR##*: }" "$COOKIE_PATH" "$knob" ;;
    missing)
        printf '%s: no %s cookies: %s has no cookie database - sign in to it once; or set %s=none (looked under %s)\n' \
            "$prog" "$b" "$b" "$knob" "$COOKIE_PATH" ;;
    readable)
        case "$b" in
        firefox | safari)
            printf '%s: no %s cookies: %s; or set %s=none\n' \
                "$prog" "$b" "${first:-yt-dlp could not load them}" "$knob" ;;
        *)
            printf '%s: no %s cookies: they could not be decrypted - allow Keychain access to "%s Safe Storage" when macOS asks; or set %s=none\n' \
                "$prog" "$b" "$b" "$knob" ;;
        esac ;;
    *)
        printf '%s: no %s cookies: %s; or set %s=none\n' \
            "$prog" "$b" "${first:-yt-dlp could not load them}" "$knob" ;;
    esac
    return 0
}
# Run one yt-dlp command ("$@", cookie args NOT included) with the configured cookie store,
# and once more WITHOUT it when the store itself is what failed — only then, so a network
# error is not paid for twice. stdout is the command's; yt-dlp's stderr lands in ERR_FILE for
# the caller's classifier; the diagnosis goes to this process's stderr.
ytdlp_cookied() {
    local out="" rc=0
    if ((${#COOKIE_ARGS[@]} > 0)); then
        out=$("$@" "${COOKIE_ARGS[@]}" 2>"$ERR_FILE") || rc=$?
        if ((rc != 0)) || [[ -z "$out" ]]; then
            if [[ "$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")" == "cookies" ]]; then
                cookie_diagnosis "$(cat "$ERR_FILE" 2>/dev/null)" >&2
                rc=0
                out=$("$@" 2>"$ERR_FILE") || rc=$?
            fi
        fi
    else
        out=$("$@" 2>"$ERR_FILE") || rc=$?
    fi
    printf '%s' "$out"
    return "$rc"
}

# This process's own scratch dir: 0700, created lazily, removed however we exit. Lazily
# because -h / -V must answer without touching the filesystem, and process-level rather than
# a function `local` because the EXIT trap runs after the function has returned — a `local`
# would be out of scope there and abort under `set -u`.
#
# The engine no longer writes into the player's state dir: `players/` has exactly one owner
# (t-play), and an engine reaching into it was only ever an artefact of the two living in
# one file. Captions and error text are content, so 0700 rather than a bare /tmp path.
SCRATCH_DIR=""
cleanup_scratch() {
    [[ -n "$SCRATCH_DIR" ]] && rm -rf "$SCRATCH_DIR" 2>/dev/null
    return 0
}
trap cleanup_scratch EXIT

ensure_scratch() {
    [[ -n "$SCRATCH_DIR" ]] && return 0
    SCRATCH_DIR=$(mktemp -d "${TMPDIR:-/tmp}/yt-search.XXXXXX") || die "cannot create a scratch directory"
    chmod 700 "$SCRATCH_DIR" 2>/dev/null || true
}

# ==============================================================================
# 3. SEARCH
# ==============================================================================

fetch_results() {
    local cmd=(
        yt-dlp
        "ytsearch${NUM_RESULTS}:${QUERY}"
    )

    # Duration bounds are enforced CLIENT-SIDE (in the jq shaping below); --match-filter is
    # only a cheap server-side pre-filter. Reason: with --flat-playlist yt-dlp marks entries
    # "incomplete", so a filter on a field a flat entry doesn't carry (a live stream has no
    # duration) cannot decide and KEEPS the entry — verified: `-m 999999` still returned a
    # live result. The filter is also sent only when a bound was actually asked for; the old
    # unconditional "duration > 0" filtered nothing and only muddied the contract.
    local match_filter=""
    ((MIN_DURATION > 0)) && match_filter="duration > $MIN_DURATION"
    if ((MAX_DURATION > 0)); then
        [[ -n "$match_filter" ]] && match_filter+=" and "
        match_filter+="duration < $MAX_DURATION"
    fi
    [[ -n "$match_filter" ]] && cmd+=(--match-filter "$match_filter")

    cmd+=(
        --flat-playlist
        --dump-single-json
        -f ba
        --skip-download
        --no-warnings
        --ignore-errors
        --quiet
    )

    # Search used to be the one surface with NO error contract: a yt-dlp failure aborted on
    # `set -e` with raw stderr even under -j, so an agent got a jq parse error instead of a
    # shape it could branch on. Capture the failure and emit the same {status:"error",
    # reason} taxonomy the rest of the suite uses; the exit code stays yt-dlp's own.
    ensure_scratch
    local result_json rc=0 err="$SCRATCH_DIR/search.err" reason=""
    # A cookie store that cannot be READ is not a search that failed: YouTube search needs no
    # login, so ytdlp_cookied asks once more without the store and says why on stderr.
    local ERR_FILE="$err"
    result_json=$(ytdlp_cookied "${cmd[@]}") || rc=$?
    if ((rc != 0)) || [[ -z "$result_json" ]]; then
        reason=$(classify_yt_dlp_error "$(cat "$err" 2>/dev/null)" "$rc")
        if [[ "$OUTPUT_MODE" == "json" || "$OUTPUT_MODE" == "json_full" ]]; then
            jq -nc --arg e "$ENGINE_NAME" --arg q "$QUERY" --arg reason "$reason" \
                '{status: "error", engine: $e, query: $q, count: 0, results: [], reason: $reason}'
        else
            cat "$err" >&2 2>/dev/null || true
            echo "Error: search failed for '$QUERY' ($reason)" >&2
        fi
        # ARCH-cli-contract.md「退出码」 reserves 1 for usage/validation, so a propagated extractor failure reports
        # 2+ even when yt-dlp itself exited 1; -j callers branch on .status instead.
        exit $((rc <= 1 ? 2 : rc))
    fi

    # ONE jq program does the whole shaping: duration bounds -> duration_fmt -> sort.
    # Sort is a client-side re-order of the fetched set; "relevance" keeps YouTube's native
    # ranking (the order ytsearch returned) — no re-sort. Numeric fields sort descending,
    # with unknown values (live streams) last. SORT_FIELD is validated at startup, so there
    # is no unknown-field branch to handle here.
    local sort_expr=""
    case "$SORT_FIELD" in
    duration) sort_expr=' | sort_by(.duration // -1) | reverse' ;;
    view_count) sort_expr=' | sort_by(.view_count // -1) | reverse' ;;
    esac

    local bounds="true"
    ((MIN_DURATION > 0)) && bounds+=" and (.duration != null and .duration > $MIN_DURATION)"
    ((MAX_DURATION > 0)) && bounds+=" and (.duration != null and .duration < $MAX_DURATION)"

    # `kind` and `access` (ARCH-cli-contract.md「数据契约」) are the ENGINE'S JUDGEMENT about a row,
    # not a site field carried over, so they are merged LAST and win over any raw entry key of
    # the same name. Both are constants on this site and that is the whole answer, not a stub:
    # a YouTube search row that SURVIVES THE GATE BELOW is one video, and anonymous extraction
    # returns the whole timeline or no stream at all — there is no preview form to report.
    # Injecting them here rather than in the lean projection is what puts them in -J as well:
    # they are the engine's routing judgement, and the caller that asked for MORE data must not
    # be the one that loses it.
    #
    # A ROW IS A PLAYABLE CALL, so a container is not a row. `ytsearch` has no scope selector
    # — the other two engines pick one (bili-search sends search_type=video, ne-search sends
    # type:1) and so never see this — and its result set really is mixed: measured 2026-09-03,
    # row 15 of 周杰伦 is the artist's CHANNEL, and it shipped as kind:\"track\" with a null
    # duration. `t-play --engine yt -- <that url>` does not play one thing, so the envelope was
    # making a claim the row could not keep.
    #
    # The signal is free: yt-dlp tags every flat entry with the extractor that will handle it,
    # and it is already in the response — a video is `Youtube`, a channel or a playlist is
    # `YoutubeTab`. No extra request, which is what makes this a gate rather than a roadmap item.
    #
    # FAIL OPEN, deliberately: an entry with NO ie_key is kept. The gate's job is to drop a
    # shape we can name, not to require a key from yt-dlp — a future version that stops
    # emitting it would otherwise empty every search on this engine, which is a far worse
    # failure than the one row this fixes.
    #
    # Dropping shortens the count, and that is the contract already: `-n` says how many to
    # FETCH, never how many come back (`-m`/`-M` have always shortened it, and bili-search's
    # url gate does the same — ARCH-engine.md「kind 与 access」). Compensating by
    # over-fetching would spend a request on every query for a row most queries do not carry.
    #
    # A container is not lost, it is UNCLAIMED: what a caller could do with an album or a
    # channel is its own verb with its own envelope, where a track count and a page cursor
    # have somewhere to live. docs/ROADMAP.md「容器行」.
    FILTERED_JSON=$(printf '%s' "$result_json" | jq "$JQ_PRELUDE
        [ (.entries // [])[]
          | select($bounds)
          | select((.ie_key // \"Youtube\") == \"Youtube\")
          | . + {duration_fmt: (.duration | fmt_dur), description: (.description | oneline),
                 kind: \"track\", access: \"full\", thumbnail: pick_thumb} ]$sort_expr")
}

# Prose list. One jq program (it used to fork five jq per row — 125 for -n 25 — and
# re-derive duration_fmt that FILTERED_JSON already carries). Unknown fields render as
# LIVE / "--" / "-" instead of leaking a raw JSON `null` into human output.
print_list() {
    printf '%s' "$FILTERED_JSON" | jq -r --arg note "$MUSIC_CHAR" '
        to_entries[]
        | (.key + 1) as $i
        | .value
        | (if $note == "" then "" else $note + " " end) + "\($i). \(.title)",
          "  - " + (if .live_status == "is_live" then "LIVE" else (.duration_fmt // "--") end),
          "  - " + (if .view_count == null then "n/a" else (.view_count | tostring) end) + " views",
          "  - \(.url)"'
}

# Structured search output for agent callers. Wraps results in a stable
# {status, engine, query, count, results} envelope so a caller gets the query echoed back,
# a result count, and — since the split — the NAME OF THE ENGINE that produced them, which
# is what lets `t-play` route a chosen result back to the matching `<engine>-resolve`
# without pattern-matching its URL. Default (OUTPUT_MODE=json) projects each entry to a
# lean, high-signal 12-field schema — the raw yt-dlp entries carry ~23 fields (ie_key,
# x-forwarded-for, two URL variants, …) that are pure token ballast for a headless caller.
# `thumbnails[]` USED to be listed here as ballast and is now the exception that proves the
# rule: the ARRAY is still ballast, the one chosen url is not — pick_thumb spends the array
# here so no caller has to learn its shape. OUTPUT_MODE=json_full (-J) keeps every raw field for the rare case
# fidelity is needed. FILTERED_JSON's own shape is left untouched (print_list still reads
# it), so we project only here.
# `jq -c`, both arms: every machine envelope in this suite is ONE line, which is the
# contract the README and ARCHITECTURE.md「定位与设计目标」 state as a differentiator.
emit_search_json() {
    if [[ "$OUTPUT_MODE" == "json_full" ]]; then
        printf '%s' "$FILTERED_JSON" | jq -c --arg e "$ENGINE_NAME" --arg q "$QUERY" \
            '{status: "ok", engine: $e, query: $q, count: length, results: .}'
    else
        printf '%s' "$FILTERED_JSON" | jq -c --arg e "$ENGINE_NAME" --arg q "$QUERY" \
            '{status: "ok", engine: $e, query: $q, count: length,
              results: map({id, title, url, channel, duration, duration_fmt, view_count,
                            live_status, description, kind, access, thumbnail})}'
    fi
}

# ==============================================================================
# 4. CLI
# ==============================================================================

print_usage() {
    cat <<'EOF'
yt-search — the YouTube search engine (non-interactive)

Usage:
  yt-search [options] <search query>
  yt-search --capabilities [-j]

Options:
  -n NUM   Number of results to fetch (default: 20). This is how many are ASKED FOR, not a
           promise of how many come back: -m/-M and the container gate both shorten it
  -m SEC   Minimum duration in seconds
  -M SEC   Maximum duration in seconds
  -s FIELD Sort field: relevance | view_count | duration (default: relevance)
  -l       Plain text list output (default)
  -j       JSON: {status, engine, query, count, results[]} — 10 lean fields per result
  -J       JSON with full raw yt-dlp fields per result (same envelope)
  --capabilities  The flags this half accepts, less the --color -h -V every command has.
           No network, no query, no dependency: how a caller learns what to ask
  --color MODE  auto | always | never (default: auto)
  -h       This help
  -V       Print the suite version

Output (JSON, -j): {"status","engine","query","count","results":[{id,title,url,channel,
                    duration,duration_fmt,view_count,live_status,description,kind,access,
                    thumbnail}, ...]}
  results[].id is this engine's media id — the input to `yt-resolve`.
  kind (track|multipart) and access (full|preview|paywalled) are always
  track/full on this site: a row IS one video, and anonymous extraction returns the
  whole timeline or no stream at all.

Exit codes: 0 ok · 1 usage/validation · 2+ a missing dependency, or a propagated
            yt-dlp failure (see .reason)

Environment:
  Defaults for every knob below live in <checkout>/config, declared once for the whole
  suite. Override per user in ${XDG_CONFIG_HOME:-~/.config}/ting/config (KEY=value, one
  per line, # comments; the pre-rename .../uting/config is read when there is no ting
  one); TING_CONFIG relocates it, and UT_CONFIG still does. Chain: flag > environment > your
  config > the shipped defaults. See ARCH-cli-contract.md「配置面」.
  YT_COOKIE_BROWSER  Browser profile cookies are read from (default: chrome; "none" for
                     anonymous). A login makes age-restricted videos searchable; a profile
                     absent from this machine degrades to anonymous rather than failing

To play a result, pass its url or id to: t-play
EOF
}

# Every flag this half takes beyond the --color -h -V every command has, stated ONCE: the
# unknown-flag refusal prints it for a person and --capabilities answers with it for a caller
# (ARCH-cli-contract.md「命令规格」).
SEARCH_FLAGS=(-n -m -M -s -l -j -J --capabilities)
CAPABILITIES=0
SEARCH_FLAG=""       # which of -n -m -M -s was given (gate: --capabilities runs no search)

# Value-taking flags (consume the next token) vs boolean flags, restricted to the search
# surface. Anything outside these is rejected — playback/lifecycle flags get a pointer to
# t-play so the caller learns the right tool instead of a bare error. This gate is the
# whole reason a narrow verb exists (ARCH-cli-contract.md「门模型」); it used to live in a separate
# wrapper file and now sits directly in front of the implementation it guards.
has_format=0
query=()
reject_url() {
    echo "yt-search: '$1' looks like a URL — use 't-play $1' to play it" >&2
    exit 1
}
while (($#)); do
    case "$1" in
    -h | --help)
        print_usage
        exit 0
        ;;
    -V | --version)
        # Answered before ANY dependency gate: a version is the first thing a bug report
        # needs, and needing yt-dlp installed to find out which version you have is
        # backwards.
        printf 'yt-search %s\n' "$UT_VERSION"
        exit 0
        ;;
    -l | --list)
        has_format=1
        OUTPUT_MODE="list"
        shift
        ;;
    -j | --json)
        has_format=1
        OUTPUT_MODE="json"
        shift
        ;;
    -J | --json-full)
        has_format=1
        OUTPUT_MODE="json_full"
        shift
        ;;
    --color=*)
        COLOR_MODE="${1#*=}"
        shift
        ;;
    --color)
        [[ $# -ge 2 ]] || { echo "yt-search: $1 requires a value" >&2; exit 1; }
        COLOR_MODE="$2"
        shift 2
        ;;
    -n | -m | -M | -s)
        [[ $# -ge 2 ]] || { echo "yt-search: $1 requires a value" >&2; exit 1; }
        SEARCH_FLAG="$1"
        case "$1" in
        -n) NUM_RESULTS="$2" ;;
        -m) MIN_DURATION="$2" ;;
        -M) MAX_DURATION="$2" ;;
        -s) SORT_FIELD="$2" ;;
        esac
        shift 2
        ;;
    -S)
        # Taken and forwarded as --format-sort until now, into a --flat-playlist
        # --dump-single-json --skip-download call that selects no format at all: the value
        # could not change one byte of the output. Rejected rather than ignored, the same
        # sentence bili-search already answered with — the two search halves may not
        # disagree about what a search IS, and an engine author reading the checklist
        # would otherwise implement a no-op.
        echo "yt-search: -S selects a stream format — searching resolves none (see yt-resolve -S)" >&2
        exit 1
        ;;
    -f | -d | --detach | --status | --stop | --set-volume | --id | --all)
        echo "yt-search: $1 is a playback flag — use t-play for playback" >&2
        exit 1
        ;;
    --info | --transcript | --subtitles | --sub-lang | --sub-langs)
        # The other half of this engine, not the player: metadata and captions are
        # extraction. --get-url is deliberately absent — it no longer exists anywhere.
        echo "yt-search: $1 belongs to the other half of this engine — use yt-resolve $1" >&2
        exit 1
        ;;
    --capabilities)
        CAPABILITIES=1
        shift
        ;;
    --)
        shift
        # `--` stops FLAG parsing, it does not stop argument validation: a query token
        # that looks like a URL is still the wrong tool, and a query beginning with '-'
        # must survive as a query. ARCHITECTURE.md「端到端控制流」.
        while (($#)); do
            case "$1" in
            http://* | https://* | www.* | youtube.com/* | youtu.be/*) reject_url "$1" ;;
            esac
            query+=("$1")
            shift
        done
        break
        ;;
    -*)
        echo "yt-search: unknown flag '$1' (search flags: ${SEARCH_FLAGS[*]})" >&2
        exit 1
        ;;
    http://* | https://* | www.* | youtube.com/* | youtu.be/*)
        reject_url "$1"
        ;;
    *)
        query+=("$1")
        shift
        ;;
    esac
done

# --capabilities asks about the ENGINE, not a query, so it answers before the query is required
# and ahead of every dependency gate, jq included: it is how a caller learns what to ask, so it
# must answer on a machine that cannot run a search yet. Anything that would shape a search is
# refused rather than ignored (ARCH-cli-contract.md「门模型」).
if ((CAPABILITIES)); then
    ((${#query[@]} == 0)) ||
        die "--capabilities takes no query — it reports what this engine accepts"
    [[ -z "$SEARCH_FLAG" ]] || die "$SEARCH_FLAG shapes a search — --capabilities runs none"
    [[ "$OUTPUT_MODE" != "json_full" ]] ||
        die "-J returns raw per-result fields — --capabilities has no results; use -j"
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        caps=""
        for f in "${SEARCH_FLAGS[@]}"; do caps+="${caps:+,}\"$f\""; done
        printf '{"status":"ok","engine":"%s","flags":[%s]}\n' "$ENGINE_NAME" "$caps"
    else
        printf '%s\n' "${SEARCH_FLAGS[*]}"
    fi
    exit 0
fi

if ((${#query[@]} == 0)); then
    echo "yt-search: a search query is required (see 'yt-search -h')" >&2
    exit 1
fi
QUERY="${query[*]}"
if [[ "$QUERY" != *[![:space:]]* ]]; then
    echo "yt-search: a search query is required (see 'yt-search -h')" >&2
    exit 1
fi

# The default output is the plain list; -j/-J/-l override.
((has_format)) || OUTPUT_MODE="list"

if ! is_non_negative_int "$NUM_RESULTS"; then
    die "-n must be a non-negative integer"
fi
# The row ceiling is applied AFTER validation and BEFORE the ytsearchN string is built, so
# one place decides how many rows a query may cost. Silent by design, exactly as the page
# budget it replaces was: a caller asking for more than the ceiling gets the ceiling.
if ((UT_MAX_SEARCH_RESULTS > 0 && NUM_RESULTS > UT_MAX_SEARCH_RESULTS)); then
    NUM_RESULTS=$UT_MAX_SEARCH_RESULTS
fi
if ! is_non_negative_int "$UT_MAX_SEARCH_RESULTS"; then
    die "UT_MAX_SEARCH_RESULTS must be a non-negative integer (0 = no ceiling)"
fi
if ! is_non_negative_int "$MIN_DURATION"; then
    die "-m must be a non-negative integer"
fi
if ! is_non_negative_int "$MAX_DURATION"; then
    die "-M must be a non-negative integer"
fi
if ((MAX_DURATION > 0 && MAX_DURATION <= MIN_DURATION)); then
    die "-M must be greater than -m when both are set"
fi
if ! validate_enum "$SORT_FIELD" relevance view_count duration; then
    die "-s must be one of: relevance, view_count, duration"
fi
if ! validate_enum "$COLOR_MODE" auto always never; then
    die "--color must be one of: auto, always, never"
fi

require_deps yt-dlp jq

fetch_results
if [[ "$OUTPUT_MODE" == "list" ]]; then
    print_list
else
    emit_search_json
fi
exit 0
