#!/usr/bin/env bash
# bili-resolve — the Bilibili RESOLVE ENGINE: a media handle -> direct stream URL(s) plus
# the HTTP headers needed to fetch them, and the read-only metadata verb that shares the
# same extractor. Agent-facing.
#
# The other half of the bilibili engine pair (`bili-search` + `bili-resolve`); the player
# (`t-play`) is source-agnostic and knows neither. Everything Bilibili-specific about
# turning a handle into bytes lives here: the yt-dlp invocation, the cookie decision, the
# format-per-mode table, and the handle shapes this site uses. It has NO playback,
# lifecycle, or mpv logic and never starts a process that outlives it.
#
# WHY THIS HALF SHELLS OUT TO yt-dlp WHILE ITS SIBLING TALKS HTTP. The reason is the
# mirror image of the one in bili-search, and it is measured, not preferred: yt-dlp is
# BETTER than a hand-written client here and WORSE there. One `yt-dlp -J` on a Bilibili
# video returns, in 2.7s, the DASH stream URL, the headers it must be fetched with, the
# title and the duration — the whole resolve envelope. Doing that by hand means the WBI
# request signature, DASH stream selection across three sources, and CDN choice; a native
# Bilibili TUI spends roughly 2500 lines on exactly that, and this file would be
# reimplementing an authentication mechanism our own dependency already maintains.
# So: no signing code, no playurl endpoint, no key rotation cache.
#
# It also puts login on the right side of the line. An account gets higher-quality audio,
# and cookies reach yt-dlp through --cookies-from-browser — a channel that already exists
# and that the HTTP half never touches. docs/ARCHITECTURE.md「原语与接缝」.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features; guard empty-array
# expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). ARCHITECTURE.md「可移植性契约」.

# Resolve this script's OWN symlink chain before looking for its siblings — see the same
# block in yt-search for why `cd -P`/`pwd -P` and a hand-rolled loop (bash 3.2 has no
# `readlink -f`).
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)

# THE version of the whole suite, declared once — in a data file, not in code. See the same
# block in bili-search / yt-resolve / t-play. CLAUDE.md § one fact, one place.
if [[ -r "$SCRIPT_DIR/../VERSION" ]]; then
    UT_VERSION=$(cat "$SCRIPT_DIR/../VERSION")
else
    UT_VERSION="unknown"
fi

# CONFIGURATION — the chain is flag > environment > the user's config > the shipped defaults
# in `<checkout>/config`, which is where every default value in the suite is declared once.
# Duplicated VERBATIM in all ten entry points — see the same block in t-play for why, and
# ARCH-cli-contract.md「配置面」 for the keys.
TING_CONFIG="${TING_CONFIG:-${UT_CONFIG:-}}"
if [[ -z "$TING_CONFIG" ]]; then
    if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/ting/config" ]]; then
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ting/config"
    else
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/uting/config"
    fi
fi
UT_CONFIG="$TING_CONFIG"
for _v in STATE_DIR ENGINE_DIR HISTORY THEME ACCENT VOLUME LANG IMAGE KEYS RESOURCE RESOURCE_TICKS BRAND ASCII SYNC PLAY_QUALITY VIZ_STYLE VIZ_COLOR DEAD_KEEP DEFAULT_ENGINE MODE_CYCLE SORT_CYCLE THEME_CYCLE QUALITY_CYCLE LOOP_CYCLE; do
    eval "[[ -n \"\${TING_$_v+x}\" ]] && UT_$_v=\"\$TING_$_v\" || true"
    eval "[[ -n \"\${UT_$_v+x}\" && -z \"\${TING_$_v+x}\" ]] && TING_$_v=\"\$UT_$_v\" || true"
done
UT_DEFAULTS="$SCRIPT_DIR/../config"
ut_read_config() {
    local file="$1" line key val _ting_k _ut_k
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        while [[ "$line" == [[:space:]]* ]]; do line="${line#[[:space:]]}"; done
        while [[ "$line" == *[[:space:]] ]]; do line="${line%[[:space:]]}"; done
        [[ -n "$line" && "$line" == *=* ]] || continue
        key="${line%%=*}"
        val="${line#*=}"
        while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
        while [[ "$val" == [[:space:]]* ]]; do val="${val#[[:space:]]}"; done
        [[ "$key" =~ ^(TING|UT|YT|BILI|NE)_[A-Z0-9_]+$ ]] || continue
        case "$key" in
        TING_CONFIG | TING_DEFAULTS | TING_ENGINE_DIR | TING_VERSION | UT_CONFIG | UT_DEFAULTS | UT_ENGINE_DIR | UT_VERSION | YT_IPC_SOCK | YT_DETACHED | YT_PLAYER_ID | YT_DETACHED_LOG) continue ;;
        esac
        if [[ ${#val} -ge 2 ]] && { [[ "$val" == \"*\" ]] || [[ "$val" == \'*\' ]]; }; then
            val="${val#?}"
            val="${val%?}"
        fi
        [[ "$val" == "~/"* ]] && val="$HOME/${val#\~/}"
        if [[ "$key" == TING_* ]]; then
            _ut_k="UT_${key#TING_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ut_k+x}\" ]] || $_ut_k=\$val"
        elif [[ "$key" == UT_* ]]; then
            _ting_k="TING_${key#UT_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ting_k+x}\" ]] || $_ting_k=\$val"
        else
            eval "[[ -n \"\${$key+x}\" ]]" && continue
            eval "$key=\$val"
        fi
    done < "$file"
}
# FAIL FAST AND SAY WHY. There is deliberately no escape hatch for --version or --help: they
# were tried, and letting execution continue past a missing defaults file replaced this one
# clear line with `YT_ASCII_VO: unbound variable` from set -u somewhere further down. A
# checkout missing part of itself is not a dependency gate (yt-dlp, jq and mpv still answer
# --version without being installed) — it is a broken checkout, and 2 is the exit code for a
# failure that is not the caller's usage error.
if [[ ! -r "$UT_DEFAULTS" ]]; then
    printf '%s: cannot read the shipped defaults at %s — that file declares every default value in the suite and is not optional\n' \
        "$(basename "$0")" "$UT_DEFAULTS" >&2
    exit 2
fi
ut_read_config "$UT_CONFIG"
ut_read_config "$UT_DEFAULTS"

# The engine's own name, as it appears in the envelope AND as the command prefix its two
# executables carry. docs/ARCHITECTURE.md「命令拓扑」.
ENGINE_NAME="bili"

# ==============================================================================
# 1. SETTINGS
# ==============================================================================

# Highest quality video+audio. This can start slower than a progressive stream.
# Optional fast-start format for interactive playback.

# THE PARTS ENDPOINTS — this file's second transport, and the suite's second and last place
# where an HTTP request is built by hand; the sibling half's `fetch_page_once` is the first.
# Two endpoints, one preferred and one fallback, are still one transport. It is here
# rather than behind yt-dlp because yt-dlp cannot answer the question: `--flat-playlist`
# returns {ie_key,_type,url} per part and NO title and NO duration (measured 2026-08-29),
# which is an envelope with nothing in it. One GET answers the whole thing in 0.38-0.43s.
#
# `view` is PREFERRED, `/x/player/pagelist` is the FALLBACK: the two return the same per-part
# rows for the same cost, and only `view` also carries `.data.bvid`, `.data.title` and
# `.data.duration` — the canonical id and two top-level fields of the envelope below. Sending
# UA and Referer is not strictly required and is sent anyway, for the reason bili-search
# states about a stale UA. Nothing else is sent: no cookie, no buvid, no signature.
#
# WHY THERE IS A FALLBACK AT ALL — measured 2026-09-01, from two different networks, and it
# is the whole reason this verb has two endpoints instead of one:
#
#     view      bare / + buvid3 / + an spi-issued buvid3+buvid4 / + a full browser header
#               set / either Referer / bvid or aid   ->  412, every combination
#     pagelist  bare                                 ->  200, code 0, all 200 parts
#     search/type  bare -> 412,  + buvid3 -> 200     (the sibling half is unaffected)
#
# So `view` began refusing this client outright — three days after the 2026-08-29 run that
# recorded it answering a bare request with 200 — while `pagelist` and the sibling engine's
# endpoint both still answer. Two networks give the same answer, so this is the endpoint's
# own change and not an address that got itself flagged.
#
# The buvid3 that rescues `search/type` does NOT rescue this one, which is the measurement
# that decided against sending one here: it would be a header added on a hunch, and the row
# above is what a hunch looks like when it is tested. A device id stays out of this request.
#
# `view` is still ATTEMPTED FIRST rather than retired: it is the endpoint with the better
# answer, the refusal is the site's current posture rather than a law, and a host where it
# still answers should still get the richer envelope. The second request is only ever spent
# where the first has already been refused.
#
# UNPREFIXED, like bili-search's SEARCH_ENDPOINT/SEARCH_REFERER and for the same reason:
# since ARCHITECTURE.md「两个根数据文件」 the prefix IS config reachability, so a constant must not wear a settable name.
VIEW_ENDPOINT="https://api.bilibili.com/x/web-interface/view"
PAGELIST_ENDPOINT="https://api.bilibili.com/x/player/pagelist"
VIEW_REFERER="https://www.bilibili.com/"

# THE AUDIO-MENU ENDPOINTS — the container verb's transport, and this file's third and last
# hand-built request. Two endpoints, one GET each per page:
#
#   menu/info      the menu's own record: `.data.title`, and — the reason it is called at all
#                  — whether the menu EXISTS. Measured 2026-09-10: an am id nobody ever
#                  created answers HTTP 200, `code: 0`, `msg: "success"` and `data: null`. So
#                  the body code is no answer here and the id is judged by the SHAPE of what
#                  came back.
#   song/of-menu   the tracks: `.data.totalSize` and `.data.data[]{id,title,duration}`, with
#                  duration already in seconds. It cannot stand in for that existence check:
#                  a menu that does not exist answers `code: 0` with `totalSize: 0` and an
#                  empty array — the same body an existing EMPTY menu returns.
#
# Both live under the `music-service-c` host, which ignores Accept-Encoding and answers gzip
# whatever is asked: a curl without --compressed gets binary (measured). Every curl in this
# file already carries it; it is written down because this is the first request that would
# have broken without it.
#
# UNPREFIXED, like the parts endpoints above and for the same reason.
MENU_INFO_ENDPOINT="https://www.bilibili.com/audio/music-service-c/web/menu/info"
OF_MENU_ENDPOINT="https://www.bilibili.com/audio/music-service-c/web/song/of-menu"

# A page is 100 because the SERVER says so — ps=100 answers, ps=101 answers code 4511000 and
# no data (measured) — and the ceiling is five of them. Neither is a flag: `-n` is a search
# flag this engine refuses, and a second spelling of it would be a whole contract for one edge
# case. A caller learns it was truncated from the envelope, where `count` below `total` says
# so. ARCH-engine.md「容器（--items）」.
ITEMS_PAGE=100
ITEMS_MAX=500

# THE VIDEO-SIDE CONTAINER ENDPOINTS — a favourites list and a collection, each with its own
# host, its own page size and its own way of saying "does not exist" (measured 2026-09-12):
#
#   fav/folder/info      the list's own record, and the EXISTENCE check: a media_id nobody ever
#                        created answers 200 / `code: 0` / `data.title: null`, so here too the
#                        code says nothing and the shape says everything.
#   fav/resource/list    the entries, `ps` capped at 40 (`ps=41` answers `code -400`). It carries
#                        its OWN `data.has_more`, which is why this engine does not derive one
#                        for favourites: the site is the authority on its own tail.
#   seasons_archives_list  a collection's videos, `page_size` capped at 100 (`101` -> `-400`).
#                        This one DOES answer existence in the code (`-404`, "啥都木有"), so no
#                        second request buys anything. It also ignores `mid` entirely — the same
#                        season_id answers identically for mid 0, 1 and the real uploader — so
#                        the uid in the URL is carried for the canonical url and nothing else.
#
# The space endpoint is the one request in this file that needs a REFERER OF ITS OWN: bare curl
# answers `{"code":-352}`, and a desktop UA plus `Referer: https://space.bilibili.com/` clears it
# (measured both ways, 2026-09-12). No buvid, no signature, no cookie.
#
# UNPREFIXED, like every other endpoint constant here and for the same reason.
FAV_INFO_ENDPOINT="https://api.bilibili.com/x/v3/fav/folder/info"
FAV_LIST_ENDPOINT="https://api.bilibili.com/x/v3/fav/resource/list"
SEASON_ENDPOINT="https://api.bilibili.com/x/polymer/web-space/seasons_archives_list"
SPACE_REFERER="https://space.bilibili.com/"
FAV_PAGE=40
SEASON_PAGE=100

# Cookies (login) are ON by default (browser: chrome). On this site they buy AUDIO QUALITY
# rather than access: an account — more so a premium one — is offered Hi-Res / Dolby /
# lossless renditions that an anonymous client is not, and this suite's main use is
# listening. Public videos resolve fine without them, so an absent profile degrades to
# anonymous rather than failing.
# Set BILI_COOKIE_BROWSER=none to force anonymous-only (skips the keychain read).
COOKIE_ARGS=()
if [[ -n "${BILI_COOKIE_BROWSER:-}" && "$BILI_COOKIE_BROWSER" != "none" ]]; then
    browser_exists=0
    case "$BILI_COOKIE_BROWSER" in
    chrome|chromium|brave)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            if [[ -d "$HOME/Library/Application Support/Google/Chrome" || -d "$HOME/Library/Application Support/BraveSoftware" || -d "$HOME/Library/Application Support/Chromium" ]]; then
                browser_exists=1
            fi
        else
            if [[ -d "$HOME/.config/google-chrome" || -d "$HOME/.config/chromium" || -d "$HOME/.config/BraveSoftware" ]]; then
                browser_exists=1
            fi
        fi
        ;;
    safari)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Safari" ]] && browser_exists=1
        fi
        ;;
    firefox)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Firefox" ]] && browser_exists=1
        else
            [[ -d "$HOME/.mozilla/firefox" ]] && browser_exists=1
        fi
        ;;
    edge)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Microsoft Edge" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/microsoft-edge" ]] && browser_exists=1
        fi
        ;;
    opera)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/com.operasoftware.Opera" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/opera" ]] && browser_exists=1
        fi
        ;;
    vivaldi)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Vivaldi" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/vivaldi" ]] && browser_exists=1
        fi
        ;;
    *)
        browser_exists=0
        ;;
    esac

    if ((browser_exists)); then
        COOKIE_ARGS=(--cookies-from-browser "$BILI_COOKIE_BROWSER")
    fi
fi

ACTION="stream"      # stream | info | parts | items | auth | capabilities
VERB_FLAG=""         # the verb flag as typed — the one-verb-per-invocation gate reads it
# The `-f` default, cross-engine: a user who listens rather than watches says so once.
PLAYBACK_MODE="$UT_PLAY_MODE"
FORMAT_SORT=""
FORMAT_FLAG=""       # which of -f / -S / --quality was actually given (gate: stream resolution only)
QUALITY="auto"       # auto | low | medium | high — the tier abstraction (--quality)
COLOR_MODE="auto"
OUTPUT_MODE="list"   # list (prose) | json | json_full
TARGET=""            # the handle as the caller typed it
TARGET_URL=""        # the watch URL it normalises to
TARGET_START=""      # ?t= seconds carried by the handle, or "" — see parse_start_seconds
CONTAINER_KIND=""    # am | fav | season | series — which container the handle named
CONTAINER_ID=""      # the id --items resolves to, digits only
CONTAINER_MID=""     # the uploader id a collection URL carried, "" for the other kinds
CONTAINER_URL=""     # the canonical container URL those digits normalise to
CURSOR=""            # the --cursor token as the caller typed it, "" when absent
CURSOR_OFFSET=0      # the item offset it decodes to; 0 is the first batch
FMT=""               # the yt-dlp format string the mode resolves to

# Glyph fallback shares ONE switch with ting (YT_ASCII, legacy alias YT_TUI_ASCII).
MUSIC_CHAR="♫"
case "${YT_ASCII:-${YT_TUI_ASCII:-}}" in
1 | true | yes | on) MUSIC_CHAR="" ;;
"")
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8* | *utf-8* | *UTF8* | *utf8*) ;;
    *) MUSIC_CHAR="" ;;
    esac
    ;;
esac

# ==============================================================================
# 2. HELPERS
# ==============================================================================

err() {
    local red='' reset=''
    case "${COLOR_MODE:-auto}" in
    always)
        red=$'\033[31m'
        reset=$'\033[0m'
        ;;
    auto)
        if [[ -t 2 ]]; then
            red=$'\033[31m'
            reset=$'\033[0m'
        fi
        ;;
    never) ;;
    esac
    echo "${red}Error:${reset} $*" >&2
}

die() {
    err "$@"
    exit 1
}

# A missing tool is not a malformed call: `die` is exit 1 (the argv is wrong — fix it),
# `die_dep` is exit 2 (the argv was fine; the machine is missing something no rewrite of the
# argv will supply). An agent that read 1 here would loop editing its own parameters against
# a wall. docs/ARCH-cli-contract.md「退出码、TTY、依赖」.
die_dep() {
    err "required command not found: $1"
    exit 2
}

validate_enum() {
    local value=$1
    shift
    local allowed
    for allowed in "$@"; do
        if [[ "$value" == "$allowed" ]]; then
            return 0
        fi
    done
    return 1
}

# ONE VERB PER INVOCATION — enforced for every pair that includes --items, and only those.
# The older verbs keep their last-one-wins behaviour: it is what has shipped, and turning an
# exit 0 into an exit 1 for `--info --parts` is a contract change nobody asked for (CLAUDE.md
# 红线 4). A caller who names two verbs has not said what it wants, and the gate model answers
# that by refusing rather than by guessing (ARCH-cli-contract.md「门模型」).
set_action() {
    local action=$1 flag=$2
    if [[ -n "$VERB_FLAG" && "$VERB_FLAG" != "$flag" ]] &&
        { [[ "$flag" == "--items" ]] || [[ "$VERB_FLAG" == "--items" ]] ||
            [[ "$flag" == "--capabilities" ]] || [[ "$VERB_FLAG" == "--capabilities" ]]; }; then
        die "$VERB_FLAG and $flag are two verbs — pass one"
    fi
    VERB_FLAG="$flag"
    ACTION="$action"
}

require_cmd() {
    local cmd=$1
    command -v "$cmd" >/dev/null 2>&1 || die_dep "$cmd"
}

require_deps() {
    local cmd
    for cmd in "$@"; do
        require_cmd "$cmd"
    done
}

# The ONE implementation of duration formatting: seconds -> "[Nd ]HHh:MMm:SSs". Each engine
# carries its own copy — they are independent executables sharing no library — and the
# shared fact is the FORMAT, stated once in docs/ARCH-engine.md「搜索子系统」.
JQ_PRELUDE='
def p2: tostring | if length < 2 then "0" + . else . end;
def strip_t:
  if type != "string" then .
  else gsub("&t=[^&#]*"; "")
     | gsub("\\?t=[^&#]*&"; "?")
     | gsub("\\?t=[^&#]*(?<e>#|$)"; "\(.e)")
  end;
def fmt_dur:
  if type != "number" then null
  else (. | floor) as $t
    | ($t / 86400 | floor) as $d
    | (($t % 86400) / 3600 | floor) as $h
    | (($t % 3600) / 60 | floor) as $m
    | ($t % 60) as $s
    | (if $d > 0 then "\($d)d " else "" end) + "\($h | p2)h:\($m | p2)m:\($s | p2)s"
  end;
'

# Map captured yt-dlp output + exit code to the suite's stable reason taxonomy so an agent
# caller can branch on `reason` instead of string-matching raw extractor wording. The ENUM
# is the shared fact and lives in ARCH-cli-contract.md「数据契约」 No member may be added here that
# the enum does not already have; `unknown` is the conservative default.
#
# The site-specific half is the last two patterns. HTTP 412 and the body code -352 are how
# this host says "rate limited", and they land in `network` — the member that already means
# RETRYABLE — for the same reason 429 does on the yt-dlp side: `forbidden` would tell a
# caller these credentials never work, which is the wrong instruction for a wait-and-retry.
classify_yt_dlp_error() {
    local text=$1 rc=$2
    if ((rc == 130)); then
        echo "stopped_by_user"
        return
    fi
    # The browser's cookie store could not be read, before any request was made — the same
    # member and the same wording yt-search's reader matches (the enum is ARCH-cli-contract.md
    # 「数据契约」). First, because it says nothing about the site.
    if grep -qiE 'could not (find|copy) [a-z]+ cookies? database|failed to decrypt|cannot decrypt|find-generic-password|keyring|keychain|\[Errno [0-9]+\][^:]*: .*(Cookies|cookies\.sqlite|binarycookies)' <<<"$text"; then
        echo "cookies"
        return
    fi
    if grep -qiE 'HTTP Error 412|[^0-9-]-352[^0-9]|risk control|Precondition Failed' <<<"$text"; then
        echo "network"
        return
    fi
    if grep -qiE 'HTTP Error 403|[^a-z]403[^0-9]|Forbidden' <<<"$text"; then
        echo "forbidden"
        return
    fi
    if grep -qiE 'may be deleted or geo-restricted|Video unavailable|Private video|has been removed|no longer available|does not exist|paid video|premium|大会员|需要登录' <<<"$text"; then
        echo "unavailable"
        return
    fi
    if grep -qiE 'Requested format is not available|No video formats|requested format|only images are available' <<<"$text"; then
        echo "format_unavailable"
        return
    fi
    if grep -qiE 'Temporary failure in name resolution|Failed to resolve|Name or service not known|Network is unreachable|Connection (refused|timed out|reset)|Could not connect|getaddrinfo|Timed out|Operation timed out|HTTP Error 429|Too Many Requests|Unable to download (webpage|API page|JSON metadata)' <<<"$text"; then
        echo "network"
        return
    fi
    echo "unknown"
}

# ── the cookie store, diagnosed ─────────────────────────────────────────────────────────
# yt-dlp words several different causes as ONE sentence. A folder the calling terminal app
# is not allowed into (macOS privacy protection) is walked as empty and reported "could not
# find … cookies database" — the same words as a browser that was never used, and the same
# command then works from another terminal. cookie_probe tells them apart by doing what
# yt-dlp does: list the browser's folder, find its newest cookie file, read one byte of it.
# `[ -r ]` would not do: it consults Unix permissions, and privacy protection sits above
# them. Local — no network, no Keychain. The paths are site knowledge, so each engine carries
# its own copy (ARCH-engine.md, the anonymous-fallback section).
COOKIE_STATE=""; COOKIE_PATH=""; COOKIE_ERR=""
cookie_denied() {
    COOKIE_ERR=$1
    if [[ "$1" == *"Operation not permitted"* && "$(uname -s)" == "Darwin" ]]; then
        COOKIE_STATE="blocked"
    else
        COOKIE_STATE="denied"
    fi
    return 0
}
cookie_probe() {
    COOKIE_STATE="unknown"; COOKIE_PATH=""; COOKIE_ERR=""
    local b=$1 root="" name="Cookies" as="$HOME/Library/Application Support" mac=0 f newest="" err
    if [[ "$(uname -s)" == "Darwin" ]]; then mac=1; fi
    case "$b" in
    chrome)   if ((mac)); then root="$as/Google/Chrome"; else root="$HOME/.config/google-chrome"; fi ;;
    chromium) if ((mac)); then root="$as/Chromium"; else root="$HOME/.config/chromium"; fi ;;
    brave)    if ((mac)); then root="$as/BraveSoftware/Brave-Browser"; else root="$HOME/.config/BraveSoftware/Brave-Browser"; fi ;;
    edge)     if ((mac)); then root="$as/Microsoft Edge"; else root="$HOME/.config/microsoft-edge"; fi ;;
    opera)    if ((mac)); then root="$as/com.operasoftware.Opera"; else root="$HOME/.config/opera"; fi ;;
    vivaldi)  if ((mac)); then root="$as/Vivaldi"; else root="$HOME/.config/vivaldi"; fi ;;
    firefox)  name="cookies.sqlite"
              if ((mac)); then root="$as/Firefox"; else root="$HOME/.mozilla/firefox"; fi ;;
    safari)   ((mac)) || return 0
              name="Cookies.binarycookies"
              root="$HOME/Library/Containers/com.apple.Safari/Data/Library/Cookies"
              if [[ ! -d "$root" ]]; then root="$HOME/Library/Cookies"; fi ;;
    *) return 0 ;;
    esac
    COOKIE_PATH=$root
    if [[ ! -e "$root" ]]; then COOKIE_STATE="missing"; return 0; fi
    if ! err=$(ls "$root" 2>&1 >/dev/null); then cookie_denied "$err"; return 0; fi
    # Newest wins because that is the profile yt-dlp itself picks when none is named.
    while IFS= read -r f; do
        if [[ -z "$newest" || "$f" -nt "$newest" ]]; then newest=$f; fi
    done < <(find "$root" -maxdepth 3 -type f -name "$name" 2>/dev/null)
    if [[ -z "$newest" ]]; then COOKIE_STATE="missing"; return 0; fi
    COOKIE_PATH=$newest
    if ! err=$(head -c1 "$newest" 2>&1 >/dev/null); then cookie_denied "$err"; return 0; fi
    COOKIE_STATE="readable"
    return 0
}
# The app to name in the fix. TERM_PROGRAM is what the terminal says it is; tmux and screen
# replace it with themselves, and then the honest answer is that we cannot tell.
terminal_app() {
    case "${TERM_PROGRAM:-}" in
    Apple_Terminal) echo "Terminal" ;;
    iTerm.app) echo "iTerm" ;;
    ghostty) echo "Ghostty" ;;
    vscode) echo "VS Code" ;;
    WezTerm) echo "WezTerm" ;;
    WarpTerminal) echo "Warp" ;;
    "" | tmux | screen)
        if [[ "${TERM:-}" == "xterm-kitty" ]]; then echo "kitty"; else echo "your terminal app"; fi ;;
    *) echo "$TERM_PROGRAM" ;;
    esac
}
# ONE line on stderr that says what was lost, why, and the fix. stderr and not the envelope:
# it is prose for a person, and the -j envelope keeps its shape (ARCH-cli-contract.md).
cookie_diagnosis() {
    local b=${BILI_COOKIE_BROWSER:-} first="" app prog="bili-resolve" knob="BILI_COOKIE_BROWSER"
    cookie_probe "$b"
    first=$(printf '%s\n' "$1" | grep -m1 'ERROR' | sed 's/^ERROR: //') || first=""
    case "$COOKIE_STATE" in
    blocked)
        app=$(terminal_app)
        printf '%s: no %s cookies: macOS blocks %s from reading them - grant it Full Disk Access (System Settings > Privacy & Security), restart it; or set %s=none\n' \
            "$prog" "$b" "$app" "$knob" ;;
    denied)
        printf '%s: no %s cookies: %s reading %s; or set %s=none\n' \
            "$prog" "$b" "${COOKIE_ERR##*: }" "$COOKIE_PATH" "$knob" ;;
    missing)
        printf '%s: no %s cookies: %s has no cookie database - sign in to it once; or set %s=none (looked under %s)\n' \
            "$prog" "$b" "$b" "$knob" "$COOKIE_PATH" ;;
    readable)
        case "$b" in
        firefox | safari)
            printf '%s: no %s cookies: %s; or set %s=none\n' \
                "$prog" "$b" "${first:-yt-dlp could not load them}" "$knob" ;;
        *)
            printf '%s: no %s cookies: they could not be decrypted - allow Keychain access to "%s Safe Storage" when macOS asks; or set %s=none\n' \
                "$prog" "$b" "$b" "$knob" ;;
        esac ;;
    *)
        printf '%s: no %s cookies: %s; or set %s=none\n' \
            "$prog" "$b" "${first:-yt-dlp could not load them}" "$knob" ;;
    esac
    return 0
}
# Run one yt-dlp command ("$@", cookie args NOT included) with the configured cookie store,
# and once more WITHOUT it when the store itself is what failed — only then, so a network
# error is not paid for twice. stdout is the command's; yt-dlp's stderr lands in ERR_FILE for
# the caller's classifier; the diagnosis goes to this process's stderr.
ytdlp_cookied() {
    local out="" rc=0
    if ((${#COOKIE_ARGS[@]} > 0)); then
        out=$("$@" "${COOKIE_ARGS[@]}" 2>"$ERR_FILE") || rc=$?
        if ((rc != 0)) || [[ -z "$out" ]]; then
            if [[ "$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")" == "cookies" ]]; then
                cookie_diagnosis "$(cat "$ERR_FILE" 2>/dev/null)" >&2
                rc=0
                out=$("$@" 2>"$ERR_FILE") || rc=$?
            fi
        fi
    else
        out=$("$@" 2>"$ERR_FILE") || rc=$?
    fi
    printf '%s' "$out"
    return "$rc"
}

# This process's own scratch dir: 0700, created lazily, removed however we exit. Lazily
# because -h / -V must answer without touching the filesystem, and process-level rather
# than a function `local` because the EXIT trap runs after the function has returned.
# 0700 rather than a bare /tmp path because the captured yt-dlp stderr can name a cookie
# database. `players/` has exactly one owner (t-play) and it is not this file.
SCRATCH_DIR=""
ERR_FILE=""
cleanup_scratch() {
    [[ -n "$SCRATCH_DIR" ]] && rm -rf "$SCRATCH_DIR" 2>/dev/null
    return 0
}
trap cleanup_scratch EXIT

ensure_scratch() {
    [[ -n "$SCRATCH_DIR" ]] && return 0
    SCRATCH_DIR=$(mktemp -d "${TMPDIR:-/tmp}/bili-resolve.XXXXXX") || die "cannot create a scratch directory"
    chmod 700 "$SCRATCH_DIR" 2>/dev/null || true
    ERR_FILE="$SCRATCH_DIR/yt-dlp.err"
    : >"$ERR_FILE"
}

# The yt-dlp format string a playback mode resolves to. This table is the reason format
# selection belongs to the engine and not the player: `bv*+ba/b` is a yt-dlp expression,
# and the player must never learn to read one. t-play sends a MODE and gets back bytes.
format_for_mode() {
    case "$1" in
    video) echo "$BILI_VIDEO_FORMAT" ;;
    fast) echo "$BILI_VIDEO_FORMAT_FAST" ;;
    ascii) echo "$BILI_VIDEO_FORMAT" ;;
    *) echo "$BILI_AUDIO_FORMAT" ;; # audio, viz
    esac
}

# The yt-dlp format-sort a quality tier resolves to, for a given playback mode. Same rule
# as format_for_mode: a caller sends a canonical TIER, and the yt-dlp sort string exists
# only here. auto (or any pair this table maps to "") sends no --format-sort — the default
# format table already picks the best. -S is the expert escape and EXPLICITLY wins: both
# given, the caller's own sort replaces this table's (ARCH-engine.md「解析」).
quality_sort_for_tier() {
    local mode=$1 tier=$2
    case "$mode" in
    video | fast | ascii)
        case "$tier" in
        low) echo "res:360" ;;
        medium) echo "res:720" ;;
        high) echo "res:1080" ;;
        esac
        ;;
    *) # audio, viz — or absent, format_for_mode's own default arm
        case "$tier" in
        low) echo "+abr" ;;       # smallest bitrate
        medium) echo "abr:128" ;; # capped ~128k
        # high: empty — the default format table already picks the best audio
        esac
        ;;
    esac
}

# A handle is either a URL or one of this site's two id spellings. Knowing those shapes is
# ENGINE knowledge — precisely what the player gave up when it stopped being a YouTube
# tool — so the check lives here, and a bad handle is an EXTRACTION failure the player
# reports as 2+, never a usage error.
#
# BV is the modern spelling ("BV" + 10 base58-ish characters) and is what bili-search
# returns as results[].id; av<digits> is the legacy numeric one, still served and still
# what `arcurl` uses. A URL on one of this engine's hosts passes through untouched so its
# query string survives — `?p=7` selects a part of a multi-part video, and that is the
# caller's choice to make. A URL from another site is a USAGE error (1), not an extraction
# failure (2+): nothing was attempted and nothing is retryable.
# The hostname a URL names — lowercased, with userinfo, port, path, query and fragment
# removed. Lowercasing goes through `tr` because the parameter-expansion form for it is a
# bash-4 feature and the floor here is 3.2; one fork per invocation.
url_host() {
    local h=$1
    h="${h#*://}"
    h="${h%%/*}"
    h="${h%%\?*}"
    h="${h%%#*}"
    h="${h##*@}"
    h="${h%%:*}"
    printf '%s' "$h" | tr 'A-Z' 'a-z'
}

# Is this host THIS engine's? One engine, one site. An engine that resolves someone else's
# URL is lying in the `engine` field, and that field's whole job is letting a caller route
# a result back to the resolver that produced it. An explicit list rather than a substring
# test: `*.bilibili.com` matches `m.bilibili.com` and refuses `evilbilibili.com`.
is_own_host() {
    case "$1" in
    bilibili.com | b23.tv) return 0 ;;
    *.bilibili.com | *.b23.tv) return 0 ;;
    esac
    return 1
}

# One query parameter's value, or "". Split by hand and ANCHORED, like parse_start_seconds
# below and for the same two reasons: an unquoted expansion would glob, and ${var//pat/} is
# quadratic on bash 3.2 (CLAUDE.md).
query_value() {
    local q=$1 key=$2 v=""
    case "&$q" in
    *"&$key="*)
        v="${q##*"$key="}"
        v="${v%%&*}"
        ;;
    esac
    printf '%s' "$v"
}

# WHICH CONTAINER IS THIS, if any. Sets CONTAINER_KIND / CONTAINER_ID / CONTAINER_MID and
# returns 0; returns 1 and decides nothing when the handle names no container. It neither dies
# nor makes a request, because TWO verbs ask it different questions: --items asks which
# container this is, and stream resolution asks only whether it is one — so that it can say so
# instead of handing a list to yt-dlp and printing an empty stream.
#
# FOUR SHAPES, one per thing this site calls a list:
#   am<id>                                   an audio menu (the original one)
#   ml<id>  /medialist/detail/ml<id>         a favourites list
#   space…/<uid>/favlist?fid=<fid>           the same list as the browser spells it
#   space…/<uid>/lists/<sid>?type=season     a collection, and …/channel/collectiondetail?sid=
#
# THE favlist URL NEEDS ARITHMETIC, and it is measured rather than reasoned: the browser URL
# carries the uploader's `fid`, while every API here takes `media_id`, and the two are related
# by `media_id = fid * 100 + uid % 100` (checked against four real lists, 2026-09-12, 4/4).
# Without it the shape a person actually copies out of the address bar would be the one spelling
# this verb could not read.
#
# A SERIES IS NOT A COLLECTION (`?type=series`): it has its own endpoint, so it is recognised
# here only to be refused by name — a wrong list is worse than a rejected one.
container_from_handle() {
    local t=$1 u="" path="" q="" seg="" mid="" sid="" fid=""
    case "$t" in
    am[0-9]*)
        [[ "$t" =~ ^am[0-9]+$ ]] || return 1
        CONTAINER_KIND="am"; CONTAINER_ID="${t#am}"; CONTAINER_MID=""
        return 0
        ;;
    ml[0-9]*)
        [[ "$t" =~ ^ml[0-9]+$ ]] || return 1
        CONTAINER_KIND="fav"; CONTAINER_ID="${t#ml}"; CONTAINER_MID=""
        return 0
        ;;
    http://* | https://*) u="$t" ;;
    bilibili.com/* | www.bilibili.com/* | m.bilibili.com/* | space.bilibili.com/* | b23.tv/*)
        u="https://$t"
        ;;
    *) return 1 ;;
    esac

    path="${u#*://}"
    path="${path#*/}"
    case "$path" in *\?*)
        q="${path#*\?}"
        path="${path%%\?*}"
        ;;
    esac
    path="${path%%#*}"
    path="${path%/}"
    seg="${path##*/}"

    case "$path" in
    */audio/am[0-9]* | audio/am[0-9]*)
        [[ "$seg" =~ ^am[0-9]+$ ]] || return 1
        CONTAINER_KIND="am"; CONTAINER_ID="${seg#am}"; CONTAINER_MID=""
        return 0
        ;;
    */medialist/detail/ml[0-9]* | medialist/detail/ml[0-9]*)
        [[ "$seg" =~ ^ml[0-9]+$ ]] || return 1
        CONTAINER_KIND="fav"; CONTAINER_ID="${seg#ml}"; CONTAINER_MID=""
        return 0
        ;;
    esac

    # Everything left is a space.bilibili.com path, which always opens with the uploader's uid.
    mid="${path%%/*}"
    [[ "$mid" =~ ^[0-9]+$ ]] || return 1
    case "$path" in
    */favlist)
        fid=$(query_value "$q" fid)
        [[ "$fid" =~ ^[0-9]+$ ]] || return 1
        CONTAINER_KIND="fav"; CONTAINER_MID="$mid"
        CONTAINER_ID=$((fid * 100 + mid % 100))
        return 0
        ;;
    */channel/collectiondetail)
        sid=$(query_value "$q" sid)
        [[ "$sid" =~ ^[0-9]+$ ]] || return 1
        CONTAINER_KIND="season"; CONTAINER_ID="$sid"; CONTAINER_MID="$mid"
        return 0
        ;;
    */channel/seriesdetail)
        CONTAINER_KIND="series"; CONTAINER_ID=""; CONTAINER_MID="$mid"
        return 0
        ;;
    */lists/[0-9]*)
        [[ "$seg" =~ ^[0-9]+$ ]] || return 1
        if [[ "$(query_value "$q" type)" == "series" ]]; then
            CONTAINER_KIND="series"; CONTAINER_ID="$seg"; CONTAINER_MID="$mid"
            return 0
        fi
        CONTAINER_KIND="season"; CONTAINER_ID="$seg"; CONTAINER_MID="$mid"
        return 0
        ;;
    esac
    return 1
}

# The ?t= seconds a handle carries, floored to a whole second, or "" when it carries none.
#
# This engine parses the timestamp ITSELF, and that asymmetry with yt-resolve is measured,
# not stylistic: yt-dlp's YouTube extractor publishes .start_time for every writing that
# site has, and its Bilibili extractor publishes the key in NO form at all (measured
# 2026-08-30 against yt-dlp 2026.08.19: ?t=601, ?t=601.5 and ?p=2&t=60 all come back with
# no start_time). One key, two sources — which is the house seam: the envelope, not the
# tool behind it. Only `?t=` is read, because only `?t=` was measured to exist here; a
# writing nobody could produce is not implemented on the strength of a guess.
#
# Split by hand rather than `for p in $q` — an unquoted expansion would glob, and a query
# value really can hold a `*`. Every expansion below is ANCHORED (`%%`/`#`), never the
# ${var//pat/} substitution form, which is O(n2) on bash 3.2 (CLAUDE.md).
parse_start_seconds() {
    local url=$1 q p v=""
    case "$url" in
    *\?*) q=${url#*\?} ;;
    *) return 0 ;;
    esac
    q=${q%%#*}
    while [[ -n "$q" ]]; do
        p=${q%%&*}
        case "$q" in
        *\&*) q=${q#*&} ;;
        *) q="" ;;
        esac
        case "$p" in
        t=*) v=${p#t=} ;;
        esac
    done
    # An unreadable value is NOT an error: it did not answer a question that had to be
    # answered, so the envelope says null and the resolve carries on. Fractions floor for
    # the reason yt-resolve's start_secs floors — the key counts seconds already gone by.
    [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 0
    TARGET_START=${v%%.*}
}

# The part number carried in ?p=N, or empty when N <= 1 or missing.
url_part_number() {
    local u=$1 q="" p=""
    case "$u" in
    *\?*) q="${u#*\?}" ;;
    esac
    q="${q%%#*}"
    case "&$q" in
    *[\&]p=*)
        p="${q##*p=}"
        p="${p%%&*}"
        ;;
    esac
    if [[ "$p" =~ ^[0-9]+$ ]] && ((p > 1)); then
        printf '%s' "$p"
    fi
}

# An audio single handle (/audio/au<digits>), or empty.
url_audio_id() {
    local u="${1%%#*}"
    u="${u%%\?*}"
    u="${u%/}"
    local seg="${u##*/}"
    if [[ "$seg" =~ ^au[0-9]+$ ]]; then
        printf '%s' "$seg"
    fi
}

# The BV/av id inside a normalised watch URL, or empty when it carries none.
#
# `--parts` is the one verb here whose input grammar is NARROWER than stream resolution's:
# its endpoint takes an id (`bvid=` / `aid=`) and has no URL form, while `-f`'s yt-dlp takes
# the URL and works out the rest. A b23.tv short link is the shape that separates them — it
# is a REDIRECT, not a spelling of an id, so serving it would mean a second request this
# verb deliberately does not make. Empty is returned and the caller is told which handle to
# pass instead; guessing an id is the one thing that must not happen.
#
# Both the path form (.../video/BV…) and the query form (?bvid=…) are read, because share
# URLs use both and either is a handle a person really pastes.
target_id() {
    local u="${1%%#*}" q="" seg
    case "$u" in *\?*)
        q="${u#*\?}"
        u="${u%%\?*}"
        ;;
    esac
    u="${u%/}"
    seg="${u##*/}"
    if [[ ! "$seg" =~ ^(BV[A-Za-z0-9]{10}|av[0-9]+)$ ]]; then
        case "&$q" in
        *[\&]bvid=*)
            seg="${q##*bvid=}"
            seg="${seg%%&*}"
            ;;
        *[\&]aid=*)
            seg="${q##*aid=}"
            seg="av${seg%%&*}"
            ;;
        *) seg="" ;;
        esac
        [[ "$seg" =~ ^(BV[A-Za-z0-9]{10}|av[0-9]+)$ ]] || seg=""
    fi
    printf '%s' "$seg"
}

# A handle is either a URL or one of this site's two id spellings.
# Every accepted handle collapses to its canonical form:
#   - Video: `https://www.bilibili.com/video/BV...` (or with `?p=N` when N > 1)
#   - Audio track: `https://www.bilibili.com/audio/au...`
#   - Short link: `https://b23.tv/...` (query stripped)
#
# All tracking parameters (spm_id_from, vd_source, share_source, etc.) are stripped,
# keeping persistent stores and history records idempotent across copy-pasting and searching.
normalize_target() {
    local t=$1 host vid part au_id
    case "$t" in
    http://* | https://*)
        host=$(url_host "$t")
        is_own_host "$host" ||
            die "'$host' is not a Bilibili host — this engine resolves Bilibili only (another site needs its own engine: t-play --engine NAME)"
        ;;
    bilibili.com/* | www.bilibili.com/* | m.bilibili.com/* | b23.tv/*)
        t="https://$t"
        ;;
    BV*)
        [[ "$t" =~ ^BV[A-Za-z0-9]{10}$ ]] ||
            die "'$t' is not a BV id (expected BV followed by 10 characters)"
        TARGET_URL="https://www.bilibili.com/video/$t"
        return 0
        ;;
    av[0-9]*)
        [[ "$t" =~ ^av[0-9]+$ ]] ||
            die "'$t' is not a Bilibili handle (expected a BV id, an av id, or a URL)"
        TARGET_URL="https://www.bilibili.com/video/$t"
        return 0
        ;;
    am[0-9]* | ml[0-9]*)
        die "'$t' is a container, not a video — use --items to list what is in it"
        ;;
    *)
        die "'$t' is neither a Bilibili URL nor a BV/av id (to search, run bili-search)"
        ;;
    esac

    # A CONTAINER URL IS REFUSED BY NAME rather than half-resolved. Handing one to yt-dlp is
    # what this guards: an album URL comes back status "ok" with an empty stream list, which is
    # the one answer a caller cannot act on. ARCH-engine.md「容器（--items）」.
    if container_from_handle "$t"; then
        die "'$t' is a container, not a video — use --items to list what is in it"
    fi

    parse_start_seconds "$t"

    vid=$(target_id "$t")
    if [[ -n "$vid" ]]; then
        part=$(url_part_number "$t")
        if [[ -n "$part" ]]; then
            TARGET_URL="https://www.bilibili.com/video/$vid?p=$part"
        else
            TARGET_URL="https://www.bilibili.com/video/$vid"
        fi
        return 0
    fi

    au_id=$(url_audio_id "$t")
    if [[ -n "$au_id" ]]; then
        TARGET_URL="https://www.bilibili.com/audio/$au_id"
        return 0
    fi

    host=$(url_host "$t")
    case "$host" in
    b23.tv | *.b23.tv)
        TARGET_URL="${t%%\?*}"
        return 0
        ;;
    esac

    TARGET_URL="$t"
}

# --items' OWN handle grammar, BESIDE normalize_target rather than inside it. The two answer
# different questions — one wants a video, the other a menu — and merging them would teach the
# stream verb to accept a container it can only answer with an empty stream list.
#
# What they do share is the HOST gate, and it fires first here too: an off-site URL is the same
# usage error at every verb and must be reported before this engine's opinion about what a
# container looks like. tests/contract.sh reads that ordering off every read-only verb.
normalize_container() {
    local t=$1 host
    case "$t" in
    http://* | https://*)
        host=$(url_host "$t")
        is_own_host "$host" ||
            die "'$host' is not a Bilibili host — this engine resolves Bilibili only (another site needs its own engine: t-play --engine NAME)"
        ;;
    esac

    container_from_handle "$t" ||
        die "'$t' is not a Bilibili container — --items takes an audio menu (am<id>), a favourites list (ml<id> or a favlist URL) or a collection URL (space.bilibili.com/<uid>/lists/<sid>?type=season). For the parts of one video, that is --parts"

    case "$CONTAINER_KIND" in
    am) CONTAINER_URL="https://www.bilibili.com/audio/am$CONTAINER_ID" ;;
    fav) CONTAINER_URL="https://www.bilibili.com/medialist/detail/ml$CONTAINER_ID" ;;
    season) CONTAINER_URL="https://space.bilibili.com/$CONTAINER_MID/lists/$CONTAINER_ID?type=season" ;;
    series)
        die "'$t' is a series, not a collection — this site keeps the two in different endpoints and --items reads collections (…/lists/<sid>?type=season)"
        ;;
    esac
}

# ==============================================================================
# 3. STREAM RESOLUTION
# ==============================================================================

# ONE yt-dlp call answers the whole question: the media URL(s) for the selected format, the
# per-format http_headers that must accompany them, and the title/duration the player needs
# for its OSD and its state record. --dump-single-json runs format selection, so
# `requested_formats` is present exactly when the selection merged two streams.
#
# --no-playlist is load-bearing HERE in a way it is not on the sibling engine: this site's
# music results are overwhelmingly multi-part collections, and a search result that is a
# 50-track compilation would otherwise expand into 50 extractions. With it, the handle
# resolves to part one in 2.7s (measured). A caller that wants another part says so in the
# URL (`?p=7`).
dump_once() {
    local cmd=(yt-dlp --dump-single-json --no-playlist -f "$FMT")
    if [[ -n "$FORMAT_SORT" ]]; then
        # -S is the expert escape and explicitly wins over the tier: both given, the
        # caller's own sort replaces the table's (ARCH-engine.md「解析」).
        cmd+=(--format-sort "$FORMAT_SORT")
    else
        local sort
        sort=$(quality_sort_for_tier "$PLAYBACK_MODE" "$QUALITY")
        [[ -n "$sort" ]] && cmd+=(--format-sort "$sort")
    fi
    (($#)) && cmd+=("$@")
    cmd+=(--no-warnings --quiet "$TARGET_URL")
    "${cmd[@]}" 2>>"$ERR_FILE"
}

# Project a raw yt-dlp record down to [ {url, http_headers} ], VIDEO FIRST. jq's sort is
# stable, so a merge keeps yt-dlp's own ordering within each class and an audio-only
# selection stays a one-element list. The player reads position, not codec: element 0 is
# what mpv opens, element 1 (when present) is its --audio-file.
#
# Credential-bearing headers are STRIPPED. The player turns every header in this object
# into an mpv `--http-header-fields-append=` argument, and mpv's argv is visible in `ps` to
# every process on the machine — so a Cookie carrying this account's SESSDATA would be
# world-readable for as long as playback lasts. This site's records were measured to carry
# only User-Agent / Accept / Accept-Language / Sec-Fetch-Mode / Referer, so today the
# filter removes nothing; it is here so that a future extractor change cannot quietly turn
# a login into a leak. CLAUDE.md § security.
JQ_STREAMS='
def safe_headers:
  (. // {}) | with_entries(select(.key | ascii_downcase
                                       | . != "cookie" and . != "authorization" and . != "set-cookie"));
[ if (.requested_formats | type) == "array"
  then (.requested_formats[] | {url: .url, http_headers: (.http_headers | safe_headers), vcodec: (.vcodec // "none")})
  else {url: .url, http_headers: (.http_headers | safe_headers), vcodec: (.vcodec // "none")}
  end
]
| map(select(.url != null))
| sort_by(if .vcodec == "none" then 1 else 0 end)
'

# The resolve envelope (ARCH-cli-contract.md「数据契约」) — the same one yt-resolve emits, key for
# key, because the player must not be able to tell which engine answered. `format` is the
# format STRING this engine SENT; the player records it verbatim and never reads it, and
# `selected` is what yt-dlp answered with ("1080P 高清+30280 - audio only"). Same two
# spellings as the sibling engine: `$format` is the argument, a bare `.format` is the raw
# record's own field. `http_headers` is a REQUIRED key, empty object when none — and on this site it is
# never empty in practice: the CDN checks Referer, and a bare URL 403s where the same URL
# with a Referer answers 206. That is the contract hole this key exists to close.
emit_stream() {
    local raw=$1 retried=$2
    local retried_json=false
    ((retried)) && retried_json=true

    if [[ "$OUTPUT_MODE" == "json_full" ]]; then
        printf '%s\n' "$raw" | jq -c '.'
        return 0
    fi
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        printf '%s\n' "$raw" | jq -c \
            --arg engine "$ENGINE_NAME" --arg mode "$PLAYBACK_MODE" --arg format "$FMT" \
            --argjson retried "$retried_json" --argjson start "${TARGET_START:-null}" \
            "$JQ_PRELUDE
             ($JQ_STREAMS) as \$s
             | {status: \"ok\", engine: \$engine,
                id: (.id // null), url: ((.webpage_url // null) | strip_t),
                title: (.title // null), duration: (.duration // null),
                start_seconds: \$start,
                mode: \$mode, format: \$format,
                selected: (.format // null),
                selected_resolution: (.resolution // null),
                stream_urls: [\$s[].url],
                http_headers: (\$s[0].http_headers // {}),
                retried: \$retried}"
        return 0
    fi
    # Prose: the stream URLs, one per line — what a human piping this into another tool
    # wants. Note that on this site such a URL is NOT usable on its own; the headers from
    # -j have to go with it.
    printf '%s' "$raw" | jq -r "$JQ_STREAMS | .[].url"
}

# Report a resolve that produced nothing usable. Exit code follows the suite taxonomy: 2+
# is a PROPAGATED tool failure and 1 is reserved for usage, so a yt-dlp status of 0 or 1 is
# FLOORED to 2 — yt-dlp exits 1 for an unavailable video, and letting that through would
# make "this video is gone" indistinguishable from "you called me wrong".
resolve_fail() {
    local rc=$1 reason
    reason=$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")
    ((rc <= 1)) && rc=2
    if [[ "$OUTPUT_MODE" == "json" || "$OUTPUT_MODE" == "json_full" ]]; then
        jq -nc --arg engine "$ENGINE_NAME" --arg url "$TARGET_URL" \
            --arg mode "$PLAYBACK_MODE" --arg reason "$reason" \
            '{status: "error", engine: $engine, url: $url, mode: $mode, reason: $reason}'
    else
        echo "bili-resolve: could not resolve a stream for $TARGET_URL ($reason)" >&2
    fi
    exit "$rc"
}

# Cookies are ON by default because on this site they buy audio quality. If the cookie
# attempt FAILS — a locked profile, a denied keychain, an expired session — the anonymous
# client is tried before giving up, because a public video plays either way and losing the
# Hi-Res rendition beats losing the track.
#
# There is deliberately NO fetch probe here, and its absence is the point. yt-resolve
# test-fetches its resolved URL because a googlevideo link missing its proof-of-origin
# token resolves fine and then 403s at play time — a YouTube-specific defect, patched with
# a YouTube-specific anonymous client. This site has no such failure mode, so inheriting
# the probe would mean one extra HTTP round trip per play against a host that rate-limits,
# to answer a question that cannot come out wrong. A new engine inherits the CONTRACT, not
# the other engine's workarounds.
resolve_stream() {
    ensure_scratch
    FMT=$(format_for_mode "$PLAYBACK_MODE")

    local raw_c="" rc_c=0 raw_a="" rc_a=0

    if ((${#COOKIE_ARGS[@]} > 0)); then
        raw_c=$(dump_once "${COOKIE_ARGS[@]}") || rc_c=$?
        # The anonymous attempt below already covers a store that cannot be read; this only
        # says so, once, in words (see cookie_diagnosis).
        if ((rc_c != 0)) && [[ "$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc_c")" == "cookies" ]]; then
            cookie_diagnosis "$(cat "$ERR_FILE" 2>/dev/null)" >&2
        fi
        if ((rc_c == 0)) && [[ -n "$raw_c" ]]; then
            emit_stream "$raw_c" 0
            return 0
        fi
        raw_a=$(dump_once) || rc_a=$?
        if ((rc_a == 0)) && [[ -n "$raw_a" ]]; then
            emit_stream "$raw_a" 1
            return 0
        fi
        # The COOKIE attempt's status is reported, not the fallback's: it is the one that
        # describes what the caller asked for.
        resolve_fail "$rc_c"
    fi

    # Anonymous-only (BILI_COOKIE_BROWSER=none, or no profile on this machine).
    raw_a=$(dump_once) || rc_a=$?
    if ((rc_a == 0)) && [[ -n "$raw_a" ]]; then
        emit_stream "$raw_a" 0
        return 0
    fi
    resolve_fail "$rc_a"
}

# ==============================================================================
# 4. METADATA VERB (read-only: nothing plays, no mpv, no state file)
# ==============================================================================

# Rich metadata WITHOUT playing, mirroring `yt-resolve --info` field for field so a caller
# does not branch on which engine answered. -j projects a lean schema (the raw record
# carries ~40 fields of formats and thumbnails that are pure token ballast for a headless
# caller); -J returns the full raw record; the default is a readable text block.
resolve_info() {
    ensure_scratch
    local cmd=(yt-dlp --dump-single-json --no-playlist --skip-download)
    cmd+=(--no-warnings --quiet "$TARGET_URL")

    local raw rc=0
    raw=$(ytdlp_cookied "${cmd[@]}") || rc=$?

    if ((rc != 0)) || [[ -z "$raw" ]]; then
        local reason
        reason=$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")
        if [[ "$OUTPUT_MODE" == "json" || "$OUTPUT_MODE" == "json_full" ]]; then
            jq -nc --arg engine "$ENGINE_NAME" --arg url "$TARGET_URL" --arg reason "$reason" \
                '{status: "error", engine: $engine, url: $url, reason: $reason}'
            exit 1
        fi
        die "could not fetch metadata for: $TARGET_URL ($reason)"
    fi

    # Same jq prelude as search, so --info and search can never drift on this format.
    local duration_fmt
    duration_fmt=$(printf '%s' "$raw" | jq -r "$JQ_PRELUDE (.duration | fmt_dur) // empty")

    case "$OUTPUT_MODE" in
    json_full)
        printf '%s\n' "$raw" | jq -c '.'
        ;;
    json)
        # `channel` falls back to `uploader`: this extractor fills the uploader field and
        # leaves channel null on some records, and the envelope's shape must not depend on
        # which. live_status is passed through as whatever the record says, or null.
        # `kind`, `access` and `thumbnail` are here so the envelope carries every key a search
        # row does: the same judgement bili-search makes (track/full), and the cover under the
        # same https rule, read from yt-dlp's `thumbnail` where search reads the site's `pic`.
        printf '%s\n' "$raw" | jq -c --arg engine "$ENGINE_NAME" --arg df "$duration_fmt" \
            --argjson start "${TARGET_START:-null}" \
            "$JQ_PRELUDE"'{
            status: "ok",
            engine: $engine,
            id, title,
            url: (.webpage_url | strip_t),
            channel: (.channel // .uploader // null),
            uploader: (.uploader // null),
            upload_date: (.upload_date // null),
            duration, duration_fmt: (if $df == "" then null else $df end),
            start_seconds: $start,
            view_count: (.view_count // null),
            like_count: (.like_count // null),
            live_status: (.live_status // null),
            description: (.description // null),
            kind: "track", access: "full",
            thumbnail: ((.thumbnail // "") as $p
                        | if ($p | type) != "string" or $p == "" then null
                          elif ($p | startswith("//")) then "https:" + $p
                          elif ($p | startswith("http://")) then ($p | sub("^http://"; "https://"))
                          elif ($p | startswith("https://")) then $p
                          else null end),
            chapters: (if (.chapters | type) == "array"
                       then [.chapters[] | {start_time, end_time, title}]
                       else null end)
        }'
        ;;
    *)
        local title channel upload_date view_count like_count webpage_url description
        title=$(printf '%s' "$raw" | jq -r '.title // "(untitled)"')
        channel=$(printf '%s' "$raw" | jq -r '.channel // .uploader // "?"')
        upload_date=$(printf '%s' "$raw" | jq -r '.upload_date // "?"')
        view_count=$(printf '%s' "$raw" | jq -r '.view_count // "?"')
        like_count=$(printf '%s' "$raw" | jq -r '.like_count // "?"')
        webpage_url=$(printf '%s' "$raw" | jq -r '.webpage_url // empty')
        description=$(printf '%s' "$raw" | jq -r '.description // ""')

        if [[ -n "$MUSIC_CHAR" ]]; then printf '%s %s\n' "$MUSIC_CHAR" "$title"; else printf '%s\n' "$title"; fi
        printf '  - channel: %s\n' "$channel"
        printf '  - uploaded: %s\n' "$upload_date"
        [[ -n "$duration_fmt" ]] && printf '  - duration: %s\n' "$duration_fmt"
        printf '  - views: %s   likes: %s\n' "$view_count" "$like_count"
        [[ -n "$webpage_url" ]] && printf '  - url: %s\n' "$webpage_url"

        local chapters_txt
        chapters_txt=$(printf '%s' "$raw" | jq -r '
            if (.chapters | type) == "array" and (.chapters | length) > 0 then
                .chapters[]
                | ((.start_time // 0) | floor) as $s
                | (($s / 60) | floor) as $m
                | ($s - $m * 60) as $sec
                | "  " + ($m | tostring) + ":" + (if $sec < 10 then "0" else "" end) + ($sec | tostring) + "  " + (.title // "")
            else empty end')
        [[ -n "$chapters_txt" ]] && printf '\nChapters:\n%s\n' "$chapters_txt"

        [[ -n "$description" ]] && printf '\nDescription:\n%s\n' "$description"
        ;;
    esac
    exit 0
}

# ==============================================================================
# 5. THE PARTS VERB (read-only: one HTTP request, no yt-dlp, no state file)
# ==============================================================================

# ONE video number can be MANY playable files here — `?p=N` — and that is this site's own
# shape, not a suite-wide one: on the sibling site an id is a file and its many-item form is
# a playlist under a different URL. So the verb exists on this engine and never on that one.
# An engine states a capability by HAVING the verb (ARCH-cli-contract.md「命令规格」), which is the
# same way this file states the absence of captions by having no --transcript.
#
# The search half cannot answer this and must not try: its response carries no part count at
# all (measured — every numeric field on a 100-part row, and not one of them is it), so
# reporting it there would mean one extra request PER ROW against the endpoint where
# requests are the scarce resource (ARCHITECTURE.md「站点知识的边界」). The resolve half answers it in one.

VIEW_CURL_RC=0
VIEW_HTTP=""
VIEW_CODE=""

# The transport seam, twin of bili-search's `fetch_page_once`: arguments reach curl as an
# ARRAY and the id through --data-urlencode, so nothing in a handle can be read as a further
# curl argument or leak into the query. Success is all three of curl exiting 0, HTTP 200 and
# a body `code` of 0 — this host answers 200 with a negative body code for a video that is
# gone, so the HTTP status alone is not the answer.
#
# NO RETRY, unlike the sibling half's one. That retry exists for a BURST: bili-search spends
# several requests per query and this host's limiter is bursty, so a 412 in the middle of a
# page plan is very often a 200 a second later. This verb spends exactly one request per
# invocation and has no burst to smooth out — a retry here would just be a second request
# made on the caller's behalf without being asked. `network` is the enum member that already
# means retryable, and the decision to spend another request is the caller's.
fetch_view_once() {
    local id=$1 body=$2
    local cmd=(
        curl -sS --compressed
        --max-time 15 --retry 0
        -o "$body" -w '%{http_code}'
        -G "$VIEW_ENDPOINT"
        -H "User-Agent: $BILI_UA"
        -H "Referer: $VIEW_REFERER"
    )
    case "$id" in
    av*) cmd+=(--data-urlencode "aid=${id#av}") ;;
    *) cmd+=(--data-urlencode "bvid=$id") ;;
    esac

    VIEW_CURL_RC=0
    VIEW_HTTP=$("${cmd[@]}" 2>/dev/null) || VIEW_CURL_RC=$?
    VIEW_CODE=""
    if [[ -s "$body" ]]; then
        VIEW_CODE=$(jq -r '.code // empty' "$body" 2>/dev/null) || VIEW_CODE=""
    fi
    ((VIEW_CURL_RC == 0)) && [[ "$VIEW_HTTP" == "200" && "$VIEW_CODE" == "0" ]]
}

# The fallback attempt, spent only after `view` has already refused (see THE PARTS ENDPOINTS
# above for the measurement). Same shape, same three success conditions, and it writes the
# SAME three globals — so one `classify_view_error` reads either attempt and this file grows
# no second error table for a second spelling of one question.
#
# Its body is a FLAT `data[]` of parts rather than `view`'s `.data.pages[]`, and it carries
# no `.data.bvid` / `.data.title` / `.data.duration`, which is what `JQ_PARTS_PAGELIST` below
# exists to project and what the envelope loses when this path is taken.
fetch_pagelist_once() {
    local id=$1 body=$2
    local cmd=(
        curl -sS --compressed
        --max-time 15 --retry 0
        -o "$body" -w '%{http_code}'
        -G "$PAGELIST_ENDPOINT"
        -H "User-Agent: $BILI_UA"
        -H "Referer: $VIEW_REFERER"
    )
    case "$id" in
    av*) cmd+=(--data-urlencode "aid=${id#av}") ;;
    *) cmd+=(--data-urlencode "bvid=$id") ;;
    esac

    VIEW_CURL_RC=0
    VIEW_HTTP=$("${cmd[@]}" 2>/dev/null) || VIEW_CURL_RC=$?
    VIEW_CODE=""
    if [[ -s "$body" ]]; then
        VIEW_CODE=$(jq -r '.code // empty' "$body" 2>/dev/null) || VIEW_CODE=""
    fi
    ((VIEW_CURL_RC == 0)) && [[ "$VIEW_HTTP" == "200" && "$VIEW_CODE" == "0" ]]
}

# HTTP status + body code -> the suite's shared reason enum (ARCH-cli-contract.md「数据契约」). The
# same two tables bili-search classifies with, because they describe the same host — and
# separate from `classify_yt_dlp_error` above, which reads an extractor's prose. The
# distinction that earns the table its lines: a bogus id answers HTTP 200 / code -400
# (measured), and calling that `network` would tell an agent to retry forever a handle that
# will never resolve.
classify_view_error() {
    local rc=$1 http=$2 code=$3
    ((rc != 0)) && {
        echo "network"
        return
    }
    case "$http" in
    412 | 429 | 5??)
        echo "network"
        return
        ;;
    403)
        echo "forbidden"
        return
        ;;
    404)
        echo "unavailable"
        return
        ;;
    esac
    case "$code" in
    -352 | -412 | -509 | -799)
        echo "network"
        return
        ;;
    -403 | 62002)
        echo "forbidden"
        return
        ;;
    -404 | -400)
        echo "unavailable"
        return
        ;;
    esac
    echo "unknown"
}

# The error envelope --info already publishes, minus the fields a part list has no opinion
# on. Exit 2, never 1: nothing here is the caller's usage error by the time a request has
# been made, and the taxonomy reserves 1 for the ones decided from argv (ARCH-cli-contract.md「退出码」).
parts_fail() {
    local reason=$1
    if [[ "$OUTPUT_MODE" == "json" || "$OUTPUT_MODE" == "json_full" ]]; then
        jq -nc --arg engine "$ENGINE_NAME" --arg url "$TARGET_URL" --arg reason "$reason" \
            '{status: "error", engine: $engine, url: $url, reason: $reason}'
    else
        echo "bili-resolve: could not list the parts of $TARGET_URL ($reason)" >&2
    fi
    exit 2
}

# EVERY PART IS AN ITEM RECORD. `{engine, url, title, duration, …}` is exactly what
# t-playlist stores and what t-play --queue consumes, so `--parts -j | jq '{items:.parts}'`
# pipes into either of them with no field renamed — a part list IS a playlist the caller has
# not saved yet. That is the whole reason the elements carry `engine` and a full `url`
# rather than a bare part number: a record here is a CALL, never a reference.
#
# The canonical id is the one the SITE returns (.data.bvid), not the one that was typed: an
# av handle resolves to its BV spelling, so every url built below is the canonical form and
# a record stored from an av call still names the same video a search row does.
JQ_PARTS='
(.data.bvid // $fallback) as $id
| ("https://www.bilibili.com/video/" + $id) as $base
| (.data.duration // ([.data.pages[].duration] | add)) as $total
| {status: "ok", engine: $engine, id: $id, url: $base,
   title: (.data.title // null),
   count: (.data.pages | length),
   total_duration: ($total // null),
   total_duration_fmt: (($total | fmt_dur) // null),
   parts: [ .data.pages[]
            | {n: .page, engine: $engine,
               url: ($base + "?p=" + (.page | tostring)),
               title: (.part // null),
               duration: (.duration // null),
               duration_fmt: ((.duration | fmt_dur) // null)} ]}
'

# The same envelope off `pagelist`'s thinner body, and the three fields it cannot fill:
#
#   id / url   the TYPED handle, because this endpoint returns no `.data.bvid`. An av handle
#              therefore stays in its av spelling here where `view` would have canonicalised
#              it to BV — the records still name the same video and still resolve, they just
#              do not agree letter-for-letter with a search row's url.
#   title      null. That is an ALREADY-LEGAL value of this field (`view` emits it for a
#              record with no title), so nothing downstream learns a new shape — and it is
#              the honest answer, not a guessed one. The part titles are all present.
#   total_dur  summed from the parts, which `JQ_PARTS` already does whenever `view` omits it.
#
# Everything the verb is actually FOR — the part list, each part's number, title, duration
# and its own playable url — comes through whole.
JQ_PARTS_PAGELIST='
$fallback as $id
| ("https://www.bilibili.com/video/" + $id) as $base
| ([.data[].duration] | add) as $total
| {status: "ok", engine: $engine, id: $id, url: $base,
   title: null,
   count: (.data | length),
   total_duration: ($total // null),
   total_duration_fmt: (($total | fmt_dur) // null),
   parts: [ .data[]
            | {n: .page, engine: $engine,
               url: ($base + "?p=" + (.page | tostring)),
               title: (.part // null),
               duration: (.duration // null),
               duration_fmt: ((.duration | fmt_dur) // null)} ]}
'

resolve_parts() {
    ensure_scratch

    local id
    id=$(target_id "$TARGET_URL")
    [[ -n "$id" ]] ||
        die "--parts needs a BV or av id and '$TARGET' carries none (a b23.tv link is a redirect, not an id — open it once, or pass the BV id bili-search returns)"

    local body="$SCRATCH_DIR/view.json"
    local shape jq_parts
    shape='(.data.pages | type) == "array" and (.data.pages | length) > 0'
    jq_parts="$JQ_PARTS"

    if ! fetch_view_once "$id" "$body"; then
        # THE VIEW REASON IS THE REPORTED ONE, decided here and carried past the second
        # attempt: `view` has the richer error vocabulary of the two (a bogus id is 200 with
        # body code -400 there), and a fallback that also fails should not downgrade a
        # verdict the preferred endpoint already gave.
        local reason
        reason=$(classify_view_error "$VIEW_CURL_RC" "$VIEW_HTTP" "$VIEW_CODE")

        # `unavailable` is the one class that is a statement about the HANDLE rather than
        # about the request — a deleted or nonexistent video answers the same way at every
        # endpoint, so a second request buys nothing. That is the same argument this file
        # already makes for not retrying, applied to not falling back.
        [[ "$reason" == "unavailable" ]] && parts_fail "$reason"

        body="$SCRATCH_DIR/pagelist.json"
        shape='(.data | type) == "array" and (.data | length) > 0'
        jq_parts="$JQ_PARTS_PAGELIST"
        if ! fetch_pagelist_once "$id" "$body"; then
            # …with one exception, and it is the same distinction: whichever endpoint
            # manages to say `unavailable` is making a statement about the HANDLE, and that
            # outranks a blanket refusal of the REQUEST. While `view` answers 412 to
            # everything, this is the only path by which a nonexistent id is still reported
            # as nonexistent (pagelist answers 200/-404 for it) instead of as a retryable
            # network fault an agent would go on asking about.
            local fb_reason
            fb_reason=$(classify_view_error "$VIEW_CURL_RC" "$VIEW_HTTP" "$VIEW_CODE")
            [[ "$fb_reason" == "unavailable" ]] && reason="$fb_reason"
            parts_fail "$reason"
        fi
    fi

    # A 200/code:0 whose record has no parts is not a video this verb can describe. Checked
    # before the projection rather than after: `.data.pages[]` on a missing key would emit an
    # envelope with count 0 and an empty list, which reads as "this video has no parts" —
    # and every video here has at least one.
    jq -e "$shape" "$body" >/dev/null 2>&1 ||
        parts_fail "unavailable"

    if [[ "$OUTPUT_MODE" == "json_full" ]]; then
        jq -c '.' "$body"
        return 0
    fi

    local env_json
    env_json=$(jq -c --arg engine "$ENGINE_NAME" --arg fallback "$id" \
        "$JQ_PRELUDE $jq_parts" "$body") ||
        parts_fail "unknown"

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        printf '%s\n' "$env_json"
        return 0
    fi

    # Prose, in the vocabulary --info and t-playlist --show already speak: the title, a
    # dashed summary line, then one line per part. A single-part video is not a special
    # case and not an error — it prints one row and says so in the count.
    local title count total_fmt
    title=$(printf '%s' "$env_json" | jq -r '.title // "(untitled)"')
    count=$(printf '%s' "$env_json" | jq -r '.count')
    total_fmt=$(printf '%s' "$env_json" | jq -r '.total_duration_fmt // "?"')

    if [[ -n "$MUSIC_CHAR" ]]; then
        printf '%s %s\n' "$MUSIC_CHAR" "$title"
    else
        printf '%s\n' "$title"
    fi
    printf '  - parts: %s   total: %s\n' "$count" "$total_fmt"
    printf '%s' "$env_json" | jq -r '.parts[] | "  \(.n). \(.title // "")  \(.duration_fmt // "")"'
    return 0
}

# ==============================================================================
# 6. THE ITEMS VERB (read-only: HTTP only, no yt-dlp, no state file)
# ==============================================================================

# A CONTAINER IS NOT A ROW. An audio menu holds tens to hundreds of tracks and has no duration
# of its own; what it has is a track count and a page cursor, and neither of those has anywhere
# to live on a search row — so a container gets its own verb and its own envelope rather than a
# `kind` on the row model. ARCH-engine.md「容器（--items）」.
#
# EVERY ITEM IS AN ITEM RECORD, the same claim --parts makes about its parts: `{engine, id, url,
# title, duration}` is what t-playlist stores and what t-play --queue consumes, and the key is
# `items` because that is the name both of them already read. So `--items -j` pipes into either
# with nothing renamed and neither of them changed a line to accept it. Each record carries its
# own `engine` and a complete playable url, because a record here is a CALL, not a reference.
#
# Item ids are the SITE's digits and the url is the `au` spelling of them — the pair that
# resolving one of these tracks answers with (measured: `bili-resolve -j -- .../audio/au2478206`
# reports id "2478206"). A record stored out of this envelope therefore names its track exactly
# the way the resolve envelope for it does.
#
# yt-dlp HAS both of these endpoints (BilibiliAudioAlbumIE) and is still not used, for --parts'
# reason plus one: it fetches a single page of 100 and never pages, so a menu longer than that
# would come back silently short. Two GETs this file already knows how to make cost no python
# start.

# ONE TRANSPORT FOR EVERY CONTAINER ENDPOINT, twin of fetch_view_once and writing the SAME
# three globals, so classify_view_error reads all four endpoints and no second error table
# grows here. The referer is a parameter because it is the one header that differs: the audio
# endpoints want the site root, and the space endpoint answers `-352` to anything else
# (measured 2026-09-12).
items_http_get() {
    local body=$1 referer=$2 url=$3
    shift 3
    local cmd=(
        curl -sS --compressed
        --max-time 15 --retry 0
        -o "$body" -w '%{http_code}'
        -G "$url"
        -H "User-Agent: $BILI_UA"
        -H "Referer: $referer"
        "$@"
    )

    VIEW_CURL_RC=0
    VIEW_HTTP=$("${cmd[@]}" 2>/dev/null) || VIEW_CURL_RC=$?
    VIEW_CODE=""
    if [[ -s "$body" ]]; then
        VIEW_CODE=$(jq -r '.code // empty' "$body" 2>/dev/null) || VIEW_CODE=""
    fi
    ((VIEW_CURL_RC == 0)) && [[ "$VIEW_HTTP" == "200" && "$VIEW_CODE" == "0" ]]
}

# Exit 2, never 1 and never 4: by the time a request has been made nothing here is the caller's
# usage error, and 4 is the lifecycle/storage code an engine never emits. `reason` is the shared
# enum (ARCH-cli-contract.md「数据契约」), same three-line envelope --parts publishes.
items_fail() {
    local reason=$1
    if [[ "$OUTPUT_MODE" == "json" || "$OUTPUT_MODE" == "json_full" ]]; then
        jq -nc --arg engine "$ENGINE_NAME" --arg url "$CONTAINER_URL" --arg reason "$reason" \
            '{status: "error", engine: $engine, url: $url, reason: $reason}'
    else
        echo "bili-resolve: could not list the items of $CONTAINER_URL ($reason)" >&2
    fi
    exit 2
}

# WHAT THE THREE CONTAINERS DIFFER BY, and it is only ever these six things — so there is one
# paging loop below rather than three. Each collector fills these in, then calls it.
ITEMS_PAGE_SIZE=0       # the site's cap for this endpoint, measured, never a guess
ITEMS_PAGE_PARAM=""     # pn | page_num
ITEMS_SIZE_PARAM=""     # ps | page_size
ITEMS_ROWS_PATH=""      # jq path to the rows on one page
ITEMS_TOTAL_PATH=""     # jq path to the count the site reports
ITEMS_MORE_PATH=""      # jq path to the site's OWN has_more, "" where it has none

ITEMS_TITLE=""          # the container's own name
ITEMS_TOTAL="null"      # what the site says it holds
ITEMS_RAW="[]"          # this batch's rows, upstream shape, unfiltered
ITEMS_TAKEN=0           # how many of them there are — the cursor's arithmetic, not the envelope's
ITEMS_HAS_MORE=false
ITEMS_PAGES=()

# THE PAGING LOOP. Pages are spent only while there is reason to: a short page is the last page,
# the site's own count says when the list is complete, its own has_more says so where it has one,
# and the batch ceiling stops a very long list. A page past the end answers an empty array
# (measured on all three), so the loop cannot run away on a site that keeps saying yes.
#
# THE BATCH IS THE CEILING ROUNDED DOWN TO A WHOLE PAGE (480 for a favourites list of 40s, 500
# for the two 100s). That rounding is what keeps a cursor honest: every offset this verb hands
# out lands on a page boundary, so continuing costs no re-reading and no overlap. A cursor that
# does NOT land on one is still answered correctly — the loop starts at the page holding it and
# drops the rows before it — because a caller is allowed to have kept an old token.
items_page_loop() {
    local endpoint=$1 referer=$2
    shift 2
    local batch=$((ITEMS_MAX / ITEMS_PAGE_SIZE * ITEMS_PAGE_SIZE))
    local pn=$((CURSOR_OFFSET / ITEMS_PAGE_SIZE + 1))
    local skip=$((CURSOR_OFFSET % ITEMS_PAGE_SIZE))
    local page on_page=0 accum=0 i=0 fetched=0 upstream=""

    ITEMS_PAGES=()
    while :; do
        i=$((i + 1))
        page="$SCRATCH_DIR/items-$i.json"
        items_http_get "$page" "$referer" "$endpoint" "$@" \
            --data-urlencode "$ITEMS_PAGE_PARAM=$pn" \
            --data-urlencode "$ITEMS_SIZE_PARAM=$ITEMS_PAGE_SIZE" ||
            items_fail "$(classify_view_error "$VIEW_CURL_RC" "$VIEW_HTTP" "$VIEW_CODE")"
        ITEMS_PAGES+=("$page")

        on_page=$(jq -r "($ITEMS_ROWS_PATH // []) | length" "$page" 2>/dev/null) || on_page=0
        [[ "$on_page" =~ ^[0-9]+$ ]] || on_page=0
        if ((i == 1)); then
            ITEMS_TOTAL=$(jq -r "$ITEMS_TOTAL_PATH // \"null\"" "$page" 2>/dev/null) || ITEMS_TOTAL="null"
            [[ "$ITEMS_TOTAL" =~ ^[0-9]+$ ]] || ITEMS_TOTAL="null"
        fi
        if [[ -n "$ITEMS_MORE_PATH" ]]; then
            upstream=$(jq -r "$ITEMS_MORE_PATH // empty" "$page" 2>/dev/null) || upstream=""
        fi

        accum=$((accum + on_page))
        fetched=$((accum - skip))
        ((on_page < ITEMS_PAGE_SIZE)) && break
        ((fetched >= batch)) && break
        [[ "$upstream" == "false" ]] && break
        [[ "$ITEMS_TOTAL" != "null" ]] && ((CURSOR_OFFSET + fetched >= ITEMS_TOTAL)) && break
        pn=$((pn + 1))
    done

    ITEMS_RAW=$(jq -c -s --argjson skip "$skip" --argjson max "$batch" \
        "[ .[] | ($ITEMS_ROWS_PATH // [])[] ] | .[\$skip:] | .[0:\$max]" \
        "${ITEMS_PAGES[@]}" 2>/dev/null) || items_fail "unknown"
    ITEMS_TAKEN=$(printf '%s' "$ITEMS_RAW" | jq 'length' 2>/dev/null) || ITEMS_TAKEN=0
    [[ "$ITEMS_TAKEN" =~ ^[0-9]+$ ]] || ITEMS_TAKEN=0

    # has_more ANSWERS ABOUT THE CONTAINER, not about how many rows survived the filter
    # (ARCH-engine.md「容器（--items）」). Three sources, in the order of how much they know:
    # rows already fetched but cut off by the ceiling settle it outright; then the site's own
    # flag where it publishes one; then the count it reported.
    if ((fetched > ITEMS_TAKEN)); then
        ITEMS_HAS_MORE=true
    elif [[ -n "$upstream" ]]; then
        ITEMS_HAS_MORE="$upstream"
    elif [[ "$ITEMS_TOTAL" != "null" ]] && ((CURSOR_OFFSET + ITEMS_TAKEN < ITEMS_TOTAL)); then
        ITEMS_HAS_MORE=true
    else
        ITEMS_HAS_MORE=false
    fi
    [[ "$ITEMS_HAS_MORE" == "true" ]] || ITEMS_HAS_MORE=false
}

# The audio menu. Its own record answers EXISTENCE, and it has to: an am id nobody created comes
# back 200 / code 0 / msg "success" / data null (measured 2026-09-10), so the body code is no
# answer and the id is judged by the SHAPE of what came back. Checked before the tracks, so a
# typo costs one request and is reported as a statement about the HANDLE.
items_am_rows() {
    local info="$SCRATCH_DIR/menu-info.json"
    items_http_get "$info" "$VIEW_REFERER" "$MENU_INFO_ENDPOINT" \
        --data-urlencode "sid=$CONTAINER_ID" ||
        items_fail "$(classify_view_error "$VIEW_CURL_RC" "$VIEW_HTTP" "$VIEW_CODE")"
    jq -e '(.data | type) == "object"' "$info" >/dev/null 2>&1 ||
        items_fail "unavailable"
    ITEMS_TITLE=$(jq -r '.data.title // empty' "$info" 2>/dev/null) || ITEMS_TITLE=""

    ITEMS_PAGE_SIZE=$ITEMS_PAGE
    ITEMS_PAGE_PARAM="pn"
    ITEMS_SIZE_PARAM="ps"
    ITEMS_ROWS_PATH=".data.data"
    ITEMS_TOTAL_PATH=".data.totalSize"
    ITEMS_MORE_PATH=""
    items_page_loop "$OF_MENU_ENDPOINT" "$VIEW_REFERER" --data-urlencode "sid=$CONTAINER_ID"
}

# The favourites list. Same two-request shape as the audio menu and for the same reason — the
# entry endpoint cannot tell "no such list" from "an empty one", and folder/info answers by
# shape (`data.title: null`, measured 2026-09-12).
#
# WHAT IT CANNOT TELL APART, and this is a limit rather than an omission: an EMPTY list and one
# this anonymous client may not see return the same body (`code: 0`, `medias: null`,
# `has_more: false`). So a private list is reported as an empty container. The alternative would
# be guessing from a login this engine's HTTP half deliberately does not hold.
items_fav_rows() {
    local info="$SCRATCH_DIR/fav-info.json"
    items_http_get "$info" "$VIEW_REFERER" "$FAV_INFO_ENDPOINT" \
        --data-urlencode "media_id=$CONTAINER_ID" ||
        items_fail "$(classify_view_error "$VIEW_CURL_RC" "$VIEW_HTTP" "$VIEW_CODE")"
    jq -e '(.data.title | type) == "string"' "$info" >/dev/null 2>&1 ||
        items_fail "unavailable"
    ITEMS_TITLE=$(jq -r '.data.title // empty' "$info" 2>/dev/null) || ITEMS_TITLE=""

    ITEMS_PAGE_SIZE=$FAV_PAGE
    ITEMS_PAGE_PARAM="pn"
    ITEMS_SIZE_PARAM="ps"
    ITEMS_ROWS_PATH=".data.medias"
    ITEMS_TOTAL_PATH=".data.info.media_count"
    ITEMS_MORE_PATH=".data.has_more"
    items_page_loop "$FAV_LIST_ENDPOINT" "$VIEW_REFERER" \
        --data-urlencode "media_id=$CONTAINER_ID" --data-urlencode "platform=web"
}

# The collection. ONE request per page and no existence check of its own, because this endpoint
# is the one that answers in the code: a season_id nobody created comes back `-404` (measured
# 2026-09-12), which classify_view_error already reads as unavailable.
items_season_rows() {
    ITEMS_PAGE_SIZE=$SEASON_PAGE
    ITEMS_PAGE_PARAM="page_num"
    ITEMS_SIZE_PARAM="page_size"
    ITEMS_ROWS_PATH=".data.archives"
    ITEMS_TOTAL_PATH=".data.page.total"
    ITEMS_MORE_PATH=""
    items_page_loop "$SEASON_ENDPOINT" "$SPACE_REFERER" \
        --data-urlencode "mid=${CONTAINER_MID:-0}" \
        --data-urlencode "season_id=$CONTAINER_ID" \
        --data-urlencode "sort_reverse=false"
    ITEMS_TITLE=$(jq -r '.data.meta.name // empty' "${ITEMS_PAGES[0]}" 2>/dev/null) || ITEMS_TITLE=""
}

# A row is an item only if it can be PLAYED and can say how long it is: an id that builds a url
# and a numeric duration. Same judgement a search row passes (ARCH-cli-contract.md「数据契约」),
# minus its live_status arm — nothing in the audio catalogue is live, so there is no second way
# to explain a missing duration here.
JQ_ITEM_FILTER='[ .[] | select((.id | type) == "number" and .id > 0
                               and (.duration | type) == "number") ]'

# The video side needs two more, and BOTH are measurements rather than defensive habits
# (2026-09-12, over two independent public lists):
#
#   type == 2      a favourites list is not all videos. `type: 24` rows are OGV episodes whose
#                  `link` is /bangumi/play/ep…, and they carry a bvid that does NOT name a
#                  /video/BV… page — a row built from one would point somewhere else.
#   attr bit 0     a dead upload stays in the list as `title: "已失效视频"` with attr 1 or 9 —
#                  and with a REAL duration (4410 / 104 / 17215 / 593073 seconds were measured).
#                  So the playable judgement below cannot catch it, the title is a site string
#                  this file will not depend on, and the bit is the invariant.
JQ_FAV_FILTER='[ .[]
  | select((.type // 0) == 2)
  | select(((.attr // 0) % 2) == 0)
  | select((.bvid | type) == "string" and (.bvid | length) > 0)
  | select((.duration | type) == "number" and .duration > 0) ]'

JQ_SEASON_FILTER='[ .[]
  | select((.bvid | type) == "string" and (.bvid | length) > 0)
  | select((.duration | type) == "number" and .duration > 0) ]'

# `count` is what came back and `total` is what the site SAYS it holds, and the gap between them
# is the whole reason a container needs its own envelope: it covers both truncation (the ceiling
# above) and rows dropped by the filter, and the envelope does not add a key to tell those apart.
#
# `has_more` is NOT that key. It answers a different question — whether the CONTAINER has rows
# past this batch — and `next_cursor` is how to ask for them. `n` numbers the rows of THIS
# batch: it is the envelope's own count, and the cursor is what joins two envelopes.
JQ_ITEMS_HEAD='
{status: "ok", engine: $engine, id: $id, url: $url,
 title: (if $title == "" then null else $title end),
 count: ($rows | length),
 total: $total,
 has_more: $has_more,
 next_cursor: $next_cursor,'

JQ_AUDIO_ITEMS="$JQ_ITEMS_HEAD"'
 items: [ $rows | to_entries[]
          | .key as $i | .value as $r
          | ($r.id | tostring) as $sid
          | {n: ($i + 1), engine: $engine, id: $sid,
             url: ("https://www.bilibili.com/audio/au" + $sid),
             title: ($r.title // null),
             duration: ($r.duration // null),
             duration_fmt: (($r.duration | fmt_dur) // null)} ]}
'

# The video side's records name a video the way resolving one does: the BV id, and the /video/
# URL built from it — the same pair `bili-resolve -j -- .../video/BV…` reports, so a record
# stored out of this envelope and a record resolved directly are the same row.
JQ_VIDEO_ITEMS="$JQ_ITEMS_HEAD"'
 items: [ $rows | to_entries[]
          | .key as $i | .value as $r
          | {n: ($i + 1), engine: $engine, id: $r.bvid,
             url: ("https://www.bilibili.com/video/" + $r.bvid),
             title: ($r.title // null),
             duration: ($r.duration // null),
             duration_fmt: (($r.duration | fmt_dur) // null)} ]}
'

resolve_items() {
    ensure_scratch

    local filter="$JQ_ITEM_FILTER" project="$JQ_AUDIO_ITEMS"
    case "$CONTAINER_KIND" in
    fav)
        items_fav_rows
        filter="$JQ_FAV_FILTER"
        project="$JQ_VIDEO_ITEMS"
        ;;
    season)
        items_season_rows
        filter="$JQ_SEASON_FILTER"
        project="$JQ_VIDEO_ITEMS"
        ;;
    *)
        items_am_rows
        ;;
    esac

    if [[ "$OUTPUT_MODE" == "json_full" ]]; then
        # The body that CARRIES the items, at full fidelity — the same rule --parts -J follows,
        # and the reason the container's own record does not appear here: it serves only the
        # top-level title. When more than one page was spent, every page's rows replace page
        # one's, because a -J that answered about less than -j would be the one output mode that
        # loses information by widening. It is THIS batch's body: the cursor keys live in the
        # envelope, so paging is something -j can do and -J cannot.
        jq -c --argjson rows "$ITEMS_RAW" "$ITEMS_ROWS_PATH = \$rows" "${ITEMS_PAGES[0]}" ||
            items_fail "unknown"
        return 0
    fi

    local next_cursor="null"
    [[ "$ITEMS_HAS_MORE" == "true" ]] && next_cursor="\"o:$((CURSOR_OFFSET + ITEMS_TAKEN))\""

    local rows env_json
    rows=$(printf '%s' "$ITEMS_RAW" | jq -c "$filter" 2>/dev/null) ||
        items_fail "unknown"
    env_json=$(jq -nc --argjson rows "$rows" \
        --arg engine "$ENGINE_NAME" --arg id "$CONTAINER_ID" --arg url "$CONTAINER_URL" \
        --arg title "$ITEMS_TITLE" --argjson total "$ITEMS_TOTAL" \
        --argjson has_more "$ITEMS_HAS_MORE" --argjson next_cursor "$next_cursor" \
        "$JQ_PRELUDE $project" 2>/dev/null) ||
        items_fail "unknown"

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        printf '%s\n' "$env_json"
        return 0
    fi

    # Prose, in the vocabulary --parts and t-playlist --show already speak: the title, a dashed
    # summary line, then one line per track. An EMPTY container prints its title and a count of
    # 0 — that is an answer, the same way a single-part video is an answer to --parts.
    local title count total_txt
    title=$(printf '%s' "$env_json" | jq -r '.title // "(untitled)"')
    count=$(printf '%s' "$env_json" | jq -r '.count')
    total_txt=$(printf '%s' "$env_json" | jq -r '.total // "?"')

    if [[ -n "$MUSIC_CHAR" ]]; then
        printf '%s %s\n' "$MUSIC_CHAR" "$title"
    else
        printf '%s\n' "$title"
    fi
    printf '  - items: %s   total: %s\n' "$count" "$total_txt"
    printf '%s' "$env_json" | jq -r '.items[] | "  \(.n). \(.title // "")  \(.duration_fmt // "")"'
    if [[ "$ITEMS_HAS_MORE" == "true" ]]; then
        printf '  … more — continue with --cursor o:%s\n' "$((CURSOR_OFFSET + ITEMS_TAKEN))"
    fi
    return 0
}

# ==============================================================================
# 7. THE AUTH VERB (read-only: no network, no yt-dlp, no state file)
# ==============================================================================

# Report the cookie DECISION this engine made at startup: which browser profile playback
# will read, and whether that profile exists on this machine. It answers BEFORE the yt-dlp
# dependency gate and makes no request, because it is a question about this process's own
# configuration, not about the site.
#
# What it deliberately does NOT claim is that the session behind those cookies buys
# anything. `auth: "cookie"` means the cookies are SENT. Whether the site accepts them, and
# what the account behind them is entitled to, are two further questions this verb answers
# neither of.
#
# Measured 2026-08-26, and the numbers are the argument: 3159 cookies extracted from chrome,
# the profile browser-confirmed LOGGED IN, and this site still served exactly the anonymous
# audio ladder (30216/30232/30280, 181 kbps AAC top; no Hi-Res 30251, no Dolby 30250) — the
# account is not a premium member, and 1080P 高码率 was unreachable with the cookies too.
# The video format list came back byte-identical with and without them. So an accepted login
# can still be indistinguishable from no login at all, which is why quality is never the
# evidence for this field, and why this field is never the evidence for quality.
resolve_auth() {
    local auth="anonymous" found=false readable=null
    if ((${#COOKIE_ARGS[@]} > 0)); then
        auth="cookie"
        found=true
        # `auth` says the engine will TRY the store; this says whether the try can succeed.
        # A profile folder that exists is not a store this process may read (cookie_probe),
        # and a status line that said "signed in" over a blocked read was the whole bug.
        # null = no probe for this browser, so no claim either way.
        cookie_probe "$BILI_COOKIE_BROWSER"
        case "$COOKIE_STATE" in
        readable) readable=true ;;
        unknown) readable=null ;;
        *) readable=false ;;
        esac
    fi
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg engine "$ENGINE_NAME" --arg auth "$auth" \
            --arg browser "$BILI_COOKIE_BROWSER" --argjson found "$found" --argjson readable "$readable" \
            '{status: "ok", engine: $engine, auth: $auth,
              cookie_browser: $browser, profile_found: $found, cookie_readable: $readable}'
        return 0
    fi
    if [[ "$auth" == "cookie" && "$readable" == "false" ]]; then
        printf 'cookie (%s, unreadable: %s)\n' "$BILI_COOKIE_BROWSER" "$COOKIE_STATE"
    elif [[ "$auth" == "cookie" ]]; then
        printf 'cookie (%s)\n' "$BILI_COOKIE_BROWSER"
    else
        printf 'anonymous\n'
    fi
}

