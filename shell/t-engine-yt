#!/usr/bin/env bash
# t-engine-yt — the YouTube ENGINE: everything this suite knows about one site, in one file.
#
# An engine is one file per SITE, not one per operation. The cookie store, the host list, the
# id shape, the error wording yt-dlp uses — each is a fact about YouTube, and when searching
# and resolving lived in two files every one of them was written twice (392 duplicated lines
# in this pair alone). The verbs below share them; they share nothing with any other engine.
#
# This file is BELOW the public contract. `t-play` is the one entry point: it forwards its
# engine verbs (--search --info --items --transcript --auth) here verbatim and calls --stream
# itself to turn a handle into bytes. So the argv here is an internal protocol between two
# files of this suite, and the flag gate lives in exactly one place — this one: a modifier
# the site has no use for is refused here, not in the player. --capabilities publishes that
# gate so `t-play --engines` can answer for it. docs/ARCHITECTURE.md「命令拓扑」.
#
# It has NO playback, lifecycle, or mpv logic and never starts a process that outlives it.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features; guard empty-array
# expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). ARCHITECTURE.md「可移植性契约」.

# Resolve this script's OWN symlink chain before looking for its siblings. The PATH entry
# is a symlink into a checkout that can live anywhere, so `dirname $0` is the symlink's
# directory, not the code's. This walks the chain to the real file and takes ITS directory.
#
# `cd -P` / `pwd -P`, not the logical forms: a relative symlink resolves to something like
# ~/bin/../../../elsewhere/shell, and logical `cd` would normalise those `..` textually
# against ~/bin instead of against what ~/bin actually points at. Physical resolution is the
# only one that lands in the right place. bash 3.2 has no `readlink -f`, hence the loop.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)

# THE version of the whole suite, declared once — in a data file, not in code. The engines
# and the player are independent executables that share no library, so a shell variable in
# any one of them would make the others ask IT for the version, which is the wrong
# dependency direction for a player that must not know its engines. CLAUDE.md § one fact, one place.
if [[ -r "$SCRIPT_DIR/../VERSION" ]]; then
    UT_VERSION=$(cat "$SCRIPT_DIR/../VERSION")
else
    UT_VERSION="unknown"
fi

# CONFIGURATION — the chain is flag > environment > the user's config > the shipped defaults
# in `<checkout>/config`, which is where every default value in the suite is declared once.
# Duplicated VERBATIM in every entry point — see the same block in t-play for why, and
# ARCH-cli-contract.md「配置面」 for the keys.
TING_CONFIG="${TING_CONFIG:-${UT_CONFIG:-}}"
if [[ -z "$TING_CONFIG" ]]; then
    if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/ting/config" ]]; then
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ting/config"
    else
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/uting/config"
    fi
fi
UT_CONFIG="$TING_CONFIG"
for _v in STATE_DIR ENGINE_DIR HISTORY THEME ACCENT VOLUME LANG IMAGE KEYS RESOURCE RESOURCE_TICKS BRAND ASCII SYNC PLAY_QUALITY VIZ_STYLE VIZ_COLOR DEAD_KEEP DEFAULT_ENGINE MODE_CYCLE SORT_CYCLE THEME_CYCLE QUALITY_CYCLE LOOP_CYCLE; do
    eval "[[ -n \"\${TING_$_v+x}\" ]] && UT_$_v=\"\$TING_$_v\" || true"
    eval "[[ -n \"\${UT_$_v+x}\" && -z \"\${TING_$_v+x}\" ]] && TING_$_v=\"\$UT_$_v\" || true"
done
UT_DEFAULTS="$SCRIPT_DIR/../config"
ut_read_config() {
    local file="$1" line key val _ting_k _ut_k
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        while [[ "$line" == [[:space:]]* ]]; do line="${line#[[:space:]]}"; done
        while [[ "$line" == *[[:space:]] ]]; do line="${line%[[:space:]]}"; done
        [[ -n "$line" && "$line" == *=* ]] || continue
        key="${line%%=*}"
        val="${line#*=}"
        while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
        while [[ "$val" == [[:space:]]* ]]; do val="${val#[[:space:]]}"; done
        [[ "$key" =~ ^(TING|UT|YT|BILI|NE)_[A-Z0-9_]+$ ]] || continue
        case "$key" in
        TING_CONFIG | TING_DEFAULTS | TING_ENGINE_DIR | TING_VERSION | UT_CONFIG | UT_DEFAULTS | UT_ENGINE_DIR | UT_VERSION | YT_IPC_SOCK | YT_DETACHED | YT_PLAYER_ID | YT_DETACHED_LOG) continue ;;
        esac
        if [[ ${#val} -ge 2 ]] && { [[ "$val" == \"*\" ]] || [[ "$val" == \'*\' ]]; }; then
            val="${val#?}"
            val="${val%?}"
        fi
        [[ "$val" == "~/"* ]] && val="$HOME/${val#\~/}"
        if [[ "$key" == TING_* ]]; then
            _ut_k="UT_${key#TING_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ut_k+x}\" ]] || $_ut_k=\$val"
        elif [[ "$key" == UT_* ]]; then
            _ting_k="TING_${key#UT_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ting_k+x}\" ]] || $_ting_k=\$val"
        else
            eval "[[ -n \"\${$key+x}\" ]]" && continue
            eval "$key=\$val"
        fi
    done < "$file"
}
# FAIL FAST AND SAY WHY. There is deliberately no escape hatch for --version or --help: they
# were tried, and letting execution continue past a missing defaults file replaced this one
# clear line with `YT_ASCII_VO: unbound variable` from set -u somewhere further down. A
# checkout missing part of itself is not a dependency gate — it is a broken checkout, and 2 is
# the exit code for a failure that is not the caller's usage error.
if [[ ! -r "$UT_DEFAULTS" ]]; then
    printf '%s: cannot read the shipped defaults at %s — that file declares every default value in the suite and is not optional\n' \
        "$(basename "$0")" "$UT_DEFAULTS" >&2
    exit 2
fi
ut_read_config "$UT_CONFIG"
ut_read_config "$UT_DEFAULTS"

# The engine's own name, as it appears in every envelope AND as the suffix of this file's
# name. Name == suffix is deliberate: it lets `t-play --engine yt` find `t-engine-yt` by string
# concatenation, with no name->command registry to keep in sync. docs/ARCHITECTURE.md「命令拓扑」.
ENGINE_NAME="yt"
PROG="t-engine-yt"

# ==============================================================================
# 1. SETTINGS
# ==============================================================================

# Cookies (login) are ON by default (browser: chrome) so login-gated / members / age-
# restricted videos — invisible to an anonymous client — are searchable and resolve. Verify
# the browser profile exists on this platform; if not, run anonymously rather than break, so
# a machine without the configured browser degrades gracefully to no-login.
# Set YT_COOKIE_BROWSER=none to force anonymous-only (skips the keychain read and the probe).
COOKIE_ARGS=()
if [[ -n "${YT_COOKIE_BROWSER:-}" && "$YT_COOKIE_BROWSER" != "none" ]]; then
    browser_exists=0
    case "$YT_COOKIE_BROWSER" in
    chrome|chromium|brave)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            if [[ -d "$HOME/Library/Application Support/Google/Chrome" || -d "$HOME/Library/Application Support/BraveSoftware" || -d "$HOME/Library/Application Support/Chromium" ]]; then
                browser_exists=1
            fi
        else
            if [[ -d "$HOME/.config/google-chrome" || -d "$HOME/.config/chromium" || -d "$HOME/.config/BraveSoftware" ]]; then
                browser_exists=1
            fi
        fi
        ;;
    safari)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Safari" ]] && browser_exists=1
        fi
        ;;
    firefox)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Firefox" ]] && browser_exists=1
        else
            [[ -d "$HOME/.mozilla/firefox" ]] && browser_exists=1
        fi
        ;;
    edge)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Microsoft Edge" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/microsoft-edge" ]] && browser_exists=1
        fi
        ;;
    opera)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/com.operasoftware.Opera" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/opera" ]] && browser_exists=1
        fi
        ;;
    vivaldi)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Vivaldi" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/vivaldi" ]] && browser_exists=1
        fi
        ;;
    *)
        browser_exists=0
        ;;
    esac

    if ((browser_exists)); then
        COOKIE_ARGS=(--cookies-from-browser "$YT_COOKIE_BROWSER")
    fi
fi

# The anonymous client. player_client=android is the one that fetches when the
# authenticated client set hands back a googlevideo URL missing its GVS proof-of-origin
# token — see probe_raw.
ANON_ARGS=(--extractor-args "youtube:player_client=android")

ACTION=""            # search | stream | info | transcript | items | auth | capabilities
VERB_FLAG=""         # the verb flag as typed — the one-verb-per-invocation gate reads it
COLOR_MODE="auto"
OUTPUT_MODE="list"   # list (prose) | json | raw (--raw: the site's own record, engine-only)
SEGMENTS=0           # --segments: the transcript envelope keeps its timed cues

# --search. The `-n` and --sort defaults are cross-engine: a caller who wants a different
# result count by default wants it from whichever source they asked. ARCH-cli-contract.md「配置面」.
NUM_RESULTS=$UT_SEARCH_RESULTS
MIN_DURATION=0
MAX_DURATION=0
SORT_FIELD="$UT_SORT_FIELD"
QUERY=""
FILTERED_JSON=""

# --stream. The `-f` default is cross-engine too: a user who listens rather than watches
# says so once.
PLAYBACK_MODE="$UT_PLAY_MODE"
QUALITY="auto"       # auto | low | medium | high — the tier abstraction (--quality)
FMT=""               # the yt-dlp format string the mode resolves to

TARGET=""            # the handle as the caller typed it
TARGET_URL=""        # the watch URL it normalises to
CONTAINER_ID=""      # the list id --items resolves to (PL… / OLAK5uy_… / UU…), or a channel handle
CONTAINER_URL=""     # the canonical playlist or channel-videos URL that id normalises to
CURSOR=""            # the --cursor token as the caller typed it, "" when absent
CURSOR_OFFSET=0      # the item offset it decodes to; 0 is the first batch

# One yt-dlp call, capped. --playlist-items takes this number as the END of the slice. A
# caller learns it was truncated from the envelope, where `count` below `total` says so
# (measured: a 4749-video list answers 500 with total 4749) — and asks for the REST with the
# cursor the envelope hands back. ARCH-engine.md「容器（--items）」.
ITEMS_MAX=500

SUB_LANG=""
# Default caption-language priority chain for --transcript. A CHAIN, not a single default,
# because the useful answer is "whatever this video actually has, in my order of
# preference" — and yt-dlp can be asked for all of them in the one round trip it was
# already making. English first, then Simplified/generic Chinese, then Japanese.
#
# ENGINE-SPECIFIC, and it has to be: Bilibili carries no caption track at all. A cross-engine
# spelling would be a knob half the suite must ignore. ARCH-cli-contract.md「配置面」.
SUB_LANG_CHAIN="$YT_SUB_LANG_CHAIN"

# Glyph fallback shares ONE switch with ting (YT_ASCII, legacy alias YT_TUI_ASCII): a
# terminal whose font can't draw ♫ can't draw it in either surface, and a non-UTF-8 locale
# (bare cron/launchd) would emit mojibake. Empty = drop the glyph, as ting does.
MUSIC_CHAR="♫"
case "${YT_ASCII:-${YT_TUI_ASCII:-}}" in
1 | true | yes | on) MUSIC_CHAR="" ;;
"")
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8* | *utf-8* | *UTF8* | *utf8*) ;;
    *) MUSIC_CHAR="" ;;
    esac
    ;;
esac

# ==============================================================================
# 2. HELPERS
# ==============================================================================

err() {
    local red='' reset=''
    case "${COLOR_MODE:-auto}" in
    always)
        red=$'\033[31m'
        reset=$'\033[0m'
        ;;
    auto)
        if [[ -t 2 ]]; then
            red=$'\033[31m'
            reset=$'\033[0m'
        fi
        ;;
    never) ;;
    esac
    echo "${red}Error:${reset} $*" >&2
}

die() {
    err "$@"
    exit 1
}

# A missing tool is not a malformed call: `die` is exit 1 (the argv is wrong — fix it),
# `die_dep` is exit 2 (the argv was fine; the machine is missing something no rewrite of the
# argv will supply). An agent that read 1 here would loop editing its own parameters against
# a wall. docs/ARCH-cli-contract.md「退出码、TTY、依赖」.
die_dep() {
    err "required command not found: $1"
    exit 2
}

is_non_negative_int() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

validate_enum() {
    local value=$1
    shift
    local allowed
    for allowed in "$@"; do
        if [[ "$value" == "$allowed" ]]; then
            return 0
        fi
    done
    return 1
}

# ONE VERB PER INVOCATION. A caller who names two verbs has not said what it wants, and the
# gate model answers that by refusing rather than by guessing (ARCH-cli-contract.md「门模型」).
set_action() {
    local action=$1 flag=$2
    if [[ -n "$VERB_FLAG" && "$VERB_FLAG" != "$flag" ]]; then
        die "$VERB_FLAG and $flag are two verbs — pass one"
    fi
    VERB_FLAG="$flag"
    ACTION="$action"
}

require_cmd() {
    local cmd=$1
    command -v "$cmd" >/dev/null 2>&1 || die_dep "$cmd"
}

require_deps() {
    local cmd
    for cmd in "$@"; do
        require_cmd "$cmd"
    done
}

# The ONE implementation of duration formatting: seconds -> "[Nd ]HHh:MMm:SSs". It is a
# jq prelude, not a bash function, because every consumer is already shaping JSON with jq —
# a bash version meant forking jq once per row just to read a field back out (25 results =
# 50+ forks, measured 40x slower than one jq program). An unknown duration yields NULL rather
# than a fake "00h:00m:00s", so each caller decides how to render it (a live stream has no
# duration). ARCH-engine.md「搜索子系统」.
#
# start_secs exists because THIS ENGINE DOES NO TIMESTAMP PARSING AT ALL: yt-dlp's own
# extractor already reads every writing YouTube has — t=601, t=601s, t=10m1s, t=1h2m3s,
# youtu.be/ID?t=, embed/ID?start=, and the #t= anchor — and hands the answer over as
# .start_time. So the whole job is normalising what it gives us into the envelope's declared
# shape (null | non-negative integer seconds):
#   absent (no timestamp in the handle)  -> null      · null (t=banana)      -> null
#   0 (t=0)                              -> 0         · 601.5 (t=601.5)      -> 601
# The floor is not tidiness: yt-dlp really does hand back a float for a fractional t, and
# "start_seconds" is how many seconds have already gone by — rounding UP would put the
# playhead past the moment the caller pointed at. A negative is refused rather than
# clamped: nothing on this site produces one, so it means we misread, and a null says so.
JQ_PRELUDE='
def p2: tostring | if length < 2 then "0" + . else . end;
def start_secs:
  if type == "number" and . >= 0 then floor else null end;
def fmt_dur:
  if type != "number" then null
  else (. | floor) as $t
    | ($t / 86400 | floor) as $d
    | (($t % 86400) / 3600 | floor) as $h
    | (($t % 3600) / 60 | floor) as $m
    | ($t % 60) as $s
    | (if $d > 0 then "\($d)d " else "" end) + "\($h | p2)h:\($m | p2)m:\($s | p2)s"
  end;
def oneline: if type != "string" then "" else gsub("\\s+"; " ") | sub("^ "; "") | sub(" $"; "") end;
# THE COVER, normalised to one directly-GETtable https URL — the site field name stops here.
# A caller (ting, or an agent) must never learn what `thumbnails[]` is: that is site
# knowledge, and site knowledge lives in an engine (CLAUDE.md).
#
# SMALLEST AT OR ABOVE 200px WIDE, not the biggest and not the first. A flat search entry
# really does carry two sizes (measured 2026-09-03: 360x202 and 720x404 on `lofi hip hop`,
# every row), which is what makes `.[0]` and `.[-1]` both wrong in a way only a real
# envelope shows. Below 200 there is nothing to be picky about: take the largest.
#
# WHY A FIXED THRESHOLD RATHER THAN THE RIGHT ONE: the right one depends on how many pixels
# a terminal cell is, and an engine cannot know that — a cell size is a rendering fact and
# belongs to whoever draws. So the threshold is a policy, and 200 is where it pays: the same
# cover at 720px is 170KB of escape payload against 39KB at 360px, measured, for a picture
# the terminal is going to downsample anyway.
#
# A full (--info) record carries dozens of sizes, several of them webp; the same rule holds,
# and `.thumbnail` — yt-dlp own single pick, the largest — is the fallback when the array
# is absent.
def pick_thumb:
  ((.thumbnails // []) | map(select((.url // "") != ""))) as $t
  | if ($t | length) == 0 then (.thumbnail // null)
    else ( ([$t[] | select((.width // 0) >= 200)] | sort_by(.width) | first)
           // ($t | sort_by(.width // 0) | last) ).url
    end;
'

# Map captured yt-dlp output + exit code to the suite's stable reason taxonomy so an agent
# caller can branch on `reason` instead of string-matching raw extractor wording (which is
# not a contract and drifts across versions). The ENUM is the shared fact and lives in
# ARCH-cli-contract.md「数据契约」 — this is the yt-dlp-side reader of it; the player carries its
# own mpv-side reader. No member may be added here that the enum does not already have.
# `unknown` is the conservative default — never guess a cause we did not positively identify.
classify_yt_dlp_error() {
    local text=$1 rc=$2
    if ((rc == 130)); then
        echo "stopped_by_user"
        return
    fi
    # The browser's cookie store could not be read — before any request was made. First,
    # because it says nothing about the site: a store the calling terminal app is not allowed
    # to read (macOS privacy protection) is reported by yt-dlp's directory walk as "could not
    # find", and that looked like a search that fails for no reason.
    if grep -qiE 'could not (find|copy) [a-z]+ cookies? database|failed to decrypt|cannot decrypt|find-generic-password|keyring|keychain|\[Errno [0-9]+\][^:]*: .*(Cookies|cookies\.sqlite|binarycookies)' <<<"$text"; then
        echo "cookies"
        return
    fi
    if grep -qiE 'HTTP Error 403|[^a-z]403[^0-9]|Forbidden' <<<"$text"; then
        echo "forbidden"
        return
    fi
    if grep -qiE 'Video unavailable|Private video|has been removed|no longer available|does not exist|account.*terminated|members-only|Sign in to confirm' <<<"$text"; then
        echo "unavailable"
        return
    fi
    if grep -qiE 'Requested format is not available|No video formats|requested format|only images are available' <<<"$text"; then
        echo "format_unavailable"
        return
    fi
    # 429 lands in `network`, not `unknown`: it is a transport-level, RETRYABLE refusal, and
    # `network` is the enum member that already means "try again later". It is grouped here
    # rather than with `forbidden` (403) deliberately — 403 means these credentials never
    # work, 429 means not right now.
    if grep -qiE 'Temporary failure in name resolution|Failed to resolve|Name or service not known|Network is unreachable|Connection (refused|timed out|reset)|Could not connect|getaddrinfo|Timed out|Operation timed out|HTTP Error 429|Too Many Requests|Unable to download (webpage|API page|JSON metadata)' <<<"$text"; then
        echo "network"
        return
    fi
    echo "unknown"
}

# ── the cookie store, diagnosed ─────────────────────────────────────────────────────────
# yt-dlp words several different causes as ONE sentence. A folder the calling terminal app
# is not allowed into (macOS privacy protection) is walked as empty and reported "could not
# find … cookies database" — the same words as a browser that was never used, and the same
# command then works from another terminal. cookie_probe tells them apart by doing what
# yt-dlp does: list the browser's folder, find its newest cookie file, read one byte of it.
# `[ -r ]` would not do: it consults Unix permissions, and privacy protection sits above
# them. Local — no network, no Keychain. The paths are site knowledge, so each engine carries
# its own copy (ARCH-engine.md, the anonymous-fallback section).
COOKIE_STATE=""; COOKIE_PATH=""; COOKIE_ERR=""
cookie_denied() {
    COOKIE_ERR=$1
    if [[ "$1" == *"Operation not permitted"* && "$(uname -s)" == "Darwin" ]]; then
        COOKIE_STATE="blocked"
    else
        COOKIE_STATE="denied"
    fi
    return 0
}
cookie_probe() {
    COOKIE_STATE="unknown"; COOKIE_PATH=""; COOKIE_ERR=""
    local b=$1 root="" name="Cookies" as="$HOME/Library/Application Support" mac=0 f newest="" err
    if [[ "$(uname -s)" == "Darwin" ]]; then mac=1; fi
    case "$b" in
    chrome)   if ((mac)); then root="$as/Google/Chrome"; else root="$HOME/.config/google-chrome"; fi ;;
    chromium) if ((mac)); then root="$as/Chromium"; else root="$HOME/.config/chromium"; fi ;;
    brave)    if ((mac)); then root="$as/BraveSoftware/Brave-Browser"; else root="$HOME/.config/BraveSoftware/Brave-Browser"; fi ;;
    edge)     if ((mac)); then root="$as/Microsoft Edge"; else root="$HOME/.config/microsoft-edge"; fi ;;
    opera)    if ((mac)); then root="$as/com.operasoftware.Opera"; else root="$HOME/.config/opera"; fi ;;
    vivaldi)  if ((mac)); then root="$as/Vivaldi"; else root="$HOME/.config/vivaldi"; fi ;;
    firefox)  name="cookies.sqlite"
              if ((mac)); then root="$as/Firefox"; else root="$HOME/.mozilla/firefox"; fi ;;
    safari)   ((mac)) || return 0
              name="Cookies.binarycookies"
              root="$HOME/Library/Containers/com.apple.Safari/Data/Library/Cookies"
              if [[ ! -d "$root" ]]; then root="$HOME/Library/Cookies"; fi ;;
    *) return 0 ;;
    esac
    COOKIE_PATH=$root
    if [[ ! -e "$root" ]]; then COOKIE_STATE="missing"; return 0; fi
    if ! err=$(ls "$root" 2>&1 >/dev/null); then cookie_denied "$err"; return 0; fi
    # Newest wins because that is the profile yt-dlp itself picks when none is named.
    while IFS= read -r f; do
        if [[ -z "$newest" || "$f" -nt "$newest" ]]; then newest=$f; fi
    done < <(find "$root" -maxdepth 3 -type f -name "$name" 2>/dev/null)
    if [[ -z "$newest" ]]; then COOKIE_STATE="missing"; return 0; fi
    COOKIE_PATH=$newest
    if ! err=$(head -c1 "$newest" 2>&1 >/dev/null); then cookie_denied "$err"; return 0; fi
    COOKIE_STATE="readable"
    return 0
}
# The app to name in the fix. TERM_PROGRAM is what the terminal says it is; tmux and screen
# replace it with themselves, and then the honest answer is that we cannot tell.
terminal_app() {
    case "${TERM_PROGRAM:-}" in
    Apple_Terminal) echo "Terminal" ;;
    iTerm.app) echo "iTerm" ;;
    ghostty) echo "Ghostty" ;;
    vscode) echo "VS Code" ;;
    WezTerm) echo "WezTerm" ;;
    WarpTerminal) echo "Warp" ;;
    "" | tmux | screen)
        if [[ "${TERM:-}" == "xterm-kitty" ]]; then echo "kitty"; else echo "your terminal app"; fi ;;
    *) echo "$TERM_PROGRAM" ;;
    esac
}
# ONE line on stderr that says what was lost, why, and the fix. stderr and not the envelope:
# it is prose for a person, and the -j envelope keeps its shape (ARCH-cli-contract.md).
cookie_diagnosis() {
    local b=${YT_COOKIE_BROWSER:-} first="" app prog="$PROG" knob="YT_COOKIE_BROWSER"
    cookie_probe "$b"
    first=$(printf '%s\n' "$1" | grep -m1 'ERROR' | sed 's/^ERROR: //') || first=""
    case "$COOKIE_STATE" in
    blocked)
        app=$(terminal_app)
        printf '%s: no %s cookies: macOS blocks %s from reading them - grant it Full Disk Access (System Settings > Privacy & Security), restart it; or set %s=none\n' \
            "$prog" "$b" "$app" "$knob" ;;
    denied)
        printf '%s: no %s cookies: %s reading %s; or set %s=none\n' \
            "$prog" "$b" "${COOKIE_ERR##*: }" "$COOKIE_PATH" "$knob" ;;
    missing)
        printf '%s: no %s cookies: %s has no cookie database - sign in to it once; or set %s=none (looked under %s)\n' \
            "$prog" "$b" "$b" "$knob" "$COOKIE_PATH" ;;
    readable)
        case "$b" in
        firefox | safari)
            printf '%s: no %s cookies: %s; or set %s=none\n' \
                "$prog" "$b" "${first:-yt-dlp could not load them}" "$knob" ;;
        *)
            printf '%s: no %s cookies: they could not be decrypted - allow Keychain access to "%s Safe Storage" when macOS asks; or set %s=none\n' \
                "$prog" "$b" "$b" "$knob" ;;
        esac ;;
    *)
        printf '%s: no %s cookies: %s; or set %s=none\n' \
            "$prog" "$b" "${first:-yt-dlp could not load them}" "$knob" ;;
    esac
    return 0
}
# Run one yt-dlp command ("$@", cookie args NOT included) with the configured cookie store,
# and once more WITHOUT it when the store itself is what failed — only then, so a network
# error is not paid for twice. stdout is the command's; yt-dlp's stderr lands in ERR_FILE for
# the caller's classifier; the diagnosis goes to this process's stderr.
ytdlp_cookied() {
    local out="" rc=0
    if ((${#COOKIE_ARGS[@]} > 0)); then
        out=$("$@" "${COOKIE_ARGS[@]}" 2>"$ERR_FILE") || rc=$?
        if ((rc != 0)) || [[ -z "$out" ]]; then
            if [[ "$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")" == "cookies" ]]; then
                cookie_diagnosis "$(cat "$ERR_FILE" 2>/dev/null)" >&2
                rc=0
                out=$("$@" 2>"$ERR_FILE") || rc=$?
            fi
        fi
    else
        out=$("$@" 2>"$ERR_FILE") || rc=$?
    fi
    printf '%s' "$out"
    return "$rc"
}

# This process's own scratch dir: 0700, created lazily, removed however we exit. Lazily
# because -h / -V must answer without touching the filesystem, and process-level rather
# than a function `local` because the EXIT trap runs after the function has returned — a
# `local` would be out of scope there and abort under `set -u`.
#
# 0700 rather than a bare /tmp path because captions are CONTENT and the captured yt-dlp
# stderr can name a cookie database. The engine does not reach into the player's state dir:
# `players/` has exactly one owner (t-play).
SCRATCH_DIR=""
ERR_FILE=""
cleanup_scratch() {
    [[ -n "$SCRATCH_DIR" ]] && rm -rf "$SCRATCH_DIR" 2>/dev/null
    return 0
}
trap cleanup_scratch EXIT

ensure_scratch() {
    [[ -n "$SCRATCH_DIR" ]] && return 0
    SCRATCH_DIR=$(mktemp -d "${TMPDIR:-/tmp}/t-engine-yt.XXXXXX") || die "cannot create a scratch directory"
    chmod 700 "$SCRATCH_DIR" 2>/dev/null || true
    ERR_FILE="$SCRATCH_DIR/yt-dlp.err"
    : >"$ERR_FILE"
}

is_json_out() {
    [[ "$OUTPUT_MODE" == "json" || "$OUTPUT_MODE" == "raw" ]]
}

# ==============================================================================
# 3. HANDLES — what a YouTube URL or id looks like
# ==============================================================================

# The hostname a URL names — lowercased, with userinfo, port, path, query and fragment
# removed. Lowercasing goes through `tr` because the parameter-expansion form for it is a
# bash-4 feature and the floor here is 3.2; it is one fork per invocation, not one per row.
url_host() {
    local h=$1
    h="${h#*://}"
    h="${h%%/*}"
    h="${h%%\?*}"
    h="${h%%#*}"
    h="${h##*@}"
    h="${h%%:*}"
    printf '%s' "$h" | tr 'A-Z' 'a-z'
}

# Is this host THIS engine's? One engine, one site: an engine that resolves someone else's
# URL is not being helpful, it is lying in the `engine` field — and that field's whole job
# is letting a caller route a result back to the resolver that produced it. yt-dlp supports
# 1700+ sites, so without this gate a Bilibili URL resolved fine and came back labelled
# `engine:"yt"`. It worked, which is exactly why it went unnoticed.
#
# An explicit list, not a substring test: `*.youtube.com` matches `music.youtube.com` and
# refuses `evilyoutube.com`, which a bare `*youtube.com*` would wave through.
is_own_host() {
    case "$1" in
    youtube.com | youtu.be | youtube-nocookie.com) return 0 ;;
    *.youtube.com | *.youtu.be | *.youtube-nocookie.com) return 0 ;;
    esac
    return 1
}

# Does a search token look like a URL? A URL is a thing to play or inspect, never a query.
looks_like_url() {
    case "$1" in
    http://* | https://* | www.* | youtube.com/* | youtu.be/*) return 0 ;;
    esac
    return 1
}

# Extract the 11-character video ID from any YouTube URL shape:
#   youtu.be/<id> · …/watch?v=<id> · …/embed/<id> · …/v/<id> · …/shorts/<id> · …/live/<id>
url_video_id() {
    local u=$1 q="" vid="" path=""
    u="${u#*://}"
    u="${u%%#*}"
    local rem="${u#*/}"
    case "$u" in
    */*) path="${rem%%\?*}" ;;
    *) path="" ;;
    esac
    case "$u" in
    *\?*) q="${u#*\?}" ;;
    esac

    case "&$q" in
    *[\&]v=*)
        vid="${q##*v=}"
        vid="${vid%%&*}"
        ;;
    esac

    if [[ -z "$vid" ]]; then
        case "$path" in
        embed/* | v/* | shorts/* | live/*)
            vid="${path#*/}"
            vid="${vid%%/*}"
            ;;
        *)
            local host="${u%%/*}"
            case "$host" in
            youtu.be | *.youtu.be)
                vid="${path%%/*}"
                ;;
            esac
            ;;
        esac
    fi

    if [[ "$vid" =~ ^[A-Za-z0-9_-]{11}$ ]]; then
        printf '%s' "$vid"
    fi
}

url_time_param() {
    local u=$1 q="" t=""
    case "$u" in
    *\?*) q="${u#*\?}" ;;
    esac
    q="${q%%#*}"
    case "&$q" in
    *[\&]t=*)
        t="${q##*t=}"
        t="${t%%&*}"
        ;;
    *[\&]start=*)
        t="${q##*start=}"
        t="${t%%&*}"
        ;;
    esac
    if [[ -z "$t" ]]; then
        case "$1" in
        *#*t=*)
            t="${1##*t=}"
            t="${t%%&*}"
            ;;
        esac
    fi
    printf '%s' "$t"
}

# The canonical watch URL for a URL that names a video, keeping a `t=` offset; the URL itself
# when no video id can be read out of it.
canonical_watch_url() {
    local u=$1 vid tval
    vid=$(url_video_id "$u")
    if [[ -z "$vid" ]]; then
        printf '%s' "$u"
        return 0
    fi
    tval=$(url_time_param "$u")
    if [[ -n "$tval" ]]; then
        printf 'https://www.youtube.com/watch?v=%s&t=%s' "$vid" "$tval"
    else
        printf 'https://www.youtube.com/watch?v=%s' "$vid"
    fi
}

# A handle is either a URL on one of this engine's hosts, or this engine's own media id.
# Knowing that a YouTube id is exactly 11 characters of [A-Za-z0-9_-] is ENGINE knowledge —
# it is precisely what the player gave up when it stopped being a YouTube tool.
#
# A URL from another site is a USAGE error (1), not an extraction failure (2+): nothing was
# attempted and nothing is retryable — the caller named the wrong engine, the same mistake
# `--engine nope` makes, and it scores the same.
#
# Every accepted handle collapses to the canonical form `https://www.youtube.com/watch?v=ID`
# (optionally keeping a valid `t=` offset for start-time extraction). All tracking parameters
# (feature, si, pp, app, ab_channel, etc.) are stripped, keeping the persistent stores idempotent.
normalize_target() {
    local t=$1 host
    case "$t" in
    http://* | https://*)
        host=$(url_host "$t")
        is_own_host "$host" ||
            die "'$host' is not a YouTube host — this engine resolves YouTube only (another site needs its own engine: t-play --engine NAME)"
        TARGET_URL=$(canonical_watch_url "$t")
        ;;
    youtube.com/* | www.youtube.com/* | m.youtube.com/* | music.youtube.com/* | \
        youtu.be/* | youtube-nocookie.com/* | www.youtube-nocookie.com/*)
        TARGET_URL=$(canonical_watch_url "https://$t")
        ;;
    *)
        [[ "$t" =~ ^[A-Za-z0-9_-]{11}$ ]] ||
            die "'$t' is neither a YouTube URL nor an 11-character video id (to search, pass --search)"
        TARGET_URL="https://www.youtube.com/watch?v=$t"
        ;;
    esac
}

# The list id a URL carries in `list=`, or "". Read from the QUERY and nowhere else: on this
# site the list id never appears in a path segment, and `watch?v=…&list=…` carries it beside
# a video id that --items is not being asked about.
url_list_id() {
    local u="${1%%#*}" q="" v=""
    case "$u" in
    *\?*) q="${u#*\?}" ;;
    *) printf '' ; return 0 ;;
    esac
    case "&$q" in
    *[\&]list=*)
        v="${q##*list=}"
        v="${v%%&*}"
        ;;
    esac
    printf '%s' "$v"
}

# WHAT A CONTAINER HANDLE LOOKS LIKE. `PL…` (a playlist), `OLAK5uy_…` (an album) and `UU…`
# (a channel's uploads) are list ids; `@handle`, `/channel/UC…`, `/c/…` and `/user/…` are
# channels. An 11-character video id is none of them, and neither is a bare word.
#
# ONE SHAPE IS STILL REFUSED, and the reason is STABILITY rather than length: a mix (`RD…`) is
# generated per request, so two calls are not two pages of one list — there is nothing a cursor
# could promise not to repeat. A channel's uploads, by contrast, measured identical across
# segmented reads (2026-09-12: `--playlist-items 1:3` + `4:6` equals `1:6`, id for id), which
# is exactly the property paging needs. `LL`/`FL…` need a login: with one, they read; without,
# yt-dlp says so and that is an upstream failure, not a usage error.
#
# The prefix is checked and the LENGTH is not: the measured `PLLdzS5ShOfOw` carries 11
# characters after `PL` where a list made today carries 32. Length is not this site's
# invariant; the prefix is.
container_is_list_id() {
    [[ "$1" =~ ^(PL|OLAK5uy_|UU|UL|LL|FL)[A-Za-z0-9_-]*$ ]]
}

# A CHANNEL, NORMALISED TO ITS VIDEOS TAB — or "" when the handle is not a channel at all.
#
# The tab is not decoration. Measured 2026-09-12: a bare `@handle` flat-lists as THREE rows of
# `_type: playlist` (Videos / Live / Shorts) and not one video, so a caller who typed a channel
# and got no tab would be answered `count: 0` about a channel with hundreds of uploads.
channel_videos_url() {
    local t=$1 path="" seg="" rest=""
    case "$t" in
    http://* | https://*)
        rest="${t#*://}"
        rest="${rest#*/}"
        path="${rest%%\?*}"
        path="${path%%#*}"
        ;;
    @*) path="$t" ;;
    UC[A-Za-z0-9_-]*) path="channel/$t" ;;
    *) printf '' ; return 0 ;;
    esac
    path="${path#/}"
    path="${path%/}"
    [[ -n "$path" ]] || { printf '' ; return 0 ; }

    # Drop a tab segment the caller may have typed, then name the one this verb means.
    case "$path" in
    */videos | */streams | */shorts | */playlists | */featured | */community | */podcasts)
        path="${path%/*}"
        ;;
    esac
    case "$path" in
    @*)
        [[ "$path" =~ ^@[A-Za-z0-9_.-]+$ ]] || { printf '' ; return 0 ; }
        ;;
    channel/* | c/* | user/*)
        seg="${path#*/}"
        [[ "$seg" =~ ^[A-Za-z0-9_.-]+$ ]] || { printf '' ; return 0 ; }
        ;;
    *) printf '' ; return 0 ;;
    esac
    printf 'https://www.youtube.com/%s/videos' "$path"
}

# --items' OWN handle grammar, BESIDE normalize_target rather than inside it: the two answer
# different questions, and merging them would make a `list=` on a single video's URL expand
# into a queue by itself — which this engine deliberately does not do (`dump_once` passes
# --no-playlist). A container is asked for by VERB, never inferred from a URL.
#
# The HOST gate fires first here too: an off-site URL is the same usage error at every verb
# and must be reported before this engine's opinion about what a container looks like.
normalize_container() {
    local t=$1 host id=""
    case "$t" in
    http://* | https://*)
        host=$(url_host "$t")
        is_own_host "$host" ||
            die "'$host' is not a YouTube host — this engine resolves YouTube only (another site needs its own engine: t-play --engine NAME)"
        id=$(url_list_id "$t")
        ;;
    youtube.com/* | www.youtube.com/* | m.youtube.com/* | music.youtube.com/* | \
        youtu.be/* | youtube-nocookie.com/* | www.youtube-nocookie.com/*)
        id=$(url_list_id "https://$t")
        ;;
    *) id="$t" ;;
    esac

    # A channel is tried only where no list id was found, so `watch?v=…&list=PL…` on a channel
    # URL still means the list the caller named.
    if [[ -z "$id" ]]; then
        local cu
        cu=$(channel_videos_url "$t")
        if [[ -n "$cu" ]]; then
            CONTAINER_ID="$t"
            CONTAINER_URL="$cu"
            return 0
        fi
    fi

    [[ -n "$id" ]] ||
        die "'$t' carries no list id — --items takes a playlist or album URL (…/playlist?list=PL…), a channel (…/@handle), the list= of a watch URL, or the bare list id"
    case "$id" in
    RD*)
        die "'$id' is a mix — it is generated on every request and has no last item, so two calls are not two pages of one list and there is nothing stable to import"
        ;;
    esac
    container_is_list_id "$id" ||
        die "'$id' is not a container — --items reads a playlist (PL…), an album (OLAK5uy_…), a channel's uploads (UU…) or a channel (…/@handle). A single video is what --info and a play take"
    CONTAINER_ID="$id"
    CONTAINER_URL="https://www.youtube.com/playlist?list=$id"
}

# ==============================================================================
# 4. --search
# ==============================================================================

search_run() {
    local cmd=(
        yt-dlp
        "ytsearch${NUM_RESULTS}:${QUERY}"
    )

    # Duration bounds are enforced CLIENT-SIDE (in the jq shaping below); --match-filter is
    # only a cheap server-side pre-filter. Reason: with --flat-playlist yt-dlp marks entries
    # "incomplete", so a filter on a field a flat entry doesn't carry (a live stream has no
    # duration) cannot decide and KEEPS the entry — verified: a 999999s minimum still returned
    # a live result. The filter is also sent only when a bound was actually asked for.
    local match_filter=""
    ((MIN_DURATION > 0)) && match_filter="duration > $MIN_DURATION"
    if ((MAX_DURATION > 0)); then
        [[ -n "$match_filter" ]] && match_filter+=" and "
        match_filter+="duration < $MAX_DURATION"
    fi
    [[ -n "$match_filter" ]] && cmd+=(--match-filter "$match_filter")

    cmd+=(
        --flat-playlist
        --dump-single-json
        -f ba
        --skip-download
        --no-warnings
        --ignore-errors
        --quiet
    )

    # Capture the failure and emit the same {status:"error", reason} taxonomy the rest of the
    # suite uses. A cookie store that cannot be READ is not a search that failed: YouTube
    # search needs no login, so ytdlp_cookied asks once more without the store and says why
    # on stderr.
    ensure_scratch
    local result_json rc=0 reason=""
    result_json=$(ytdlp_cookied "${cmd[@]}") || rc=$?
    if ((rc != 0)) || [[ -z "$result_json" ]]; then
        reason=$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")
        if is_json_out; then
            jq -nc --arg e "$ENGINE_NAME" --arg q "$QUERY" --arg reason "$reason" \
                '{status: "error", engine: $e, query: $q, count: 0, results: [], reason: $reason}'
        else
            cat "$ERR_FILE" >&2 2>/dev/null || true
            echo "Error: search failed for '$QUERY' ($reason)" >&2
        fi
        # 1 is reserved for usage/validation, so a propagated extractor failure reports 2+
        # even when yt-dlp itself exited 1; -j callers branch on .status instead.
        exit $((rc <= 1 ? 2 : rc))
    fi

    # ONE jq program does the whole shaping: duration bounds -> duration_fmt -> sort.
    # Sort is a client-side re-order of the fetched set; "relevance" keeps YouTube's native
    # ranking (the order ytsearch returned). Numeric fields sort descending, with unknown
    # values (live streams) last. SORT_FIELD is validated at startup.
    local sort_expr=""
    case "$SORT_FIELD" in
    duration) sort_expr=' | sort_by(.duration // -1) | reverse' ;;
    view_count) sort_expr=' | sort_by(.view_count // -1) | reverse' ;;
    esac

    local bounds="true"
    ((MIN_DURATION > 0)) && bounds+=" and (.duration != null and .duration > $MIN_DURATION)"
    ((MAX_DURATION > 0)) && bounds+=" and (.duration != null and .duration < $MAX_DURATION)"

    # `kind` and `access` (ARCH-cli-contract.md「数据契约」) are the ENGINE'S JUDGEMENT about a row,
    # not a site field carried over, so they are merged LAST and win over any raw entry key of
    # the same name. Both are constants on this site and that is the whole answer: a YouTube
    # search row that SURVIVES THE GATE BELOW is one video, and anonymous extraction returns
    # the whole timeline or no stream at all — there is no preview form to report.
    #
    # A ROW IS A PLAYABLE CALL, so a container is not a row. `ytsearch` has no scope selector
    # and its result set really is mixed: measured 2026-09-03, row 15 of 周杰伦 is the artist's
    # CHANNEL. The signal is free: yt-dlp tags every flat entry with the extractor that will
    # handle it — a video is `Youtube`, a channel or a playlist is `YoutubeTab`.
    #
    # FAIL OPEN, deliberately: an entry with NO ie_key is kept. A future yt-dlp that stops
    # emitting it would otherwise empty every search on this engine.
    #
    # Dropping shortens the count, and that is the contract already: `-n` says how many to
    # FETCH, never how many come back (ARCH-engine.md「kind 与 access」). A container is not lost,
    # it is UNCLAIMED: --items is its verb. docs/ROADMAP.md「容器行」.
    FILTERED_JSON=$(printf '%s' "$result_json" | jq "$JQ_PRELUDE
        [ (.entries // [])[]
          | select($bounds)
          | select((.ie_key // \"Youtube\") == \"Youtube\")
          | . + {duration_fmt: (.duration | fmt_dur), description: (.description | oneline),
                 kind: \"track\", access: \"full\", thumbnail: pick_thumb} ]$sort_expr")

    case "$OUTPUT_MODE" in
    list)
        # Prose list, one jq program. Unknown fields render as LIVE / "--" / "n/a" instead of
        # leaking a raw JSON `null` into human output.
        printf '%s' "$FILTERED_JSON" | jq -r --arg note "$MUSIC_CHAR" '
            to_entries[]
            | (.key + 1) as $i
            | .value
            | (if $note == "" then "" else $note + " " end) + "\($i). \(.title)",
              "  - " + (if .live_status == "is_live" then "LIVE" else (.duration_fmt // "--") end),
              "  - " + (if .view_count == null then "n/a" else (.view_count | tostring) end) + " views",
              "  - \(.url)"'
        ;;
    raw)
        printf '%s' "$FILTERED_JSON" | jq -c --arg e "$ENGINE_NAME" --arg q "$QUERY" \
            '{status: "ok", engine: $e, query: $q, count: length, results: .}'
        ;;
    *)
        # The lean projection: the raw yt-dlp entries carry ~23 fields (ie_key,
        # x-forwarded-for, two URL variants, …) that are pure token ballast for a headless
        # caller. `engine` is what lets the player route a chosen row back here without
        # pattern-matching its URL. One line: every machine envelope in this suite is.
        printf '%s' "$FILTERED_JSON" | jq -c --arg e "$ENGINE_NAME" --arg q "$QUERY" \
            '{status: "ok", engine: $e, query: $q, count: length,
              results: map({id, title, url, channel, duration, duration_fmt, view_count,
                            live_status, description, kind, access, thumbnail})}'
        ;;
    esac
}

# ==============================================================================
# 5. --stream (internal: the player's handle -> bytes)
# ==============================================================================

# The yt-dlp format string a playback mode resolves to. This table is the reason format
# selection belongs to the engine and not the player: `bv*+ba/b` is a yt-dlp expression,
# and the player must never learn to read one. t-play sends a MODE and gets back bytes.
format_for_mode() {
    case "$1" in
    video) echo "$YT_VIDEO_FORMAT" ;;
    fast) echo "$YT_VIDEO_FORMAT_FAST" ;;
    ascii) echo "$YT_VIDEO_FORMAT" ;;
    *) echo "$YT_AUDIO_FORMAT" ;; # audio, viz
    esac
}

# The yt-dlp format-sort a quality tier resolves to, for a given playback mode. Same rule
# as format_for_mode: a caller sends a canonical TIER, and the yt-dlp sort string exists
# only here. auto (or any pair this table maps to "") sends no --format-sort — the default
# format table already picks the best (ARCH-engine.md「解析」).
quality_sort_for_tier() {
    local mode=$1 tier=$2
    case "$mode" in
    video | fast | ascii)
        case "$tier" in
        low) echo "res:360" ;;
        medium) echo "res:720" ;;
        high) echo "res:1080" ;;
        esac
        ;;
    *) # audio, viz — or absent, format_for_mode's own default arm
        case "$tier" in
        low) echo "+abr" ;;       # smallest bitrate
        medium) echo "abr:128" ;; # capped ~128k
        # high: empty — the default format table already picks the best audio
        esac
        ;;
    esac
}

# ONE yt-dlp call answers the whole question: the signed media URL(s) for the selected
# format, the per-format http_headers that must accompany them, and the title/duration the
# player needs for its OSD and its state record. --dump-single-json runs format selection,
# so `requested_formats` is present exactly when the selection merged two streams.
dump_once() {
    local cmd=(yt-dlp --dump-single-json --no-playlist -f "$FMT")
    local sort
    sort=$(quality_sort_for_tier "$PLAYBACK_MODE" "$QUALITY")
    [[ -n "$sort" ]] && cmd+=(--format-sort "$sort")
    (($#)) && cmd+=("$@")
    cmd+=(--no-warnings --quiet "$TARGET_URL")
    "${cmd[@]}" 2>>"$ERR_FILE"
}

# Project a raw yt-dlp record down to [ {url, http_headers} ], VIDEO FIRST. jq's sort is
# stable, so a merge keeps yt-dlp's own ordering within each class and an audio-only
# selection stays a one-element list. The player reads position, not codec: element 0 is
# what mpv opens, element 1 (when present) is its --audio-file.
JQ_STREAMS='
[ if (.requested_formats | type) == "array"
  then (.requested_formats[] | {url: .url, http_headers: (.http_headers // {}), vcodec: (.vcodec // "none")})
  else {url: .url, http_headers: (.http_headers // {}), vcodec: (.vcodec // "none")}
  end
]
| map(select(.url != null))
| sort_by(if .vcodec == "none" then 1 else 0 end)
'

# True (0) if the media URLs in this record can actually be FETCHED, not merely resolved:
# a signed googlevideo URL answers 206/200 when authorized and 403 when it is missing the
# GVS proof-of-origin token. That 403 is the exact failure that used to make mpv abort
# mid-load, so the probe's verdict matches what playback would do — letting us pick the
# working client BEFORE the player ever launches. For HLS playlists the first segment is
# probed, so a manifest that 200s with 403 segments is caught. The record's own
# http_headers are replayed on the probe request, so what we test is what mpv will send.
#
# When curl is absent we CANNOT probe, and the honest answer is "assume fetchable": the
# caller then keeps its first-choice client. Narrow intersection (no curl AND cookies AND a
# PO-token video).
probe_raw() {
    local raw=$1
    command -v curl >/dev/null 2>&1 || return 0

    local media
    media=$(printf '%s' "$raw" | jq -r "$JQ_STREAMS | .[0].url // empty") || return 1
    [[ -n "$media" ]] || return 1

    local hdr_args=()
    local h
    while IFS= read -r h; do
        [[ -n "$h" ]] && hdr_args+=(-H "$h")
    done < <(printf '%s' "$raw" | jq -r "$JQ_STREAMS | (.[0].http_headers // {}) | to_entries[] | \"\(.key): \(.value)\"" 2>/dev/null)

    if [[ "$media" == *"m3u8"* || "$media" == *"/hls_playlist/"* ]]; then
        local first_seg
        first_seg=$(curl -sSL --max-time 5 ${hdr_args[@]+"${hdr_args[@]}"} "$media" 2>/dev/null | grep -E '^https?://' | head -n 1 || true)
        [[ -n "$first_seg" ]] && media="$first_seg"
    fi

    local code
    code=$(curl -sSL -o /dev/null -I -r 0- --max-time 10 -w '%{http_code}' ${hdr_args[@]+"${hdr_args[@]}"} "$media" 2>/dev/null) || return 1
    [[ "$code" == 2* ]]
}

# The stream envelope (ARCH-cli-contract.md「数据契约」). `format` is the format STRING this
# engine SENT — the player records it verbatim and never reads it — and `selected` is what
# yt-dlp came back having PICKED, so the pair is request and answer: "ba/b" against
# "251 - audio only (medium)". Mind the two spellings in the filter below: `$format` is the
# argument (the request), while a bare `.format` reads the raw yt-dlp record still in `.`
# (the answer). `http_headers` is a REQUIRED key, empty object when none: a bare URL handed
# to a Referer-checking host would 403.
emit_stream() {
    local raw=$1 retried=$2
    local retried_json=false
    ((retried)) && retried_json=true

    if [[ "$OUTPUT_MODE" == "raw" ]]; then
        printf '%s\n' "$raw" | jq -c '.'
        return 0
    fi
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        printf '%s\n' "$raw" | jq -c \
            --arg engine "$ENGINE_NAME" --arg mode "$PLAYBACK_MODE" --arg format "$FMT" \
            --argjson retried "$retried_json" \
            "$JQ_PRELUDE
             ($JQ_STREAMS) as \$s
             | {status: \"ok\", engine: \$engine,
                id: (.id // null), url: (.webpage_url // null),
                title: (.title // null), duration: (.duration // null),
                start_seconds: (.start_time | start_secs),
                mode: \$mode, format: \$format,
                selected: (.format // null),
                selected_resolution: (.resolution // null),
                stream_urls: [\$s[].url],
                http_headers: (\$s[0].http_headers // {}),
                retried: \$retried}"
        return 0
    fi
    # Prose: the stream URLs, one per line — what a human piping this into another tool wants.
    printf '%s' "$raw" | jq -r "$JQ_STREAMS | .[].url"
}

# Report a resolve that produced nothing usable. 2+ is a PROPAGATED tool failure and 1 is
# reserved for usage, so a yt-dlp status of 0 or 1 is FLOORED to 2 — yt-dlp exits 1 for an
# unavailable video, and letting that through would make "this video is gone"
# indistinguishable from "you called me wrong".
stream_fail() {
    local rc=$1 reason
    reason=$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")
    ((rc <= 1)) && rc=2
    if is_json_out; then
        jq -nc --arg engine "$ENGINE_NAME" --arg url "$TARGET_URL" \
            --arg mode "$PLAYBACK_MODE" --arg reason "$reason" \
            '{status: "error", engine: $engine, url: $url, mode: $mode, reason: $reason}'
    else
        echo "$PROG: could not resolve a stream for $TARGET_URL ($reason)" >&2
    fi
    exit "$rc"
}

# Cookies are ON by default so login-gated content resolves; but some PUBLIC videos 403
# with cookies (missing GVS PO token) while the anonymous client fetches fine, and
# login-gated videos are the reverse. So: try the preferred client, probe it, and switch
# only if the other one actually fetches. If NEITHER does (network down, unresolvable,
# both 403) we hand back the cookie attempt anyway and let the player produce the real
# transport error, so the reason taxonomy stays accurate instead of guessing.
stream_run() {
    ensure_scratch
    FMT=$(format_for_mode "$PLAYBACK_MODE")

    local raw_c="" rc_c=0 raw_a="" rc_a=0

    if ((${#COOKIE_ARGS[@]} > 0)); then
        raw_c=$(dump_once "${COOKIE_ARGS[@]}") || rc_c=$?
        # The anonymous attempt below already covers a store that cannot be read; this only
        # says so, once, in words (see cookie_diagnosis).
        if ((rc_c != 0)) && [[ "$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc_c")" == "cookies" ]]; then
            cookie_diagnosis "$(cat "$ERR_FILE" 2>/dev/null)" >&2
        fi
        if ((rc_c == 0)) && [[ -n "$raw_c" ]] && probe_raw "$raw_c"; then
            emit_stream "$raw_c" 0
            return 0
        fi
        raw_a=$(dump_once "${ANON_ARGS[@]}") || rc_a=$?
        if ((rc_a == 0)) && [[ -n "$raw_a" ]] && probe_raw "$raw_a"; then
            emit_stream "$raw_a" 1
            return 0
        fi
        if ((rc_c == 0)) && [[ -n "$raw_c" ]]; then
            emit_stream "$raw_c" 0
            return 0
        fi
        stream_fail "$rc_c"
    fi

    # Anonymous-only (YT_COOKIE_BROWSER=none, or no profile on this machine): nothing to
    # weigh, so no probe either.
    raw_a=$(dump_once "${ANON_ARGS[@]}") || rc_a=$?
    if ((rc_a == 0)) && [[ -n "$raw_a" ]]; then
        emit_stream "$raw_a" 0
        return 0
    fi
    stream_fail "$rc_a"
}

# ==============================================================================
# 6. --info and --transcript (read-only: nothing plays, no mpv, no state file)
# ==============================================================================

# The one place a read-only verb reports a miss, so the text and JSON shapes cannot drift:
# machine callers get {status:"error", ...} and exit 1, humans get a sentence on stderr.
# `reason` is the shared enum, never prose.
readonly_fail() { # <reason> <prose>
    if is_json_out; then
        jq -nc --arg engine "$ENGINE_NAME" --arg url "$TARGET_URL" --arg reason "$1" \
            '{status: "error", engine: $engine, url: $url, reason: $reason}'
        exit 1
    fi
    die "$2"
}

# Rich metadata for a video WITHOUT playing: description, chapters, uploader, upload date,
# like count. Honours cookies like resolution. -j projects a lean schema (the raw record
# carries ~40 fields of formats/thumbnails/fragments that are pure token ballast); --raw returns
# the full raw record; default is a readable text block.
#
# THE ENVELOPE CARRIES EVERY FIELD A SEARCH ROW DOES — `kind`, `access` and `thumbnail`
# included — so a caller holding a URL instead of a search result can build the same row out
# of it. Without them the TUI read the raw --raw record to find a cover, which is site knowledge
# leaking out of the engine. The description stays whole here (search one-lines it): this
# verb is where a caller comes to read it.
info_run() {
    ensure_scratch
    local cmd=(yt-dlp --dump-single-json --skip-download)
    cmd+=(--no-warnings --quiet "$TARGET_URL")

    local raw rc=0
    raw=$(ytdlp_cookied "${cmd[@]}") || rc=$?

    if ((rc != 0)) || [[ -z "$raw" ]]; then
        local reason
        reason=$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")
        readonly_fail "$reason" "could not fetch metadata for: $TARGET_URL ($reason)"
    fi

    case "$OUTPUT_MODE" in
    raw)
        printf '%s\n' "$raw" | jq -c '.'
        ;;
    json)
        printf '%s\n' "$raw" | jq -c --arg engine "$ENGINE_NAME" \
            "$JQ_PRELUDE"'{
            status: "ok",
            engine: $engine,
            id, title,
            url: .webpage_url,
            channel, uploader, upload_date,
            duration, duration_fmt: (.duration | fmt_dur),
            start_seconds: (.start_time | start_secs),
            view_count, like_count, live_status,
            description,
            kind: "track", access: "full",
            thumbnail: pick_thumb,
            chapters: (if (.chapters | type) == "array"
                       then [.chapters[] | {start_time, end_time, title}]
                       else null end)
        }'
        ;;
    *)
        printf '%s' "$raw" | jq -r --arg note "$MUSIC_CHAR" "$JQ_PRELUDE"'
            (if $note == "" then "" else $note + " " end) + (.title // "(untitled)"),
            "  - channel: \(.channel // .uploader // "?")",
            "  - uploaded: \(.upload_date // "?")",
            ((.duration | fmt_dur) // empty | "  - duration: \(.)"),
            "  - views: \(.view_count // "?")   likes: \(.like_count // "?")",
            "  - live: \(.live_status // "?")",
            (.webpage_url // empty | "  - url: \(.)"),
            (if (.chapters | type) == "array" and (.chapters | length) > 0 then
                "", "Chapters:",
                (.chapters[]
                 | ((.start_time // 0) | floor) as $s
                 | (($s / 60) | floor) as $m
                 | ($s - $m * 60) as $sec
                 | "  " + ($m | tostring) + ":" + (if $sec < 10 then "0" else "" end) + ($sec | tostring) + "  " + (.title // ""))
             else empty end),
            (if (.description // "") != "" then "", "Description:", .description else empty end)'
        ;;
    esac
}

# The ONE json3 -> segments transform. json3 (YouTube's own JSON caption format) is asked
# for by name precisely so this stays a jq program: VTT/SRT would need a timeline parser in
# awk, and the point of --sub-format json3 is that the timing is already structured.
#
# Three shapes in a real json3 file have to be dropped, and all three are dropped by the
# SAME two filters rather than by naming them (verified against both a human-authored and
# an auto-generated track):
#   1. the leading window-definition event  -> no "segs" key at all
#   2. auto-caption rollup events (aAppend) -> their only seg is "\n", so it cleans to ""
#   3. style markup inside a cue            -> gsub'd out, then collapsed whitespace
# Filtering on the CLEANED TEXT being empty, instead of on `aAppend == 1`, is deliberate:
# it drops the rollup markers we have seen while keeping any hypothetical aAppend event
# that actually carries words. The trailing consecutive-dedup is insurance on top.
#
# Auto tracks carry word-level segs (each with its own tOffsetMs); joining them with no
# separator is correct because YouTube puts the leading space INSIDE each seg's utf8.
JQ_TRANSCRIPT='
def clean: gsub("<[^>]*>"; "") | gsub("[[:space:]]+"; " ") | sub("^ +"; "") | sub(" +$"; "");
[ .events[]?
  | select(has("segs"))
  | { start:    ((.tStartMs // 0) / 1000),
      duration: ((.dDurationMs // 0) / 1000),
      text:     ([.segs[]? | .utf8 // ""] | join("") | clean) }
  | select(.text != "") ]
| reduce .[] as $s ([]; if ((length > 0) and (.[-1].text == $s.text)) then . else . + [$s] end)
'

transcript_fail() {
    case "$1" in
    no_subtitles_available) readonly_fail "$1" "no captions available for: $TARGET_URL" ;;
    *) readonly_fail "$1" "could not fetch captions ($1) for: $TARGET_URL" ;;
    esac
}

# Fetch a video's caption track and hand it over as text an agent can put straight in a
# prompt, or as a structured envelope.
#
# ONE yt-dlp call does both halves of the job, which is the whole reason this verb is
# cheap. The flag combination is load-bearing and each piece was picked against a measured
# alternative:
#   --write-subs --write-auto-subs   ask for human captions AND auto ones in one pass;
#                                    yt-dlp prefers the human track when both exist.
#   --no-simulate                    REQUIRED. --print alone implies --simulate, and a
#                                    simulating yt-dlp writes no subtitle file at all.
#   --print %(id)s, %(subtitles)j    the id for the envelope, and the HUMAN-caption dict
#                                    (one line, ~15 KB) purely to answer is_auto: the
#                                    written file's language tag is either a key in it
#                                    (human) or it is not (auto). automatic_captions is
#                                    deliberately NOT printed - with YouTube's machine
#                                    translations it runs to 940 languages / 3.2 MB.
#   --sub-format json3               see JQ_TRANSCRIPT.
#   -o <dir>/%(id)s.%(ext)s          yt-dlp splices the language in, so the file lands as
#                                    <id>.<lang>.json3 - that name is how the language and
#                                    the human/auto answer are recovered.
#
# Language selection is a PRIORITY CHAIN, not a single tag: yt-dlp writes a file for every
# candidate it can satisfy, and the first candidate in the caller's own order that actually
# landed wins — in one round trip and with no "which languages exist" query first.
transcript_run() {
    local langs="$SUB_LANG"
    [[ -n "$langs" ]] || langs="$SUB_LANG_CHAIN"

    ensure_scratch
    local dir="$SCRATCH_DIR/transcript"
    mkdir -p "$dir" 2>/dev/null || true

    local cmd=(yt-dlp --skip-download --no-simulate)
    cmd+=(
        --write-subs --write-auto-subs
        --sub-langs "$langs"
        --sub-format json3
        --print "%(id)s"
        --print "%(subtitles)j"
        -o "$dir/%(id)s.%(ext)s"
        --no-warnings --quiet
        "$TARGET_URL"
    )

    # stderr is captured rather than discarded so a failure can be classified into the same
    # reason enum the other verbs use, instead of being reported as a generic "no captions"
    # when the real answer is 429 / private video / no network.
    local out rc=0
    out=$(ytdlp_cookied "${cmd[@]}") || rc=$?

    local vid subs_json
    vid=$(printf '%s\n' "$out" | sed -n 1p)
    subs_json=$(printf '%s\n' "$out" | sed -n 2p)

    if [[ -z "$vid" ]]; then
        transcript_fail "$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")"
    fi

    # Pick the first candidate the caller asked for that yt-dlp actually wrote.
    local pick="" lang="" rest="$langs" cand
    while [[ -n "$rest" ]]; do
        cand="${rest%%,*}"
        if [[ "$rest" == *,* ]]; then rest="${rest#*,}"; else rest=""; fi
        [[ -n "$cand" ]] || continue
        if [[ -f "$dir/$vid.$cand.json3" ]]; then
            pick="$dir/$vid.$cand.json3"
            lang="$cand"
            break
        fi
    done
    # Fallback for a tag yt-dlp normalised on the way out (asking for `zh` can land
    # `zh-Hans`): take whatever single track did arrive rather than calling it a miss.
    if [[ -z "$pick" ]]; then
        local f base
        for f in "$dir"/*.json3; do
            [[ -f "$f" ]] || continue
            pick="$f"
            base="${f##*/}"
            base="${base%.json3}"
            lang="${base#"$vid".}"
            break
        done
    fi

    # No file written is the miss signal, NOT the exit status: yt-dlp exits 0 for a language
    # that simply does not exist on the video (verified), and non-zero only when something
    # else went wrong.
    if [[ -z "$pick" ]]; then
        if ((rc != 0)); then
            transcript_fail "$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")"
        fi
        transcript_fail "no_subtitles_available"
    fi

    # is_auto from the printed human-caption dict: the track's language is a key there, or
    # it came from the automatic side. `NA` is yt-dlp's rendering of an absent field.
    local is_auto=true
    if [[ -n "$subs_json" && "$subs_json" != "NA" ]]; then
        if printf '%s' "$subs_json" | jq -e --arg l "$lang" 'has($l)' >/dev/null 2>&1; then
            is_auto=false
        fi
    fi

    local segments
    segments=$(jq -c "$JQ_TRANSCRIPT" "$pick" 2>/dev/null) || segments=""
    # A track that parses to nothing is a miss, not an empty success: an agent handed
    # {"text":""} would summarise silence and never learn the captions were unusable.
    if [[ -z "$segments" || "$segments" == "[]" ]]; then
        transcript_fail "no_subtitles_available"
    fi

    # -j is the lean projection; --segments makes it a strict SUPERSET. What -j drops is
    # `segments`, because it is the SAME WORDS TWICE: measured on a 444-cue auto track, the envelope is 52,698 bytes of which `text` is 16,917 and `segments` is
    # 35,647 carrying that identical text plus its timings. `chars` and `segment_count` stay
    # so the lean form is still self-describing: a caller can budget context without
    # fetching the rest.
    if is_json_out; then
        local full=false
        ((SEGMENTS)) && full=true
        jq -nc --arg engine "$ENGINE_NAME" --arg id "$vid" --arg url "$TARGET_URL" --arg lang "$lang" \
            --argjson is_auto "$is_auto" --argjson segments "$segments" \
            --argjson full "$full" \
            '($segments | map(.text) | join(" ")) as $text
             | {status: "ok", engine: $engine, id: $id, url: $url, lang: $lang, is_auto: $is_auto,
                chars: ($text | length), segment_count: ($segments | length), text: $text}
             + (if $full then {segments: $segments} else {} end)'
    else
        # Same string the envelope's `text` carries, so the two output modes can never
        # disagree about what the transcript says.
        printf '%s' "$segments" | jq -r 'map(.text) | join(" ")'
    fi
}

# ==============================================================================
# 7. --items (read-only: one yt-dlp call, no mpv, no state file)
# ==============================================================================

# Exit 2, never 1 and never 4: by the time yt-dlp has run nothing here is the caller's usage
# error, and 4 is the lifecycle/storage code an engine never emits (ARCH-cli-contract.md「数据契约」).
items_fail() {
    local reason=$1
    if is_json_out; then
        jq -nc --arg engine "$ENGINE_NAME" --arg url "$CONTAINER_URL" --arg reason "$reason" \
            '{status: "error", engine: $engine, url: $url, reason: $reason}'
    else
        echo "$PROG: could not list the items of $CONTAINER_URL ($reason)" >&2
    fi
    exit 2
}

# An entry is an item only if it can be PLAYED and can say how long it is — a url, and either a
# duration or a reason there is none. That is the judgement a search row passes, applied to
# the same fields: a private or deleted entry arrives titled "[Private video]" with a null
# duration and no live_status, and drops out here, while a live stream keeps its place because
# live_status explains the missing number. `ie_key` is checked for the reason search checks it.
#
# The url is the entry's own when it is one, and built from the id when it is not. It carries
# no `list=` (measured), so a stored record plays as one track.
JQ_ITEMS='
def item_url: if (.url | type) == "string" and (.url | startswith("http"))
              then .url else "https://www.youtube.com/watch?v=" + .id end;
[ (.entries // [])[]
  | select((.ie_key // "Youtube") == "Youtube")
  | select((.id | type) == "string" and (.id | length) > 0)
  | select((.duration | type) == "number"
           or ((.live_status | type) == "string" and (.live_status | length) > 0)) ] as $rows
| {status: "ok", engine: $engine, id: (.id // $id), url: $url,
   title: (.title // null),
   count: ($rows | length),
   total: $total,
   has_more: $has_more,
   next_cursor: $next_cursor,
   items: [ $rows | to_entries[]
            | .key as $i | .value as $r
            | {n: ($i + 1), engine: $engine, id: $r.id,
               url: ($r | item_url),
               title: ($r.title // null),
               duration: ($r.duration // null),
               duration_fmt: (($r.duration | fmt_dur) // null)} ]}
'

# A CONTAINER IS NOT A ROW. A playlist holds tens to thousands of videos and has no duration
# of its own; what it has is a track count and a cursor. ARCH-engine.md「容器（--items）」.
#
# EVERY ITEM IS AN ITEM RECORD: `{engine, id, url, title, duration}` is what t-playlist stores
# and what t-play --queue consumes, so `--items -j` pipes into either with nothing renamed.
#
# A URL IS STILL NOT A QUEUE. `dump_once` keeps --no-playlist, so a `list=` riding along on a
# single video's URL is ignored by every other verb; this one reads it only because the caller
# asked for the container by name. ARCH-engine.md「URL 不变队列，动词才变」.
#
# ONE yt-dlp call, --flat-playlist: measured 2026-09-10, an 87-video list answers in 1.0s and
# a 12-track album in 0.7s, and each entry already carries the whole item record.
items_run() {
    ensure_scratch

    local start=$((CURSOR_OFFSET + 1)) end=$((CURSOR_OFFSET + ITEMS_MAX))
    local cmd=(yt-dlp --flat-playlist --dump-single-json --playlist-items "$start:$end")
    # Cookies for the same reason --info takes them: a caller's own unlisted playlist is
    # readable with the login it already configured.
    cmd+=(--no-warnings --quiet "$CONTAINER_URL")

    local raw rc=0
    raw=$(ytdlp_cookied "${cmd[@]}") || rc=$?

    if ((rc != 0)) || [[ -z "$raw" ]]; then
        items_fail "$(classify_yt_dlp_error "$(cat "$ERR_FILE" 2>/dev/null)" "$rc")"
    fi
    # THE EXISTENCE CHECK reads the SHAPE because the exit code does not always answer: a list
    # id of the right form that names nothing comes back rc 0 with `id: null` and no entries
    # (measured on a made-up OLAK5uy_ id), while a bogus PL id exits 1 with "The playlist does
    # not exist". Both are statements about the handle, so both answer the same way.
    printf '%s' "$raw" | jq -e '(.id | type) == "string"' >/dev/null 2>&1 ||
        items_fail "unavailable"

    if [[ "$OUTPUT_MODE" == "raw" ]]; then
        printf '%s\n' "$raw" | jq -c '.'
        return 0
    fi

    # HOW MANY RAW ENTRIES CAME BACK decides whether there is a next batch, counted BEFORE the
    # item filter: `has_more` answers about the container, not about how many of its rows are
    # playable.
    #
    # `playlist_count` is only sometimes there (2026-09-12, @RickAstleyYT): asking for `1:6` of
    # a 138-video channel answers `playlist_count: null`, asking for `10000:10005` answers 138
    # with no entries. The site tells the count when the walk reaches the end and not before —
    # so `total` is null while a batch is full, and truthful on the batch that runs out.
    local raw_n total="null" has_more=false next_cursor="null" next_off
    raw_n=$(printf '%s' "$raw" | jq -r '(.entries // []) | length' 2>/dev/null) || raw_n=0
    [[ "$raw_n" =~ ^[0-9]+$ ]] || raw_n=0
    total=$(printf '%s' "$raw" | jq -r '.playlist_count // "null"' 2>/dev/null) || total="null"
    [[ "$total" =~ ^[0-9]+$ ]] || total="null"
    next_off=$((CURSOR_OFFSET + raw_n))
    if ((raw_n >= ITEMS_MAX)); then
        has_more=true
        [[ "$total" != "null" ]] && ((next_off >= total)) && has_more=false
    fi
    [[ "$has_more" == true ]] && next_cursor="\"o:$next_off\""

    local env_json
    env_json=$(printf '%s' "$raw" | jq -c --arg engine "$ENGINE_NAME" --arg id "$CONTAINER_ID" \
        --arg url "$CONTAINER_URL" --argjson total "$total" \
        --argjson has_more "$has_more" --argjson next_cursor "$next_cursor" \
        "$JQ_PRELUDE $JQ_ITEMS" 2>/dev/null) ||
        items_fail "unknown"

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        printf '%s\n' "$env_json"
        return 0
    fi

    # Prose: the title, a dashed summary line, then one line per item. An EMPTY list prints
    # its title and a count of 0 — that is an answer, not an error.
    printf '%s' "$env_json" | jq -r --arg note "$MUSIC_CHAR" '
        (if $note == "" then "" else $note + " " end) + (.title // "(untitled)"),
        "  - items: \(.count)   total: \(.total // "?")",
        (.items[] | "  \(.n). \(.title // "")  \(.duration_fmt // "")")'
}

# ==============================================================================
# 8. --auth (read-only: no network, no yt-dlp, no state file)
# ==============================================================================

# Report the cookie DECISION this engine made at startup: which browser profile it will
# read, and whether that profile exists on this machine. It answers BEFORE the yt-dlp
# dependency gate and makes no request, because it is a question about this process's own
# configuration, not about the site.
#
# What it deliberately does NOT claim is that the session behind those cookies is valid.
# `auth: "cookie"` means the cookies are SENT: an expired login still reports "cookie".
auth_run() {
    local auth="anonymous" found=false readable=null
    if ((${#COOKIE_ARGS[@]} > 0)); then
        auth="cookie"
        found=true
        # A profile folder that exists is not a store this process may read (cookie_probe),
        # and a status line that said "signed in" over a blocked read was the whole bug.
        # null = no probe for this browser, so no claim either way.
        cookie_probe "$YT_COOKIE_BROWSER"
        case "$COOKIE_STATE" in
        readable) readable=true ;;
        unknown) readable=null ;;
        *) readable=false ;;
        esac
    fi
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg engine "$ENGINE_NAME" --arg auth "$auth" \
            --arg browser "$YT_COOKIE_BROWSER" --argjson found "$found" --argjson readable "$readable" \
            '{status: "ok", engine: $engine, auth: $auth,
              cookie_browser: $browser, profile_found: $found, cookie_readable: $readable}'
        return 0
    fi
    if [[ "$auth" == "cookie" && "$readable" == "false" ]]; then
        printf 'cookie (%s, unreadable: %s)\n' "$YT_COOKIE_BROWSER" "$COOKIE_STATE"
    elif [[ "$auth" == "cookie" ]]; then
        printf 'cookie (%s)\n' "$YT_COOKIE_BROWSER"
    else
        printf 'anonymous\n'
    fi
}

