#!/usr/bin/env bash
# ne-search — the NetEase Cloud Music SEARCH ENGINE: query -> result envelope. Agent-facing.
#
# One half of the netease engine pair (`ne-search` + `ne-resolve`); the player (`t-play`) is
# source-agnostic and knows neither. This file owns everything that is NetEase-specific about
# searching: the weapi request envelope, the AES wrapping it needs, the result shaping, and
# the one signal this site publishes that neither shipping engine could ever compute. It has
# NO playback, lifecycle, or mpv logic and never starts a process that outlives it.
#
# WHY THIS HALF TALKS HTTP AND WHY THE HTTP IS ENCRYPTED. Measured 2026-09-02:
#   GET /api/search/get/web  the plaintext endpoint every third-party client used to call
#                            answers {"result":"35b174…"} — a hex blob, not JSON. It is dead.
#   POST /weapi/cloudsearch/pc  answers code:200 with the whole page of metadata — id, name,
#                            artists, album, duration AND `fee`, in one request, anonymous.
# So the transport is weapi, and weapi means two AES-128-CBC passes plus an `encSecKey`. That
# is the whole reason this engine — alone in the suite — needs `openssl`, and the dependency
# is scoped to this ONE file: `ne-resolve` shells out to yt-dlp and fetches lyrics over plain
# GET, so a machine without openssl loses this half and nothing else. docs/ARCHITECTURE.md
# 「原语与接缝」; ARCH-engine.md.
#
# WHAT THIS ENGINE IS FOR, stated because it decides whether a query is worth running here.
# Measured 2026-09-02 over 10 queries x 50 rows: 57% of rows are playable on a free account,
# and the distribution is BIMODAL — artist names run 6-36% (Taylor Swift 6, 陈奕迅 24, 周杰伦
# 30, 王菲 36) while instrumental and long-tail queries run 62-98% (jazz 62, 电子 72, 古典 76,
# 邓丽君 84, 钢琴 88, lofi 98). Search an artist and you mostly hit the VIP wall; search a mood
# and almost everything plays. That is a property of the catalogue, not of this code.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features; guard empty-array
# expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). ARCHITECTURE.md「可移植性契约」.

# Resolve this script's OWN symlink chain before looking for its siblings — see the same
# block in yt-search for why `cd -P`/`pwd -P` and a hand-rolled loop (bash 3.2 has no
# `readlink -f`).
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)

# THE version of the whole suite, declared once — in a data file, not in code. See the same
# block in yt-search / yt-resolve / t-play. CLAUDE.md § one fact, one place.
if [[ -r "$SCRIPT_DIR/../VERSION" ]]; then
    UT_VERSION=$(cat "$SCRIPT_DIR/../VERSION")
else
    UT_VERSION="unknown"
fi

# CONFIGURATION — the chain is flag > environment > the user's config > the shipped defaults
# in `<checkout>/config`, which is where every default value in the suite is declared once.
# Duplicated VERBATIM in all ten entry points — see the same block in t-play for why, and
# ARCH-cli-contract.md「配置面」 for the keys.
TING_CONFIG="${TING_CONFIG:-${UT_CONFIG:-}}"
if [[ -z "$TING_CONFIG" ]]; then
    if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/ting/config" ]]; then
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ting/config"
    else
        TING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/uting/config"
    fi
fi
UT_CONFIG="$TING_CONFIG"
for _v in STATE_DIR ENGINE_DIR HISTORY THEME ACCENT VOLUME LANG IMAGE KEYS RESOURCE RESOURCE_TICKS BRAND ASCII SYNC PLAY_QUALITY VIZ_STYLE VIZ_COLOR DEAD_KEEP DEFAULT_ENGINE MODE_CYCLE SORT_CYCLE THEME_CYCLE QUALITY_CYCLE LOOP_CYCLE; do
    eval "[[ -n \"\${TING_$_v+x}\" ]] && UT_$_v=\"\$TING_$_v\" || true"
    eval "[[ -n \"\${UT_$_v+x}\" && -z \"\${TING_$_v+x}\" ]] && TING_$_v=\"\$UT_$_v\" || true"
done
UT_DEFAULTS="$SCRIPT_DIR/../config"
ut_read_config() {
    local file="$1" line key val _ting_k _ut_k
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        while [[ "$line" == [[:space:]]* ]]; do line="${line#[[:space:]]}"; done
        while [[ "$line" == *[[:space:]] ]]; do line="${line%[[:space:]]}"; done
        [[ -n "$line" && "$line" == *=* ]] || continue
        key="${line%%=*}"
        val="${line#*=}"
        while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
        while [[ "$val" == [[:space:]]* ]]; do val="${val#[[:space:]]}"; done
        [[ "$key" =~ ^(TING|UT|YT|BILI|NE)_[A-Z0-9_]+$ ]] || continue
        case "$key" in
        TING_CONFIG | TING_DEFAULTS | TING_ENGINE_DIR | TING_VERSION | UT_CONFIG | UT_DEFAULTS | UT_ENGINE_DIR | UT_VERSION | YT_IPC_SOCK | YT_DETACHED | YT_PLAYER_ID | YT_DETACHED_LOG) continue ;;
        esac
        if [[ ${#val} -ge 2 ]] && { [[ "$val" == \"*\" ]] || [[ "$val" == \'*\' ]]; }; then
            val="${val#?}"
            val="${val%?}"
        fi
        [[ "$val" == "~/"* ]] && val="$HOME/${val#\~/}"
        if [[ "$key" == TING_* ]]; then
            _ut_k="UT_${key#TING_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ut_k+x}\" ]] || $_ut_k=\$val"
        elif [[ "$key" == UT_* ]]; then
            _ting_k="TING_${key#UT_}"
            eval "[[ -n \"\${$key+x}\" ]] || $key=\$val"
            eval "[[ -n \"\${$_ting_k+x}\" ]] || $_ting_k=\$val"
        else
            eval "[[ -n \"\${$key+x}\" ]]" && continue
            eval "$key=\$val"
        fi
    done < "$file"
}
# FAIL FAST AND SAY WHY. There is deliberately no escape hatch for --version or --help: a
# checkout missing part of itself is not a dependency gate (curl, jq and openssl still answer
# --version without being installed) — it is a broken checkout, and 2 is the exit code for a
# failure that is not the caller's usage error.
if [[ ! -r "$UT_DEFAULTS" ]]; then
    printf '%s: cannot read the shipped defaults at %s — that file declares every default value in the suite and is not optional\n' \
        "$(basename "$0")" "$UT_DEFAULTS" >&2
    exit 2
fi
ut_read_config "$UT_CONFIG"
ut_read_config "$UT_DEFAULTS"

# The engine's own name, as it appears in the envelope AND as the command prefix its two
# executables carry. Name == prefix is what lets `t-play --engine ne` find `ne-resolve`
# by string concatenation, with no name->command registry. docs/ARCHITECTURE.md「命令拓扑」.
ENGINE_NAME="ne"

# ==============================================================================
# 1. SETTINGS
# ==============================================================================

SEARCH_ENDPOINT="https://music.163.com/weapi/cloudsearch/pc"

# The Referer is the only header the endpoint insists on, and it is a public constant, not an
# authentication mechanism. `os=pc` is likewise a client-shape hint, not a credential: this
# engine sends NO account cookie, no token and reads no browser profile (measured 2026-09-02
# — the anonymous request answers code:200 with the full page).
#
# UNPREFIXED, like bili-search's SEARCH_ENDPOINT and for the same reason: since
# ARCHITECTURE.md「两个根数据文件」 the prefix IS config reachability — ut_read_config accepts
# every UT_/YT_/BILI_/NE_ name not in its refusal list — so an NE_ spelling would be taken off
# disk and then silently overwritten by this line. A constant must not wear a settable name.
SEARCH_REFERER="https://music.163.com"
SEARCH_COOKIE="os=pc"

# THE WEAPI WRAPPER, and every constant in it. The site's browser client wraps a JSON payload
# in two AES-128-CBC passes and ships the (RSA-encrypted) second key alongside:
#
#     step1  = base64( AES-128-CBC( payload_json, presetKey, iv ) )
#     params = base64( AES-128-CBC( step1,        secretKey, iv ) )
#     encSecKey = RSA_nopad( reverse(secretKey) )
#
# presetKey and iv are the site's own literals. `secretKey` is a value the CALLER picks —
# the browser generates 16 random characters per request and nothing on the far side checks
# that it is random — so this engine PINS it to presetKey, and `encSecKey` collapses from a
# per-request modular exponentiation into the 256-hex-character constant below. That is the
# whole reason no RSA runs at play time: measured 2026-09-02, a search sent with these three
# constants answers code:200.
#
# The keys are given to openssl as HEX because that is what -K/-iv take. They are written out
# rather than derived with `xxd -p`: xxd ships with vim, not with a base system, and deriving
# a constant at runtime would add a dependency to save nothing.
#   presetKey "0CoJUm6Qyw8W8jud" · iv "0102030405060708" (the ASCII digits, not the bytes)
PRESET_KEY_HEX="30436f4a556d365179773857386a7564"
IV_HEX="30313032303330343035303630373038"
# HOW encSecKey WAS COMPUTED, written down so the next person dares to touch it. It is
# RSA(reverse(secretKey)) with NO padding: 112 zero bytes followed by the 16 bytes of the
# REVERSED key, exactly 128 bytes in, textbook modular exponentiation against the site's
# public modulus. Change PRESET_KEY_HEX and this MUST be recomputed — and the only symptom of
# getting it wrong is a generic error code from the endpoint, which is precisely why the
# known-vector check in tests/contract.sh exists.
#
#     K='0CoJUm6Qyw8W8jud'
#     { head -c 112 /dev/zero; printf '%s' "$(printf '%s' "$K" | rev)"; } > in.bin
#     openssl pkeyutl -encrypt -pubin -inkey pub.pem -pkeyopt rsa_padding_mode:none \
#         -in in.bin | xxd -p -c 256
#
# pub.pem is NetEase's published client key (a public constant, not a secret):
#     -----BEGIN PUBLIC KEY-----
#     MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDgtQn2JZ34ZC28NWYpAUd98iZ37BUrX/aKzmFbt7cl
#     FSs6sXqHauqKWqdtLkF2KexO40H1YTX8z2lSgBBOAxLsvaklV8k4cBFK9snQXE9/DDaFt6Rr7iVZMldc
#     zhC0JNgTz+SHXT6CBHuX3e9SdB1Ua44oncaTWz7OBGLbCiK45wIDAQAB
#     -----END PUBLIC KEY-----
#   (the PEM body is ONE line in the original; folded here only to fit this column.)
ENC_SEC_KEY="bf50d0bcf56833b06d8d1219496a452a1d860fd58a14c0aafba3e770104ca77dc6856cb310ed3309039e6865081be4ddc2df52663373b20b70ac25b4d0c6ca466daef6b50174e93536e2d580c49e70649ad1936584899e85722eb83ceddfb4f56c1172fca5e60592d0e6ee3e8e02be1fe6e53f285b0389162d8e6ddc553857cd"

# The endpoint's own ceiling on one request. Asking for more is answered with fewer, so the
# page plan below is built around it rather than discovering it every time.
PAGE_LIMIT_MAX=100
# HOW MANY REQUESTS ONE SEARCH MAY SPEND. The default filter (NE_INCLUDE_VIP=0) throws rows
# away, so `-n 20` against an artist name can come back holding six; the answer is to ASK FOR
# MORE, never to promise less — `-n` has always said how many to FETCH, not how many will be
# emitted. Two knobs bound that: each request asks for twice what is still wanted, and no
# search makes more than three requests. Three because this host has risk control and the
# fourth request buys the tail of a page nobody reads.
#
# Neither is a config key, deliberately: they are this engine's internal cost policy, not a
# per-user choice, and the flag/config surface stays narrow enough for a small model to call.
OVERFETCH=2
MAX_REQUESTS=3

# The `-n` default. Cross-engine: a caller who wants a different result count by default
# wants it from whichever source they asked. ARCH-cli-contract.md「配置面」.
NUM_RESULTS=$UT_SEARCH_RESULTS
MIN_DURATION=0
MAX_DURATION=0
# The `-s` default, cross-engine like `-n`.
SORT_FIELD="$UT_SORT_FIELD"
COLOR_MODE="auto"
OUTPUT_MODE="list"
QUERY=""
FILTERED_JSON=""

# Glyph fallback shares ONE switch with ting (YT_ASCII, legacy alias YT_TUI_ASCII): a
# terminal whose font can't draw ♫ can't draw it in either surface, and a non-UTF-8 locale
# (bare cron/launchd) would emit mojibake. Empty = drop the glyph, as ting does.
MUSIC_CHAR="♫"
case "${YT_ASCII:-${YT_TUI_ASCII:-}}" in
1 | true | yes | on) MUSIC_CHAR="" ;;
"")
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8* | *utf-8* | *UTF8* | *utf8*) ;;
    *) MUSIC_CHAR="" ;;
    esac
    ;;
esac

# ==============================================================================
# 2. HELPERS
# ==============================================================================

err() {
    local red='' reset=''
    case "${COLOR_MODE:-auto}" in
    always)
        red=$'\033[31m'
        reset=$'\033[0m'
        ;;
    auto)
        if [[ -t 2 ]]; then
            red=$'\033[31m'
            reset=$'\033[0m'
        fi
        ;;
    never) ;;
    esac
    echo "${red}Error:${reset} $*" >&2
}

die() {
    err "$@"
    exit 1
}

# A missing tool is not a malformed call: `die` is exit 1 (the argv is wrong — fix it),
# `die_dep` is exit 2 (the argv was fine; the machine is missing something no rewrite of the
# argv will supply). An agent that read 1 here would loop editing its own parameters against
# a wall. docs/ARCH-cli-contract.md「退出码、TTY、依赖」.
die_dep() {
    err "required command not found: $1"
    exit 2
}

is_non_negative_int() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

validate_enum() {
    local value=$1
    shift
    local allowed
    for allowed in "$@"; do
        if [[ "$value" == "$allowed" ]]; then
            return 0
        fi
    done
    return 1
}

require_cmd() {
    local cmd=$1
    command -v "$cmd" >/dev/null 2>&1 || die_dep "$cmd"
}

require_deps() {
    local cmd
    for cmd in "$@"; do
        require_cmd "$cmd"
    done
}

# The ONE implementation of duration formatting: seconds -> "[Nd ]HHh:MMm:SSs". A jq prelude,
# not a bash function, so a caller already shaping JSON pays one fork instead of one per row.
# Each engine carries its own copy: they are independent executables sharing no library, and
# the shared fact is the FORMAT, stated once in docs/ARCH-engine.md「搜索子系统」.
#
# `ne_secs` is this site's own half: duration arrives as `dt`, in MILLISECONDS.
JQ_PRELUDE='
def p2: tostring | if length < 2 then "0" + . else . end;
def fmt_dur:
  if type != "number" then null
  else (. | floor) as $t
    | ($t / 86400 | floor) as $d
    | (($t % 86400) / 3600 | floor) as $h
    | (($t % 3600) / 60 | floor) as $m
    | ($t % 60) as $s
    | (if $d > 0 then "\($d)d " else "" end) + "\($h | p2)h:\($m | p2)m:\($s | p2)s"
  end;
def ne_secs:
  if type != "number" then null else (. / 1000 | floor) end;
# THE COVER, normalised to one directly-GETtable https URL — the site field name stops here.
# `.al.picUrl` is what this site calls it, and a caller must never learn that (CLAUDE.md:
# site knowledge lives in an engine). Measured 2026-09-03: it arrives over PLAIN http on
# every row (`http://p3.music.126.net/…jpg`), and the host serves the identical bytes over
# https — so the scheme is upgraded rather than passed through, because a TUI that fetches
# it must not be the one place in the suite that downgrades a connection.
#
# The cover is SQUARE here (album art), not 16:9 like the two video sites. Nothing in this
# engine acts on that — an aspect ratio is a rendering fact and belongs to whoever draws —
# but it is why the field is a URL and not a promised shape.
def pick_thumb:
  (.al.picUrl // "") as $p
  | if ($p | type) != "string" or $p == "" then null
    elif ($p | startswith("http://")) then ($p | sub("^http://"; "https://"))
    elif ($p | startswith("https://")) then $p
    else null
    end;
'

# THE `fee` -> `access` MAP, and the reason this engine exists at all beyond being a third
# source. `access` (ARCH-cli-contract.md「数据契约」) is printed as a constant "full" by both
# shipping engines because neither site tells them anything else in a search response; this
# one puts the answer in `.result.songs[].fee`, for free, in the page already fetched.
#
# The map, and what each arm is measured against (2026-09-02):
#   0, 8  -> full        id 5257138 (fee:8) resolves to size 12764517 / br 320001 / the whole
#                        319s — a complete track, not a sample.
#   1     -> preview     the two paths disagree and the honest answer is the one the PLAYER
#                        will take: weapi answers size:0 / br:0 / level:null (no stream at
#                        all), while the eapi path yt-dlp uses answers a playable but
#                        TRUNCATED 30-second clip. `ne-resolve` walks the second, so the row
#                        promises a preview.
#   4     -> paywalled   album purchase required. Zero rows of 500 measured, filled from the
#                        site's own semantics rather than left to fall through.
#   else  -> full        an engine states what it knows and does not downgrade on a value it
#                        has never seen.
#
# `preview` rather than `paywalled` for fee:1 keeps this field a LOWER BOUND: a VIP account
# resolving the whole track is not a broken promise, and it keeps `access` a statement about
# the SITE rather than about who is logged in (ARCH-cli-contract.md「数据契约」).
#
# ONE definition, used by the shaping program and by nothing else — the page loop decides
# whether to fetch again by counting the SHAPED rows, so the predicate cannot drift from what
# is emitted.
JQ_ACCESS='
def ne_access:
  if type != "number" then "full"
  elif . == 1 then "preview"
  elif . == 4 then "paywalled"
  else "full"
  end;
'

# Map an HTTP status + the response body's own `code` to the suite's stable reason taxonomy so
# an agent caller can branch on `reason` instead of on NetEase's numbers. The ENUM is the
# shared fact and lives in ARCH-cli-contract.md「数据契约」 — no member may be added here
# that it does not already have.
#
# -462 is this host's rate limit and lands in `network`, the member that already means
# RETRYABLE — the same call 429 gets everywhere else in the suite. `forbidden` would tell a
# caller these credentials never work, which is doubly wrong here: no credential was sent.
classify_http_error() {
    local curl_rc=$1 http=$2 code=$3
    # curl never got an answer: DNS, connection refused, TLS, timeout. All transport.
    if ((curl_rc != 0)); then
        echo "network"
        return
    fi
    case "$http" in
    412 | 429 | 5??) echo "network"; return ;;
    403) echo "forbidden"; return ;;
    404) echo "unavailable"; return ;;
    esac
    case "$code" in
    -462 | -447 | 405) echo "network"; return ;;
    -460 | -2) echo "forbidden"; return ;;
    esac
    echo "unknown"
}

# This process's own scratch dir: 0700, created lazily, removed however we exit. Lazily
# because -h / -V must answer without touching the filesystem, and process-level rather than a
# function `local` because the EXIT trap runs after the function has returned — a `local`
# would be out of scope there and abort under `set -u`.
#
# The engine does not write into the player's state dir: `players/` has exactly one owner
# (t-play). 0700 rather than a bare /tmp path because a response body is content.
SCRATCH_DIR=""
cleanup_scratch() {
    [[ -n "$SCRATCH_DIR" ]] && rm -rf "$SCRATCH_DIR" 2>/dev/null
    return 0
}
trap cleanup_scratch EXIT

ensure_scratch() {
    [[ -n "$SCRATCH_DIR" ]] && return 0
    SCRATCH_DIR=$(mktemp -d "${TMPDIR:-/tmp}/ne-search.XXXXXX") || die "cannot create a scratch directory"
    chmod 700 "$SCRATCH_DIR" 2>/dev/null || true
}

# ==============================================================================
# 3. SEARCH
# ==============================================================================

# Report a search that produced nothing usable, in whichever shape the caller asked for. Exit
# code follows the suite taxonomy: ARCH-cli-contract.md「退出码」 reserves 1 for
# usage/validation, so a failure to reach or parse the site is 2 — a caller branching on the
# exit code must be able to tell "you called me wrong" from "the site did not answer".
search_fail() {
    local reason=$1
    if [[ "$OUTPUT_MODE" == "json" || "$OUTPUT_MODE" == "json_full" ]]; then
        jq -nc --arg e "$ENGINE_NAME" --arg q "$QUERY" --arg reason "$reason" \
            '{status: "error", engine: $e, query: $q, count: 0, results: [], reason: $reason}'
    else
        echo "Error: search failed for '$QUERY' ($reason)" >&2
    fi
    exit 2
}

# THE ONLY PLACE IN THE SUITE THAT ENCRYPTS ANYTHING. Payload JSON in, the `params` value out.
# Two passes with the same key, because the second key is pinned to the first (see ENC_SEC_KEY
# above); `-A` on both is load-bearing — without it openssl wraps its base64 at 64 columns and
# the endpoint is handed a value with newlines in it.
weapi_params() {
    local payload=$1 step1
    step1=$(printf '%s' "$payload" |
        openssl enc -aes-128-cbc -K "$PRESET_KEY_HEX" -iv "$IV_HEX" -a -A) || return 1
    printf '%s' "$step1" |
        openssl enc -aes-128-cbc -K "$PRESET_KEY_HEX" -iv "$IV_HEX" -a -A || return 1
}

# One attempt. Sets PAGE_HTTP / PAGE_CODE / PAGE_CURL_RC and leaves the body on disk; the
# caller decides what the answer is worth. Globals rather than a return value because they
# travel together and bash 3.2 command substitution would strip the file the others wrote.
#
# The transport seam, twin of bili-search's `fetch_page_once`: arguments reach curl as an
# ARRAY and both values go through --data-urlencode, so nothing in a query or a ciphertext
# (base64 contains `+` and `/`) can be read as a further parameter.
PAGE_HTTP=""
PAGE_CODE=""
PAGE_CURL_RC=0
fetch_page_once() {
    local limit=$1 offset=$2 body=$3
    local payload params

    # limit/offset are STRINGS in this payload — that is the shape the site's own client
    # sends, and it is what was measured answering 200.
    payload=$(jq -cn --arg s "$QUERY" --arg limit "$limit" --arg offset "$offset" \
        '{s: $s, type: "1", limit: $limit, offset: $offset, csrf_token: ""}') || return 1
    params=$(weapi_params "$payload") || return 1

    local cmd=(
        curl -sS --compressed
        --max-time 15 --retry 0
        -o "$body" -w '%{http_code}'
        "$SEARCH_ENDPOINT"
        -H "User-Agent: $NE_UA"
        -H "Referer: $SEARCH_REFERER"
        -H "Cookie: $SEARCH_COOKIE"
        --data-urlencode "params=$params"
        --data-urlencode "encSecKey=$ENC_SEC_KEY"
    )

    PAGE_CURL_RC=0
    PAGE_HTTP=$("${cmd[@]}" 2>/dev/null) || PAGE_CURL_RC=$?
    PAGE_CODE=""
    if [[ -s "$body" ]]; then
        PAGE_CODE=$(jq -r '.code // empty' "$body" 2>/dev/null) || PAGE_CODE=""
    fi
    ((PAGE_CURL_RC == 0)) && [[ "$PAGE_HTTP" == "200" && "$PAGE_CODE" == "200" ]]
}

# One page of results, left in $SCRATCH_DIR/chunk.json as the raw `.result.songs` array.
# NO RETRY: this engine spends at most three requests per search against a host with risk
# control, and a retry would quietly make that six. `network` is the enum member that already
# means retryable, and spending another request is the caller's decision — the same argument
# bili-resolve's --parts makes.
#
# IT RETURNS A STATUS AND WRITES A FILE; IT DOES NOT PRINT AND IT DOES NOT DIE. A failure
# reported by calling `search_fail` from in here would be swallowed: the caller runs this
# inside a command substitution, so the error envelope would land in a shell variable and the
# only thing reaching the caller's caller would be the exit code — a JSON caller handed an
# empty stdout and a bare 2, which is exactly the contract this envelope exists to keep
# (ARCH-cli-contract.md「数据契约」).
PAGE_TOTAL=0
FETCH_REASON=""
fetch_page() {
    local limit=$1 offset=$2
    local body="$SCRATCH_DIR/page.$offset.json"

    if ! fetch_page_once "$limit" "$offset" "$body"; then
        FETCH_REASON=$(classify_http_error "$PAGE_CURL_RC" "$PAGE_HTTP" "$PAGE_CODE")
        return 1
    fi

    # `songCount` is the server's own total and is how the loop knows the tail is exhausted
    # without spending a request to discover an empty page. An exhausted or empty search
    # omits `.result.songs` entirely rather than sending [].
    PAGE_TOTAL=$(jq -r '.result.songCount // 0' "$body" 2>/dev/null) || PAGE_TOTAL=0
    is_non_negative_int "$PAGE_TOTAL" || PAGE_TOTAL=0
    jq -c '.result.songs // []' "$body" >"$SCRATCH_DIR/chunk.json" 2>/dev/null ||
        echo '[]' >"$SCRATCH_DIR/chunk.json"
    return 0
}

# ONE jq program does the whole shaping, and the page loop below runs THIS — never a second
# predicate of its own — to decide whether to fetch again. The normalised fields are merged
# OVER the raw record rather than replacing it, so -J keeps every field the site sent while -j
# projects the same twelve keys the other two engines project.
#
# Field by field, and the two that are deliberately null:
#   view_count  ALWAYS null. The response carries `.pop`, which is a 0-100 popularity SCORE,
#               not a play count. Printing it as view_count would publish a fabricated fact in
#               a field whose whole meaning is "how many times this was played".
#   live_status ALWAYS null. A song is not a broadcast; this site has no live form here.
#   kind        always "track" — a cloudsearch type:1 result IS one song, and the site's
#               album/playlist shapes live behind other type numbers this engine does not ask
#               for. A constant that was measured, not a stub.
#   access      the one field that is COMPUTED, from `.fee` — see JQ_ACCESS.
#
# `title` is NOT run through an HTML unescaper, and that is measured rather than assumed
# (2026-09-02): unlike Bilibili's search, this endpoint highlights nothing and escapes
# nothing — a track really called "R&B Soul" arrives with a bare `&`. Unescaping entities in
# text that carries none can only corrupt it.
#
# `select(.url != null)` is the row's own premise: a result is a CALL (`t-play --engine ne --
# <url>`) or it is not a row. ARCH-cli-contract.md「数据契约」.
JQ_SHAPE='
[ .[]
  | . + { id:          (if (.id | type) == "number" then (.id | tostring) else null end),
          title:       (.name // null),
          url:         (if (.id | type) == "number"
                        then "https://music.163.com/song?id=" + (.id | tostring)
                        else null end),
          channel:     (if (.ar | type) == "array"
                        then ([.ar[].name // empty] | join(", ")) else null end),
          duration:    (.dt | ne_secs),
          view_count:  null,
          live_status: null,
          description: (.al.name // "") }
  | . + { duration_fmt: (.duration | fmt_dur),
          kind: "track",
          access: (.fee | ne_access),
          thumbnail: pick_thumb }
  | select(.url != null)
  | select($vip or .access == "full") ]
'

fetch_results() {
    ensure_scratch

    # The row ceiling is applied FIRST and the request plan is derived from what survives it:
    # UT_MAX_SEARCH_RESULTS is counted in rows because rows are what the envelope contains,
    # and this engine spends it by asking for more of them per request rather than by taking
    # more pages (ARCH-cli-contract.md「配置面」).
    local wanted=$NUM_RESULTS
    ((UT_MAX_SEARCH_RESULTS > 0 && wanted > UT_MAX_SEARCH_RESULTS)) && wanted=$UT_MAX_SEARCH_RESULTS

    local limit=$((wanted * OVERFETCH))
    ((limit > PAGE_LIMIT_MAX)) && limit=$PAGE_LIMIT_MAX
    ((limit < 1)) && limit=1

    local vip=false
    ((NE_INCLUDE_VIP)) && vip=true

    local all="$SCRATCH_DIR/all.json"
    echo '[]' >"$all"
    local shaped='[]'
    local offset=0 req=0 kept=0

    while ((req < MAX_REQUESTS)); do
        local chunk n
        fetch_page "$limit" "$offset" || search_fail "$FETCH_REASON"
        chunk="$SCRATCH_DIR/chunk.json"
        n=$(jq 'length' "$chunk" 2>/dev/null) || n=0
        req=$((req + 1))
        ((n == 0)) && break

        jq -c --slurpfile chunk "$chunk" '. + $chunk[0]' "$all" >"$all.tmp" && mv "$all.tmp" "$all"
        shaped=$(jq -c --argjson vip "$vip" "$JQ_PRELUDE $JQ_ACCESS $JQ_SHAPE" "$all")
        kept=$(printf '%s' "$shaped" | jq 'length')

        ((kept >= wanted)) && break
        # The server is out of rows: it sent a short page, or the next offset is past the
        # total it declared. Either way another request would come back empty.
        ((n < limit)) && break
        offset=$((offset + n))
        ((PAGE_TOTAL > 0 && offset >= PAGE_TOTAL)) && break
    done

    # Sort is a client-side re-order of what was fetched. `-s view_count` DEGRADES to the
    # site's own ordering and does not error: the field this engine publishes is always null,
    # and re-ordering by a constant would only reverse the ranking the site sent. `-s
    # duration` is exact. SORT_FIELD is validated at startup, so there is no unknown-field
    # branch here.
    local sort_expr=""
    case "$SORT_FIELD" in
    duration) sort_expr=' | sort_by(.duration // -1) | reverse' ;;
    esac

    # The duration bounds are LOCAL and exact. This endpoint has no duration filter of its own
    # to hand half the work to — unlike Bilibili's, which offers four coarse buckets.
    local bounds="true"
    ((MIN_DURATION > 0)) && bounds+=" and (.duration != null and .duration > $MIN_DURATION)"
    ((MAX_DURATION > 0)) && bounds+=" and (.duration != null and .duration < $MAX_DURATION)"

    FILTERED_JSON=$(printf '%s' "$shaped" |
        jq -c '[ .[] | select('"$bounds"') ]'"$sort_expr"' | .[0:'"$wanted"']')
}

# Prose list. One jq program, and it renders the unknowns rather than leaking a raw JSON
# `null` into human output. The third line is the ARTIST rather than a play count: this site
# publishes none, and "n/a views" on every row of every search is noise, not information. A
# row that is not fully playable says so — it can only appear at all under NE_INCLUDE_VIP=1.
print_list() {
    printf '%s' "$FILTERED_JSON" | jq -r --arg note "$MUSIC_CHAR" '
        to_entries[]
        | (.key + 1) as $i
        | .value
        | (if $note == "" then "" else $note + " " end) + "\($i). \(.title)"
          + (if .access == "full" then "" else "  [" + .access + "]" end),
          "  - " + (.duration_fmt // "--"),
          "  - " + (if (.channel // "") == "" then "?" else .channel end),
          "  - \(.url)"'
}

# Structured search output for agent callers. The envelope is the one yt-search publishes,
# field for field — {status, engine, query, count, results} with the same eleven keys per
# result — because a caller that has to branch on which engine answered is a caller for whom
# the contract has already failed. `engine` is what lets it route a chosen result back to the
# matching <engine>-resolve without pattern-matching a URL.
#
# `jq -c`, both arms: every machine envelope in this suite is ONE line.
emit_search_json() {
    if [[ "$OUTPUT_MODE" == "json_full" ]]; then
        printf '%s' "$FILTERED_JSON" | jq -c --arg e "$ENGINE_NAME" --arg q "$QUERY" \
            '{status: "ok", engine: $e, query: $q, count: length, results: .}'
    else
        printf '%s' "$FILTERED_JSON" | jq -c --arg e "$ENGINE_NAME" --arg q "$QUERY" \
            '{status: "ok", engine: $e, query: $q, count: length,
              results: map({id, title, url, channel, duration, duration_fmt, view_count,
                            live_status, description, kind, access, thumbnail})}'
    fi
}

# ==============================================================================
# 4. CLI
# ==============================================================================

print_usage() {
    cat <<'EOF'
ne-search — the NetEase Cloud Music search engine (non-interactive)

Usage:
  ne-search [options] <search query>
  ne-search --capabilities [-j]

Options:
  -n NUM   Number of results to fetch (default: 20). This is how many are ASKED FOR, not a
           promise of how many come back — see the VIP note below
  -m SEC   Minimum duration in seconds
  -M SEC   Maximum duration in seconds
           Both are applied locally and exactly: this endpoint has no duration filter
  -s FIELD Sort field: relevance | view_count | duration (default: relevance)
           view_count DEGRADES to the site's own ordering — this site publishes no play
           count, and a row's view_count is always null. duration re-orders what was fetched
  -l       Plain text list output (default)
  -j       JSON: {status, engine, query, count, results[]} — 11 lean fields per result
  -J       JSON with every field the site sent per result (same envelope)
  --capabilities  The flags this half accepts, less the --color -h -V every command has.
           No network, no query, no dependency: how a caller learns what to ask
  --color MODE  auto | always | never (default: auto)
  -h       This help
  -V       Print the suite version

Output (JSON, -j): {"status","engine","query","count","results":[{id,title,url,channel,
                    duration,duration_fmt,view_count,live_status,description,kind,access,
                    thumbnail}, ...]}
  Identical to yt-search's and bili-search's envelope, field for field. results[].id is a
  numeric song id — the input to `ne-resolve`. view_count and live_status are always null:
  this search cannot know either, and kind is always "track".

  access is REAL here, and this is the only engine in the suite for which it is: the search
  response carries the site's own `fee`, so a row states whether it is fully playable
  ("full"), a 30-second sample ("preview") or an album purchase ("paywalled") — with no extra
  request. Both other engines print "full" because their sites tell them nothing.

Searching sends no credential of any kind: no account, no token, nothing read from a browser
profile. Login — the higher-quality audio an account may get — applies to ne-resolve, which
reaches it through yt-dlp.

VIP: by default only fully playable rows are returned (NE_INCLUDE_VIP=0), because a stored
row is a CALL and must run. Measured 2026-09-02 over 500 rows, 57% of this catalogue is
playable on a free account and the split is sharp: an ARTIST NAME mostly hits the VIP wall
(Taylor Swift 6%, 陈奕迅 24%, 周杰伦 30%), a MOOD or an instrument mostly does not (jazz 62%,
古典 76%, 钢琴 88%, lofi 98%). So -n 20 on an artist can come back holding six; the engine
already asks the site for more than you asked for, up to three requests. Set
NE_INCLUDE_VIP=1 to see the rest, labelled by access.

Exit codes: 0 ok · 1 usage/validation · 2 a missing dependency, or the site did
            not answer usefully (see .reason)

Requires openssl, which no other command in this suite needs: this site's search endpoint
takes an encrypted payload and the plaintext one it used to serve is gone. It is a dependency
of THIS FILE only — ne-resolve, and the rest of the suite, run without it.

Environment:
  Defaults for every knob below live in <checkout>/config, declared once for the whole
  suite. Override per user in ${XDG_CONFIG_HOME:-~/.config}/ting/config (KEY=value, one
  per line, # comments; the pre-rename .../uting/config is read when there is no ting
  one); TING_CONFIG relocates it, and UT_CONFIG still does. Chain: flag > environment > your
  config > the shipped defaults. See ARCH-cli-contract.md「配置面」.
  NE_UA           User-Agent sent with the search request (a browser UA)
  NE_INCLUDE_VIP  1 = also return rows that are not fully playable (default: 0)

To play a result, pass its song id to: t-play --engine ne
EOF
}

# Every flag this half takes beyond the --color -h -V every command has, stated ONCE: the
# unknown-flag refusal prints it for a person and --capabilities answers with it for a caller
# (ARCH-cli-contract.md「命令规格」).
SEARCH_FLAGS=(-n -m -M -s -l -j -J --capabilities)
CAPABILITIES=0
SEARCH_FLAG=""       # which of -n -m -M -s was given (gate: --capabilities runs no search)

# Value-taking flags (consume the next token) vs boolean flags, restricted to the search
# surface. Anything outside these is rejected — playback/lifecycle flags get a pointer to
# t-play so the caller learns the right tool instead of a bare error. ARCH-cli-contract.md「门模型」
has_format=0
query=()
reject_url() {
    echo "ne-search: '$1' looks like a URL — use 't-play --engine ne $1' to play it" >&2
    exit 1
}
while (($#)); do
    case "$1" in
    -h | --help)
        print_usage
        exit 0
        ;;
    -V | --version)
        # Answered before ANY dependency gate: a version is the first thing a bug report
        # needs, and needing openssl installed to find out which version you have is
        # backwards.
        printf 'ne-search %s\n' "$UT_VERSION"
        exit 0
        ;;
    -l | --list)
        has_format=1
        OUTPUT_MODE="list"
        shift
        ;;
    -j | --json)
        has_format=1
        OUTPUT_MODE="json"
        shift
        ;;
    -J | --json-full)
        has_format=1
        OUTPUT_MODE="json_full"
        shift
        ;;
    --color=*)
        COLOR_MODE="${1#*=}"
        shift
        ;;
    --color)
        [[ $# -ge 2 ]] || { echo "ne-search: $1 requires a value" >&2; exit 1; }
        COLOR_MODE="$2"
        shift 2
        ;;
    -n | -m | -M | -s)
        [[ $# -ge 2 ]] || { echo "ne-search: $1 requires a value" >&2; exit 1; }
        SEARCH_FLAG="$1"
        case "$1" in
        -n) NUM_RESULTS="$2" ;;
        -m) MIN_DURATION="$2" ;;
        -M) MAX_DURATION="$2" ;;
        -s) SORT_FIELD="$2" ;;
        esac
        shift 2
        ;;
    -S)
        # -S sorts STREAM FORMATS, and a search resolves none: whatever engine it is pointed
        # at, the value cannot change one byte of a search's output. Every search half rejects
        # it; the resolve half is where it belongs.
        echo "ne-search: -S selects a stream format — searching resolves none (see ne-resolve -S)" >&2
        exit 1
        ;;
    --quality | --quality=*)
        echo "ne-search: --quality selects a stream format — searching resolves none (see ne-resolve --quality)" >&2
        exit 1
        ;;
    -f | -d | --detach | --status | --stop | --set-volume | --id | --all)
        echo "ne-search: $1 is a playback flag — use t-play for playback" >&2
        exit 1
        ;;
    --info | --transcript | --subtitles | --sub-lang | --sub-langs)
        echo "ne-search: $1 belongs to the other half of this engine — use ne-resolve $1" >&2
        exit 1
        ;;
    --capabilities)
        CAPABILITIES=1
        shift
        ;;
    --)
        shift
        # `--` stops FLAG parsing, it does not stop argument validation: a query token that
        # looks like a URL is still the wrong tool, and a query beginning with '-' must
        # survive as a query. ARCHITECTURE.md「端到端控制流」.
        while (($#)); do
            case "$1" in
            http://* | https://* | www.* | music.163.com/* | y.music.163.com/*) reject_url "$1" ;;
            esac
            query+=("$1")
            shift
        done
        break
        ;;
    -*)
        echo "ne-search: unknown flag '$1' (search flags: ${SEARCH_FLAGS[*]})" >&2
        exit 1
        ;;
    http://* | https://* | www.* | music.163.com/* | y.music.163.com/*)
        reject_url "$1"
        ;;
    *)
        query+=("$1")
        shift
        ;;
    esac
done

# --capabilities asks about the ENGINE, not a query, so it answers before the query is required
# and ahead of every dependency gate, jq included: it is how a caller learns what to ask, so it
# must answer on a machine that cannot run a search yet. Anything that would shape a search is
# refused rather than ignored (ARCH-cli-contract.md「门模型」).
if ((CAPABILITIES)); then
    ((${#query[@]} == 0)) ||
        die "--capabilities takes no query — it reports what this engine accepts"
    [[ -z "$SEARCH_FLAG" ]] || die "$SEARCH_FLAG shapes a search — --capabilities runs none"
    [[ "$OUTPUT_MODE" != "json_full" ]] ||
        die "-J returns raw per-result fields — --capabilities has no results; use -j"
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        caps=""
        for f in "${SEARCH_FLAGS[@]}"; do caps+="${caps:+,}\"$f\""; done
        printf '{"status":"ok","engine":"%s","flags":[%s]}\n' "$ENGINE_NAME" "$caps"
    else
        printf '%s\n' "${SEARCH_FLAGS[*]}"
    fi
    exit 0
fi

if ((${#query[@]} == 0)); then
    echo "ne-search: a search query is required (see 'ne-search -h')" >&2
    exit 1
fi
QUERY="${query[*]}"
if [[ "$QUERY" != *[![:space:]]* ]]; then
    echo "ne-search: a search query is required (see 'ne-search -h')" >&2
    exit 1
fi

# The default output is the plain list; -j/-J/-l override.
((has_format)) || OUTPUT_MODE="list"

if ! is_non_negative_int "$NUM_RESULTS"; then
    die "-n must be a non-negative integer"
fi
if ! is_non_negative_int "$UT_MAX_SEARCH_RESULTS"; then
    die "UT_MAX_SEARCH_RESULTS must be a non-negative integer (0 = no ceiling)"
fi
if ! is_non_negative_int "$MIN_DURATION"; then
    die "-m must be a non-negative integer"
fi
if ! is_non_negative_int "$MAX_DURATION"; then
    die "-M must be a non-negative integer"
fi
if ((MAX_DURATION > 0 && MAX_DURATION <= MIN_DURATION)); then
    die "-M must be greater than -m when both are set"
fi
if ! validate_enum "$SORT_FIELD" relevance view_count duration; then
    die "-s must be one of: relevance, view_count, duration"
fi
if ! validate_enum "$COLOR_MODE" auto always never; then
    die "--color must be one of: auto, always, never"
fi
if ! validate_enum "$NE_INCLUDE_VIP" 0 1; then
    die "NE_INCLUDE_VIP must be 0 or 1"
fi

# openssl joins curl and jq HERE, in the search half only, and it goes through the same
# require_cmd gate every other dependency in the suite does: a machine without it loses this
# one command and keeps the other nine, which is exactly what scoping the dependency to the
# engine was for (ARCH-engine.md).
require_deps curl jq openssl

# -n 0 is a legal, cheap answer: the empty envelope, without a round trip.
if ((NUM_RESULTS == 0)); then
    FILTERED_JSON='[]'
else
    fetch_results
fi
if [[ "$OUTPUT_MODE" == "list" ]]; then
    print_list
else
    emit_search_json
fi
exit 0
